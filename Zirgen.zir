#[include "std/file", "std/io", "std/str", "std/map", "std/vec", "vendor/clang-c/Index.zir", "src/Lexer.zir", "src/Logger.zir" : *]

enum TranspileState: i32 {
    None, Declared, Defined
}

class FileState {
    pub path: String,
    pub name: String,
    pub relative_path: String,
    pub macros: String,
    pub declarations: String,
    pub extern_functions: String,
    pub includes: Map<String, String>,
    pub imports: Vector<String>,
    pub count: u64 = 0
}

class PendingMacro {
    pub name: String,
    pub file_state: *mut FileState = null;

    PendingMacro(&mut this, name: &String, file_state: *mut FileState) {
        (this.name, this.file_state) = (name, file_state);
    }
}

class GlobalState {
    pub files: Map<String, *mut FileState>,
    pub transpile_states: Map<String, TranspileState>,
    pub included_from: Map<String, *mut FileState>,
    pub external: Map<String, String>,
    pub modules: Map<String, String>,
    pub enum_constants: Map<String, String>,
    pub pending: Vector<PendingMacro>,
    pub translation_unit: CXTranslationUnit = null,
    pub output_directory: String,
    pub root_directory: String,
    pub last_anonymous_enum: CXCursor
}

fn EnsureBlankLine(string: &mut String) {
    let length = string.Length();

    if length >= 2 && string[length - 1] == '\n' && string[length - 2] != '\n' {
        string += "\n";
    }
}

fn NormalizePath(path: &String) -> String {
    let mut result = AbsolutePath(path).UnwrapOr(path);

    for i in 0..result.Length() {
        if result[i] == '\\' {
            result[i] = '/';
        }
    }

    result
}

fn GetRelativePath(path: &String, root_directory: &String) -> String {
    let normalized = NormalizePath(path);
    let root = NormalizePath(root_directory);

    let inside = normalized.Length() > root.Length() && (normalized[root.Length()] == '/' || root[root.Length() - 1] == '/');

    if !root.Empty() && normalized.StartsWith(root) && inside {
        let mut start = root.Length();

        while start < normalized.Length() && (normalized[start] == '/' || normalized[start] == '\\') {
            start += 1;
        }

        if start < normalized.Length() {
            return SplitExtension(normalized.SubString(start, normalized.Length() - start)).0;
        }
    }

    SplitExtension(SplitPath(normalized).1).0
}

fn ModuleOf(state: *mut GlobalState, path: &String) -> String {
    for directory in state->modules.Keys() {
        if path.Length() > directory.Length() && path.StartsWith(directory) && path[directory.Length()] == '/' { return state->modules[directory]; }
    }

    String()
}

fn GetFileState(state: *mut GlobalState, cursor: CXCursor) -> *mut FileState {
    let location = clang_getCursorLocation(cursor);
    if clang_Location_isInSystemHeader(location) != 0 { return null; }

    let mut file: CXFile = null;
    clang_getFileLocation(location, &mut file, null, null, null);
    if file == null { return null; }

    let spelling = clang_getFileName(file);
    let path = NormalizePath(clang_getCString(spelling).ToString());
    clang_disposeString(spelling);
    if !ModuleOf(state, path).Empty() { return null; }

    if state->included_from.Has(path) {
        return state->included_from[path];
    }

    let extension = SplitExtension(SplitPath(path).1).1;
    if extension == ".def" || extension == ".inc" { return null; }
    if state->files.Has(path) { return state->files[path]; }
    let mut file_state = new FileState();
    file_state->name = SplitExtension(SplitPath(path).1).0;
    file_state->relative_path = GetRelativePath(path, state->root_directory);
    (file_state->path, state->files[path]) = (path, file_state);
    file_state
}

fn FuncTypeToString(_type: CXType) -> String {
    let mut result = "fn(".ToString();
    let num_args = clang_getNumArgTypes(_type);

    for i in 0..num_args {
        result += TypeToString(clang_getArgType(_type, i as u32));

        if i < num_args - 1 {
            result += ", ";
        }
    }

    if clang_isFunctionTypeVariadic(_type) != 0 {
        if num_args > 0 {
            result += ", ";
        } result += "...";
    }

    result += ")";
    let ret_type = clang_getResultType(_type);

    if clang_getCanonicalType(ret_type).kind != CXTypeKind::CXType_Void {
        result += " -> " + TypeToString(ret_type);
    }

    result
}

fn TypeToString(_type: CXType) -> String {
    match _type.kind {
        CXTypeKind::CXType_Void => "void".ToString(),
        CXTypeKind::CXType_Bool => "bool".ToString(),
        CXTypeKind::CXType_Char_U | CXTypeKind::CXType_UChar => "u8".ToString(),
        CXTypeKind::CXType_Char_S | CXTypeKind::CXType_SChar => "i8".ToString(),
        CXTypeKind::CXType_UShort => "u16".ToString(),
        CXTypeKind::CXType_Short => "i16".ToString(),
        CXTypeKind::CXType_UInt => "u32".ToString(),
        CXTypeKind::CXType_Int => "i32".ToString(),
        CXTypeKind::CXType_ULong | CXTypeKind::CXType_ULongLong => if clang_Type_getSizeOf(_type) == 4 { "u32".ToString() } else { "u64".ToString() },
        CXTypeKind::CXType_Long | CXTypeKind::CXType_LongLong => if clang_Type_getSizeOf(_type) == 4 { "i32".ToString() } else { "i64".ToString() },
        CXTypeKind::CXType_Float => "f32".ToString(),
        CXTypeKind::CXType_Double => "f64".ToString(),
        CXTypeKind::CXType_WChar => "u16".ToString(),
        CXTypeKind::CXType_Elaborated => TypeToString(clang_Type_getNamedType(_type)),
        CXTypeKind::CXType_Attributed => TypeToString(clang_Type_getModifiedType(_type)),
        CXTypeKind::CXType_FunctionProto | CXTypeKind::CXType_FunctionNoProto => FuncTypeToString(_type),
        CXTypeKind::CXType_Pointer => PointerTypeToString(_type),
        CXTypeKind::CXType_Record | CXTypeKind::CXType_Enum | CXTypeKind::CXType_Typedef => NamedTypeToString(_type),
        CXTypeKind::CXType_IncompleteArray => "*mut " + TypeToString(clang_getArrayElementType(_type)),
        CXTypeKind::CXType_ConstantArray => '[' + TypeToString(clang_getArrayElementType(_type)) + "; " + String::FromInteger(clang_getArraySize(_type) as u64) + ']',
        _ => String()
    }
}

fn PointerTypeToString(_type: CXType) -> String {
    let pointee = clang_getPointeeType(_type);

    if pointee.kind == CXTypeKind::CXType_FunctionProto || pointee.kind == CXTypeKind::CXType_FunctionNoProto {
        return FuncTypeToString(pointee);
    }

    let canonical = clang_getCanonicalType(pointee);

    if canonical.kind == CXTypeKind::CXType_FunctionProto || canonical.kind == CXTypeKind::CXType_FunctionNoProto {
        return TypeToString(pointee);
    }

    let prefix = if clang_isConstQualifiedType(pointee) != 0 { "*" } else { "*mut " };
    prefix + TypeToString(pointee)
}

fn NamedTypeToString(_type: CXType) -> String {
    let spelling = clang_getTypeSpelling(_type);
    let mut string = clang_getCString(spelling).ToString();
    clang_disposeString(spelling);

    loop {
        if string.StartsWith("const ") {
            string = string.SubString(6);
        } else if string.StartsWith("volatile ") {
            string = string.SubString(9);
        } else {
            break;
        }
    }

    if string.StartsWith("struct ") {
        string = string.SubString(7);
    } else if string.StartsWith("union ") {
        string = string.SubString(6);
    } else if string.StartsWith("enum ") {
        string = string.SubString(5);
    }

    if string == "size_t" || string == "uintptr_t" { return "usize".ToString(); }
    if string == "ssize_t" || string == "intptr_t" || string == "ptrdiff_t" { return "isize".ToString(); }
    if string == "time_t" || string == "off_t" { return "isize".ToString(); }
    if string == "uint64_t" { return "u64".ToString(); }
    if string == "int64_t" { return "i64".ToString(); }
    if string == "uint32_t" { return "u32".ToString(); }
    if string == "int32_t" { return "i32".ToString(); }
    if string == "uint16_t" { return "u16".ToString(); }
    if string == "int16_t" { return "i16".ToString(); }
    if string == "uint8_t" { return "u8".ToString(); }
    if string == "int8_t" { return "i8".ToString(); }

    let declaration = clang_getTypeDeclaration(_type);

    if clang_Cursor_isNull(declaration) == 0 && clang_Location_isInSystemHeader(clang_getCursorLocation(declaration)) != 0 {
        return match _type.kind {
            CXTypeKind::CXType_Typedef => TypeToString(clang_getCanonicalType(_type)),
            CXTypeKind::CXType_Enum => TypeToString(clang_getEnumDeclIntegerType(declaration)),
            _ => "void".ToString()
        };
    }

    string
}

fn QualifyConstants(state: *mut GlobalState, expression: &String, enumeration: &String, type_name: &String) -> String {
    let mut bitwise = true;
    let mut result = String();

    for pass in 0..2 {
        result = String();
        let mut i: usize = 0;

        while i < expression.Length() {
            let start = i;

            while i < expression.Length() && ((expression[i] >= 'a' && expression[i] <= 'z') || (expression[i] >= 'A' && expression[i] <= 'Z') || (expression[i] >= '0' && expression[i] <= '9') || expression[i] == '_') {
                i += 1;
            }

            if i == start {
                let character = expression[i];
                if character != ' ' && character != '(' && character != ')' && character != '|' && character != '&' && character != '^' { bitwise = false; }
                result += character;
                i += 1;
                continue;
            }

            let word = expression.SubString(start, i - start);
            let constant = state->enum_constants.Has(word);
            let other = constant && state->enum_constants[word] != enumeration;
            if !constant || other { bitwise = false; }
            if other { result += state->enum_constants[word] + "::"; }
            result += word;
            if constant && pass == 1 { result += " as " + type_name; }
        }

        if bitwise { return expression; }
    }

    result
}

class EnumVisitorData {
    pub state: *mut GlobalState,
    pub file_state: *mut FileState,
    pub name: String,
    pub type_name: String;

    EnumVisitorData(&mut this, state: *mut GlobalState, file_state: *mut FileState, name: &String, type_name: &String) {
        (this.state, this.file_state, this.name, this.type_name) = (state, file_state, name, type_name);
    }
}

extern "C" {
    fn VisitEnumChild(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        if cursor.kind != CXCursorKind::CXCursor_EnumConstantDecl {
            return CXChildVisitResult::CXChildVisit_Continue;
        }

        let visitor_data = client_data as *mut EnumVisitorData;
        let (file_state, type_name) = (visitor_data->file_state, visitor_data->type_name);

        let spelling = clang_getCursorSpelling(cursor);
        let name = clang_getCString(spelling).ToString();
        clang_disposeString(spelling);

        let mut expression = String();
        clang_visitChildren(cursor, VisitChildExpression, &mut expression as CXClientData);
        let value = clang_getEnumConstantDeclValue(cursor);

        if value < 0 {
            expression = String::FromInteger(value);
        }

        expression = QualifyConstants(visitor_data->state, expression, visitor_data->name, type_name);
        visitor_data->state->enum_constants[name] = visitor_data->name;

        if !expression.Empty() {
            file_state->declarations += "    " + name + " = " + expression;

            if type_name.StartsWith('u') && expression.StartsWith('-') {
                file_state->declarations += " as " + type_name;
            }
        } else {
            file_state->declarations += "    " + name;
        }

        file_state->declarations += ",\n";
        CXChildVisitResult::CXChildVisit_Continue
    }

    fn VisitStructChild(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        let data = client_data as *mut StructVisitorData;

        if cursor.kind == CXCursorKind::CXCursor_StructDecl || cursor.kind == CXCursorKind::CXCursor_UnionDecl {
            if clang_Cursor_isAnonymousRecordDecl(cursor) != 0 {
                data->bitfield_start = -1;
                let name = "_" + String::FromInteger(data->count);
                let nested_name = data->name + name;
                data->count += 1;
                EmitRecord(data->state, data->file_state, cursor, nested_name);
                data->body += "    pub " + name + ": " + nested_name + ",\n";
            } else if clang_Cursor_isAnonymous(cursor) == 0 {
                let spelling = clang_getCursorSpelling(cursor);
                let name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);
                EmitRecord(data->state, data->file_state, cursor, name);
            } return CXChildVisitResult::CXChildVisit_Continue;
        }

        if cursor.kind != CXCursorKind::CXCursor_FieldDecl {
            return CXChildVisitResult::CXChildVisit_Continue;
        }

        let _type = clang_getCursorType(cursor);

        if clang_Cursor_isBitField(cursor) != 0 {
            if clang_getFieldDeclBitWidth(cursor) == 0 {
                return CXChildVisitResult::CXChildVisit_Continue;
            }

            let size = clang_Type_getSizeOf(_type);
            let unit = size * 8;
            let start = (clang_Cursor_getOffsetOfField(cursor) / unit) * unit;

            if start != data->bitfield_start || size != data->bitfield_size {
                (data->bitfield_start, data->bitfield_size) = (start, size);
                data->body += "    pub _bitfield" + String::FromInteger(data->count) + ": " + TypeToString(_type) + ",\n";
                data->count += 1;
            }

            return CXChildVisitResult::CXChildVisit_Continue;
        }

        data->bitfield_start = -1;
        let spelling = clang_getCursorSpelling(cursor);
        let mut name = clang_getCString(spelling).ToString();
        clang_disposeString(spelling);

        if name.Empty() {
            name = "_" + String::FromInteger(data->count);
            data->count += 1;
        } else if StringToKeyword(name) != TokenType::UNKNOWN {
            name = "_" + name;
        }

        let anonymous = AnonymousRecordOf(_type);
        let mut type_string = String();

        if clang_Cursor_isNull(anonymous) == 0 {
            let nested_name = data->name + "_" + name;
            EmitRecord(data->state, data->file_state, anonymous, nested_name);
            type_string = FieldTypeToString(_type, nested_name);
        } else {
            type_string = TypeToString(_type);
        }

        data->body += "    pub " + name + ": " + type_string + ",\n";
        CXChildVisitResult::CXChildVisit_Continue
    }
}

class FunctionBodyData {
    pub body: String,
    pub valid: bool = true
}

class StructVisitorData {
    pub state: *mut GlobalState,
    pub file_state: *mut FileState,
    pub name: String,
    pub body: String,
    pub count: u64 = 0,
    pub bitfield_start: i64 = -1,
    pub bitfield_size: i64 = 0;

    StructVisitorData(&mut this, state: *mut GlobalState, file_state: *mut FileState, name: &String) {
        (this.state, this.file_state, this.name) = (state, file_state, name);
    }
}

fn AnonymousRecordOf(_type: CXType) -> CXCursor {
    match _type.kind {
        CXTypeKind::CXType_ConstantArray => AnonymousRecordOf(clang_getArrayElementType(_type)),
        CXTypeKind::CXType_Elaborated => AnonymousRecordOf(clang_Type_getNamedType(_type)),
        CXTypeKind::CXType_Record => {
            let declaration = clang_getTypeDeclaration(_type);
            if clang_Cursor_isAnonymous(declaration) != 0 { declaration }
            else { clang_getNullCursor() }
        },
        _ => clang_getNullCursor()
    }
}

fn FieldTypeToString(_type: CXType, anonymous_name: &String) -> String {
    match _type.kind {
        CXTypeKind::CXType_ConstantArray => '[' + FieldTypeToString(clang_getArrayElementType(_type), anonymous_name) + "; " + String::FromInteger(clang_getArraySize(_type) as u64) + ']',
        CXTypeKind::CXType_Elaborated => FieldTypeToString(clang_Type_getNamedType(_type), anonymous_name),
        _ => String(anonymous_name)
    }
}

fn EmitEnum(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor, name: &String, type_override: &String) {
    EnsureBlankLine(file_state->declarations);

    let is_definition = clang_isCursorDefinition(cursor) != 0;
    let transpile_state = state->transpile_states.Get(name, TranspileState::None);
    if transpile_state == TranspileState::Defined || (transpile_state == TranspileState::Declared && !is_definition) { return; }
    state->transpile_states[name] = if is_definition { TranspileState::Defined } else { TranspileState::Declared };

    let type_name: String = if !type_override.Empty() {
        type_override
    } else {
        TypeToString(clang_getEnumDeclIntegerType(cursor))
    };

    let length_before = file_state->declarations.Length();
    file_state->declarations += "enum " + name + ": " + type_name + " {\n";
    let length_header = file_state->declarations.Length();

    let mut visitor_data = EnumVisitorData(state, file_state, name, type_name);
    clang_visitChildren(cursor, VisitEnumChild, &mut visitor_data as CXClientData);

    if file_state->declarations.Length() == length_header {
        file_state->declarations = file_state->declarations.SubString(0, length_before) + "enum " + name + ": " + type_name + " {}\n\n";
    } else {
        let length = file_state->declarations.Length();

        if length >= 2 && file_state->declarations[length - 1] == '\n' && file_state->declarations[length - 2] == ',' {
            file_state->declarations = file_state->declarations.SubString(0, length - 2) + "\n";
        }

        file_state->declarations += "}\n\n";
    }
}

fn EmitRecord(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor, name: &String) {
    if state->external.Has(name) {
        let module = state->external[name];
        if !file_state->imports.Contains(module) { file_state->imports.PushBack(module); }
        return;
    }

    let is_definition = clang_isCursorDefinition(cursor) != 0;

    if !is_definition && clang_Cursor_isNull(clang_getCursorDefinition(cursor)) == 0 {
        return;
    }

    let transpile_state = state->transpile_states.Get(name, TranspileState::None);
    if transpile_state == TranspileState::Defined || (transpile_state == TranspileState::Declared && !is_definition) { return; }
    state->transpile_states[name] = if is_definition { TranspileState::Defined } else { TranspileState::Declared };

    if !is_definition {
        EnsureBlankLine(file_state->declarations);
        file_state->declarations += "struct " + name + " {}\n\n";
        return;
    }

    if cursor.kind == CXCursorKind::CXCursor_UnionDecl {
        EmitUnion(file_state, cursor, name);
        return;
    }

    let mut data = StructVisitorData(state, file_state, name);
    clang_visitChildren(cursor, VisitStructChild, &mut data as CXClientData);
    EnsureBlankLine(file_state->declarations);

    if data.body.Empty() {
        file_state->declarations += "struct " + name + " {}\n\n";
    } else {
        file_state->declarations += "struct " + name + " {\n" + data.body.SubString(0, data.body.Length() - 2) + "\n}\n\n";
    }
}

fn EmitUnion(file_state: *mut FileState, cursor: CXCursor, name: &String) {
    let _type = clang_getCursorType(cursor);
    let (size, alignment) = (clang_Type_getSizeOf(_type), clang_Type_getAlignOf(_type));

    let element: String = if alignment >= 8 {
        "u64".ToString()
    } else if alignment == 4 {
        "u32".ToString()
    } else if alignment == 2 {
        "u16".ToString()
    } else {
        "u8".ToString()
    };

    let element_size = if alignment >= 8 { 8 } else { alignment };
    EnsureBlankLine(file_state->declarations);
    file_state->declarations += "struct " + name + " {\n    pub _data: [" + element + "; " + String::FromInteger(size / element_size) + "]\n}\n\n";
}

fn InferMacroType(value: &String) -> String {
    if value.Empty() { return String(); }
    if value[0] == '"' { return "*i8".ToString(); }
    if value[0] == '\'' { return "i8".ToString(); }
    let length = value.Length();

    if !(length >= 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X')) {
        for i in 0..length {
            if value[i] == '.' || value[i] == 'e' || value[i] == 'E' {
                if value[length - 1] == 'f' || value[length - 1] == 'F' {
                    return "f32".ToString();
                } return "f64".ToString();
            }
        }
    }

    let hexadecimal = length >= 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X');
    let (mut unsigned, mut long_long) = (false, false);

    for i in 0..length {
        if value[i] == 'u' || value[i] == 'U' { unsigned = true; }
        if i > 0 && (value[i] == 'l' || value[i] == 'L') && (value[i - 1] == 'l' || value[i - 1] == 'L') { long_long = true; }
    }

    let number = ParseIntegerLiteral(value);
    let fits_i32 = number <= 0x7FFFFFFF;
    let fits_u32 = number <= 0xFFFFFFFF;
    let fits_i64 = number <= 0x7FFFFFFFFFFFFFFF;

    if unsigned {
        String(if fits_u32 && !long_long { "u32" } else { "u64" })
    } else if long_long {
        String(if fits_i64 { "i64" } else { "u64" })
    } else if fits_i32 {
        "i32".ToString()
    } else if fits_u32 && hexadecimal {
        "u32".ToString()
    } else {
        String(if fits_i64 { "i64" } else { "u64" })
    }
}

fn ParseIntegerLiteral(value: &String) -> u64 {
    let length = value.Length();
    let mut result: u64 = 0;

    if length >= 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X') {
        let mut i: usize = 2;

        while i < length {
            let character = value[i];

            if character >= '0' && character <= '9' {
                result = result * 16 + (character - '0') as u64;
            } else if character >= 'a' && character <= 'f' {
                result = result * 16 + (character - 'a') as u64 + 10;
            } else if character >= 'A' && character <= 'F' {
                result = result * 16 + (character - 'A') as u64 + 10;
            } else {
                break;
            } i += 1;
        }
    } else {
        let mut i: usize = 0;

        while i < length && value[i] >= '0' && value[i] <= '9' {
            result = result * 10 + (value[i] - '0') as u64;
            i += 1;
        }
    }

    result
}

fn StripCSuffix(value: &String, _type: &String) -> String {
    let length = value.Length();

    if _type == "f32" {
        if length > 0 {
            if value[length - 1] == 'f' || value[length - 1] == 'F' {
                return value.SubString(0, length - 1);
            }
        } return value;
    }

    if _type == "*i8" || _type == "i8" || _type == "f64" {
        return value;
    }

    let mut end = length;

    while end > 0 {
        if value[end - 1] == 'u' || value[end - 1] == 'U' || value[end - 1] == 'l' || value[end - 1] == 'L' {
            end -= 1;
        } else {
            break;
        }
    }

    value.SubString(0, end)
}

fn StripCSuffix(value: &String, float: bool) -> String {
    let mut end = value.Length();

    while end > 0 {
        let character = value[end - 1];

        if float && (character == 'f' || character == 'F') {
            end -= 1;
        } else if character == 'u' || character == 'U' || character == 'l' || character == 'L' {
            end -= 1;
        } else {
            break;
        }
    }

    value.SubString(0, end)
}

fn TranslateMacro(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor) {
    if clang_Cursor_isMacroFunctionLike(cursor) != 0 { return; }
    if clang_Cursor_isMacroBuiltin(cursor) != 0 { return; }

    let name_spelling = clang_getCursorSpelling(cursor);
    let name = String(clang_getCString(name_spelling));
    clang_disposeString(name_spelling);
    if name.Empty() { return; }

    if state->transpile_states.Has(name) { return; }
    state->transpile_states[name] = TranspileState::Defined;

    let extent = clang_getCursorExtent(cursor);
    let (mut tokens, mut num_tokens): (*mut CXToken, u32) = (null, 0);
    clang_tokenize(state->translation_unit, extent, &mut tokens, &mut num_tokens);

    if num_tokens < 2 || tokens == null {
        if tokens != null {
            clang_disposeTokens(state->translation_unit, tokens, num_tokens);
        } return;
    }

    let kind = clang_getTokenKind(tokens[1]);
    let value_spelling = clang_getTokenSpelling(state->translation_unit, tokens[1]);
    let value = clang_getCString(value_spelling).ToString();
    clang_disposeString(value_spelling);
    let (mut depth, mut separated) = (0i32, false);

    for i in 1u32..num_tokens {
        if clang_getTokenKind(tokens[i as usize]) != CXTokenKind::CXToken_Punctuation { continue; }
        let punctuation_spelling = clang_getTokenSpelling(state->translation_unit, tokens[i as usize]);
        let punctuation = clang_getCString(punctuation_spelling).ToString();
        clang_disposeString(punctuation_spelling);
        if punctuation == "(" { depth += 1; } else if punctuation == ")" { depth -= 1; } else if punctuation == "," && depth == 0 { separated = true; }
    }

    clang_disposeTokens(state->translation_unit, tokens, num_tokens);

    if num_tokens == 2 && kind == CXTokenKind::CXToken_Identifier && state->enum_constants.Has(value) && IsIdentifier(state->enum_constants[value]) {
        let enumeration = state->enum_constants[value];
        file_state->macros += "const " + name + ": " + enumeration + " = " + enumeration + "::" + value + ";\n";
        return;
    }

    if num_tokens != 2 || kind != CXTokenKind::CXToken_Literal {
        if !separated { state->pending.PushBack(PendingMacro(name, file_state)); }
        return;
    }

    let _type = InferMacroType(value);
    if _type.Empty() { return; }

    file_state->macros += "const " + name + ": " + _type + " = " + StripCSuffix(value, _type) + ";\n";
}

fn IsIdentifier(name: &String) -> bool {
    if name.Empty() || (name[0] >= '0' && name[0] <= '9') { return false; }

    for i in 0..name.Length() {
        let character = name[i];
        if !((character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') || character == '_') { return false; }
    }

    true
}

fn FloatLiteral(value: f64, single: bool) -> String {
    for precision in 1usize..18 {
        let text = String::FromFloat(value, precision);
        let parsed = text.ToFloat().UnwrapOr(0.0);
        if (single && parsed as f32 == value as f32) || (!single && parsed == value) { return text; }
    }

    String::FromFloat(value, 17)
}

fn ConstantValue(cursor: CXCursor, _type: CXType) -> (String, String) {
    let canonical = clang_getCanonicalType(_type);
    let result = clang_Cursor_Evaluate(cursor);
    if result == null { return (String(), String()); }
    let kind = clang_EvalResult_getKind(result);
    let integer = canonical.kind >= CXTypeKind::CXType_Bool && canonical.kind <= CXTypeKind::CXType_Int128;
    let floating = canonical.kind == CXTypeKind::CXType_Float || canonical.kind == CXTypeKind::CXType_Double;

    let value = match kind {
        CXEvalResultKind::CXEval_Int => if !integer { String() }
            else if clang_EvalResult_isUnsignedInt(result) != 0 { String::FromInteger(clang_EvalResult_getAsUnsigned(result)) }
            else { String::FromInteger(clang_EvalResult_getAsLongLong(result)) },
        CXEvalResultKind::CXEval_Float => if floating { FloatLiteral(clang_EvalResult_getAsDouble(result), canonical.kind == CXTypeKind::CXType_Float) } else { String() },
        CXEvalResultKind::CXEval_StrLiteral => "\"" + clang_EvalResult_getAsStr(result).ToString().Escape() + "\"",
        _ => String()
    };

    clang_EvalResult_dispose(result);
    if value.Empty() { return (String(), String()); }
    let type_name = if kind == CXEvalResultKind::CXEval_StrLiteral { "*i8".ToString() } else { TypeToString(_type) };
    if type_name.Empty() { return (String(), String()); }
    (type_name, value)
}

fn EmitVariable(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor) {
    let spelling = clang_getCursorSpelling(cursor);
    let name = clang_getCString(spelling).ToString();
    clang_disposeString(spelling);
    let _type = clang_getCursorType(cursor);
    if name.Empty() || state->transpile_states.Has(name) || clang_isConstQualifiedType(_type) == 0 { return; }
    let initializer = clang_Cursor_getVarDeclInitializer(cursor);
    if clang_Cursor_isNull(initializer) != 0 { return; }
    let (type_name, mut value) = ConstantValue(cursor, _type);
    if type_name.Empty() { return; }

    if initializer.kind == CXCursorKind::CXCursor_IntegerLiteral {
        let literal = TranslateExpression(initializer);
        if !literal.Empty() { value = literal; }
    }

    state->transpile_states[name] = TranspileState::Defined;
    file_state->declarations += "const " + name + ": " + type_name + " = " + value + ";\n";
}

fn EvaluateMacros(state: *mut GlobalState, header: &String, clang_args: &Vector<*i8>) {
    if state->pending.Empty() { return; }
    let path = NormalizePath(header);
    let probe = JoinPath(SplitPath(path).0, "zirgen_probe.h".ToString());
    let mut source = "#include \"" + path + "\"\n";

    for i in 0..state->pending.Length() {
        source += "static const __auto_type zirgen_value_" + String::FromInteger(i as u64) + " = (" + state->pending[i].name + ");\n";
    }

    let mut unsaved: CXUnsavedFile;
    (unsaved.Filename, unsaved.Contents, unsaved.Length) = (probe.Data(), source.Data(), source.Length() as u32);
    let index = clang_createIndex(0, 0);
    let unit = clang_parseTranslationUnit(index, probe.Data(), clang_args.Data(), clang_args.Length() as i32, &mut unsaved, 1, CXTranslationUnit_Flags::CXTranslationUnit_None as u32);

    if unit != null {
        clang_visitChildren(clang_getTranslationUnitCursor(unit), VisitProbe, state as CXClientData);
        clang_disposeTranslationUnit(unit);
    }

    clang_disposeIndex(index);
    state->pending.Clear();
}

extern "C" {
    fn CreateDirectoryA(lpPathName: *i8, lpSecurityAttributes: *mut void) -> i32;
}

fn EnsureDirectory(path: &String) {
    if path.Empty() || FolderExists(path) { return; }
    let directory = SplitPath(path).0;
    if !directory.Empty() { EnsureDirectory(directory); }
    CreateDirectoryA(path.Data(), null);
}

fn FlushAnonymousEnum(state: *mut GlobalState, file_state: *mut FileState) {
    if clang_Cursor_isNull(state->last_anonymous_enum) == 0 {
        let mut target_file_state = file_state;

        if target_file_state == null {
            target_file_state = GetFileState(state, state->last_anonymous_enum);
        }

        if target_file_state != null {
            let mut name = String();

            if clang_Cursor_isAnonymous(state->last_anonymous_enum) != 0 {
                let _type = clang_getCursorType(state->last_anonymous_enum);
                let type_spelling = clang_getTypeSpelling(_type);
                name = String(clang_getCString(type_spelling));
                clang_disposeString(type_spelling);
            } else {
                let spelling = clang_getCursorSpelling(state->last_anonymous_enum);
                name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);
            }

            EmitEnum(state, target_file_state, state->last_anonymous_enum, name, String());
        }

        state->last_anonymous_enum = clang_getNullCursor();
    }
}

fn TranslateExpression(cursor: CXCursor) -> String {
    let kind = cursor.kind;

    match kind {
        CXCursorKind::CXCursor_CallExpr => {
            let spelling = clang_getCursorSpelling(cursor);
            let mut result = clang_getCString(spelling).ToString() + '(';
            clang_disposeString(spelling);
            let mut first = true;

            for i in 0..clang_Cursor_getNumArguments(cursor) {
                if !first { result += ", "; } else { first = false; }
                let argument_cursor = clang_Cursor_getArgument(cursor, i as u32);
                let mut argument = TranslateExpression(argument_cursor);

                if argument.Empty() {
                    clang_visitChildren(argument_cursor, VisitChildExpression, &mut argument as CXClientData);
                }

                if argument.Empty() { return String(); }
                result += argument;
            }

            result + ')'
        },
        CXCursorKind::CXCursor_IntegerLiteral | CXCursorKind::CXCursor_FloatingLiteral => {
            let extent = clang_getCursorExtent(cursor);
            let translation_unit = clang_Cursor_getTranslationUnit(cursor);
            let (mut tokens, mut num_tokens): (*mut CXToken, u32) = (null, 0);
            clang_tokenize(translation_unit, extent, &mut tokens, &mut num_tokens);
            let mut value = String();

            if tokens != null && num_tokens > 0 {
                let token_spelling = clang_getTokenSpelling(translation_unit, tokens[0]);
                value = StripCSuffix(clang_getCString(token_spelling).ToString(), kind == CXCursorKind::CXCursor_FloatingLiteral);
                clang_disposeString(token_spelling);
                clang_disposeTokens(translation_unit, tokens, num_tokens);
            }

            value
        },
        CXCursorKind::CXCursor_StringLiteral | CXCursorKind::CXCursor_DeclRefExpr => {
            let spelling = clang_getCursorSpelling(cursor);
            let value = clang_getCString(spelling).ToString();
            clang_disposeString(spelling);

            if kind == CXCursorKind::CXCursor_DeclRefExpr && StringToKeyword(value) != TokenType::UNKNOWN {
                return "_" + value;
            }

            value
        },
        CXCursorKind::CXCursor_CStyleCastExpr => {
            let mut operand = String();
            clang_visitChildren(cursor, VisitChildExpression, &mut operand as CXClientData);

            if clang_getCursorType(cursor).kind == CXTypeKind::CXType_Pointer && (operand == "0" || operand == "NULL") {
                "null".ToString()
            } else {
                String()
            }
        },
        CXCursorKind::CXCursor_UnaryOperator => {
            let spelling = clang_getCursorSpelling(cursor);
            let _operator = clang_getCString(spelling).ToString();
            clang_disposeString(spelling);

            let mut operand = String();
            clang_visitChildren(cursor, VisitChildExpression, &mut operand as CXClientData);
            _operator + operand
        },
        CXCursorKind::CXCursor_BinaryOperator => {
            let spelling = clang_getCursorSpelling(cursor);
            let _operator = clang_getCString(spelling).ToString();
            clang_disposeString(spelling);

            let mut operands = Vector<String>();
            clang_visitChildren(cursor, VisitChildExpressions, &mut operands as CXClientData);
            if operands.Length() != 2 { return String(); }
            operands[0] + ' ' + _operator + ' ' + operands[1]
        },
        CXCursorKind::CXCursor_ParenExpr => {
            let mut expression = String();
            clang_visitChildren(cursor, VisitChildExpression, &mut expression as CXClientData);
            if expression.Empty() { return String(); }
            "(" + expression + ")"
        },
        _ => String()
    }
}

fn TranslateStatement(cursor: CXCursor) -> String {
    let kind = cursor.kind;

    match kind {
        CXCursorKind::CXCursor_ReturnStmt => {
            let mut expression = String();
            clang_visitChildren(cursor, VisitChildExpression, &mut expression as CXClientData);

            if !expression.Empty() {
                "return " + expression + ";\n"
            } else {
                let mut has_child = false;
                clang_visitChildren(cursor, VisitAnyChild, &mut has_child as CXClientData);
                if has_child { String() } else { "return;\n".ToString() }
            }
        },
        CXCursorKind::CXCursor_CallExpr => {
            let expression = TranslateExpression(cursor);

            if !expression.Empty() {
                expression + ";\n"
            } else {
                String()
            }
        },
        _ => String()
    }
}

extern "C" {
    fn VisitChildExpression(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        let expression = client_data as *mut String;
        let child_expression = TranslateExpression(cursor);

        if !child_expression.Empty() {
            *expression = child_expression;
            return CXChildVisitResult::CXChildVisit_Break;
        }

        if cursor.kind == CXCursorKind::CXCursor_UnexposedExpr { CXChildVisitResult::CXChildVisit_Recurse }
        else { CXChildVisitResult::CXChildVisit_Break }
    }

    fn VisitChildExpressions(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        let expressions = client_data as *mut Vector<String>;
        let child_expression = TranslateExpression(cursor);

        if !child_expression.Empty() {
            expressions->PushBack(child_expression);
            return CXChildVisitResult::CXChildVisit_Continue;
        }

        if cursor.kind == CXCursorKind::CXCursor_UnexposedExpr { CXChildVisitResult::CXChildVisit_Recurse }
        else { CXChildVisitResult::CXChildVisit_Continue }
    }

    fn VisitAnyChild(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        *(client_data as *mut bool) = true;
        CXChildVisitResult::CXChildVisit_Break
    }

    fn VisitFunctionBody(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        let data = client_data as *mut FunctionBodyData;

        if parent.kind != CXCursorKind::CXCursor_CompoundStmt {
            return if cursor.kind == CXCursorKind::CXCursor_CompoundStmt { CXChildVisitResult::CXChildVisit_Recurse } else { CXChildVisitResult::CXChildVisit_Continue };
        }

        let statement = TranslateStatement(cursor);

        if statement.Empty() {
            data->valid = false;
            return CXChildVisitResult::CXChildVisit_Break;
        }

        data->body += "    " + statement;
        CXChildVisitResult::CXChildVisit_Continue
    }

    fn VisitProbe(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        if cursor.kind != CXCursorKind::CXCursor_VarDecl { return CXChildVisitResult::CXChildVisit_Continue; }
        let spelling = clang_getCursorSpelling(cursor);
        let name = clang_getCString(spelling).ToString();
        clang_disposeString(spelling);
        if !name.StartsWith("zirgen_value_") { return CXChildVisitResult::CXChildVisit_Continue; }

        let state = client_data as *mut GlobalState;
        let index = name.SubString(13).ToUnsignedInteger().UnwrapOr(state->pending.Length() as u64) as usize;
        if index >= state->pending.Length() { return CXChildVisitResult::CXChildVisit_Continue; }
        let (type_name, value) = ConstantValue(cursor, clang_getCanonicalType(clang_getCursorType(cursor)));

        if !type_name.Empty() {
            let &pending = state->pending[index];
            pending.file_state->macros += "const " + pending.name + ": " + type_name + " = " + value + ";\n";
        }

        CXChildVisitResult::CXChildVisit_Continue
    }

    fn VisitTopLevel(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> CXChildVisitResult {
        let location = clang_getCursorLocation(cursor);

        if clang_Location_isInSystemHeader(location) != 0 {
            return CXChildVisitResult::CXChildVisit_Continue;
        }

        let state = client_data as *mut GlobalState;
        let file_state = GetFileState(state, cursor);

        if file_state == null {
            return CXChildVisitResult::CXChildVisit_Continue;
        }

        match cursor.kind {
            CXCursorKind::CXCursor_InclusionDirective => {
                let file = clang_getIncludedFile(cursor);

                if file != null {
                    let spelling = clang_getFileName(file);
                    let path = NormalizePath(clang_getCString(spelling).ToString());
                    clang_disposeString(spelling);

                    let extension = SplitExtension(SplitPath(path).1).1;
                    let module = ModuleOf(state, path);

                    if !module.Empty() {
                        if !file_state->imports.Contains(module) { file_state->imports.PushBack(module); }
                    } else if extension == ".def" || extension == ".inc" {
                        if !state->included_from.Has(path) {
                            state->included_from[path] = file_state;
                        }
                    } else if !file_state->includes.Has(path) {
                        file_state->includes[path] = "vendor/" + SplitPath(state->output_directory).1 + '/' + GetRelativePath(path, state->root_directory) + ".zir";
                    }
                }
            },
            CXCursorKind::CXCursor_EnumDecl => {
                FlushAnonymousEnum(state, file_state);
                let spelling = clang_getCursorSpelling(cursor);
                let name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);

                if clang_Cursor_isAnonymous(cursor) != 0 {
                    state->last_anonymous_enum = cursor;
                } else {
                    EmitEnum(state, file_state, cursor, name, String());
                }
            },
            CXCursorKind::CXCursor_StructDecl | CXCursorKind::CXCursor_UnionDecl => {
                FlushAnonymousEnum(state, file_state);
                let spelling = clang_getCursorSpelling(cursor);
                let name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);

                if clang_Cursor_isAnonymous(cursor) == 0 {
                    EmitRecord(state, file_state, cursor, name);
                }
            },
            CXCursorKind::CXCursor_TypedefDecl => {
                let spelling = clang_getCursorSpelling(cursor);
                let name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);

                if name == "ssize_t" || name == "size_t" || name == "ptrdiff_t" || name == "intptr_t" || name == "uintptr_t" || name == "int8_t" || name == "uint8_t" || name == "int16_t" || name == "uint16_t" || name == "int32_t" || name == "uint32_t" || name == "int64_t" || name == "uint64_t" {
                    FlushAnonymousEnum(state, file_state);
                    return CXChildVisitResult::CXChildVisit_Continue;
                }

                let transpile_state = state->transpile_states.Get(name, TranspileState::None);

                if transpile_state == TranspileState::Defined {
                    FlushAnonymousEnum(state, file_state);
                    return CXChildVisitResult::CXChildVisit_Continue;
                }

                let underlying = clang_getTypedefDeclUnderlyingType(cursor);

                match underlying.kind {
                    CXTypeKind::CXType_Record => {
                        FlushAnonymousEnum(state, file_state);
                        let declaration = clang_getTypeDeclaration(underlying);
                        let declaration_spelling = clang_getCursorSpelling(declaration);
                        let declaration_name = String(clang_getCString(declaration_spelling));
                        clang_disposeString(declaration_spelling);

                        if declaration_name.Empty() || declaration_name == name {
                            EmitRecord(state, file_state, declaration, name);
                            return CXChildVisitResult::CXChildVisit_Continue;
                        }
                    },
                    CXTypeKind::CXType_Enum => {
                        FlushAnonymousEnum(state, file_state);
                        let declaration = clang_getTypeDeclaration(underlying);
                        let declaration_spelling = clang_getCursorSpelling(declaration);
                        let declaration_name = String(clang_getCString(declaration_spelling));
                        clang_disposeString(declaration_spelling);

                        if declaration_name.Empty() || declaration_name == name {
                            EmitEnum(state, file_state, declaration, name, String());
                            return CXChildVisitResult::CXChildVisit_Continue;
                        }
                    },
                    _ => {
                        if clang_Cursor_isNull(state->last_anonymous_enum) == 0 && (underlying.kind >= CXTypeKind::CXType_Char_U && underlying.kind <= CXTypeKind::CXType_Int128) {
                            let type_override = TypeToString(underlying);
                            EmitEnum(state, file_state, state->last_anonymous_enum, name, type_override);
                            state->last_anonymous_enum = clang_getNullCursor();
                            state->transpile_states[name] = TranspileState::Defined;
                            return CXChildVisitResult::CXChildVisit_Continue;
                        }
                    }
                }

                if transpile_state != TranspileState::None {
                    FlushAnonymousEnum(state, file_state);
                    return CXChildVisitResult::CXChildVisit_Continue;
                }

                FlushAnonymousEnum(state, file_state);
                state->transpile_states[name] = TranspileState::Defined;
                file_state->declarations += "type " + name + " = " + TypeToString(underlying) + ";\n";
            },
            CXCursorKind::CXCursor_MacroDefinition => {
                FlushAnonymousEnum(state, file_state);
                TranslateMacro(state, file_state, cursor);
            },
            CXCursorKind::CXCursor_VarDecl => {
                FlushAnonymousEnum(state, file_state);
                EmitVariable(state, file_state, cursor);
            },
            CXCursorKind::CXCursor_FunctionDecl => {
                FlushAnonymousEnum(state, file_state);
                let spelling = clang_getCursorSpelling(cursor);
                let name = clang_getCString(spelling).ToString();
                clang_disposeString(spelling);

                let transpile_state = state->transpile_states.Get(name, TranspileState::None);
                if transpile_state == TranspileState::Defined { return CXChildVisitResult::CXChildVisit_Continue; }
                state->transpile_states[name] = TranspileState::Defined;

                let mut arguments = String();
                let num_args = clang_Cursor_getNumArguments(cursor);
                let ret_type = clang_getCursorResultType(cursor);

                for i in 0..num_args {
                    let argument = clang_Cursor_getArgument(cursor, i as u32);
                    let argument_spelling = clang_getCursorSpelling(argument);
                    let mut argument_name = String(clang_getCString(argument_spelling));
                    clang_disposeString(argument_spelling);

                    if argument_name.Empty() {
                        argument_name = "_p" + String::FromInteger(i as i64);
                    } else if StringToKeyword(argument_name) != TokenType::UNKNOWN {
                        argument_name = "_" + argument_name;
                    }

                    let _type = clang_getCursorType(argument);

                    if _type.kind == CXTypeKind::CXType_ConstantArray {
                        let element_type = clang_getArrayElementType(_type);
                        let prefix = if clang_isConstQualifiedType(element_type) != 0 { "*" } else { "*mut " };
                        arguments += argument_name + ": " + prefix + TypeToString(element_type);
                    } else {
                        arguments += argument_name + ": " + TypeToString(_type);
                    }

                    if i < num_args - 1 {
                        arguments += ", ";
                    }
                }

                if clang_Cursor_isVariadic(cursor) != 0 {
                    if num_args > 0 {
                        arguments += ", ";
                    } arguments += "...";
                }

                if clang_isCursorDefinition(cursor) != 0 {
                    let mut body = FunctionBodyData();
                    clang_visitChildren(cursor, VisitFunctionBody, &mut body as CXClientData);
                    if !body.valid { return CXChildVisitResult::CXChildVisit_Continue; }
                    let mut declaration = "fn " + name + "(" + arguments + ")";

                    if clang_getCanonicalType(ret_type).kind != CXTypeKind::CXType_Void {
                        declaration += " -> " + TypeToString(ret_type);
                    }

                    declaration += " {\n" + body.body + "}\n\n";
                    EnsureBlankLine(file_state->declarations);
                    file_state->declarations += declaration;
                } else {
                    let mut declaration = "    fn " + name + "(" + arguments + ")";

                    if clang_getCanonicalType(ret_type).kind != CXTypeKind::CXType_Void {
                        declaration += " -> " + TypeToString(ret_type);
                    }

                    file_state->extern_functions += declaration + ";\n";
                }
            },
            _ => {
                FlushAnonymousEnum(state, file_state);
            }
        }

        CXChildVisitResult::CXChildVisit_Continue
    }
}

fn IsDirectory(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());
    if attributes == INVALID_FILE_ATTRIBUTES { return false; }
    (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
}

fn CollectHeaders(directory: &String, headers: &mut Vector<String>) {
    let mut find_data: WIN32_FIND_DATAA;
    let handle = FindFirstFileA((directory + "\\*").Data(), &mut find_data);
    if handle == INVALID_HANDLE_VALUE { return; }

    loop {
        let name = String(&find_data.cFileName[0] as *i8);

        if name != "." && name != ".." {
            let path = directory + "\\" + name;

            if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
                CollectHeaders(path, headers);
            } else if name.Length() >= 2 && SplitExtension(name).1 == ".h" {
                headers.PushBack(path);
            }
        }

        if FindNextFileA(handle, &mut find_data) == 0 {
            break;
        }
    }

    FindClose(handle);
}

fn Main(args: &mut Vector<String>) -> i32 {
    let (_, executable) = SplitPath(args[0]);

    if args.Length() < 2 {
        WriteLine("Usage: " + executable + " <header.h | input_directory> [-o output_directory] [-I include_directory] [-ignore file_name] [-from module record_name|directory]");
        return 1;
    }

    let mut clang_args = Vector<*i8>();
    clang_args.PushBack("-x");
    clang_args.PushBack("c-header");

    let input = args[1];
    let mut output_directory = String();
    let mut ignored_files = Vector<String>();
    let mut state: GlobalState;
    let mut i: usize = 2;

    while i < args.Length() {
        let &arg = args[i];

        if arg == "-o" {
            i += 1;

            if i < args.Length() {
                output_directory = args[i];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-o'.");
                return 1;
            }
        } else if arg == "-ignore" {
            i += 1;

            if i < args.Length() {
                ignored_files.PushBack(args[i]);
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-ignore'.");
                return 1;
            }
        } else if arg == "-from" {
            i += 2;

            if i < args.Length() && IsDirectory(args[i]) {
                state.modules[NormalizePath(args[i])] = args[i - 1];
            } else if i < args.Length() {
                state.external[args[i]] = args[i - 1];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing arguments to '-from'.");
                return 1;
            }
        } else {
            clang_args.PushBack(arg.Data());
        } i += 1;
    }

    let mut input_files = Vector<String>();

    if IsDirectory(input) {
        CollectHeaders(input, &mut input_files);
    } else {
        input_files.PushBack(input);
    }

    if input_files.Empty() {
        WriteLine(executable + ": \x1b[31mError:\x1b[0m No header files found in '" + input + "'.");
        return 1;
    }

    let root_directory: String = if IsDirectory(input) {
        input
    } else {
        SplitPath(input).0
    };

    if output_directory.Empty() {
        let name: String = if IsDirectory(input) {
            SplitPath(input).1
        } else {
            SplitPath(SplitPath(input).0).1
        };

        output_directory = JoinPath("include".ToString(), JoinPath("vendor".ToString(), name));
    }

    EnsureDirectory(output_directory);
    let index = clang_createIndex(0, 1);

    if index == null {
        WriteLine(executable + ": \x1b[31mError:\x1b[0m Failed to create clang index.");
        return 1;
    }

    state.output_directory = output_directory;
    state.root_directory = root_directory;
    state.last_anonymous_enum = clang_getNullCursor();

    for header_file in input_files {
        let translation_unit = clang_parseTranslationUnit(index, header_file.Data(), clang_args.Data(), clang_args.Length() as i32, null, 0, CXTranslationUnit_Flags::CXTranslationUnit_DetailedPreprocessingRecord as u32);

        if translation_unit != null {
            state.translation_unit = translation_unit;
            let root = clang_getTranslationUnitCursor(translation_unit);
            clang_visitChildren(root, VisitTopLevel, &mut state as CXClientData);
            clang_disposeTranslationUnit(translation_unit);
        }

        EvaluateMacros(&mut state, header_file, clang_args);
    }

    FlushAnonymousEnum(&mut state, null);

    let files = state.files.Values();
    let mut valid_files = Vector<String>();

    for file_state in files {
        if !ignored_files.Contains(file_state->name) && !file_state->declarations.Empty() || !file_state->extern_functions.Empty() {
            valid_files.PushBack(file_state->path);
        }
    }

    let mut entries = Vector<String>();

    for header_file in input_files {
        let path = NormalizePath(header_file);
        if !state.files.Has(path) { continue; }

        if valid_files.Contains(path) {
            entries.PushBack(path);
            continue;
        }

        for include_path in state.files[path]->includes.Keys() {
            if valid_files.Contains(include_path) && !entries.Contains(include_path) { entries.PushBack(include_path); }
        }
    }

    let single = valid_files.Length() == 1;

    for file_state in files {
        if !valid_files.Contains(file_state->path) {
            continue;
        }

        let mut content = String();
        let mut has_include = false;

        if !file_state->imports.Empty() {
            content += "#[include ";

            for j in 0..file_state->imports.Length() {
                if j > 0 { content += ", "; }
                content += "\"" + file_state->imports[j] + "\"";
            }

            content += " : *]\n";
        }

        for include_path in file_state->includes.Keys() {
            if valid_files.Contains(include_path) {
                if !has_include {
                    EnsureBlankLine(content);
                    content += "#[include ";
                    has_include = true;
                } else {
                    content += ", ";
                }

                content += "\"" + file_state->includes[include_path] + "\"";
            }
        }

        if has_include {
            content += " : *]\n";
        }

        if !file_state->macros.Empty() {
            EnsureBlankLine(content);
            content += file_state->macros;
        }

        if !file_state->declarations.Empty() {
            EnsureBlankLine(content);
            content += file_state->declarations;
        }

        if !file_state->extern_functions.Empty() {
            EnsureBlankLine(content);
            content += "extern \"C\" {\n";
            content += file_state->extern_functions;
            content += "}\n";
        }

        let mut end = content.Length();

        while end >= 2 && content[end - 1] == '\n' && content[end - 2] == '\n' {
            end -= 1;
        }

        let name = if single { "Entry".ToString() } else { file_state->relative_path };
        let output_path = JoinPath(output_directory, name + ".zir");
        EnsureDirectory(SplitPath(output_path).0);

        if _WriteFile(output_path, content.SubString(0, end)).IsOk() {
            WriteLine(executable + ": \x1b[32mInfo:\x1b[0m Generated '" + output_path + "'.");
        }
    }

    if !single && !entries.Empty() {
        let mut content = "#[include ".ToString();

        for j in 0..entries.Length() {
            if j > 0 { content += ", "; }
            content += "\"vendor/" + SplitPath(output_directory).1 + '/' + state.files[entries[j]]->relative_path + ".zir\"";
        }

        content += " : *]\n";
        let entry_path = JoinPath(output_directory, "Entry.zir".ToString());

        if _WriteFile(entry_path, content).IsOk() {
            WriteLine(executable + ": \x1b[32mInfo:\x1b[0m Generated '" + entry_path + "'.");
        }
    }

    clang_disposeIndex(index);
    0
}
