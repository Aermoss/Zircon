#[include "std/io", "std/str", "std/opt", "std/res" : *]

fn Divide(a: f64, b: f64) -> Result<f64, *i8> {
    if b == 0.0 {
        return Result<f64, *i8>::Err("division by zero");
    }

    return Result<f64, *i8>::Ok(a / b);
}

fn Find(haystack: *i8, needle: i8) -> Option<usize> {
    let mut i: usize = 0;

    while haystack[i] != '\0' {
        if haystack[i] == needle {
            return Option<usize>::Some(i);
        } i += 1;
    }

    return Option<usize>::None;
}

fn Main(args: &mut Vector<String>) -> i32 {
    let result = Divide(10.0, 3.0);

    match result {
        Result<f64, *i8>::Ok(value) => { WriteLine("10 / 3 = " + String::FromFloat(value)); },
        Result<f64, *i8>::Err(message) => { WriteLine("Error: " + message.ToString()); }
    }

    let error = Divide(1.0, 0.0);

    match error {
        Result<f64, *i8>::Ok(value) => { WriteLine("Result: " + String::FromFloat(value)); },
        Result<f64, *i8>::Err(message) => { WriteLine("Error: " + message.ToString() + " (expected)"); }
    }

    let found = Find("hello", 'l');

    match found {
        Option<usize>::Some(index) => { WriteLine("Found at index: " + String::FromInteger(index as u64)); },
        Option<usize>::None => { WriteLine("Not found"); }
    }

    let missing = Find("hello", 'z');

    if let Option<usize>::Some(index) = missing {
        WriteLine("Found at: " + String::FromInteger(index as u64));
    } else {
        WriteLine("Not found (expected)");
    }

    return 0;
}
