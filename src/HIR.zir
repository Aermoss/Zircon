#[include "std/str", "std/vec", "std/arena",
    "src/AST.zir", "src/Generic.zir", "src/Logger.zir" : *]

enum HIRTypeKind: u8 {
    Void, Boolean, Character, Integer, Float, Pointer, Reference, Array,
    Function, Class, Structure, Enumeration, Variant
}

class HIRType {
    pub kind: HIRTypeKind;

    HIRType(&mut this, kind: HIRTypeKind) {
        this.kind = kind;
    }

    pub fn IsMutable(&this) -> bool { return (this.kind == HIRTypeKind::Pointer && (this as *HIRPointerType)->mutable) || (this.kind == HIRTypeKind::Reference && (this as *HIRReferenceType)->mutable); }
    pub fn IsLiteral(&this) -> bool { return (this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->literal) || (this.kind == HIRTypeKind::Float && (this as *HIRFloatType)->literal); }
    pub fn IsSigned(&this) -> bool { return this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->signed; }

    pub fn IsVoid(&this) -> bool { return this.kind == HIRTypeKind::Void; }
    pub fn IsBoolean(&this) -> bool { return this.kind == HIRTypeKind::Boolean; }
    pub fn IsCharacter(&this) -> bool { return this.kind == HIRTypeKind::Character; }
    pub fn IsInteger(&this) -> bool { return this.kind == HIRTypeKind::Integer; }
    pub fn IsIntegerPointer(&this) -> bool { return this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->native; }
    pub fn IsIntegerLiteral(&this) -> bool { return this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->literal; }
    pub fn IsFloat(&this) -> bool { return this.kind == HIRTypeKind::Float; }
    pub fn IsFloatLiteral(&this) -> bool { return this.kind == HIRTypeKind::Float && (this as *HIRFloatType)->literal; }
    pub fn IsPointer(&this) -> bool { return this.kind == HIRTypeKind::Pointer || this.kind == HIRTypeKind::Reference; }
    pub fn IsNullPointer(&this) -> bool { return this.kind == HIRTypeKind::Pointer && (this as *HIRPointerType)->pointee->kind == HIRTypeKind::Void; }
    pub fn IsReference(&this) -> bool { return this.kind == HIRTypeKind::Reference; }
    pub fn IsArray(&this) -> bool { return this.kind == HIRTypeKind::Array; }
    pub fn IsFunction(&this) -> bool { return this.kind == HIRTypeKind::Function; }
    pub fn IsClass(&this) -> bool { return this.kind == HIRTypeKind::Class; }
    pub fn IsStructure(&this) -> bool { return this.kind == HIRTypeKind::Structure; }
    pub fn IsEnumeration(&this) -> bool { return this.kind == HIRTypeKind::Enumeration; }
    pub fn IsVariant(&this) -> bool { return this.kind == HIRTypeKind::Variant; }

    pub fn IsTrivial(&this) -> bool {
        if this.IsBoolean() || this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsPointer() || this.IsFunction() {
            return true;
        }

        if this.IsArray() {
            return (this as *HIRArrayType)->element->IsTrivial();
        }

        if this.HasFields() {
            for field in this.Fields() {
                if !field->_type->IsTrivial() {
                    return false;
                }
            }
        }

        if this.HasMethods() {
            if !this.Methods().Empty() {
                return false;
            }
        }

        if this.IsClass() {
            let declaration = (this as *HIRClassType)->declaration;

            if declaration->destructor != null || !declaration->constructors.Empty() {
                return false;
            }
        }

        if this.IsClass() || this.IsStructure() || this.IsEnumeration() {
            return true;
        } return false;
    }

    pub fn FindField(&this, name: &String, path: &mut Vector<u32>, ambiguous: &mut bool) -> *HIRFieldDeclaration {
        let parents = (this as *HIRClassType)->declaration->parents;
        let (index, mut result: *HIRFieldDeclaration) = (this.Index(name), null);
        if index != -1 { return this.Fields()[index as usize]; }

        for i in 0..parents.Size() {
            let parent: *HIRType = parents[i];
            let mut parent_path = Vector<u32>();
            let field = parent->FindField(name, &mut parent_path, ambiguous);
            if field == null { continue; }

            if result != null {
                ambiguous = true;
                return result;
            }
            
            path.Clear();
            path.PushBack(i as u32);
            path += parent_path;
            result = field;
        } return result;
    }

    pub fn FindParentPath(&this, other: &HIRType, path: &mut Vector<u32>) -> bool {
        let parents = (this as *HIRClassType)->declaration->parents;

        for i in 0..parents.Size() {
            let parent: *HIRType = parents[i];
            path.PushBack(i as u32);

            if *parent == other || parent->FindParentPath(other, path) {
                return true;
            }

            path.PopBack();
        } return false;
    }

    pub fn IsDerivedFrom(&this, other: &HIRType) -> bool {
        for parent in (this as *HIRClassType)->declaration->parents {
            if *parent == other || parent->IsDerivedFrom(other) {
                return true;
            }
        } return false;
    }

    pub fn IsCompatible(&this, other: &HIRType) -> bool {
        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return true;
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if other.Pointee().IsDerivedFrom(this.Pointee()) {
                    return true;
                }
            }
        }

        if this.IsClass() && other.IsClass() {
            if other.IsDerivedFrom(this) {
                return true;
            }
        } return this == other;
    }

    pub fn IsMutabilityCompatible(&this, other: &HIRType) -> bool {
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } return true;
    }

    pub fn IsSame(&this, other: &HIRType) -> bool {
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() || left->IsReference() != right->IsReference() || right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } return this == other;
    }

    pub fn ScorePointer(&this, other: &HIRType, base: u64) -> u64 {
        let mut reference_mismatch = false;
        let mut mutability_mismatch = false;
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;
        let mut score = base;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return 0;
            }

            mutability_mismatch |= left->IsMutable() != right->IsMutable();
            reference_mismatch |= left->IsReference() != right->IsReference();
            (left, right) = (left->Pointee(), right->Pointee());
        }

        if reference_mismatch { score -= 10; }
        if mutability_mismatch { score -= 1; }
        return score;
    }

    pub fn ScoreParameter(&this, other: &HIRType) -> u64 {
        if other.IsLiteral() {
            if this.IsInteger() && other.IsInteger() {
                let (left, right) = (this as *HIRIntegerType, other as *HIRIntegerType);

                if left->width == right->width && left->signed == right->signed && left->native == right->native {
                    return 100;
                } return 1;
            } else if this.IsFloat() && other.IsFloat() {
                if (this as *HIRFloatType)->width == (other as *HIRFloatType)->width {
                    return 100;
                } return 1;
            } return 0;
        }

        if this == other {
            return this.ScorePointer(other, 100);
        }

        if this.IsReference() {
            let score = this.Pointee().ScoreParameter(other);
            if score != 0 { return score - 3; }
        }

        if other.IsReference() {
            let score = this.ScoreParameter(other.Pointee());
            if score != 0 { return score - 3; }
        }

        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return this.ScorePointer(other, 30);
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if other.Pointee().IsDerivedFrom(this.Pointee()) {
                    return this.ScorePointer(other, 70);
                }
            }
        }

        if this.IsClass() && other.IsClass() {
            if other.IsDerivedFrom(this) {
                return 70;
            }
        } return 0;
    }

    pub fn Pointee(&this) -> &HIRType {
        if !this.IsPointer() {
            Logger::Log("HIRType", "Not a pointer!", LogSeverity::Fatal);
        }

        if this.IsReference() {
            return (this as *HIRReferenceType)->referent;
        } else {
            return (this as *HIRPointerType)->pointee;
        }
    }

    pub fn Width(&this) -> u32 {
        if !this.IsBoolean() && !this.IsCharacter() && !this.IsInteger() && !this.IsFloat() && !this.IsEnumeration() {
            Logger::Log("HIRType", "Not a boolean, character, integer, float or enumeration!", LogSeverity::Fatal);
        }

        if this.IsBoolean() { return 1; }
        else if this.IsCharacter() { return 8; }
        else if this.IsInteger() { return (this as *HIRIntegerType)->width; }
        else if this.IsFloat() { return (this as *HIRFloatType)->width; }
        else { return (this as *HIREnumerationType)->underlying->width; }
    }

    pub fn Alignment(&this) -> usize {
        if this.IsBoolean() {
            return 1;
        } else if this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsEnumeration() {
            return (this.Width() / 8) as usize;
        } else if this.IsPointer() || this.IsFunction() {
            return LLVMPointerSize(llvm_lowerer->target->layout) as usize;
        } else if this.IsArray() {
            return this.Element().Alignment();
        } else if this.HasFields() {
            let mut alignment: usize = 1;

            if this.IsClass() {
                for parent in (this as *HIRClassType)->declaration->parents {
                    let parent_alignment = parent->Alignment();
                    if parent_alignment > alignment { alignment = parent_alignment; }
                }
            }

            for field in this.Fields() {
                let field_alignment = field->_type->Alignment();
                if field_alignment > alignment { alignment = field_alignment; }
            } return alignment;
        } else if this.IsVariant() {
            let mut alignment: usize = 1;

            for member in (this as *HIRVariantType)->declaration->members {
                for field in member->fields {
                    let field_alignment = field->_type->Alignment();
                    if field_alignment > alignment { alignment = field_alignment; }
                }
            } return alignment;
        } else {
            return 1;
        }
    }

    pub fn Size(&this) -> usize {
        if this.IsVoid() {
            return 0;
        } else if this.IsBoolean() {
            return 1;
        } else if this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsEnumeration() {
            return (this.Width() / 8) as usize;
        } else if this.IsPointer() || this.IsFunction() {
            return LLVMPointerSize(llvm_lowerer->target->layout) as usize;
        } else if this.IsArray() {
            return this.Element().Size() * this.Length();
        } else if this.HasFields() {
            let mut size: usize = 0;
            let mut alignment: usize = 1;

            if this.IsClass() {
                for parent in (this as *HIRClassType)->declaration->parents {
                    let parent_alignment = parent->Alignment();
                    if parent_alignment > alignment { alignment = parent_alignment; }
                    let remainder = size % parent_alignment;
                    if remainder != 0 { size += parent_alignment - remainder; }
                    size += parent->Size();
                }
            }

            for field in this.Fields() {
                let field_type = field->_type;
                let field_alignment = field_type->Alignment();
                if field_alignment > alignment { alignment = field_alignment; }
                let remainder = size % field_alignment;
                if remainder != 0 { size += field_alignment - remainder; }
                size += field_type->Size();
            }

            let remainder = size % alignment;
            if remainder != 0 { size += alignment - remainder; }
            return size;
        } else if this.IsVariant() {
            let mut size: usize = 0;

            for member in (this as *HIRVariantType)->declaration->members {
                let mut member_size: usize = 1;
                let mut member_alignment: usize = 1;

                for field in member->fields {
                    let field_alignment = field->_type->Alignment();
                    if field_alignment > member_alignment { member_alignment = field_alignment; }
                    let remainder = member_size % field_alignment;
                    if remainder != 0 { member_size += field_alignment - remainder; }
                    member_size += field->_type->Size();
                }

                let remainder = member_size % member_alignment;
                if remainder != 0 { member_size += member_alignment - remainder; }
                if member_size > size { size = member_size; }
            } return size;
        } else {
            return 0;
        }
    }

    pub fn Length(&this) -> usize {
        if !this.IsArray() {
            Logger::Log("HIRType", "Not an array!", LogSeverity::Fatal);
        } return (this as *HIRArrayType)->length;
    }

    pub fn Element(&this) -> &HIRType {
        if !this.IsArray() {
            Logger::Log("HIRType", "Not an array!", LogSeverity::Fatal);
        } return (this as *HIRArrayType)->element;
    }

    pub fn Parameters(&this) -> &Vector<*HIRType> {
        if !this.IsFunction() {
            Logger::Log("HIRType", "Not a function!", LogSeverity::Fatal);
        } return (this as *HIRFunctionType)->parameters;
    }

    pub fn Return(&this) -> &HIRType {
        if !this.IsFunction() {
            Logger::Log("HIRType", "Not a function!", LogSeverity::Fatal);
        } return (this as *HIRFunctionType)->_return;
    }

    pub fn Fields(&this) -> &Vector<*HIRFieldDeclaration> {
        if !this.HasFields() {
            Logger::Log("HIRType", "Not a class or structure!", LogSeverity::Fatal);
        }

        if this.IsClass() {
            return (this as *HIRClassType)->declaration->fields;
        } else {
            return (this as *HIRStructureType)->declaration->fields;
        }
    }

    pub fn HasFields(&this) -> bool {
        return this.IsClass() || this.IsStructure();
    }

    pub fn Index(&this, name: &String) -> isize {
        let fields = this.Fields();

        for i in 0..fields.Size() {
            let field: *HIRFieldDeclaration = fields[i];

            if field->name == name {
                return i as isize;
            }
        } return -1;
    }

    pub fn Methods(&this) -> &Vector<*mut HIRFunctionDeclaration> {
        if !this.HasMethods() {
            Logger::Log("HIRType", "Not a class, structure or variant!", LogSeverity::Fatal);
        }

        if this.IsClass() {
            return (this as *HIRClassType)->declaration->methods;
        } else if this.IsStructure() {
            return (this as *HIRStructureType)->declaration->methods;
        } else {
            return (this as *HIRVariantType)->declaration->methods;
        }
    }

    pub fn HasMethods(&this) -> bool {
        return this.IsClass() || this.IsStructure() || this.IsVariant();
    }

    pub fn GetCandidates(&this, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut found = false;

        if this.IsClass() {
            let declaration = (this as *HIRClassType)->declaration;

            if declaration->name == name {
                for constructor in declaration->constructors {
                    result.PushBack(constructor);
                } return result;
            } else if ('~' + declaration->name) == name {
                result.PushBack(declaration->destructor);
                return result;
            }
        }

        this.CollectMethods(name, result, found);

        if result.Empty() && !test {
            if found {
                Logger::Log("Method '" + name + "' is not accessible.", node, LogSeverity::Error);
            } else {
                Logger::Log("Invalid arguments for method: '" + name + "'.", node, LogSeverity::Error);
            }
        } return result;
    }

    fn CollectMethods(&this, name: &String, result: &mut Vector<*HIRFunctionDeclaration>, found: &mut bool) {
        for method in this.Methods() {
            if method->name != name {
                continue;
            }

            if method->public || (hir_lowerer->current_type != null && *hir_lowerer->current_type == this) {
                result.PushBack(method);
            } found = true;
        }

        if !found && this.IsClass() && name != "operator=" {
            for parent in (this as *HIRClassType)->declaration->parents {
                parent->CollectMethods(name, result, found);
            }
        }
    }

    pub fn operator==(&this, other: &HIRType) -> bool {
        if (this.IsVoid() && other.IsVoid()) || (this.IsBoolean() && other.IsBoolean()) || (this.IsCharacter() && other.IsCharacter()) {
            return true;
        } else if this.IsInteger() && other.IsInteger() {
            let (left, right) = (this as *HIRIntegerType, other as *HIRIntegerType);
            return left->signed == right->signed && left->width == right->width && left->native == right->native;
        } else if this.IsFloat() && other.IsFloat() {
            return (this as *HIRFloatType)->width == (other as *HIRFloatType)->width;
        } else if (this.IsPointer() || this.IsArray()) && (other.IsPointer() || other.IsArray()) {
            let (mut left: *HIRType, mut right: *HIRType) = (null, null);

            if this.IsArray() {
                left = (this as *HIRArrayType)->element;
            } else if this.IsReference() {
                left = (this as *HIRReferenceType)->referent;
            } else {
                left = (this as *HIRPointerType)->pointee;
            }

            if other.IsArray() {
                right = (other as *HIRArrayType)->element;
            } else if other.IsReference() {
                right = (other as *HIRReferenceType)->referent;
            } else {
                right = (other as *HIRPointerType)->pointee;
            }

            return *left == *right;
        } else if this.IsArray() && other.IsArray() {
            let (left, right) = (this as *HIRArrayType, other as *HIRArrayType);
            return left->element == right->element && left->length == right->length;
        } else if this.IsFunction() && other.IsFunction() {
            let (left, right) = (this as *HIRFunctionType, other as *HIRFunctionType);

            if left->parameters.Size() != right->parameters.Size() {
                return false;
            }

            for i in 0..left->parameters.Size() {
                let (left_parameter: *HIRType, right_parameter: *HIRType) = (left->parameters[i], right->parameters[i]);

                if left_parameter != right_parameter {
                    if left_parameter == null || right_parameter == null { return false; }
                    if *left_parameter != *right_parameter { return false; }
                }
            }

            let (left_return, right_return) = (left->_return, right->_return);

            if left_return != right_return {
                if left_return == null || right_return == null { return false; }
                if *left_return != *right_return { return false; }
            } return true;
        } else if this.IsClass() && other.IsClass() {
            return (this as *HIRClassType)->declaration == (other as *HIRClassType)->declaration;
        } else if this.IsStructure() && other.IsStructure() {
            return (this as *HIRStructureType)->declaration == (other as *HIRStructureType)->declaration;
        } else if this.IsEnumeration() && other.IsEnumeration() {
            return (this as *HIREnumerationType)->declaration == (other as *HIREnumerationType)->declaration;
        } else if this.IsVariant() && other.IsVariant() {
            return (this as *HIRVariantType)->declaration == (other as *HIRVariantType)->declaration;
        } else {
            return false;
        }
    }

    pub fn operator!=(&this, other: &HIRType) -> bool {
        return !(this == other);
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRTypeKind::Void {
            return (this as *HIRVoidType)->ToString();
        } else if this.kind == HIRTypeKind::Boolean {
            return (this as *HIRBooleanType)->ToString();
        } else if this.kind == HIRTypeKind::Character {
            return (this as *HIRCharacterType)->ToString();
        } else if this.kind == HIRTypeKind::Integer {
            return (this as *HIRIntegerType)->ToString();
        } else if this.kind == HIRTypeKind::Float {
            return (this as *HIRFloatType)->ToString();
        } else if this.kind == HIRTypeKind::Pointer {
            return (this as *HIRPointerType)->ToString();
        } else if this.kind == HIRTypeKind::Reference {
            return (this as *HIRReferenceType)->ToString();
        } else if this.kind == HIRTypeKind::Array {
            return (this as *HIRArrayType)->ToString();
        } else if this.kind == HIRTypeKind::Function {
            return (this as *HIRFunctionType)->ToString();
        } else if this.kind == HIRTypeKind::Class {
            return (this as *HIRClassType)->ToString();
        } else if this.kind == HIRTypeKind::Structure {
            return (this as *HIRStructureType)->ToString();
        } else if this.kind == HIRTypeKind::Enumeration {
            return (this as *HIREnumerationType)->ToString();
        } else if this.kind == HIRTypeKind::Variant {
            return (this as *HIRVariantType)->ToString();
        } else {
            return "<invalid type>".ToString();
        }
    }
}

class HIRVoidType : HIRType {
    HIRVoidType(&mut this) : HIRType(HIRTypeKind::Void) {}

    pub fn ToString(&this) -> String {
        return "void".ToString();
    }
}

class HIRBooleanType : HIRType {
    HIRBooleanType(&mut this) : HIRType(HIRTypeKind::Boolean) {}

    pub fn ToString(&this) -> String {
        return "bool".ToString();
    }
}

class HIRCharacterType : HIRType {
    HIRCharacterType(&mut this) : HIRType(HIRTypeKind::Character) {}

    pub fn ToString(&this) -> String {
        return "char".ToString();
    }
}

class HIRIntegerType : HIRType {
    pub width: u32,
    pub signed: bool,
    pub literal: bool,
    pub native: bool;

    HIRIntegerType(&mut this, width: u32, signed: bool, literal: bool, native: bool) : HIRType(HIRTypeKind::Integer) {
        (this.width, this.signed, this.literal, this.native) = (width, signed, literal, native);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            if !this.native {
                return (this.signed ? 'i' : 'u') + String::FromInteger(this.width as u64);
            } else {
                return (this.signed ? "isize" : "usize").ToString();
            }
        } else {
            return "<integer literal>".ToString();
        }
    }
}

class HIRFloatType : HIRType {
    pub width: u32,
    pub literal: bool;

    HIRFloatType(&mut this, width: u32, literal: bool) : HIRType(HIRTypeKind::Float) {
        (this.width, this.literal) = (width, literal);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            return 'f' + String::FromInteger(this.width as u64);
        } else {
            return "<float literal>".ToString();
        }
    }
}

class HIRPointerType : HIRType {
    pub pointee: *HIRType,
    pub mutable: bool;

    HIRPointerType(&mut this, pointee: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Pointer) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "*mut " : "*") + this.pointee->ToString();
    }
}

class HIRReferenceType : HIRType {
    pub referent: *HIRType,
    pub mutable: bool;

    HIRReferenceType(&mut this, referent: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Reference) {
        (this.referent, this.mutable) = (referent, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "&mut " : "&") + this.referent->ToString();
    }
}

class HIRArrayType : HIRType {
    pub element: *HIRType,
    pub length: usize;

    HIRArrayType(&mut this, element: *HIRType, length: usize) : HIRType(HIRTypeKind::Array) {
        (this.element, this.length) = (element, length);
    }

    pub fn ToString(&this) -> String {
        return '[' + this.element->ToString() + "; " + String::FromInteger(this.length as u64) + ']';
    }
}

class HIRFunctionType : HIRType {
    pub parameters: Vector<*HIRType>,
    pub _return: *HIRType;

    HIRFunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) : HIRType(HIRTypeKind::Function) {
        (this.parameters, this._return) = (parameters, _return);
    }

    pub fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *HIRType = this.parameters[i];
            result += parameter->ToString();
        } result += ')';

        if this._return->kind != HIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        } return result;
    }
}

class HIRClassType : HIRType {
    pub declaration: *HIRClassDeclaration;

    HIRClassType(&mut this, declaration: *HIRClassDeclaration) : HIRType(HIRTypeKind::Class) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.declaration->name;
    }
}

class HIRStructureType : HIRType {
    pub declaration: *HIRStructureDeclaration;

    HIRStructureType(&mut this, declaration: *HIRStructureDeclaration) : HIRType(HIRTypeKind::Structure) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.declaration->name;
    }
}

class HIREnumerationType : HIRType {
    pub declaration: *HIREnumerationDeclaration,
    pub underlying: *HIRIntegerType;

    HIREnumerationType(&mut this, declaration: *HIREnumerationDeclaration, underlying: *HIRIntegerType) : HIRType(HIRTypeKind::Enumeration) {
        (this.declaration, this.underlying) = (declaration, underlying);
    }

    pub fn ToString(&this) -> String {
        return '%' + this.declaration->name;
    }
}

class HIRVariantType : HIRType {
    pub declaration: *HIRVariantDeclaration;

    HIRVariantType(&mut this, declaration: *HIRVariantDeclaration) : HIRType(HIRTypeKind::Variant) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.declaration->name;
    }
}

enum HIRPatternKind: u8 {
    Wildcard, Rest, Literal, Identifier, Tuple, Field, Structure, Variant, Or
}

class HIRPattern {
    pub kind: HIRPatternKind;

    HIRPattern(&mut this, kind: HIRPatternKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRPatternKind::Wildcard {
            return (this as *HIRWildcardPattern)->ToString();
        } else if this.kind == HIRPatternKind::Rest {
            return (this as *HIRRestPattern)->ToString();
        } else if this.kind == HIRPatternKind::Literal {
            return (this as *HIRLiteralPattern)->ToString();
        } else if this.kind == HIRPatternKind::Identifier {
            return (this as *HIRIdentifierPattern)->ToString();
        } else if this.kind == HIRPatternKind::Tuple {
            return (this as *HIRTuplePattern)->ToString();
        } else if this.kind == HIRPatternKind::Field {
            return (this as *HIRFieldPattern)->ToString();
        } else if this.kind == HIRPatternKind::Structure {
            return (this as *HIRStructurePattern)->ToString();
        } else if this.kind == HIRPatternKind::Variant {
            return (this as *HIRVariantPattern)->ToString();
        } else if this.kind == HIRPatternKind::Or {
            return (this as *HIROrPattern)->ToString();
        } else {
            return "<invalid pattern>".ToString();
        }
    }
}

class HIRWildcardPattern : HIRPattern {
    HIRWildcardPattern(&mut this) : HIRPattern(HIRPatternKind::Wildcard) {}

    pub fn ToString(&this) -> String {
        return '_'.ToString();
    }
}

class HIRRestPattern : HIRPattern {
    HIRRestPattern(&mut this) : HIRPattern(HIRPatternKind::Rest) {}

    pub fn ToString(&this) -> String {
        return "..".ToString();
    }
}

class HIRLiteralPattern : HIRPattern {
    pub literal: *HIRExpression;

    HIRLiteralPattern(&mut this, literal: *HIRExpression) : HIRPattern(HIRPatternKind::Literal) {
        this.literal = literal;
    }

    pub fn ToString(&this) -> String {
        return this.literal->ToString();
    }
}

class HIRIdentifierPattern : HIRPattern {
    pub name: String,
    pub _type: *HIRType,
    pub mutable: bool;

    HIRIdentifierPattern(&mut this, name: String, _type: *HIRType, mutable: bool) : HIRPattern(HIRPatternKind::Identifier) {
        (this.name, this._type, this.mutable) = (name, _type, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();
        if this.mutable { result += "mut "; }
        return result + this.name;
    }
}

class HIRTuplePattern : HIRPattern {
    pub patterns: Vector<*HIRPattern>;

    HIRTuplePattern(&mut this, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Tuple) {
        this.patterns = patterns;
    }

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            let pattern: *HIRPattern = this.patterns[i];
            result += pattern->ToString();
        } return result + ')';
    }
}

class HIRFieldPattern : HIRPattern {
    pub name: String,
    pub pattern: *HIRPattern;

    HIRFieldPattern(&mut this, name: String, pattern: *HIRPattern) : HIRPattern(HIRPatternKind::Field) {
        (this.name, this.pattern) = (name, pattern);
    }

    pub fn ToString(&this) -> String {
        return this.name + ": " + this.pattern->ToString();
    }
}

class HIRStructurePattern : HIRPattern {
    pub declaration: *HIRStructureDeclaration,
    pub patterns: Vector<*HIRPattern>;

    HIRStructurePattern(&mut this, declaration: *HIRStructureDeclaration, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Structure) {
        (this.declaration, this.patterns) = (declaration, patterns);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.declaration->name + " { ";

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            let pattern: *HIRPattern = this.patterns[i];
            result += pattern->ToString();
        } return result + " }";
    }
}

class HIRVariantPattern : HIRPattern {
    pub member: *HIRVariantMember,
    pub patterns: Vector<*HIRPattern>;

    HIRVariantPattern(&mut this, member: *HIRVariantMember, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Variant) {
        (this.member, this.patterns) = (member, patterns);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.member->name + '(';

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            let pattern: *HIRPattern = this.patterns[i];
            result += pattern->ToString();
        } return result + ')';
    }
}

class HIROrPattern : HIRPattern {
    pub patterns: Vector<*HIRPattern>;

    HIROrPattern(&mut this, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Or) {
        this.patterns = patterns;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        for i in 0..this.patterns.Size() {
            if i != 0 { result += " | "; }
            let pattern: *HIRPattern = this.patterns[i];
            result += pattern->ToString();
        } return result;
    }
}

enum HIRExpressionKind: u8 {
    Literal,
    BindingReference, VariableReference, DeclarationReference,
    Assignment, Unary, Binary, Ternary, Call, Cast,
    IndexAccess, FieldAccess, MemberAccess, TagAccess,
    New, Delete, Constructor, Destructor,
    Intrinsic, Deferred
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *HIRType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = true;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *HIRType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *HIRType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    pub fn Precedence(&this) -> u8 {
        if this.kind == HIRExpressionKind::Assignment {
            return 10;
        } else if this.kind == HIRExpressionKind::Ternary {
            return 20;
        } else if this.kind == HIRExpressionKind::Binary {
            let binary = this as *HIRBinaryExpression;

            if binary->kind == HIRBinaryKind::LogicalOr {
                return 30;
            } else if binary->kind == HIRBinaryKind::LogicalAnd {
                return 40;
            } else if binary->kind == HIRBinaryKind::BitwiseOr {
                return 50;
            } else if binary->kind == HIRBinaryKind::BitwiseXor {
                return 60;
            } else if binary->kind == HIRBinaryKind::BitwiseAnd {
                return 70;
            } else if binary->kind == HIRBinaryKind::Equal || binary->kind == HIRBinaryKind::NotEqual {
                return 80;
            } else if binary->kind == HIRBinaryKind::Less || binary->kind == HIRBinaryKind::LessEqual || binary->kind == HIRBinaryKind::Greater || binary->kind == HIRBinaryKind::GreaterEqual {
                return 90;
            } else if binary->kind == HIRBinaryKind::LeftShift || binary->kind == HIRBinaryKind::RightShift {
                return 100;
            } else if binary->kind == HIRBinaryKind::Add || binary->kind == HIRBinaryKind::Subtract {
                return 110;
            } else if binary->kind == HIRBinaryKind::Multiply || binary->kind == HIRBinaryKind::Divide || binary->kind == HIRBinaryKind::Modulo {
                return 120;
            } else {
                return 0;
            }
        } else if this.kind == HIRExpressionKind::Unary || this.kind == HIRExpressionKind::New || this.kind == HIRExpressionKind::Delete {
            return 130;
        } else if this.kind == HIRExpressionKind::Cast {
            return 140;
        } else if this.kind == HIRExpressionKind::Call || this.kind == HIRExpressionKind::Constructor || this.kind == HIRExpressionKind::Destructor || this.kind == HIRExpressionKind::IndexAccess || this.kind == HIRExpressionKind::FieldAccess || this.kind == HIRExpressionKind::MemberAccess || this.kind == HIRExpressionKind::TagAccess {
            return 150;
        } else {
            return 160;
        }
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRExpressionKind::Literal {
            return (this as *HIRLiteral)->ToString();
        } else if this.kind == HIRExpressionKind::BindingReference {
            return (this as *HIRBindingReference)->ToString();
        } else if this.kind == HIRExpressionKind::VariableReference {
            return (this as *HIRVariableReference)->ToString();
        } else if this.kind == HIRExpressionKind::DeclarationReference {
            return (this as *HIRDeclarationReference)->ToString();
        } else if this.kind == HIRExpressionKind::Assignment {
            return (this as *HIRAssignmentExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Unary {
            return (this as *HIRUnaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Binary {
            return (this as *HIRBinaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Ternary {
            return (this as *HIRTernaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Call {
            return (this as *HIRCallExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Cast {
            return (this as *HIRCastExpression)->ToString();
        } else if this.kind == HIRExpressionKind::IndexAccess {
            return (this as *HIRIndexAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::FieldAccess {
            return (this as *HIRFieldAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::MemberAccess {
            return (this as *HIRMemberAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::TagAccess {
            return (this as *HIRTagAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::New {
            return (this as *HIRNewExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Delete {
            return (this as *HIRDeleteExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Constructor {
            return (this as *HIRConstructorExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Destructor {
            return (this as *HIRDestructorExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Intrinsic {
            return (this as *HIRIntrinsicExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Deferred {
            return (this as *HIRDeferredExpression)->ToString();
        } else {
            return "<invalid expression>".ToString();
        }
    }
}

enum HIRLiteralKind: u8 {
    Boolean, Character, Integer, Float, String, Array, Structure, Variant, Null
}

class HIRLiteral : HIRExpression {
    pub kind: HIRLiteralKind;

    HIRLiteral(&mut this, kind: HIRLiteralKind, _type: *HIRType) : HIRExpression(HIRExpressionKind::Literal, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRLiteralKind::Boolean {
            return (this as *HIRBooleanLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Character {
            return (this as *HIRCharacterLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Integer {
            return (this as *HIRIntegerLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Float {
            return (this as *HIRFloatLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::String {
            return (this as *HIRStringLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Array {
            return (this as *HIRArrayLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Structure {
            return (this as *HIRStructureLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Variant {
            return (this as *HIRVariantLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Null {
            return (this as *HIRNullLiteral)->ToString();
        } else {
            return "<invalid literal>".ToString();
        }
    }
}

class HIRBooleanLiteral : HIRLiteral {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Boolean, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return (this.value ? "true" : "false").ToString();
    }
}

class HIRCharacterLiteral : HIRLiteral {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Character, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '\'' + String(this.value as i8).Escape() + '\'';
    }
}

class HIRIntegerLiteral : HIRLiteral {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class HIRFloatLiteral : HIRLiteral {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value);
    }
}

class HIRStringLiteral : HIRLiteral {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *HIRType) : HIRLiteral(HIRLiteralKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class HIRArrayLiteral : HIRLiteral {
    pub elements: Vector<*HIRExpression>;

    HIRArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Array, _type) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        let mut result = '['.ToString();

        for i in 0..this.elements.Size() {
            if i > 0 { result += ", "; }
            let element: *HIRExpression = this.elements[i];
            result += element->ToString();
        } return result + ']';
    }
}

class HIRStructureLiteral : HIRLiteral {
    pub fields: Vector<*HIRExpression>;

    HIRStructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Structure, _type) {
        this.fields = fields;
    }

    pub fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }
            let field: *HIRExpression = this.fields[i];
            result += field->ToString();
        } return result + '}';
    }
}

class HIRVariantLiteral : HIRLiteral {
    pub member: *HIRVariantMember,
    pub fields: Vector<*HIRExpression>;

    HIRVariantLiteral(&mut this, member: *HIRVariantMember, fields: Vector<*HIRExpression>) : HIRLiteral(HIRLiteralKind::Variant, member->_type) {
        (this.member, this.fields) = (member, fields);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.member->name + (this.member->structure ? '{' : '(').ToString();

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }

            if this.member->structure {
                result += this.member->fields[i]->name + ": ";
            }

            let field: *HIRExpression = this.fields[i];
            result += field->ToString();
        } return result + (this.member->structure ? '}' : ')');
    }
}

class HIRNullLiteral : HIRLiteral {
    HIRNullLiteral(&mut this, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

class HIRBindingReference : HIRExpression {
    pub binding: *HIRIdentifierPattern;

    HIRBindingReference(&mut this, binding: *HIRIdentifierPattern) : HIRExpression(HIRExpressionKind::BindingReference, binding->_type, HIRExpressionCategory::Place, binding->mutable) {
        this.binding = binding;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.binding->name;
    }
}

class HIRVariableReference : HIRExpression {
    pub variable: *HIRVariableStatement;

    HIRVariableReference(&mut this, variable: *HIRVariableStatement) : HIRExpression(HIRExpressionKind::VariableReference, variable->_type, HIRExpressionCategory::Place, variable->mutable) {
        this.variable = variable;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.variable->name;
    }
}

class HIRDeclarationReference : HIRExpression {
    pub declaration: *HIRTypedDeclaration;

    HIRDeclarationReference(&mut this, declaration: *HIRTypedDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationReference, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        if this.declaration->kind == HIRDeclarationKind::Parameter {
            return '%' + this.declaration->name;
        } else if this.declaration->kind == HIRDeclarationKind::Function {
            return "@\"" + this.declaration->name + '"';
        } else {
            return '@' + this.declaration->name;
        }
    }
}

class HIRAssignmentExpression : HIRExpression {
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRAssignmentExpression(&mut this, left: *HIRExpression, right: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Assignment, _type) {
        (this.left, this.right) = (left, right);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.left->Precedence() {
            result += '(' + this.left->ToString() + ')';
        } else {
            result += this.left->ToString();
        }

        result += " = ";

        if this.Precedence() > this.right->Precedence() {
            result += '(' + this.right->ToString() + ')';
        } else {
            result += this.right->ToString();
        } return result;
    }
}

enum HIRUnaryKind: u8 {
    AddressOf, Dereference, Negate, Not
}

extend HIRUnaryKind {
    pub fn ToString(this) -> String {
        if this == HIRUnaryKind::AddressOf { return '&'.ToString(); }
        else if this == HIRUnaryKind::Dereference { return '*'.ToString(); }
        else if this == HIRUnaryKind::Negate { return '-'.ToString(); }
        else if this == HIRUnaryKind::Not { return '!'.ToString(); }
        else { return "<invalid unary>".ToString(); }
    }
}

class HIRUnaryExpression : HIRExpression {
    pub kind: HIRUnaryKind,
    pub operand: *HIRExpression;

    HIRUnaryExpression(&mut this, kind: HIRUnaryKind, operand: *HIRExpression, _type: *HIRType, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Unary, _type, category, mutable) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.kind.ToString();

        if this.kind == HIRUnaryKind::AddressOf && this._type->IsMutable() {
            result += "mut ";
        }

        if this.Precedence() >= this.operand->Precedence() {
            result += '(' + this.operand->ToString() + ')';
        } else {
            result += this.operand->ToString();
        } return result;
    }
}

enum HIRBinaryKind: u8 {
    Add, Subtract, Multiply, Divide, Modulo,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual,
    LogicalAnd, LogicalOr, BitwiseAnd, BitwiseOr, BitwiseXor,
    LeftShift, RightShift
}

extend HIRBinaryKind {
    pub fn ToString(this) -> String {
        if this == HIRBinaryKind::Add { return '+'.ToString(); }
        else if this == HIRBinaryKind::Subtract { return '-'.ToString(); }
        else if this == HIRBinaryKind::Multiply { return '*'.ToString(); }
        else if this == HIRBinaryKind::Divide { return '/'.ToString(); }
        else if this == HIRBinaryKind::Modulo { return '%'.ToString(); }
        else if this == HIRBinaryKind::Equal { return "==".ToString(); }
        else if this == HIRBinaryKind::NotEqual { return "!=".ToString(); }
        else if this == HIRBinaryKind::Less { return '<'.ToString(); }
        else if this == HIRBinaryKind::LessEqual { return "<=".ToString(); }
        else if this == HIRBinaryKind::Greater { return '>'.ToString(); }
        else if this == HIRBinaryKind::GreaterEqual { return ">=".ToString(); }
        else if this == HIRBinaryKind::LogicalAnd { return "&&".ToString(); }
        else if this == HIRBinaryKind::LogicalOr { return "||".ToString(); }
        else if this == HIRBinaryKind::BitwiseAnd { return '&'.ToString(); }
        else if this == HIRBinaryKind::BitwiseOr { return '|'.ToString(); }
        else if this == HIRBinaryKind::BitwiseXor { return '^'.ToString(); }
        else if this == HIRBinaryKind::LeftShift { return "<<".ToString(); }
        else if this == HIRBinaryKind::RightShift { return ">>".ToString(); }
        else { return "<invalid binary>".ToString(); }
    }
}

class HIRBinaryExpression : HIRExpression {
    pub kind: HIRBinaryKind,
    pub left: *HIRExpression,
    pub right: *HIRExpression,
    pub destructors: Vector<*HIRExpression>;

    HIRBinaryExpression(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Binary, _type) {
        (this.kind, this.left, this.right, this.destructors) = (kind, left, right, destructors);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.left->Precedence() {
            result += '(' + this.left->ToString() + ')';
        } else {
            result += this.left->ToString();
        }

        result += ' ' + this.kind.ToString() + ' ';

        if this.Precedence() >= this.right->Precedence() {
            result += '(' + this.right->ToString() + ')';
        } else {
            result += this.right->ToString();
        } return result;
    }
}

class HIRTernaryExpression : HIRExpression {
    pub condition: *HIRExpression,
    pub then_value: *HIRExpression,
    pub then_destructors: Vector<*HIRExpression>,
    pub else_value: *HIRExpression,
    pub else_destructors: Vector<*HIRExpression>;

    HIRTernaryExpression(&mut this, condition: *HIRExpression, then_value: *HIRExpression, then_destructors: Vector<*HIRExpression>, else_value: *HIRExpression, else_destructors: Vector<*HIRExpression>, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Ternary, then_value->_type, category, mutable) {
        (this.condition, this.then_value, this.then_destructors, this.else_value, this.else_destructors) = (condition, then_value, then_destructors, else_value, else_destructors);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.condition->Precedence() {
            result += '(' + this.condition->ToString() + ')';
        } else {
            result += this.condition->ToString();
        }

        result += " ? ";

        if this.Precedence() > this.then_value->Precedence() {
            result += '(' + this.then_value->ToString() + ')';
        } else {
            result += this.then_value->ToString();
        }

        result += " : ";

        if this.Precedence() > this.else_value->Precedence() {
            result += '(' + this.else_value->ToString() + ')';
        } else {
            result += this.else_value->ToString();
        } return result;
    }
}

class HIRCallExpression : HIRExpression {
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRCallExpression(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, callee->_type->Return()) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call ".ToString();

        if this.Precedence() > this.callee->Precedence() {
            result += '(' + this.callee->ToString() + ')';
        } else {
            result += this.callee->ToString();
        } result += '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *HIRExpression = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class HIRCastExpression : HIRExpression {
    pub value: *HIRExpression;

    HIRCastExpression(&mut this, value: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Cast, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.value->Precedence() {
            result += '(' + this.value->ToString() + ')';
        } else {
            result += this.value->ToString();
        }

        return result + " as " + this._type->ToString();
    }
}

class HIRIndexAccessExpression : HIRExpression {
    pub value: *HIRExpression,
    pub index: *HIRExpression;

    HIRIndexAccessExpression(&mut this, value: *HIRExpression, index: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::IndexAccess, _type) {
        (this.value, this.index) = (value, index);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.value->Precedence() {
            result += '(' + this.value->ToString() + ')';
        } else {
            result += this.value->ToString();
        }

        return result + '[' + this.index->ToString() + ']';
    }
}

class HIRFieldAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub field: *HIRFieldDeclaration;

    HIRFieldAccessExpression(&mut this, instance: *HIRExpression, field: *HIRFieldDeclaration) : HIRExpression(HIRExpressionKind::FieldAccess, field->_type, HIRExpressionCategory::Place, instance->mutable) {
        (this.instance, this.field) = (instance, field);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.instance->Precedence() {
            result += '(' + this.instance->ToString() + ')';
        } else {
            result += this.instance->ToString();
        }

        return result + '.' + this.field->name;
    }
}

class HIRMemberAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub member: *HIRVariantMember,
    pub field: *HIRVariantField;

    HIRMemberAccessExpression(&mut this, instance: *HIRExpression, member: *HIRVariantMember, field: *HIRVariantField) : HIRExpression(HIRExpressionKind::MemberAccess, field->_type, HIRExpressionCategory::Place, instance->mutable) {
        (this.instance, this.member, this.field) = (instance, member, field);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.instance->Precedence() {
            result += '(' + this.instance->ToString() + ')';
        } else {
            result += this.instance->ToString();
        }

        return result + '.' + this.member->name;
    }
}

class HIRTagAccessExpression : HIRExpression {
    pub instance: *HIRExpression;

    HIRTagAccessExpression(&mut this, instance: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::TagAccess, _type, HIRExpressionCategory::Place, instance->mutable) {
        this.instance = instance;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.instance->Precedence() {
            result += '(' + this.instance->ToString() + ')';
        } else {
            result += this.instance->ToString();
        }

        return result + ".tag";
    }
}

class HIRNewExpression : HIRExpression {
    pub _type: *HIRType,
    pub size: *HIRExpression,
    pub initialized: bool,
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRNewExpression(&mut this, _type: *HIRType, size: *HIRExpression, initialized: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>, result_type: *HIRType) : HIRExpression(HIRExpressionKind::New, result_type) {
        (this._type, this.size, this.initialized, this.callee, this.arguments) = (_type, size, initialized, callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "new " + this._type->ToString();

        if this.size != null {
            result += '[' + this.size->ToString() + ']';
        } else if this.initialized {
            result += '(';

            for i in 0..this.arguments.Size() {
                if i != 0 { result += ", "; }
                let argument: *HIRExpression = this.arguments[i];
                result += argument->ToString();
            } result += ')';
        } return result;
    }
}

class HIRDeleteExpression : HIRExpression {
    pub value: *HIRExpression,
    pub array: bool,
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRDeleteExpression(&mut this, value: *HIRExpression, array: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Delete, _type) {
        (this.value, this.array, this.callee, this.arguments) = (value, array, callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "delete ".ToString();

        if this.Precedence() > this.value->Precedence() {
            result += '(' + this.value->ToString() + ')';
        } else {
            result += this.value->ToString();
        } return result;
    }
}

class HIRConstructorExpression : HIRExpression {
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRConstructorExpression(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Constructor, _type) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "constructor ".ToString();

        if this.Precedence() > this.callee->Precedence() {
            result += '(' + this.callee->ToString() + ')';
        } else {
            result += this.callee->ToString();
        } result += '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *HIRExpression = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class HIRDestructorExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub callee: *HIRExpression;

    HIRDestructorExpression(&mut this, instance: *HIRExpression, callee: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Destructor, _type) {
        (this.instance, this.callee) = (instance, callee);
    }

    pub fn ToString(&this) -> String {
        let mut result = "destructor ".ToString();

        if this.Precedence() > this.callee->Precedence() {
            result += '(' + this.callee->ToString() + ')';
        } else {
            result += this.callee->ToString();
        }

        return result + '(' + this.instance->ToString() + ')';
    }
}

enum HIRIntrinsicKind: u8 {
    SizeOf, AlignOf
}

extend HIRIntrinsicKind {
    pub fn ToString(this) -> String {
        if this == HIRIntrinsicKind::SizeOf { return "sizeof".ToString(); }
        else if this == HIRIntrinsicKind::AlignOf { return "alignof".ToString(); }
        else { return "<invalid intrinsic>".ToString(); }
    }
}

class HIRIntrinsicExpression : HIRExpression {
    pub kind: HIRIntrinsicKind,
    pub _type: *HIRType;

    HIRIntrinsicExpression(&mut this, kind: HIRIntrinsicKind, _type: *HIRType, result_type: *HIRType) : HIRExpression(HIRExpressionKind::Intrinsic, result_type) {
        (this.kind, this._type) = (kind, _type);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + '(' + this._type->ToString() + ')';
    }
}

class HIRDeferredExpression : HIRExpression {
    pub expression: *ASTExpression;

    HIRDeferredExpression(&mut this, expression: *ASTExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Deferred, _type) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return "<deferred expression>".ToString();
    }
}

enum HIRStatementKind: u8 {
    Block, Variable, Expression, If, While, Loop, For, Match, Return, Break, Continue, Assembly
}

class HIRStatement {
    pub kind: HIRStatementKind;

    HIRStatement(&mut this, kind: HIRStatementKind) {
        this.kind = kind;
    }

    pub fn HasBlock(&this) -> bool {
        return this.kind == HIRStatementKind::Block || this.kind == HIRStatementKind::If || this.kind == HIRStatementKind::While || this.kind == HIRStatementKind::Loop || this.kind == HIRStatementKind::For || this.kind == HIRStatementKind::Match || this.kind == HIRStatementKind::Assembly;
    }

    pub fn ToString(&this, indent: usize) -> String {
        if this.kind == HIRStatementKind::Block {
            return (this as *HIRBlockStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Variable {
            return (' ' * indent * 4) + (this as *HIRVariableStatement)->ToString();
        } else if this.kind == HIRStatementKind::Expression {
            return (' ' * indent * 4) + (this as *HIRExpressionStatement)->ToString();
        } else if this.kind == HIRStatementKind::If {
            return (' ' * indent * 4) + (this as *HIRIfStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::While {
            return (' ' * indent * 4) + (this as *HIRWhileStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Loop {
            return (' ' * indent * 4) + (this as *HIRLoopStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::For {
            return (' ' * indent * 4) + (this as *HIRForStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Match {
            return (' ' * indent * 4) + (this as *HIRMatchStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Return {
            return (' ' * indent * 4) + (this as *HIRReturnStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Break {
            return (' ' * indent * 4) + (this as *HIRBreakStatement)->ToString();
        } else if this.kind == HIRStatementKind::Continue {
            return (' ' * indent * 4) + (this as *HIRContinueStatement)->ToString();
        } else if this.kind == HIRStatementKind::Assembly {
            return (' ' * indent * 4) + (this as *HIRAssemblyStatement)->ToString();
        } else {
            return (' ' * indent * 4) + "<invalid statement>".ToString();
        }
    }
}

class HIRBlockStatement : HIRStatement {
    pub statements: Vector<*HIRStatement>;

    HIRBlockStatement(&mut this) : HIRStatement(HIRStatementKind::Block) {}

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = '{'.ToString();

        if !this.statements.Empty() {
            result += '\n';
            let mut previous: *HIRStatement = null;

            for current in this.statements {
                if previous != null && (previous->HasBlock() || current->HasBlock()) {
                    result += '\n';
                }

                result += current->ToString(indent + 1) + '\n';
                previous = current;
            } result += (' ' * indent * 4) + '}';
        } else {
            result += '}';
        } return result;
    }
}

class HIRVariableStatement : HIRStatement {
    pub name: String,
    pub _type: *HIRType,
    pub initializer: *HIRExpression,
    pub mutable: bool;

    HIRVariableStatement(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, mutable: bool) : HIRStatement(HIRStatementKind::Variable) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = "let %" + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRExpressionStatement : HIRStatement {
    pub expression: *HIRExpression;

    HIRExpressionStatement(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Expression) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return this.expression->ToString();
    }
}

class HIRCondition {
    pub pattern: *HIRPattern = null,
    pub expression: *HIRExpression;

    HIRCondition(&mut this, expression: *HIRExpression) {
        this.expression = expression;
    }

    HIRCondition(&mut this, pattern: *HIRPattern, expression: *HIRExpression) {
        (this.pattern, this.expression) = (pattern, expression);
    }

    pub fn ToString(&this) -> String {
        if this.pattern != null {
            return "let " + this.pattern->ToString() + " = " + this.expression->ToString();
        } else {
            return this.expression->ToString();
        }
    }
}

class HIRIfStatement : HIRStatement {
    pub condition: *HIRCondition,
    pub destructors: Vector<*HIRExpression>,
    pub then_body: *HIRBlockStatement,
    pub else_body: *HIRBlockStatement;

    HIRIfStatement(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, then_body: *HIRBlockStatement, else_body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::If) {
        (this.condition, this.destructors, this.then_body, this.else_body) = (condition, destructors, then_body, else_body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "if " + this.condition->ToString() + ' ' + this.then_body->ToString(indent);

        if this.else_body != null {
            result += " else " + this.else_body->ToString(indent);
        } return result;
    }
}

class HIRWhileStatement : HIRStatement {
    pub condition: *HIRCondition,
    pub destructors: Vector<*HIRExpression>,
    pub while_body: *HIRBlockStatement,
    pub else_body: *HIRBlockStatement;

    HIRWhileStatement(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, while_body: *HIRBlockStatement, else_body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::While) {
        (this.condition, this.destructors, this.while_body, this.else_body) = (condition, destructors, while_body, else_body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "while " + this.condition->ToString() + ' ' + this.while_body->ToString(indent);
    }
}

class HIRLoopStatement : HIRStatement {
    pub body: *HIRBlockStatement;

    HIRLoopStatement(&mut this, body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::Loop) {
        this.body = body;
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "loop " + this.body->ToString(indent);
    }
}

class HIRForStatement : HIRStatement {
    pub iterator: *HIRVariableStatement,
    pub condition: *HIRExpression,
    pub step: *HIRExpression,
    pub destructors: Vector<*HIRExpression>,
    pub body: *HIRBlockStatement;

    HIRForStatement(&mut this, iterator: *HIRVariableStatement, condition: *HIRExpression, step: *HIRExpression, destructors: Vector<*HIRExpression>, body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::For) {
        (this.iterator, this.condition, this.step, this.destructors, this.body) = (iterator, condition, step, destructors, body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "for " + this.iterator->ToString() + ", " + this.condition->ToString() + ", " + this.step->ToString() + ' ' + this.body->ToString(indent);
    }
}

class HIRMatchArm {
    pub pattern: *HIRPattern,
    pub guard: *HIRExpression,
    pub body: *HIRBlockStatement;

    HIRMatchArm(&mut this, pattern: *HIRPattern, guard: *HIRExpression, body: *HIRBlockStatement) {
        (this.pattern, this.guard, this.body) = (pattern, guard, body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = this.pattern->ToString();
        if this.guard != null { result += " if " + this.guard->ToString(); }
        return result + " => " + this.body->ToString(indent);
    }
}

class HIRMatchStatement : HIRStatement {
    pub target: *HIRExpression,
    pub destructors: Vector<*HIRExpression>,
    pub arms: Vector<*HIRMatchArm>;

    HIRMatchStatement(&mut this, target: *HIRExpression, destructors: Vector<*HIRExpression>, arms: Vector<*HIRMatchArm>) : HIRStatement(HIRStatementKind::Match) {
        (this.target, this.destructors, this.arms) = (target, destructors, arms);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "match " + this.target->ToString() + " {\n";

        for i in 0..this.arms.Size() {
            if i != 0 { result += ",\n"; }
            let arm: *HIRMatchArm = this.arms[i];
            result += ' ' * (indent + 1) * 4;
            result += arm->ToString(indent + 1);
        }

        return result + '\n' + (' ' * indent * 4) + '}';
    }
}

class HIRReturnStatement : HIRStatement {
    pub expression: *HIRExpression,
    pub destructors: Vector<*HIRExpression>;

    HIRReturnStatement(&mut this, expression: *HIRExpression, destructors: Vector<*HIRExpression>) : HIRStatement(HIRStatementKind::Return) {
        (this.expression, this.destructors) = (expression, destructors);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = String();

        for destructor in this.destructors {
            result += destructor->ToString() + '\n' + (' ' * indent * 4);
        } result += "return";

        if this.expression != null {
            result += ' ' + this.expression->ToString();
        } return result;
    }
}

class HIRBreakStatement : HIRStatement {
    HIRBreakStatement(&mut this) : HIRStatement(HIRStatementKind::Break) {}

    pub fn ToString(&this) -> String {
        return "break".ToString();
    }
}

class HIRContinueStatement : HIRStatement {
    HIRContinueStatement(&mut this) : HIRStatement(HIRStatementKind::Continue) {}

    pub fn ToString(&this) -> String {
        return "continue".ToString();
    }
}

class HIRAssemblyOperand {
    pub name: String,
    pub expression: *HIRExpression;

    HIRAssemblyOperand(&mut this, name: String, expression: *HIRExpression) {
        (this.name, this.expression) = (name, expression);
    }
}

class HIRAssemblyStatement : HIRStatement {
    pub _volatile: bool,
    pub text: String,
    pub inputs: Vector<*HIRAssemblyOperand>,
    pub outputs: Vector<*HIRAssemblyOperand>,
    pub clobbers: Vector<String>;

    HIRAssemblyStatement(&mut this, _volatile: bool, text: String, inputs: Vector<*HIRAssemblyOperand>, outputs: Vector<*HIRAssemblyOperand>, clobbers: Vector<String>) : HIRStatement(HIRStatementKind::Assembly) {
        (this._volatile, this.text, this.inputs, this.outputs, this.clobbers) = (_volatile, text, inputs, outputs, clobbers);
    }

    pub fn ToString(&this) -> String {
        let mut result = (this._volatile ? "volatile asm " : "asm ").ToString();

        if !this.inputs.Empty() {
            result += ": ";

            for i in 0..this.inputs.Size() {
                if i != 0 { result += ", "; }
                let input: *HIRAssemblyOperand = this.inputs[i]; 
                result += input->name + '(' + input->expression->ToString() + ')';
            } result += " -> ";
        }

        result += '{' + this.text + '}';

        if !this.outputs.Empty() {
            result += " -> ";

            for i in 0..this.outputs.Size() {
                if i != 0 { result += ", "; }
                let output: *HIRAssemblyOperand = this.outputs[i]; 
                result += output->name + '(' + output->expression->ToString() + ')';
            }
        }

        if !this.clobbers.Empty() {
            result += " : ";

            for i in 0..this.clobbers.Size() {
                if i != 0 { result += ", "; }
                result += this.clobbers[i];
            }
        } return result;
    }
}

enum HIRDeclarationKind: u8 {
    Parameter, Function, Field, Class, Structure, EnumerationMember, Enumeration, VariantMember, Variant, Extend, Constant, Static, Assembly
}

class HIRDeclaration {
    pub kind: HIRDeclarationKind;

    HIRDeclaration(&mut this, kind: HIRDeclarationKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRDeclarationKind::Parameter {
            return (this as *HIRParameterDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Function {
            return (this as *HIRFunctionDeclaration)->ToString(0);
        } else if this.kind == HIRDeclarationKind::Field {
            return (this as *HIRFieldDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Class {
            return (this as *HIRClassDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Structure {
            return (this as *HIRStructureDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::EnumerationMember {
            return (this as *HIREnumerationMember)->ToString();
        } else if this.kind == HIRDeclarationKind::Enumeration {
            return (this as *HIREnumerationDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::VariantMember {
            return (this as *HIRVariantMember)->ToString();
        } else if this.kind == HIRDeclarationKind::Variant {
            return (this as *HIRVariantDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Extend {
            return (this as *HIRExtendDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Constant {
            return (this as *HIRConstantDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Static {
            return (this as *HIRStaticDeclaration)->ToString();
        } else if this.kind == HIRDeclarationKind::Assembly {
            return (this as *HIRAssemblyDeclaration)->ToString();
        } else {
            return "<invalid declaration>".ToString();
        }
    }
}

class HIRTypedDeclaration : HIRDeclaration {
    pub name: String,
    pub _type: *HIRType;

    HIRTypedDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *HIRType) : HIRDeclaration(kind) {
        (this.name, this._type) = (name, _type);
    }
}

enum HIRDeclarationABI: u8 {
    Native, C
}

enum HIRDeclarationLinkage: u8 {
    Private, Internal, External
}

class HIRLinkableDeclaration : HIRTypedDeclaration {
    pub abi: HIRDeclarationABI,
    pub linkage: HIRDeclarationLinkage;

    HIRLinkableDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *HIRType, abi: HIRDeclarationABI, linkage: HIRDeclarationLinkage) : HIRTypedDeclaration(kind, name, _type) {
        (this.abi, this.linkage) = (abi, linkage);
    }
}

class HIRParameterDeclaration : HIRTypedDeclaration {
    pub mutable: bool;

    HIRParameterDeclaration(&mut this, name: String, _type: *HIRType, mutable: bool) : HIRTypedDeclaration(HIRDeclarationKind::Parameter, name, _type) {
        this.mutable = mutable;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.name + ": " + this._type->ToString();
    }
}

class HIRFunctionDeclaration : HIRLinkableDeclaration {
    pub no_mangle: bool,
    pub public: bool,
    pub parameters: Vector<*HIRParameterDeclaration>,
    pub _return: *HIRType,
    pub body: *HIRBlockStatement = null,
    pub instance: *GenericInstance = null;

    HIRFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *HIRType, _type: *HIRType, no_mangle: bool, public: bool, abi: HIRDeclarationABI) : HIRLinkableDeclaration(HIRDeclarationKind::Function, name, _type, abi, HIRDeclarationLinkage::External) {
        (this.parameters, this._return, this.no_mangle, this.public) = (parameters, _return, no_mangle, public);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "fn @\"" + this.name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *HIRParameterDeclaration = this.parameters[i];
            result += parameter->ToString();
        } result += ')';

        if !this._type->Return().IsVoid() {
            result += " -> " + this._type->Return().ToString();
        }

        if this.body != null {
            result += ' ' + this.body->ToString(indent);
        } return result;
    }
}

class HIRFieldDeclaration : HIRTypedDeclaration {
    pub index: usize,
    pub initializer: *ASTExpression,
    pub public: bool;

    HIRFieldDeclaration(&mut this, name: String, _type: *HIRType, index: usize, initializer: *ASTExpression, public: bool) : HIRTypedDeclaration(HIRDeclarationKind::Field, name, _type) {
        (this.index, this.initializer, this.public) = (index, initializer, public);
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRClassDeclaration : HIRTypedDeclaration {
    pub parents: Vector<*HIRType>,
    pub fields: Vector<*HIRFieldDeclaration>,
    pub constructors: Vector<*mut HIRFunctionDeclaration>,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub instance: *GenericInstance = null;

    HIRClassDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Class, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "class %" + this.name;

        if !this.parents.Empty() {
            result += " : ";

            for i in 0..this.parents.Size() {
                if i != 0 { result += ", "; }
                let parent: *HIRType = this.parents[i];
                result += parent->ToString();
            }
        } result += " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                let field: *HIRFieldDeclaration = this.fields[i];
                result += "    " + field->ToString();
            }

            if !this.constructors.Empty() || this.destructor != null || !this.methods.Empty() {
                result += ';';
            } result += '\n';
        }

        for constructor in this.constructors {
            result += "\n    " + constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIRStructureDeclaration : HIRTypedDeclaration {
    pub fields: Vector<*HIRFieldDeclaration>,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub instance: *GenericInstance = null;

    HIRStructureDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Structure, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "struct %" + this.name + " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                let field: *HIRFieldDeclaration = this.fields[i];
                result += "    " + field->ToString();
            }

            if this.copy_constructor != null || this.destructor != null || !this.methods.Empty() || this.copy_assign != null {
                result += ';';
            } result += '\n';
        }
        
        if this.copy_constructor != null {
            result += "\n    " + this.copy_constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        }

        if this.copy_assign != null {
            result += "\n    " + this.copy_assign->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIREnumerationMember : HIRTypedDeclaration {
    pub value: *HIRExpression;

    HIREnumerationMember(&mut this, name: String, value: *HIRExpression, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::EnumerationMember, name, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name;

        if this.value != null {
            result += " = " + this.value->ToString();
        } return result;
    }
}

class HIREnumerationDeclaration : HIRTypedDeclaration {
    pub members: Vector<*HIREnumerationMember>;

    HIREnumerationDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Enumeration, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "enum %" + this.name + " {";

        if !this.members.Empty() {
            result += '\n';

            for i in 0..this.members.Size() {
                if i != 0 { result += ",\n"; }
                let member: *HIREnumerationMember = this.members[i];
                result += "    " + member->ToString();
            } result += '\n';
        } return result + '}';
    }
}

class HIRVariantField {
    pub name: String,
    pub _type: *HIRType,
    pub index: usize;

    HIRVariantField(&mut this, name: String, _type: *HIRType, index: usize) {
        (this.name, this._type, this.index) = (name, _type, index);
    }

    pub fn ToString(&this) -> String {
        if !this.name.Empty() {
            return this.name + ": " + this._type->ToString();
        } else {
            return this._type->ToString();
        }
    }
}

class HIRVariantMember : HIRTypedDeclaration {
    pub structure: bool = false,
    pub fields: Vector<*HIRVariantField>,
    pub index: usize;

    HIRVariantMember(&mut this, name: String, _type: *HIRType, index: usize) : HIRTypedDeclaration(HIRDeclarationKind::VariantMember, name, _type) {
        this.index = index;
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name;

        if !this.fields.Empty() {
            result += this.structure ? " { " : "(";

            for i in 0..this.fields.Size() {
                if i != 0 { result += ", "; }
                let field: *HIRVariantField = this.fields[i];
                result += field->ToString();
            } result += this.structure ? " }" : ")";
        } return result;
    }
}

class HIRVariantDeclaration : HIRTypedDeclaration {
    pub members: Vector<*HIRVariantMember>,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub instance: *GenericInstance = null;

    HIRVariantDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Variant, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "enum %" + this.name + " {";

        if !this.members.Empty() {
            result += '\n';

            for i in 0..this.members.Size() {
                if i != 0 { result += ",\n"; }
                let member: *HIRVariantMember = this.members[i];
                result += "    " + member->ToString();
            }

            if this.copy_constructor != null || this.destructor != null || !this.methods.Empty() || this.copy_assign != null {
                result += ';';
            } result += '\n';
        }
        
        if this.copy_constructor != null {
            result += "\n    " + this.copy_constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        }

        if this.copy_assign != null {
            result += "\n    " + this.copy_assign->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIRExtendDeclaration : HIRTypedDeclaration {
    pub methods: Vector<*mut HIRFunctionDeclaration>;

    HIRExtendDeclaration(&mut this, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Extend, _type->ToString(), _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "extend " + this.name + " {";

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIRExtensionRegistry {
    pub extensions: Vector<*HIRExtendDeclaration>;

    HIRExtensionRegistry(&mut this) {}

    pub fn Register(&mut this, extension: *HIRExtendDeclaration) {
        this.extensions.PushBack(extension);
    }

    pub fn GetCandidates(&this, _type: *HIRType, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut found = false;

        for extension in this.extensions {
            if *extension->_type != *_type {
                continue;
            }

            for method in extension->methods {
                if method->name != name {
                    continue;
                }

                if method->public || (hir_lowerer->current_type != null && *hir_lowerer->current_type == *_type) {
                    result.PushBack(method);
                } found = true;
            }
        }

        if result.Empty() && !test {
            if found {
                Logger::Log("Method '" + name + "' is not accessible.", node, LogSeverity::Error);
            } else {
                Logger::Log("Invalid arguments for method: '" + name + "'.", node, LogSeverity::Error);
            }
        } return result;
    }
}

class HIRConstantDeclaration : HIRTypedDeclaration {
    pub initializer: *HIRExpression;

    HIRConstantDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression) : HIRTypedDeclaration(HIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        return "const @" + this.name + ": " + this._type->ToString() + " = " + this.initializer->ToString();
    }
}

class HIRStaticDeclaration : HIRLinkableDeclaration {
    pub initializer: *HIRExpression,
    pub alignment: *HIRExpression,
    pub mutable: bool;

    HIRStaticDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) : HIRLinkableDeclaration(HIRDeclarationKind::Static, name, _type, HIRDeclarationABI::Native, linkage) {
        (this.initializer, this.alignment, this.mutable) = (initializer, alignment, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = "static @" + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRAssemblyDeclaration : HIRDeclaration {
    pub text: String;

    HIRAssemblyDeclaration(&mut this, text: String) : HIRDeclaration(HIRDeclarationKind::Assembly) {
        this.text = text;
    }
}

class HIRModule {
    pub declarations: Vector<*HIRDeclaration>;

    HIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *HIRDeclaration = null;

        for current in this.declarations {
            if previous != null {
                result += '\n';

                if previous->kind != current->kind || (current->kind == HIRDeclarationKind::Class || current->kind == HIRDeclarationKind::Structure || current->kind == HIRDeclarationKind::Enumeration || current->kind == HIRDeclarationKind::Extend) {
                    result += '\n';
                } else if current->kind == HIRDeclarationKind::Function {
                    let current = current as *HIRFunctionDeclaration;
                    let previous = previous as *HIRFunctionDeclaration;

                    if current->body != null || previous->body != null {
                        result += '\n';
                    }
                }
            }

            result += current->ToString();
            previous = current;
        } return result;
    }
}

class HIRContext {
    pub arena: Arena;

    HIRContext(&mut this) {}

    pub fn VoidType(&mut this) -> *mut HIRVoidType {
        return this.arena.New<HIRVoidType>();
    }

    pub fn BooleanType(&mut this) -> *mut HIRBooleanType {
        return this.arena.New<HIRBooleanType>();
    }

    pub fn CharacterType(&mut this) -> *mut HIRCharacterType {
        return this.arena.New<HIRCharacterType>();
    }

    pub fn IntegerType(&mut this, width: u32, signed: bool) -> *mut HIRIntegerType {
        return this.arena.New<HIRIntegerType>(width, signed, false, false);
    }

    pub fn IntegerPointerType(&mut this, signed: bool) -> *mut HIRIntegerType {
        return this.arena.New<HIRIntegerType>(64u32, signed, false, true);
    }

    pub fn IntegerLiteralType(&mut this) -> *mut HIRIntegerType {
        return this.arena.New<HIRIntegerType>(32u32, true, true, false);
    }

    pub fn FloatType(&mut this, width: u32) -> *mut HIRFloatType {
        return this.arena.New<HIRFloatType>(width, false);
    }

    pub fn FloatLiteralType(&mut this) -> *mut HIRFloatType {
        return this.arena.New<HIRFloatType>(64u32, true);
    }

    pub fn PointerType(&mut this, pointee: *HIRType, mutable: bool) -> *mut HIRPointerType {
        return this.arena.New<HIRPointerType>(pointee, mutable);
    }

    pub fn ReferenceType(&mut this, referent: *HIRType, mutable: bool) -> *mut HIRReferenceType {
        return this.arena.New<HIRReferenceType>(referent, mutable);
    }

    pub fn ArrayType(&mut this, element: *HIRType, length: usize) -> *mut HIRArrayType {
        return this.arena.New<HIRArrayType>(element, length);
    }

    pub fn FunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) -> *mut HIRFunctionType {
        return this.arena.New<HIRFunctionType>(parameters, _return);
    }

    pub fn ClassType(&mut this, declaration: *HIRClassDeclaration) -> *mut HIRClassType {
        return this.arena.New<HIRClassType>(declaration);
    }

    pub fn StructureType(&mut this, declaration: *HIRStructureDeclaration) -> *mut HIRStructureType {
        return this.arena.New<HIRStructureType>(declaration);
    }

    pub fn EnumerationType(&mut this, declaration: *HIREnumerationDeclaration, underlying: *HIRIntegerType) -> *mut HIREnumerationType {
        return this.arena.New<HIREnumerationType>(declaration, underlying);
    }

    pub fn VariantType(&mut this, declaration: *HIRVariantDeclaration) -> *mut HIRVariantType {
        return this.arena.New<HIRVariantType>(declaration);
    }
}

class HIRBuilder {
    context: *mut HIRContext,
    module: *mut HIRModule,
    function: *mut HIRFunctionDeclaration = null,
    block: *mut HIRBlockStatement = null;

    HIRBuilder(&mut this) {}

    HIRBuilder(&mut this, context: *mut HIRContext, module: *mut HIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn WildcardPattern(&mut this) -> *mut HIRWildcardPattern {
        return this.context->arena.New<HIRWildcardPattern>();
    }

    pub fn RestPattern(&mut this) -> *mut HIRRestPattern {
        return this.context->arena.New<HIRRestPattern>();
    }

    pub fn LiteralPattern(&mut this, literal: *HIRExpression) -> *mut HIRLiteralPattern {
        return this.context->arena.New<HIRLiteralPattern>(literal);
    }

    pub fn IdentifierPattern(&mut this, name: String, _type: *HIRType, mutable: bool) -> *mut HIRIdentifierPattern {
        return this.context->arena.New<HIRIdentifierPattern>(name, _type, mutable);
    }

    pub fn TuplePattern(&mut this, patterns: Vector<*HIRPattern>) -> *mut HIRTuplePattern {
        return this.context->arena.New<HIRTuplePattern>(patterns);
    }

    pub fn FieldPattern(&mut this, name: String, pattern: *HIRPattern) -> *mut HIRFieldPattern {
        return this.context->arena.New<HIRFieldPattern>(name, pattern);
    }

    pub fn StructurePattern(&mut this, declaration: *HIRStructureDeclaration, patterns: Vector<*HIRPattern>) -> *mut HIRStructurePattern {
        return this.context->arena.New<HIRStructurePattern>(declaration, patterns);
    }

    pub fn VariantPattern(&mut this, member: *HIRVariantMember, patterns: Vector<*HIRPattern>) -> *mut HIRVariantPattern {
        return this.context->arena.New<HIRVariantPattern>(member, patterns);
    }

    pub fn OrPattern(&mut this, patterns: Vector<*HIRPattern>) -> *mut HIROrPattern {
        return this.context->arena.New<HIROrPattern>(patterns);
    }

    pub fn BooleanLiteral(&mut this, value: bool, _type: *HIRType) -> *mut HIRBooleanLiteral {
        return this.context->arena.New<HIRBooleanLiteral>(value, _type);
    }

    pub fn CharacterLiteral(&mut this, value: u32, _type: *HIRType) -> *mut HIRCharacterLiteral {
        return this.context->arena.New<HIRCharacterLiteral>(value, _type);
    }

    pub fn IntegerLiteral(&mut this, value: u64, _type: *HIRType) -> *mut HIRIntegerLiteral {
        return this.context->arena.New<HIRIntegerLiteral>(value, _type);
    }

    pub fn FloatLiteral(&mut this, value: f64, _type: *HIRType) -> *mut HIRFloatLiteral {
        return this.context->arena.New<HIRFloatLiteral>(value, _type);
    }

    pub fn StringLiteral(&mut this, value: String, _type: *HIRType) -> *mut HIRStringLiteral {
        return this.context->arena.New<HIRStringLiteral>(value, _type);
    }

    pub fn ArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRArrayLiteral {
        return this.context->arena.New<HIRArrayLiteral>(elements, _type);
    }

    pub fn StructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRStructureLiteral {
        return this.context->arena.New<HIRStructureLiteral>(fields, _type);
    }

    pub fn VariantLiteral(&mut this, member: *HIRVariantMember, fields: Vector<*HIRExpression>) -> *mut HIRVariantLiteral {
        return this.context->arena.New<HIRVariantLiteral>(member, fields);
    }

    pub fn NullLiteral(&mut this) -> *mut HIRNullLiteral {
        return this.context->arena.New<HIRNullLiteral>(this.context->PointerType(this.context->VoidType(), false));
    }

    pub fn ReferenceBinding(&mut this, pattern: *HIRIdentifierPattern) -> *mut HIRBindingReference {
        return this.context->arena.New<HIRBindingReference>(pattern);
    }

    pub fn ReferenceVariable(&mut this, variable: *HIRVariableStatement) -> *mut HIRVariableReference {
        return this.context->arena.New<HIRVariableReference>(variable);
    }

    pub fn ReferenceDeclaration(&mut this, declaration: *HIRTypedDeclaration, mutable: bool) -> *mut HIRDeclarationReference {
        return this.context->arena.New<HIRDeclarationReference>(declaration, mutable);
    }

    pub fn Assignment(&mut this, left: *HIRExpression, right: *HIRExpression) -> *mut HIRAssignmentExpression {
        return this.context->arena.New<HIRAssignmentExpression>(left, right, this.context->VoidType());
    }

    pub fn AddressOf(&mut this, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Unary && (operand as *HIRUnaryExpression)->kind == HIRUnaryKind::Dereference {
            return (operand as *HIRUnaryExpression)->operand;
        }

        return this.context->arena.New<HIRUnaryExpression>(HIRUnaryKind::AddressOf, operand, this.context->ReferenceType(operand->_type, operand->category == HIRExpressionCategory::Place ? operand->mutable : true), HIRExpressionCategory::Value, false);
    }

    pub fn Dereference(&mut this, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Unary && (operand as *HIRUnaryExpression)->kind == HIRUnaryKind::AddressOf {
            return (operand as *HIRUnaryExpression)->operand;
        }

        return this.context->arena.New<HIRUnaryExpression>(HIRUnaryKind::Dereference, operand, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable());
    }

    fn MaskToWidth(&this, value: u64, width: u64) -> u64 {
        if width >= 64 { return value; }
        return value & ((1u64 << width) - 1);
    }

    fn FoldUnary(&mut this, kind: HIRUnaryKind, operand: *HIRLiteral, _type: *HIRType) -> *HIRExpression {
        if kind == HIRUnaryKind::Negate {
            if operand->kind == HIRLiteralKind::Integer {
                return this.IntegerLiteral(this.MaskToWidth((0u64 - (operand as *HIRIntegerLiteral)->value), _type->Width() as u64), _type);
            } else if operand->kind == HIRLiteralKind::Float {
                return this.FloatLiteral(-(operand as *HIRFloatLiteral)->value, _type);
            } else { return null; }
        } else if kind == HIRUnaryKind::Not {
            if operand->kind == HIRLiteralKind::Integer {
                return this.IntegerLiteral(this.MaskToWidth(!(operand as *HIRIntegerLiteral)->value, _type->Width() as u64), _type);
            } else if operand->kind == HIRLiteralKind::Boolean {
                return this.BooleanLiteral(!(operand as *HIRBooleanLiteral)->value, _type);
            } else { return null; }
        } else { return null; }
    }

    pub fn Unary(&mut this, kind: HIRUnaryKind, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Literal && kind != HIRUnaryKind::AddressOf && kind != HIRUnaryKind::Dereference {
            let folded = this.FoldUnary(kind, operand as *HIRLiteral, operand->_type);
            if folded != null { return folded; }
        }

        return this.context->arena.New<HIRUnaryExpression>(kind, operand, operand->_type, HIRExpressionCategory::Value, false);
    }

    fn SignExtend(&this, value: u64, width: u64) -> i64 {
        let masked = this.MaskToWidth(value, width);
        if width >= 64 { return masked as i64; }
        let sign_bit = 1u64 << (width - 1);

        if (masked & sign_bit) != 0 {
            return (masked | !((1u64 << width) - 1)) as i64;
        } return masked as i64;
    }

    fn FoldBinary(&mut this, kind: HIRBinaryKind, left: *HIRLiteral, right: *HIRLiteral, _type: *HIRType) -> *HIRExpression {
        if left->kind == HIRLiteralKind::Integer && right->kind == HIRLiteralKind::Integer {
            let (left, right) = ((left as *HIRIntegerLiteral)->value, (right as *HIRIntegerLiteral)->value);
            if (kind == HIRBinaryKind::Divide || kind == HIRBinaryKind::Modulo) && right == 0 { return null; }
            let (signed, width) = (_type->IsSigned(), _type->Width() as u64);

            if kind == HIRBinaryKind::Add {
                return this.IntegerLiteral(this.MaskToWidth(left + right, width), _type);
            } else if kind == HIRBinaryKind::Subtract {
                return this.IntegerLiteral(this.MaskToWidth(left - right, width), _type);
            } else if kind == HIRBinaryKind::Multiply {
                return this.IntegerLiteral(this.MaskToWidth(left * right, width), _type);
            } else if kind == HIRBinaryKind::Divide {
                return this.IntegerLiteral(this.MaskToWidth(signed ? (this.SignExtend(left, width) / this.SignExtend(right, width)) as u64 : left / right, width), _type);
            } else if kind == HIRBinaryKind::Modulo {
                return this.IntegerLiteral(this.MaskToWidth(signed ? (this.SignExtend(left, width) % this.SignExtend(right, width)) as u64 : left % right, width), _type);
            } else if kind == HIRBinaryKind::BitwiseAnd {
                return this.IntegerLiteral(left & right, _type);
            } else if kind == HIRBinaryKind::BitwiseOr {
                return this.IntegerLiteral(left | right, _type);
            } else if kind == HIRBinaryKind::BitwiseXor {
                return this.IntegerLiteral(left ^ right, _type);
            } else if kind == HIRBinaryKind::LeftShift {
                return this.IntegerLiteral(this.MaskToWidth(left << right, width), _type);
            } else if kind == HIRBinaryKind::RightShift {
                return this.IntegerLiteral(this.MaskToWidth(signed ? (this.SignExtend(left, width) >> right as i64) as u64 : left >> right, width), _type);
            } else if kind == HIRBinaryKind::Equal {
                return this.BooleanLiteral(left == right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::NotEqual {
                return this.BooleanLiteral(left != right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::Less {
                return this.BooleanLiteral(signed ? this.SignExtend(left, width) < this.SignExtend(right, width) : left < right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::LessEqual {
                return this.BooleanLiteral(signed ? this.SignExtend(left, width) <= this.SignExtend(right, width) : left <= right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::Greater {
                return this.BooleanLiteral(signed ? this.SignExtend(left, width) > this.SignExtend(right, width) : left > right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::GreaterEqual {
                return this.BooleanLiteral(signed ? this.SignExtend(left, width) >= this.SignExtend(right, width) : left >= right, this.context->BooleanType());
            } else { return null; }
        } else if left->kind == HIRLiteralKind::Float && right->kind == HIRLiteralKind::Float {
            let left = (left as *HIRFloatLiteral)->value;
            let right = (right as *HIRFloatLiteral)->value;

            if kind == HIRBinaryKind::Add {
                return this.FloatLiteral(left + right, _type);
            } else if kind == HIRBinaryKind::Subtract {
                return this.FloatLiteral(left - right, _type);
            } else if kind == HIRBinaryKind::Multiply {
                return this.FloatLiteral(left * right, _type);
            } else if kind == HIRBinaryKind::Divide {
                return this.FloatLiteral(left / right, _type);
            } else if kind == HIRBinaryKind::Equal {
                return this.BooleanLiteral(left == right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::NotEqual {
                return this.BooleanLiteral(left != right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::Less {
                return this.BooleanLiteral(left < right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::LessEqual {
                return this.BooleanLiteral(left <= right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::Greater {
                return this.BooleanLiteral(left > right, this.context->BooleanType());
            } else if kind == HIRBinaryKind::GreaterEqual {
                return this.BooleanLiteral(left >= right, this.context->BooleanType());
            } else { return null; }
        } else if left->kind == HIRLiteralKind::Boolean && right->kind == HIRLiteralKind::Boolean {
            let left = (left as *HIRBooleanLiteral)->value;
            let right = (right as *HIRBooleanLiteral)->value;

            if kind == HIRBinaryKind::BitwiseAnd || kind == HIRBinaryKind::LogicalAnd {
                return this.BooleanLiteral(left && right, _type);
            } else if kind == HIRBinaryKind::BitwiseOr || kind == HIRBinaryKind::LogicalOr {
                return this.BooleanLiteral(left || right, _type);
            } else if kind == HIRBinaryKind::BitwiseXor || kind == HIRBinaryKind::NotEqual {
                return this.BooleanLiteral(left != right, _type);
            } else if kind == HIRBinaryKind::Equal {
                return this.BooleanLiteral(left == right, _type);
            } else { return null; }
        } else { return null; }
    }

    pub fn Binary(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, _type: *HIRType) -> *HIRExpression {
        return this.Binary(kind, left, right, Vector<*HIRExpression>(), _type);
    }

    pub fn Binary(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) -> *HIRExpression {
        if left->kind == HIRExpressionKind::Literal && right->kind == HIRExpressionKind::Literal {
            let folded = this.FoldBinary(kind, left as *HIRLiteral, right as *HIRLiteral, _type);
            if folded != null { return folded; }
        }

        return this.context->arena.New<HIRBinaryExpression>(kind, left, right, destructors, _type);
    }

    pub fn Ternary(&mut this, condition: *HIRExpression, then_value: *HIRExpression, then_destructors: Vector<*HIRExpression>, else_value: *HIRExpression, else_destructors: Vector<*HIRExpression>, category: HIRExpressionCategory, mutable: bool) -> *mut HIRTernaryExpression {
        return this.context->arena.New<HIRTernaryExpression>(condition, then_value, then_destructors, else_value, else_destructors, category, mutable);
    }

    pub fn Call(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRCallExpression {
        return this.context->arena.New<HIRCallExpression>(callee, arguments);
    }

    fn FoldCast(&mut this, value: *HIRLiteral, target: *HIRType) -> *HIRExpression {
        if !target->IsInteger() && !target->IsFloat() && !target->IsBoolean() && !target->IsCharacter() && !target->IsEnumeration() {
            return null;
        }

        if value->kind == HIRLiteralKind::Integer || value->kind == HIRLiteralKind::Character || value->kind == HIRLiteralKind::Boolean {
            let raw = value->kind == HIRLiteralKind::Boolean ? ((value as *HIRBooleanLiteral)->value ? 1u64 : 0u64)
                : value->kind == HIRLiteralKind::Character ? (value as *HIRCharacterLiteral)->value as u64
                : (value as *HIRIntegerLiteral)->value;

            if target->IsFloat() {
                return this.FloatLiteral(value->_type->IsInteger() && value->_type->IsSigned() ? this.SignExtend(raw, value->_type->Width() as u64) as f64 : raw as f64, target);
            } else {
                return this.IntegerLiteral(this.MaskToWidth(raw, target->Width() as u64), target);
            }
        } else if value->kind == HIRLiteralKind::Float {
            let value = (value as *HIRFloatLiteral)->value;

            if target->IsInteger() {
                return this.IntegerLiteral(this.MaskToWidth(value as u64, target->Width() as u64), target);
            } else {
                return this.FloatLiteral(value, target);
            }
        } else {
            return null;
        }
    }

    pub fn Cast(&mut this, value: *HIRExpression, _type: *HIRType) -> *HIRExpression {
        if value->kind == HIRExpressionKind::Literal {
            let folded = this.FoldCast(value as *HIRLiteral, _type);
            if folded != null { return folded; }
        }

        return this.context->arena.New<HIRCastExpression>(value, _type);
    }

    pub fn IndexAccess(&mut this, value: *HIRExpression, index: *HIRExpression) -> *mut HIRIndexAccessExpression {
        if value->_type->IsArray() {
            return this.context->arena.New<HIRIndexAccessExpression>(value, index, this.context->ReferenceType(value->_type->Element(), value->mutable));
        } else {
            return this.context->arena.New<HIRIndexAccessExpression>(value, index, this.context->ReferenceType(value->_type->Pointee(), value->_type->IsMutable()));
        }
    }

    pub fn FieldAccess(&mut this, instance: *HIRExpression, field: *HIRFieldDeclaration) -> *mut HIRFieldAccessExpression {
        return this.context->arena.New<HIRFieldAccessExpression>(instance, field);
    }

    pub fn MemberAccess(&mut this, instance: *HIRExpression, member: *HIRVariantMember, field: *HIRVariantField) -> *mut HIRMemberAccessExpression {
        return this.context->arena.New<HIRMemberAccessExpression>(instance, member, field);
    }

    pub fn TagAccess(&mut this, instance: *HIRExpression) -> *mut HIRTagAccessExpression {
        return this.context->arena.New<HIRTagAccessExpression>(instance, this.context->IntegerType(8, false));
    }

    pub fn New(&mut this, _type: *HIRType, size: *HIRExpression, initialized: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRNewExpression {
        return this.context->arena.New<HIRNewExpression>(_type, size, initialized, callee, arguments, this.context->PointerType(_type, true));
    }

    pub fn Delete(&mut this, value: *HIRExpression, array: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRDeleteExpression {
        return this.context->arena.New<HIRDeleteExpression>(value, array, callee, arguments, this.context->VoidType());
    }

    pub fn Constructor(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRConstructorExpression {
        return this.context->arena.New<HIRConstructorExpression>(callee, arguments, _type);
    }

    pub fn Destructor(&mut this, instance: *HIRExpression, callee: *HIRExpression) -> *mut HIRDestructorExpression {
        return this.context->arena.New<HIRDestructorExpression>(instance, callee, this.context->VoidType());
    }

    pub fn Intrinsic(&mut this, kind: HIRIntrinsicKind, _type: *HIRType) -> *mut HIRIntrinsicExpression {
        return this.context->arena.New<HIRIntrinsicExpression>(kind, _type, this.context->IntegerPointerType(false));
    }

    pub fn Deferred(&mut this, expression: *ASTExpression, _type: *HIRType) -> *mut HIRDeferredExpression {
        return this.context->arena.New<HIRDeferredExpression>(expression, _type);
    }

    pub fn BuildBlockStatement(&mut this) -> *mut HIRBlockStatement {
        return this.context->arena.New<HIRBlockStatement>();
    }

    pub fn SetCurrentBlock(&mut this, block: *mut HIRBlockStatement) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&this) -> *mut HIRBlockStatement {
        return this.block;
    }

    pub fn BuildVariableStatement(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, mutable: bool) -> *mut HIRVariableStatement {
        return this.context->arena.New<HIRVariableStatement>(name, _type, initializer, mutable);
    }

    pub fn BuildExpressionStatement(&mut this, expression: *HIRExpression) -> *mut HIRExpressionStatement {
        let statement = this.context->arena.New<HIRExpressionStatement>(expression);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildCondition(&mut this, expression: *HIRExpression) -> *mut HIRCondition {
        return this.context->arena.New<HIRCondition>(expression);
    }

    pub fn BuildCondition(&mut this, pattern: *HIRPattern, expression: *HIRExpression) -> *mut HIRCondition {
        return this.context->arena.New<HIRCondition>(pattern, expression);
    }

    pub fn BuildIfStatement(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, then_body: *HIRBlockStatement, else_body: *HIRBlockStatement) -> *mut HIRIfStatement {
        let statement = this.context->arena.New<HIRIfStatement>(condition, destructors, then_body, else_body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildWhileStatement(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, while_body: *HIRBlockStatement, else_body: *HIRBlockStatement) -> *mut HIRWhileStatement {
        let statement = this.context->arena.New<HIRWhileStatement>(condition, destructors, while_body, else_body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildLoopStatement(&mut this, body: *HIRBlockStatement) -> *mut HIRLoopStatement {
        let statement = this.context->arena.New<HIRLoopStatement>(body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildForStatement(&mut this, iterator: *HIRVariableStatement, condition: *HIRExpression, step: *HIRExpression, destructors: Vector<*HIRExpression>, body: *HIRBlockStatement) -> *mut HIRForStatement {
        let statement = this.context->arena.New<HIRForStatement>(iterator, condition, step, destructors, body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildMatchArm(&mut this, pattern: *HIRPattern, guard: *HIRExpression, body: *HIRBlockStatement) -> *mut HIRMatchArm {
        return this.context->arena.New<HIRMatchArm>(pattern, guard, body);
    }

    pub fn BuildMatchStatement(&mut this, target: *HIRExpression, destructors: Vector<*HIRExpression>, arms: Vector<*HIRMatchArm>) -> *mut HIRMatchStatement {
        let statement = this.context->arena.New<HIRMatchStatement>(target, destructors, arms);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildReturnStatement(&mut this, value: *HIRExpression, destructors: Vector<*HIRExpression>) -> *mut HIRReturnStatement {
        let _return = this.context->arena.New<HIRReturnStatement>(value, destructors);
        this.block->statements.PushBack(_return);
        return _return;
    }

    pub fn BuildBreakStatement(&mut this) -> *mut HIRBreakStatement {
        let _break = this.context->arena.New<HIRBreakStatement>();
        this.block->statements.PushBack(_break);
        return _break;
    }

    pub fn BuildContinueStatement(&mut this) -> *mut HIRContinueStatement {
        let _continue = this.context->arena.New<HIRContinueStatement>();
        this.block->statements.PushBack(_continue);
        return _continue;
    }

    pub fn BuildAssemblyOperand(&mut this, name: String, expression: *HIRExpression) -> *mut HIRAssemblyOperand {
        return this.context->arena.New<HIRAssemblyOperand>(name, expression);
    }

    pub fn BuildAssemblyStatement(&mut this, _volatile: bool, text: String, inputs: Vector<*HIRAssemblyOperand>, outputs: Vector<*HIRAssemblyOperand>, clobbers: Vector<String>) -> *mut HIRAssemblyStatement {
        return this.context->arena.New<HIRAssemblyStatement>(_volatile, text, inputs, outputs, clobbers);
    }

    pub fn BuildParameterDeclaration(&mut this, name: String, _type: *HIRType, mutable: bool) -> *mut HIRParameterDeclaration {
        return this.context->arena.New<HIRParameterDeclaration>(name, _type, mutable);
    }

    pub fn BuildFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *HIRType, _type: *HIRType, no_mangle: bool, public: bool, abi: HIRDeclarationABI) -> *mut HIRFunctionDeclaration {
        return this.context->arena.New<HIRFunctionDeclaration>(name, parameters, _return, _type, no_mangle, public, abi);
    }

    pub fn SetCurrentFunction(&mut this, function: *mut HIRFunctionDeclaration) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&this) -> *mut HIRFunctionDeclaration {
        return this.function;
    }

    pub fn BuildFieldDeclaration(&mut this, name: String, _type: *HIRType, index: usize, initializer: *ASTExpression, public: bool) -> *mut HIRFieldDeclaration {
        return this.context->arena.New<HIRFieldDeclaration>(name, _type, index, initializer, public);
    }

    pub fn BuildClassDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRClassDeclaration {
        let declaration = this.context->arena.New<HIRClassDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildStructureDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRStructureDeclaration {
        let declaration = this.context->arena.New<HIRStructureDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildEnumerationMember(&mut this, name: String, value: *HIRExpression, _type: *HIRType) -> *mut HIREnumerationMember {
        return this.context->arena.New<HIREnumerationMember>(name, value, _type);
    }

    pub fn BuildEnumerationDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIREnumerationDeclaration {
        let declaration = this.context->arena.New<HIREnumerationDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildVariantField(&mut this, name: String, _type: *HIRType, index: usize) -> *mut HIRVariantField {
        return this.context->arena.New<HIRVariantField>(name, _type, index);
    }

    pub fn BuildVariantMember(&mut this, name: String, _type: *HIRType, index: usize) -> *mut HIRVariantMember {
        return this.context->arena.New<HIRVariantMember>(name, _type, index);
    }

    pub fn BuildVariantDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRVariantDeclaration {
        let declaration = this.context->arena.New<HIRVariantDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildExtendDeclaration(&mut this, _type: *HIRType) -> *mut HIRExtendDeclaration {
        let declaration = this.context->arena.New<HIRExtendDeclaration>(_type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildConstantDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression) -> *mut HIRConstantDeclaration {
        let declaration = this.context->arena.New<HIRConstantDeclaration>(name, _type, initializer);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildStaticDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) -> *mut HIRStaticDeclaration {
        let declaration = this.context->arena.New<HIRStaticDeclaration>(name, _type, initializer, alignment, mutable, linkage);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildAssemblyDeclaration(&mut this, text: String) -> *mut HIRAssemblyDeclaration {
        let declaration = this.context->arena.New<HIRAssemblyDeclaration>(text);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }
}

