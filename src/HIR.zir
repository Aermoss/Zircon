    HIRIfExpression(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, then_body: *HIRBlockExpression, else_body: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::If, _type) {
        (this.condition, this.destructors, this.then_body, this.else_body) = (condition, destructors, then_body, else_body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "if " + this.condition->ToString() + ' ' + this.then_body->ToString(indent);

        if this.else_body != null {
            result += " else " + this.else_body->ToString(indent);
        }

        result
    }
}

