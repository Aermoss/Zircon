#[include "std/str", "std/vec", "std/arena",
    "src/AST.zir", "src/Generic.zir", "src/Logger.zir" : *]

enum HIRTypeKind: u8 {
    Never, Void, Boolean, Character, Integer, Float, Pointer, Reference,
    Array, Tuple, Function, Class, Structure, Enumeration, Variant
}

class HIRType {
    pub kind: HIRTypeKind;

    HIRType(&mut this, kind: HIRTypeKind) {
        this.kind = kind;
    }

    pub fn IsMutable(&this) -> bool { (this.kind == HIRTypeKind::Pointer && (this as *HIRPointerType)->mutable) || (this.kind == HIRTypeKind::Reference && (this as *HIRReferenceType)->mutable) }
    pub fn IsLiteral(&this) -> bool { (this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->literal) || (this.kind == HIRTypeKind::Float && (this as *HIRFloatType)->literal) }
    pub fn IsSigned(&this) -> bool { this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->signed }

    pub fn IsNever(&this) -> bool { this.kind == HIRTypeKind::Never }
    pub fn IsVoid(&this) -> bool { this.kind == HIRTypeKind::Void }
    pub fn IsBoolean(&this) -> bool { this.kind == HIRTypeKind::Boolean }
    pub fn IsCharacter(&this) -> bool { this.kind == HIRTypeKind::Character }
    pub fn IsInteger(&this) -> bool { this.kind == HIRTypeKind::Integer }
    pub fn IsIntegerPointer(&this) -> bool { this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->native }
    pub fn IsIntegerLiteral(&this) -> bool { this.kind == HIRTypeKind::Integer && (this as *HIRIntegerType)->literal }
    pub fn IsFloat(&this) -> bool { this.kind == HIRTypeKind::Float }
    pub fn IsFloatLiteral(&this) -> bool { this.kind == HIRTypeKind::Float && (this as *HIRFloatType)->literal }
    pub fn IsPointer(&this) -> bool { this.kind == HIRTypeKind::Pointer || this.kind == HIRTypeKind::Reference }
    pub fn IsNullPointer(&this) -> bool { this.kind == HIRTypeKind::Pointer && (this as *HIRPointerType)->_null == true }
    pub fn IsReference(&this) -> bool { this.kind == HIRTypeKind::Reference }
    pub fn IsArray(&this) -> bool { this.kind == HIRTypeKind::Array }
    pub fn IsTuple(&this) -> bool { this.kind == HIRTypeKind::Tuple }
    pub fn IsUnit(&this) -> bool { this.IsTuple() && (this as *HIRTupleType)->elements.Empty() }
    pub fn IsFunction(&this) -> bool { this.kind == HIRTypeKind::Function }
    pub fn IsClass(&this) -> bool { this.kind == HIRTypeKind::Class }
    pub fn IsStructure(&this) -> bool { this.kind == HIRTypeKind::Structure }
    pub fn IsEnumeration(&this) -> bool { this.kind == HIRTypeKind::Enumeration }
    pub fn IsVariant(&this) -> bool { this.kind == HIRTypeKind::Variant }

    pub fn IsTrivial(&this) -> bool {
        if this.IsNever() || this.IsVoid() || this.IsBoolean() || this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsPointer() || this.IsReference() || this.IsFunction() || this.IsEnumeration() {
            true
        } else if this.IsArray() {
            (this as *HIRArrayType)->element->IsTrivial()
        } else if this.IsTuple() {
            for element in (this as *HIRTupleType)->elements {
                if !element->IsTrivial() {
                    return false;
                }
            }

            true
        } else if this.IsStructure() {
            for field in (this as *HIRStructureType)->declaration->fields {
                if !field->_type->IsTrivial() {
                    return false;
                }
            }

            true
        } else if this.IsVariant() {
            for member in (this as *HIRVariantType)->declaration->members {
                for field in member->fields {
                    if !field->_type->IsTrivial() {
                        return false;
                    }
                }
            }

            true
        } else {
            false
        }
    }

    pub fn FindField(&this, name: &String, path: &mut Vector<u32>, ambiguous: &mut bool) -> *HIRFieldDeclaration {
        let parents = (this as *HIRClassType)->declaration->parents;
        let (index, mut result) = (this.Index(name), null as *HIRFieldDeclaration);
        if index != -1 { return this.Fields()[index as usize]; }

        for i in 0..parents.Size() {
            let mut parent_path = Vector<u32>();
            let field = parents[i]->FindField(name, &mut parent_path, ambiguous);
            if field == null { continue; }

            if result != null {
                ambiguous = true;
                return result;
            }
            
            path.Clear();
            path.PushBack(i as u32);
            path += parent_path;
            result = field;
        }

        result
    }

    pub fn FindParentPath(&this, other: &HIRType, path: &mut Vector<u32>) -> bool {
        let parents = (this as *HIRClassType)->declaration->parents;

        for i in 0..parents.Size() {
            path.PushBack(i as u32);

            if *parents[i] == other || parents[i]->FindParentPath(other, path) {
                return true;
            }

            path.PopBack();
        }

        false
    }

    pub fn IsDerivedFrom(&this, other: &HIRType) -> bool {
        for parent in (this as *HIRClassType)->declaration->parents {
            if *parent == other || parent->IsDerivedFrom(other) {
                return true;
            }
        }

        false
    }

    pub fn IsCompatible(&this, other: &HIRType) -> bool {
        if other.IsNever() {
            return true;
        }

        if this.IsFunction() && other.IsNullPointer() {
            return true;
        }

        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return true;
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if other.Pointee().IsDerivedFrom(this.Pointee()) {
                    return true;
                }
            }
        }

        if this.IsClass() && other.IsClass() {
            if other.IsDerivedFrom(this) {
                return true;
            }
        }

        this == other
    }

    pub fn IsMutabilityCompatible(&this, other: &HIRType) -> bool {
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if left->IsArray() && right->IsArray() {
            left->Element().IsMutabilityCompatible(right->Element())
        } else if left->IsTuple() && right->IsTuple() {
            let &lefts = (left as *HIRTupleType)->elements;
            let &rights = (right as *HIRTupleType)->elements;
            if lefts.Size() != rights.Size() { return true; }

            for i in 0..lefts.Size() {
                if !lefts[i]->IsMutabilityCompatible(rights[i]) { return false; }
            }

            true
        } else {
            true
        }
    }

    pub fn IsSame(&this, other: &HIRType) -> bool {
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() || left->IsReference() != right->IsReference() || right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if left->IsArray() && right->IsArray() {
            left->Length() == right->Length() && left->Element().IsSame(right->Element())
        } else if left->IsTuple() && right->IsTuple() {
            let &lefts = (left as *HIRTupleType)->elements;
            let &rights = (right as *HIRTupleType)->elements;
            if lefts.Size() != rights.Size() { return false; }

            for i in 0..lefts.Size() {
                if !lefts[i]->IsSame(rights[i]) { return false; }
            }

            true
        } else {
            this == other
        }
    }

    pub fn ContainsLiteral(&this) -> bool {
        if this.IsArray() {
            this.Element().ContainsLiteral()
        } else if this.IsTuple() {
            for element in (this as *HIRTupleType)->elements {
                if element->ContainsLiteral() {
                    return true;
                }
            }

            false
        } else {
            this.IsLiteral()
        }
    }

    pub fn ScorePointer(&this, other: &HIRType, base: u64) -> u64 {
        let mut reference_mismatch = false;
        let mut mutability_mismatch = false;
        let mut left: *HIRType = this;
        let mut right: *HIRType = other;
        let mut score = base;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return 0;
            }

            mutability_mismatch |= left->IsMutable() != right->IsMutable();
            reference_mismatch |= left->IsReference() != right->IsReference();
            (left, right) = (left->Pointee(), right->Pointee());
        }

        if reference_mismatch { score -= 10; }
        if mutability_mismatch { score -= 1; }
        score
    }

    pub fn ScoreParameter(&this, other: &HIRType) -> u64 {
        if other.IsLiteral() {
            if this.IsInteger() && other.IsInteger() {
                let (left, right) = (this as *HIRIntegerType, other as *HIRIntegerType);

                if left->width == right->width && left->signed == right->signed && left->native == right->native {
                    return 100;
                } return 1;
            } else if this.IsFloat() && other.IsFloat() {
                if (this as *HIRFloatType)->width == (other as *HIRFloatType)->width {
                    return 100;
                } return 1;
            } return 0;
        }

        if this == other {
            return this.ScorePointer(other, 100);
        }

        if this.IsTuple() && other.IsTuple() {
            let (left, right) = (this as *HIRTupleType, other as *HIRTupleType);
            if left->elements.Size() != right->elements.Size() { return 0; }
            let mut score: u64 = 100;

            for i in 0..left->elements.Size() {
                let element_score = left->elements[i]->ScoreParameter(*right->elements[i]);
                if element_score == 0 { return 0; }
                if element_score < score { score = element_score; }
            } return score;
        }

        if this.IsReference() {
            let score = this.Pointee().ScoreParameter(other);
            if score != 0 { return score - 3; }
        }

        if other.IsReference() {
            let score = this.ScoreParameter(other.Pointee());
            if score != 0 { return score - 3; }
        }

        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return this.ScorePointer(other, 30);
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if other.Pointee().IsDerivedFrom(this.Pointee()) {
                    return this.ScorePointer(other, 70);
                }
            }
        }

        if this.IsClass() && other.IsClass() {
            if other.IsDerivedFrom(this) {
                return 70;
            }
        }

        0
    }

    pub fn Pointee(&this) -> &HIRType {
        if !this.IsPointer() {
            Logger::Log("HIRType", "Not a pointer!", LogSeverity::Fatal);
        }

        if this.IsReference() {
            (this as *HIRReferenceType)->referent
        } else {
            (this as *HIRPointerType)->pointee
        }
    }

    pub fn Width(&this) -> u32 {
        if !this.IsBoolean() && !this.IsCharacter() && !this.IsInteger() && !this.IsFloat() && !this.IsEnumeration() {
            Logger::Log("HIRType", "Not a boolean, character, integer, float or enumeration!", LogSeverity::Fatal);
        }

        if this.IsBoolean() { 1 }
        else if this.IsCharacter() { 8 }
        else if this.IsInteger() { (this as *HIRIntegerType)->width }
        else if this.IsFloat() { (this as *HIRFloatType)->width }
        else { (this as *HIREnumerationType)->underlying->width }
    }

    pub fn Alignment(&this) -> usize {
        if this.IsBoolean() {
            1
        } else if this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsEnumeration() {
            (this.Width() / 8) as usize
        } else if this.IsPointer() || this.IsFunction() {
            llvm_lowerer->target->Info().pointer_size
        } else if this.IsArray() {
            this.Element().Alignment()
        } else if this.IsTuple() {
            let mut alignment: usize = 1;

            for element in (this as *HIRTupleType)->elements {
                let element_alignment = element->Alignment();
                if element_alignment > alignment { alignment = element_alignment; }
            }

            alignment
        } else if this.HasFields() {
            let mut alignment: usize = 1;

            if this.IsClass() {
                for parent in (this as *HIRClassType)->declaration->parents {
                    let parent_alignment = parent->Alignment();
                    if parent_alignment > alignment { alignment = parent_alignment; }
                }
            }

            for field in this.Fields() {
                let field_alignment = field->_type->Alignment();
                if field_alignment > alignment { alignment = field_alignment; }
            }

            alignment
        } else if this.IsVariant() {
            let mut alignment: usize = 1;

            for member in (this as *HIRVariantType)->declaration->members {
                for field in member->fields {
                    let field_alignment = field->_type->Alignment();
                    if field_alignment > alignment { alignment = field_alignment; }
                }
            }

            alignment
        } else {
            1
        }
    }

    pub fn Size(&this) -> usize {
        if this.IsNever() || this.IsVoid() {
            0
        } else if this.IsBoolean() {
            1
        } else if this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsEnumeration() {
            (this.Width() / 8) as usize
        } else if this.IsPointer() || this.IsFunction() {
            llvm_lowerer->target->Info().pointer_size
        } else if this.IsArray() {
            this.Element().Size() * this.Length()
        } else if this.IsTuple() {
            let mut size: usize = 0;
            let mut alignment: usize = 1;

            for element in (this as *HIRTupleType)->elements {
                let element_alignment = element->Alignment();
                if element_alignment > alignment { alignment = element_alignment; }
                let remainder = size % element_alignment;
                if remainder != 0 { size += element_alignment - remainder; }
                size += element->Size();
            }

            let remainder = size % alignment;
            if remainder != 0 { size += alignment - remainder; }
            size
        } else if this.HasFields() {
            let mut size: usize = 0;
            let mut alignment: usize = 1;

            if this.IsClass() {
                for parent in (this as *HIRClassType)->declaration->parents {
                    let parent_alignment = parent->Alignment();
                    if parent_alignment > alignment { alignment = parent_alignment; }
                    let remainder = size % parent_alignment;
                    if remainder != 0 { size += parent_alignment - remainder; }
                    size += parent->Size();
                }
            }

            for field in this.Fields() {
                let field_alignment = field->_type->Alignment();
                if field_alignment > alignment { alignment = field_alignment; }
                let remainder = size % field_alignment;
                if remainder != 0 { size += field_alignment - remainder; }
                size += field->_type->Size();
            }

            let remainder = size % alignment;
            if remainder != 0 { size += alignment - remainder; }
            size
        } else if this.IsVariant() {
            let mut size: usize = 0;
            let mut alignment: usize = 1;

            for member in (this as *HIRVariantType)->declaration->members {
                let mut member_size: usize = 1;

                for field in member->fields {
                    let field_alignment = field->_type->Alignment();
                    if field_alignment > alignment { alignment = field_alignment; }
                    let remainder = member_size % field_alignment;
                    if remainder != 0 { member_size += field_alignment - remainder; }
                    member_size += field->_type->Size();
                }

                if member_size > size {
                    size = member_size;
                }
            }

            let remainder = size % alignment;
            if remainder != 0 { size += alignment - remainder; }
            size
        } else {
            0
        }
    }

    pub fn Length(&this) -> usize {
        if !this.IsArray() {
            Logger::Log("HIRType", "Not an array!", LogSeverity::Fatal);
        }

        (this as *HIRArrayType)->length
    }

    pub fn Element(&this) -> &HIRType {
        if !this.IsArray() {
            Logger::Log("HIRType", "Not an array!", LogSeverity::Fatal);
        }

        (this as *HIRArrayType)->element
    }

    pub fn Parameters(&this) -> &Vector<*HIRType> {
        if !this.IsFunction() {
            Logger::Log("HIRType", "Not a function!", LogSeverity::Fatal);
        }

        (this as *HIRFunctionType)->parameters
    }

    pub fn Return(&this) -> &HIRType {
        if !this.IsFunction() {
            Logger::Log("HIRType", "Not a function!", LogSeverity::Fatal);
        }

        (this as *HIRFunctionType)->_return
    }

    pub fn Fields(&this) -> &Vector<*HIRFieldDeclaration> {
        if !this.HasFields() {
            Logger::Log("HIRType", "Not a class or structure!", LogSeverity::Fatal);
        }

        if this.IsClass() {
            (this as *HIRClassType)->declaration->fields
        } else {
            (this as *HIRStructureType)->declaration->fields
        }
    }

    pub fn HasFields(&this) -> bool {
        this.IsClass() || this.IsStructure()
    }

    pub fn HasSpecialMembers(&this) -> bool {
        this.IsClass() || this.IsStructure() || this.IsVariant() || this.IsArray() || (this.IsTuple() && !this.IsUnit())
    }

    pub fn Index(&this, name: &String) -> isize {
        let fields = this.Fields();

        for i in 0..fields.Size() {
            if fields[i]->name == name {
                return i as isize;
            }
        }

        -1
    }

    pub fn Methods(&this) -> &Vector<*mut HIRFunctionDeclaration> {
        if !this.HasMethods() {
            Logger::Log("HIRType", "Not a class, structure or variant!", LogSeverity::Fatal);
        }

        if this.IsClass() {
            (this as *HIRClassType)->declaration->methods
        } else if this.IsStructure() {
            (this as *HIRStructureType)->declaration->methods
        } else {
            (this as *HIRVariantType)->declaration->methods
        }
    }

    pub fn HasMethods(&this) -> bool {
        this.IsClass() || this.IsStructure() || this.IsVariant()
    }

    pub fn GetCandidates(&this, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut found = false;

        if this.IsClass() {
            let declaration = (this as *HIRClassType)->declaration;

            if declaration->name == name {
                for constructor in declaration->constructors {
                    result.PushBack(constructor);
                } return result;
            } else if ('~' + declaration->name) == name {
                result.PushBack(declaration->destructor);
                return result;
            }
        }

        this.CollectMethods(name, result, found);

        if result.Empty() && !test {
            if found {
                Logger::Log("Method '" + name + "' is not accessible.", node, LogSeverity::Error);
            } else {
                Logger::Log("Invalid arguments for method: '" + name + "'.", node, LogSeverity::Error);
            }
        }

        result
    }

    fn CollectMethods(&this, name: &String, result: &mut Vector<*HIRFunctionDeclaration>, found: &mut bool) {
        for method in this.Methods() {
            if method->name != name {
                continue;
            }

            if method->public || (hir_lowerer->current_type != null && *hir_lowerer->current_type == this) {
                result.PushBack(method);
            } found = true;
        }

        if !found && this.IsClass() && name != "operator=" {
            for parent in (this as *HIRClassType)->declaration->parents {
                parent->CollectMethods(name, result, found);
            }
        }
    }

    pub fn operator==(&this, other: &HIRType) -> bool {
        if (this.IsNever() && other.IsNever()) || (this.IsVoid() && other.IsVoid()) || (this.IsBoolean() && other.IsBoolean()) || (this.IsCharacter() && other.IsCharacter()) {
            true
        } else if this.IsInteger() && other.IsInteger() {
            let (left, right) = (this as *HIRIntegerType, other as *HIRIntegerType);
            left->signed == right->signed && left->width == right->width && left->native == right->native
        } else if this.IsFloat() && other.IsFloat() {
            (this as *HIRFloatType)->width == (other as *HIRFloatType)->width
        } else if this.IsPointer() && other.IsPointer() {
            let (mut left, mut right): (*HIRType, *HIRType) = (null, null);

            if this.IsReference() {
                left = (this as *HIRReferenceType)->referent;
            } else {
                left = (this as *HIRPointerType)->pointee;
            }

            if other.IsReference() {
                right = (other as *HIRReferenceType)->referent;
            } else {
                right = (other as *HIRPointerType)->pointee;
            }

            *left == *right
        } else if this.IsArray() && other.IsArray() {
            let (left, right) = (this as *HIRArrayType, other as *HIRArrayType);
            left->element == right->element && left->length == right->length
        } else if this.IsTuple() && other.IsTuple() {
            let (left, right) = (this as *HIRTupleType, other as *HIRTupleType);
            if left->elements.Size() != right->elements.Size() { return false; }

            for i in 0..left->elements.Size() {
                let (left_element, right_element) = (left->elements[i], right->elements[i]);

                if left_element != right_element {
                    if left_element == null || right_element == null { return false; }
                    if *left_element != *right_element { return false; }
                }
            }

            true
        } else if this.IsFunction() && other.IsFunction() {
            let (left, right) = (this as *HIRFunctionType, other as *HIRFunctionType);

            if left->parameters.Size() != right->parameters.Size() {
                return false;
            }

            for i in 0..left->parameters.Size() {
                let (left_parameter, right_parameter) = (left->parameters[i], right->parameters[i]);

                if left_parameter != right_parameter {
                    if left_parameter == null || right_parameter == null { return false; }
                    if *left_parameter != *right_parameter { return false; }
                }
            }

            let (left_return, right_return) = (left->_return, right->_return);

            if left_return != right_return {
                if left_return == null || right_return == null { return false; }
                if *left_return != *right_return { return false; }
            }

            true
        } else if this.IsClass() && other.IsClass() {
            (this as *HIRClassType)->declaration == (other as *HIRClassType)->declaration
        } else if this.IsStructure() && other.IsStructure() {
            (this as *HIRStructureType)->declaration == (other as *HIRStructureType)->declaration
        } else if this.IsEnumeration() && other.IsEnumeration() {
            (this as *HIREnumerationType)->declaration == (other as *HIREnumerationType)->declaration
        } else if this.IsVariant() && other.IsVariant() {
            (this as *HIRVariantType)->declaration == (other as *HIRVariantType)->declaration
        } else {
            false
        }
    }

    pub fn operator!=(&this, other: &HIRType) -> bool {
        !(this == other)
    }

    pub fn ToString(&this) -> String {
        match this.kind {
            HIRTypeKind::Never => (this as *HIRNeverType)->ToString(),
            HIRTypeKind::Void => (this as *HIRVoidType)->ToString(),
            HIRTypeKind::Boolean => (this as *HIRBooleanType)->ToString(),
            HIRTypeKind::Character => (this as *HIRCharacterType)->ToString(),
            HIRTypeKind::Integer => (this as *HIRIntegerType)->ToString(),
            HIRTypeKind::Float => (this as *HIRFloatType)->ToString(),
            HIRTypeKind::Pointer => (this as *HIRPointerType)->ToString(),
            HIRTypeKind::Reference => (this as *HIRReferenceType)->ToString(),
            HIRTypeKind::Array => (this as *HIRArrayType)->ToString(),
            HIRTypeKind::Tuple => (this as *HIRTupleType)->ToString(),
            HIRTypeKind::Function => (this as *HIRFunctionType)->ToString(),
            HIRTypeKind::Class => (this as *HIRClassType)->ToString(),
            HIRTypeKind::Structure => (this as *HIRStructureType)->ToString(),
            HIRTypeKind::Enumeration => (this as *HIREnumerationType)->ToString(),
            HIRTypeKind::Variant => (this as *HIRVariantType)->ToString()
        }
    }
}

class HIRNeverType : HIRType {
    HIRNeverType(&mut this) : HIRType(HIRTypeKind::Never) {}

    pub fn ToString(&this) -> String {
        '!'.ToString()
    }
}

class HIRVoidType : HIRType {
    HIRVoidType(&mut this) : HIRType(HIRTypeKind::Void) {}

    pub fn ToString(&this) -> String {
        "void".ToString()
    }
}

class HIRBooleanType : HIRType {
    HIRBooleanType(&mut this) : HIRType(HIRTypeKind::Boolean) {}

    pub fn ToString(&this) -> String {
        "bool".ToString()
    }
}

class HIRCharacterType : HIRType {
    HIRCharacterType(&mut this) : HIRType(HIRTypeKind::Character) {}

    pub fn ToString(&this) -> String {
        "char".ToString()
    }
}

class HIRIntegerType : HIRType {
    pub width: u32,
    pub signed: bool,
    pub literal: bool,
    pub native: bool;

    HIRIntegerType(&mut this, width: u32, signed: bool, literal: bool, native: bool) : HIRType(HIRTypeKind::Integer) {
        (this.width, this.signed, this.literal, this.native) = (width, signed, literal, native);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            if !this.native {
                (if this.signed { 'i' } else { 'u' }) + String::FromInteger(this.width as u64)
            } else {
                (if this.signed { "isize" } else { "usize" }).ToString()
            }
        } else {
            "<integer literal>".ToString()
        }
    }
}

class HIRFloatType : HIRType {
    pub width: u32,
    pub literal: bool;

    HIRFloatType(&mut this, width: u32, literal: bool) : HIRType(HIRTypeKind::Float) {
        (this.width, this.literal) = (width, literal);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            'f' + String::FromInteger(this.width as u64)
        } else {
            "<float literal>".ToString()
        }
    }
}

class HIRPointerType : HIRType {
    pub pointee: *HIRType,
    pub mutable: bool,
    pub _null: bool = false;

    HIRPointerType(&mut this, pointee: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Pointer) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub fn ToString(&this) -> String {
        (if this.mutable { "*mut " } else { "*" }) + this.pointee->ToString()
    }
}

class HIRReferenceType : HIRType {
    pub referent: *HIRType,
    pub mutable: bool;

    HIRReferenceType(&mut this, referent: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Reference) {
        (this.referent, this.mutable) = (referent, mutable);
    }

    pub fn ToString(&this) -> String {
        (if this.mutable { "&mut " } else { "&" }) + this.referent->ToString()
    }
}

class HIRArrayType : HIRType {
    pub element: *HIRType,
    pub length: usize,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null;

    HIRArrayType(&mut this, element: *HIRType, length: usize) : HIRType(HIRTypeKind::Array) {
        (this.element, this.length) = (element, length);
    }

    pub fn ToString(&this) -> String {
        '[' + this.element->ToString() + "; " + String::FromInteger(this.length as u64) + ']'
    }
}

class HIRTupleType : HIRType {
    pub elements: Vector<*HIRType>,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null;

    HIRTupleType(&mut this, elements: Vector<*HIRType>) : HIRType(HIRTypeKind::Tuple) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.elements.Size() {
            if i != 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ')'
    }
}

class HIRFunctionType : HIRType {
    pub parameters: Vector<*HIRType>,
    pub _return: *HIRType;

    HIRFunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) : HIRType(HIRTypeKind::Function) {
        (this.parameters, this._return) = (parameters, _return);
    }

    pub fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            result += this.parameters[i]->ToString();
        } result += ')';

        if this._return->kind != HIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        }

        result
    }
}

class HIRClassType : HIRType {
    pub declaration: *HIRClassDeclaration;

    HIRClassType(&mut this, declaration: *HIRClassDeclaration) : HIRType(HIRTypeKind::Class) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        '%' + this.declaration->name
    }
}

class HIRStructureType : HIRType {
