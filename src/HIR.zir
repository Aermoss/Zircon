    HIRStructureType(&mut this, declaration: *HIRStructureDeclaration) : HIRType(HIRTypeKind::Structure) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        '%' + this.declaration->name
    }
}

class HIREnumerationType : HIRType {
    pub declaration: *HIREnumerationDeclaration,
    pub underlying: *HIRIntegerType;

    HIREnumerationType(&mut this, declaration: *HIREnumerationDeclaration, underlying: *HIRIntegerType) : HIRType(HIRTypeKind::Enumeration) {
        (this.declaration, this.underlying) = (declaration, underlying);
    }

    pub fn ToString(&this) -> String {
        '%' + this.declaration->name
    }
}

class HIRVariantType : HIRType {
    pub declaration: *HIRVariantDeclaration;

    HIRVariantType(&mut this, declaration: *HIRVariantDeclaration) : HIRType(HIRTypeKind::Variant) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        '%' + this.declaration->name
    }
}

enum HIRPatternKind: u8 {
    Wildcard, Rest, Literal, Range, Identifier, Tuple, Field, Structure, Enumeration, Variant, Or, Dereference
}

class HIRPattern {
    pub kind: HIRPatternKind;

    HIRPattern(&mut this, kind: HIRPatternKind) {
        this.kind = kind;
    }

    pub fn IsIrrefutable(&this) -> bool {
        match this.kind {
            HIRPatternKind::Wildcard | HIRPatternKind::Rest | HIRPatternKind::Identifier => {
                return true;
            },
            HIRPatternKind::Literal | HIRPatternKind::Range => {
                return false;
            },
            HIRPatternKind::Tuple => {
                for pattern in (this as *HIRTuplePattern)->patterns {
                    if !pattern->IsIrrefutable() { return false; }
                } return true;
            },
            HIRPatternKind::Field => {
                return (this as *HIRFieldPattern)->pattern->IsIrrefutable();
            },
            HIRPatternKind::Structure => {
                for pattern in (this as *HIRStructurePattern)->patterns {
                    if !pattern->IsIrrefutable() { return false; }
                } return true;
            },
            HIRPatternKind::Variant => {
                let variant = this as *HIRVariantPattern;

                if (variant->member->_type as *HIRVariantType)->declaration->members.Size() != 1 {
                    return false;
                }

                for pattern in variant->patterns {
                    if !pattern->IsIrrefutable() { return false; }
                } return true;
            },
            HIRPatternKind::Or => {
                for pattern in (this as *HIROrPattern)->patterns {
                    if pattern->IsIrrefutable() { return true; }
                } return false;
            },
            HIRPatternKind::Dereference => {
                return (this as *HIRDereferencePattern)->pattern->IsIrrefutable();
            },
            _ => {}
        }

        false
    }

    pub fn ToString(&this) -> String {
        match this.kind {
            HIRPatternKind::Wildcard => (this as *HIRWildcardPattern)->ToString(),
            HIRPatternKind::Rest => (this as *HIRRestPattern)->ToString(),
            HIRPatternKind::Literal => (this as *HIRLiteralPattern)->ToString(),
            HIRPatternKind::Range => (this as *HIRRangePattern)->ToString(),
            HIRPatternKind::Identifier => (this as *HIRIdentifierPattern)->ToString(),
            HIRPatternKind::Tuple => (this as *HIRTuplePattern)->ToString(),
            HIRPatternKind::Field => (this as *HIRFieldPattern)->ToString(),
            HIRPatternKind::Structure => (this as *HIRStructurePattern)->ToString(),
            HIRPatternKind::Enumeration => (this as *HIREnumerationPattern)->ToString(),
            HIRPatternKind::Variant => (this as *HIRVariantPattern)->ToString(),
            HIRPatternKind::Or => (this as *HIROrPattern)->ToString(),
            HIRPatternKind::Dereference => (this as *HIRDereferencePattern)->ToString()
        }
    }
}

class HIRWildcardPattern : HIRPattern {
    HIRWildcardPattern(&mut this) : HIRPattern(HIRPatternKind::Wildcard) {}

    pub fn ToString(&this) -> String {
        '_'.ToString()
    }
}

class HIRRestPattern : HIRPattern {
    HIRRestPattern(&mut this) : HIRPattern(HIRPatternKind::Rest) {}

    pub fn ToString(&this) -> String {
        "..".ToString()
    }
}

class HIRLiteralPattern : HIRPattern {
    pub literal: *HIRExpression;

    HIRLiteralPattern(&mut this, literal: *HIRExpression) : HIRPattern(HIRPatternKind::Literal) {
        this.literal = literal;
    }

    pub fn ToString(&this) -> String {
        this.literal->ToString()
    }
}

class HIRRangePattern : HIRPattern {
    pub start: *HIRExpression,
    pub end: *HIRExpression,
    pub inclusive: bool;

    HIRRangePattern(&mut this, start: *HIRExpression, end: *HIRExpression, inclusive: bool) : HIRPattern(HIRPatternKind::Range) {
        (this.start, this.end, this.inclusive) = (start, end, inclusive);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();
        if this.start != null { result += this.start->ToString(); }
        result += if this.inclusive { "..=" } else { ".." };
        if this.end != null { result += this.end->ToString(); }
        result
    }
}

class HIRIdentifierPattern : HIRPattern {
    pub name: String,
    pub _type: *HIRType,
    pub value: *HIRExpression,
    pub mutable: bool;

    HIRIdentifierPattern(&mut this, name: String, _type: *HIRType, value: *HIRExpression, mutable: bool) : HIRPattern(HIRPatternKind::Identifier) {
        (this.name, this._type, this.value, this.mutable) = (name, _type, value, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();
        if this.mutable { result += "mut "; }
        result + this.name
    }
}

class HIRTuplePattern : HIRPattern {
    pub patterns: Vector<*HIRPattern>,
    pub _type: *HIRTupleType;

    HIRTuplePattern(&mut this, patterns: Vector<*HIRPattern>, _type: *HIRTupleType) : HIRPattern(HIRPatternKind::Tuple) {
        (this.patterns, this._type) = (patterns, _type);
    }

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            result += this.patterns[i]->ToString();
        }

        result + ')'
    }
}

class HIRFieldPattern : HIRPattern {
    pub name: String,
    pub pattern: *HIRPattern;

    HIRFieldPattern(&mut this, name: String, pattern: *HIRPattern) : HIRPattern(HIRPatternKind::Field) {
        (this.name, this.pattern) = (name, pattern);
    }

    pub fn ToString(&this) -> String {
        this.name + ": " + this.pattern->ToString()
    }
}

class HIRStructurePattern : HIRPattern {
    pub declaration: *HIRStructureDeclaration,
    pub patterns: Vector<*HIRPattern>;

    HIRStructurePattern(&mut this, declaration: *HIRStructureDeclaration, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Structure) {
        (this.declaration, this.patterns) = (declaration, patterns);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.declaration->name + " { ";

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            result += this.patterns[i]->ToString();
        }

        result + " }"
    }
}

class HIREnumerationPattern : HIRPattern {
    pub member: *HIREnumerationMember;

    HIREnumerationPattern(&mut this, member: *HIREnumerationMember) : HIRPattern(HIRPatternKind::Enumeration) {
        this.member = member;
    }

    pub fn ToString(&this) -> String {
        this.member->name
    }
}

class HIRVariantPattern : HIRPattern {
    pub member: *HIRVariantMember,
    pub patterns: Vector<*HIRPattern>;

    HIRVariantPattern(&mut this, member: *HIRVariantMember, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Variant) {
        (this.member, this.patterns) = (member, patterns);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.member->name + '(';

        for i in 0..this.patterns.Size() {
            if i != 0 { result += ", "; }
            result += this.patterns[i]->ToString();
        }

        result + ')'
    }
}

class HIRDereferencePattern : HIRPattern {
    pub binding: *HIRIdentifierPattern,
    pub pattern: *HIRPattern;

    HIRDereferencePattern(&mut this, binding: *HIRIdentifierPattern, pattern: *HIRPattern) : HIRPattern(HIRPatternKind::Dereference) {
        (this.binding, this.pattern) = (binding, pattern);
    }

    pub fn ToString(&this) -> String {
        '*' + this.pattern->ToString()
    }
}

class HIROrPattern : HIRPattern {
    pub patterns: Vector<*HIRPattern>;

    HIROrPattern(&mut this, patterns: Vector<*HIRPattern>) : HIRPattern(HIRPatternKind::Or) {
        this.patterns = patterns;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        for i in 0..this.patterns.Size() {
            if i != 0 { result += " | "; }
            result += this.patterns[i]->ToString();
        }

        result
    }
}

enum HIRExpressionKind: u8 {
    Literal,
    BindingReference, DeclarationReference,
    Assignment, Unary, Binary, Call, Cast,
    IndexAccess, TupleAccess, FieldAccess, MemberAccess, TagAccess,
    New, Delete, Constructor, Destructor,
    Intrinsic, Deferred,
    Block, If, While, Loop, For, Match, Return, Break, Continue
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *HIRType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = true;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *HIRType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *HIRType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    pub fn Precedence(&this) -> u8 {
        match this.kind {
            HIRExpressionKind::Assignment => 10,
            HIRExpressionKind::Binary => {
                let binary = this as *HIRBinaryExpression;

                match binary->kind {
                    HIRBinaryKind::LogicalOr => 30,
                    HIRBinaryKind::LogicalAnd => 40,
                    HIRBinaryKind::BitwiseOr => 50,
                    HIRBinaryKind::BitwiseXor => 60,
                    HIRBinaryKind::BitwiseAnd => 70,
                    HIRBinaryKind::Equal | HIRBinaryKind::NotEqual => 80,
                    HIRBinaryKind::Less | HIRBinaryKind::LessEqual | HIRBinaryKind::Greater | HIRBinaryKind::GreaterEqual => 90,
                    HIRBinaryKind::LeftShift | HIRBinaryKind::RightShift => 100,
                    HIRBinaryKind::Add | HIRBinaryKind::Subtract => 110,
                    HIRBinaryKind::Multiply | HIRBinaryKind::Divide | HIRBinaryKind::Modulo => 120
                }
            },
            HIRExpressionKind::Unary | HIRExpressionKind::New | HIRExpressionKind::Delete => 130,
            HIRExpressionKind::Cast => 140,
            HIRExpressionKind::Call | HIRExpressionKind::Constructor | HIRExpressionKind::Destructor | HIRExpressionKind::IndexAccess | HIRExpressionKind::TupleAccess | HIRExpressionKind::FieldAccess | HIRExpressionKind::MemberAccess | HIRExpressionKind::TagAccess => 150,
            _ => 160
        }
    }

    pub fn ToString(&this) -> String {
        match this.kind {
            HIRExpressionKind::Literal => (this as *HIRLiteral)->ToString(),
            HIRExpressionKind::BindingReference => (this as *HIRBindingReference)->ToString(),
            HIRExpressionKind::DeclarationReference => (this as *HIRDeclarationReference)->ToString(),
            HIRExpressionKind::Assignment => (this as *HIRAssignmentExpression)->ToString(),
            HIRExpressionKind::Unary => (this as *HIRUnaryExpression)->ToString(),
            HIRExpressionKind::Binary => (this as *HIRBinaryExpression)->ToString(),
            HIRExpressionKind::Call => (this as *HIRCallExpression)->ToString(),
            HIRExpressionKind::Cast => (this as *HIRCastExpression)->ToString(),
            HIRExpressionKind::IndexAccess => (this as *HIRIndexAccessExpression)->ToString(),
            HIRExpressionKind::TupleAccess => (this as *HIRTupleAccessExpression)->ToString(),
            HIRExpressionKind::FieldAccess => (this as *HIRFieldAccessExpression)->ToString(),
            HIRExpressionKind::MemberAccess => (this as *HIRMemberAccessExpression)->ToString(),
            HIRExpressionKind::TagAccess => (this as *HIRTagAccessExpression)->ToString(),
            HIRExpressionKind::New => (this as *HIRNewExpression)->ToString(),
            HIRExpressionKind::Delete => (this as *HIRDeleteExpression)->ToString(),
            HIRExpressionKind::Constructor => (this as *HIRConstructorExpression)->ToString(),
            HIRExpressionKind::Destructor => (this as *HIRDestructorExpression)->ToString(),
            HIRExpressionKind::Intrinsic => (this as *HIRIntrinsicExpression)->ToString(),
            HIRExpressionKind::Deferred => (this as *HIRDeferredExpression)->ToString(),
            HIRExpressionKind::Block | HIRExpressionKind::If | HIRExpressionKind::While | HIRExpressionKind::Loop | HIRExpressionKind::For | HIRExpressionKind::Match | HIRExpressionKind::Return | HIRExpressionKind::Break | HIRExpressionKind::Continue => this.ToString(0)
        }
    }

    pub fn ToString(&this, indent: usize) -> String {
        match this.kind {
            HIRExpressionKind::Block => (this as *HIRBlockExpression)->ToString(indent),
            HIRExpressionKind::If => (this as *HIRIfExpression)->ToString(indent),
            HIRExpressionKind::While => (this as *HIRWhileExpression)->ToString(indent),
            HIRExpressionKind::Loop => (this as *HIRLoopExpression)->ToString(indent),
            HIRExpressionKind::For => (this as *HIRForExpression)->ToString(indent),
            HIRExpressionKind::Match => (this as *HIRMatchExpression)->ToString(indent),
            HIRExpressionKind::Return => (this as *HIRReturnExpression)->ToString(indent),
            HIRExpressionKind::Break => (this as *HIRBreakExpression)->ToString(indent),
            HIRExpressionKind::Continue => (this as *HIRContinueExpression)->ToString(indent),
            _ => this.ToString()
        }
    }

    pub fn IsBlockLike(&this) -> bool {
        this.kind == HIRExpressionKind::Block || this.kind == HIRExpressionKind::If || this.kind == HIRExpressionKind::While || this.kind == HIRExpressionKind::Loop || this.kind == HIRExpressionKind::For || this.kind == HIRExpressionKind::Match
    }

    pub fn IsControl(&this) -> bool {
        this.IsBlockLike() || this.kind == HIRExpressionKind::Return || this.kind == HIRExpressionKind::Break || this.kind == HIRExpressionKind::Continue
    }
}

enum HIRLiteralKind: u8 {
    Boolean, Character, Integer, Float, String, Array, Tuple, Structure, Variant, Null
}

class HIRLiteral : HIRExpression {
    pub kind: HIRLiteralKind;

    HIRLiteral(&mut this, kind: HIRLiteralKind, _type: *HIRType) : HIRExpression(HIRExpressionKind::Literal, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        match this.kind {
            HIRLiteralKind::Boolean => (this as *HIRBooleanLiteral)->ToString(),
            HIRLiteralKind::Character => (this as *HIRCharacterLiteral)->ToString(),
            HIRLiteralKind::Integer => (this as *HIRIntegerLiteral)->ToString(),
            HIRLiteralKind::Float => (this as *HIRFloatLiteral)->ToString(),
            HIRLiteralKind::String => (this as *HIRStringLiteral)->ToString(),
            HIRLiteralKind::Array => (this as *HIRArrayLiteral)->ToString(),
            HIRLiteralKind::Tuple => (this as *HIRTupleLiteral)->ToString(),
            HIRLiteralKind::Structure => (this as *HIRStructureLiteral)->ToString(),
            HIRLiteralKind::Variant => (this as *HIRVariantLiteral)->ToString(),
            HIRLiteralKind::Null => (this as *HIRNullLiteral)->ToString()
        }
    }
}

class HIRBooleanLiteral : HIRLiteral {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Boolean, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        (if this.value { "true" } else { "false" }).ToString()
    }
}

class HIRCharacterLiteral : HIRLiteral {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Character, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        '\'' + String(this.value as i8).Escape() + '\''
    }
}

class HIRIntegerLiteral : HIRLiteral {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        String::FromInteger(this.value)
    }
}

class HIRFloatLiteral : HIRLiteral {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        String::FromFloat(this.value)
    }
}

class HIRStringLiteral : HIRLiteral {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *HIRType) : HIRLiteral(HIRLiteralKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        '"' + this.value.Escape() + '"'
    }
}

class HIRArrayLiteral : HIRLiteral {
    pub elements: Vector<*HIRExpression>,
    pub repeat: bool = false;

    HIRArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Array, _type) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        if this.repeat {
            return '[' + this.elements[0]->ToString() + "; " + String::FromInteger(this._type->Length() as u64) + ']';
        }

        let mut result = '['.ToString();

        for i in 0..this.elements.Size() {
            if i > 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ']'
    }
}

class HIRTupleLiteral : HIRLiteral {
    pub elements: Vector<*HIRExpression>;

    HIRTupleLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Tuple, _type) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.elements.Size() {
            if i > 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ')'
    }
}

class HIRStructureLiteral : HIRLiteral {
    pub fields: Vector<*HIRExpression>;

    HIRStructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Structure, _type) {
        this.fields = fields;
    }

    pub fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }
            result += this.fields[i]->ToString();
        }

        result + '}'
    }
}

class HIRVariantLiteral : HIRLiteral {
    pub member: *HIRVariantMember,
    pub fields: Vector<*HIRExpression>;

    HIRVariantLiteral(&mut this, member: *HIRVariantMember, fields: Vector<*HIRExpression>) : HIRLiteral(HIRLiteralKind::Variant, member->_type) {
        (this.member, this.fields) = (member, fields);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.member->name + (if this.member->structure { '{' } else { '(' }).ToString();

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }

            if this.member->structure {
                result += this.member->fields[i]->name + ": ";
            }

            result += this.fields[i]->ToString();
        }

        result + (if this.member->structure { '}' } else { ')' })
    }
}

class HIRNullLiteral : HIRLiteral {
    HIRNullLiteral(&mut this, _type: *HIRType) : HIRLiteral(HIRLiteralKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        "null".ToString()
    }
}

class HIRBindingReference : HIRExpression {
    pub binding: *HIRIdentifierPattern;

    HIRBindingReference(&mut this, binding: *HIRIdentifierPattern) : HIRExpression(HIRExpressionKind::BindingReference, binding->_type, HIRExpressionCategory::Place, binding->mutable) {
        this.binding = binding;
    }

    pub fn ToString(&this) -> String {
        '%' + this.binding->name
    }
}

class HIRDeclarationReference : HIRExpression {
    pub declaration: *HIRTypedDeclaration;

    HIRDeclarationReference(&mut this, declaration: *HIRTypedDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationReference, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        match this.declaration->kind {
            HIRDeclarationKind::Parameter => '%' + this.declaration->name,
            HIRDeclarationKind::Function => "@\"" + this.declaration->name + '"',
            _ => '@' + this.declaration->name
        }
    }
}

class HIRAssignmentExpression : HIRExpression {
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRAssignmentExpression(&mut this, left: *HIRExpression, right: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Assignment, _type) {
        (this.left, this.right) = (left, right);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.left->Precedence() {
            result += '(' + this.left->ToString() + ')';
        } else {
            result += this.left->ToString();
        }

        result += " = ";

        if this.Precedence() > this.right->Precedence() {
            result += '(' + this.right->ToString() + ')';
        } else {
            result += this.right->ToString();
        }

        result
    }
}

enum HIRUnaryKind: u8 {
    AddressOf, Dereference, Negate, Not
}

extend HIRUnaryKind {
    pub fn ToString(this) -> String {
        match this {
            HIRUnaryKind::AddressOf => '&',
            HIRUnaryKind::Dereference => '*',
            HIRUnaryKind::Negate => '-',
            HIRUnaryKind::Not => '!'
        }.ToString()
    }
}

class HIRUnaryExpression : HIRExpression {
    pub kind: HIRUnaryKind,
    pub operand: *HIRExpression;

    HIRUnaryExpression(&mut this, kind: HIRUnaryKind, operand: *HIRExpression, _type: *HIRType, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Unary, _type, category, mutable) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        let mut result = this.kind.ToString();

        if this.kind == HIRUnaryKind::AddressOf && this._type->IsMutable() {
            result += "mut ";
        }

        if this.Precedence() >= this.operand->Precedence() {
            result += '(' + this.operand->ToString() + ')';
        } else {
            result += this.operand->ToString();
        }

        result
    }
}

enum HIRBinaryKind: u8 {
    Add, Subtract, Multiply, Divide, Modulo,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual,
    LogicalAnd, LogicalOr, BitwiseAnd, BitwiseOr, BitwiseXor,
    LeftShift, RightShift
}

extend HIRBinaryKind {
    pub fn ToString(this) -> String {
        match this {
            HIRBinaryKind::Add => '+'.ToString(),
            HIRBinaryKind::Subtract => '-'.ToString(),
            HIRBinaryKind::Multiply => '*'.ToString(),
            HIRBinaryKind::Divide => '/'.ToString(),
            HIRBinaryKind::Modulo => '%'.ToString(),
            HIRBinaryKind::Equal => "==".ToString(),
            HIRBinaryKind::NotEqual => "!=".ToString(),
            HIRBinaryKind::Less => '<'.ToString(),
            HIRBinaryKind::LessEqual => "<=".ToString(),
            HIRBinaryKind::Greater => '>'.ToString(),
            HIRBinaryKind::GreaterEqual => ">=".ToString(),
            HIRBinaryKind::LogicalAnd => "&&".ToString(),
            HIRBinaryKind::LogicalOr => "||".ToString(),
            HIRBinaryKind::BitwiseAnd => '&'.ToString(),
            HIRBinaryKind::BitwiseOr => '|'.ToString(),
            HIRBinaryKind::BitwiseXor => '^'.ToString(),
            HIRBinaryKind::LeftShift => "<<".ToString(),
            HIRBinaryKind::RightShift => ">>".ToString()
        }
    }
}

class HIRBinaryExpression : HIRExpression {
    pub kind: HIRBinaryKind,
    pub left: *HIRExpression,
    pub right: *HIRExpression,
    pub destructors: Vector<*HIRExpression>;

    HIRBinaryExpression(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Binary, _type) {
        (this.kind, this.left, this.right, this.destructors) = (kind, left, right, destructors);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.left->Precedence() {
            result += '(' + this.left->ToString() + ')';
        } else {
            result += this.left->ToString();
        }

        result += ' ' + this.kind.ToString() + ' ';

        if this.Precedence() >= this.right->Precedence() {
            result += '(' + this.right->ToString() + ')';
        } else {
            result += this.right->ToString();
        }

        result
    }
}

class HIRCallExpression : HIRExpression {
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>,
    pub location: *HIRExpression = null;

    HIRCallExpression(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, callee->_type->Return()) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call ".ToString();

        if this.Precedence() > this.callee->Precedence() {
            result += '(' + this.callee->ToString() + ')';
        } else {
            result += this.callee->ToString();
        } result += '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            result += this.arguments[i]->ToString();
        }

        result + ')'
    }
}

class HIRCastExpression : HIRExpression {
    pub value: *HIRExpression;

    HIRCastExpression(&mut this, value: *HIRExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::Cast, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.value->Precedence() {
            result += '(' + this.value->ToString() + ')';
        } else {
            result += this.value->ToString();
        }

        result + " as " + this._type->ToString()
    }
}

class HIRIndexAccessExpression : HIRExpression {
    pub value: *HIRExpression,
    pub index: *HIRExpression;

    HIRIndexAccessExpression(&mut this, value: *HIRExpression, index: *HIRExpression, _type: *HIRType, mutable: bool) : HIRExpression(HIRExpressionKind::IndexAccess, _type, HIRExpressionCategory::Place, mutable) {
        (this.value, this.index) = (value, index);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.Precedence() > this.value->Precedence() {
            result += '(' + this.value->ToString() + ')';
        } else {
            result += this.value->ToString();
        }

        result + '[' + this.index->ToString() + ']'
    }
}

class HIRTupleAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub index: usize;

    HIRTupleAccessExpression(&mut this, instance: *HIRExpression, index: usize, _type: *HIRType) : HIRExpression(HIRExpressionKind::TupleAccess, _type, HIRExpressionCategory::Place, instance->mutable) {
