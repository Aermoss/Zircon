class HIRForExpression : HIRExpression {
    pub iterator: *HIRPattern,
    pub target: *HIRPattern,
    pub condition: *HIRExpression,
    pub step: *HIRExpression,
    pub destructors: Vector<*HIRExpression>,
    pub body: *HIRBlockExpression;

    HIRForExpression(&mut this, iterator: *HIRPattern, target: *HIRPattern, condition: *HIRExpression, step: *HIRExpression, destructors: Vector<*HIRExpression>, body: *HIRBlockExpression, _type: *HIRType) : HIRExpression(HIRExpressionKind::For, _type) {
        (this.iterator, this.target, this.condition, this.step, this.destructors, this.body) = (iterator, target, condition, step, destructors, body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        "for " + this.iterator->ToString() + ", " + this.condition->ToString() + ", " + this.step->ToString() + ' ' + this.body->ToString(indent)
    }
}

class HIRPatternChecker {
    HIRPatternChecker(&mut this) {}

    pub fn Normalize(&this, mut pattern: *HIRPattern) -> *HIRPattern {
        while pattern != null {
            match pattern->kind {
                HIRPatternKind::Dereference => { pattern = (pattern as *HIRDereferencePattern)->pattern; },
                HIRPatternKind::Field => { pattern = (pattern as *HIRFieldPattern)->pattern; },
                HIRPatternKind::Wildcard | HIRPatternKind::Identifier | HIRPatternKind::Rest => { return null; },
                _ => { return pattern; }
            }
        }

        null
    }

    pub fn NormalizeType(&this, _type: *HIRType) -> *HIRType {
        if _type->IsReference() {
            return _type->Pointee();
        }

        _type
    }

    fn MemberKey(&this, member: *HIREnumerationMember) -> String {
        let value = member->value;

        if value->kind == HIRExpressionKind::Literal && (value as *HIRLiteral)->kind == HIRLiteralKind::Integer {
            return "e" + String::FromInteger((value as *HIRIntegerLiteral)->value);
        }

        "m" + member->name
    }

    fn LiteralKey(&this, literal: *HIRExpression) -> String {
        if literal->kind != HIRExpressionKind::Literal {
            return "?" + literal->ToString();
        }

        let value = literal as *HIRLiteral;

        match value->kind {
            HIRLiteralKind::Boolean => if (value as *HIRBooleanLiteral)->value { "true".ToString() } else { "false".ToString() },
            HIRLiteralKind::Integer => "i" + String::FromInteger((value as *HIRIntegerLiteral)->value),
            HIRLiteralKind::Character => "c" + String::FromInteger((value as *HIRCharacterLiteral)->value as u64),
            _ => "?" + literal->ToString()
        }
    }

    pub fn IsRange(&this, _type: *HIRType) -> bool {
        _type->IsCharacter() || (_type->IsInteger() && !_type->IsLiteral() && _type->Width() <= 64)
    }

    fn RangeMax(&this, _type: *HIRType) -> u64 {
        let width = _type->Width();
        if width >= 64 { return 0xFFFFFFFFFFFFFFFFu64; }
        (1u64 << width) - 1
    }

    fn Bias(&this, value: u64, _type: *HIRType) -> u64 {
        let masked = value & this.RangeMax(_type);
        if !_type->IsSigned() { return masked; }
        masked ^ (1u64 << (_type->Width() - 1))
    }

    pub fn BoundValue(&this, bound: *HIRExpression, _type: *HIRType) -> u64 {
        let literal = bound as *HIRLiteral;

        if literal->kind == HIRLiteralKind::Character {
            return this.Bias((literal as *HIRCharacterLiteral)->value as u64, _type);
        }

        this.Bias((literal as *HIRIntegerLiteral)->value, _type)
    }

    fn RangeOf(&this, pattern: *HIRPattern, _type: *HIRType, low: &mut u64, high: &mut u64) -> bool {
        if pattern->kind == HIRPatternKind::Literal {
            let literal = (pattern as *HIRLiteralPattern)->literal;
            if literal->kind != HIRExpressionKind::Literal { return false; }
            let kind = (literal as *HIRLiteral)->kind;
            if kind != HIRLiteralKind::Integer && kind != HIRLiteralKind::Character { return false; }
            let value = this.BoundValue(literal, _type);
            (low, high) = (value, value);
            return true;
        } else if pattern->kind == HIRPatternKind::Range {
            let range = pattern as *HIRRangePattern;
            low = if range->start != null { this.BoundValue(range->start, _type) } else { 0 };
            high = this.RangeMax(_type);

            if range->end != null {
                high = this.BoundValue(range->end, _type);
                if !range->inclusive { high -= 1; }
            } return true;
        }

        false
    }

    fn Split(&this, rows: &Vector<Vector<*HIRPattern>>, _type: *HIRType, low: u64, high: u64) -> Vector<u64> {
        let mut points = Vector<u64>();
        points.PushBack(low);

        for row in rows {
            let head = this.Normalize(row[0]);
            if head == null { continue; }
            let (mut start, mut end) = (0u64, 0u64);
            if !this.RangeOf(head, _type, start, end) { continue; }
            if start > low && start <= high && !points.Contains(start) { points.PushBack(start); }
            if end < high && end + 1 > low && !points.Contains(end + 1) { points.PushBack(end + 1); }
        }

        for i in 1..points.Size() {
            let mut j = i;

            while j > 0 && points[j - 1] > points[j] {
                let swap = points[j];
                points[j] = points[j - 1];
                points[j - 1] = swap;
                j -= 1;
            }
        }

        points
    }

    fn SpecializeRange(&this, rows: &Vector<Vector<*HIRPattern>>, _type: *HIRType, low: u64, high: u64) -> Vector<Vector<*HIRPattern>> {
        let mut specialized = Vector<Vector<*HIRPattern>>();

        for row in rows {
            let head = this.Normalize(row[0]);

            if head != null {
                let (mut start, mut end) = (0u64, 0u64);
                if !this.RangeOf(head, _type, start, end) || start > low || end < high { continue; }
            }

            let mut rest = Vector<*HIRPattern>();

            for i in 1..row.Size() {
                rest.PushBack(row[i]);
            } specialized.PushBack(rest);
        }

        specialized
    }

    fn PieceEnd(&this, points: &Vector<u64>, index: usize, high: u64) -> u64 {
        if index + 1 < points.Size() { return points[index + 1] - 1; }
        high
    }

    fn UsefulRange(&this, rows: &Vector<Vector<*HIRPattern>>, vector: &Vector<*HIRPattern>, types: &Vector<*HIRType>, _type: *HIRType) -> bool {
        let head = this.Normalize(vector[0]);
        let (mut low, mut high) = (0u64, this.RangeMax(_type));
        if head != null && !this.RangeOf(head, _type, low, high) { return true; }
        let mut rest = Vector<*HIRPattern>();
        for i in 1..vector.Size() { rest.PushBack(vector[i]); }
        let points = this.Split(rows, _type, low, high);

        for i in 0..points.Size() {
            if this.Useful(this.SpecializeRange(rows, _type, points[i], this.PieceEnd(points, i, high)), rest, this.Tail(types)) {
                return true;
            }
        }

        false
    }

    fn MissingRange(&this, rows: &Vector<Vector<*HIRPattern>>, types: &Vector<*HIRType>, _type: *HIRType, witness: &mut Vector<String>) -> bool {
        let high = this.RangeMax(_type);
        let points = this.Split(rows, _type, 0, high);

        for i in 0..points.Size() {
            let end = this.PieceEnd(points, i, high);
            let mut inner = Vector<String>();

            if this.Missing(this.SpecializeRange(rows, _type, points[i], end), this.Tail(types), inner) {
                witness.PushBack(this.FormatRange(_type, points[i], end));
                for value in inner { witness.PushBack(value); }
                return true;
            }
        }

        false
    }

    fn FormatBound(&this, _type: *HIRType, value: u64) -> String {
        let width = _type->Width();

        if !_type->IsSigned() {
            return String::FromInteger(value);
        }

        let unbiased = value ^ (1u64 << (width - 1));

        if width < 64 && (unbiased & (1u64 << (width - 1))) != 0 {
            return String::FromInteger((unbiased | !this.RangeMax(_type)) as i64);
        }

        String::FromInteger(unbiased as i64)
    }

    fn FormatRange(&this, _type: *HIRType, low: u64, high: u64) -> String {
        if low == high { return this.FormatBound(_type, low); }
        this.FormatBound(_type, low) + "..=" + this.FormatBound(_type, high)
    }

    fn Key(&this, pattern: *HIRPattern) -> String {
        match pattern->kind {
            HIRPatternKind::Literal => this.LiteralKey((pattern as *HIRLiteralPattern)->literal),
            HIRPatternKind::Enumeration => this.MemberKey((pattern as *HIREnumerationPattern)->member),
            HIRPatternKind::Variant => (pattern as *HIRVariantPattern)->member->name,
            _ => String()
        }
    }

    pub fn IsFinite(&this, _type: *HIRType) -> bool {
        _type->IsBoolean() || _type->IsEnumeration() || _type->IsVariant() || _type->IsStructure() || _type->IsTuple()
    }

    pub fn Constructors(&this, _type: *HIRType) -> Vector<String> {
        let mut keys = Vector<String>();

        if _type->IsBoolean() {
            keys.PushBack("true".ToString());
            keys.PushBack("false".ToString());
        } else if _type->IsEnumeration() {
            for member in (_type as *HIREnumerationType)->declaration->members {
                let key = this.MemberKey(member);

                if !keys.Contains(key) {
                    keys.PushBack(key);
                }
            }
        } else if _type->IsVariant() {
            for member in (_type as *HIRVariantType)->declaration->members {
                keys.PushBack(member->name);
            }
        } else if _type->IsStructure() || _type->IsTuple() {
            keys.PushBack(String());
        }

        keys
    }

    fn VariantMember(&this, _type: *HIRType, key: &String) -> *HIRVariantMember {
        for member in (_type as *HIRVariantType)->declaration->members {
            if member->name == key { return member; }
        }

        null
    }

    pub fn FieldTypes(&this, _type: *HIRType, key: &String) -> Vector<*HIRType> {
        let mut types = Vector<*HIRType>();

        if _type->IsVariant() {
            let member = this.VariantMember(_type, key);
            if member == null { return types; }

            for field in member->fields {
                types.PushBack(field->_type);
            }
        } else if _type->IsStructure() {
            for field in (_type as *HIRStructureType)->declaration->fields {
                types.PushBack(field->_type);
            }
        } else if _type->IsTuple() {
            for element in (_type as *HIRTupleType)->elements {
                types.PushBack(element);
            }
        }

        types
    }

    fn FindField(&this, patterns: &Vector<*HIRPattern>, name: &String) -> *HIRPattern {
        for pattern in patterns {
            if pattern->kind == HIRPatternKind::Field && (pattern as *HIRFieldPattern)->name == name {
                return pattern;
            }
        }

        null
    }

    fn Fields(&this, pattern: *HIRPattern, arity: usize) -> Vector<*HIRPattern> {
        let mut fields = Vector<*HIRPattern>();

        match pattern->kind {
            HIRPatternKind::Variant => {
                let variant = pattern as *HIRVariantPattern;

                if variant->member->structure {
                    for field in variant->member->fields {
                        fields.PushBack(this.FindField(variant->patterns, field->name));
                    }
                } else {
                    for field in variant->patterns {
                        fields.PushBack(field);
                    }
                }
            },
            HIRPatternKind::Structure => {
                let structure = pattern as *HIRStructurePattern;

                for field in structure->declaration->fields {
                    fields.PushBack(this.FindField(structure->patterns, field->name));
                }
            },
            HIRPatternKind::Tuple => {
                for element in (pattern as *HIRTuplePattern)->patterns {
                    fields.PushBack(element);
                }
            },
            _ => {}
        }

        while fields.Size() < arity {
            fields.PushBack(null);
        }

        fields
    }

    fn ExpandRow(&this, row: &Vector<*HIRPattern>, rows: &mut Vector<Vector<*HIRPattern>>) {
        let head = this.Normalize(row[0]);

        if head != null && head->kind == HIRPatternKind::Or {
            for alternative in (head as *HIROrPattern)->patterns {
                let mut expanded: Vector<*HIRPattern> = row;
                expanded[0] = alternative;
                this.ExpandRow(expanded, rows);
            }
        } else {
            rows.PushBack(row);
        }
    }

    pub fn Expand(&this, rows: &Vector<Vector<*HIRPattern>>) -> Vector<Vector<*HIRPattern>> {
        let mut expanded = Vector<Vector<*HIRPattern>>();

        for row in rows {
            this.ExpandRow(row, expanded);
        }

        expanded
    }

    pub fn Specialize(&this, rows: &Vector<Vector<*HIRPattern>>, key: &String, arity: usize) -> Vector<Vector<*HIRPattern>> {
        let mut specialized = Vector<Vector<*HIRPattern>>();

        for row in rows {
            let head = this.Normalize(row[0]);
            let mut fields = Vector<*HIRPattern>();

            if head == null {
                while fields.Size() < arity {
                    fields.PushBack(null);
                }
            } else if this.Key(head) == key {
                fields = this.Fields(head, arity);
            } else {
                continue;
            }

            for i in 1..row.Size() {
                fields.PushBack(row[i]);
            }

            specialized.PushBack(fields);
        }

        specialized
    }

    fn Default(&this, rows: &Vector<Vector<*HIRPattern>>) -> Vector<Vector<*HIRPattern>> {
        let mut defaulted = Vector<Vector<*HIRPattern>>();

        for row in rows {
            if this.Normalize(row[0]) != null { continue; }
            let mut rest = Vector<*HIRPattern>();

            for i in 1..row.Size() {
                rest.PushBack(row[i]);
            } defaulted.PushBack(rest);
        }

        defaulted
    }

    fn Heads(&this, rows: &Vector<Vector<*HIRPattern>>) -> Vector<String> {
        let mut keys = Vector<String>();

        for row in rows {
            let head = this.Normalize(row[0]);
            if head == null { continue; }
            let key = this.Key(head);
            if !keys.Contains(key) { keys.PushBack(key); }
        }

        keys
    }

    fn IsComplete(&this, heads: &Vector<String>, _type: *HIRType) -> bool {
        if !this.IsFinite(_type) { return false; }

        for key in this.Constructors(_type) {
            if !heads.Contains(key) { return false; }
        }

        true
    }

    fn Tail(&this, types: &Vector<*HIRType>) -> Vector<*HIRType> {
        let mut tail = Vector<*HIRType>();

        for i in 1..types.Size() {
            tail.PushBack(types[i]);
        }

        tail
    }

    pub fn Useful(&this, rows: &Vector<Vector<*HIRPattern>>, vector: &Vector<*HIRPattern>, types: &Vector<*HIRType>) -> bool {
        if vector.Empty() { return rows.Empty(); }
        let expanded = this.Expand(rows);
        let head = this.Normalize(vector[0]);
        let _type = this.NormalizeType(types[0]);

        if head != null && head->kind == HIRPatternKind::Or {
            for alternative in (head as *HIROrPattern)->patterns {
                let mut candidate: Vector<*HIRPattern> = vector;
                candidate[0] = alternative;
                if this.Useful(expanded, candidate, types) { return true; }
            } return false;
        }

        if this.IsRange(_type) {
            return this.UsefulRange(expanded, vector, types, _type);
        }

        if head != null {
            let key = this.Key(head);
            let mut field_types = this.FieldTypes(_type, key);
            let mut fields = this.Fields(head, field_types.Size());
            for i in 1..vector.Size() { fields.PushBack(vector[i]); }
            for i in 1..types.Size() { field_types.PushBack(types[i]); }
            return this.Useful(this.Specialize(expanded, key, this.FieldTypes(_type, key).Size()), fields, field_types);
        }

        if this.IsComplete(this.Heads(expanded), _type) {
            for key in this.Constructors(_type) {
                let mut field_types = this.FieldTypes(_type, key);
                let arity = field_types.Size();
                let mut fields = Vector<*HIRPattern>();
                while fields.Size() < arity { fields.PushBack(null); }
                for i in 1..vector.Size() { fields.PushBack(vector[i]); }
                for i in 1..types.Size() { field_types.PushBack(types[i]); }
                if this.Useful(this.Specialize(expanded, key, arity), fields, field_types) { return true; }
            } return false;
        }

        let mut rest = Vector<*HIRPattern>();
        for i in 1..vector.Size() { rest.PushBack(vector[i]); }
        this.Useful(this.Default(expanded), rest, this.Tail(types))
    }

    pub fn Missing(&this, rows: &Vector<Vector<*HIRPattern>>, types: &Vector<*HIRType>, witness: &mut Vector<String>) -> bool {
        if types.Empty() { return rows.Empty(); }
        let expanded = this.Expand(rows);
        let _type = this.NormalizeType(types[0]);

        if this.IsRange(_type) {
            return this.MissingRange(expanded, types, _type, witness);
        }

        let heads = this.Heads(expanded);

        if this.IsComplete(heads, _type) {
            for key in this.Constructors(_type) {
                let mut field_types = this.FieldTypes(_type, key);
                let arity = field_types.Size();
                for i in 1..types.Size() { field_types.PushBack(types[i]); }
                let mut inner = Vector<String>();

                if this.Missing(this.Specialize(expanded, key, arity), field_types, inner) {
                    let mut fields = Vector<String>();
                    for i in 0..arity { fields.PushBack(inner[i]); }
                    witness.PushBack(this.Format(_type, key, fields));
                    for i in arity..inner.Size() { witness.PushBack(inner[i]); }
                    return true;
                }
            } return false;
        }

        let mut inner = Vector<String>();
        if !this.Missing(this.Default(expanded), this.Tail(types), inner) { return false; }

        if heads.Empty() || !this.IsFinite(_type) {
            witness.PushBack('_'.ToString());
        } else {
            for key in this.Constructors(_type) {
                if heads.Contains(key) { continue; }
                let mut fields = Vector<String>();

                while fields.Size() < this.FieldTypes(_type, key).Size() {
                    fields.PushBack('_'.ToString());
                }

                witness.PushBack(this.Format(_type, key, fields));
                break;
            }
        }

        for value in inner {
            witness.PushBack(value);
        }

        true
    }

    fn FormatFields(&this, names: &Vector<String>, fields: &Vector<String>) -> String {
        let mut result = String();
        let mut omitted = false;

        for i in 0..fields.Size() {
            if fields[i] == "_" {
                omitted = true;
                continue;
            }

            if !result.Empty() { result += ", "; }
            result += names[i] + ": " + fields[i];
        }

        if omitted {
            if !result.Empty() { result += ", "; }
            result += "..";
        }

        " { " + result + " }"
    }

    pub fn Format(&this, _type: *HIRType, key: &String, fields: &Vector<String>) -> String {
        if _type->IsBoolean() {
            return key;
        } else if _type->IsEnumeration() {
            let declaration = (_type as *HIREnumerationType)->declaration;

            for member in declaration->members {
                if this.MemberKey(member) == key {
                    return declaration->name + "::" + member->name;
                }
            } return '_'.ToString();
        } else if _type->IsVariant() {
            let member = this.VariantMember(_type, key);
            let mut result = (_type as *HIRVariantType)->declaration->name + "::" + member->name;
            if member->fields.Empty() { return result; }

            if member->structure {
                let mut names = Vector<String>();
                for field in member->fields { names.PushBack(field->name); }
                return result + this.FormatFields(names, fields);
            }

            result += "(";

            for i in 0..fields.Size() {
                if i != 0 { result += ", "; }
                result += fields[i];
            } return result + ")";
        } else if _type->IsStructure() {
            let declaration = (_type as *HIRStructureType)->declaration;
            let mut names = Vector<String>();
            for field in declaration->fields { names.PushBack(field->name); }
            return declaration->name + this.FormatFields(names, fields);
        } else if _type->IsTuple() {
            let mut result = "(".ToString();

            for i in 0..fields.Size() {
                if i != 0 { result += ", "; }
                result += fields[i];
            } return result + ")";
        }

        '_'.ToString()
    }
}

class HIRMatchArm {
    pub pattern: *HIRPattern,
    pub guard: *HIRExpression,
    pub destructors: Vector<*HIRExpression>,
    pub body: *HIRBlockExpression;

    HIRMatchArm(&mut this, pattern: *HIRPattern, guard: *HIRExpression, body: *HIRBlockExpression) {
        (this.pattern, this.guard, this.body) = (pattern, guard, body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = this.pattern->ToString();
        if this.guard != null { result += " if " + this.guard->ToString(); }
        result + " => " + this.body->ToString(indent)
    }
}

class HIRMatchExpression : HIRExpression {
    pub target: *HIRExpression,
    pub destructors: Vector<*HIRExpression>,
    pub arms: Vector<*HIRMatchArm>;

    HIRMatchExpression(&mut this, target: *HIRExpression, destructors: Vector<*HIRExpression>, arms: Vector<*HIRMatchArm>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Match, _type) {
        (this.target, this.destructors, this.arms) = (target, destructors, arms);
    }

    pub fn Uncovered(&this) -> Vector<String> {
        let checker = HIRPatternChecker();
        let mut rows = Vector<Vector<*HIRPattern>>();

        for arm in this.arms {
            if arm->guard != null { continue; }
            let mut row = Vector<*HIRPattern>();
            row.PushBack(arm->pattern);
            rows.PushBack(row);
        }

        let mut missing = Vector<String>();
        let _type = checker.NormalizeType(this.target->_type);

        if _type->IsBoolean() || _type->IsEnumeration() || _type->IsVariant() {
            let expanded = checker.Expand(rows);

            for key in checker.Constructors(_type) {
                let field_types = checker.FieldTypes(_type, key);
                let mut fields = Vector<String>();

                if checker.Missing(checker.Specialize(expanded, key, field_types.Size()), field_types, fields) {
                    missing.PushBack(checker.Format(_type, key, fields));
                }
            } return missing;
        }

        let mut types = Vector<*HIRType>();
        types.PushBack(this.target->_type);
        let mut witness = Vector<String>();

        if checker.Missing(rows, types, witness) {
            missing.PushBack(witness[0]);
        }

        missing
    }

    pub fn IsExhaustive(&this) -> bool {
        this.Uncovered().Empty()
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "match " + this.target->ToString() + " {\n";

        for i in 0..this.arms.Size() {
            if i != 0 { result += ",\n"; }
            result += (' ' * (indent + 1) * 4) + this.arms[i]->ToString(indent + 1);
        }

        result + '\n' + (' ' * indent * 4) + '}'
    }
}

class HIRReturnExpression : HIRExpression {
    pub value: *HIRExpression,
    pub destructors: Vector<*HIRExpression>;

    HIRReturnExpression(&mut this, value: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Return, _type) {
        (this.value, this.destructors) = (value, destructors);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let result = DestructorsToString(this.destructors, indent) + "return";

        if this.value != null {
            return result + ' ' + this.value->ToString(indent);
        }

        result
    }
}

class HIRBreakExpression : HIRExpression {
    pub value: *HIRExpression,
    pub destructors: Vector<*HIRExpression>;

    HIRBreakExpression(&mut this, value: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Break, _type) {
        (this.value, this.destructors) = (value, destructors);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let result = DestructorsToString(this.destructors, indent) + "break";

        if this.value != null {
            return result + ' ' + this.value->ToString(indent);
        }

        result
    }
}

class HIRContinueExpression : HIRExpression {
    pub destructors: Vector<*HIRExpression>;

    HIRContinueExpression(&mut this, destructors: Vector<*HIRExpression>, _type: *HIRType) : HIRExpression(HIRExpressionKind::Continue, _type) {
        this.destructors = destructors;
    }

    pub fn ToString(&this, indent: usize) -> String {
        DestructorsToString(this.destructors, indent) + "continue"
    }
}

enum HIRStatementKind: u8 {
    Variable, Expression, Assembly
}

class HIRStatement {
    pub kind: HIRStatementKind;

    HIRStatement(&mut this, kind: HIRStatementKind) {
        this.kind = kind;
    }

    pub fn HasBlock(&this) -> bool {
        this.kind == HIRStatementKind::Assembly || (this.kind == HIRStatementKind::Expression && (this as *HIRExpressionStatement)->expression->IsBlockLike())
    }

    pub fn ToString(&this, indent: usize) -> String {
        match this.kind {
            HIRStatementKind::Variable => (' ' * indent * 4) + (this as *HIRLetStatement)->ToString(indent),
            HIRStatementKind::Expression => (' ' * indent * 4) + (this as *HIRExpressionStatement)->expression->ToString(indent),
            HIRStatementKind::Assembly => (' ' * indent * 4) + (this as *HIRAssemblyStatement)->ToString()
        }
    }
}

fn DestructorsToString(destructors: &Vector<*HIRExpression>, indent: usize) -> String {
    let mut result = String();

    for destructor in destructors {
        result += destructor->ToString() + '\n' + (' ' * indent * 4);
    }

    result
}

class HIRLetStatement : HIRStatement {
    pub pattern: *HIRPattern,
    pub _type: *HIRType,
    pub initializer: *HIRExpression;

    HIRLetStatement(&mut this, pattern: *HIRPattern, _type: *HIRType, initializer: *HIRExpression) : HIRStatement(HIRStatementKind::Variable) {
        (this.pattern, this._type, this.initializer) = (pattern, _type, initializer);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "let " + this.pattern->ToString();

        if this._type != null {
            result += ": " + this._type->ToString();
        }

        if this.initializer != null {
            result += " = " + this.initializer->ToString(indent);
        }

        result
    }
}

class HIRExpressionStatement : HIRStatement {
    pub expression: *HIRExpression;

    HIRExpressionStatement(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Expression) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        this.expression->ToString()
    }
}

class HIRAssemblyOperand {
    pub name: String,
    pub expression: *HIRExpression;

    HIRAssemblyOperand(&mut this, name: String, expression: *HIRExpression) {
        (this.name, this.expression) = (name, expression);
    }
}

class HIRAssemblyStatement : HIRStatement {
    pub _volatile: bool,
    pub text: String,
    pub inputs: Vector<*HIRAssemblyOperand>,
    pub outputs: Vector<*HIRAssemblyOperand>,
    pub clobbers: Vector<String>;

    HIRAssemblyStatement(&mut this, _volatile: bool, text: String, inputs: Vector<*HIRAssemblyOperand>, outputs: Vector<*HIRAssemblyOperand>, clobbers: Vector<String>) : HIRStatement(HIRStatementKind::Assembly) {
        (this._volatile, this.text, this.inputs, this.outputs, this.clobbers) = (_volatile, text, inputs, outputs, clobbers);
    }

    pub fn ToString(&this) -> String {
        let mut result = (if this._volatile { "volatile asm " } else { "asm " }).ToString();

        if !this.inputs.Empty() {
            result += ": ";

            for i in 0..this.inputs.Size() {
                if i != 0 { result += ", "; }
                result += this.inputs[i]->name + '(' + this.inputs[i]->expression->ToString() + ')';
            } result += " -> ";
        }

        result += '{' + this.text + '}';

        if !this.outputs.Empty() {
            result += " -> ";

            for i in 0..this.outputs.Size() {
                if i != 0 { result += ", "; }
                result += this.outputs[i]->name + '(' + this.outputs[i]->expression->ToString() + ')';
            }
        }

        if !this.clobbers.Empty() {
            result += " : ";

            for i in 0..this.clobbers.Size() {
                if i != 0 { result += ", "; }
                result += this.clobbers[i];
            }
        }

        result
    }
}

enum HIRDeclarationKind: u8 {
    Parameter, Function, Field, Class, Structure, EnumerationMember, Enumeration, VariantMember, Variant, Extend, Constant, Static, Assembly
}

class HIRDeclaration {
    pub kind: HIRDeclarationKind;

    HIRDeclaration(&mut this, kind: HIRDeclarationKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        match this.kind {
            HIRDeclarationKind::Parameter => (this as *HIRParameterDeclaration)->ToString(),
            HIRDeclarationKind::Function => (this as *HIRFunctionDeclaration)->ToString(0),
            HIRDeclarationKind::Field => (this as *HIRFieldDeclaration)->ToString(),
            HIRDeclarationKind::Class => (this as *HIRClassDeclaration)->ToString(),
            HIRDeclarationKind::Structure => (this as *HIRStructureDeclaration)->ToString(),
            HIRDeclarationKind::EnumerationMember => (this as *HIREnumerationMember)->ToString(),
            HIRDeclarationKind::Enumeration => (this as *HIREnumerationDeclaration)->ToString(),
            HIRDeclarationKind::VariantMember => (this as *HIRVariantMember)->ToString(),
            HIRDeclarationKind::Variant => (this as *HIRVariantDeclaration)->ToString(),
            HIRDeclarationKind::Extend => (this as *HIRExtendDeclaration)->ToString(),
            HIRDeclarationKind::Constant => (this as *HIRConstantDeclaration)->ToString(),
            HIRDeclarationKind::Static => (this as *HIRStaticDeclaration)->ToString(),
            HIRDeclarationKind::Assembly => (this as *HIRAssemblyDeclaration)->ToString()
        }
    }
}

class HIRTypedDeclaration : HIRDeclaration {
    pub name: String,
    pub _type: *HIRType;

    HIRTypedDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *HIRType) : HIRDeclaration(kind) {
        (this.name, this._type) = (name, _type);
    }
}

enum HIRDeclarationABI: u8 {
    Native, C
}

enum HIRDeclarationLinkage: u8 {
    Private, Internal, External
}

class HIRLinkableDeclaration : HIRTypedDeclaration {
    pub abi: HIRDeclarationABI,
    pub linkage: HIRDeclarationLinkage;

    HIRLinkableDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *HIRType, abi: HIRDeclarationABI, linkage: HIRDeclarationLinkage) : HIRTypedDeclaration(kind, name, _type) {
        (this.abi, this.linkage) = (abi, linkage);
    }
}

class HIRParameterDeclaration : HIRTypedDeclaration {
    pub mutable: bool,
    pub addressable: bool = false;

    HIRParameterDeclaration(&mut this, name: String, _type: *HIRType, mutable: bool) : HIRTypedDeclaration(HIRDeclarationKind::Parameter, name, _type) {
        this.mutable = mutable;
    }

    pub fn ToString(&this) -> String {
        '%' + this.name + ": " + this._type->ToString()
    }
}

class HIRFunctionDeclaration : HIRLinkableDeclaration {
    pub no_mangle: bool,
    pub public: bool,
    pub parameters: Vector<*HIRParameterDeclaration>,
    pub _return: *HIRType,
    pub body: *HIRBlockExpression = null,
    pub instance: *GenericInstance = null,
    pub caller_location: *HIRParameterDeclaration = null,
    pub referenced: bool = false,
    pub deferred: bool = false;

    HIRFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *HIRType, _type: *HIRType, no_mangle: bool, public: bool, abi: HIRDeclarationABI) : HIRLinkableDeclaration(HIRDeclarationKind::Function, name, _type, abi, HIRDeclarationLinkage::External) {
        (this.parameters, this._return, this.no_mangle, this.public) = (parameters, _return, no_mangle, public);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "fn @\"" + this.name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            result += this.parameters[i]->ToString();
        } result += ')';

        if !this._type->Return().IsUnit() {
            result += " -> " + this._type->Return().ToString();
        }

        if this.body != null {
            result += ' ' + this.body->ToString(indent);
        }

        result
    }
}

class HIRFieldDeclaration : HIRTypedDeclaration {
    pub index: usize,
    pub initializer: *ASTExpression,
    pub public: bool;

    HIRFieldDeclaration(&mut this, name: String, _type: *HIRType, index: usize, initializer: *ASTExpression, public: bool) : HIRTypedDeclaration(HIRDeclarationKind::Field, name, _type) {
        (this.index, this.initializer, this.public) = (index, initializer, public);
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        }

        result
    }
}

class HIRClassDeclaration : HIRTypedDeclaration {
    pub parents: Vector<*HIRType>,
    pub fields: Vector<*HIRFieldDeclaration>,
    pub constructors: Vector<*mut HIRFunctionDeclaration>,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub instance: *GenericInstance = null;

    HIRClassDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Class, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "class %" + this.name;

        if !this.parents.Empty() {
            result += " : ";

            for i in 0..this.parents.Size() {
                if i != 0 { result += ", "; }
                result += this.parents[i]->ToString();
            }
        } result += " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                result += "    " + this.fields[i]->ToString();
            }

            if !this.constructors.Empty() || this.destructor != null || !this.methods.Empty() {
                result += ';';
            } result += '\n';
        }

        for constructor in this.constructors {
            result += "\n    " + constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            if method->deferred { continue; }
            result += "\n    " + method->ToString(1) + '\n';
        }

        result + '}'
    }
}

class HIRStructureDeclaration : HIRTypedDeclaration {
    pub fields: Vector<*HIRFieldDeclaration>,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub instance: *GenericInstance = null;

    HIRStructureDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Structure, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "struct %" + this.name + " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                result += "    " + this.fields[i]->ToString();
            }

            if this.copy_constructor != null || this.destructor != null || !this.methods.Empty() || this.copy_assign != null {
                result += ';';
            } result += '\n';
        }
        
        if this.copy_constructor != null {
            result += "\n    " + this.copy_constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            if method->deferred { continue; }
            result += "\n    " + method->ToString(1) + '\n';
        }

        if this.copy_assign != null {
            result += "\n    " + this.copy_assign->ToString(1) + '\n';
        }

        result + '}'
    }
}

class HIREnumerationMember : HIRTypedDeclaration {
    pub value: *HIRExpression;

    HIREnumerationMember(&mut this, name: String, value: *HIRExpression, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::EnumerationMember, name, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name;

        if this.value != null {
            result += " = " + this.value->ToString();
        }

        result
    }
}

class HIREnumerationDeclaration : HIRTypedDeclaration {
    pub members: Vector<*HIREnumerationMember>;

    HIREnumerationDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Enumeration, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "enum %" + this.name + " {";

        if !this.members.Empty() {
            result += '\n';

            for i in 0..this.members.Size() {
                if i != 0 { result += ",\n"; }
                result += "    " + this.members[i]->ToString();
            } result += '\n';
        }

        result + '}'
    }
}

class HIRVariantField {
    pub name: String,
    pub _type: *HIRType,
    pub index: usize;

    HIRVariantField(&mut this, name: String, _type: *HIRType, index: usize) {
        (this.name, this._type, this.index) = (name, _type, index);
    }

    pub fn ToString(&this) -> String {
        if !this.name.Empty() {
            this.name + ": " + this._type->ToString()
        } else {
            this._type->ToString()
        }
    }
}

class HIRVariantMember : HIRTypedDeclaration {
    pub structure: bool = false,
    pub fields: Vector<*HIRVariantField>,
    pub index: usize;

    HIRVariantMember(&mut this, name: String, _type: *HIRType, index: usize) : HIRTypedDeclaration(HIRDeclarationKind::VariantMember, name, _type) {
        this.index = index;
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + this.name;

        if !this.fields.Empty() {
            result += if this.structure { " { " } else { "(" };

            for i in 0..this.fields.Size() {
                if i != 0 { result += ", "; }
                result += this.fields[i]->ToString();
            } result += if this.structure { " }" } else { ")" };
        }

        result
    }
}

class HIRVariantDeclaration : HIRTypedDeclaration {
    pub members: Vector<*HIRVariantMember>,
    pub methods: Vector<*mut HIRFunctionDeclaration>,
    pub copy_constructor: *mut HIRFunctionDeclaration = null,
    pub copy_assign: *mut HIRFunctionDeclaration = null,
    pub destructor: *mut HIRFunctionDeclaration = null,
    pub instance: *GenericInstance = null;

    HIRVariantDeclaration(&mut this, name: String, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Variant, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "enum %" + this.name + " {";

        if !this.members.Empty() {
            result += '\n';

            for i in 0..this.members.Size() {
                if i != 0 { result += ",\n"; }
                result += "    " + this.members[i]->ToString();
            }

            if this.copy_constructor != null || this.destructor != null || !this.methods.Empty() || this.copy_assign != null {
                result += ';';
            } result += '\n';
        }
        
        if this.copy_constructor != null {
            result += "\n    " + this.copy_constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            if method->deferred { continue; }
            result += "\n    " + method->ToString(1) + '\n';
        }

        if this.copy_assign != null {
            result += "\n    " + this.copy_assign->ToString(1) + '\n';
        }

        result + '}'
    }
}

class HIRExtendDeclaration : HIRTypedDeclaration {
    pub methods: Vector<*mut HIRFunctionDeclaration>;

    HIRExtendDeclaration(&mut this, _type: *HIRType) : HIRTypedDeclaration(HIRDeclarationKind::Extend, _type->ToString(), _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "extend " + this.name + " {";

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        }

        result + '}'
    }
}

class HIRExtensionRegistry {
    pub extensions: Vector<*HIRExtendDeclaration>;

    HIRExtensionRegistry(&mut this) {}

    pub fn Register(&mut this, extension: *HIRExtendDeclaration) {
        this.extensions.PushBack(extension);
    }

    pub fn GetCandidates(&this, _type: *HIRType, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut found = false;

        for extension in this.extensions {
            if *extension->_type != *_type {
                continue;
            }

            for method in extension->methods {
                if method->name != name {
                    continue;
                }

                if method->public || (hir_lowerer->current_type != null && *hir_lowerer->current_type == *_type) {
                    result.PushBack(method);
                } found = true;
            }
        }

        if result.Empty() && !test {
            if found {
                Logger::Log("Method '" + name + "' is not accessible.", node, LogSeverity::Error);
            } else {
                Logger::Log("Invalid arguments for method: '" + name + "'.", node, LogSeverity::Error);
            }
        }

        result
    }
}

class HIRConstantDeclaration : HIRTypedDeclaration {
    pub initializer: *HIRExpression;

    HIRConstantDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression) : HIRTypedDeclaration(HIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        "const @" + this.name + ": " + this._type->ToString() + " = " + this.initializer->ToString()
    }
}

class HIRStaticDeclaration : HIRLinkableDeclaration {
    pub initializer: *HIRExpression,
    pub alignment: *HIRExpression,
    pub mutable: bool;

    HIRStaticDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) : HIRLinkableDeclaration(HIRDeclarationKind::Static, name, _type, HIRDeclarationABI::Native, linkage) {
        (this.initializer, this.alignment, this.mutable) = (initializer, alignment, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = "static @" + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        }

        result
    }
}

class HIRAssemblyDeclaration : HIRDeclaration {
    pub text: String;

    HIRAssemblyDeclaration(&mut this, text: String) : HIRDeclaration(HIRDeclarationKind::Assembly) {
        this.text = text;
    }
}

class HIRModule {
    pub declarations: Vector<*HIRDeclaration>;

    HIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *HIRDeclaration = null;

        for current in this.declarations {
            if previous != null {
                result += '\n';

                if previous->kind != current->kind || (current->kind == HIRDeclarationKind::Class || current->kind == HIRDeclarationKind::Structure || current->kind == HIRDeclarationKind::Enumeration || current->kind == HIRDeclarationKind::Extend) {
                    result += '\n';
                } else if current->kind == HIRDeclarationKind::Function {
                    let current = current as *HIRFunctionDeclaration;
                    let previous = previous as *HIRFunctionDeclaration;

                    if current->body != null || previous->body != null {
                        result += '\n';
                    }
                }
            }

            result += current->ToString();
            previous = current;
        }

        result
    }
}

class HIRContext {
    pub arena: Arena,
    array_types: Vector<*mut HIRArrayType>,
    tuple_types: Vector<*mut HIRTupleType>;

    HIRContext(&mut this) {}

    pub fn NeverType(&mut this) -> *mut HIRNeverType {
        this.arena.New<HIRNeverType>()
    }

    pub fn VoidType(&mut this) -> *mut HIRVoidType {
        this.arena.New<HIRVoidType>()
    }

    pub fn BooleanType(&mut this) -> *mut HIRBooleanType {
        this.arena.New<HIRBooleanType>()
    }

    pub fn CharacterType(&mut this) -> *mut HIRCharacterType {
        this.arena.New<HIRCharacterType>()
    }

    pub fn IntegerType(&mut this, width: u32, signed: bool) -> *mut HIRIntegerType {
        this.arena.New<HIRIntegerType>(width, signed, false, false)
    }

    pub fn IntegerPointerType(&mut this, signed: bool) -> *mut HIRIntegerType {
        this.arena.New<HIRIntegerType>((llvm_lowerer->target->Info().pointer_size * 8) as u32, signed, false, true)
    }

    pub fn IntegerLiteralType(&mut this) -> *mut HIRIntegerType {
        this.arena.New<HIRIntegerType>(32u32, true, true, false)
    }

    pub fn FloatType(&mut this, width: u32) -> *mut HIRFloatType {
        this.arena.New<HIRFloatType>(width, false)
    }

    pub fn FloatLiteralType(&mut this) -> *mut HIRFloatType {
        this.arena.New<HIRFloatType>(64u32, true)
    }

    pub fn PointerType(&mut this, pointee: *HIRType, mutable: bool) -> *mut HIRPointerType {
        this.arena.New<HIRPointerType>(pointee, mutable)
    }

    pub fn ReferenceType(&mut this, referent: *HIRType, mutable: bool) -> *mut HIRReferenceType {
        this.arena.New<HIRReferenceType>(referent, mutable)
    }

    pub fn ArrayType(&mut this, element: *HIRType, length: usize) -> *mut HIRArrayType {
        if element->ContainsLiteral() {
            return this.arena.New<HIRArrayType>(element, length);
        }

        for existing in this.array_types {
            if existing->length == length && existing->element->IsSame(element) {
                return existing;
            }
        }

        let _type = this.arena.New<HIRArrayType>(element, length);
        this.array_types.PushBack(_type);
        _type
    }

    pub fn TupleType(&mut this, elements: Vector<*HIRType>) -> *mut HIRTupleType {
        for element in elements {
            if element->ContainsLiteral() {
                return this.arena.New<HIRTupleType>(elements);
            }
        }

        for existing in this.tuple_types {
            if existing->elements.Size() != elements.Size() {
                continue;
            }

            let mut same = true;

            for i in 0..elements.Size() {
                if !existing->elements[i]->IsSame(elements[i]) {
                    same = false;
                    break;
                }
            }

            if same {
                return existing;
            }
        }

        let _type = this.arena.New<HIRTupleType>(elements);
        this.tuple_types.PushBack(_type);
        _type
    }

    pub fn UnitType(&mut this) -> *mut HIRTupleType {
        this.TupleType(Vector<*HIRType>())
    }

    pub fn FunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) -> *mut HIRFunctionType {
        this.arena.New<HIRFunctionType>(parameters, _return)
    }

    pub fn ClassType(&mut this, declaration: *HIRClassDeclaration) -> *mut HIRClassType {
        this.arena.New<HIRClassType>(declaration)
    }

    pub fn StructureType(&mut this, declaration: *HIRStructureDeclaration) -> *mut HIRStructureType {
        this.arena.New<HIRStructureType>(declaration)
    }

    pub fn EnumerationType(&mut this, declaration: *HIREnumerationDeclaration, underlying: *HIRIntegerType) -> *mut HIREnumerationType {
        this.arena.New<HIREnumerationType>(declaration, underlying)
    }

    pub fn VariantType(&mut this, declaration: *HIRVariantDeclaration) -> *mut HIRVariantType {
        this.arena.New<HIRVariantType>(declaration)
    }
}

class HIRBuilder {
    context: *mut HIRContext,
    module: *mut HIRModule,
    function: *mut HIRFunctionDeclaration = null,
    block: *mut HIRBlockExpression = null;

    HIRBuilder(&mut this) {}

    HIRBuilder(&mut this, context: *mut HIRContext, module: *mut HIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn WildcardPattern(&mut this) -> *mut HIRWildcardPattern {
        this.context->arena.New<HIRWildcardPattern>()
    }

    pub fn RestPattern(&mut this) -> *mut HIRRestPattern {
        this.context->arena.New<HIRRestPattern>()
    }

    pub fn LiteralPattern(&mut this, literal: *HIRExpression) -> *mut HIRLiteralPattern {
        this.context->arena.New<HIRLiteralPattern>(literal)
    }

    pub fn RangePattern(&mut this, start: *HIRExpression, end: *HIRExpression, inclusive: bool) -> *mut HIRRangePattern {
        this.context->arena.New<HIRRangePattern>(start, end, inclusive)
    }

    pub fn IdentifierPattern(&mut this, name: String, _type: *HIRType, value: *HIRExpression, mutable: bool) -> *mut HIRIdentifierPattern {
        this.context->arena.New<HIRIdentifierPattern>(name, _type, value, mutable)
    }

    pub fn TuplePattern(&mut this, patterns: Vector<*HIRPattern>, _type: *HIRTupleType) -> *mut HIRTuplePattern {
        this.context->arena.New<HIRTuplePattern>(patterns, _type)
    }

    pub fn FieldPattern(&mut this, name: String, pattern: *HIRPattern) -> *mut HIRFieldPattern {
        this.context->arena.New<HIRFieldPattern>(name, pattern)
    }

    pub fn StructurePattern(&mut this, declaration: *HIRStructureDeclaration, patterns: Vector<*HIRPattern>) -> *mut HIRStructurePattern {
        this.context->arena.New<HIRStructurePattern>(declaration, patterns)
    }

    pub fn EnumerationPattern(&mut this, member: *HIREnumerationMember) -> *mut HIREnumerationPattern {
        this.context->arena.New<HIREnumerationPattern>(member)
    }

    pub fn VariantPattern(&mut this, member: *HIRVariantMember, patterns: Vector<*HIRPattern>) -> *mut HIRVariantPattern {
        this.context->arena.New<HIRVariantPattern>(member, patterns)
    }

    pub fn OrPattern(&mut this, patterns: Vector<*HIRPattern>) -> *mut HIROrPattern {
        this.context->arena.New<HIROrPattern>(patterns)
    }

    pub fn DereferencePattern(&mut this, binding: *HIRIdentifierPattern, pattern: *HIRPattern) -> *mut HIRDereferencePattern {
        this.context->arena.New<HIRDereferencePattern>(binding, pattern)
    }

    pub fn BooleanLiteral(&mut this, value: bool, _type: *HIRType) -> *mut HIRBooleanLiteral {
        this.context->arena.New<HIRBooleanLiteral>(value, _type)
    }

    pub fn CharacterLiteral(&mut this, value: u32, _type: *HIRType) -> *mut HIRCharacterLiteral {
        this.context->arena.New<HIRCharacterLiteral>(value, _type)
    }

    pub fn IntegerLiteral(&mut this, value: u64, _type: *HIRType) -> *mut HIRIntegerLiteral {
        this.context->arena.New<HIRIntegerLiteral>(value, _type)
    }

    pub fn FloatLiteral(&mut this, value: f64, _type: *HIRType) -> *mut HIRFloatLiteral {
        this.context->arena.New<HIRFloatLiteral>(value, _type)
    }

    pub fn StringLiteral(&mut this, value: String, _type: *HIRType) -> *mut HIRStringLiteral {
        this.context->arena.New<HIRStringLiteral>(value, _type)
    }

    pub fn ArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRArrayLiteral {
        this.context->arena.New<HIRArrayLiteral>(elements, _type)
    }

    pub fn TupleLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRTupleLiteral {
        this.context->arena.New<HIRTupleLiteral>(elements, _type)
    }

    pub fn StructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRStructureLiteral {
        this.context->arena.New<HIRStructureLiteral>(fields, _type)
    }

    pub fn VariantLiteral(&mut this, member: *HIRVariantMember, fields: Vector<*HIRExpression>) -> *mut HIRVariantLiteral {
        this.context->arena.New<HIRVariantLiteral>(member, fields)
    }

    pub fn NullLiteral(&mut this) -> *mut HIRNullLiteral {
        let _type = this.context->PointerType(this.context->VoidType(), false);
        _type->_null = true;
        this.context->arena.New<HIRNullLiteral>(_type)
    }

    pub fn NullLiteral(&mut this, _type: *HIRType) -> *mut HIRNullLiteral {
        this.context->arena.New<HIRNullLiteral>(_type)
    }

    pub fn ReferenceBinding(&mut this, pattern: *HIRIdentifierPattern) -> *mut HIRBindingReference {
        this.context->arena.New<HIRBindingReference>(pattern)
    }

    pub fn ReferenceDeclaration(&mut this, declaration: *HIRTypedDeclaration, mutable: bool) -> *mut HIRDeclarationReference {
        if declaration->kind == HIRDeclarationKind::Function {
            (declaration as *mut HIRFunctionDeclaration)->referenced = true;
        }

        this.context->arena.New<HIRDeclarationReference>(declaration, mutable)
    }

    fn SetAddressable(&mut this, mut expression: *HIRExpression) {
        while expression->kind == HIRExpressionKind::FieldAccess {
            expression = (expression as *HIRFieldAccessExpression)->instance;
        }

        if expression->kind == HIRExpressionKind::DeclarationReference && (expression as *HIRDeclarationReference)->declaration->kind == HIRDeclarationKind::Parameter {
            ((expression as *HIRDeclarationReference)->declaration as *mut HIRParameterDeclaration)->addressable = true;
        }
    }

    pub fn Assignment(&mut this, left: *HIRExpression, right: *HIRExpression) -> *mut HIRAssignmentExpression {
        this.SetAddressable(left);
        this.context->arena.New<HIRAssignmentExpression>(left, right, this.context->UnitType())
    }

    pub fn AddressOf(&mut this, operand: *HIRExpression, mutable: bool) -> *HIRExpression {
        let address = this.AddressOf(operand);
        if mutable || !address->_type->IsMutable() { return address; }

        if address->_type->IsReference() {
            this.Cast(address, this.context->ReferenceType(address->_type->Pointee(), false))
        } else {
            this.Cast(address, this.context->PointerType(address->_type->Pointee(), false))
        }
    }

    pub fn AddressOf(&mut this, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Unary && (operand as *HIRUnaryExpression)->kind == HIRUnaryKind::Dereference {
            return (operand as *HIRUnaryExpression)->operand;
        }

        this.SetAddressable(operand);
        this.context->arena.New<HIRUnaryExpression>(HIRUnaryKind::AddressOf, operand, this.context->ReferenceType(operand->_type, if operand->category == HIRExpressionCategory::Place { operand->mutable } else { true }), HIRExpressionCategory::Value, false)
    }

    pub fn Dereference(&mut this, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Unary && (operand as *HIRUnaryExpression)->kind == HIRUnaryKind::AddressOf {
            return (operand as *HIRUnaryExpression)->operand;
        }

        this.context->arena.New<HIRUnaryExpression>(HIRUnaryKind::Dereference, operand, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable())
    }

    fn MaskToWidth(&this, value: u64, width: u32) -> u64 {
        if width >= 64 { return value; }
        value & ((1u64 << width) - 1)
    }

    fn FoldUnary(&mut this, kind: HIRUnaryKind, operand: *HIRLiteral, _type: *HIRType) -> *HIRExpression {
        match kind {
            HIRUnaryKind::Negate => {
                match operand->kind {
                    HIRLiteralKind::Integer => this.IntegerLiteral(this.MaskToWidth((0u64 - (operand as *HIRIntegerLiteral)->value), _type->Width()), _type),
                    HIRLiteralKind::Float => this.FloatLiteral(-(operand as *HIRFloatLiteral)->value, _type),
                    _ => null
                }
            },
            HIRUnaryKind::Not => {
                match operand->kind {
                    HIRLiteralKind::Integer => this.IntegerLiteral(this.MaskToWidth(!(operand as *HIRIntegerLiteral)->value, _type->Width()), _type),
                    HIRLiteralKind::Boolean => this.BooleanLiteral(!(operand as *HIRBooleanLiteral)->value, _type),
                    _ => null
                }
            },
            _ => null
        }
    }

    pub fn Unary(&mut this, kind: HIRUnaryKind, operand: *HIRExpression) -> *HIRExpression {
        if operand->kind == HIRExpressionKind::Literal && kind != HIRUnaryKind::AddressOf && kind != HIRUnaryKind::Dereference {
            let folded = this.FoldUnary(kind, operand as *HIRLiteral, operand->_type);
            if folded != null { return folded; }
        }

        this.context->arena.New<HIRUnaryExpression>(kind, operand, operand->_type, HIRExpressionCategory::Value, false)
    }

    fn SignExtend(&this, value: u64, width: u32) -> i64 {
        let masked = this.MaskToWidth(value, width);
        if width >= 64 { return masked as i64; }
        let sign_bit = 1u64 << (width - 1);

        if (masked & sign_bit) != 0 {
            return (masked | !((1u64 << width) - 1)) as i64;
        }

        masked as i64
    }

    fn FoldBinary(&mut this, kind: HIRBinaryKind, left: *HIRLiteral, right: *HIRLiteral, _type: *HIRType) -> *HIRExpression {
        match left->kind {
            HIRLiteralKind::Integer if right->kind == HIRLiteralKind::Integer => {
                let (left, right) = ((left as *HIRIntegerLiteral)->value, (right as *HIRIntegerLiteral)->value);
                if (kind == HIRBinaryKind::Divide || kind == HIRBinaryKind::Modulo) && right == 0 { return null; }
                let (signed, width) = (_type->IsSigned(), _type->Width());

                match kind {
                    HIRBinaryKind::Add => this.IntegerLiteral(this.MaskToWidth(left + right, width), _type),
                    HIRBinaryKind::Subtract => this.IntegerLiteral(this.MaskToWidth(left - right, width), _type),
                    HIRBinaryKind::Multiply => this.IntegerLiteral(this.MaskToWidth(left * right, width), _type),
                    HIRBinaryKind::Divide => this.IntegerLiteral(this.MaskToWidth(if signed { (this.SignExtend(left, width) / this.SignExtend(right, width)) as u64 } else { left / right }, width), _type),
                    HIRBinaryKind::Modulo => this.IntegerLiteral(this.MaskToWidth(if signed { (this.SignExtend(left, width) % this.SignExtend(right, width)) as u64 } else { left % right }, width), _type),
                    HIRBinaryKind::BitwiseAnd => this.IntegerLiteral(left & right, _type),
                    HIRBinaryKind::BitwiseOr => this.IntegerLiteral(left | right, _type),
                    HIRBinaryKind::BitwiseXor => this.IntegerLiteral(left ^ right, _type),
                    HIRBinaryKind::LeftShift => this.IntegerLiteral(this.MaskToWidth(left << right, width), _type),
                    HIRBinaryKind::RightShift => this.IntegerLiteral(this.MaskToWidth(if signed { (this.SignExtend(left, width) >> right as i64) as u64 } else { left >> right }, width), _type),
                    HIRBinaryKind::Equal => this.BooleanLiteral(left == right, this.context->BooleanType()),
                    HIRBinaryKind::NotEqual => this.BooleanLiteral(left != right, this.context->BooleanType()),
                    HIRBinaryKind::Less => this.BooleanLiteral(if signed { this.SignExtend(left, width) < this.SignExtend(right, width) } else { left < right }, this.context->BooleanType()),
                    HIRBinaryKind::LessEqual => this.BooleanLiteral(if signed { this.SignExtend(left, width) <= this.SignExtend(right, width) } else { left <= right }, this.context->BooleanType()),
                    HIRBinaryKind::Greater => this.BooleanLiteral(if signed { this.SignExtend(left, width) > this.SignExtend(right, width) } else { left > right }, this.context->BooleanType()),
                    HIRBinaryKind::GreaterEqual => this.BooleanLiteral(if signed { this.SignExtend(left, width) >= this.SignExtend(right, width) } else { left >= right }, this.context->BooleanType()),
                    _ => null
                }
            },
            HIRLiteralKind::Float if right->kind == HIRLiteralKind::Float => {
                let left = (left as *HIRFloatLiteral)->value;
                let right = (right as *HIRFloatLiteral)->value;

                match kind {
                    HIRBinaryKind::Add => this.FloatLiteral(left + right, _type),
                    HIRBinaryKind::Subtract => this.FloatLiteral(left - right, _type),
                    HIRBinaryKind::Multiply => this.FloatLiteral(left * right, _type),
                    HIRBinaryKind::Divide => this.FloatLiteral(left / right, _type),
                    HIRBinaryKind::Equal => this.BooleanLiteral(left == right, this.context->BooleanType()),
                    HIRBinaryKind::NotEqual => this.BooleanLiteral(left != right, this.context->BooleanType()),
                    HIRBinaryKind::Less => this.BooleanLiteral(left < right, this.context->BooleanType()),
                    HIRBinaryKind::LessEqual => this.BooleanLiteral(left <= right, this.context->BooleanType()),
                    HIRBinaryKind::Greater => this.BooleanLiteral(left > right, this.context->BooleanType()),
                    HIRBinaryKind::GreaterEqual => this.BooleanLiteral(left >= right, this.context->BooleanType()),
                    _ => null
                }
            },
            HIRLiteralKind::Boolean if right->kind == HIRLiteralKind::Boolean => {
                let left = (left as *HIRBooleanLiteral)->value;
                let right = (right as *HIRBooleanLiteral)->value;

                match kind {
                    HIRBinaryKind::BitwiseAnd | HIRBinaryKind::LogicalAnd => this.BooleanLiteral(left && right, _type),
                    HIRBinaryKind::BitwiseOr | HIRBinaryKind::LogicalOr => this.BooleanLiteral(left || right, _type),
                    HIRBinaryKind::BitwiseXor | HIRBinaryKind::NotEqual => this.BooleanLiteral(left != right, _type),
                    HIRBinaryKind::Equal => this.BooleanLiteral(left == right, _type),
                    _ => null
                }
            },
            _ => null
        }
    }

    pub fn Binary(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, _type: *HIRType) -> *HIRExpression {
        this.Binary(kind, left, right, Vector<*HIRExpression>(), _type)
    }

    pub fn Binary(&mut this, kind: HIRBinaryKind, left: *HIRExpression, right: *HIRExpression, destructors: Vector<*HIRExpression>, _type: *HIRType) -> *HIRExpression {
        if left->kind == HIRExpressionKind::Literal && right->kind == HIRExpressionKind::Literal {
            let folded = this.FoldBinary(kind, left as *HIRLiteral, right as *HIRLiteral, _type);
            if folded != null { return folded; }
        }

        this.context->arena.New<HIRBinaryExpression>(kind, left, right, destructors, _type)
    }

    pub fn Call(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRCallExpression {
        this.context->arena.New<HIRCallExpression>(callee, arguments)
    }

    fn FoldCast(&mut this, value: *HIRLiteral, target: *HIRType) -> *HIRExpression {
        if !target->IsInteger() && !target->IsFloat() && !target->IsBoolean() && !target->IsCharacter() && !target->IsEnumeration() {
            return null;
        }

        match value->kind {
            HIRLiteralKind::Integer | HIRLiteralKind::Character | HIRLiteralKind::Boolean => {
                let raw = if value->kind == HIRLiteralKind::Boolean {
                    if (value as *HIRBooleanLiteral)->value { 1u64 } else { 0u64 }
                } else if value->kind == HIRLiteralKind::Character {
                    (value as *HIRCharacterLiteral)->value as u64
                } else {
                    (value as *HIRIntegerLiteral)->value
                };

                if target->IsFloat() {
                    this.FloatLiteral(if value->_type->IsInteger() && value->_type->IsSigned() { this.SignExtend(raw, value->_type->Width()) as f64 } else { raw as f64 }, target)
                } else {
                    let mut converted = raw;

                    if value->_type->IsInteger() && value->_type->IsSigned() && target->Width() > value->_type->Width() {
                        converted = this.SignExtend(raw, value->_type->Width()) as u64;
                    }

                    this.IntegerLiteral(this.MaskToWidth(converted, target->Width()), target)
                }
            },
            HIRLiteralKind::Float => {
                let value = (value as *HIRFloatLiteral)->value;

                if target->IsInteger() {
                    this.IntegerLiteral(this.MaskToWidth(value as u64, target->Width()), target)
                } else {
                    this.FloatLiteral(value, target)
                }
            },
            _ => null
        }
    }

    pub fn Cast(&mut this, value: *HIRExpression, _type: *HIRType) -> *HIRExpression {
        if value->kind == HIRExpressionKind::Literal {
            let folded = this.FoldCast(value as *HIRLiteral, _type);
            if folded != null { return folded; }
        }

        this.context->arena.New<HIRCastExpression>(value, _type)
    }

    pub fn IndexAccess(&mut this, value: *HIRExpression, index: *HIRExpression) -> *mut HIRIndexAccessExpression {
        if value->_type->IsArray() {
            this.context->arena.New<HIRIndexAccessExpression>(value, index, value->_type->Element(), value->mutable)
        } else {
            this.context->arena.New<HIRIndexAccessExpression>(value, index, value->_type->Pointee(), value->_type->IsMutable())
        }
    }

    pub fn TupleAccess(&mut this, instance: *HIRExpression, index: usize) -> *mut HIRTupleAccessExpression {
        this.context->arena.New<HIRTupleAccessExpression>(instance, index, (instance->_type as *HIRTupleType)->elements[index])
    }

    pub fn FieldAccess(&mut this, instance: *HIRExpression, field: *HIRFieldDeclaration) -> *mut HIRFieldAccessExpression {
        this.context->arena.New<HIRFieldAccessExpression>(instance, field)
    }

    pub fn MemberAccess(&mut this, instance: *HIRExpression, member: *HIRVariantMember, field: *HIRVariantField) -> *mut HIRMemberAccessExpression {
        this.context->arena.New<HIRMemberAccessExpression>(instance, member, field)
    }

    pub fn TagAccess(&mut this, instance: *HIRExpression) -> *mut HIRTagAccessExpression {
        this.context->arena.New<HIRTagAccessExpression>(instance, this.context->IntegerType(8, false))
    }

    pub fn New(&mut this, _type: *HIRType, size: *HIRExpression, initialized: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRNewExpression {
        this.context->arena.New<HIRNewExpression>(_type, size, initialized, callee, arguments, this.context->PointerType(_type, true))
    }

    pub fn Delete(&mut this, value: *HIRExpression, array: bool, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRDeleteExpression {
        this.context->arena.New<HIRDeleteExpression>(value, array, callee, arguments, this.context->UnitType())
    }

    pub fn Constructor(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *HIRType) -> *mut HIRConstructorExpression {
        this.context->arena.New<HIRConstructorExpression>(callee, arguments, _type)
    }

    pub fn Destructor(&mut this, instance: *HIRExpression, callee: *HIRExpression) -> *mut HIRDestructorExpression {
        this.context->arena.New<HIRDestructorExpression>(instance, callee, this.context->UnitType())
    }

    pub fn Intrinsic(&mut this, kind: HIRIntrinsicKind, _type: *HIRType) -> *mut HIRIntrinsicExpression {
        this.context->arena.New<HIRIntrinsicExpression>(kind, _type, this.context->IntegerPointerType(false))
    }

    pub fn Deferred(&mut this, expression: *ASTExpression, _type: *HIRType) -> *mut HIRDeferredExpression {
        this.context->arena.New<HIRDeferredExpression>(expression, _type)
    }

    pub fn Block(&mut this) -> *mut HIRBlockExpression {
        this.context->arena.New<HIRBlockExpression>(this.context->UnitType())
    }

    pub fn SetCurrentBlock(&mut this, block: *mut HIRBlockExpression) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&this) -> *mut HIRBlockExpression {
        this.block
    }

    pub fn BuildCondition(&mut this, expression: *HIRExpression) -> *mut HIRCondition {
        this.context->arena.New<HIRCondition>(expression)
    }

    pub fn BuildCondition(&mut this, pattern: *HIRPattern, expression: *HIRExpression) -> *mut HIRCondition {
        this.context->arena.New<HIRCondition>(pattern, expression)
    }

    pub fn If(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, then_body: *HIRBlockExpression, else_body: *HIRExpression, _type: *HIRType) -> *mut HIRIfExpression {
        this.context->arena.New<HIRIfExpression>(condition, destructors, then_body, else_body, _type)
    }

    pub fn While(&mut this, condition: *HIRCondition, destructors: Vector<*HIRExpression>, while_body: *HIRBlockExpression, else_body: *HIRBlockExpression) -> *mut HIRWhileExpression {
        this.context->arena.New<HIRWhileExpression>(condition, destructors, while_body, else_body, this.context->UnitType())
    }

    pub fn Loop(&mut this) -> *mut HIRLoopExpression {
        this.context->arena.New<HIRLoopExpression>(this.context->UnitType())
    }

    pub fn For(&mut this, iterator: *HIRPattern, target: *HIRPattern, condition: *HIRExpression, step: *HIRExpression, destructors: Vector<*HIRExpression>, body: *HIRBlockExpression) -> *mut HIRForExpression {
        this.context->arena.New<HIRForExpression>(iterator, target, condition, step, destructors, body, this.context->UnitType())
    }

    pub fn BuildMatchArm(&mut this, pattern: *HIRPattern, guard: *HIRExpression, body: *HIRBlockExpression) -> *mut HIRMatchArm {
        this.context->arena.New<HIRMatchArm>(pattern, guard, body)
    }

    pub fn Match(&mut this, target: *HIRExpression, destructors: Vector<*HIRExpression>, arms: Vector<*HIRMatchArm>, _type: *HIRType) -> *mut HIRMatchExpression {
        this.context->arena.New<HIRMatchExpression>(target, destructors, arms, _type)
    }

    pub fn Return(&mut this, value: *HIRExpression, destructors: Vector<*HIRExpression>) -> *mut HIRReturnExpression {
        this.context->arena.New<HIRReturnExpression>(value, destructors, this.context->NeverType())
    }

    pub fn Break(&mut this, value: *HIRExpression, destructors: Vector<*HIRExpression>) -> *mut HIRBreakExpression {
        this.context->arena.New<HIRBreakExpression>(value, destructors, this.context->NeverType())
    }

    pub fn Continue(&mut this, destructors: Vector<*HIRExpression>) -> *mut HIRContinueExpression {
        this.context->arena.New<HIRContinueExpression>(destructors, this.context->NeverType())
    }

    pub fn BuildLetStatement(&mut this, pattern: *HIRPattern, _type: *HIRType, initializer: *HIRExpression) -> *mut HIRLetStatement {
        this.context->arena.New<HIRLetStatement>(pattern, _type, initializer)
    }

    pub fn BuildExpressionStatement(&mut this, expression: *HIRExpression) -> *mut HIRExpressionStatement {
        let statement = this.context->arena.New<HIRExpressionStatement>(expression);
        this.block->statements.PushBack(statement);
        statement
    }

    pub fn BuildAssemblyOperand(&mut this, name: String, expression: *HIRExpression) -> *mut HIRAssemblyOperand {
        this.context->arena.New<HIRAssemblyOperand>(name, expression)
    }

    pub fn BuildAssemblyStatement(&mut this, _volatile: bool, text: String, inputs: Vector<*HIRAssemblyOperand>, outputs: Vector<*HIRAssemblyOperand>, clobbers: Vector<String>) -> *mut HIRAssemblyStatement {
        let assembly = this.context->arena.New<HIRAssemblyStatement>(_volatile, text, inputs, outputs, clobbers);
        this.block->statements.PushBack(assembly);
        assembly
    }

    pub fn BuildParameterDeclaration(&mut this, name: String, _type: *HIRType, mutable: bool) -> *mut HIRParameterDeclaration {
        this.context->arena.New<HIRParameterDeclaration>(name, _type, mutable)
    }

    pub fn BuildFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *HIRType, _type: *HIRType, no_mangle: bool, public: bool, abi: HIRDeclarationABI) -> *mut HIRFunctionDeclaration {
        this.context->arena.New<HIRFunctionDeclaration>(name, parameters, _return, _type, no_mangle, public, abi)
    }

    pub fn SetCurrentFunction(&mut this, function: *mut HIRFunctionDeclaration) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&this) -> *mut HIRFunctionDeclaration {
        this.function
    }

    pub fn BuildFieldDeclaration(&mut this, name: String, _type: *HIRType, index: usize, initializer: *ASTExpression, public: bool) -> *mut HIRFieldDeclaration {
        this.context->arena.New<HIRFieldDeclaration>(name, _type, index, initializer, public)
    }

    pub fn BuildClassDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRClassDeclaration {
        let declaration = this.context->arena.New<HIRClassDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildStructureDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRStructureDeclaration {
        let declaration = this.context->arena.New<HIRStructureDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildEnumerationMember(&mut this, name: String, value: *HIRExpression, _type: *HIRType) -> *mut HIREnumerationMember {
        this.context->arena.New<HIREnumerationMember>(name, value, _type)
    }

    pub fn BuildEnumerationDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIREnumerationDeclaration {
        let declaration = this.context->arena.New<HIREnumerationDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildVariantField(&mut this, name: String, _type: *HIRType, index: usize) -> *mut HIRVariantField {
        this.context->arena.New<HIRVariantField>(name, _type, index)
    }

    pub fn BuildVariantMember(&mut this, name: String, _type: *HIRType, index: usize) -> *mut HIRVariantMember {
        this.context->arena.New<HIRVariantMember>(name, _type, index)
    }

    pub fn BuildVariantDeclaration(&mut this, name: String, _type: *HIRType) -> *mut HIRVariantDeclaration {
        let declaration = this.context->arena.New<HIRVariantDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildExtendDeclaration(&mut this, _type: *HIRType) -> *mut HIRExtendDeclaration {
        let declaration = this.context->arena.New<HIRExtendDeclaration>(_type);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildConstantDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression) -> *mut HIRConstantDeclaration {
        let declaration = this.context->arena.New<HIRConstantDeclaration>(name, _type, initializer);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildStaticDeclaration(&mut this, name: String, _type: *HIRType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) -> *mut HIRStaticDeclaration {
        let declaration = this.context->arena.New<HIRStaticDeclaration>(name, _type, initializer, alignment, mutable, linkage);
        this.module->declarations.PushBack(declaration);
        declaration
    }

    pub fn BuildAssemblyDeclaration(&mut this, text: String) -> *mut HIRAssemblyDeclaration {
        let declaration = this.context->arena.New<HIRAssemblyDeclaration>(text);
        this.module->declarations.PushBack(declaration);
        declaration
    }
}

#[include "src/HIRLowerer.zir", "src/LLVMLowerer.zir" : *]
