class HIRMemberAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub member: *HIRVariantMember,
    pub field: *HIRVariantField;

    HIRMemberAccessExpression(&mut this, instance: *HIRExpression, member: *HIRVariantMember, field: *HIRVariantField) : HIRExpression(HIRExpressionKind::MemberAccess, field->_type, HIRExpressionCategory::Place, instance->mutable) {
