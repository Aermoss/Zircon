class HIRBlockExpression : HIRExpression {
    pub statements: Vector<*HIRStatement>,
    pub destructors: Vector<*HIRExpression>,
    pub tail: *HIRExpression = null;

    HIRBlockExpression(&mut this, _type: *HIRType) : HIRExpression(HIRExpressionKind::Block, _type) {}

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = '{'.ToString();

        if this.statements.Empty() && this.tail == null && this.destructors.Empty() {
            return result + '}';
        }

        result += '\n';
        let mut previous: *HIRStatement = null;

        for current in this.statements {
            if previous != null && (previous->HasBlock() || current->HasBlock()) {
                result += '\n';
            }

            result += current->ToString(indent + 1) + '\n';
            previous = current;
        }

        if this.tail != null {
            result += (' ' * (indent + 1) * 4) + this.tail->ToString(indent + 1) + '\n';
        }

        for destructor in this.destructors {
            result += (' ' * (indent + 1) * 4) + destructor->ToString() + '\n';
        }

        result + (' ' * indent * 4) + '}'
    }
}

class HIRCondition {
    pub pattern: *HIRPattern = null,
    pub expression: *HIRExpression;

    HIRCondition(&mut this, expression: *HIRExpression) {
        this.expression = expression;
    }

    HIRCondition(&mut this, pattern: *HIRPattern, expression: *HIRExpression) {
        (this.pattern, this.expression) = (pattern, expression);
    }

    pub fn ToString(&this) -> String {
        if this.pattern != null {
            "let " + this.pattern->ToString() + " = " + this.expression->ToString()
        } else {
            this.expression->ToString()
        }
    }
}

