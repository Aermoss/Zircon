#[include "std/str" : *]

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL, ZERO,

    NEW, DELETE, ASYNC, AWAIT, AS, THIS, OPERATOR,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNCTION, CLASS, STRUCTURE, ENUMERATION, EXTEND, TYPE, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, ASSEMBLY, ASSEMBLY_TEXT, VOLATILE, UNSAFE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,
    EQUAL, NOT_EQUAL, GREATER, LESS, GREATER_EQUAL, LESS_EQUAL,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    AT, QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ELIF, ENDIF, INCLUDE, ERROR, WARNING
}

extend TokenType {
    pub fn ToString(this) -> String {
        match this {
            TokenType::EOF => { return "EOF".ToString(); },
            TokenType::IDENTIFIER => { return "IDENTIFIER".ToString(); },
            TokenType::INTEGER => { return "INTEGER".ToString(); },
            TokenType::FLOAT => { return "FLOAT".ToString(); },
            TokenType::STRING => { return "STRING".ToString(); },
            TokenType::CHAR => { return "CHAR".ToString(); },
            TokenType::TRUE => { return "TRUE".ToString(); },
            TokenType::FALSE => { return "FALSE".ToString(); },
            TokenType::NULL => { return "NULL".ToString(); },
            TokenType::ZERO => { return "ZERO".ToString(); },
            TokenType::NEW => { return "NEW".ToString(); },
            TokenType::DELETE => { return "DELETE".ToString(); },
            TokenType::ASYNC => { return "ASYNC".ToString(); },
            TokenType::AWAIT => { return "AWAIT".ToString(); },
            TokenType::AS => { return "AS".ToString(); },
            TokenType::THIS => { return "THIS".ToString(); },
            TokenType::OPERATOR => { return "OPERATOR".ToString(); },
            TokenType::IF => { return "IF".ToString(); },
            TokenType::ELSE => { return "ELSE".ToString(); },
            TokenType::FOR => { return "FOR".ToString(); },
            TokenType::IN => { return "IN".ToString(); },
            TokenType::WHILE => { return "WHILE".ToString(); },
            TokenType::LOOP => { return "LOOP".ToString(); },
            TokenType::MATCH => { return "MATCH".ToString(); },
            TokenType::RETURN => { return "RETURN".ToString(); },
            TokenType::BREAK => { return "BREAK".ToString(); },
            TokenType::CONTINUE => { return "CONTINUE".ToString(); },
            TokenType::FUNCTION => { return "FUNCTION".ToString(); },
            TokenType::CLASS => { return "CLASS".ToString(); },
            TokenType::STRUCTURE => { return "STRUCTURE".ToString(); },
            TokenType::ENUMERATION => { return "ENUMERATION".ToString(); },
            TokenType::EXTEND => { return "EXTEND".ToString(); },
            TokenType::TYPE => { return "TYPE".ToString(); },
            TokenType::EXTERN => { return "EXTERN".ToString(); },
            TokenType::LET => { return "LET".ToString(); },
            TokenType::MUT => { return "MUT".ToString(); },
            TokenType::CONST => { return "CONST".ToString(); },
            TokenType::STATIC => { return "STATIC".ToString(); },
            TokenType::PUBLIC => { return "PUBLIC".ToString(); },
            TokenType::ASSEMBLY => { return "ASSEMBLY".ToString(); },
            TokenType::ASSEMBLY_TEXT => { return "ASSEMBLY_TEXT".ToString(); },
            TokenType::VOLATILE => { return "VOLATILE".ToString(); },
            TokenType::UNSAFE => { return "UNSAFE".ToString(); },
            TokenType::ASSIGN => { return "ASSIGN".ToString(); },
            TokenType::PLUS_ASSIGN => { return "PLUS_ASSIGN".ToString(); },
            TokenType::MINUS_ASSIGN => { return "MINUS_ASSIGN".ToString(); },
            TokenType::MUL_ASSIGN => { return "MUL_ASSIGN".ToString(); },
            TokenType::DIV_ASSIGN => { return "DIV_ASSIGN".ToString(); },
            TokenType::MOD_ASSIGN => { return "MOD_ASSIGN".ToString(); },
            TokenType::LSHIFT_ASSIGN => { return "LSHIFT_ASSIGN".ToString(); },
            TokenType::RSHIFT_ASSIGN => { return "RSHIFT_ASSIGN".ToString(); },
            TokenType::AND_ASSIGN => { return "AND_ASSIGN".ToString(); },
            TokenType::OR_ASSIGN => { return "OR_ASSIGN".ToString(); },
            TokenType::XOR_ASSIGN => { return "XOR_ASSIGN".ToString(); },
            TokenType::PLUS => { return "PLUS".ToString(); },
            TokenType::MINUS => { return "MINUS".ToString(); },
            TokenType::MUL => { return "MUL".ToString(); },
            TokenType::DIV => { return "DIV".ToString(); },
            TokenType::MOD => { return "MOD".ToString(); },
            TokenType::AND => { return "AND".ToString(); },
            TokenType::OR => { return "OR".ToString(); },
            TokenType::NOT => { return "NOT".ToString(); },
            TokenType::BITWISE_AND => { return "BITWISE_AND".ToString(); },
            TokenType::BITWISE_OR => { return "BITWISE_OR".ToString(); },
            TokenType::BITWISE_XOR => { return "BITWISE_XOR".ToString(); },
            TokenType::LSHIFT => { return "LSHIFT".ToString(); },
            TokenType::RSHIFT => { return "RSHIFT".ToString(); },
            TokenType::TILDE => { return "TILDE".ToString(); },
            TokenType::EQUAL => { return "EQUAL".ToString(); },
            TokenType::NOT_EQUAL => { return "NOT_EQUAL".ToString(); },
            TokenType::GREATER => { return "GREATER".ToString(); },
            TokenType::LESS => { return "LESS".ToString(); },
            TokenType::GREATER_EQUAL => { return "GREATER_EQUAL".ToString(); },
            TokenType::LESS_EQUAL => { return "LESS_EQUAL".ToString(); },
            TokenType::LPAREN => { return "LPAREN".ToString(); },
            TokenType::RPAREN => { return "RPAREN".ToString(); },
            TokenType::LBRACE => { return "LBRACE".ToString(); },
            TokenType::RBRACE => { return "RBRACE".ToString(); },
            TokenType::LBRACKET => { return "LBRACKET".ToString(); },
            TokenType::RBRACKET => { return "RBRACKET".ToString(); },
            TokenType::DOT => { return "DOT".ToString(); },
            TokenType::TWO_DOT => { return "TWO_DOT".ToString(); },
            TokenType::THREE_DOT => { return "THREE_DOT".ToString(); },
            TokenType::COMMA => { return "COMMA".ToString(); },
            TokenType::COLON => { return "COLON".ToString(); },
            TokenType::DOUBLE_COLON => { return "DOUBLE_COLON".ToString(); },
            TokenType::SEMICOLON => { return "SEMICOLON".ToString(); },
            TokenType::AT => { return "AT".ToString(); },
            TokenType::QUESTION_MARK => { return "QUESTION_MARK".ToString(); },
            TokenType::BACKSLASH => { return "BACKSLASH".ToString(); },
            TokenType::ARROW => { return "ARROW".ToString(); },
            TokenType::FAT_ARROW => { return "FAT_ARROW".ToString(); },
            TokenType::PREPROCESSOR_START => { return "PREPROCESSOR_START".ToString(); },
            TokenType::PREPROCESSOR_END => { return "PREPROCESSOR_END".ToString(); },
            TokenType::ELIF => { return "ELIF".ToString(); },
            TokenType::ENDIF => { return "ENDIF".ToString(); },
            TokenType::INCLUDE => { return "INCLUDE".ToString(); },
            TokenType::ERROR => { return "ERROR".ToString(); },
            TokenType::WARNING => { return "WARNING".ToString(); },
            _ => { return "UNKNOWN".ToString(); }
        }
    }
}

fn StringToKeyword(string: &String) -> TokenType {
    if string == "true" { return TokenType::TRUE; }
    else if string == "false" { return TokenType::FALSE; }
    else if string == "null" { return TokenType::NULL; }
    else if string == "zero" { return TokenType::ZERO; }
    else if string == "new" { return TokenType::NEW; }
    else if string == "delete" { return TokenType::DELETE; }
    else if string == "async" { return TokenType::ASYNC; }
    else if string == "await" { return TokenType::AWAIT; }
    else if string == "as" { return TokenType::AS; }
    else if string == "this" { return TokenType::THIS; }
    else if string == "if" { return TokenType::IF; }
    else if string == "else" { return TokenType::ELSE; }
    else if string == "for" { return TokenType::FOR; }
    else if string == "in" { return TokenType::IN; }
    else if string == "while" { return TokenType::WHILE; }
    else if string == "loop" { return TokenType::LOOP; }
    else if string == "match" { return TokenType::MATCH; }
    else if string == "return" { return TokenType::RETURN; }
    else if string == "break" { return TokenType::BREAK; }
    else if string == "continue" { return TokenType::CONTINUE; }
    else if string == "fn" { return TokenType::FUNCTION; }
    else if string == "class" { return TokenType::CLASS; }
    else if string == "struct" { return TokenType::STRUCTURE; }
    else if string == "enum" { return TokenType::ENUMERATION; }
    else if string == "extend" { return TokenType::EXTEND; }
    else if string == "type" { return TokenType::TYPE; }
    else if string == "extern" { return TokenType::EXTERN; }
    else if string == "let" { return TokenType::LET; }
    else if string == "mut" { return TokenType::MUT; }
    else if string == "const" { return TokenType::CONST; }
    else if string == "static" { return TokenType::STATIC; }
    else if string == "pub" { return TokenType::PUBLIC; }
    else if string == "operator" { return TokenType::OPERATOR; }
    else if string == "asm" { return TokenType::ASSEMBLY; }
    else if string == "volatile" { return TokenType::VOLATILE; }
    else if string == "unsafe" { return TokenType::UNSAFE; }
    else { return TokenType::UNKNOWN; }
}

fn StringToDirective(string: &String) -> TokenType {
    if string == "true" { return TokenType::TRUE; }
    else if string == "false" { return TokenType::FALSE; }
    else if string == "if" { return TokenType::IF; }
    else if string == "elif" { return TokenType::ELIF; }
    else if string == "else" { return TokenType::ELSE; }
    else if string == "endif" { return TokenType::ENDIF; }
    else if string == "include" { return TokenType::INCLUDE; }
    else if string == "error" { return TokenType::ERROR; }
    else if string == "warning" { return TokenType::WARNING; }
    else { return TokenType::UNKNOWN; }
}

class Token {
    pub _type: TokenType,
    pub value: String,
    pub row: u32,
    pub column: u32,
    pub file: String
}
