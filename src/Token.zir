#[include "std/str" : *]

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL, ZERO,

    NEW, DELETE, ASYNC, AWAIT, AS, THIS, OPERATOR,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNCTION, CLASS, STRUCTURE, ENUMERATION, EXTEND, TYPE, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, ASSEMBLY, ASSEMBLY_TEXT, VOLATILE, UNSAFE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,
    EQUAL, NOT_EQUAL, GREATER, LESS, GREATER_EQUAL, LESS_EQUAL,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    AT, QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ELIF, ENDIF, INCLUDE, ERROR, WARNING
}

extend TokenType {
    pub fn ToString(this) -> String {
        match this {
            TokenType::EOF => "EOF",
            TokenType::IDENTIFIER => "IDENTIFIER",
            TokenType::INTEGER => "INTEGER",
            TokenType::FLOAT => "FLOAT",
            TokenType::STRING => "STRING",
            TokenType::CHAR => "CHAR",
            TokenType::TRUE => "TRUE",
            TokenType::FALSE => "FALSE",
            TokenType::NULL => "NULL",
            TokenType::ZERO => "ZERO",
            TokenType::NEW => "NEW",
            TokenType::DELETE => "DELETE",
            TokenType::ASYNC => "ASYNC",
            TokenType::AWAIT => "AWAIT",
            TokenType::AS => "AS",
            TokenType::THIS => "THIS",
            TokenType::OPERATOR => "OPERATOR",
            TokenType::IF => "IF",
            TokenType::ELSE => "ELSE",
            TokenType::FOR => "FOR",
            TokenType::IN => "IN",
            TokenType::WHILE => "WHILE",
            TokenType::LOOP => "LOOP",
            TokenType::MATCH => "MATCH",
            TokenType::RETURN => "RETURN",
            TokenType::BREAK => "BREAK",
            TokenType::CONTINUE => "CONTINUE",
            TokenType::FUNCTION => "FUNCTION",
            TokenType::CLASS => "CLASS",
            TokenType::STRUCTURE => "STRUCTURE",
            TokenType::ENUMERATION => "ENUMERATION",
            TokenType::EXTEND => "EXTEND",
            TokenType::TYPE => "TYPE",
            TokenType::EXTERN => "EXTERN",
            TokenType::LET => "LET",
            TokenType::MUT => "MUT",
            TokenType::CONST => "CONST",
            TokenType::STATIC => "STATIC",
            TokenType::PUBLIC => "PUBLIC",
            TokenType::ASSEMBLY => "ASSEMBLY",
            TokenType::ASSEMBLY_TEXT => "ASSEMBLY_TEXT",
            TokenType::VOLATILE => "VOLATILE",
            TokenType::UNSAFE => "UNSAFE",
            TokenType::ASSIGN => "ASSIGN",
            TokenType::PLUS_ASSIGN => "PLUS_ASSIGN",
            TokenType::MINUS_ASSIGN => "MINUS_ASSIGN",
            TokenType::MUL_ASSIGN => "MUL_ASSIGN",
            TokenType::DIV_ASSIGN => "DIV_ASSIGN",
            TokenType::MOD_ASSIGN => "MOD_ASSIGN",
            TokenType::LSHIFT_ASSIGN => "LSHIFT_ASSIGN",
            TokenType::RSHIFT_ASSIGN => "RSHIFT_ASSIGN",
            TokenType::AND_ASSIGN => "AND_ASSIGN",
            TokenType::OR_ASSIGN => "OR_ASSIGN",
            TokenType::XOR_ASSIGN => "XOR_ASSIGN",
            TokenType::PLUS => "PLUS",
            TokenType::MINUS => "MINUS",
            TokenType::MUL => "MUL",
            TokenType::DIV => "DIV",
            TokenType::MOD => "MOD",
            TokenType::AND => "AND",
            TokenType::OR => "OR",
            TokenType::NOT => "NOT",
            TokenType::BITWISE_AND => "BITWISE_AND",
            TokenType::BITWISE_OR => "BITWISE_OR",
            TokenType::BITWISE_XOR => "BITWISE_XOR",
            TokenType::LSHIFT => "LSHIFT",
            TokenType::RSHIFT => "RSHIFT",
            TokenType::TILDE => "TILDE",
            TokenType::EQUAL => "EQUAL",
            TokenType::NOT_EQUAL => "NOT_EQUAL",
            TokenType::GREATER => "GREATER",
            TokenType::LESS => "LESS",
            TokenType::GREATER_EQUAL => "GREATER_EQUAL",
            TokenType::LESS_EQUAL => "LESS_EQUAL",
            TokenType::LPAREN => "LPAREN",
            TokenType::RPAREN => "RPAREN",
            TokenType::LBRACE => "LBRACE",
            TokenType::RBRACE => "RBRACE",
            TokenType::LBRACKET => "LBRACKET",
            TokenType::RBRACKET => "RBRACKET",
            TokenType::DOT => "DOT",
            TokenType::TWO_DOT => "TWO_DOT",
            TokenType::THREE_DOT => "THREE_DOT",
            TokenType::COMMA => "COMMA",
            TokenType::COLON => "COLON",
            TokenType::DOUBLE_COLON => "DOUBLE_COLON",
            TokenType::SEMICOLON => "SEMICOLON",
            TokenType::AT => "AT",
            TokenType::QUESTION_MARK => "QUESTION_MARK",
            TokenType::BACKSLASH => "BACKSLASH",
            TokenType::ARROW => "ARROW",
            TokenType::FAT_ARROW => "FAT_ARROW",
            TokenType::PREPROCESSOR_START => "PREPROCESSOR_START",
            TokenType::PREPROCESSOR_END => "PREPROCESSOR_END",
            TokenType::ELIF => "ELIF",
            TokenType::ENDIF => "ENDIF",
            TokenType::INCLUDE => "INCLUDE",
            TokenType::ERROR => "ERROR",
            TokenType::WARNING => "WARNING",
            _ => "UNKNOWN"
        }.ToString()
    }
}

fn StringToKeyword(string: &String) -> TokenType {
    if string == "true" { TokenType::TRUE }
    else if string == "false" { TokenType::FALSE }
    else if string == "null" { TokenType::NULL }
    else if string == "zero" { TokenType::ZERO }
    else if string == "new" { TokenType::NEW }
    else if string == "delete" { TokenType::DELETE }
    else if string == "async" { TokenType::ASYNC }
    else if string == "await" { TokenType::AWAIT }
    else if string == "as" { TokenType::AS }
    else if string == "this" { TokenType::THIS }
    else if string == "if" { TokenType::IF }
    else if string == "else" { TokenType::ELSE }
    else if string == "for" { TokenType::FOR }
    else if string == "in" { TokenType::IN }
    else if string == "while" { TokenType::WHILE }
    else if string == "loop" { TokenType::LOOP }
    else if string == "match" { TokenType::MATCH }
    else if string == "return" { TokenType::RETURN }
    else if string == "break" { TokenType::BREAK }
    else if string == "continue" { TokenType::CONTINUE }
    else if string == "fn" { TokenType::FUNCTION }
    else if string == "class" { TokenType::CLASS }
    else if string == "struct" { TokenType::STRUCTURE }
    else if string == "enum" { TokenType::ENUMERATION }
    else if string == "extend" { TokenType::EXTEND }
    else if string == "type" { TokenType::TYPE }
    else if string == "extern" { TokenType::EXTERN }
    else if string == "let" { TokenType::LET }
    else if string == "mut" { TokenType::MUT }
    else if string == "const" { TokenType::CONST }
    else if string == "static" { TokenType::STATIC }
    else if string == "pub" { TokenType::PUBLIC }
    else if string == "operator" { TokenType::OPERATOR }
    else if string == "asm" { TokenType::ASSEMBLY }
    else if string == "volatile" { TokenType::VOLATILE }
    else if string == "unsafe" { TokenType::UNSAFE }
    else { TokenType::UNKNOWN }
}

fn StringToDirective(string: &String) -> TokenType {
    if string == "true" { TokenType::TRUE }
    else if string == "false" { TokenType::FALSE }
    else if string == "if" { TokenType::IF }
    else if string == "elif" { TokenType::ELIF }
    else if string == "else" { TokenType::ELSE }
    else if string == "endif" { TokenType::ENDIF }
    else if string == "include" { TokenType::INCLUDE }
    else if string == "error" { TokenType::ERROR }
    else if string == "warning" { TokenType::WARNING }
    else { TokenType::UNKNOWN }
}

class Token {
    pub _type: TokenType,
    pub value: String,
    pub row: u32,
    pub column: u32,
    pub file: String
}
