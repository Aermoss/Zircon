#[include "std/str" : *]

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL, ZERO,

    NEW, DELETE, ASYNC, AWAIT, AS, THIS, OPERATOR,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNCTION, CLASS, STRUCTURE, ENUMERATION, EXTEND, TYPE, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, ASSEMBLY, ASSEMBLY_TEXT, VOLATILE, UNSAFE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,
    EQUAL, NOT_EQUAL, GREATER, LESS, GREATER_EQUAL, LESS_EQUAL,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    AT, QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ELIF, ENDIF, INCLUDE, ERROR, WARNING
}

extend TokenType {
    pub fn ToString(this) -> String {
        match this {
            TokenType::EOF => "EOF".ToString(),
            TokenType::IDENTIFIER => "IDENTIFIER".ToString(),
            TokenType::INTEGER => "INTEGER".ToString(),
            TokenType::FLOAT => "FLOAT".ToString(),
            TokenType::STRING => "STRING".ToString(),
            TokenType::CHAR => "CHAR".ToString(),
            TokenType::TRUE => "TRUE".ToString(),
            TokenType::FALSE => "FALSE".ToString(),
            TokenType::NULL => "NULL".ToString(),
            TokenType::ZERO => "ZERO".ToString(),
            TokenType::NEW => "NEW".ToString(),
            TokenType::DELETE => "DELETE".ToString(),
            TokenType::ASYNC => "ASYNC".ToString(),
            TokenType::AWAIT => "AWAIT".ToString(),
            TokenType::AS => "AS".ToString(),
            TokenType::THIS => "THIS".ToString(),
            TokenType::OPERATOR => "OPERATOR".ToString(),
            TokenType::IF => "IF".ToString(),
            TokenType::ELSE => "ELSE".ToString(),
            TokenType::FOR => "FOR".ToString(),
            TokenType::IN => "IN".ToString(),
            TokenType::WHILE => "WHILE".ToString(),
            TokenType::LOOP => "LOOP".ToString(),
            TokenType::MATCH => "MATCH".ToString(),
            TokenType::RETURN => "RETURN".ToString(),
            TokenType::BREAK => "BREAK".ToString(),
            TokenType::CONTINUE => "CONTINUE".ToString(),
            TokenType::FUNCTION => "FUNCTION".ToString(),
            TokenType::CLASS => "CLASS".ToString(),
            TokenType::STRUCTURE => "STRUCTURE".ToString(),
            TokenType::ENUMERATION => "ENUMERATION".ToString(),
            TokenType::EXTEND => "EXTEND".ToString(),
            TokenType::TYPE => "TYPE".ToString(),
            TokenType::EXTERN => "EXTERN".ToString(),
            TokenType::LET => "LET".ToString(),
            TokenType::MUT => "MUT".ToString(),
            TokenType::CONST => "CONST".ToString(),
            TokenType::STATIC => "STATIC".ToString(),
            TokenType::PUBLIC => "PUBLIC".ToString(),
            TokenType::ASSEMBLY => "ASSEMBLY".ToString(),
            TokenType::ASSEMBLY_TEXT => "ASSEMBLY_TEXT".ToString(),
            TokenType::VOLATILE => "VOLATILE".ToString(),
            TokenType::UNSAFE => "UNSAFE".ToString(),
            TokenType::ASSIGN => "ASSIGN".ToString(),
            TokenType::PLUS_ASSIGN => "PLUS_ASSIGN".ToString(),
            TokenType::MINUS_ASSIGN => "MINUS_ASSIGN".ToString(),
            TokenType::MUL_ASSIGN => "MUL_ASSIGN".ToString(),
            TokenType::DIV_ASSIGN => "DIV_ASSIGN".ToString(),
            TokenType::MOD_ASSIGN => "MOD_ASSIGN".ToString(),
            TokenType::LSHIFT_ASSIGN => "LSHIFT_ASSIGN".ToString(),
            TokenType::RSHIFT_ASSIGN => "RSHIFT_ASSIGN".ToString(),
            TokenType::AND_ASSIGN => "AND_ASSIGN".ToString(),
            TokenType::OR_ASSIGN => "OR_ASSIGN".ToString(),
            TokenType::XOR_ASSIGN => "XOR_ASSIGN".ToString(),
            TokenType::PLUS => "PLUS".ToString(),
            TokenType::MINUS => "MINUS".ToString(),
            TokenType::MUL => "MUL".ToString(),
            TokenType::DIV => "DIV".ToString(),
            TokenType::MOD => "MOD".ToString(),
            TokenType::AND => "AND".ToString(),
            TokenType::OR => "OR".ToString(),
            TokenType::NOT => "NOT".ToString(),
            TokenType::BITWISE_AND => "BITWISE_AND".ToString(),
            TokenType::BITWISE_OR => "BITWISE_OR".ToString(),
            TokenType::BITWISE_XOR => "BITWISE_XOR".ToString(),
            TokenType::LSHIFT => "LSHIFT".ToString(),
            TokenType::RSHIFT => "RSHIFT".ToString(),
            TokenType::TILDE => "TILDE".ToString(),
            TokenType::EQUAL => "EQUAL".ToString(),
            TokenType::NOT_EQUAL => "NOT_EQUAL".ToString(),
            TokenType::GREATER => "GREATER".ToString(),
            TokenType::LESS => "LESS".ToString(),
            TokenType::GREATER_EQUAL => "GREATER_EQUAL".ToString(),
            TokenType::LESS_EQUAL => "LESS_EQUAL".ToString(),
            TokenType::LPAREN => "LPAREN".ToString(),
            TokenType::RPAREN => "RPAREN".ToString(),
            TokenType::LBRACE => "LBRACE".ToString(),
            TokenType::RBRACE => "RBRACE".ToString(),
            TokenType::LBRACKET => "LBRACKET".ToString(),
            TokenType::RBRACKET => "RBRACKET".ToString(),
            TokenType::DOT => "DOT".ToString(),
            TokenType::TWO_DOT => "TWO_DOT".ToString(),
            TokenType::THREE_DOT => "THREE_DOT".ToString(),
            TokenType::COMMA => "COMMA".ToString(),
            TokenType::COLON => "COLON".ToString(),
            TokenType::DOUBLE_COLON => "DOUBLE_COLON".ToString(),
            TokenType::SEMICOLON => "SEMICOLON".ToString(),
            TokenType::AT => "AT".ToString(),
            TokenType::QUESTION_MARK => "QUESTION_MARK".ToString(),
            TokenType::BACKSLASH => "BACKSLASH".ToString(),
            TokenType::ARROW => "ARROW".ToString(),
            TokenType::FAT_ARROW => "FAT_ARROW".ToString(),
            TokenType::PREPROCESSOR_START => "PREPROCESSOR_START".ToString(),
            TokenType::PREPROCESSOR_END => "PREPROCESSOR_END".ToString(),
            TokenType::ELIF => "ELIF".ToString(),
            TokenType::ENDIF => "ENDIF".ToString(),
            TokenType::INCLUDE => "INCLUDE".ToString(),
            TokenType::ERROR => "ERROR".ToString(),
            TokenType::WARNING => "WARNING".ToString(),
            _ => "UNKNOWN".ToString()
        }
    }
}

fn StringToKeyword(string: &String) -> TokenType {
    if string == "true" { TokenType::TRUE }
    else if string == "false" { TokenType::FALSE }
    else if string == "null" { TokenType::NULL }
    else if string == "zero" { TokenType::ZERO }
    else if string == "new" { TokenType::NEW }
    else if string == "delete" { TokenType::DELETE }
    else if string == "async" { TokenType::ASYNC }
    else if string == "await" { TokenType::AWAIT }
    else if string == "as" { TokenType::AS }
    else if string == "this" { TokenType::THIS }
    else if string == "if" { TokenType::IF }
    else if string == "else" { TokenType::ELSE }
    else if string == "for" { TokenType::FOR }
    else if string == "in" { TokenType::IN }
    else if string == "while" { TokenType::WHILE }
    else if string == "loop" { TokenType::LOOP }
    else if string == "match" { TokenType::MATCH }
    else if string == "return" { TokenType::RETURN }
    else if string == "break" { TokenType::BREAK }
    else if string == "continue" { TokenType::CONTINUE }
    else if string == "fn" { TokenType::FUNCTION }
    else if string == "class" { TokenType::CLASS }
    else if string == "struct" { TokenType::STRUCTURE }
    else if string == "enum" { TokenType::ENUMERATION }
    else if string == "extend" { TokenType::EXTEND }
    else if string == "type" { TokenType::TYPE }
    else if string == "extern" { TokenType::EXTERN }
    else if string == "let" { TokenType::LET }
    else if string == "mut" { TokenType::MUT }
    else if string == "const" { TokenType::CONST }
    else if string == "static" { TokenType::STATIC }
    else if string == "pub" { TokenType::PUBLIC }
    else if string == "operator" { TokenType::OPERATOR }
    else if string == "asm" { TokenType::ASSEMBLY }
    else if string == "volatile" { TokenType::VOLATILE }
    else if string == "unsafe" { TokenType::UNSAFE }
    else { TokenType::UNKNOWN }
}

fn StringToDirective(string: &String) -> TokenType {
    if string == "true" { TokenType::TRUE }
    else if string == "false" { TokenType::FALSE }
    else if string == "if" { TokenType::IF }
    else if string == "elif" { TokenType::ELIF }
    else if string == "else" { TokenType::ELSE }
    else if string == "endif" { TokenType::ENDIF }
    else if string == "include" { TokenType::INCLUDE }
    else if string == "error" { TokenType::ERROR }
    else if string == "warning" { TokenType::WARNING }
    else { TokenType::UNKNOWN }
}

class Token {
    pub _type: TokenType,
    pub value: String,
    pub row: u32,
    pub column: u32,
    pub file: String
}
