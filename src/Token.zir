#[include "std/str", "src/Source.zir" : *]

enum TokenType: i32 {
    Unknown, EndOfFile,

    Identifier, Integer, Float, String, Character, Label, True, False, Null,

    New, Delete, Async, Await, As, This, Operator,
    If, Else, For, In, While, Loop, Match, Return, Break, Continue,
    Function, Class, Structure, Enumeration, Extend, Type, Extern, Let, Mut, Const, Static,
    Public, Virtual, Override, Assembly, AssemblyText, Volatile, Unsafe,

    Assign, PlusAssign, MinusAssign, MulAssign, DivAssign, ModAssign,
    LeftShiftAssign, RightShiftAssign, AndAssign, OrAssign, XorAssign,

    Plus, Minus, Mul, Div, Mod, And, Or, Not,
    BitwiseAnd, BitwiseOr, BitwiseXor, LeftShift, RightShift, Tilde,
    Equal, NotEqual, Greater, Less, GreaterEqual, LessEqual,

    LeftParen, RightParen, LeftBrace, RightBrace, LeftBracket, RightBracket,
    Dot, TwoDot, ThreeDot, Comma, Colon, DoubleColon, Semicolon,
    At, QuestionMark, Backslash, Arrow, FatArrow,

    PreprocessorStart, PreprocessorEnd,
    Elif, Endif, Include, Error, Warning
}

extend TokenType {
