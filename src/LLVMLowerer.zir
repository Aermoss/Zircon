#[include "std/str", "std/vec", "std/map", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Analysis.zir",
    "src/Target.zir", "src/MIR.zir", "src/Logger.zir" : *]

class LLVMLowerer {
    module: LLVMModuleRef = null,
    builder: LLVMBuilderRef = null,
    context: LLVMContextRef,
    pub target: *Target,

    types: Map<*MIRType, LLVMTypeRef>,
    declarations: Map<*MIRDeclaration, LLVMValueRef>,
    phis: Map<*MIRPhiInstruction, LLVMValueRef>,
    blocks: Map<*MIRBlock, LLVMBasicBlockRef>,
    values: Map<*MIRValue, LLVMValueRef>,

    freestanding: bool,
    no_red_zone: bool;

    LLVMLowerer(&mut this, target: &Target, freestanding: bool, no_red_zone: bool) {
        if llvm_lowerer != null {
            Logger::Log("Another instance of 'LLVMLowerer' already exists!", LogSeverity::Fatal);
        } llvm_lowerer = this;

        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
        (this.context, this.target) = (LLVMContextCreate(), target);
    }

    ~LLVMLowerer(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        LLVMContextDispose(this.context);
        llvm_lowerer = null;
    }

    pub fn Lower(&mut this, module: *MIRModule) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());

        if module != null {
            this.LowerModule(module);
        }

        let mut message: *mut i8 = null;

        if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
            let final_message = message != null ? message : "Unknown reason.";
            Logger::Log("Module verification failed: " + final_message.ToString(), LogSeverity::Error);

            if message != null {
                LLVMDisposeMessage(message);
            } return this.module;
        }

        if message != null {
            LLVMDisposeMessage(message);
        } return this.module;
    }

    fn LowerModule(&mut this, module: *MIRModule) {
        for declaration in module->declarations {
            this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFifthPass(declaration);
        }
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Type {
            this.LowerTypeDeclarationFirstPass(declaration as *MIRTypeDeclaration);
        } else if declaration->kind == MIRDeclarationKind::Assembly {
            this.LowerAssemblyDeclaration(declaration as *MIRAssemblyDeclaration);
        }
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Type {
            this.LowerTypeDeclarationSecondPass(declaration as *MIRTypeDeclaration);
        }
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Constant {
            this.LowerConstantDeclarationFirstPass(declaration as *MIRConstantDeclaration);
        } else if declaration->kind == MIRDeclarationKind::Static {
            this.LowerStaticDeclarationFirstPass(declaration as *MIRStaticDeclaration);
        } else if declaration->kind == MIRDeclarationKind::Function {
            this.LowerFunctionDeclarationFirstPass(declaration as *MIRFunctionDeclaration);
        }
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Constant {
            this.LowerConstantDeclarationSecondPass(declaration as *MIRConstantDeclaration);
        } else if declaration->kind == MIRDeclarationKind::Static {
            this.LowerStaticDeclarationSecondPass(declaration as *MIRStaticDeclaration);
        }
    }

    fn LowerDeclarationFifthPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Function {
            this.LowerFunctionDeclarationSecondPass(declaration as *MIRFunctionDeclaration);
        }
    }

    fn LowerTypeDeclarationFirstPass(&mut this, _type: *MIRTypeDeclaration) {
        this.types[_type->_type] = LLVMStructCreateNamed(this.context, _type->name.Data());
    }

    fn LowerTypeDeclarationSecondPass(&mut this, _type: *MIRTypeDeclaration) {
        let mut fields = Vector<LLVMTypeRef>();

        for field in (_type->_type as *MIRStructureType)->fields {
            let lowered_field = this.LowerType(field);
            if lowered_field == null { return; }
            fields.PushBack(lowered_field);
        }

        LLVMStructSetBody(this.types[_type->_type], fields.Data(), fields.Size() as u32, 0);
    }

    fn LowerFunctionDeclarationFirstPass(&mut this, function: *MIRFunctionDeclaration) {
        let mut parameters = Vector<LLVMTypeRef>();

        for parameter in function->parameters {
            let lowered_parameter_type = this.LowerType(parameter->_type);
            if lowered_parameter_type == null { return; }
            parameters.PushBack(lowered_parameter_type);
        }

        let _return = this.LowerType(function->_return);
        if _return == null { return; }
        let value = LLVMAddFunction(this.module, function->name.Data(), LLVMFunctionType(_return, parameters.Data(), parameters.Size() as u32, 0));
        LLVMSetFunctionCallConv(value, (function->linkage == MIRDeclarationLinkage::Internal ? LLVMCallConv::LLVMFastCallConv : LLVMCallConv::LLVMCCallConv) as u32);
        this.declarations[function] = value;

        if this.freestanding || true {
            let attribute = LLVMCreateStringAttribute(this.context, "no-stack-arg-probe", 18, "", 0);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if this.no_red_zone {
            let attribute = LLVMCreateEnumAttribute(this.context, LLVMGetEnumAttributeKindForName("noredzone", 9), 0);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if !this.target->features.Empty() {
            let attribute = LLVMCreateStringAttribute(this.context, "target-features", 15, this.target->features.Data(), this.target->features.Length() as u32);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }
    }

    fn LowerFunctionDeclarationSecondPass(&mut this, function: *MIRFunctionDeclaration) {
        if function->blocks.Empty() { return; }
        let value = this.declarations[function];
        this.values.Clear();

        for parameter in function->parameters {
            let lowered_parameter = LLVMGetParam(value, parameter->index);
            LLVMSetValueName2(lowered_parameter, parameter->name.Data(), parameter->name.Length());
            this.values[parameter] = lowered_parameter;
        }

        this.blocks.Clear();

        for block in function->blocks {
            this.blocks[block] = LLVMAppendBasicBlockInContext(this.context, value, block->name.Data());
        }

        this.phis.Clear();

        for block in function->blocks {
            LLVMPositionBuilderAtEnd(this.builder, this.blocks[block]);

            for instruction in block->instructions {
                this.values[instruction] = this.LowerInstruction(instruction);
            }

            if block->terminator != null {
                this.LowerTerminator(block->terminator);
            }
        }

        for pair in this.phis {
            let (phi, lowered) = (pair.left, pair.right);

            for incoming in phi->incomings {
                let mut value = this.LowerValue(incoming.value);
                if value == null { continue; }
                let mut block = this.blocks.Get(incoming.block, null);
                if block == null { continue; }
                LLVMAddIncoming(lowered, &mut value, &mut block, 1);
            }
        }
    }

    fn LowerConstantDeclarationFirstPass(&mut this, constant: *MIRConstantDeclaration) {
        let _type = this.LowerType(constant->_type);
        if _type == null { return; }
        let global = LLVMAddGlobal(this.module, _type, constant->name.Data());
        this.declarations[constant] = global;
        LLVMSetGlobalConstant(global, 1);
    }

    fn LowerConstantDeclarationSecondPass(&mut this, constant: *MIRConstantDeclaration) {
        let initializer = this.LowerValue(constant->initializer);
        if initializer == null { return; }
        LLVMSetInitializer(this.declarations[constant], initializer);
    }

    fn LowerLinkage(&mut this, linkage: MIRDeclarationLinkage) -> LLVMLinkage {
        if linkage == MIRDeclarationLinkage::Private { return LLVMLinkage::LLVMPrivateLinkage; }
        else if linkage == MIRDeclarationLinkage::Internal { return LLVMLinkage::LLVMInternalLinkage; }
        else { return LLVMLinkage::LLVMExternalLinkage; }
    }

    fn LowerStaticDeclarationFirstPass(&mut this, _static: *MIRStaticDeclaration) {
        let _type = this.LowerType(_static->_type);
        if _type == null { return; }
        let global = LLVMAddGlobal(this.module, _type, _static->name.Data());
        LLVMSetLinkage(global, this.LowerLinkage(_static->linkage));
        LLVMSetGlobalConstant(global, !_static->mutable ? 1 : 0);
        this.declarations[_static] = global;
    }

    fn LowerStaticDeclarationSecondPass(&mut this, _static: *MIRStaticDeclaration) {
        if _static->initializer == null { return; }
        let initializer = this.LowerValue(_static->initializer);
        if initializer == null { return; }
        LLVMSetInitializer(this.declarations[_static], initializer);
    }

    fn LowerAssemblyDeclaration(&mut this, assembly: *MIRAssemblyDeclaration) {
        LLVMAppendModuleInlineAsm(this.module, assembly->text.Data(), assembly->text.Length());
    }

    fn LowerValue(&mut this, value: *MIRValue) -> LLVMValueRef {
        if value->kind == MIRValueKind::Constant {
            return this.LowerConstant(value as *MIRConstant);
        } else if value->kind == MIRValueKind::Instruction || value->kind == MIRValueKind::Parameter {
            return this.values.Get(value, null);
        } else if value->kind == MIRValueKind::DeclarationReference {
            return this.declarations.Get((value as *MIRDeclarationReference)->declaration, null);
        } else {
            return null;
        }
    }

    fn LowerConstant(&mut this, constant: *MIRConstant) -> LLVMValueRef {
        let _type = this.LowerType(constant->_type);
        if _type == null { return null; }

        if constant->kind == MIRConstantKind::Integer {
            return LLVMConstInt(_type, (constant as *MIRConstantInteger)->value, 0);
        } else if constant->kind == MIRConstantKind::Float {
            return LLVMConstReal(_type, (constant as *MIRConstantFloat)->value);
        } else if constant->kind == MIRConstantKind::String {
            let value = (constant as *MIRConstantString)->value;
            return LLVMConstStringInContext2(this.context, value.Data(), value.Length(), 0);
        } else if constant->kind == MIRConstantKind::Array {
            let mut elements = Vector<LLVMValueRef>();

            for element in (constant as *MIRConstantArray)->elements {
                let lowered_element = this.LowerValue(element);
                if lowered_element == null { return null; }
                elements.PushBack(lowered_element);
            }

            let _type = this.LowerType((constant->_type as *MIRArrayType)->element);
            if _type == null { return null; }
            return LLVMConstArray2(_type, elements.Data(), elements.Size() as u64);
        } else if constant->kind == MIRConstantKind::Structure {
            let mut fields = Vector<LLVMValueRef>();

            for field in (constant as *MIRConstantStructure)->fields {
                let lowered_field = this.LowerValue(field);
                if lowered_field == null { return null; }
                fields.PushBack(lowered_field);
            }

            return LLVMConstNamedStruct(_type, fields.Data(), fields.Size() as u32);
        } else if constant->kind == MIRConstantKind::Null {
            return LLVMConstNull(_type);
        } else if constant->kind == MIRConstantKind::Expression {
            return this.LowerConstantExpression(constant as *MIRConstantExpression);
        } else {
            return null;
        }
    }

    fn LowerConstantExpression(&mut this, expression: *MIRConstantExpression) -> LLVMValueRef {
        if expression->kind == MIRConstantExpressionKind::Unary {
            return this.LowerUnaryExpression(expression as *MIRUnaryExpression);
        } else if expression->kind == MIRConstantExpressionKind::Binary {
            return this.LowerBinaryExpression(expression as *MIRBinaryExpression);
        } else if expression->kind == MIRConstantExpressionKind::Cast {
            return this.LowerCastExpression(expression as *MIRCastExpression);
        } else if expression->kind == MIRConstantExpressionKind::ArrayGEP {
            return this.LowerArrayGEPExpression(expression as *MIRArrayGEPExpression);
        } else if expression->kind == MIRConstantExpressionKind::StructGEP {
            return this.LowerStructGEPExpression(expression as *MIRStructGEPExpression);
        } else {
            return null;
        }
    }

    fn LowerUnaryExpression(&mut this, unary: *MIRUnaryExpression) -> LLVMValueRef {
        let operand = this.LowerValue(unary->operand);
        if operand == null { return null; }
        return this.LowerResolvedUnary(unary->kind, operand, "");
    }

    fn LowerBinaryExpression(&mut this, binary: *MIRBinaryExpression) -> LLVMValueRef {
        let left = this.LowerValue(binary->left);
        if left == null { return null; }
        let right = this.LowerValue(binary->right);
        if right == null { return null; }
        return this.LowerResolvedBinary(binary->kind, left, right, "");
    }

    fn LowerCastExpression(&mut this, cast: *MIRCastExpression) -> LLVMValueRef {
        let target = this.LowerType(cast->_type);
        if target == null { return null; }
        let value = this.LowerValue(cast->value);
        if value == null { return null; }
        return this.LowerResolvedCast(cast->kind, value, target, "");
    }

    fn LowerArrayGEPExpression(&mut this, gep: *MIRArrayGEPExpression) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        let mut index = this.LowerValue(gep->index);
        if index == null { return null; }
        return LLVMBuildGEP2(this.builder, _type, pointer, &mut index, 1, "");
    }

    fn LowerStructGEPExpression(&mut this, gep: *MIRStructGEPExpression) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        return LLVMBuildStructGEP2(this.builder, _type, pointer, gep->index, "");
    }

    fn LowerInstruction(&mut this, instruction: *MIRInstruction) -> LLVMValueRef {
        if instruction->kind == MIRInstructionKind::Alloca {
            return this.LowerAllocaInstruction(instruction as *MIRAllocaInstruction);
        } else if instruction->kind == MIRInstructionKind::Load {
            return this.LowerLoadInstruction(instruction as *MIRLoadInstruction);
        } else if instruction->kind == MIRInstructionKind::Store {
            return this.LowerStoreInstruction(instruction as *MIRStoreInstruction);
        } else if instruction->kind == MIRInstructionKind::ArrayGEP {
            return this.LowerArrayGEPInstruction(instruction as *MIRArrayGEPInstruction);
        } else if instruction->kind == MIRInstructionKind::StructGEP {
            return this.LowerStructGEPInstruction(instruction as *MIRStructGEPInstruction);
        } else if instruction->kind == MIRInstructionKind::Unary {
            return this.LowerUnaryInstruction(instruction as *MIRUnaryInstruction);
        } else if instruction->kind == MIRInstructionKind::Binary {
            return this.LowerBinaryInstruction(instruction as *MIRBinaryInstruction);
        } else if instruction->kind == MIRInstructionKind::Call {
            return this.LowerCallInstruction(instruction as *MIRCallInstruction);
        } else if instruction->kind == MIRInstructionKind::Cast {
            return this.LowerCastInstruction(instruction as *MIRCastInstruction);
        } else if instruction->kind == MIRInstructionKind::Select {
            return this.LowerSelectInstruction(instruction as *MIRSelectInstruction);
        } else if instruction->kind == MIRInstructionKind::Phi {
            return this.LowerPhiInstruction(instruction as *MIRPhiInstruction);
        } else if instruction->kind == MIRInstructionKind::Assembly {
            return this.LowerAssemblyInstruction(instruction as *MIRAssemblyInstruction);
        } else if instruction->kind == MIRInstructionKind::Terminator {
            return this.LowerTerminator(instruction as *MIRTerminator);
        } else {
            return null;
        }
    }

    fn LowerAllocaInstruction(&mut this, alloca: *MIRAllocaInstruction) -> LLVMValueRef {
        let _type = this.LowerType(alloca->_type);
        if _type == null { return null; }
        return LLVMBuildAlloca(this.builder, _type, alloca->name.Data());
    }

    fn LowerLoadInstruction(&mut this, load: *MIRLoadInstruction) -> LLVMValueRef {
        let _type = this.LowerType(load->_type);
        if _type == null { return null; }
        let pointer = this.LowerValue(load->pointer);
        if pointer == null { return null; }
        return LLVMBuildLoad2(this.builder, _type, pointer, load->name.Data());
    }

    fn LowerStoreInstruction(&mut this, store: *MIRStoreInstruction) -> LLVMValueRef {
        let value = this.LowerValue(store->value);
        if value == null { return null; }
        let pointer = this.LowerValue(store->pointer);
        if pointer == null { return null; }
        return LLVMBuildStore(this.builder, value, pointer);
    }

    fn LowerArrayGEPInstruction(&mut this, gep: *MIRArrayGEPInstruction) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        let mut index = this.LowerValue(gep->index);
        if index == null { return null; }
        return LLVMBuildGEP2(this.builder, _type, pointer, &mut index, 1, gep->name.Data());
    }

    fn LowerStructGEPInstruction(&mut this, gep: *MIRStructGEPInstruction) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        return LLVMBuildStructGEP2(this.builder, _type, pointer, gep->index, gep->name.Data());
    }

    fn LowerUnaryInstruction(&mut this, unary: *MIRUnaryInstruction) -> LLVMValueRef {
        let operand = this.LowerValue(unary->operand);
        if operand == null { return null; }
        return this.LowerResolvedUnary(unary->kind, operand, unary->name.Data());
    }

    fn LowerResolvedUnary(&mut this, kind: MIRUnaryKind, operand: LLVMValueRef, name: *i8) -> LLVMValueRef {
        if kind == MIRUnaryKind::Neg { return LLVMBuildNeg(this.builder, operand, name); }
        else if kind == MIRUnaryKind::FNeg { return LLVMBuildFNeg(this.builder, operand, name); }
        else if kind == MIRUnaryKind::Not { return LLVMBuildNot(this.builder, operand, name); }
        else { return null; }
    }

    fn LowerBinaryInstruction(&mut this, binary: *MIRBinaryInstruction) -> LLVMValueRef {
        let left = this.LowerValue(binary->left);
        if left == null { return null; }
        let right = this.LowerValue(binary->right);
        if right == null { return null; }
        return this.LowerResolvedBinary(binary->kind, left, right, binary->name.Data());
    }

    fn LowerResolvedBinary(&mut this, kind: MIRBinaryKind, left: LLVMValueRef, right: LLVMValueRef, name: *i8) -> LLVMValueRef {
        if kind == MIRBinaryKind::Add { return LLVMBuildAdd(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::Sub { return LLVMBuildSub(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::Mul { return LLVMBuildMul(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::SDiv { return LLVMBuildSDiv(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::UDiv { return LLVMBuildUDiv(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::SRem { return LLVMBuildSRem(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::URem { return LLVMBuildURem(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::And { return LLVMBuildAnd(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::Or { return LLVMBuildOr(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::Xor { return LLVMBuildXor(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::Shl { return LLVMBuildShl(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::LShr { return LLVMBuildLShr(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::AShr { return LLVMBuildAShr(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::FAdd { return LLVMBuildFAdd(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::FSub { return LLVMBuildFSub(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::FMul { return LLVMBuildFMul(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::FDiv { return LLVMBuildFDiv(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::FRem { return LLVMBuildFRem(this.builder, left, right, name); }
        else if kind == MIRBinaryKind::ICmpEq { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left, right, name); }
        else if kind == MIRBinaryKind::ICmpNe { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left, right, name); }
        else if kind == MIRBinaryKind::ICmpSlt { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSLT, left, right, name); }
        else if kind == MIRBinaryKind::ICmpSgt { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSGT, left, right, name); }
        else if kind == MIRBinaryKind::ICmpSle { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSLE, left, right, name); }
        else if kind == MIRBinaryKind::ICmpSge { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSGE, left, right, name); }
        else if kind == MIRBinaryKind::ICmpUlt { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, left, right, name); }
        else if kind == MIRBinaryKind::ICmpUgt { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGT, left, right, name); }
        else if kind == MIRBinaryKind::ICmpUle { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULE, left, right, name); }
        else if kind == MIRBinaryKind::ICmpUge { return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGE, left, right, name); }
        else if kind == MIRBinaryKind::FCmpEq { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOEQ, left, right, name); }
        else if kind == MIRBinaryKind::FCmpNe { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealONE, left, right, name); }
        else if kind == MIRBinaryKind::FCmpLt { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, left, right, name); }
        else if kind == MIRBinaryKind::FCmpGt { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGT, left, right, name); }
        else if kind == MIRBinaryKind::FCmpLe { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, left, right, name); }
        else if kind == MIRBinaryKind::FCmpGe { return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGE, left, right, name); }
        else { return null; }
    }

    fn LowerCallInstruction(&mut this, call: *MIRCallInstruction) -> LLVMValueRef {
        let _type = this.LowerFunctionType(call->callee->_type as *MIRFunctionType);
        if _type == null { return null; }
        let callee = this.LowerValue(call->callee);
        if callee == null { return null; }
        let mut arguments = Vector<LLVMValueRef>();

        for argument in call->arguments {
            let lowered_argument = this.LowerValue(argument);
            if lowered_argument == null { return null; }
            arguments.PushBack(lowered_argument);
        }

        return LLVMBuildCall2(this.builder, _type, callee, arguments.Data(), arguments.Size() as u32, call->name.Data());
    }

    fn LowerCastInstruction(&mut this, cast: *MIRCastInstruction) -> LLVMValueRef {
        let target = this.LowerType(cast->_type);
        if target == null { return null; }
        let value = this.LowerValue(cast->value);
        if value == null { return null; }
        return this.LowerResolvedCast(cast->kind, value, target, cast->name.Data());
    }

    fn LowerResolvedCast(&mut this, kind: MIRCastKind, value: LLVMValueRef, target: LLVMTypeRef, name: *i8) -> LLVMValueRef {
        if kind == MIRCastKind::Trunc { return LLVMBuildTrunc(this.builder, value, target, name); }
        else if kind == MIRCastKind::ZExt { return LLVMBuildZExt(this.builder, value, target, name); }
        else if kind == MIRCastKind::SExt { return LLVMBuildSExt(this.builder, value, target, name); }
        else if kind == MIRCastKind::FPTrunc { return LLVMBuildFPTrunc(this.builder, value, target, name); }
        else if kind == MIRCastKind::FPExt { return LLVMBuildFPExt(this.builder, value, target, name); }
        else if kind == MIRCastKind::FPToSI { return LLVMBuildFPToSI(this.builder, value, target, name); }
        else if kind == MIRCastKind::FPToUI { return LLVMBuildFPToUI(this.builder, value, target, name); }
        else if kind == MIRCastKind::SIToFP { return LLVMBuildSIToFP(this.builder, value, target, name); }
        else if kind == MIRCastKind::UIToFP { return LLVMBuildUIToFP(this.builder, value, target, name); }
        else if kind == MIRCastKind::PtrToInt { return LLVMBuildPtrToInt(this.builder, value, target, name); }
        else if kind == MIRCastKind::IntToPtr { return LLVMBuildIntToPtr(this.builder, value, target, name); }
        else if kind == MIRCastKind::Bitcast { return LLVMBuildBitCast(this.builder, value, target, name); }
        else { return null; }
    }

    fn LowerSelectInstruction(&mut this, select: *MIRSelectInstruction) -> LLVMValueRef {
        let condition = this.LowerValue(select->condition);
        if condition == null { return null; }
        let then_value = this.LowerValue(select->then_value);
        if then_value == null { return null; }
        let else_value = this.LowerValue(select->else_value);
        if else_value == null { return null; }
        return LLVMBuildSelect(this.builder, condition, then_value, else_value, select->name.Data());
    }

    fn LowerPhiInstruction(&mut this, phi: *MIRPhiInstruction) -> LLVMValueRef {
        let _type = this.LowerType(phi->_type);
        if _type == null { return null; }
        let lowered = LLVMBuildPhi(this.builder, _type, phi->name.Data());
        this.phis[phi] = lowered;
        return lowered;
    }

    fn LowerAssemblyInstruction(&mut this, assembly: *MIRAssemblyInstruction) -> LLVMValueRef {
        let mut constraints = String();
        let mut parameters = Vector<LLVMTypeRef>();
        let mut _return = LLVMVoidTypeInContext(this.context);
        let mut inputs = Vector<LLVMValueRef>();
        let mut output: LLVMValueRef = null;

        for input in assembly->inputs {
            if !constraints.Empty() { constraints += ","; }
            constraints += '{' + input->name + '}';
            let _type = this.LowerType(input->value->_type);
            if _type == null { return null; }
            parameters.PushBack(_type);
            let value = this.LowerValue(input->value);
            if value == null { return null; }
            inputs.PushBack(value);
        }

        for _output in assembly->outputs {
            if !constraints.Empty() { constraints += ","; }
            constraints += "={" + _output->name + '}';
            _return = this.LowerType((_output->value->_type as *MIRPointerType)->pointee);
            if _return == null { return null; }
            output = this.LowerValue(_output->value);
            if output == null { return null; }
        }

        for clobber in assembly->clobbers {
            if !constraints.Empty() { constraints += ","; }
            constraints += "~{" + clobber + '}';
        }

        let _type = LLVMFunctionType(_return, parameters.Empty() ? null : parameters.Data(), parameters.Size() as u32, 0);
        let inline = LLVMGetInlineAsm(_type, assembly->text.Data(), assembly->text.Length(), constraints.Data(), constraints.Length(), assembly->_volatile as i32, 0, LLVMInlineAsmDialect::LLVMInlineAsmDialectATT, 0);
        let result = LLVMBuildCall2(this.builder, _type, inline, inputs.Empty() ? null : inputs.Data(), inputs.Size() as u32, "");

        if output != null {
            LLVMBuildStore(this.builder, result, output);
        } return null;
    }

    fn LowerTerminator(&mut this, terminator: *MIRTerminator) -> LLVMValueRef {
        if terminator->kind == MIRTerminatorKind::Return {
            return this.LowerReturnInstruction(terminator as *MIRReturnInstruction);
        } else if terminator->kind == MIRTerminatorKind::Branch {
            return this.LowerBranchInstruction(terminator as *MIRBranchInstruction);
        } else if terminator->kind == MIRTerminatorKind::ConditionalBranch {
            return this.LowerConditionalBranchInstruction(terminator as *MIRConditionalBranchInstruction);
        } else if terminator->kind == MIRTerminatorKind::Unreachable {
            return this.LowerUnreachableInstruction(terminator as *MIRUnreachableInstruction);
        } else {
            return null;
        }
    }

    fn LowerReturnInstruction(&mut this, _return: *MIRReturnInstruction) -> LLVMValueRef {
        if _return->value != null {
            let value = this.LowerValue(_return->value);
            if value == null { return null; }
            return LLVMBuildRet(this.builder, value);
        } else {
            return LLVMBuildRetVoid(this.builder);
        }
    }

    fn LowerBranchInstruction(&mut this, branch: *MIRBranchInstruction) -> LLVMValueRef {
        let target = this.blocks.Get(branch->target, null);
        if target == null { return null; }
        return LLVMBuildBr(this.builder, target);
    }

    fn LowerConditionalBranchInstruction(&mut this, branch: *MIRConditionalBranchInstruction) -> LLVMValueRef {
        let condition = this.LowerValue(branch->condition);
        if condition == null { return null; }
        let then_target = this.blocks.Get(branch->then_target, null);
        if then_target == null { return null; }
        let else_target = this.blocks.Get(branch->else_target, null);
        if else_target == null { return null; }
        return LLVMBuildCondBr(this.builder, condition, then_target, else_target);
    }

    fn LowerUnreachableInstruction(&mut this, unreachable: *MIRUnreachableInstruction) -> LLVMValueRef {
        return LLVMBuildUnreachable(this.builder);
    }

    fn LowerFunctionType(&mut this, function: *MIRFunctionType) -> LLVMTypeRef {
        let mut parameters = Vector<LLVMTypeRef>();

        for parameter in function->parameters {
            let lowered_parameter = this.LowerType(parameter);
            if lowered_parameter == null { return null; }
            parameters.PushBack(lowered_parameter);
        }

        let _return = this.LowerType(function->_return);
        if _return == null { return null; }
        return LLVMFunctionType(_return, parameters.Data(), parameters.Size() as u32, 0);
    }

    fn LowerType(&mut this, _type: *MIRType) -> LLVMTypeRef {
        if _type->kind == MIRTypeKind::Void {
            return LLVMVoidTypeInContext(this.context);
        } else if _type->kind == MIRTypeKind::Integer {
            return LLVMIntTypeInContext(this.context, (_type as *MIRIntegerType)->width);
        } else if _type->kind == MIRTypeKind::Float {
            if (_type as *MIRFloatType)->width == 64 {
                return LLVMDoubleTypeInContext(this.context);
            } else {
                return LLVMFloatTypeInContext(this.context);
            }
        } else if _type->kind == MIRTypeKind::Pointer {
            let pointer = _type as *MIRPointerType;
            let pointee = this.LowerType(pointer->pointee);
            if pointee == null { return null; }
            return LLVMPointerType(pointee, 0);
        } else if _type->kind == MIRTypeKind::Array {
            let array = _type as *MIRArrayType;
            let element = this.LowerType(array->element);
            if element == null { return null; }
            return LLVMArrayType2(element, array->length as u64);
        } else if _type->kind == MIRTypeKind::Structure {
            if this.types.Has(_type) {
                return this.types[_type];
            } else {
                let mut fields = Vector<LLVMTypeRef>();

                for field in (_type as *MIRStructureType)->fields {
                    let lowered_field = this.LowerType(field);
                    if lowered_field == null { return null; }
                    fields.PushBack(lowered_field);
                }

                return LLVMStructTypeInContext(this.context, fields.Data(), fields.Size() as u32, 0);
            }
        } else if _type->kind == MIRTypeKind::Function {
            return LLVMPointerType(this.LowerFunctionType(_type as *MIRFunctionType), 0);
        } else {
            return null;
        }
    }
}

static mut llvm_lowerer: *mut LLVMLowerer = null;
