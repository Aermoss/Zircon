#[include "std/str", "std/vec", "std/map", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Analysis.zir",
    "src/Target.zir", "src/MIR.zir", "src/Logger.zir" : *]

class LLVMLowerer {
    module: LLVMModuleRef = null,
    builder: LLVMBuilderRef = null,
    pub context: LLVMContextRef,
    pub target: *Target,

    types: Map<*MIRType, LLVMTypeRef>,
    declarations: Map<*MIRDeclaration, LLVMValueRef>,
    phis: Map<*MIRPhiInstruction, LLVMValueRef>,
    blocks: Map<*MIRBlock, LLVMBasicBlockRef>,
    values: Map<*MIRValue, LLVMValueRef>,

    freestanding: bool,
    no_red_zone: bool;

    LLVMLowerer(&mut this, target: &Target, freestanding: bool, no_red_zone: bool) {
        if llvm_lowerer != null {
            Logger::Log("Another instance of 'LLVMLowerer' already exists!", LogSeverity::Fatal);
        } llvm_lowerer = this;

        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
        (this.context, this.target) = (LLVMContextCreate(), target);
    }

    ~LLVMLowerer(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        LLVMContextDispose(this.context);
        llvm_lowerer = null;
    }

    pub fn Lower(&mut this, module: *MIRModule) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());

        if module != null {
            this.LowerModule(module);
        }

        let mut message: *mut i8 = null;

        if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
            let final_message = if message != null { message } else { "Unknown reason." };
            Logger::Log("Module verification failed: " + final_message.ToString(), LogSeverity::Error);

            if message != null {
                LLVMDisposeMessage(message);
            } return this.module;
        }

        if message != null {
            LLVMDisposeMessage(message);
        }

        this.module
    }

    fn LowerModule(&mut this, module: *MIRModule) {
        for declaration in module->declarations {
            this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFifthPass(declaration);
        }
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *MIRDeclaration) {
        match declaration->kind {
            MIRDeclarationKind::Type => {
                this.LowerTypeDeclarationFirstPass(declaration as *MIRTypeDeclaration);
            },
            MIRDeclarationKind::Assembly => {
                this.LowerAssemblyDeclaration(declaration as *MIRAssemblyDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Type {
            this.LowerTypeDeclarationSecondPass(declaration as *MIRTypeDeclaration);
        }
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *MIRDeclaration) {
        match declaration->kind {
            MIRDeclarationKind::Constant => {
                this.LowerConstantDeclarationFirstPass(declaration as *MIRConstantDeclaration);
            },
            MIRDeclarationKind::Static => {
                this.LowerStaticDeclarationFirstPass(declaration as *MIRStaticDeclaration);
            },
            MIRDeclarationKind::Function => {
                this.LowerFunctionDeclarationFirstPass(declaration as *MIRFunctionDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *MIRDeclaration) {
        match declaration->kind {
            MIRDeclarationKind::Constant => {
                this.LowerConstantDeclarationSecondPass(declaration as *MIRConstantDeclaration);
            },
            MIRDeclarationKind::Static => {
                this.LowerStaticDeclarationSecondPass(declaration as *MIRStaticDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationFifthPass(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Function {
            this.LowerFunctionDeclarationSecondPass(declaration as *MIRFunctionDeclaration);
        }
    }

    fn LowerTypeDeclarationFirstPass(&mut this, _type: *MIRTypeDeclaration) {
        this.types[_type->_type] = LLVMStructCreateNamed(this.context, _type->name.Data());
    }

    fn LowerTypeDeclarationSecondPass(&mut this, _type: *MIRTypeDeclaration) {
        let mut fields = Vector<LLVMTypeRef>();

        for field in (_type->_type as *MIRStructureType)->fields {
            let lowered_field = this.LowerType(field);
            if lowered_field == null { return; }
            fields.PushBack(lowered_field);
        }

        LLVMStructSetBody(this.types[_type->_type], fields.Data(), fields.Length() as u32, 0);
    }

    fn LowerFunctionDeclarationFirstPass(&mut this, function: *MIRFunctionDeclaration) {
        let mut parameters = Vector<LLVMTypeRef>();

        for parameter in function->parameters {
            let lowered_parameter = this.LowerType(parameter->_type);
            if lowered_parameter == null { return; }
            parameters.PushBack(lowered_parameter);
        }

        let _return = this.LowerType(function->_return);
        if _return == null { return; }
        let var_arg = (function->_type as *MIRFunctionType)->var_arg as i32;
        let value = LLVMAddFunction(this.module, function->name.Data(), LLVMFunctionType(_return, parameters.Data(), parameters.Length() as u32, var_arg));
        this.declarations[function] = value;

        for parameter in function->parameters {
            if parameter->sret != null {
                LLVMAddAttributeAtIndex(value, (parameter->index + 1) as LLVMAttributeIndex, LLVMCreateTypeAttribute(this.context, LLVMGetEnumAttributeKindForName("sret", 4), this.LowerType(parameter->sret)));
            } else if parameter->byval != null {
                LLVMAddAttributeAtIndex(value, (parameter->index + 1) as LLVMAttributeIndex, LLVMCreateTypeAttribute(this.context, LLVMGetEnumAttributeKindForName("byval", 5), this.LowerType(parameter->byval)));
            }
        }

        if this.freestanding || true {
            let attribute = LLVMCreateStringAttribute(this.context, "no-stack-arg-probe", 18, "", 0);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if this.no_red_zone {
            let attribute = LLVMCreateEnumAttribute(this.context, LLVMGetEnumAttributeKindForName("noredzone", 9), 0);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if !this.target->features.Empty() {
            let attribute = LLVMCreateStringAttribute(this.context, "target-features", 15, this.target->features.Data(), this.target->features.Length() as u32);
            LLVMAddAttributeAtIndex(value, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }
    }

    fn LowerFunctionDeclarationSecondPass(&mut this, function: *MIRFunctionDeclaration) {
        if function->blocks.Empty() { return; }
        let value = this.declarations[function];
        this.values.Clear();

        for parameter in function->parameters {
            let lowered_parameter = LLVMGetParam(value, parameter->index);
            LLVMSetValueName2(lowered_parameter, parameter->name.Data(), parameter->name.Length());
            this.values[parameter] = lowered_parameter;
        }

        this.blocks.Clear();

        for block in function->blocks {
            this.blocks[block] = LLVMAppendBasicBlockInContext(this.context, value, block->name.Data());
        }

        this.phis.Clear();

        for block in function->blocks {
            LLVMPositionBuilderAtEnd(this.builder, this.blocks[block]);

            for instruction in block->instructions {
                this.values[instruction] = this.LowerInstruction(instruction);
            }

            if block->terminator != null {
                this.LowerTerminator(block->terminator);
            }
        }

        for (phi, lowered) in this.phis {
            for incoming in phi->incomings {
                let mut value = this.LowerValue(incoming.value);
                if value == null { continue; }
                let mut block = this.blocks.Get(incoming.block, null);
                if block == null { continue; }
                LLVMAddIncoming(lowered, &mut value, &mut block, 1);
            }
        }
    }

    fn LowerConstantDeclarationFirstPass(&mut this, constant: *MIRConstantDeclaration) {
        let _type = this.LowerType(constant->_type);
        if _type == null { return; }
        let global = LLVMAddGlobal(this.module, _type, constant->name.Data());
        this.declarations[constant] = global;
        LLVMSetGlobalConstant(global, 1);
    }

    fn LowerConstantDeclarationSecondPass(&mut this, constant: *MIRConstantDeclaration) {
        let initializer = this.LowerValue(constant->initializer);
        if initializer == null { return; }
        LLVMSetInitializer(this.declarations[constant], initializer);
    }

    fn LowerLinkage(&mut this, linkage: MIRDeclarationLinkage) -> LLVMLinkage {
        match linkage {
            MIRDeclarationLinkage::Private => LLVMLinkage::LLVMPrivateLinkage,
            MIRDeclarationLinkage::Internal => LLVMLinkage::LLVMInternalLinkage,
            _ => LLVMLinkage::LLVMExternalLinkage
        }
    }

    fn LowerStaticDeclarationFirstPass(&mut this, _static: *MIRStaticDeclaration) {
        let _type = this.LowerType(_static->_type);
        if _type == null { return; }
        let global = LLVMAddGlobal(this.module, _type, _static->name.Data());
        LLVMSetLinkage(global, this.LowerLinkage(_static->linkage));
        LLVMSetGlobalConstant(global, if !_static->mutable { 1 } else { 0 });
        this.declarations[_static] = global;
    }

    fn LowerStaticDeclarationSecondPass(&mut this, _static: *MIRStaticDeclaration) {
        if _static->initializer == null { return; }
        let initializer = this.LowerValue(_static->initializer);
        if initializer == null { return; }
        LLVMSetInitializer(this.declarations[_static], initializer);
    }

    fn LowerAssemblyDeclaration(&mut this, assembly: *MIRAssemblyDeclaration) {
        LLVMAppendModuleInlineAsm(this.module, assembly->text.Data(), assembly->text.Length());
    }

    fn LowerValue(&mut this, value: *MIRValue) -> LLVMValueRef {
        match value->kind {
            MIRValueKind::Constant => this.LowerConstant(value as *MIRConstant),
            MIRValueKind::Instruction | MIRValueKind::Parameter => this.values.Get(value, null),
            MIRValueKind::DeclarationReference => this.declarations.Get((value as *MIRDeclarationReference)->declaration, null)
        }
    }

    fn LowerConstant(&mut this, constant: *MIRConstant) -> LLVMValueRef {
        let _type = this.LowerType(constant->_type);
        if _type == null { return null; }

        match constant->kind {
            MIRConstantKind::Integer => LLVMConstInt(_type, (constant as *MIRConstantInteger)->value, 0),
            MIRConstantKind::Float => LLVMConstReal(_type, (constant as *MIRConstantFloat)->value),
            MIRConstantKind::String => {
                let value = (constant as *MIRConstantString)->value;
                LLVMConstStringInContext2(this.context, value.Data(), value.Length(), 0)
            },
            MIRConstantKind::Array => {
                let mut elements = Vector<LLVMValueRef>();

                for element in (constant as *MIRConstantArray)->elements {
                    let lowered_element = this.LowerValue(element);
                    if lowered_element == null { return null; }
                    elements.PushBack(lowered_element);
                }

                let _type = this.LowerType((constant->_type as *MIRArrayType)->element);
                if _type == null { return null; }
                LLVMConstArray2(_type, elements.Data(), elements.Length() as u64)
            },
            MIRConstantKind::Structure => {
                let mut fields = Vector<LLVMValueRef>();

                for field in (constant as *MIRConstantStructure)->fields {
                    let lowered_field = this.LowerValue(field);
                    if lowered_field == null { return null; }
                    fields.PushBack(lowered_field);
                }

                LLVMConstNamedStruct(_type, fields.Data(), fields.Length() as u32)
            },
            MIRConstantKind::Null => LLVMConstNull(_type),
            MIRConstantKind::Undef => LLVMGetUndef(_type),
            MIRConstantKind::Expression => this.LowerConstantExpression(constant as *MIRConstantExpression)
        }
    }

    fn LowerConstantExpression(&mut this, expression: *MIRConstantExpression) -> LLVMValueRef {
        match expression->kind {
            MIRConstantExpressionKind::Unary => this.LowerUnaryExpression(expression as *MIRUnaryExpression),
            MIRConstantExpressionKind::Binary => this.LowerBinaryExpression(expression as *MIRBinaryExpression),
            MIRConstantExpressionKind::Cast => this.LowerCastExpression(expression as *MIRCastExpression),
            MIRConstantExpressionKind::ArrayGEP => this.LowerArrayGEPExpression(expression as *MIRArrayGEPExpression),
            MIRConstantExpressionKind::StructGEP => this.LowerStructGEPExpression(expression as *MIRStructGEPExpression)
        }
    }

    fn LowerUnaryExpression(&mut this, unary: *MIRUnaryExpression) -> LLVMValueRef {
        let operand = this.LowerValue(unary->operand);
        if operand == null { return null; }
        this.LowerResolvedUnary(unary->kind, operand, "")
    }

    fn LowerBinaryExpression(&mut this, binary: *MIRBinaryExpression) -> LLVMValueRef {
        let left = this.LowerValue(binary->left);
        if left == null { return null; }
        let right = this.LowerValue(binary->right);
        if right == null { return null; }
        this.LowerResolvedBinary(binary->kind, left, right, "")
    }

    fn LowerCastExpression(&mut this, cast: *MIRCastExpression) -> LLVMValueRef {
        let target = this.LowerType(cast->_type);
        if target == null { return null; }
        let value = this.LowerValue(cast->value);
        if value == null { return null; }
        this.LowerResolvedCast(cast->kind, value, target, "")
    }

    fn LowerArrayGEPExpression(&mut this, gep: *MIRArrayGEPExpression) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        let mut index = this.LowerValue(gep->index);
        if index == null { return null; }
        LLVMBuildGEP2(this.builder, _type, pointer, &mut index, 1, "")
    }

    fn LowerStructGEPExpression(&mut this, gep: *MIRStructGEPExpression) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        LLVMBuildStructGEP2(this.builder, _type, pointer, gep->index, "")
    }

    fn LowerInstruction(&mut this, instruction: *MIRInstruction) -> LLVMValueRef {
        match instruction->kind {
            MIRInstructionKind::Alloca => this.LowerAllocaInstruction(instruction as *MIRAllocaInstruction),
            MIRInstructionKind::Load => this.LowerLoadInstruction(instruction as *MIRLoadInstruction),
            MIRInstructionKind::Store => this.LowerStoreInstruction(instruction as *MIRStoreInstruction),
            MIRInstructionKind::ArrayGEP => this.LowerArrayGEPInstruction(instruction as *MIRArrayGEPInstruction),
            MIRInstructionKind::StructGEP => this.LowerStructGEPInstruction(instruction as *MIRStructGEPInstruction),
            MIRInstructionKind::Unary => this.LowerUnaryInstruction(instruction as *MIRUnaryInstruction),
            MIRInstructionKind::Binary => this.LowerBinaryInstruction(instruction as *MIRBinaryInstruction),
            MIRInstructionKind::Call => this.LowerCallInstruction(instruction as *MIRCallInstruction),
            MIRInstructionKind::Cast => this.LowerCastInstruction(instruction as *MIRCastInstruction),
            MIRInstructionKind::Select => this.LowerSelectInstruction(instruction as *MIRSelectInstruction),
            MIRInstructionKind::Phi => this.LowerPhiInstruction(instruction as *MIRPhiInstruction),
            MIRInstructionKind::Assembly => this.LowerAssemblyInstruction(instruction as *MIRAssemblyInstruction),
            MIRInstructionKind::Terminator => this.LowerTerminator(instruction as *MIRTerminator)
        }
    }

    fn LowerAllocaInstruction(&mut this, alloca: *MIRAllocaInstruction) -> LLVMValueRef {
        let _type = this.LowerType(alloca->_type);
        if _type == null { return null; }
        LLVMBuildAlloca(this.builder, _type, alloca->name.Data())
    }

    fn LowerLoadInstruction(&mut this, load: *MIRLoadInstruction) -> LLVMValueRef {
        let _type = this.LowerType(load->_type);
        if _type == null { return null; }
        let pointer = this.LowerValue(load->pointer);
        if pointer == null { return null; }
        let result = LLVMBuildLoad2(this.builder, _type, pointer, load->name.Data());
        if load->alignment != 0 { LLVMSetAlignment(result, load->alignment); }
        result
    }

    fn LowerStoreInstruction(&mut this, store: *MIRStoreInstruction) -> LLVMValueRef {
        let value = this.LowerValue(store->value);
        if value == null { return null; }
        let pointer = this.LowerValue(store->pointer);
        if pointer == null { return null; }
        let result = LLVMBuildStore(this.builder, value, pointer);
        if store->alignment != 0 { LLVMSetAlignment(result, store->alignment); }
        result
    }

    fn LowerArrayGEPInstruction(&mut this, gep: *MIRArrayGEPInstruction) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        let mut index = this.LowerValue(gep->index);
        if index == null { return null; }
        LLVMBuildGEP2(this.builder, _type, pointer, &mut index, 1, gep->name.Data())
    }

    fn LowerStructGEPInstruction(&mut this, gep: *MIRStructGEPInstruction) -> LLVMValueRef {
        let _type = this.LowerType((gep->pointer->_type as *MIRPointerType)->pointee);
        if _type == null { return null; }
        let pointer = this.LowerValue(gep->pointer);
        if pointer == null { return null; }
        LLVMBuildStructGEP2(this.builder, _type, pointer, gep->index, gep->name.Data())
    }

    fn LowerUnaryInstruction(&mut this, unary: *MIRUnaryInstruction) -> LLVMValueRef {
        let operand = this.LowerValue(unary->operand);
        if operand == null { return null; }
        this.LowerResolvedUnary(unary->kind, operand, unary->name.Data())
    }

    fn LowerResolvedUnary(&mut this, kind: MIRUnaryKind, operand: LLVMValueRef, name: *i8) -> LLVMValueRef {
        match kind {
            MIRUnaryKind::Neg => LLVMBuildNeg(this.builder, operand, name),
            MIRUnaryKind::FNeg => LLVMBuildFNeg(this.builder, operand, name),
            MIRUnaryKind::Not => LLVMBuildNot(this.builder, operand, name)
        }
    }

    fn LowerBinaryInstruction(&mut this, binary: *MIRBinaryInstruction) -> LLVMValueRef {
        let left = this.LowerValue(binary->left);
        if left == null { return null; }
        let right = this.LowerValue(binary->right);
        if right == null { return null; }
        this.LowerResolvedBinary(binary->kind, left, right, binary->name.Data())
    }

    fn LowerResolvedBinary(&mut this, kind: MIRBinaryKind, left: LLVMValueRef, right: LLVMValueRef, name: *i8) -> LLVMValueRef {
        match kind {
            MIRBinaryKind::Add => LLVMBuildAdd(this.builder, left, right, name),
            MIRBinaryKind::Sub => LLVMBuildSub(this.builder, left, right, name),
            MIRBinaryKind::Mul => LLVMBuildMul(this.builder, left, right, name),
            MIRBinaryKind::SDiv => LLVMBuildSDiv(this.builder, left, right, name),
            MIRBinaryKind::UDiv => LLVMBuildUDiv(this.builder, left, right, name),
            MIRBinaryKind::SRem => LLVMBuildSRem(this.builder, left, right, name),
            MIRBinaryKind::URem => LLVMBuildURem(this.builder, left, right, name),
            MIRBinaryKind::And => LLVMBuildAnd(this.builder, left, right, name),
            MIRBinaryKind::Or => LLVMBuildOr(this.builder, left, right, name),
            MIRBinaryKind::Xor => LLVMBuildXor(this.builder, left, right, name),
            MIRBinaryKind::Shl => LLVMBuildShl(this.builder, left, right, name),
            MIRBinaryKind::LShr => LLVMBuildLShr(this.builder, left, right, name),
            MIRBinaryKind::AShr => LLVMBuildAShr(this.builder, left, right, name),
            MIRBinaryKind::FAdd => LLVMBuildFAdd(this.builder, left, right, name),
            MIRBinaryKind::FSub => LLVMBuildFSub(this.builder, left, right, name),
            MIRBinaryKind::FMul => LLVMBuildFMul(this.builder, left, right, name),
            MIRBinaryKind::FDiv => LLVMBuildFDiv(this.builder, left, right, name),
            MIRBinaryKind::FRem => LLVMBuildFRem(this.builder, left, right, name),
            MIRBinaryKind::ICmpEq => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left, right, name),
            MIRBinaryKind::ICmpNe => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left, right, name),
            MIRBinaryKind::ICmpSlt => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSLT, left, right, name),
            MIRBinaryKind::ICmpSgt => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSGT, left, right, name),
            MIRBinaryKind::ICmpSle => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSLE, left, right, name),
            MIRBinaryKind::ICmpSge => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntSGE, left, right, name),
            MIRBinaryKind::ICmpUlt => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, left, right, name),
            MIRBinaryKind::ICmpUgt => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGT, left, right, name),
            MIRBinaryKind::ICmpUle => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULE, left, right, name),
            MIRBinaryKind::ICmpUge => LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGE, left, right, name),
            MIRBinaryKind::FCmpEq => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOEQ, left, right, name),
            MIRBinaryKind::FCmpNe => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealUNE, left, right, name),
            MIRBinaryKind::FCmpLt => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, left, right, name),
            MIRBinaryKind::FCmpGt => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGT, left, right, name),
            MIRBinaryKind::FCmpLe => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, left, right, name),
            MIRBinaryKind::FCmpGe => LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGE, left, right, name)
        }
    }

    fn LowerCallInstruction(&mut this, call: *MIRCallInstruction) -> LLVMValueRef {
        let _type = this.LowerFunctionType(call->callee->_type as *MIRFunctionType);
        if _type == null { return null; }
        let callee = this.LowerValue(call->callee);
        if callee == null { return null; }
        let mut arguments = Vector<LLVMValueRef>();

        for argument in call->arguments {
            let lowered_argument = this.LowerValue(argument);
            if lowered_argument == null { return null; }
            arguments.PushBack(lowered_argument);
        }

        let result = LLVMBuildCall2(this.builder, _type, callee, arguments.Data(), arguments.Length() as u32, call->name.Data());

        if call->sret != null {
            LLVMAddCallSiteAttribute(result, 1 as LLVMAttributeIndex, LLVMCreateTypeAttribute(this.context, LLVMGetEnumAttributeKindForName("sret", 4), this.LowerType(call->sret)));
        }

        result
    }

    fn LowerCastInstruction(&mut this, cast: *MIRCastInstruction) -> LLVMValueRef {
        let target = this.LowerType(cast->_type);
        if target == null { return null; }
        let value = this.LowerValue(cast->value);
        if value == null { return null; }
        this.LowerResolvedCast(cast->kind, value, target, cast->name.Data())
    }

    fn LowerResolvedCast(&mut this, kind: MIRCastKind, value: LLVMValueRef, target: LLVMTypeRef, name: *i8) -> LLVMValueRef {
        match kind {
            MIRCastKind::Trunc => LLVMBuildTrunc(this.builder, value, target, name),
            MIRCastKind::ZExt => LLVMBuildZExt(this.builder, value, target, name),
            MIRCastKind::SExt => LLVMBuildSExt(this.builder, value, target, name),
            MIRCastKind::FPTrunc => LLVMBuildFPTrunc(this.builder, value, target, name),
            MIRCastKind::FPExt => LLVMBuildFPExt(this.builder, value, target, name),
            MIRCastKind::FPToSI => this.LowerSaturatingCast(value, target, true, name),
            MIRCastKind::FPToUI => this.LowerSaturatingCast(value, target, false, name),
            MIRCastKind::SIToFP => LLVMBuildSIToFP(this.builder, value, target, name),
            MIRCastKind::UIToFP => LLVMBuildUIToFP(this.builder, value, target, name),
            MIRCastKind::PtrToInt => LLVMBuildPtrToInt(this.builder, value, target, name),
            MIRCastKind::IntToPtr => LLVMBuildIntToPtr(this.builder, value, target, name),
            MIRCastKind::Bitcast => LLVMBuildBitCast(this.builder, value, target, name)
        }
    }

    fn LowerSaturatingCast(&mut this, mut value: LLVMValueRef, target: LLVMTypeRef, signed: bool, name: *i8) -> LLVMValueRef {
        if LLVMIsAConstantFP(value) != null {
            let mut loses_info = 0;
            let number = LLVMConstRealGetDouble(value, &mut loses_info);
            let width = LLVMGetIntTypeWidth(target);
            let limit = (1u64 << (width - 1)) - 1;
            let half = (1u64 << (width - 1)) as f64;

            if signed {
                let result = if number != number {
                    0
                } else if number >= half {
                    limit as i64
                } else if number <= -half {
                    -(limit as i64) - 1
                } else {
                    number as i64
                };

                return LLVMConstInt(target, result as u64, 1);
            }

            let result = if number != number || number <= 0.0 {
                0
            } else if number >= half * 2.0 {
                limit * 2 + 1
            } else {
                number as u64
            };

            return LLVMConstInt(target, result, 0);
        }

        if LLVMIsConstant(value) != 0 {
            return if signed {
                LLVMBuildFPToSI(this.builder, value, target, name)
            } else {
                LLVMBuildFPToUI(this.builder, value, target, name)
            };
        }

        let mut types = [target, LLVMTypeOf(value)];
        let intrinsic = (if signed { "llvm.fptosi.sat" } else { "llvm.fptoui.sat" }).ToString();
        let id = LLVMLookupIntrinsicID(intrinsic.Data(), intrinsic.Length());
        let function = LLVMGetIntrinsicDeclaration(this.module, id, &mut types[0], 2);
        let _type = LLVMIntrinsicGetType(this.context, id, &mut types[0], 2);
        LLVMBuildCall2(this.builder, _type, function, &mut value, 1, name)
    }

    fn LowerSelectInstruction(&mut this, select: *MIRSelectInstruction) -> LLVMValueRef {
        let condition = this.LowerValue(select->condition);
        if condition == null { return null; }
        let then_value = this.LowerValue(select->then_value);
        if then_value == null { return null; }
        let else_value = this.LowerValue(select->else_value);
        if else_value == null { return null; }
        LLVMBuildSelect(this.builder, condition, then_value, else_value, select->name.Data())
    }

    fn LowerPhiInstruction(&mut this, phi: *MIRPhiInstruction) -> LLVMValueRef {
        let _type = this.LowerType(phi->_type);
        if _type == null { return null; }
        let lowered = LLVMBuildPhi(this.builder, _type, phi->name.Data());
        this.phis[phi] = lowered;
        lowered
    }

    fn LowerAssemblyInstruction(&mut this, assembly: *MIRAssemblyInstruction) -> LLVMValueRef {
        let mut constraints = String();
        let mut parameters = Vector<LLVMTypeRef>();
        let mut _return = LLVMVoidTypeInContext(this.context);
        let mut inputs = Vector<LLVMValueRef>();
        let mut output: LLVMValueRef = null;

        for input in assembly->inputs {
            if !constraints.Empty() { constraints += ","; }
            constraints += '{' + input->name + '}';
            let _type = this.LowerType(input->value->_type);
            if _type == null { return null; }
            parameters.PushBack(_type);
            let value = this.LowerValue(input->value);
            if value == null { return null; }
            inputs.PushBack(value);
        }

        for _output in assembly->outputs {
            if !constraints.Empty() { constraints += ","; }
            constraints += "={" + _output->name + '}';
            _return = this.LowerType((_output->value->_type as *MIRPointerType)->pointee);
            if _return == null { return null; }
            output = this.LowerValue(_output->value);
            if output == null { return null; }
        }

        for clobber in assembly->clobbers {
            if !constraints.Empty() { constraints += ","; }
            constraints += "~{" + clobber + '}';
        }

        let _type = LLVMFunctionType(_return, if parameters.Empty() { null } else { parameters.Data() }, parameters.Length() as u32, 0);
        let inline = LLVMGetInlineAsm(_type, assembly->text.Data(), assembly->text.Length(), constraints.Data(), constraints.Length(), assembly->_volatile as i32, 0, LLVMInlineAsmDialect::LLVMInlineAsmDialectATT, 0);
        let result = LLVMBuildCall2(this.builder, _type, inline, if inputs.Empty() { null } else { inputs.Data() }, inputs.Length() as u32, "");

        if output != null {
            LLVMBuildStore(this.builder, result, output);
        }

        null
    }

    fn LowerTerminator(&mut this, terminator: *MIRTerminator) -> LLVMValueRef {
        match terminator->kind {
            MIRTerminatorKind::Return => this.LowerReturnInstruction(terminator as *MIRReturnInstruction),
            MIRTerminatorKind::Branch => this.LowerBranchInstruction(terminator as *MIRBranchInstruction),
            MIRTerminatorKind::ConditionalBranch => this.LowerConditionalBranchInstruction(terminator as *MIRConditionalBranchInstruction),
            MIRTerminatorKind::Unreachable => this.LowerUnreachableInstruction(terminator as *MIRUnreachableInstruction)
        }
    }

    fn LowerReturnInstruction(&mut this, _return: *MIRReturnInstruction) -> LLVMValueRef {
        if _return->value != null {
            let value = this.LowerValue(_return->value);
            if value == null { return null; }
            LLVMBuildRet(this.builder, value)
        } else {
            LLVMBuildRetVoid(this.builder)
        }
    }

    fn LowerBranchInstruction(&mut this, branch: *MIRBranchInstruction) -> LLVMValueRef {
        let target = this.blocks.Get(branch->target, null);
        if target == null { return null; }
        LLVMBuildBr(this.builder, target)
    }

    fn LowerConditionalBranchInstruction(&mut this, branch: *MIRConditionalBranchInstruction) -> LLVMValueRef {
        let condition = this.LowerValue(branch->condition);
        if condition == null { return null; }
        let then_target = this.blocks.Get(branch->then_target, null);
        if then_target == null { return null; }
        let else_target = this.blocks.Get(branch->else_target, null);
        if else_target == null { return null; }
        LLVMBuildCondBr(this.builder, condition, then_target, else_target)
    }

    fn LowerUnreachableInstruction(&mut this, unreachable: *MIRUnreachableInstruction) -> LLVMValueRef {
        LLVMBuildUnreachable(this.builder)
    }

    fn LowerFunctionType(&mut this, function: *MIRFunctionType) -> LLVMTypeRef {
        let mut parameters = Vector<LLVMTypeRef>();

        for parameter in function->parameters {
            let lowered_parameter = this.LowerType(parameter);
            if lowered_parameter == null { return null; }
            parameters.PushBack(lowered_parameter);
        }

        let _return = this.LowerType(function->_return);
        if _return == null { return null; }
        LLVMFunctionType(_return, parameters.Data(), parameters.Length() as u32, function->var_arg as i32)
    }

    fn LowerType(&mut this, _type: *MIRType) -> LLVMTypeRef {
        match _type->kind {
            MIRTypeKind::Void => LLVMVoidTypeInContext(this.context),
            MIRTypeKind::Integer => LLVMIntTypeInContext(this.context, (_type as *MIRIntegerType)->width),
            MIRTypeKind::Float => {
                if (_type as *MIRFloatType)->width == 64 {
                    LLVMDoubleTypeInContext(this.context)
                } else {
                    LLVMFloatTypeInContext(this.context)
                }
            },
            MIRTypeKind::Pointer => LLVMPointerTypeInContext(this.context, 0),
            MIRTypeKind::Array => {
                let array = _type as *MIRArrayType;
                let element = this.LowerType(array->element);
                if element == null { return null; }
                LLVMArrayType2(element, array->length as u64)
            },
            MIRTypeKind::Structure => {
                if this.types.Has(_type) {
                    this.types[_type]
                } else {
                    let mut fields = Vector<LLVMTypeRef>();

                    for field in (_type as *MIRStructureType)->fields {
                        let lowered_field = this.LowerType(field);
                        if lowered_field == null { return null; }
                        fields.PushBack(lowered_field);
                    }

                    LLVMStructTypeInContext(this.context, fields.Data(), fields.Length() as u32, 0)
                }
            },
            MIRTypeKind::Function => LLVMPointerTypeInContext(this.context, 0)
        }
    }
}

static mut llvm_lowerer: *mut LLVMLowerer = null;
