#[include "std/str", "std/vec", "std/file", "src/Lexer.zir", "src/Token.zir", "src/Logger.zir" : *]

class Preprocessor {
    pub defines: Vector<String>,
    pub include_paths: Vector<String>,
    included_paths: Vector<String>,
    conditions: Vector<bool>,
    taken: Vector<bool>,
    tokens: Vector<Token>,
    file: String,
    recovering: bool = false,
    index: usize;

    fn Current(&this) -> Token {
        if this.index >= this.tokens.Length() {
            this.tokens[this.tokens.Length() - 1]
        } else {
            this.tokens[this.index]
        }
    }

    fn Peek(&this, offset: usize) -> Token {
        let index = this.index + offset;

        if index >= this.tokens.Length() {
            this.tokens[this.tokens.Length() - 1]
        } else {
            this.tokens[index]
        }
    }

    fn Advance(&mut this) -> Token {
        let token = this.Current();

        if this.index < this.tokens.Length() {
            this.index += 1;
        }

        token
    }

    fn Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            true
        } else {
            false
        }
    }

    fn Expect(&mut this, _type: TokenType) -> Token {
        let token = this.Current();

        if token._type == _type {
            this.Advance();
        } else if !this.recovering {
            Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);
            this.recovering = true;
        }

        token
    }

    pub fn Condition(&this) -> bool {
        for condition in this.conditions {
            if !condition { return false; }
        }

        true
    }

    fn ProcessPrimary(&mut this) -> bool {
        if this.Match(TokenType::TRUE) {
            true
        } else if this.Match(TokenType::FALSE) {
            false
        } else if this.Match(TokenType::LPAREN) {
            let result = this.ProcessExpression();
            this.Expect(TokenType::RPAREN);
            result
        } else {
            let name = this.Expect(TokenType::IDENTIFIER).value;
            this.defines.Contains(name)
        }
    }

    fn ProcessNotExpression(&mut this) -> bool {
        if this.Match(TokenType::NOT) {
            return !this.ProcessNotExpression();
        }

        this.ProcessPrimary()
    }

    fn ProcessAndExpression(&mut this) -> bool {
        let mut result = this.ProcessNotExpression();

        while this.Current()._type == TokenType::AND {
            this.Advance();
            let right = this.ProcessNotExpression();
            result = result && right;
        }

        result
    }

    fn ProcessOrExpression(&mut this) -> bool {
        let mut result = this.ProcessAndExpression();

        while this.Current()._type == TokenType::OR {
            this.Advance();
            let right = this.ProcessAndExpression();
            result = result || right;
        }

        result
    }

    fn ProcessExpression(&mut this) -> bool {
        this.ProcessOrExpression()
    }

    fn FindModuleIn(&this, directory: &String, name: &String) -> (String, bool) {
        let mut path = JoinPath(directory, name);

        if !PathExists(path) {
            return (String(), false);
        }

        if FolderExists(path) {
            path = JoinPath(path, String("Entry.zir"));

            if !PathExists(path) {
                return (String(), true);
            }
        }

        (AbsolutePath(path).Unwrap(), false)
    }

    fn FindModule(&this, name: &String) -> (String, bool) {
        let (path, mut missing_entry) = this.FindModuleIn(SplitPath(this.file).0, name);

        if !path.Empty() {
            return (path, false);
        }

        for include_path in this.include_paths {
            let (path, missing) = this.FindModuleIn(include_path, name);

            if !path.Empty() {
                return (path, false);
            }

            missing_entry |= missing;
        }

        (String(), missing_entry)
    }

    fn IncludeModule(&mut this, token: Token, result: &mut Vector<Token>) {
        let (path, missing_entry) = this.FindModule(token.value);

        if path.Empty() {
            Logger::Log("Module '" + token.value + (if missing_entry { "' entry point not found." } else { "' not found." }), token, LogSeverity::Error);
            return;
        }

        if this.included_paths.Contains(path #[if WINDOWS || DARWIN] .ToLower() #[endif]) {
            return;
        }

        let source = match File::ReadText(path) {
            Result<String, IOError>::Ok(source) => source,
            Result<String, IOError>::Err(error) => {
                Logger::Log("Failed to read module '" + token.value + "': " + error.ToString() + ".", token, LogSeverity::Error);
                return;
            }
        };

        let mut taken = Vector<bool>();
        this.taken.Swap(taken);
        let mut tokens = Vector<Token>();
        this.tokens.Swap(tokens);
        let mut conditions = Vector<bool>();
        this.conditions.Swap(conditions);
        let (index, file) = (this.index, this.file);

        let mut lexer: Lexer;
        result += this.Process(lexer.Lex(source, path), path);
        result.PopBack();

        (this.index, this.file) = (index, file);
        this.conditions.Swap(conditions);
        this.tokens.Swap(tokens);
        this.taken.Swap(taken);
    }

    fn ProcessInclude(&mut this, result: &mut Vector<Token>) {
        loop {
            let token = this.Expect(TokenType::STRING);
            if token._type != TokenType::STRING { return; }

            if this.Condition() {
                this.IncludeModule(token, result);
            }

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        this.Expect(TokenType::COLON);
        this.Expect(TokenType::MUL);
    }

    pub fn ProcessDirective(&mut this, result: &mut Vector<Token>) {
        let token = this.Current();

        if this.Match(TokenType::INCLUDE) {
            this.ProcessInclude(result);
        } else if this.Match(TokenType::IF) {
            let active = this.ProcessExpression();
            this.conditions.PushBack(active);
            this.taken.PushBack(active);
        } else if this.Match(TokenType::ELIF) {
            let active = this.ProcessExpression();

            if this.conditions.Empty() {
                Logger::Log("Unexpected 'elif' directive.", token, LogSeverity::Error);
            } else if this.taken[this.taken.Length() - 1] {
                this.conditions[this.conditions.Length() - 1] = false;
            } else {
                this.conditions[this.conditions.Length() - 1] = active;
                this.taken[this.taken.Length() - 1] = active;
            }
        } else if this.Match(TokenType::ELSE) {
            if this.conditions.Empty() {
                Logger::Log("Unexpected 'else' directive.", token, LogSeverity::Error);
            } else if this.taken[this.taken.Length() - 1] {
                this.conditions[this.conditions.Length() - 1] = false;
            } else {
                this.conditions[this.conditions.Length() - 1] = true;
                this.taken[this.taken.Length() - 1] = true;
            }
        } else if this.Match(TokenType::ENDIF) {
            if !this.conditions.Empty() {
                this.conditions.PopBack();
                this.taken.PopBack();
            } else {
                Logger::Log("Unexpected 'endif' directive.", token, LogSeverity::Error);
            }
        } else if this.Match(TokenType::ERROR) {
            let message = this.Expect(TokenType::STRING);

            if message._type == TokenType::STRING && this.Condition() {
                Logger::Log(message.value, token, LogSeverity::Error);
            }
        } else if this.Match(TokenType::WARNING) {
            let message = this.Expect(TokenType::STRING);

            if message._type == TokenType::STRING && this.Condition() {
                Logger::Log(message.value, token, LogSeverity::Warning);
            }
        } else {
            Logger::Log("Unknown directive: '" + token.value + "'.", token, LogSeverity::Error);
            this.recovering = true;
        }
    }

    pub fn Process(&mut this, tokens: &Vector<Token>, file: &String) -> Vector<Token> {
        (this.tokens, this.index, this.file) = (tokens, 0, AbsolutePath(file).Unwrap());
        this.included_paths.PushBack(this.file #[if WINDOWS || DARWIN] .ToLower() #[endif]);
        let mut result = Vector<Token>();

        loop {
            let token = this.Current();

            if this.Match(TokenType::PREPROCESSOR_START) {
                this.recovering = false;
                this.ProcessDirective(result);

                if this.Current()._type != TokenType::PREPROCESSOR_END {
                    this.Expect(TokenType::PREPROCESSOR_END);

                    while this.Current()._type != TokenType::PREPROCESSOR_END && this.Current()._type != TokenType::PREPROCESSOR_START && this.Current()._type != TokenType::EOF {
                        this.Advance();
                    }
                }

                this.Match(TokenType::PREPROCESSOR_END);
                this.recovering = false;
            } else if token._type != TokenType::EOF {
                if this.Condition() {
                    result.PushBack(token);
                } this.Advance();
            } else {
                if !this.conditions.Empty() {
                    Logger::Log("Expected 'endif' directive.", token, LogSeverity::Error);
                }

                result.PushBack(token);
                break;
            }
        }

        result
    }
}
