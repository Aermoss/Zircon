#[include "std/str", "std/vec", "std/arena", "src/Logger.zir" : *]

enum MIRTypeKind: u8 {
    Void, Integer, Float, Pointer, Array, Structure, Function
}

class MIRType {
    pub kind: MIRTypeKind;

    MIRType(&mut this, kind: MIRTypeKind) {
        this.kind = kind;
    }

    virtual ~MIRType(&mut this) {}

    pub virtual fn ToString(&this) -> String;
}

class MIRVoidType : MIRType {
    MIRVoidType(&mut this) : MIRType(MIRTypeKind::Void) {}

    pub override fn ToString(&this) -> String {
        "void".ToString()
    }
}

class MIRIntegerType : MIRType {
    pub width: u32;

    MIRIntegerType(&mut this, width: u32) : MIRType(MIRTypeKind::Integer) {
        this.width = width;
    }

    pub override fn ToString(&this) -> String {
        'i' + String::FromInteger(this.width as u64)
    }
}

class MIRFloatType : MIRType {
    pub width: u32;

    MIRFloatType(&mut this, width: u32) : MIRType(MIRTypeKind::Float) {
        this.width = width;
    }

    pub override fn ToString(&this) -> String {
        'f' + String::FromInteger(this.width as u64)
    }
}

class MIRPointerType : MIRType {
    pub pointee: *MIRType;

    MIRPointerType(&mut this, pointee: *MIRType) : MIRType(MIRTypeKind::Pointer) {
        this.pointee = pointee;
    }

    pub override fn ToString(&this) -> String {
        '*' + this.pointee->ToString()
    }
}

class MIRArrayType : MIRType {
    pub element: *MIRType,
    pub length: usize;

    MIRArrayType(&mut this, element: *MIRType, length: usize) : MIRType(MIRTypeKind::Array) {
        (this.element, this.length) = (element, length);
    }

    pub override fn ToString(&this) -> String {
        '[' + this.element->ToString() + "; " + String::FromInteger(this.length as u64) + ']'
    }
}

class MIRStructureType : MIRType {
    pub name: String,
    pub fields: Vector<*MIRType>;

    MIRStructureType(&mut this, name: String) : MIRType(MIRTypeKind::Structure) {
        this.name = name;
    }

    MIRStructureType(&mut this, fields: Vector<*MIRType>) : MIRType(MIRTypeKind::Structure) {
        this.fields = fields;
    }

    pub fn SetBody(&mut this, fields: Vector<*MIRType>) {
        this.fields = fields;
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = "{ ".ToString();

        for i in 0..this.fields.Size() {
            if i != 0 { result += ", "; }
            result += this.fields[i]->ToString();
        }

        result + " }"
    }

    pub override fn ToString(&this) -> String {
        if this.name.Empty()  {
            return this.ToDefinitionString();
        }

        '%' + this.name
    }
}

class MIRFunctionType : MIRType {
    pub parameters: Vector<*MIRType>,
    pub _return: *MIRType;

    MIRFunctionType(&mut this, parameters: Vector<*MIRType>, _return: *MIRType) : MIRType(MIRTypeKind::Function) {
        (this.parameters, this._return) = (parameters, _return);
    }

    pub override fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            result += this.parameters[i]->ToString();
        } result += ')';

        if this._return->kind != MIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        }

        result
    }
}

enum MIRValueKind: u8 {
    Constant, Instruction, DeclarationReference, Parameter
}

class MIRValue {
    pub kind: MIRValueKind,
    pub _type: *MIRType;

    MIRValue(&mut this, kind: MIRValueKind, _type: *MIRType) {
        (this.kind, this._type) = (kind, _type);
    }

    virtual ~MIRValue(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut _type = this._type;

        if _type->kind == MIRTypeKind::Function {
            _type = (this._type as *MIRFunctionType)->_return;
        }

        match this.kind {
            MIRValueKind::Constant => _type->ToString() + ' ' + (this as *MIRConstant)->ToString(),
            MIRValueKind::Instruction => _type->ToString() + ' ' + (this as *MIRInstruction)->ToString(),
            MIRValueKind::DeclarationReference => _type->ToString() + ' ' + (this as *MIRDeclarationReference)->ToString(),
            MIRValueKind::Parameter => _type->ToString() + ' ' + (this as *MIRParameter)->ToString()
        }
    }
}

enum MIRConstantKind: u8 {
    Integer, Float, String, Array, Structure, Null, Expression, Undef
}

class MIRConstant : MIRValue {
    pub kind: MIRConstantKind;

    MIRConstant(&mut this, kind: MIRConstantKind, _type: *MIRType) : MIRValue(MIRValueKind::Constant, _type) {
        this.kind = kind;
    }

    pub virtual fn ToString(&this) -> String;
}

class MIRConstantInteger : MIRConstant {
    pub value: u64;

    MIRConstantInteger(&mut this, value: u64, _type: *MIRType) : MIRConstant(MIRConstantKind::Integer, _type) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        if (this._type as *MIRIntegerType)->width == 1 {
            return (if this.value != 0 { "true" } else { "false" }).ToString();
        }

        String::FromInteger(this.value as i64)
    }
}

class MIRConstantFloat : MIRConstant {
    pub value: f64;

    MIRConstantFloat(&mut this, value: f64, _type: *MIRType) : MIRConstant(MIRConstantKind::Float, _type) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        String::FromFloat(this.value)
    }
}

class MIRConstantString : MIRConstant {
    pub value: String;

    MIRConstantString(&mut this, value: String, _type: *MIRType) : MIRConstant(MIRConstantKind::String, _type) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        '"' + this.value.Escape() + '"'
    }
}

class MIRConstantArray : MIRConstant {
    pub elements: Vector<*MIRValue>;

    MIRConstantArray(&mut this, elements: Vector<*MIRValue>, _type: *MIRType) : MIRConstant(MIRConstantKind::Array, _type) {
        this.elements = elements;
    }

    pub override fn ToString(&this) -> String {
        let mut result = '['.ToString();

        for i in 0..this.elements.Size() {
            if i != 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ']'
    }
}

class MIRConstantStructure : MIRConstant {
    pub fields: Vector<*MIRValue>;

    MIRConstantStructure(&mut this, fields: Vector<*MIRValue>, _type: *MIRType) : MIRConstant(MIRConstantKind::Structure, _type) {
        this.fields = fields;
    }

    pub override fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.fields.Size() {
            if i != 0 { result += ", "; }
            result += this.fields[i]->ToString();
        }

        result + '}'
    }
}

class MIRConstantNull : MIRConstant {
    MIRConstantNull(&mut this, _type: *MIRType) : MIRConstant(MIRConstantKind::Null, _type) {}

    pub override fn ToString(&this) -> String {
        "null".ToString()
    }
}

class MIRConstantUndef : MIRConstant {
    MIRConstantUndef(&mut this, _type: *MIRType) : MIRConstant(MIRConstantKind::Undef, _type) {}

    pub override fn ToString(&this) -> String {
        "undef".ToString()
    }
}

enum MIRConstantExpressionKind: u8 {
    Unary, Binary, Cast, ArrayGEP, StructGEP
}

class MIRConstantExpression : MIRConstant {
    pub kind: MIRConstantExpressionKind;

    MIRConstantExpression(&mut this, kind: MIRConstantExpressionKind, _type: *MIRType) : MIRConstant(MIRConstantKind::Expression, _type) {
        this.kind = kind;
    }
}

enum MIRUnaryKind: u8 {
    Neg, FNeg, Not
}

extend MIRUnaryKind {
    pub fn ToString(this) -> String {
        match this {
            MIRUnaryKind::Neg => "neg",
            MIRUnaryKind::FNeg => "fneg",
            MIRUnaryKind::Not => "not"
        }.ToString()
    }
}

class MIRUnaryExpression : MIRConstantExpression {
    pub kind: MIRUnaryKind,
    pub operand: *MIRValue;

    MIRUnaryExpression(&mut this, kind: MIRUnaryKind, operand: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Unary, _type) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub override fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.operand->ToString()
    }
}

enum MIRBinaryKind: u8 {
    Add, Sub, Mul, SDiv, UDiv, SRem, URem,
    And, Or, Xor, Shl, LShr, AShr,
    FAdd, FSub, FMul, FDiv, FRem,
    ICmpEq, ICmpNe, ICmpSlt, ICmpSgt, ICmpSle, ICmpSge, ICmpUlt, ICmpUgt, ICmpUle, ICmpUge,
    FCmpEq, FCmpNe, FCmpLt, FCmpGt, FCmpLe, FCmpGe
}

extend MIRBinaryKind {
    pub fn ToString(this) -> String {
        match this {
            MIRBinaryKind::Add => "add",
            MIRBinaryKind::Sub => "sub",
            MIRBinaryKind::Mul => "mul",
            MIRBinaryKind::SDiv => "sdiv",
            MIRBinaryKind::UDiv => "udiv",
            MIRBinaryKind::SRem => "srem",
            MIRBinaryKind::URem => "urem",
            MIRBinaryKind::And => "and",
            MIRBinaryKind::Or => "or",
            MIRBinaryKind::Xor => "xor",
            MIRBinaryKind::Shl => "shl",
            MIRBinaryKind::LShr => "lshr",
            MIRBinaryKind::AShr => "ashr",
            MIRBinaryKind::FAdd => "fadd",
            MIRBinaryKind::FSub => "fsub",
            MIRBinaryKind::FMul => "fmul",
            MIRBinaryKind::FDiv => "fdiv",
            MIRBinaryKind::FRem => "frem",
            MIRBinaryKind::ICmpEq => "icmp eq",
            MIRBinaryKind::ICmpNe => "icmp ne",
            MIRBinaryKind::ICmpSlt => "icmp slt",
            MIRBinaryKind::ICmpSgt => "icmp sgt",
            MIRBinaryKind::ICmpSle => "icmp sle",
            MIRBinaryKind::ICmpSge => "icmp sge",
            MIRBinaryKind::ICmpUlt => "icmp ult",
            MIRBinaryKind::ICmpUgt => "icmp ugt",
            MIRBinaryKind::ICmpUle => "icmp ule",
            MIRBinaryKind::ICmpUge => "icmp uge",
            MIRBinaryKind::FCmpEq => "fcmp eq",
            MIRBinaryKind::FCmpNe => "fcmp ne",
            MIRBinaryKind::FCmpLt => "fcmp lt",
            MIRBinaryKind::FCmpGt => "fcmp gt",
            MIRBinaryKind::FCmpLe => "fcmp le",
            MIRBinaryKind::FCmpGe => "fcmp ge"
        }.ToString()
    }
}

class MIRBinaryExpression : MIRConstantExpression {
    pub kind: MIRBinaryKind,
    pub left: *MIRValue,
    pub right: *MIRValue;

    MIRBinaryExpression(&mut this, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Binary, _type) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub override fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.left->ToString() + ", " + this.right->ToString()
    }
}

enum MIRCastKind: u8 {
    Trunc, ZExt, SExt,
    FPTrunc, FPExt, FPToSI, FPToUI, SIToFP, UIToFP,
    PtrToInt, IntToPtr, Bitcast
}

extend MIRCastKind {
    pub fn ToString(this) -> String {
        match this {
            MIRCastKind::Trunc => "trunc",
            MIRCastKind::ZExt => "zext",
            MIRCastKind::SExt => "sext",
            MIRCastKind::FPTrunc => "fptrunc",
            MIRCastKind::FPExt => "fpext",
            MIRCastKind::FPToSI => "fptosi",
            MIRCastKind::FPToUI => "fptoui",
            MIRCastKind::SIToFP => "sitofp",
            MIRCastKind::UIToFP => "uitofp",
            MIRCastKind::PtrToInt => "ptrtoint",
            MIRCastKind::IntToPtr => "inttoptr",
            MIRCastKind::Bitcast => "bitcast"
        }.ToString()
    }
}

class MIRCastExpression : MIRConstantExpression {
    pub kind: MIRCastKind,
    pub value: *MIRValue;

    MIRCastExpression(&mut this, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Cast, _type) {
        (this.kind, this.value) = (kind, value);
    }

    pub override fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.value->ToString() + " to " + this._type->ToString()
    }
}

class MIRArrayGEPExpression : MIRConstantExpression {
    pub pointer: *MIRValue,
    pub index: *MIRValue;

    MIRArrayGEPExpression(&mut this, pointer: *MIRValue, index: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::ArrayGEP, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub override fn ToString(&this) -> String {
        "getelementptr " + this.pointer->ToString() + ", " + this.index->ToString()
    }
}

class MIRStructGEPExpression : MIRConstantExpression {
    pub pointer: *MIRValue,
    pub index: u32;

    MIRStructGEPExpression(&mut this, pointer: *MIRValue, index: u32, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::StructGEP, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub override fn ToString(&this) -> String {
        "getelementptr " + this.pointer->ToString() + ", " + String::FromInteger(this.index as u64)
    }
}

enum MIRInstructionKind: u8 {
    Alloca, Load, Store, ArrayGEP, StructGEP,
    Unary, Binary, Call, Cast, Select, Phi,
    Assembly, Terminator
}

class MIRInstruction : MIRValue {
    pub kind: MIRInstructionKind,
    pub name: String;

    MIRInstruction(&mut this, kind: MIRInstructionKind, name: String, _type: *MIRType) : MIRValue(MIRValueKind::Instruction, _type) {
        this.kind = kind;

        if _type->kind == MIRTypeKind::Void {
            this.name = "".ToString();
        } else {
            this.name = name;
        }
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = String();

        if this._type->kind != MIRTypeKind::Void {
            result += '%' + this.name + " = ";
        }

        match this.kind {
            MIRInstructionKind::Alloca => {
                result += (this as *MIRAllocaInstruction)->ToString();
            },
            MIRInstructionKind::Load => {
                result += (this as *MIRLoadInstruction)->ToString();
            },
            MIRInstructionKind::Store => {
                result += (this as *MIRStoreInstruction)->ToString();
            },
            MIRInstructionKind::ArrayGEP => {
                result += (this as *MIRArrayGEPInstruction)->ToString();
            },
            MIRInstructionKind::StructGEP => {
                result += (this as *MIRStructGEPInstruction)->ToString();
            },
            MIRInstructionKind::Unary => {
                result += (this as *MIRUnaryInstruction)->ToString();
            },
            MIRInstructionKind::Binary => {
                result += (this as *MIRBinaryInstruction)->ToString();
            },
            MIRInstructionKind::Call => {
                result += (this as *MIRCallInstruction)->ToString();
            },
            MIRInstructionKind::Cast => {
                result += (this as *MIRCastInstruction)->ToString();
            },
            MIRInstructionKind::Select => {
                result += (this as *MIRSelectInstruction)->ToString();
            },
            MIRInstructionKind::Phi => {
                result += (this as *MIRPhiInstruction)->ToString();
            },
            MIRInstructionKind::Assembly => {
                result += (this as *MIRAssemblyInstruction)->ToString();
            },
            MIRInstructionKind::Terminator => {
                result += (this as *MIRTerminator)->ToString();
            }
        }

        result
    }

    pub fn ToString(&this) -> String {
        if this.name.Empty()  {
            Logger::Log("Referencing an unnamed instruction!", LogSeverity::Fatal);
        }

        '%' + this.name
    }
}

class MIRAllocaInstruction : MIRInstruction {
    pub _type: *MIRType;

    MIRAllocaInstruction(&mut this, name: String, _type: *MIRType, result_type: *MIRType) : MIRInstruction(MIRInstructionKind::Alloca, name, result_type) {
        this._type = _type;
    }

    pub fn ToString(&this) -> String {
        "alloca " + this._type->ToString()
    }
}

class MIRLoadInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub alignment: u32 = 0;

    MIRLoadInstruction(&mut this, name: String, pointer: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Load, name, _type) {
        this.pointer = pointer;
    }

    pub fn ToString(&this) -> String {
        let mut result = "load " + this._type->ToString() + ", " + this.pointer->ToString();
        if this.alignment != 0 { result += ", align " + String::FromInteger(this.alignment as u64); }
        result
    }
}

class MIRStoreInstruction : MIRInstruction {
    pub value: *MIRValue,
    pub pointer: *MIRValue,
    pub alignment: u32 = 0;

    MIRStoreInstruction(&mut this, value: *MIRValue, pointer: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Store, "".ToString(), _type) {
        (this.value, this.pointer) = (value, pointer);
    }

    pub fn ToString(&this) -> String {
        let mut result = "store " + this.value->ToString() + ", " + this.pointer->ToString();
        if this.alignment != 0 { result += ", align " + String::FromInteger(this.alignment as u64); }
        result
    }
}

class MIRArrayGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: *MIRValue;

    MIRArrayGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::ArrayGEP, name, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        "getelementptr " + this.pointer->ToString() + ", " + this.index->ToString()
    }
}

class MIRStructGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: u32;

    MIRStructGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: u32, _type: *MIRType) : MIRInstruction(MIRInstructionKind::StructGEP, name, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        "getelementptr " + this.pointer->ToString() + ", " + String::FromInteger(this.index as u64)
    }
}

class MIRUnaryInstruction : MIRInstruction {
    pub kind: MIRUnaryKind,
    pub operand: *MIRValue;

    MIRUnaryInstruction(&mut this, name: String, kind: MIRUnaryKind, operand: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Unary, name, _type) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.operand->ToString()
    }
}

class MIRBinaryInstruction : MIRInstruction {
    pub kind: MIRBinaryKind,
    pub left: *MIRValue,
    pub right: *MIRValue;

    MIRBinaryInstruction(&mut this, name: String, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Binary, name, _type) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.left->ToString() + ", " + this.right->ToString()
    }
}

class MIRCallInstruction : MIRInstruction {
    pub callee: *MIRValue,
    pub arguments: Vector<*MIRValue>;

    MIRCallInstruction(&mut this, name: String, callee: *MIRValue, arguments: Vector<*MIRValue>, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Call, name, _type) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call " + this.callee->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            result += this.arguments[i]->ToString();
        }

        result + ')'
    }
}

class MIRCastInstruction : MIRInstruction {
    pub kind: MIRCastKind,
    pub value: *MIRValue;

    MIRCastInstruction(&mut this, name: String, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Cast, name, _type) {
        (this.kind, this.value) = (kind, value);
    }

    pub fn ToString(&this) -> String {
        this.kind.ToString() + ' ' + this.value->ToString() + " to " + this._type->ToString()
    }
}

class MIRSelectInstruction : MIRInstruction {
    pub condition: *MIRValue,
    pub then_value: *MIRValue,
    pub else_value: *MIRValue;

    MIRSelectInstruction(&mut this, name: String, condition: *MIRValue, then_value: *MIRValue, else_value: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Select, name, _type) {
        (this.condition, this.then_value, this.else_value) = (condition, then_value, else_value);
    }

    pub fn ToString(&this) -> String {
        "select " + this.condition->ToString() + ", " + this.then_value->ToString() + ", " + this.else_value->ToString()
    }
}

class MIRPhiIncoming {
    pub value: *MIRValue,
    pub block: *MIRBlock;

    MIRPhiIncoming(&mut this) {}

    MIRPhiIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        (this.value, this.block) = (value, block);
    }
}

class MIRPhiInstruction : MIRInstruction {
    pub incomings: Vector<MIRPhiIncoming>;

    MIRPhiInstruction(&mut this, name: String, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Phi, name, _type) {}

    pub fn AddIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        this.incomings.PushBack(MIRPhiIncoming(value, block));
    }

    pub fn ToString(&this) -> String {
        let mut result = "phi ".ToString();

        for i in 0..this.incomings.Size() {
            if i != 0 { result += ", "; }
            result += '[' + this.incomings[i].value->ToString() + ", " + this.incomings[i].block->ToString() + ']';
        }

        result
    }
}

class MIRAssemblyOperand {
    pub name: String,
    pub value: *MIRValue;

    MIRAssemblyOperand(&mut this, name: String, value: *MIRValue) {
        (this.name, this.value) = (name, value);
    }
}

class MIRAssemblyInstruction : MIRInstruction {
    pub _volatile: bool,
    pub text: String,
    pub inputs: Vector<*MIRAssemblyOperand>,
    pub outputs: Vector<*MIRAssemblyOperand>,
    pub clobbers: Vector<String>;

    MIRAssemblyInstruction(&mut this, _volatile: bool, text: String, inputs: Vector<*MIRAssemblyOperand>, outputs: Vector<*MIRAssemblyOperand>, clobbers: Vector<String>, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Assembly, "".ToString(), _type) {
        (this._volatile, this.text, this.inputs, this.outputs, this.clobbers) = (_volatile, text, inputs, outputs, clobbers);
    }

    pub fn ToString(&this) -> String {
        let mut result = (if this._volatile { "volatile asm " } else { "asm " }).ToString();

        if !this.inputs.Empty() {
            result += ": ";

            for i in 0..this.inputs.Size() {
                if i != 0 { result += ", "; }
                result += this.inputs[i]->name + '(' + this.inputs[i]->value->ToString() + ')';
            } result += " -> ";
        }

        result += '{' + this.text + '}';

        if !this.outputs.Empty() {
            result += " -> ";

            for i in 0..this.outputs.Size() {
                if i != 0 { result += ", "; }
                result += this.outputs[i]->name + '(' + this.outputs[i]->value->ToString() + ')';
            }
        }

        if !this.clobbers.Empty() {
            result += " : ";

            for i in 0..this.clobbers.Size() {
                if i != 0 { result += ", "; }
                result += this.clobbers[i];
            }
        }

        result
    }
}

enum MIRTerminatorKind: u8 {
    Return, Branch, ConditionalBranch, Unreachable
}

class MIRTerminator : MIRInstruction {
    pub kind: MIRTerminatorKind;

    MIRTerminator(&mut this, kind: MIRTerminatorKind, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Terminator, "".ToString(), _type) {
        this.kind = kind;
    }

    pub virtual fn ToString(&this) -> String;
}

class MIRReturnInstruction : MIRTerminator {
    pub value: *MIRValue;

    MIRReturnInstruction(&mut this, value: *MIRValue, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Return, _type) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        let mut result = "return".ToString();

        if this.value != null {
            result += ' ' + this.value->ToString();
        }

        result
    }
}

class MIRBranchInstruction : MIRTerminator {
    pub target: *MIRBlock;

    MIRBranchInstruction(&mut this, target: *MIRBlock, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Branch, _type) {
        this.target = target;
    }

    pub override fn ToString(&this) -> String {
        "branch " + this.target->ToString()
    }
}

class MIRConditionalBranchInstruction : MIRTerminator {
    pub condition: *MIRValue,
    pub then_target: *MIRBlock,
    pub else_target: *MIRBlock;

    MIRConditionalBranchInstruction(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::ConditionalBranch, _type) {
        (this.condition, this.then_target, this.else_target) = (condition, then_target, else_target);
    }

    pub override fn ToString(&this) -> String {
        "branch " + this.condition->ToString() + ", " + this.then_target->ToString() + ", " + this.else_target->ToString()
    }
}

class MIRUnreachableInstruction : MIRTerminator {
    MIRUnreachableInstruction(&mut this, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Unreachable, _type) {}

    pub override fn ToString(&this) -> String {
        "unreachable".ToString()
    }
}

class MIRDeclarationReference : MIRValue {
    pub declaration: *MIRTypedDeclaration;

    MIRDeclarationReference(&mut this, declaration: *MIRTypedDeclaration, _type: *MIRType) : MIRValue(MIRValueKind::DeclarationReference, _type) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        "@\"" + this.declaration->name + '"'
    }
}

class MIRParameter : MIRValue {
    pub name: String,
    pub sret: *MIRType = null,
    pub byval: *MIRType = null,
    pub index: u32;

    MIRParameter(&mut this, name: String, index: u32, _type: *MIRType) : MIRValue(MIRValueKind::Parameter, _type) {
        (this.name, this.index) = (name, index);
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = '%' + this.name + ": ";

        if this.sret != null {
            result += "@sret(" + this.sret->ToString() + ") ";
        }

        if this.byval != null {
            result += "@byval(" + this.byval->ToString() + ") ";
        }

        result + this._type->ToString()
    }

    pub fn ToString(&this) -> String {
        '%' + this.name
    }
}

class MIRBlock {
    pub name: String,
    pub parent: *mut MIRFunctionDeclaration = null,
    pub instructions: Vector<*mut MIRInstruction>,
    pub terminator: *mut MIRTerminator = null;

    MIRBlock(&mut this, name: String) {
        this.name = name;
    }

    pub fn HasTerminator(&this) -> bool {
        this.terminator != null
    }

    pub fn GetTerminator(&this) -> *mut MIRTerminator {
        this.terminator
    }

    pub fn SetTerminator(&mut this, terminator: *mut MIRTerminator) {
        if this.HasTerminator() {
            Logger::Log("Block already terminated!", LogSeverity::Fatal);
        } this.terminator = terminator;
    }

    pub fn AddInstruction(&mut this, instruction: *mut MIRInstruction) {
        if this.HasTerminator() {
            Logger::Log("Appending instruction after block terminator!", LogSeverity::Fatal);
        }

        if instruction->_type->kind != MIRTypeKind::Void {
            instruction->name = this.parent->GetUniqueName(instruction->name);
        } this.instructions.PushBack(instruction);
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = this.name + ':';

        for instruction in this.instructions {
            result += "\n  " + instruction->ToDefinitionString();
        }

        if this.terminator != null {
            result += "\n  " + this.terminator->ToString();
        }

        result
    }

    pub fn ToString(&this) -> String {
        '%' + this.name
    }
}

enum MIRDeclarationKind: u8 {
    Type, Function, Constant, Static, Assembly
}

class MIRDeclaration {
    pub kind: MIRDeclarationKind;

    MIRDeclaration(&mut this, kind: MIRDeclarationKind) {
        this.kind = kind;
    }

    virtual ~MIRDeclaration(&mut this) {}

    pub virtual fn ToString(&this) -> String;
}

class MIRTypedDeclaration : MIRDeclaration {
    pub name: String,
    pub _type: *MIRType;

    MIRTypedDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *MIRType) : MIRDeclaration(kind) {
        (this.name, this._type) = (name, _type);
    }
}

enum MIRDeclarationLinkage: u8 {
    Private, Internal, External
}

class MIRLinkableDeclaration : MIRTypedDeclaration {
    pub linkage: MIRDeclarationLinkage;

    MIRLinkableDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *MIRType, linkage: MIRDeclarationLinkage) : MIRTypedDeclaration(kind, name, _type) {
        this.linkage = linkage;
    }
}

class MIRTypeDeclaration : MIRTypedDeclaration {
    MIRTypeDeclaration(&mut this, name: String, _type: *MIRType) : MIRTypedDeclaration(MIRDeclarationKind::Type, name, _type) {}

    pub override fn ToString(&this) -> String {
        let mut result = "type %" + this.name + " = ";

        if this._type->kind == MIRTypeKind::Structure {
            result += (this._type as *MIRStructureType)->ToDefinitionString();
        } else {
            result += this._type->ToString();
        }

        result
    }
}

class MIRFunctionDeclaration : MIRLinkableDeclaration {
    pub parameters: Vector<*MIRParameter>,
    pub _return: *MIRType,
    pub blocks: Vector<*mut MIRBlock>,
    pub names: Map<String, u32>,
    pub alloca_index: usize = 0;

    MIRFunctionDeclaration(&mut this, name: String, parameters: Vector<*MIRParameter>, _return: *MIRType, _type: *MIRType, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Function, name, _type, linkage) {
        (this.parameters, this._return) = (parameters, _return);

        for parameter in this.parameters {
            if parameter->name.Empty() { continue; }
            let count = this.names.Get(parameter->name, 0);
            this.names[parameter->name] = count + 1;
        }
    }

    pub fn AddBlock(&mut this, block: *mut MIRBlock) {
        (block->name, block->parent) = (this.GetUniqueName(block->name), this);
        this.blocks.PushBack(block);
    }

    pub fn AddAllocaInstruction(&mut this, alloca: *mut MIRAllocaInstruction) {
        let instruction = alloca as *mut MIRInstruction;
        instruction->name = this.GetUniqueName(instruction->name);
        this.blocks[0]->instructions.Insert(this.alloca_index, alloca);
        this.alloca_index += 1;
    }

    pub fn GetUniqueName(&mut this, name: &String) -> String {
        if name.Empty() { return name; }
        let count = this.names.Get(name, 0);
        this.names[name] = count + 1;
        if count == 0 { return name; }
        name + '.' + String::FromInteger(count as u64)
    }

    pub override fn ToString(&this) -> String {
        let mut result = "fn @\"" + this.name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            result += this.parameters[i]->ToDefinitionString();
        } result += ')';

        if this._return->kind != MIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        }

        if !this.blocks.Empty() {
            result += " {\n";

            for i in 0..this.blocks.Size() {
                if i != 0 { result += '\n'; }
                let block: *MIRBlock = this.blocks[i];
                result += block->ToDefinitionString() + '\n';
            } result += '}';
        }

        result
    }
}

class MIRConstantDeclaration : MIRTypedDeclaration {
    pub initializer: *MIRValue;

    MIRConstantDeclaration(&mut this, name: String, _type: *MIRType, initializer: *MIRValue) : MIRTypedDeclaration(MIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub override fn ToString(&this) -> String {
        "const @\"" + this.name + "\": " + this._type->ToString() + " = " + this.initializer->ToString()
    }
}

class MIRStaticDeclaration : MIRLinkableDeclaration {
    pub initializer: *MIRValue,
    pub mutable: bool;

    MIRStaticDeclaration(&mut this, name: String, _type: *MIRType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Static, name, _type, linkage) {
        (this.initializer, this.mutable) = (initializer, mutable);
    }

    pub override fn ToString(&this) -> String {
        let mut result = "static @\"" + this.name + "\": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        }

        result
    }
}

class MIRAssemblyDeclaration : MIRDeclaration {
    pub text: String;

    MIRAssemblyDeclaration(&mut this, text: String) : MIRDeclaration(MIRDeclarationKind::Assembly) {
        this.text = text;
    }

    pub override fn ToString(&this) -> String {
        "asm {" + this.text + '}'
    }
}

class MIRModule {
    pub declarations: Vector<*mut MIRDeclaration>;

    MIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *MIRDeclaration = null;

        for declaration in this.declarations {
            if previous != null {
                result += '\n';

                if previous->kind != declaration->kind {
                    result += '\n';
                } else if declaration->kind == MIRDeclarationKind::Function {
                    let current = declaration as *MIRFunctionDeclaration;
                    let previous = previous as *MIRFunctionDeclaration;

                    if !current->blocks.Empty() || !previous->blocks.Empty() {
                        result += '\n';
                    }
                }
            }

            result += declaration->ToString();
            previous = declaration;
        }

        result
    }
}

class MIRContext {
    pub arena: Arena;

    MIRContext(&mut this) {}

    pub fn VoidType(&mut this) -> *MIRType {
        this.arena.New<MIRVoidType>()
    }

    pub fn IntegerType(&mut this, width: u32) -> *MIRType {
        this.arena.New<MIRIntegerType>(width)
    }

    pub fn FloatType(&mut this, width: u32) -> *MIRType {
        this.arena.New<MIRFloatType>(width)
    }

    pub fn PointerType(&mut this, pointee: *MIRType) -> *MIRType {
        this.arena.New<MIRPointerType>(pointee)
    }

    pub fn ArrayType(&mut this, element: *MIRType, length: usize) -> *MIRType {
        this.arena.New<MIRArrayType>(element, length)
    }

    pub fn StructureType(&mut this, name: String) -> *MIRType {
        this.arena.New<MIRStructureType>(name)
    }

    pub fn StructureType(&mut this, fields: Vector<*MIRType>) -> *MIRType {
        this.arena.New<MIRStructureType>(fields)
    }

    pub fn FunctionType(&mut this, parameters: Vector<*MIRType>, _return: *MIRType) -> *MIRType {
        this.arena.New<MIRFunctionType>(parameters, _return)
    }
}

class MIRBuilder {
    context: *mut MIRContext,
    module: *mut MIRModule,
    function: *mut MIRFunctionDeclaration = null,
    block: *mut MIRBlock = null;

    MIRBuilder(&mut this) {}

    MIRBuilder(&mut this, context: *mut MIRContext, module: *mut MIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn ConstantInteger(&mut this, value: u64, _type: *MIRType) -> *mut MIRConstantInteger {
        this.context->arena.New<MIRConstantInteger>(value, _type)
    }

    pub fn ConstantFloat(&mut this, value: f64, _type: *MIRType) -> *mut MIRConstantFloat {
        this.context->arena.New<MIRConstantFloat>(value, _type)
    }

    pub fn ConstantString(&mut this, value: String, _type: *MIRType) -> *mut MIRConstantString {
        this.context->arena.New<MIRConstantString>(value, _type)
    }

    pub fn ConstantArray(&mut this, values: Vector<*MIRValue>, _type: *MIRType) -> *mut MIRConstantArray {
        this.context->arena.New<MIRConstantArray>(values, _type)
    }

    pub fn ConstantStruct(&mut this, values: Vector<*MIRValue>, _type: *MIRType) -> *mut MIRConstantStructure {
        this.context->arena.New<MIRConstantStructure>(values, _type)
    }

    pub fn ConstantNull(&mut this, _type: *MIRType) -> *mut MIRConstantNull {
        this.context->arena.New<MIRConstantNull>(_type)
    }

    pub fn ConstantUndef(&mut this, _type: *MIRType) -> *mut MIRConstantUndef {
        this.context->arena.New<MIRConstantUndef>(_type)
    }

    pub fn ConstantUnary(&mut this, kind: MIRUnaryKind, operand: *MIRValue) -> *mut MIRUnaryExpression {
        this.context->arena.New<MIRUnaryExpression>(kind, operand, operand->_type)
    }

    pub fn ConstantBinary(&mut this, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) -> *mut MIRBinaryExpression {
        this.context->arena.New<MIRBinaryExpression>(kind, left, right, _type)
    }

    pub fn ConstantCast(&mut this, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) -> *mut MIRCastExpression {
        this.context->arena.New<MIRCastExpression>(kind, value, _type)
    }

    pub fn ConstantArrayGEP(&mut this, pointer: *MIRValue, index: *MIRValue) -> *mut MIRArrayGEPExpression {
        this.context->arena.New<MIRArrayGEPExpression>(pointer, index, pointer->_type)
    }

    pub fn ConstantStructGEP(&mut this, pointer: *MIRValue, index: u32, _type: *MIRType) -> *mut MIRStructGEPExpression {
        this.context->arena.New<MIRStructGEPExpression>(pointer, index, _type)
    }

    pub fn BuildAlloca(&mut this, name: String, _type: *MIRType) -> *mut MIRAllocaInstruction {
        let alloca = this.context->arena.New<MIRAllocaInstruction>(name, _type, this.context->PointerType(_type));
        this.function->AddAllocaInstruction(alloca);
        alloca
    }

    pub fn BuildLoad(&mut this, name: String, pointer: *MIRValue) -> *mut MIRLoadInstruction {
        if pointer->_type->kind != MIRTypeKind::Pointer {
            Logger::Log("Loading from a non-pointer value!", LogSeverity::Fatal);
            return null;
        }

        let load = this.context->arena.New<MIRLoadInstruction>(name, pointer, (pointer->_type as *MIRPointerType)->pointee);
        this.block->AddInstruction(load);
        load
    }

    pub fn BuildStore(&mut this, value: *MIRValue, pointer: *MIRValue) -> *mut MIRStoreInstruction {
        let store = this.context->arena.New<MIRStoreInstruction>(value, pointer, this.context->VoidType());
        this.block->AddInstruction(store);
        store
    }

    pub fn BuildArrayGEP(&mut this, name: String, pointer: *MIRValue, index: *MIRValue) -> *mut MIRValue {
        if this.GetCurrentBlock() == null {
            return this.ConstantArrayGEP(pointer, index);
        }

        let gep = this.context->arena.New<MIRArrayGEPInstruction>(name, pointer, index, pointer->_type);
        this.block->AddInstruction(gep);
        gep
    }

    pub fn BuildStructGEP(&mut this, name: String, pointer: *MIRValue, index: u32, _type: *MIRType) -> *mut MIRValue {
        if this.GetCurrentBlock() == null {
            return this.ConstantStructGEP(pointer, index, _type);
        }

        let gep = this.context->arena.New<MIRStructGEPInstruction>(name, pointer, index, _type);
        this.block->AddInstruction(gep);
        gep
    }

    pub fn BuildUnary(&mut this, name: String, kind: MIRUnaryKind, operand: *MIRValue) -> *mut MIRValue {
        if this.GetCurrentBlock() == null {
            return this.ConstantUnary(kind, operand);
        }

        let unary = this.context->arena.New<MIRUnaryInstruction>(name, kind, operand, operand->_type);
        this.block->AddInstruction(unary);
        unary
    }

    pub fn BuildBinary(&mut this, name: String, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) -> *mut MIRValue {
        if this.GetCurrentBlock() == null {
            return this.ConstantBinary(kind, left, right, _type);
        }

        let binary = this.context->arena.New<MIRBinaryInstruction>(name, kind, left, right, _type);
        this.block->AddInstruction(binary);
        binary
    }

    pub fn BuildCall(&mut this, name: String, callee: *MIRValue, arguments: Vector<*MIRValue>) -> *mut MIRCallInstruction {
        let call = this.context->arena.New<MIRCallInstruction>(name, callee, arguments, (callee->_type as *MIRFunctionType)->_return);
        this.block->AddInstruction(call);
        call
    }

    pub fn BuildCast(&mut this, name: String, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) -> *mut MIRValue {
        if this.GetCurrentBlock() == null {
            return this.ConstantCast(kind, value, _type);
        }

        let cast = this.context->arena.New<MIRCastInstruction>(name, kind, value, _type);
        this.block->AddInstruction(cast);
        cast
    }

    pub fn BuildSelect(&mut this, name: String, condition: *MIRValue, then_value: *MIRValue, else_value: *MIRValue, _type: *MIRType) -> *mut MIRSelectInstruction {
        let select = this.context->arena.New<MIRSelectInstruction>(name, condition, then_value, else_value, _type);
        this.block->AddInstruction(select);
        select
    }

    pub fn BuildPhi(&mut this, name: String, _type: *MIRType) -> *mut MIRPhiInstruction {
        let phi = this.context->arena.New<MIRPhiInstruction>(name, _type);
        this.block->AddInstruction(phi);
        phi
    }

    pub fn BuildAssemblyOperand(&mut this, name: String, value: *MIRValue) -> *mut MIRAssemblyOperand {
        this.context->arena.New<MIRAssemblyOperand>(name, value)
    }

    pub fn BuildAssembly(&mut this, _volatile: bool, text: String, inputs: Vector<*MIRAssemblyOperand>, outputs: Vector<*MIRAssemblyOperand>, clobbers: Vector<String>) -> *mut MIRAssemblyInstruction {
        let assembly = this.context->arena.New<MIRAssemblyInstruction>(_volatile, text, inputs, outputs, clobbers, this.context->VoidType());
        this.block->AddInstruction(assembly);
        assembly
    }

    pub fn BuildReturn(&mut this, value: *MIRValue) -> *mut MIRReturnInstruction {
        let _return = this.context->arena.New<MIRReturnInstruction>(value, this.context->VoidType());
        this.block->SetTerminator(_return);
        _return
    }

    pub fn BuildBranch(&mut this, target: *MIRBlock) -> *mut MIRBranchInstruction {
        let branch = this.context->arena.New<MIRBranchInstruction>(target, this.context->VoidType());
        this.block->SetTerminator(branch);
        branch
    }

    pub fn BuildConditionalBranch(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock) -> *mut MIRConditionalBranchInstruction {
        let branch = this.context->arena.New<MIRConditionalBranchInstruction>(condition, then_target, else_target, this.context->VoidType());
        this.block->SetTerminator(branch);
        branch
    }

    pub fn BuildUnreachable(&mut this) -> *mut MIRUnreachableInstruction {
        let unreachable = this.context->arena.New<MIRUnreachableInstruction>(this.context->VoidType());
        this.block->SetTerminator(unreachable);
        unreachable
    }

    pub fn ReferenceDeclaration(&mut this, declaration: *MIRTypedDeclaration) -> *mut MIRDeclarationReference {
        let mut _type: *MIRType = null;

        if declaration->kind == MIRDeclarationKind::Constant || declaration->kind == MIRDeclarationKind::Static {
            _type = this.context->PointerType(declaration->_type);
        } else {
            _type = declaration->_type;
        }

        this.context->arena.New<MIRDeclarationReference>(declaration, _type)
    }

    pub fn BuildParameter(&mut this, name: String, index: u32, _type: *MIRType) -> *mut MIRParameter {
        this.context->arena.New<MIRParameter>(name, index, _type)
    }

    pub fn BuildBlock(&mut this, name: String) -> *mut MIRBlock {
        let block = this.context->arena.New<MIRBlock>(name);
        this.function->AddBlock(block);
        block
    }

    pub fn SetCurrentBlock(&mut this, block: *mut MIRBlock) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&this) -> *mut MIRBlock {
        this.block
    }

    pub fn BuildType(&mut this, name: String, _type: *MIRType) -> *mut MIRTypeDeclaration {
        let type_declaration = this.context->arena.New<MIRTypeDeclaration>(name, _type);
        this.module->declarations.PushBack(type_declaration);
        type_declaration
    }

    pub fn BuildFunction(&mut this, name: String, parameters: Vector<*MIRParameter>, _return: *MIRType, linkage: MIRDeclarationLinkage) -> *mut MIRFunctionDeclaration {
        let mut parameter_types = Vector<*MIRType>();
        for parameter in parameters { parameter_types.PushBack(parameter->_type); }
        let _type = this.context->FunctionType(parameter_types, _return);
        let function = this.context->arena.New<MIRFunctionDeclaration>(name, parameters, _return, _type, linkage);
        this.module->declarations.PushBack(function);
        function
    }

    pub fn SetCurrentFunction(&mut this, function: *mut MIRFunctionDeclaration) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&this) -> *mut MIRFunctionDeclaration {
        this.function
    }

    pub fn BuildConstant(&mut this, name: String, _type: *MIRType, initializer: *MIRValue) -> *mut MIRConstantDeclaration {
        let constant = this.context->arena.New<MIRConstantDeclaration>(name, _type, initializer);
        this.module->declarations.PushBack(constant);
        constant
    }

    pub fn BuildStatic(&mut this, name: String, _type: *MIRType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) -> *mut MIRStaticDeclaration {
        let _static = this.context->arena.New<MIRStaticDeclaration>(name, _type, mutable, initializer, linkage);
        this.module->declarations.PushBack(_static);
        _static
    }

    pub fn BuildAssembly(&mut this, text: String) -> *mut MIRAssemblyDeclaration {
        let assembly = this.context->arena.New<MIRAssemblyDeclaration>(text);
        this.module->declarations.PushBack(assembly);
        assembly
    }
}
