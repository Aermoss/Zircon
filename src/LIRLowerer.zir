#[include "std/str", "std/vec", "std/map",
    "src/MIR.zir", "src/LIR.zir", "src/Logger.zir" : *]

class LIRLowerer {
    context: LIRContext,
    builder: LIRBuilder,
    values: Map<*MIRValue, *LIROperand>,
    blocks: Map<*MIRBlock, *mut LIRBlock>,
    module: *mut LIRModule;

    LIRLowerer(&mut this) {}

    pub fn Lower(&mut this, module: *MIRModule) -> *LIRModule {
        this.module = this.context.arena.New<LIRModule>();
        this.builder = LIRBuilder(&mut this.context, this.module);
        this.LowerModule(module);
        return this.module;
    }

    fn LowerModule(&mut this, module: *MIRModule) {
        for declaration in module->declarations {
            this.LowerDeclaration(declaration);
        }
    }

    fn LowerDeclaration(&mut this, declaration: *MIRDeclaration) {
        if declaration->kind == MIRDeclarationKind::Function {
            this.LowerFunctionDeclaration((declaration as *MIRLinkableDeclaration) as *MIRFunctionDeclaration);
        }
    }

    fn LowerFunctionDeclaration(&mut this, function: *MIRFunctionDeclaration) {
        let declaration = (function as *MIRLinkableDeclaration) as *MIRDeclaration;
        let lowered = this.builder.BuildFunction(declaration->name);
        if function->blocks.Empty() { return; }
        this.builder.SetCurrentFunction(lowered);
        this.blocks.Clear();

        for block in function->blocks {
            this.blocks[block] = this.builder.BuildBlock(block->name);
        }

        this.builder.SetCurrentBlock(this.blocks[function->blocks[0]]);
        this.values.Clear();

        for i in 0..function->parameters.Size() {
            if i >= 8 { break; }
            let parameter: *MIRParameter = function->parameters[i];
            let destination = this.builder.VirtualRegister() as *LIRRegisterOperand;
            this.EmitMove(destination, this.builder.PhysicalRegister((24 + i) as u8, 'a' + String::FromInteger(i as u64)) as *LIRRegisterOperand);
            this.values[parameter as *MIRValue] = destination;
        }

        for block in function->blocks {
            this.builder.SetCurrentBlock(this.blocks[block]);

            for instruction in block->instructions {
                this.values[instruction as *MIRValue] = this.LowerInstruction(instruction);
            }

            if block->terminator != null {
                this.LowerTerminator(block->terminator);
            }
        }
    }

    fn LowerValue(&mut this, value: *MIRValue) -> *LIROperand {
        if value->kind == MIRValueKind::Constant {
            return this.LowerConstant(value as *MIRConstant);
        } else if value->kind == MIRValueKind::Instruction || value->kind == MIRValueKind::Parameter {
            return this.values.Get(value, null);
        } else if value->kind == MIRValueKind::DeclarationReference {
            return this.builder.SymbolOperand((value as *MIRDeclarationReference)->declaration->name);
        } else {
            return null;
        }
    }

    fn LowerConstant(&mut this, constant: *MIRConstant) -> *LIROperand {
        if constant->kind == MIRConstantKind::Integer {
            return this.builder.ImmediateOperand((constant as *MIRConstantInteger)->value as i64) as *LIROperand;
        } else if constant->kind == MIRConstantKind::Null {
            return this.builder.ImmediateOperand(0) as *LIROperand;
        } else if constant->kind == MIRConstantKind::Expression {
            return this.LowerConstantExpression(constant as *MIRConstantExpression);
        } else {
            return null;
        }
    }

    fn LowerConstantExpression(&mut this, expression: *MIRConstantExpression) -> *LIROperand {
        if expression->kind == MIRConstantExpressionKind::Unary {
            return this.LowerUnaryExpression(expression as *MIRUnaryExpression);
        } else if expression->kind == MIRConstantExpressionKind::Binary {
            return this.LowerBinaryExpression(expression as *MIRBinaryExpression);
        } else if expression->kind == MIRConstantExpressionKind::Cast {
            return this.LowerCastExpression(expression as *MIRCastExpression);
        } else if expression->kind == MIRConstantExpressionKind::ArrayGEP {
            return this.LowerArrayGEPExpression(expression as *MIRArrayGEPExpression);
        } else if expression->kind == MIRConstantExpressionKind::StructGEP {
            return this.LowerStructGEPExpression(expression as *MIRStructGEPExpression);
        } else {
            return null;
        }
    }

    fn LowerUnaryExpression(&mut this, unary: *MIRUnaryExpression) -> *LIROperand {
        return null;
    }

    fn LowerBinaryExpression(&mut this, binary: *MIRBinaryExpression) -> *LIROperand {
        return null;
    }

    fn LowerCastExpression(&mut this, cast: *MIRCastExpression) -> *LIROperand {
        return null;
    }

    fn LowerArrayGEPExpression(&mut this, gep: *MIRArrayGEPExpression) -> *LIROperand {
        return null;
    }

    fn LowerStructGEPExpression(&mut this, gep: *MIRStructGEPExpression) -> *LIROperand {
        return null;
    }

    fn LowerInstruction(&mut this, instruction: *MIRInstruction) -> *LIROperand {
        if instruction->kind == MIRInstructionKind::Alloca {
            return this.LowerAllocaInstruction(instruction as *MIRAllocaInstruction);
        } else if instruction->kind == MIRInstructionKind::Load {
            return this.LowerLoadInstruction(instruction as *MIRLoadInstruction);
        } else if instruction->kind == MIRInstructionKind::Store {
            return this.LowerStoreInstruction(instruction as *MIRStoreInstruction);
        } else if instruction->kind == MIRInstructionKind::ArrayGEP {
            return this.LowerArrayGEPInstruction(instruction as *MIRArrayGEPInstruction);
        } else if instruction->kind == MIRInstructionKind::StructGEP {
            return this.LowerStructGEPInstruction(instruction as *MIRStructGEPInstruction);
        } else if instruction->kind == MIRInstructionKind::Unary {
            return this.LowerUnaryInstruction(instruction as *MIRUnaryInstruction);
        } else if instruction->kind == MIRInstructionKind::Binary {
            return this.LowerBinaryInstruction(instruction as *MIRBinaryInstruction);
        } else if instruction->kind == MIRInstructionKind::Call {
            return this.LowerCallInstruction(instruction as *MIRCallInstruction);
        } else if instruction->kind == MIRInstructionKind::Cast {
            return this.LowerCastInstruction(instruction as *MIRCastInstruction);
        } else if instruction->kind == MIRInstructionKind::Select {
            return this.LowerSelectInstruction(instruction as *MIRSelectInstruction);
        } else if instruction->kind == MIRInstructionKind::Phi {
            return this.LowerPhiInstruction(instruction as *MIRPhiInstruction);
        } else if instruction->kind == MIRInstructionKind::Terminator {
            return this.LowerTerminator(instruction as *MIRTerminator);
        } else {
            return null;
        }
    }

    fn AlignOf(&this, _type: *MIRType) -> u32 {
        if _type->kind == MIRTypeKind::Integer {
            let width = (_type as *MIRIntegerType)->width;
            return width <= 8 ? 1 : width / 8;
        } else if _type->kind == MIRTypeKind::Float {
            let width = (_type as *MIRFloatType)->width;
            return width <= 8 ? 1 : width / 8;
        } else if _type->kind == MIRTypeKind::Pointer {
            return 4;
        } else if _type->kind == MIRTypeKind::Array {
            return this.AlignOf((_type as *MIRArrayType)->element);
        } else if _type->kind == MIRTypeKind::Structure {
            let mut alignment: u32 = 1;

            for field in (_type as *MIRStructureType)->fields {
                let field_alignment = this.AlignOf(field);

                if field_alignment > alignment {
                    alignment = field_alignment;
                }
            } return alignment;
        } else {
            return 1;
        }
    }

    fn SizeOf(&this, _type: *MIRType) -> u32 {
        if _type->kind == MIRTypeKind::Integer {
            let width = (_type as *MIRIntegerType)->width;
            return width <= 8 ? 1 : width / 8;
        } else if _type->kind == MIRTypeKind::Float {
            let width = (_type as *MIRFloatType)->width;
            return width <= 8 ? 1 : width / 8;
        } else if _type->kind == MIRTypeKind::Pointer {
            return 4;
        } else if _type->kind == MIRTypeKind::Array {
            let array = _type as *MIRArrayType;
            return this.SizeOf(array->element) * array->length as u32;
        } else if _type->kind == MIRTypeKind::Structure {
            let mut size: u32 = 0;
            let alignment = this.AlignOf(_type);

            for field in (_type as *MIRStructureType)->fields {
                let field_alignment = this.AlignOf(field);
                size = this.AlignUp(size, field_alignment);
                size += this.SizeOf(field);
            }

            return this.AlignUp(size, alignment);
        } else {
            return 0;
        }
    }

    fn AlignUp(&this, mut value: u32, alignment: u32) -> u32 {
        let remainder = value % alignment;

        if remainder != 0 {
            value += alignment - remainder;
        } return value;
    }

    fn EmitRType(&mut this, opcode: LIROpcode, rs1: *LIROperand, rs2: *LIROperand) -> *LIROperand {
        let destination = this.builder.VirtualRegister() as *LIRRegisterOperand;
        let mut defines = Vector<*LIROperand>();
        defines.PushBack(destination);
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(rs1);
        uses.PushBack(rs2);
        this.builder.BuildInstruction(opcode, defines, uses);
        return destination;
    }

    fn EmitIType(&mut this, opcode: LIROpcode, rs1: *LIROperand, immediate: *LIROperand) -> *LIROperand {
        let destination = this.builder.VirtualRegister() as *LIRRegisterOperand;
        let mut defines = Vector<*LIROperand>();
        defines.PushBack(destination);
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(rs1);
        uses.PushBack(immediate);
        this.builder.BuildInstruction(opcode, defines, uses);
        return destination;
    }

    fn EmitMove(&mut this, destination: *LIROperand, source: *LIROperand) {
        let mut defines = Vector<*LIROperand>();
        defines.PushBack(destination);
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(source);
        uses.PushBack(this.builder.ImmediateOperand(0) as *LIROperand);
        this.builder.BuildInstruction(LIROpcode::Addi, defines, uses);
    }

    fn EnsureRegister(&mut this, operand: *LIROperand) -> *LIROperand {
        if operand->kind == LIROperandKind::Register {
            return operand;
        } else if operand->kind == LIROperandKind::Immediate {
            return this.EmitIType(LIROpcode::Addi, this.builder.PhysicalRegister(0, "zero".ToString()) as *LIRRegisterOperand, operand);
        } else if operand->kind == LIROperandKind::Memory {
            let memory = operand as *LIRMemoryOperand;
            let base = this.EnsureRegister(memory->base);

            if memory->offset != 0 {
                return this.EmitIType(LIROpcode::Addi, base, this.builder.ImmediateOperand(memory->offset as i64));
            } return base;
        } else {
            return null;
        }
    }

    fn EnsureMemory(&mut this, operand: *LIROperand) -> *LIROperand {
        if operand->kind != LIROperandKind::Memory {
            let base = this.EnsureRegister(operand);
            if base == null { return null; }
            return this.builder.MemoryOperand(base, 0);
        } return operand;
    }

    fn LowerAllocaInstruction(&mut this, alloca: *MIRAllocaInstruction) -> *LIROperand {
        let size = this.SizeOf(alloca->_type);
        if size == 0 { return null; }
        let function = this.builder.GetCurrentFunction();
        function->frame_size = this.AlignUp(function->frame_size, this.AlignOf(alloca->_type));
        function->frame_size += size;
        let frame = this.builder.PhysicalRegister(5, "fp".ToString()) as *LIRRegisterOperand;
        return this.builder.MemoryOperand(frame, -(function->frame_size as i32)) as *LIROperand;
    }

    fn LowerLoadInstruction(&mut this, load: *MIRLoadInstruction) -> *LIROperand {
        let pointer = this.LowerValue(load->pointer);
        if pointer == null { return null; }
        let size = this.SizeOf(((load as *MIRInstruction) as *MIRValue)->_type);
        let opcode = size > 2 ? LIROpcode::Lw : (size > 1 ? LIROpcode::Lhu : LIROpcode::Lbu);
        let destination = this.builder.VirtualRegister() as *LIRRegisterOperand;
        let mut defines = Vector<*LIROperand>();
        defines.PushBack(destination);
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(this.EnsureMemory(pointer));
        this.builder.BuildInstruction(opcode, defines, uses);
        return destination;
    }

    fn LowerStoreInstruction(&mut this, store: *MIRStoreInstruction) -> *LIROperand {
        let value = this.LowerValue(store->value);
        let pointer = this.LowerValue(store->pointer);
        if value == null || pointer == null { return null; }
        let size = this.SizeOf(store->value->_type);
        let opcode = size > 2 ? LIROpcode::Sw : (size > 1 ? LIROpcode::Sh : LIROpcode::Sb);
        let defines = Vector<*LIROperand>();
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(this.EnsureRegister(value));
        uses.PushBack(this.EnsureMemory(pointer));
        this.builder.BuildInstruction(opcode, defines, uses);
        return null;
    }

    fn LowerArrayGEPInstruction(&mut this, gep: *MIRArrayGEPInstruction) -> *LIROperand {
        return null;
    }

    fn LowerStructGEPInstruction(&mut this, gep: *MIRStructGEPInstruction) -> *LIROperand {
        return null;
    }

    fn LowerUnaryInstruction(&mut this, unary: *MIRUnaryInstruction) -> *LIROperand {
        return null;
    }

    fn LowerBinaryInstruction(&mut this, binary: *MIRBinaryInstruction) -> *LIROperand {
        return null;
    }

    fn LowerCallInstruction(&mut this, call: *MIRCallInstruction) -> *LIROperand {
        return null;
    }

    fn LowerCastInstruction(&mut this, cast: *MIRCastInstruction) -> *LIROperand {
        return null;
    }

    fn LowerSelectInstruction(&mut this, select: *MIRSelectInstruction) -> *LIROperand {
        let condition = this.LowerValue(select->condition);
        if condition == null { return null; }
        let then_value = this.LowerValue(select->then_value);
        if then_value == null { return null; }
        let else_value = this.LowerValue(select->else_value);
        if else_value == null { return null; }
        return null;
    }

    fn LowerPhiInstruction(&mut this, phi: *MIRPhiInstruction) -> *LIROperand {
        return null;
    }

    fn LowerTerminator(&mut this, terminator: *MIRTerminator) -> *LIROperand {
        if terminator->kind == MIRTerminatorKind::Return {
            return this.LowerReturnInstruction(terminator as *MIRReturnInstruction);
        } else if terminator->kind == MIRTerminatorKind::Branch {
            return this.LowerBranchInstruction(terminator as *MIRBranchInstruction);
        } else if terminator->kind == MIRTerminatorKind::ConditionalBranch {
            return this.LowerConditionalBranchInstruction(terminator as *MIRConditionalBranchInstruction);
        } else if terminator->kind == MIRTerminatorKind::Unreachable {
            return this.LowerUnreachableInstruction(terminator as *MIRUnreachableInstruction);
        } else {
            return null;
        }
    }

    fn LowerReturnInstruction(&mut this, _return: *MIRReturnInstruction) -> *LIROperand {
        if _return->value != null {
            let value = this.LowerValue(_return->value);

            if value != null {
                this.EmitMove(this.builder.PhysicalRegister(24, "a0".ToString()) as *LIRRegisterOperand, this.EnsureRegister(value));
            }
        }

        let defines = Vector<*LIROperand>();
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(this.builder.PhysicalRegister(1, "ra".ToString()) as *LIRRegisterOperand);
        this.builder.BuildInstruction(LIROpcode::Br, defines, uses);
        return null;
    }

    fn LowerBranchInstruction(&mut this, branch: *MIRBranchInstruction) -> *LIROperand {
        let target = this.blocks.Get(branch->target, null);
        if target == null { return null; }
        let defines = Vector<*LIROperand>();
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(this.builder.BlockOperand(target));
        this.builder.BuildInstruction(LIROpcode::B, defines, uses);
        return null;
    }

    fn LowerConditionalBranchInstruction(&mut this, branch: *MIRConditionalBranchInstruction) -> *LIROperand {
        let condition = this.LowerValue(branch->condition);
        if condition == null { return null; }
        let then_target = this.blocks.Get(branch->then_target, null);
        if then_target == null { return null; }
        let else_target = this.blocks.Get(branch->else_target, null);
        if else_target == null { return null; }

        let bne_defines = Vector<*LIROperand>();
        let mut bne_uses = Vector<*LIROperand>();
        bne_uses.PushBack(this.EnsureRegister(condition));
        bne_uses.PushBack(this.builder.PhysicalRegister(0, "zero".ToString()) as *LIRRegisterOperand);
        bne_uses.PushBack(this.builder.BlockOperand(then_target));
        this.builder.BuildInstruction(LIROpcode::Bne, bne_defines, bne_uses);

        let b_defines = Vector<*LIROperand>();
        let mut b_uses = Vector<*LIROperand>();
        b_uses.PushBack(this.builder.BlockOperand(else_target));
        this.builder.BuildInstruction(LIROpcode::B, b_defines, b_uses);
        return null;
    }

    fn LowerUnreachableInstruction(&mut this, unreachable: *MIRUnreachableInstruction) -> *LIROperand {
        let defines = Vector<*LIROperand>();
        let uses = Vector<*LIROperand>();
        this.builder.BuildInstruction(LIROpcode::Hlt, defines, uses);
        return null;
    }
}
