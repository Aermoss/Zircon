#[include "std/str", "std/vec", "std/map",
    "src/MIR.zir", "src/LIR.zir", "src/Logger.zir" : *]

class LIRPhiEdge {
    pub from: *MIRBlock,
    pub to: *MIRBlock,
    pub block: *mut LIRBlock,
    pub index: usize;

    LIRPhiEdge(&mut this) {}

    LIRPhiEdge(&mut this, from: *MIRBlock, to: *MIRBlock, block: *mut LIRBlock, index: usize) {
        (this.from, this.to, this.block, this.index) = (from, to, block, index);
    }
}

class LIRConstant {
    pub symbol: String,
    pub value: i64 = 0,
    pub valid: bool = false;

    LIRConstant(&mut this) {}

    LIRConstant(&mut this, symbol: String, value: i64) {
        (this.symbol, this.value, this.valid) = (symbol, value, true);
    }
}

class LIRLowerer {
    pub context: LIRContext,
    builder: LIRBuilder,
    values: Map<*MIRValue, *LIROperand>,
    blocks: Map<*MIRBlock, *mut LIRBlock>,
    edges: Vector<LIRPhiEdge>,
    block: *MIRBlock = null,
    constant_index: u32 = 0,
    module: *mut LIRModule;

    LIRLowerer(&mut this) {}

    pub fn Lower(&mut this, module: *MIRModule) -> *LIRModule {
        this.module = this.context.arena.New<LIRModule>();
        this.builder = LIRBuilder(&mut this.context, this.module);
        this.LowerModule(module);
        this.module
    }

    fn LowerModule(&mut this, module: *MIRModule) {
        for declaration in module->declarations {
            this.LowerDeclaration(declaration);
        }
    }

    fn LowerDeclaration(&mut this, declaration: *MIRDeclaration) {
        match declaration->kind {
            MIRDeclarationKind::Function => {
                this.LowerFunctionDeclaration(declaration as *MIRFunctionDeclaration);
            },
            MIRDeclarationKind::Static => {
                let _static = declaration as *MIRStaticDeclaration;
                this.LowerGlobal(_static->name, _static->linkage == MIRDeclarationLinkage::External, _static->_type, _static->initializer);
            },
            MIRDeclarationKind::Constant => {
                let constant = declaration as *MIRConstantDeclaration;
                this.LowerGlobal(constant->name, true, constant->_type, constant->initializer);
            },
            MIRDeclarationKind::Assembly => {
                this.module->assembly.PushBack((declaration as *MIRAssemblyDeclaration)->text);
            },
            _ => {}
        }
    }

    fn Unsupported(&mut this, feature: *i8) -> *LIROperand {
        let function = this.builder.GetCurrentFunction();
        let location = if function != null { " (in '" + function->name + "')" } else { String() };
        Logger::Log(feature.ToString() + " is not supported by the Zodiac backend" + location + '.', LogSeverity::Error);
        null
    }

    fn LowerGlobal(&mut this, name: String, global: bool, _type: *MIRType, initializer: *MIRValue) -> *mut LIRGlobal {
        if initializer == null { return null; }
        let lowered = this.builder.BuildGlobal(name, global, this.AlignOf(_type), this.SizeOf(_type));
        this.WriteConstant(lowered, 0, initializer);
        lowered
    }

    fn WriteInteger(&mut this, global: *mut LIRGlobal, offset: u32, value: u64, size: u32) {
        for i in 0..size as usize {
            global->data[offset as usize + i] = ((value >> ((i * 8) as u64)) & 0xFF) as u8;
        }
    }

    fn WriteConstant(&mut this, global: *mut LIRGlobal, offset: u32, value: *MIRValue) {
        if value->kind == MIRValueKind::Constant {
            let constant = value as *MIRConstant;

            match constant->kind {
                MIRConstantKind::Integer => {
                    this.WriteInteger(global, offset, (constant as *MIRConstantInteger)->value, this.SizeOf(constant->_type));
                    return;
                },
                MIRConstantKind::Null => {
                    return;
                },
                MIRConstantKind::String => {
                    let string = (constant as *MIRConstantString)->value;

                    if constant->_type->kind == MIRTypeKind::Pointer {
                        global->relocations.PushBack(LIRRelocation(offset, this.LowerStringData(string)));
                        return;
                    }

                    let size = this.SizeOf(constant->_type) as usize;

                    for i in 0..string.Length() {
                        if i >= size { break; }
                        global->data[offset as usize + i] = string[i] as u8;
                    } return;
                },
                MIRConstantKind::Array => {
                    let element_size = this.SizeOf((constant->_type as *MIRArrayType)->element);
                    let elements = (constant as *MIRConstantArray)->elements;

                    for i in 0..elements.Length() {
                        this.WriteConstant(global, offset + i as u32 * element_size, elements[i]);
                    } return;
                },
                MIRConstantKind::Structure => {
                    let _type = constant->_type as *MIRStructureType;
                    let fields = (constant as *MIRConstantStructure)->fields;

                    for i in 0..fields.Length() {
                        this.WriteConstant(global, offset + this.FieldOffset(_type, i as u32), fields[i]);
                    } return;
                },
                MIRConstantKind::Float => {
                    this.Unsupported("Floating point constant");
                    return;
                },
                _ => {}
            }
        }

        let result = this.EvaluateConstant(value);

        if !result.valid {
            Logger::Log("Global '" + global->name + "' has an initializer that cannot be evaluated at compile time.", LogSeverity::Error);
        } else if result.symbol.Empty() {
            this.WriteInteger(global, offset, result.value as u64, this.SizeOf(value->_type));
        } else if result.value != 0 {
            Logger::Log("Global '" + global->name + "' has an initializer with a symbol offset, which is not supported by the Zodiac backend.", LogSeverity::Error);
        } else {
            global->relocations.PushBack(LIRRelocation(offset, result.symbol));
        }
    }

    fn LowerStringData(&mut this, value: &String) -> String {
        let name = ".Lstring." + String::FromInteger(this.constant_index as u64);
        this.constant_index += 1;
        let global = this.builder.BuildGlobal(name, false, 1, (value.Length() + 1) as u32);

        for i in 0..value.Length() {
            global->data[i] = value[i] as u8;
        }

        name
    }

    fn EvaluateConstant(&mut this, value: *MIRValue) -> LIRConstant {
        match value->kind {
            MIRValueKind::DeclarationReference => {
                return LIRConstant((value as *MIRDeclarationReference)->declaration->name, 0);
            },
            MIRValueKind::Constant => {},
            _ => {
                return LIRConstant();
            }
        }

        let constant = value as *MIRConstant;

        match constant->kind {
            MIRConstantKind::Integer => {
                return LIRConstant(String(), (constant as *MIRConstantInteger)->value as i64);
            },
            MIRConstantKind::Null | MIRConstantKind::Undef => {
                return LIRConstant(String(), 0);
            },
            MIRConstantKind::Expression => {},
            _ => {
                return LIRConstant();
            }
        }

        let expression = constant as *MIRConstantExpression;

        match expression->kind {
            MIRConstantExpressionKind::Cast => {
                let cast = expression as *MIRCastExpression;
                let mut result = this.EvaluateConstant(cast->value);
                if !result.valid || !result.symbol.Empty() { return result; }
                let source_width = this.IntegerWidth(cast->value->_type);

                match cast->kind {
                    MIRCastKind::Trunc => {
                        result.value = this.TruncateValue(result.value, this.IntegerWidth(cast->_type));
                    },
                    MIRCastKind::ZExt => {
                        result.value = this.TruncateValue(result.value, source_width);
                    },
                    MIRCastKind::SExt => {
                        result.value = this.SignExtendValue(result.value, source_width);
                    },
                    MIRCastKind::Bitcast | MIRCastKind::PtrToInt | MIRCastKind::IntToPtr => {},
                    _ => {
                        return LIRConstant();
                    }
                }

                result
            },
            MIRConstantExpressionKind::ArrayGEP => {
                let gep = expression as *MIRArrayGEPExpression;
                let mut result = this.EvaluateConstant(gep->pointer);
                let index = this.EvaluateConstant(gep->index);
                if !result.valid || !index.valid || !index.symbol.Empty() { return LIRConstant(); }
                result.value += index.value * this.SizeOf((gep->pointer->_type as *MIRPointerType)->pointee) as i64;
                result
            },
            MIRConstantExpressionKind::StructGEP => {
                let gep = expression as *MIRStructGEPExpression;
                let mut result = this.EvaluateConstant(gep->pointer);
                if !result.valid { return result; }
                result.value += this.FieldOffset((gep->pointer->_type as *MIRPointerType)->pointee as *MIRStructureType, gep->index) as i64;
                result
            },
            MIRConstantExpressionKind::Unary => {
                let unary = expression as *MIRUnaryExpression;
                let mut result = this.EvaluateConstant(unary->operand);
                if !result.valid || !result.symbol.Empty() { return LIRConstant(); }

                match unary->kind {
                    MIRUnaryKind::Neg => {
                        result.value = -result.value;
                    },
                    MIRUnaryKind::Not => {
                        result.value = !result.value;
                    },
                    _ => {
                        return LIRConstant();
                    }
                }

                result
            },
            MIRConstantExpressionKind::Binary => {
                let binary = expression as *MIRBinaryExpression;
                let mut left = this.EvaluateConstant(binary->left);
                let right = this.EvaluateConstant(binary->right);
                if !left.valid || !right.valid || !right.symbol.Empty() { return LIRConstant(); }
                let width = this.IntegerWidth(binary->left->_type);

                match binary->kind {
                    MIRBinaryKind::Add => {
                        left.value += right.value;
                        return left;
                    },
                    MIRBinaryKind::Sub => {
                        left.value -= right.value;
                        return left;
                    },
                    _ if !left.symbol.Empty() => {
                        return LIRConstant();
                    },
                    _ => {}
                }

                let (a, b) = (this.SignExtendValue(left.value, width), this.SignExtendValue(right.value, width));
                let ua = (this.TruncateValue(left.value, width) as u64) & 0xFFFFFFFF;
                let ub = (this.TruncateValue(right.value, width) as u64) & 0xFFFFFFFF;

                match binary->kind {
                    MIRBinaryKind::Mul => { left.value = a * b; },
                    MIRBinaryKind::SDiv if b != 0 => { left.value = a / b; },
                    MIRBinaryKind::SRem if b != 0 => { left.value = a % b; },
                    MIRBinaryKind::UDiv if ub != 0 => { left.value = (ua / ub) as i64; },
                    MIRBinaryKind::URem if ub != 0 => { left.value = (ua % ub) as i64; },
                    MIRBinaryKind::And => { left.value = a & b; },
                    MIRBinaryKind::Or => { left.value = a | b; },
                    MIRBinaryKind::Xor => { left.value = a ^ b; },
                    MIRBinaryKind::Shl => { left.value = a << (b & 31); },
                    MIRBinaryKind::LShr => { left.value = (ua >> (ub & 31)) as i64; },
                    MIRBinaryKind::AShr => { left.value = a >> (b & 31); },
                    _ => { return LIRConstant(); }
                }
                left
            }
        }
    }

    fn LowerFunctionDeclaration(&mut this, function: *MIRFunctionDeclaration) {
        let lowered = this.builder.BuildFunction(function->name);
        lowered->global = function->linkage == MIRDeclarationLinkage::External;
        if function->blocks.Empty() { return; }
        lowered->frame_size = 8;
        this.builder.SetCurrentFunction(lowered);
        this.blocks.Clear();
        this.edges.Clear();
        this.values.Clear();

        for block in function->blocks {
            this.blocks[block] = this.builder.BuildBlock(block->name);
        }

        this.builder.SetCurrentBlock(this.blocks[function->blocks[0]]);

        for i in 0..function->parameters.Length() {
            let destination = this.builder.VirtualRegister();

            if i < LIR_ARGUMENT_COUNT {
                this.EmitMove(destination, this.Physical(LIR_A0 + (i as u8)));
            } else {
                this.Emit(LIROpcode::Lw, destination, this.builder.MemoryOperand(this.Physical(LIR_FP), ((i - LIR_ARGUMENT_COUNT) * 4) as i32), null);
            }

            this.values[function->parameters[i]] = destination;
        }

        for block in function->blocks {
            this.block = block;
            this.builder.SetCurrentBlock(this.blocks[block]);

            for instruction in block->instructions {
                this.values[instruction] = this.LowerInstruction(instruction);
            }

            if block->terminator != null {
                this.LowerTerminator(block->terminator);
            }
        }

        this.LowerPhiCopies();
        this.OptimizeFunction(lowered);
        this.builder.SetCurrentFunction(null);
    }

    fn VirtualIndex(&this, operand: *LIROperand) -> i64 {
        if operand != null && operand->kind == LIROperandKind::Memory {
            return this.VirtualIndex((operand as *LIRMemoryOperand)->base);
        } else if operand != null && operand->kind == LIROperandKind::Register && (operand as *LIRRegisterOperand)->kind == LIRRegisterKind::Virtual {
            return (operand as *LIRVirtualRegister)->index as i64;
        }

        -1
    }

    fn IsPure(&this, instruction: *LIRInstruction) -> bool {
        let opcode = instruction->opcode;
        (opcode >= LIROpcode::Slt && opcode <= LIROpcode::Srai) || opcode == LIROpcode::Li || opcode == LIROpcode::La
    }

    fn IsZero(&this, operand: *LIROperand) -> bool {
        operand->kind == LIROperandKind::Register && (operand as *LIRRegisterOperand)->kind == LIRRegisterKind::Physical
            && (operand as *LIRPhysicalRegister)->index == LIR_ZERO
    }

    fn IsImmediateValue(&this, operand: *LIROperand, value: i64) -> bool {
        this.IsImmediate(operand) && this.ImmediateValue(operand) == value
    }

    fn OptimizeFunction(&mut this, function: *mut LIRFunction) {
        let count = function->register_index as usize;
        let mut uses = Vector<u32>();
        let mut defines = Vector<u32>();
        let mut definers = Vector<*LIRInstruction>();

        for i in 0..count {
            uses.PushBack(0);
            defines.PushBack(0);
            definers.PushBack(null);
        }

        for block in function->blocks {
            for instruction in block->instructions {
                for operand in instruction->uses {
                    let index = this.VirtualIndex(operand);
                    if index >= 0 { uses[index as usize] += 1; }
                }

                for operand in instruction->defines {
                    let index = this.VirtualIndex(operand);

                    if index >= 0 {
                        defines[index as usize] += 1;
                        definers[index as usize] = instruction;
                    }
                }
            }
        }

        for block in function->blocks {
            let size = block->instructions.Length();
            if size < 2 { continue; }
            let branch = block->instructions[size - 2];
            if branch->opcode != LIROpcode::Bne || block->instructions[size - 1]->opcode != LIROpcode::B { continue; }
            let condition = this.VirtualIndex(branch->uses[0]);
            if condition < 0 || uses[condition as usize] != 1 || defines[condition as usize] != 1 { continue; }
            let mut definer = definers[condition as usize];
            let mut inverted = false;

            if definer->opcode == LIROpcode::Xori && this.IsImmediateValue(definer->uses[1], 1) {
                let inner = this.VirtualIndex(definer->uses[0]);
                if inner < 0 || uses[inner as usize] != 1 || defines[inner as usize] != 1 { continue; }
                (definer, inverted) = (definers[inner as usize], true);
            }

            let position = match block->instructions.Index(definer) {
                Option<usize>::Some(position) => position,
                Option<usize>::None => continue
            };

            if definer->uses.Length() != 2 { continue; }
            let mut left = definer->uses[0];
            let mut right = definer->uses[1];
            let mut stable = true;

            for operand in definer->uses {
                let index = this.VirtualIndex(operand);
                if operand->kind != LIROperandKind::Register || this.IsZero(operand) { continue; }
                if index < 0 || index as usize >= count { stable = false; continue; }
                if defines[index as usize] == 1 { continue; }

                for k in (position + 1)..(size - 2) {
                    for other in block->instructions[k]->defines {
                        if this.VirtualIndex(other) == index { stable = false; }
                    }
                }
            }

            if !stable { continue; }
            let mut opcode = LIROpcode::Nop;

            match definer->opcode {
                LIROpcode::Sltiu if this.IsImmediateValue(right, 1) => {
                    (opcode, right) = (if inverted { LIROpcode::Bne } else { LIROpcode::Beq }, this.Zero());
                },
                LIROpcode::Sltu if this.IsZero(left) => {
                    (opcode, left, right) = (if inverted { LIROpcode::Beq } else { LIROpcode::Bne }, right, this.Zero());
                },
                LIROpcode::Slt | LIROpcode::Slti => {
                    opcode = if inverted { LIROpcode::Bge } else { LIROpcode::Blt };
                },
                LIROpcode::Sltu | LIROpcode::Sltiu => {
                    opcode = if inverted { LIROpcode::Bgeu } else { LIROpcode::Bltu };
                },
                _ => {
                    continue;
                }
            }

            let mut fused = Vector<*LIRInstruction>();

            for i in 0..(size - 2) {
                fused.PushBack(block->instructions[i]);
            }

            for operand in definer->uses {
                let index = this.VirtualIndex(operand);
                if index >= 0 { uses[index as usize] += 1; }
            }

            if this.IsImmediateValue(right, 0) {
                right = this.Zero();
            } else if this.IsImmediate(right) {
                let register = this.builder.VirtualRegister();
                let mut li_defines = Vector<*LIROperand>();
                li_defines.PushBack(register);
                let mut li_uses = Vector<*LIROperand>();
                li_uses.PushBack(right);
                fused.PushBack(this.context.arena.New<LIRInstruction>(LIROpcode::Li, li_defines, li_uses));
                right = register;
            }

            let branch_defines = Vector<*LIROperand>();
            let mut branch_uses = Vector<*LIROperand>();
            branch_uses.PushBack(left);
            branch_uses.PushBack(right);
            branch_uses.PushBack(branch->uses[2]);
            fused.PushBack(this.context.arena.New<LIRInstruction>(opcode, branch_defines, branch_uses));
            fused.PushBack(block->instructions[size - 1]);
            block->instructions = fused;
            uses[condition as usize] = 0;
        }

        let mut changed = true;

        while changed {
            changed = false;

            for block in function->blocks {
                let mut kept = Vector<*LIRInstruction>();

                for instruction in block->instructions {
                    let mut dead = this.IsPure(instruction) && !instruction->defines.Empty();

                    for operand in instruction->defines {
                        let index = this.VirtualIndex(operand);
                        if index < 0 || index as usize >= count || uses[index as usize] != 0 { dead = false; }
                    }

                    if !dead {
                        kept.PushBack(instruction);
                        continue;
                    }

                    for operand in instruction->uses {
                        let index = this.VirtualIndex(operand);
                        if index >= 0 && (index as usize) < count { uses[index as usize] -= 1; }
                    } changed = true;
                }

                block->instructions = kept;
            }
        }
    }

    fn HasPhis(&this, block: *MIRBlock) -> bool {
        for instruction in block->instructions {
            if instruction->kind == MIRInstructionKind::Phi {
                return true;
            }
        }

        false
    }

    fn EdgeTarget(&mut this, to: *MIRBlock, conditional: bool) -> *LIRBlock {
        let target = this.blocks[to];
        if !this.HasPhis(to) { return target; }
        let current = this.builder.GetCurrentBlock();

        if !conditional {
            this.edges.PushBack(LIRPhiEdge(this.block, to, current, current->instructions.Length()));
            return target;
        }

        let split = this.builder.BuildBlock(this.block->name + ".to." + to->name);
        this.edges.PushBack(LIRPhiEdge(this.block, to, split, 0));
        this.builder.SetCurrentBlock(split);
        this.EmitBranch(target);
        this.builder.SetCurrentBlock(current);
        split
    }

    fn EmitParallelCopy(&mut this, destinations: &Vector<*LIROperand>, initial_sources: &Vector<*LIROperand>) {
        let mut sources: Vector<*LIROperand> = initial_sources;
        let mut pending = Vector<usize>();

        for i in 0..destinations.Length() {
            if destinations[i] != sources[i] {
                pending.PushBack(i);
            }
        }

        while !pending.Empty() {
            let mut ready: i64 = -1;

            for k in 0..pending.Length() {
                let mut blocked = false;

                for other in pending {
                    if other != pending[k] && sources[other] == destinations[pending[k]] {
                        blocked = true;
                    }
                }

                if !blocked {
                    ready = k as i64;
                    break;
                }
            }

            if ready >= 0 {
                let i = pending.RemoveAt(ready as usize);
                this.EmitMove(destinations[i], sources[i]);
                continue;
            }

            let saved = destinations[pending[0]];
            let temporary = this.builder.VirtualRegister();
            this.EmitMove(temporary, saved);

            for other in pending {
                if sources[other] == saved {
                    sources[other] = temporary;
                }
            }
        }
    }

    fn IsUndef(&this, value: *MIRValue) -> bool {
        value->kind == MIRValueKind::Constant && (value as *MIRConstant)->kind == MIRConstantKind::Undef
    }

    fn LowerPhiCopies(&mut this) {
        for edge in this.edges {
            let mut scratch = LIRBlock("".ToString());
            this.builder.SetCurrentBlock(&mut scratch);
            let mut destinations = Vector<*LIROperand>();
            let mut sources = Vector<*LIROperand>();

            for instruction in edge.to->instructions {
                if instruction->kind != MIRInstructionKind::Phi { continue; }
                let phi = instruction as *MIRPhiInstruction;
                let destination = this.values.Get(phi as *MIRValue, null);
                if destination == null { continue; }

                for incoming in phi->incomings {
                    if incoming.block == edge.from {
                        if this.IsUndef(incoming.value) { break; }
                        destinations.PushBack(destination);
                        sources.PushBack(this.EnsureRegister(this.LowerValue(incoming.value)));
                        break;
                    }
                }
            }

            this.EmitParallelCopy(destinations, sources);

            for i in 0..scratch.instructions.Length() {
                edge.block->instructions.Insert(edge.index + i, scratch.instructions[i]);
            }
        }

        this.builder.SetCurrentBlock(null);
    }

    fn LowerValue(&mut this, value: *MIRValue) -> *LIROperand {
        if value == null {
            return null;
        }

        match value->kind {
            MIRValueKind::Constant => this.LowerConstant(value as *MIRConstant),
            MIRValueKind::Instruction | MIRValueKind::Parameter => {
                if !this.values.Has(value) {
                    this.Unsupported("Using a value before its definition");
                }

                this.values.Get(value, null)
            },
            MIRValueKind::DeclarationReference => this.builder.SymbolOperand((value as *MIRDeclarationReference)->declaration->name)
        }
    }

    fn LowerConstant(&mut this, constant: *MIRConstant) -> *LIROperand {
        match constant->kind {
            MIRConstantKind::Integer => this.Immediate(this.TruncateValue((constant as *MIRConstantInteger)->value as i64, this.IntegerWidth(constant->_type))),
            MIRConstantKind::Null | MIRConstantKind::Undef => this.Immediate(0),
            MIRConstantKind::Float => this.Unsupported("Floating point"),
            MIRConstantKind::Expression => {
                let result = this.EvaluateConstant(constant);
                if !result.valid { return this.Unsupported("This constant expression"); }

                if result.symbol.Empty() {
                    return this.Immediate(this.TruncateValue(result.value, this.IntegerWidth(constant->_type)));
                }

                this.builder.MemoryOperand(this.EnsureRegister(this.builder.SymbolOperand(result.symbol)), result.value as i32)
            },
            MIRConstantKind::String if constant->_type->kind == MIRTypeKind::Pointer => this.builder.SymbolOperand(this.LowerStringData((constant as *MIRConstantString)->value)),
            _ => {
                let name = ".Lconstant." + String::FromInteger(this.constant_index as u64);
                this.constant_index += 1;
                this.LowerGlobal(name, false, constant->_type, constant);
                this.builder.SymbolOperand(name)
            }
        }
    }

    fn LowerInstruction(&mut this, instruction: *MIRInstruction) -> *LIROperand {
        match instruction->kind {
            MIRInstructionKind::Alloca => this.LowerAllocaInstruction(instruction as *MIRAllocaInstruction),
            MIRInstructionKind::Load => this.LowerLoadInstruction(instruction as *MIRLoadInstruction),
            MIRInstructionKind::Store => this.LowerStoreInstruction(instruction as *MIRStoreInstruction),
            MIRInstructionKind::ArrayGEP => {
                let gep = instruction as *MIRArrayGEPInstruction;
                this.LowerArrayGEP(gep->pointer, gep->index)
            },
            MIRInstructionKind::StructGEP => {
                let gep = instruction as *MIRStructGEPInstruction;
                this.LowerStructGEP(gep->pointer, gep->index)
            },
            MIRInstructionKind::Unary => {
                let unary = instruction as *MIRUnaryInstruction;
                this.LowerUnary(unary->kind, unary->operand, unary->_type)
            },
            MIRInstructionKind::Binary => {
                let binary = instruction as *MIRBinaryInstruction;
                this.LowerBinary(binary->kind, binary->left, binary->right)
            },
            MIRInstructionKind::Call => this.LowerCallInstruction(instruction as *MIRCallInstruction),
            MIRInstructionKind::Cast => {
                let cast = instruction as *MIRCastInstruction;
                this.LowerCast(cast->kind, cast->value, cast->_type)
            },
            MIRInstructionKind::Select => this.LowerSelectInstruction(instruction as *MIRSelectInstruction),
            MIRInstructionKind::Phi => this.LowerPhiInstruction(instruction as *MIRPhiInstruction),
            MIRInstructionKind::Assembly => this.LowerAssemblyInstruction(instruction as *MIRAssemblyInstruction),
            MIRInstructionKind::Terminator => {
                this.LowerTerminator(instruction as *MIRTerminator);
                null
            }
        }
    }

    fn IntegerWidth(&this, _type: *MIRType) -> u32 {
        if _type == null {
            return 0;
        }

        match _type->kind {
            MIRTypeKind::Integer => (_type as *MIRIntegerType)->width,
            MIRTypeKind::Pointer | MIRTypeKind::Function => 32,
            _ => 0
        }
    }

    fn IsAggregate(&this, _type: *MIRType) -> bool {
        _type != null && (_type->kind == MIRTypeKind::Array || _type->kind == MIRTypeKind::Structure)
    }

    fn AlignOf(&this, _type: *MIRType) -> u32 {
        match _type->kind {
            MIRTypeKind::Integer => {
                let width = (_type as *MIRIntegerType)->width;
                if width <= 8 { 1 } else { width / 8 }
            },
            MIRTypeKind::Float => {
                let width = (_type as *MIRFloatType)->width;
                if width <= 8 { 1 } else { width / 8 }
            },
            MIRTypeKind::Pointer => 4,
            MIRTypeKind::Array => this.AlignOf((_type as *MIRArrayType)->element),
            MIRTypeKind::Structure => {
                let mut alignment: u32 = 1;

                for field in (_type as *MIRStructureType)->fields {
                    let field_alignment = this.AlignOf(field);

                    if field_alignment > alignment {
                        alignment = field_alignment;
                    }
                }

                alignment
            },
            _ => 1
        }
    }

    fn SizeOf(&this, _type: *MIRType) -> u32 {
        match _type->kind {
            MIRTypeKind::Integer => {
                let width = (_type as *MIRIntegerType)->width;
                if width <= 8 { 1 } else { width / 8 }
            },
            MIRTypeKind::Float => {
                let width = (_type as *MIRFloatType)->width;
                if width <= 8 { 1 } else { width / 8 }
            },
            MIRTypeKind::Pointer => 4,
            MIRTypeKind::Array => {
                let array = _type as *MIRArrayType;
                this.SizeOf(array->element) * array->length as u32
            },
            MIRTypeKind::Structure => {
                let mut size: u32 = 0;
                let alignment = this.AlignOf(_type);

                for field in (_type as *MIRStructureType)->fields {
                    let field_alignment = this.AlignOf(field);
                    size = this.AlignUp(size, field_alignment);
                    size += this.SizeOf(field);
                }

                this.AlignUp(size, alignment)
            },
            _ => 0
        }
    }

    fn AlignUp(&this, mut value: u32, alignment: u32) -> u32 {
        if alignment <= 1 { return value; }
        let remainder = value % alignment;

        if remainder != 0 {
            value += alignment - remainder;
        }

        value
    }

    fn FieldOffset(&this, _type: *MIRStructureType, index: u32) -> u32 {
        let mut offset: u32 = 0;

        for i in 0..index as usize {
            let field = _type->fields[i];
            let field_alignment = this.AlignOf(field);
            offset = this.AlignUp(offset, field_alignment);
            offset += this.SizeOf(field);
        }

        if index as usize < _type->fields.Length() {
            offset = this.AlignUp(offset, this.AlignOf(_type->fields[index as usize]));
        }

        offset
    }

    fn TruncateValue(&this, value: i64, width: u32) -> i64 {
        if width == 0 || width >= 32 { return (((value as u64) & 0xFFFFFFFF) as u32) as i32 as i64; }
        ((value as u64) & ((1u64 << (width as u64)) - 1)) as i64
    }

    fn SignExtendValue(&this, value: i64, width: u32) -> i64 {
        let bits = if width == 0 || width > 32 { 32 } else { width };
        let shift = (64 - bits) as i64;
        (value << shift) >> shift
    }

    fn FitsSigned16(&this, value: i64) -> bool {
        value >= -32768 && value <= 32767
    }

    fn FitsUnsigned16(&this, value: i64) -> bool {
        value >= 0 && value <= 65535
    }

    fn Log2(&this, value: i64) -> i64 {
        if value <= 0 || (value & (value - 1)) != 0 { return -1; }
        let mut result: i64 = 0;

        while (1i64 << result) < value {
            result += 1;
        }

        result
    }

    fn IsImmediate(&this, operand: *LIROperand) -> bool {
        operand != null && operand->kind == LIROperandKind::Immediate
    }

    fn ImmediateValue(&this, operand: *LIROperand) -> i64 {
        (operand as *LIRImmediateOperand)->value
    }

    fn Immediate(&mut this, value: i64) -> *LIROperand {
        this.builder.ImmediateOperand(value)
    }

    fn Physical(&mut this, index: u8) -> *LIROperand {
        this.builder.PhysicalRegister(index)
    }

    fn Zero(&mut this) -> *LIROperand {
        this.Physical(LIR_ZERO)
    }

    fn Emit(&mut this, opcode: LIROpcode, destination: *LIROperand, first: *LIROperand, second: *LIROperand) -> *mut LIRInstruction {
        let mut defines = Vector<*LIROperand>();
        if destination != null { defines.PushBack(destination); }
        let mut uses = Vector<*LIROperand>();
        if first != null { uses.PushBack(first); }
        if second != null { uses.PushBack(second); }
        this.builder.BuildInstruction(opcode, defines, uses)
    }

    fn EmitValue(&mut this, opcode: LIROpcode, first: *LIROperand, second: *LIROperand) -> *LIROperand {
        let destination = this.builder.VirtualRegister();
        this.Emit(opcode, destination, first, second);
        destination
    }

    fn EmitMove(&mut this, destination: *LIROperand, source: *LIROperand) {
        this.Emit(LIROpcode::Addi, destination, source, this.Immediate(0));
    }

    fn EmitBranch(&mut this, target: *LIRBlock) {
        this.Emit(LIROpcode::B, null, this.builder.BlockOperand(target), null);
    }

    fn EmitAddImmediate(&mut this, base: *LIROperand, value: i64) -> *LIROperand {
        if value == 0 {
            base
        } else if this.FitsSigned16(value) {
            this.EmitValue(LIROpcode::Addi, base, this.Immediate(value))
        } else {
            this.EmitValue(LIROpcode::Add, base, this.EmitValue(LIROpcode::Li, this.Immediate(value), null))
        }
    }

    fn EnsureRegister(&mut this, operand: *LIROperand) -> *LIROperand {
        if operand == null {
            return this.Zero();
        }

        match operand->kind {
            LIROperandKind::Register => operand,
            LIROperandKind::Immediate => {
                if this.ImmediateValue(operand) == 0 { return this.Zero(); }
                this.EmitValue(LIROpcode::Li, operand, null)
            },
            LIROperandKind::Memory => {
                let memory = operand as *LIRMemoryOperand;
                this.EmitAddImmediate(this.EnsureRegister(memory->base), memory->offset as i64)
            },
            LIROperandKind::Symbol => this.EmitValue(LIROpcode::La, operand, null),
            _ => this.Zero()
        }
    }

    fn EnsureMemory(&mut this, operand: *LIROperand) -> *LIRMemoryOperand {
        if operand != null && operand->kind == LIROperandKind::Memory {
            operand as *LIRMemoryOperand
        } else if this.IsImmediate(operand) {
            let value = this.ImmediateValue(operand);
            if this.FitsSigned16(value) { return this.builder.MemoryOperand(this.Zero(), value as i32); }
            let low = value & 0x7FF;
            this.builder.MemoryOperand(this.EnsureRegister(this.Immediate(value - low)), low as i32)
        } else {
            this.builder.MemoryOperand(this.EnsureRegister(operand), 0)
        }
    }

    fn LegalMemory(&mut this, memory: *LIRMemoryOperand, size: u32) -> *LIRMemoryOperand {
        if this.FitsSigned16(memory->offset as i64) && this.FitsSigned16(memory->offset as i64 + size as i64) {
            return memory;
        }

        this.builder.MemoryOperand(this.EnsureRegister(memory), 0)
    }

    fn ZeroExtend(&mut this, operand: *LIROperand, width: u32) -> *LIROperand {
        if this.IsImmediate(operand) { return this.Immediate(this.TruncateValue(this.ImmediateValue(operand), width)); }
        let register = this.EnsureRegister(operand);
        if width >= 32 { return register; }
        if width <= 16 { return this.EmitValue(LIROpcode::Andi, register, this.Immediate((1i64 << (width as i64)) - 1)); }
        let shift = this.Immediate((32 - width) as i64);
        this.EmitValue(LIROpcode::Srli, this.EmitValue(LIROpcode::Slli, register, shift), shift)
    }

    fn SignExtend(&mut this, operand: *LIROperand, width: u32) -> *LIROperand {
        if this.IsImmediate(operand) { return this.Immediate(this.SignExtendValue(this.ImmediateValue(operand), width)); }
        let register = this.EnsureRegister(operand);
        if width >= 32 { return register; }
        let shift = this.Immediate((32 - width) as i64);
        this.EmitValue(LIROpcode::Srai, this.EmitValue(LIROpcode::Slli, register, shift), shift)
    }

    fn AllocateStack(&mut this, size: u32, alignment: u32) -> *LIRMemoryOperand {
        let function = this.builder.GetCurrentFunction();
        function->frame_size = this.AlignUp(function->frame_size + size, if alignment > 4 { 4 } else { alignment });
        this.builder.MemoryOperand(this.Physical(LIR_FP), -(function->frame_size as i32))
    }

    fn CopyMemory(&mut this, destination: *LIRMemoryOperand, source: *LIRMemoryOperand, size: u32, alignment: u32) {
        let unit: u32 = if alignment >= 4 && size % 4 == 0 { 4 } else if alignment >= 2 && size % 2 == 0 { 2 } else { 1 };
        let load = if unit == 4 { LIROpcode::Lw } else if unit == 2 { LIROpcode::Lhu } else { LIROpcode::Lbu };
        let store = if unit == 4 { LIROpcode::Sw } else if unit == 2 { LIROpcode::Sh } else { LIROpcode::Sb };
        let legal_source = this.LegalMemory(source, size);
        let legal_destination = this.LegalMemory(destination, size);
        let mut offset: u32 = 0;

        while offset < size {
            let value = this.EmitValue(load, this.builder.MemoryOperand(legal_source->base, legal_source->offset + offset as i32), null);
            this.Emit(store, null, value, this.builder.MemoryOperand(legal_destination->base, legal_destination->offset + offset as i32));
            offset += unit;
        }
    }

    fn LoadOpcode(&this, size: u32) -> LIROpcode {
        if size == 1 { LIROpcode::Lbu } else if size == 2 { LIROpcode::Lhu } else { LIROpcode::Lw }
    }

    fn StoreOpcode(&this, size: u32) -> LIROpcode {
        if size == 1 { LIROpcode::Sb } else if size == 2 { LIROpcode::Sh } else { LIROpcode::Sw }
    }

    fn IsScalar(&this, _type: *MIRType) -> bool {
        let width = this.IntegerWidth(_type);
        width > 0 && width <= 32
    }

    fn LowerAllocaInstruction(&mut this, alloca: *MIRAllocaInstruction) -> *LIROperand {
        this.AllocateStack(this.SizeOf(alloca->_type), this.AlignOf(alloca->_type))
    }

    fn LowerLoadInstruction(&mut this, load: *MIRLoadInstruction) -> *LIROperand {
        let pointer = this.LowerValue(load->pointer);
        if pointer == null { return null; }
        let (size, alignment) = (this.SizeOf(load->_type), this.AlignOf(load->_type));

        if this.IsAggregate(load->_type) {
            let temporary = this.AllocateStack(size, alignment);
            this.CopyMemory(temporary, this.EnsureMemory(pointer), size, alignment);
            return temporary;
        } else if !this.IsScalar(load->_type) {
            return this.Unsupported(if load->_type->kind == MIRTypeKind::Float { "Floating point" } else { "64-bit integer arithmetic" });
        }

        this.EmitValue(this.LoadOpcode(size), this.LegalMemory(this.EnsureMemory(pointer), size), null)
    }

    fn LowerStoreInstruction(&mut this, store: *MIRStoreInstruction) -> *LIROperand {
        let value = this.LowerValue(store->value);
        let pointer = this.LowerValue(store->pointer);
        if value == null || pointer == null { return null; }
        let _type = store->value->_type;
        let (size, alignment) = (this.SizeOf(_type), this.AlignOf(_type));

        if this.IsAggregate(_type) {
            this.CopyMemory(this.EnsureMemory(pointer), this.EnsureMemory(value), size, alignment);
            return null;
        } else if !this.IsScalar(_type) {
            return this.Unsupported(if _type->kind == MIRTypeKind::Float { "Floating point" } else { "64-bit integer arithmetic" });
        }

        let source = this.EnsureRegister(value);
        this.Emit(this.StoreOpcode(size), null, source, this.LegalMemory(this.EnsureMemory(pointer), size));
        null
    }

    fn LowerArrayGEP(&mut this, pointer_value: *MIRValue, index_value: *MIRValue) -> *LIROperand {
        let pointer = this.LowerValue(pointer_value);
        let index = this.LowerValue(index_value);
        if pointer == null || index == null { return null; }
        let element_size = this.SizeOf((pointer_value->_type as *MIRPointerType)->pointee) as i64;
        let base = this.EnsureMemory(pointer);

        if this.IsImmediate(index) {
            return this.builder.MemoryOperand(base->base, (base->offset as i64 + this.ImmediateValue(index) * element_size) as i32);
        } else if element_size == 0 {
            return base;
        }

        let mut scaled = this.EnsureRegister(index);
        let shift = this.Log2(element_size);

        if shift > 0 {
            scaled = this.EmitValue(LIROpcode::Slli, scaled, this.Immediate(shift));
        } else if shift < 0 {
            scaled = this.EmitValue(LIROpcode::Mul, scaled, this.EnsureRegister(this.Immediate(element_size)));
        }

        this.builder.MemoryOperand(this.EmitValue(LIROpcode::Add, base->base, scaled), base->offset)
    }

    fn LowerStructGEP(&mut this, pointer_value: *MIRValue, index: u32) -> *LIROperand {
        let pointer = this.LowerValue(pointer_value);
        if pointer == null { return null; }
        let base = this.EnsureMemory(pointer);
        let _type = (pointer_value->_type as *MIRPointerType)->pointee as *MIRStructureType;
        this.builder.MemoryOperand(base->base, base->offset + this.FieldOffset(_type, index) as i32)
    }

    fn LowerUnary(&mut this, kind: MIRUnaryKind, operand_value: *MIRValue, _type: *MIRType) -> *LIROperand {
        if kind == MIRUnaryKind::FNeg || !this.IsScalar(_type) {
            return this.Unsupported(if kind == MIRUnaryKind::FNeg { "Floating point" } else { "64-bit integer arithmetic" });
        }

        let operand = this.LowerValue(operand_value);
        if operand == null { return null; }
        let width = this.IntegerWidth(_type);

        match kind {
            MIRUnaryKind::Neg => {
                if this.IsImmediate(operand) { return this.Immediate(this.TruncateValue(-this.ImmediateValue(operand), width)); }
                this.EmitValue(LIROpcode::Sub, this.Zero(), this.EnsureRegister(operand))
            },
            MIRUnaryKind::Not => {
                if this.IsImmediate(operand) { return this.Immediate(this.TruncateValue(!this.ImmediateValue(operand), width)); }
                if width <= 16 { return this.EmitValue(LIROpcode::Xori, this.EnsureRegister(operand), this.Immediate((1i64 << (width as i64)) - 1)); }
                this.EmitValue(LIROpcode::Subi, this.EmitValue(LIROpcode::Sub, this.Zero(), this.EnsureRegister(operand)), this.Immediate(1))
            },
            _ => null
        }
    }

    fn IsComparison(&this, kind: MIRBinaryKind) -> bool {
        kind >= MIRBinaryKind::ICmpEq && kind <= MIRBinaryKind::ICmpUge
    }

    fn LowerBinary(&mut this, kind: MIRBinaryKind, left_value: *MIRValue, right_value: *MIRValue) -> *LIROperand {
        if (kind >= MIRBinaryKind::FAdd && kind <= MIRBinaryKind::FRem) || kind >= MIRBinaryKind::FCmpEq {
            return this.Unsupported("Floating point");
        } else if !this.IsScalar(left_value->_type) {
            return this.Unsupported("64-bit integer arithmetic");
        }

        let mut left = this.LowerValue(left_value);
        let mut right = this.LowerValue(right_value);
        if left == null || right == null { return null; }
        let width = this.IntegerWidth(left_value->_type);

        let commutative = kind == MIRBinaryKind::Add || kind == MIRBinaryKind::Mul || kind == MIRBinaryKind::And || kind == MIRBinaryKind::Or
            || kind == MIRBinaryKind::Xor || kind == MIRBinaryKind::ICmpEq || kind == MIRBinaryKind::ICmpNe;

        if commutative && this.IsImmediate(left) && !this.IsImmediate(right) {
            let temporary = left;
            (left, right) = (right, temporary);
        }

        let immediate = this.IsImmediate(right);
        let value = if immediate { this.ImmediateValue(right) } else { 0 };

        match kind {
            MIRBinaryKind::Add => {
                if immediate && this.FitsSigned16(value) { return this.EmitValue(LIROpcode::Addi, this.EnsureRegister(left), right); }
                this.EmitValue(LIROpcode::Add, this.EnsureRegister(left), this.EnsureRegister(right))
            },
            MIRBinaryKind::Sub => {
                if immediate && this.FitsSigned16(value) { return this.EmitValue(LIROpcode::Subi, this.EnsureRegister(left), right); }
                this.EmitValue(LIROpcode::Sub, this.EnsureRegister(left), this.EnsureRegister(right))
            },
            MIRBinaryKind::Mul => {
                let shift = if immediate { this.Log2(value) } else { -1 };
                if shift >= 0 { return this.EmitValue(LIROpcode::Slli, this.EnsureRegister(left), this.Immediate(shift)); }
                this.EmitValue(LIROpcode::Mul, this.EnsureRegister(left), this.EnsureRegister(right))
            },
            MIRBinaryKind::SDiv | MIRBinaryKind::SRem => {
                let opcode = if kind == MIRBinaryKind::SDiv { LIROpcode::Div } else { LIROpcode::Rem };
                this.EmitValue(opcode, this.EnsureRegister(this.SignExtend(left, width)), this.EnsureRegister(this.SignExtend(right, width)))
            },
            MIRBinaryKind::UDiv | MIRBinaryKind::URem => {
                let opcode = if kind == MIRBinaryKind::UDiv { LIROpcode::Divu } else { LIROpcode::Remu };
                this.EmitValue(opcode, this.EnsureRegister(this.ZeroExtend(left, width)), this.EnsureRegister(this.ZeroExtend(right, width)))
            },
            MIRBinaryKind::And | MIRBinaryKind::Or | MIRBinaryKind::Xor => {
                let register_opcode = if kind == MIRBinaryKind::And { LIROpcode::And } else if kind == MIRBinaryKind::Or { LIROpcode::Or } else { LIROpcode::Xor };
                let immediate_opcode = if kind == MIRBinaryKind::And { LIROpcode::Andi } else if kind == MIRBinaryKind::Or { LIROpcode::Ori } else { LIROpcode::Xori };
                if immediate && this.FitsUnsigned16(value) { return this.EmitValue(immediate_opcode, this.EnsureRegister(left), right); }
                this.EmitValue(register_opcode, this.EnsureRegister(left), this.EnsureRegister(right))
            },
            MIRBinaryKind::Shl => {
                if immediate { return this.EmitValue(LIROpcode::Slli, this.EnsureRegister(left), this.Immediate(value & 31)); }
                this.EmitValue(LIROpcode::Sll, this.EnsureRegister(left), this.EnsureRegister(right))
            },
            MIRBinaryKind::LShr => {
                let extended = this.EnsureRegister(this.ZeroExtend(left, width));
                if immediate { return this.EmitValue(LIROpcode::Srli, extended, this.Immediate(value & 31)); }
                this.EmitValue(LIROpcode::Srl, extended, this.EnsureRegister(right))
            },
            MIRBinaryKind::AShr => {
                let extended = this.EnsureRegister(this.SignExtend(left, width));
                if immediate { return this.EmitValue(LIROpcode::Srai, extended, this.Immediate(value & 31)); }
                this.EmitValue(LIROpcode::Sra, extended, this.EnsureRegister(right))
            },
            _ if this.IsComparison(kind) => this.LowerComparison(kind, left, right, width),
            _ => null
        }
    }

    fn LowerComparison(&mut this, kind: MIRBinaryKind, left_operand: *LIROperand, right_operand: *LIROperand, width: u32) -> *LIROperand {
        let signed = kind == MIRBinaryKind::ICmpSlt || kind == MIRBinaryKind::ICmpSgt || kind == MIRBinaryKind::ICmpSle || kind == MIRBinaryKind::ICmpSge;
        let left = if signed { this.SignExtend(left_operand, width) } else { this.ZeroExtend(left_operand, width) };
        let right = if signed { this.SignExtend(right_operand, width) } else { this.ZeroExtend(right_operand, width) };
        let immediate = this.IsImmediate(right);
        let value = if immediate { this.ImmediateValue(right) } else { 0 };

        match kind {
            MIRBinaryKind::ICmpEq | MIRBinaryKind::ICmpNe => {
                let mut difference = this.EnsureRegister(left);

                if !immediate {
                    difference = this.EmitValue(LIROpcode::Xor, difference, right);
                } else if value != 0 && this.FitsUnsigned16(value) {
                    difference = this.EmitValue(LIROpcode::Xori, difference, right);
                } else if value != 0 {
                    difference = this.EmitValue(LIROpcode::Xor, difference, this.EnsureRegister(right));
                }

                if kind == MIRBinaryKind::ICmpEq { return this.EmitValue(LIROpcode::Sltiu, difference, this.Immediate(1)); }
                this.EmitValue(LIROpcode::Sltu, this.Zero(), difference)
            },
            MIRBinaryKind::ICmpSlt | MIRBinaryKind::ICmpSge => {
                let result = if immediate && this.FitsSigned16(value) { this.EmitValue(LIROpcode::Slti, this.EnsureRegister(left), right) } else { this.EmitValue(LIROpcode::Slt, this.EnsureRegister(left), this.EnsureRegister(right)) };
                if kind == MIRBinaryKind::ICmpSlt { result } else { this.EmitValue(LIROpcode::Xori, result, this.Immediate(1)) }
            },
            MIRBinaryKind::ICmpUlt | MIRBinaryKind::ICmpUge => {
                let result = if immediate && this.FitsUnsigned16(value) { this.EmitValue(LIROpcode::Sltiu, this.EnsureRegister(left), right) } else { this.EmitValue(LIROpcode::Sltu, this.EnsureRegister(left), this.EnsureRegister(right)) };
                if kind == MIRBinaryKind::ICmpUlt { result } else { this.EmitValue(LIROpcode::Xori, result, this.Immediate(1)) }
            },
            _ => {
                let opcode = if signed { LIROpcode::Slt } else { LIROpcode::Sltu };
                let result = this.EmitValue(opcode, this.EnsureRegister(right), this.EnsureRegister(left));
                let strict = kind == MIRBinaryKind::ICmpSgt || kind == MIRBinaryKind::ICmpUgt;
                if strict { result } else { this.EmitValue(LIROpcode::Xori, result, this.Immediate(1)) }
            }
        }
    }

    fn LowerCondition(&mut this, value: *MIRValue) -> *LIROperand {
        let condition = this.LowerValue(value);
        if condition == null || this.IsImmediate(condition) { return condition; }

        if value->kind == MIRValueKind::Instruction && (value as *MIRInstruction)->kind == MIRInstructionKind::Binary {
            if this.IsComparison((value as *MIRBinaryInstruction)->kind) {
                return condition;
            }
        }

        this.EmitValue(LIROpcode::Andi, this.EnsureRegister(condition), this.Immediate(1))
    }

    fn LowerCallInstruction(&mut this, call: *MIRCallInstruction) -> *LIROperand {
        let function = this.builder.GetCurrentFunction();
        let mut sources = Vector<*LIROperand>();

        for i in 0..call->arguments.Length() {
            let argument = call->arguments[i];

            if !this.IsScalar(argument->_type) && !this.IsAggregate(argument->_type) {
                return this.Unsupported(if argument->_type->kind == MIRTypeKind::Float { "Floating point" } else { "64-bit integer arithmetic" });
            }

            let source = this.EnsureRegister(this.LowerValue(argument));

            if i < LIR_ARGUMENT_COUNT {
                sources.PushBack(source);
            } else {
                let offset = ((i - LIR_ARGUMENT_COUNT) * 4) as u32;
                this.Emit(LIROpcode::Sw, null, source, this.builder.MemoryOperand(this.Physical(LIR_SP), offset as i32));
                if offset + 4 > function->outgoing_size { function->outgoing_size = offset + 4; }
            }
        }

        let mut callee: *LIROperand = null;
        let mut opcode = LIROpcode::Blr;

        if call->callee->kind == MIRValueKind::DeclarationReference && (call->callee as *MIRDeclarationReference)->declaration->kind == MIRDeclarationKind::Function {
            (callee, opcode) = (this.LowerValue(call->callee), LIROpcode::Bl);
        } else {
            callee = this.EnsureRegister(this.LowerValue(call->callee));
        }

        let mut arguments = Vector<*LIROperand>();

        for i in 0..sources.Length() {
            let register = this.Physical(LIR_A0 + (i as u8));
            this.EmitMove(register, sources[i]);
            arguments.PushBack(register);
        }

        let mut clobbers = Vector<*LIROperand>();

        for i in LIR_T0..(LIR_A7 + 1) {
            clobbers.PushBack(this.Physical(i));
        }

        let instruction = this.Emit(opcode, null, callee, null);
        instruction->implicit_uses = arguments;
        instruction->implicit_defines = clobbers;
        function->has_calls = true;

        if call->_type == null || call->_type->kind == MIRTypeKind::Void {
            return null;
        } else if !this.IsScalar(call->_type) {
            return this.Unsupported(if call->_type->kind == MIRTypeKind::Float { "Floating point" } else { "Returning this type by value" });
        }

        let result = this.builder.VirtualRegister();
        this.EmitMove(result, this.Physical(LIR_A0));
        result
    }

    fn LowerCast(&mut this, kind: MIRCastKind, value_value: *MIRValue, _type: *MIRType) -> *LIROperand {
        if kind != MIRCastKind::Trunc && kind != MIRCastKind::ZExt && kind != MIRCastKind::SExt && kind != MIRCastKind::PtrToInt && kind != MIRCastKind::IntToPtr && kind != MIRCastKind::Bitcast {
            return this.Unsupported("Floating point");
        } else if kind != MIRCastKind::Bitcast && kind != MIRCastKind::Trunc && (!this.IsScalar(value_value->_type) || !this.IsScalar(_type)) {
            return this.Unsupported("64-bit integer arithmetic");
        }

        let value = this.LowerValue(value_value);
        if value == null { return null; }

        match kind {
            MIRCastKind::Trunc => {
                if this.IsImmediate(value) { return this.Immediate(this.TruncateValue(this.ImmediateValue(value), this.IntegerWidth(_type))); }
                value
            },
            MIRCastKind::ZExt => this.ZeroExtend(value, this.IntegerWidth(value_value->_type)),
            MIRCastKind::SExt => this.SignExtend(value, this.IntegerWidth(value_value->_type)),
            _ => value
        }
    }

    fn LowerSelectInstruction(&mut this, select: *MIRSelectInstruction) -> *LIROperand {
        let condition = this.LowerCondition(select->condition);
        let then_value = this.LowerValue(select->then_value);
        let else_value = this.LowerValue(select->else_value);
        if condition == null || then_value == null || else_value == null { return null; }

        if this.IsImmediate(condition) {
            return if this.ImmediateValue(condition) != 0 { then_value } else { else_value };
        }

        let else_register = this.EnsureRegister(else_value);
        let mask = this.EmitValue(LIROpcode::Sub, this.Zero(), condition);
        let difference = this.EmitValue(LIROpcode::Xor, this.EnsureRegister(then_value), else_register);
        this.EmitValue(LIROpcode::Xor, else_register, this.EmitValue(LIROpcode::And, difference, mask))
    }

    fn LowerPhiInstruction(&mut this, phi: *MIRPhiInstruction) -> *LIROperand {
        if !this.IsScalar(phi->_type) && !this.IsAggregate(phi->_type) {
            return this.Unsupported(if phi->_type->kind == MIRTypeKind::Float { "Floating point" } else { "64-bit integer arithmetic" });
        }

        this.builder.VirtualRegister()
    }

    fn PhysicalRegisterByName(&mut this, name: &String) -> *LIROperand {
        let index = LIRRegisterIndex(name);

        if index < 0 {
            Logger::Log("Unknown register '" + name + "' in inline assembly.", LogSeverity::Error);
            return null;
        }

        this.Physical(index as u8)
    }

    fn LowerAssemblyInstruction(&mut this, assembly: *MIRAssemblyInstruction) -> *LIROperand {
        let mut inputs = Vector<*LIROperand>();
        let mut outputs = Vector<*LIROperand>();

        for input in assembly->inputs {
            let register = this.PhysicalRegisterByName(input->name);
            let value = this.EnsureRegister(this.LowerValue(input->value));
            if register == null { continue; }
            this.EmitMove(register, value);
            inputs.PushBack(register);
        }

        for output in assembly->outputs {
            let register = this.PhysicalRegisterByName(output->name);
            if register != null { outputs.PushBack(register); }
        }

        let mut defines = outputs;

        for clobber in assembly->clobbers {
            let index = LIRRegisterIndex(clobber);
            if index >= 0 { defines.PushBack(this.Physical(index as u8)); }
        }

        let instruction = this.Emit(LIROpcode::Asm, null, null, null);
        instruction->text = assembly->text;
        instruction->implicit_uses = inputs;
        instruction->implicit_defines = defines;

        for i in 0..assembly->outputs.Length() {
            if i >= outputs.Length() { break; }
            let output = assembly->outputs[i];
            let pointer = this.LowerValue(output->value);
            if pointer == null { continue; }
            let result = this.builder.VirtualRegister();
            this.EmitMove(result, outputs[i]);
            let size = this.SizeOf((output->value->_type as *MIRPointerType)->pointee);
            this.Emit(this.StoreOpcode(size), null, result, this.LegalMemory(this.EnsureMemory(pointer), size));
        }

        null
    }

    fn LowerTerminator(&mut this, terminator: *MIRTerminator) {
        match terminator->kind {
            MIRTerminatorKind::Return => {
                this.LowerReturnInstruction(terminator as *MIRReturnInstruction);
            },
            MIRTerminatorKind::Branch => {
                this.EmitBranch(this.EdgeTarget((terminator as *MIRBranchInstruction)->target, false));
            },
            MIRTerminatorKind::ConditionalBranch => {
                this.LowerConditionalBranchInstruction(terminator as *MIRConditionalBranchInstruction);
            },
            MIRTerminatorKind::Unreachable => {
                this.Emit(LIROpcode::Hlt, null, null, null);
            }
        }
    }

    fn LowerReturnInstruction(&mut this, _return: *MIRReturnInstruction) {
        let mut uses = Vector<*LIROperand>();

        if _return->value != null {
            if !this.IsScalar(_return->value->_type) {
                this.Unsupported(if _return->value->_type->kind == MIRTypeKind::Float { "Floating point" } else { "Returning this type by value" });
            } else {
                let value = this.EnsureRegister(this.LowerValue(_return->value));
                let register = this.Physical(LIR_A0);
                this.EmitMove(register, value);
                uses.PushBack(register);
            }
        }

        let instruction = this.Emit(LIROpcode::Ret, null, null, null);
        instruction->implicit_uses = uses;
    }

    fn LowerConditionalBranchInstruction(&mut this, branch: *MIRConditionalBranchInstruction) {
        let condition = this.LowerCondition(branch->condition);
        if condition == null { return; }

        if this.IsImmediate(condition) {
            this.EmitBranch(this.EdgeTarget(if this.ImmediateValue(condition) != 0 { branch->then_target } else { branch->else_target }, false));
            return;
        }

        let then_target = this.EdgeTarget(branch->then_target, true);
        let else_target = this.EdgeTarget(branch->else_target, true);
        let defines = Vector<*LIROperand>();
        let mut uses = Vector<*LIROperand>();
        uses.PushBack(condition);
        uses.PushBack(this.Zero());
        uses.PushBack(this.builder.BlockOperand(then_target));
        this.builder.BuildInstruction(LIROpcode::Bne, defines, uses);
        this.EmitBranch(else_target);
    }
}
