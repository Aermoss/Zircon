#[include "std/vec", "src/HIR.zir", "src/MIR.zir", "src/Target.zir" : *]

enum ABIPassMode: u8 {
    Direct, Cast, Indirect
}

class ABIValue {
    pub mode: ABIPassMode = ABIPassMode::Direct,
    pub cast: *MIRType = null,
    pub cast_size: usize = 0,
    pub byval: bool = false,
    pub extension: MIRExtension = MIRExtension::None,
    pub stack_align: u32 = 0,
    pub integer_registers: usize = 0,
    pub sse_registers: usize = 0;

    ABIValue(&mut this) {}

    ABIValue(&mut this, mode: ABIPassMode) {
        this.mode = mode;
    }

    ABIValue(&mut this, cast: *MIRType, cast_size: usize) {
        (this.mode, this.cast, this.cast_size) = (ABIPassMode::Cast, cast, cast_size);
    }
}

class ABIFunction {
    pub _return: ABIValue,
    pub parameters: Vector<ABIValue>;

    ABIFunction(&mut this) {}
}

class ABILeaf {
    pub offset: usize,
    pub size: usize,
    pub float_width: u32;

    ABILeaf(&mut this, offset: usize, size: usize, float_width: u32) {
        (this.offset, this.size, this.float_width) = (offset, size, float_width);
    }
}

enum ABIClass: u8 {
    None, Integer, SSE
}

class ABIClassifier {
    context: *mut MIRContext,
    abi: TargetABI,
    pointer_size: usize,
    integer_registers: usize = 0,
    sse_registers: usize = 0;

    ABIClassifier(&mut this, context: *mut MIRContext, abi: TargetABI, pointer_size: usize) {
        (this.context, this.abi, this.pointer_size) = (context, abi, pointer_size);
    }

    pub fn Classify(&mut this, abi: HIRDeclarationABI, _return: *HIRType, parameters: &Vector<*HIRType>, fixed: usize) -> ABIFunction {
        let native = abi == HIRDeclarationABI::Native && this.abi != TargetABI::Svarog;
        let mut result = ABIFunction();
        result._return = this.ClassifyValue(_return, true, false, native);
        (this.integer_registers, this.sse_registers) = (6, 8);
        if result._return.mode == ABIPassMode::Indirect { this.integer_registers -= 1; }

        for i in 0..parameters.Length() {
            let mut value = this.ClassifyValue(parameters[i], false, i >= fixed, native);
            if !native && this.abi == TargetABI::SysV64 { value = this.AssignSysV64Registers(value); }
            result.parameters.PushBack(value);
        }

        result
    }

    pub fn Native(&mut this, _type: *HIRType) -> ABIValue {
        if this.abi == TargetABI::Svarog { this.ClassifySvarog(_type, false) } else { this.ClassifyNative(_type, false) }
    }

    fn ClassifyValue(&mut this, _type: *HIRType, _return: bool, variadic: bool, native: bool) -> ABIValue {
        if native { return this.ClassifyNative(_type, _return); }

        match this.abi {
            TargetABI::Win64 => this.ClassifyWin64(_type, _return),
            TargetABI::SysV64 => this.ClassifySysV64(_type, _return),
            TargetABI::AAPCS64 | TargetABI::DarwinPCS64 | TargetABI::WinARM64 => this.ClassifyAArch64(_type, _return, variadic),
            TargetABI::Svarog => this.ClassifySvarog(_type, _return)
        }
    }

    fn IsAggregate(&this, _type: *HIRType) -> bool {
        _type->HasSpecialMembers() || _type->IsSlice()
    }

    fn Integer(&mut this, size: usize) -> *MIRType {
        this.context->IntegerType(size as u32 * 8)
    }

    fn Extension(&this, _type: *HIRType) -> MIRExtension {
        if _type->IsBoolean() || _type->IsCharacter() { return MIRExtension::Zero; }
        let mut integer: *HIRIntegerType = null;

        if _type->IsInteger() {
            integer = _type as *HIRIntegerType;
        } else if _type->IsEnumeration() {
            integer = (_type as *HIREnumerationType)->underlying;
        }

        if integer == null || integer->width > 16 {
            MIRExtension::None
        } else if integer->signed {
            MIRExtension::Sign
        } else {
            MIRExtension::Zero
        }
    }

    fn ClassifyNative(&mut this, _type: *HIRType, _return: bool) -> ABIValue {
        if !this.IsAggregate(_type) { return ABIValue(); }
        let size = _type->Size();

        if (size != 1 && size != 2 && size != 4 && size != 8) || size > this.pointer_size || !_type->IsTrivial() || _type->IsSlice() {
            return ABIValue(ABIPassMode::Indirect);
        }

        ABIValue(this.Integer(size), size)
    }

    fn ClassifyWin64(&mut this, _type: *HIRType, _return: bool) -> ABIValue {
        if !this.IsAggregate(_type) {
            let mut value = ABIValue();
            if _type->IsBoolean() { value.extension = MIRExtension::Zero; }
            if !_return && _type->IsInteger() && _type->Width() == 128 { value.mode = ABIPassMode::Indirect; }
            return value;
        }

        let size = _type->Size();
        if !_type->IsTrivial() || (size != 1 && size != 2 && size != 4 && size != 8) { return ABIValue(ABIPassMode::Indirect); }
        ABIValue(this.Integer(size), size)
    }

    fn ClassifySysV64(&mut this, _type: *HIRType, _return: bool) -> ABIValue {
        if !this.IsAggregate(_type) {
            let mut value = ABIValue();
            value.extension = this.Extension(_type);

            if _type->IsFloat() {
                value.sse_registers = 1;
            } else if _type->IsInteger() && _type->Width() == 128 {
                value.integer_registers = 2;
            } else if !_type->IsUnit() && !_type->IsVoid() && !_type->IsNever() {
                value.integer_registers = 1;
            }

            return value;
        }

        if !_type->IsTrivial() {
            let mut value = ABIValue(ABIPassMode::Indirect);
            value.integer_registers = 1;
            return value;
        }

        let size = _type->Size();

        if size == 0 || size > 16 {
            let mut value = ABIValue(ABIPassMode::Indirect);
            value.byval = !_return;
            return value;
        }

        let mut leaves = Vector<ABILeaf>();
        this.Flatten(_type, 0, leaves);
        let mut classes = [ABIClass::None, ABIClass::None];
        let mut ends: [usize; 2] = [0, 0];

        for leaf in leaves {
            let kind = if leaf.float_width != 0 { ABIClass::SSE } else { ABIClass::Integer };

            for i in (leaf.offset / 8)..((leaf.offset + leaf.size - 1) / 8 + 1) {
                if classes[i] != ABIClass::Integer { classes[i] = kind; }
                let end = if leaf.offset + leaf.size < (i + 1) * 8 { leaf.offset + leaf.size } else { (i + 1) * 8 };
                if end > ends[i] { ends[i] = end; }
            }
        }

        let count = (size + 7) / 8;
        let mut parts = Vector<*MIRType>();
        let (mut integers, mut sses): (usize, usize) = (0, 0);

        for i in 0..count {
            if classes[i] == ABIClass::SSE {
                parts.PushBack(this.context->FloatType(if ends[i] - i * 8 <= 4 { 32 } else { 64 }));
                sses += 1;
            } else {
                parts.PushBack(this.Integer(if size - i * 8 < 8 { size - i * 8 } else { 8 }));
                integers += 1;
            }
        }

        let mut value = if count == 1 {
            ABIValue(parts[0], size)
        } else if integers == 2 && _type->Alignment() == 16 {
            ABIValue(this.Integer(16), 16)
        } else {
            ABIValue(this.context->StructureType(parts), 16)
        };

        (value.integer_registers, value.sse_registers) = (integers, sses);
        value
    }

    fn AssignSysV64Registers(&mut this, value: ABIValue) -> ABIValue {
        if value.integer_registers <= this.integer_registers && value.sse_registers <= this.sse_registers {
            this.integer_registers -= value.integer_registers;
            this.sse_registers -= value.sse_registers;
            return value;
        }

        if value.mode != ABIPassMode::Cast { return value; }
        let mut memory = ABIValue(ABIPassMode::Indirect);
        memory.byval = true;
        memory
    }

    fn ClassifyAArch64(&mut this, _type: *HIRType, _return: bool, variadic: bool) -> ABIValue {
        if !this.IsAggregate(_type) {
            let mut value = ABIValue();
            if this.abi == TargetABI::DarwinPCS64 { value.extension = this.Extension(_type); }
            return value;
        }

        if !_type->IsTrivial() { return ABIValue(ABIPassMode::Indirect); }
        let size = _type->Size();

        if !variadic || this.abi != TargetABI::WinARM64 {
            let (count, width) = this.HomogeneousFloat(_type);

            if count != 0 {
                if _return { return ABIValue(); }
                let mut value = ABIValue(this.context->ArrayType(this.context->FloatType(width), count), size);
                if this.abi == TargetABI::AAPCS64 { value.stack_align = 8; }
                return value;
            }
        }

        if size > 16 {
            ABIValue(ABIPassMode::Indirect)
        } else if _type->Alignment() == 16 {
            ABIValue(this.Integer(16), 16)
        } else if size <= 8 {
            if _return { ABIValue(this.Integer(size), size) } else { ABIValue(this.Integer(8), 8) }
        } else {
            ABIValue(this.context->ArrayType(this.Integer(8), 2), 16)
        }
    }

    fn ClassifySvarog(&mut this, _type: *HIRType, _return: bool) -> ABIValue {
        if !this.IsAggregate(_type) {
            let mut value = ABIValue();
            value.extension = this.Extension(_type);
            return value;
        }

        let (size, word) = (_type->Size(), this.pointer_size);
        if !_type->IsTrivial() || size > word * 2 { return ABIValue(ABIPassMode::Indirect); }
        if size <= word { return ABIValue(this.Integer(word), word); }
        ABIValue(this.context->ArrayType(this.Integer(word), 2), word * 2)
    }

    fn HomogeneousFloat(&this, _type: *HIRType) -> (usize, u32) {
        let mut leaves = Vector<ABILeaf>();
        this.Flatten(_type, 0, leaves);
        if leaves.Empty() || leaves.Length() > 4 || leaves[0].float_width == 0 { return (0, 0); }
        let width = leaves[0].float_width;

        for leaf in leaves {
            if leaf.float_width != width { return (0, 0); }
        }

        if leaves.Length() * (width as usize / 8) != _type->Size() { return (0, 0); }
        (leaves.Length(), width)
    }

    fn Align(&this, offset: usize, alignment: usize) -> usize {
        let remainder = offset % alignment;
        if remainder == 0 { offset } else { offset + alignment - remainder }
    }

    fn Flatten(&this, _type: *HIRType, offset: usize, leaves: &mut Vector<ABILeaf>) {
        if _type->IsFloat() {
            leaves.PushBack(ABILeaf(offset, _type->Size(), _type->Width()));
        } else if _type->IsArray() {
            let element: *HIRType = _type->Element();
            let size = element->Size();

            for i in 0.._type->Length() {
                this.Flatten(element, offset + i * size, leaves);
            }
        } else if _type->IsTuple() {
            let mut current: usize = 0;

            for element in (_type as *HIRTupleType)->elements {
                current = this.Align(current, element->Alignment());
                this.Flatten(element, offset + current, leaves);
                current += element->Size();
            }
        } else if _type->HasFields() {
            let mut current: usize = 0;

            if _type->IsClass() {
                let declaration = (_type as *HIRClassType)->declaration;

                if declaration->vptr {
                    leaves.PushBack(ABILeaf(offset, this.pointer_size, 0));
                    current = this.pointer_size;
                }

                if declaration->parent != null {
                    current = this.Align(current, declaration->parent->Alignment());
                    this.Flatten(declaration->parent, offset + current, leaves);
                    current += declaration->parent->Size();
                }
            }

            for field in _type->Fields() {
                current = this.Align(current, field->_type->Alignment());
                this.Flatten(field->_type, offset + current, leaves);
                current += field->_type->Size();
            }
        } else if _type->IsSlice() {
            leaves.PushBack(ABILeaf(offset, this.pointer_size, 0));
            leaves.PushBack(ABILeaf(offset + this.pointer_size, this.pointer_size, 0));
        } else if _type->Size() != 0 {
            leaves.PushBack(ABILeaf(offset, _type->Size(), 0));
        }
    }
}
