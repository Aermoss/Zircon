#[include "std/io", "std/file", "std/std", "src/Target.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/Parser.zir", "src/HIRLowerer.zir", "src/MIRLowerer.zir", "src/MIRPasses.zir", "src/LIRLowerer.zir", "src/LIRAllocator.zir", "src/ZodiacEmitter.zir", "src/Logger.zir" : *]

#[if !ZODIAC]
#[include "std/time", "vendor/llvm-c/Core.zir", "vendor/llvm-c/IRReader.zir", "vendor/llvm-c/BitReader.zir", "vendor/llvm-c/BitWriter.zir", "vendor/llvm-c/Transforms/PassBuilder.zir", "src/LLVMLowerer.zir", "src/Assembler.zir" : *]

#[if WINDOWS]
const INFINITE: u32 = 0xFFFFFFFF;

class STARTUPINFOA {
    pub cb: u32,
    pub lpReserved: *mut i8,
    pub lpDesktop: *mut i8,
    pub lpTitle: *mut i8,
    pub dwX: u32,
    pub dwY: u32,
    pub dwXSize: u32,
    pub dwYSize: u32,
    pub dwXCountChars: u32,
    pub dwYCountChars: u32,
    pub dwFillAttribute: u32,
    pub dwFlags: u32,
    pub wShowWindow: u16,
    pub cbReserved2: u16,
    pub lpReserved2: *mut u8,
    pub hStdInput: *mut void,
    pub hStdOutput: *mut void,
    pub hStdError: *mut void
}

type LPSTARTUPINFOA = *mut STARTUPINFOA;

class PROCESS_INFORMATION {
    pub hProcess: *mut void,
    pub hThread: *mut void,
    pub dwProcessId: u32,
    pub dwThreadId: u32
}

type LPPROCESS_INFORMATION = *mut PROCESS_INFORMATION;
#[else]
class _SHArgs {
    pub sh: *i8,
    pub flag: *i8,
    pub cmd: *i8,
    pub end: *i8
}

class _NullEnv {
    pub end: *i8
}
#[endif]

extern "C" {
#[if WINDOWS]
    fn CreateProcessA(lpApplicationName: *i8, lpCommandLine: *i8, lpProcessAttributes: *mut void, lpThreadAttributes: *mut void, bInheritHandles: i32, dwCreationFlags: u32, lpEnvironment: *mut void, lpCurrentDirectory: *i8, lpStartupInfo: LPSTARTUPINFOA, lpProcessInformation: LPPROCESS_INFORMATION) -> i32;
    fn WaitForSingleObject(hHandle: *mut void, dwMilliseconds: u32) -> u32;
    fn GetExitCodeProcess(hProcess: *mut void, lpExitCode: *mut u32) -> i32;
#[else]
    fn fork() -> i32;
    fn execve(path: *i8, argv: **i8, envp: **i8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
#[endif]
}

fn Execute(command: *i8) -> u32 {
#[if WINDOWS]
    let mut startup_info: STARTUPINFOA;
    memset(&mut startup_info, 0, sizeof(startup_info));
    startup_info.cb = sizeof(startup_info) as u32;
    let mut process_info: PROCESS_INFORMATION;

    if CreateProcessA(null, command, null, null, 0, 0, null, null, &mut startup_info, &mut process_info) == 0 {
        WriteLine("\x1b[31mFailed to create process: " + String::FromInteger(GetLastError() as u64) + ".\x1b[0m");
        Exit(1);
    }

    let mut exit_code: u32 = 0;
    WaitForSingleObject(process_info.hProcess, INFINITE);

    if GetExitCodeProcess(process_info.hProcess, &mut exit_code) == 0 {
        WriteLine("\x1b[31mFailed to get process exit code: " + String::FromInteger(GetLastError() as u64) + ".\x1b[0m");
    }

    CloseHandle(process_info.hProcess);
    CloseHandle(process_info.hThread);
    exit_code
#[else]
    let mut shargs: _SHArgs;
    shargs.sh = "/bin/sh";
    shargs.flag = "-c";
    shargs.cmd = command;
    shargs.end = null;
    let mut nullenv: _NullEnv;
    nullenv.end = null;
    let pid = fork();

    if pid == 0 {
        execve(shargs.sh, &shargs as **i8, &nullenv as **i8);
        Exit(1);
    }

    let mut status = 0;
    waitpid(pid, &mut status, 0);
    ((status >> 8) & 0xFF) as u32
#[endif]
}
#[endif]

#[if WINDOWS]
fn ListFolderOrExit(path: &String, what: &String) -> Vector<FolderEntry> {
    match ListFolder(path) {
        Result<Vector<FolderEntry>, IOError>::Ok(entries) => entries,
        Result<Vector<FolderEntry>, IOError>::Err(_) => {
            WriteLine("\x1b[31mFailed to find " + what + " path.\x1b[0m");
            Exit(1)
        }
    }
}

fn IsNewerVersion(version: &Vector<u64>, other: &Vector<u64>) -> bool {
    for i in 0..version.Length() {
        if version[i] != other[i] {
            return version[i] > other[i];
        }
    }

    false
}

fn NewestVersionFolder(path: &String, count: usize, what: &String) -> String {
    let mut newest = String();
    let mut newest_version = Vector<u64>();

    for entry in ListFolderOrExit(path, what) {
        if entry.kind != EntryKind::Folder {
            continue;
        }

        let mut version = Vector<u64>();
        let parts = entry.name.Split('.');

        for part in parts {
            let number = part.ToUnsignedInteger();

            if number.IsSome() {
                version.PushBack(number.Unwrap());
            }
        }

        if parts.Length() == count && version.Length() == count && (newest.Empty() || IsNewerVersion(version, newest_version)) {
            newest = entry.name;
            newest_version = version;
        }
    }

    if newest.Empty() {
        WriteLine("\x1b[31mFailed to find a valid " + what + " version.\x1b[0m");
        Exit(1);
    }

    JoinPath(path, newest)
}

fn GetWindowsSDKPath() -> String {
    NewestVersionFolder("C:\\Program Files (x86)\\Windows Kits\\10\\Lib".ToString(), 4, "Windows SDK".ToString())
}

fn GetMSVCPath() -> String {
    let mut newest = String();
    let mut newest_version: i64 = 0;
    let root = "C:\\Program Files\\Microsoft Visual Studio".ToString();
    let what = "Visual Studio".ToString();

    for entry in ListFolderOrExit(root, what) {
        let number = entry.name.ToInteger();

        if entry.kind != EntryKind::Folder || number.IsNone() {
            continue;
        }

        let version = match number.Unwrap() {
            2017 => 15,
            2019 => 16,
            2022 => 17,
            version => version
        };

        if version > newest_version {
            newest = entry.name;
            newest_version = version;
        }
    }

    if newest.Empty() {
        WriteLine("\x1b[31mFailed to find a valid Visual Studio version.\x1b[0m");
        Exit(1);
    }

    let installation = JoinPath(root, newest);

    for entry in ListFolderOrExit(installation, what) {
        let path = JoinPath(JoinPath(installation, entry.name), "VC\\Tools\\MSVC".ToString());

        if entry.kind == EntryKind::Folder && FolderExists(path) {
            return NewestVersionFolder(path, 3, "MSVC".ToString());
        }
    }

    WriteLine("\x1b[31mFailed to find MSVC path.\x1b[0m");
    Exit(1);
}
#[endif]

fn WriteOutput(path: &String, content: &String) {
    if let Result<(), IOError>::Err(error) = File::WriteText(path, content) {
        Logger::Log(path, "Failed to write file: " + error.ToString() + ".", LogSeverity::Error);
    }
}

fn PrintVersion() {
#[if ZODIAC]
    WriteLine("Zircon 8.4 \"Octane\" (zodiac-unknown-zenith)");
#[else]
    WriteLine("Zircon 8.4 \"Octane\" (" + LLVMGetDefaultTargetTriple().ToString() + ')');
#[endif]
    WriteLine("Copyright (c) 2025-2026 Yusuf Rençber.");
    WriteLine("Licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file for details.");
}

fn PrintUsage(executable: &String) {
    WriteLine("OVERVIEW: Zircon compiler");
    WriteLine("USAGE: " + executable + " [options] <inputs>");
    WriteLine("OPTIONS:");
    WriteLine("  -o <file>                Write output to <file>");
    WriteLine("  -I <dir>                 Add directory to include search path");
    WriteLine("  -L <dir>                 Add directory to library search path");
    WriteLine("  -l <name>                Link against library <name>");
    WriteLine("  -D <macro>               Define a macro");
    WriteLine("  -O<level>, -O            Optimization level (0, 1, 2, 3) [-O defaults to -O2]");
    WriteLine("  -g                       Enable debug information");
    WriteLine("  -c                       Only run preprocess, compile, and assemble steps");
    WriteLine("  -S                       Only run preprocess and compilation steps");
    WriteLine("  -emit-hir                Emit HIR (High-level intermediate representation)");
    WriteLine("  -emit-mir                Emit MIR (Mid-level intermediate representation)");
    WriteLine("  -emit-lir                Emit LIR (Low-level intermediate representation)");
    WriteLine("  -emit-llvm               Emit LLVM intermediate representation");
    WriteLine("  -emit-bc                 Emit LLVM bitcode");
    WriteLine("  -check, -fsyntax-only    Check code for errors, but do not emit code");
    WriteLine("  -target <triple>         Generate code for the given target");
    WriteLine("  -march <arch>            Architecture to generate code for");
    WriteLine("  -mcmodel <model>         Code model (tiny, small, medium, large, kernel)");
    WriteLine("  -ffreestanding           Assert that the compilation takes place in a freestanding environment");
    WriteLine("  -mno-red-zone            Do not use the red-zone for x86-64 code");
    WriteLine("  -mgeneral-regs-only      Generate code which only uses the general-purpose registers");
    WriteLine("  -r, --run                Run the program after compiling");
    WriteLine("  -v, --verbose            Show commands to run and use verbose output");
    WriteLine("  --version                Display compiler version");
    WriteLine("  -h, --help               Display this help message");
}

#[if !ZODIAC]
fn FatalErrorHandler(reason: *i8) {
    Logger::Log("LLVM", reason, LogSeverity::Fatal);
}
#[endif]

fn Main(args: &mut Vector<String>) -> i32 {
    let (_, executable) = SplitPath(args[0]);
    let mut logger = Logger(executable);

    if args.Length() < 2 {
        PrintUsage(executable);
        return 1;
    }

#[if !ZODIAC]
    LLVMEnablePrettyStackTrace();
    LLVMInstallFatalErrorHandler(FatalErrorHandler);

    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
    LLVMInitializeX86AsmParser();

    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMInitializeAArch64AsmParser();
#[endif]

    let (mut input_files, mut output_file) = (Vector<String>(), String());
    let (mut include_paths, mut lib_paths) = (Vector<String>(), Vector<String>());
    let (mut defines, mut libs) = (Vector<String>(), Vector<String>());

    include_paths.PushBack(".".ToString());
    include_paths.PushBack("include".ToString());
#[if ZODIAC]
    include_paths.PushBack("/include".ToString());
#[else]
    let root = SplitPath(SplitPath(ExecutablePath().Unwrap()).0).0;

    if !root.Empty() {
        include_paths.PushBack(JoinPath(root, "include".ToString()));
    }
#[endif]

    let mut features = String();
#[if ZODIAC]
    let mut triple = "zodiac-unknown-zenith".ToString();
#[else]
    let mut triple = LLVMGetDefaultTargetTriple().ToString();
    let mut opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
#[endif]
    let (mut arch, mut code_model) = ("generic".ToString(), "default".ToString());
    let (mut emit_hir, mut emit_mir, mut emit_lir) = (false, false, false);
    let (mut emit_object, mut emit_asm, mut emit_llvm, mut emit_bc) = (false, false, false, false);
    let (mut run, mut debug, mut verbose, mut check) = (false, false, false, false);
    let (mut freestanding, mut no_red_zone) = (false, false);
    let mut i: usize = 1;

    while i < args.Length() {
        let &arg = args[i];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            return 0;
        } else if arg == "--version" {
            PrintVersion();
            return 0;
        } else if arg == "-v" || arg == "--verbose" {
            verbose = true;
        } else if arg == "-check" || arg == "-fsyntax-only" {
            check = true;
        } else if arg == "-g" || arg == "--debug" {
            debug = true;
        } else if arg == "-c" {
            emit_object = true;
        } else if arg == "-S" {
            emit_asm = true;
        } else if arg == "-emit-hir" {
            emit_hir = true;
        } else if arg == "-emit-mir" {
            emit_mir = true;
        } else if arg == "-emit-lir" {
            emit_lir = true;
        } else if arg == "-emit-llvm" {
            emit_llvm = true;
        } else if arg == "-emit-bc" {
            emit_bc = true;
        } else if arg == "-ffreestanding" {
            freestanding = true;
        } else if arg == "-mno-red-zone" {
            no_red_zone = true;
        } else if arg == "-mgeneral-regs-only" {
            if !features.Empty() { features += ","; }
            features += "+nofp,+nosimd";

            if triple.Contains("aarch64") || triple.Contains("arm64") {
                features += ",+fixed-x18";
            }
        } else if arg == "-r" || arg == "--run" {
            run = true;
        } else if arg == "-O0" {
#[if !ZODIAC]
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
#[endif]
        } else if arg == "-O1" {
#[if !ZODIAC]
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
#[endif]
        } else if arg == "-O2" || arg == "-O" {
#[if !ZODIAC]
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
#[endif]
        } else if arg == "-O3" {
#[if !ZODIAC]
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive;
#[endif]
        } else if arg == "-o" {
            i += 1;

            if i < args.Length() {
                output_file = args[i];
            } else {
                Logger::Log("Missing argument to '-o'.", LogSeverity::Error);
                return 1;
            }
        } else if arg.StartsWith("-I") {
            let mut path = arg.SubString(2);

            if path.Empty() {
                i += 1;

                if i < args.Length() {
                    path = args[i];
                } else {
                    Logger::Log("Missing argument to '-I'.", LogSeverity::Error);
                    return 1;
                }
            }

            include_paths.PushBack(path);
        } else if arg.StartsWith("-L") {
            let mut path = arg.SubString(2);

            if path.Empty() {
                i += 1;

                if i < args.Length() {
                    path = args[i];
                } else {
                    Logger::Log("Missing argument to '-L'.", LogSeverity::Error);
                    return 1;
                }
            }

            lib_paths.PushBack(path);
        } else if arg.StartsWith("-l") {
            let mut name = arg.SubString(2);

            if name.Empty() {
                i += 1;

                if i < args.Length() {
                    name = args[i];
                } else {
                    Logger::Log("Missing argument to '-l'.", LogSeverity::Error);
                    return 1;
                }
            }

            libs.PushBack(name);
        } else if arg.StartsWith("-D") {
            let mut define = arg.SubString(2);

            if define.Empty() {
                i += 1;

                if i < args.Length() {
                    define = args[i];
                } else {
                    Logger::Log("Missing argument to '-D'.", LogSeverity::Error);
                    return 1;
                }
            }

            defines.PushBack(define);
        } else if arg == "-target" {
            i += 1;

            if i < args.Length() {
                triple = args[i];
            } else {
                Logger::Log("Missing argument to '-target'.", LogSeverity::Error);
                return 1;
            }
        } else if arg == "-march" {
            i += 1;

            if i < args.Length() {
                arch = args[i];
            } else {
                Logger::Log("Missing argument to '-march'.", LogSeverity::Error);
                return 1;
            }
        } else if arg == "-mcmodel" {
            i += 1;

            if i < args.Length() {
                code_model = args[i];
            } else {
                Logger::Log("Missing argument to '-mcmodel'.", LogSeverity::Error);
                return 1;
            }
        } else if arg.StartsWith('-') {
            Logger::Log("Unknown option '" + arg + "'.", LogSeverity::Error);
            return 1;
        } else {
            if FileExists(arg) {
                input_files.PushBack(arg);
            } else {
                Logger::Log("Cannot find '" + arg + "'.", LogSeverity::Error);
                return 1;
            }
        } i += 1;
    }

    if input_files.Empty() {
        Logger::Log("No input files.", LogSeverity::Error);
        return 1;
    }

    if !output_file.Empty() && input_files.Length() > 1 && (emit_object || emit_asm) {
        Logger::Log("Cannot specify '-o' when generating multiple output files.", LogSeverity::Error);
        return 1;
    }

    if triple.Contains("zenith") {
        defines.PushBack("ZENITH".ToString());
    } else if triple.Contains("windows") {
        defines.PushBack("WINDOWS".ToString());
    } else if triple.Contains("darwin") || triple.Contains("apple") {
        defines.PushBack("DARWIN".ToString());
    } else if triple.Contains("linux") {
        defines.PushBack("LINUX".ToString());
    }

    if triple.StartsWith("zodiac") {
        defines.PushBack("ZODIAC".ToString());

        if !emit_asm && !check {
            Logger::Log("The Zodiac target can only generate assembly, use '-S' and assemble with 'zas'.", LogSeverity::Error);
            return 1;
        }
    } else if triple.Contains("x86_64") || triple.Contains("x64") || triple.Contains("amd64") {
        defines.PushBack("AMD64".ToString());
    } else if triple.Contains("aarch64") || triple.Contains("arm64") {
        defines.PushBack("ARM64".ToString());
    }

    if triple.Contains("darwin") || triple.Contains("apple") || (triple.Contains("linux") && !freestanding) {
        defines.PushBack("LIBC".ToString());
    }

#[if !ZODIAC]
    let start = Instant::Now();
    let mut objects = Vector<String>();
    let mut temp_files = Vector<String>();
    let temp_path = match TemporaryPath() {
        Result<String, IOError>::Ok(path) => path,
        Result<String, IOError>::Err(error) => {
            Logger::Log("Failed to get temporary path: " + error.ToString() + ".", LogSeverity::Error);
            return 1;
        }
    };
#[endif]
    let mut entry_included = false;
    let mut failed = false;

    for input_file in input_files {
        let (name, extension) = SplitExtension(input_file);

#[if ZODIAC]
        let target = Target(triple);
#[else]
        let mut module: LLVMModuleRef = null;
        let target = Target(triple, arch, code_model, features, opt_level);
        let mut llvm_lowerer = LLVMLowerer(target, freestanding, no_red_zone);
        let mut assembler = Assembler(target);
#[endif]

        if target.backend == TargetBackend::Zodiac && extension != ".zir" {
            failed = true;
            Logger::Log(input_file, "Only Zircon sources can be compiled for the Zodiac target.", LogSeverity::Error);
            Logger::Clear();
            continue;
        }

        if extension == ".zir" {
            if verbose {
                Logger::Log("Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut lexer = Lexer();
            let mut preprocessor = Preprocessor();
            preprocessor.include_paths = include_paths;
            preprocessor.defines = defines;

            let mut source = match File::ReadText(input_file) {
                Result<String, IOError>::Ok(source) => source,
                Result<String, IOError>::Err(error) => {
                    failed = true;
                    Logger::Log(input_file, "Failed to read file: " + error.ToString() + ".", LogSeverity::Error);
                    Logger::Clear();
                    continue;
                }
            };

            if !entry_included && !check && !freestanding {
                source += "\n#[include \"std/rt\" : *]\n";
                entry_included = true;
            }

            let mut tokens = preprocessor.Process(lexer.Lex(source, input_file), input_file);

            let mut parser = Parser();
#[if !ZODIAC]
            let ast_start = Instant::Now();
#[endif]
            let ast_module = parser.Parse(tokens);
            tokens.Clear();
#[if !ZODIAC]
            WriteLine("AST module parsed in " + String::FromFloat(ast_start.Elapsed()) + " seconds.");
#[endif]

            let mut hir_lowerer = HIRLowerer(target.Info());
#[if !ZODIAC]
            let hir_start = Instant::Now();
#[endif]
            let mut hir_module: *HIRModule = null;

            if !Logger::HasError() {
                hir_module = hir_lowerer.Lower(ast_module);
            }

            if !check && !Logger::HasError() && hir_module != null {
#[if !ZODIAC]
                WriteLine("HIR module lowered in " + String::FromFloat(hir_start.Elapsed()) + " seconds.");
#[endif]
                if emit_hir { WriteOutput(name + ".hir", hir_module->ToString()); }
                parser.arena.Clear();

                let mut mir_lowerer = MIRLowerer(target.Info());
#[if !ZODIAC]
                let mir_start = Instant::Now();
#[endif]
                let mir_module = mir_lowerer.Lower(hir_module);
                hir_lowerer.context.arena.Reset();
#[if !ZODIAC]
                WriteLine("MIR module lowered in " + String::FromFloat(mir_start.Elapsed()) + " seconds.");
#[endif]

                if target.backend == TargetBackend::Zodiac {
                    let mut pass_manager = MIRPassManager(&mut mir_lowerer.context);
                    pass_manager.Add(MIRPassKind::ReorderBlocks);
                    pass_manager.Add(MIRPassKind::PromoteAllocas);
#[if !ZODIAC]
                    let passes_start = Instant::Now();
#[endif]
                    pass_manager.Run(mir_module);
#[if !ZODIAC]
                    WriteLine("MIR passes ran in " + String::FromFloat(passes_start.Elapsed()) + " seconds.");
#[endif]
                }

                if emit_mir { WriteOutput(name + ".mir", mir_module->ToString()); }

                if target.backend == TargetBackend::Zodiac {
                    let mut lir_lowerer = LIRLowerer();
#[if !ZODIAC]
                    let lir_start = Instant::Now();
#[endif]
                    let lir_module = lir_lowerer.Lower(mir_module);
                    mir_lowerer.context.arena.Reset();
#[if !ZODIAC]
                    WriteLine("LIR module lowered in " + String::FromFloat(lir_start.Elapsed()) + " seconds.");
#[endif]
                    if emit_lir { WriteOutput(name + ".virtual.lir", lir_module->ToString()); }

                    let mut allocator = LIRAllocator(&mut lir_lowerer.context);
#[if !ZODIAC]
                    let allocator_start = Instant::Now();
#[endif]
                    allocator.Allocate(lir_module);
#[if !ZODIAC]
                    WriteLine("LIR module allocated in " + String::FromFloat(allocator_start.Elapsed()) + " seconds.");
#[endif]
                    if Logger::HasError() {
                        failed = true;
                        Logger::Clear();
                        continue;
                    }
                    if emit_lir { WriteOutput(name + ".physical.lir", lir_module->ToString()); }

                    if emit_asm {
                        let mut asm_name = name + ".s";
                        if !output_file.Empty() { asm_name = output_file; }
                        let mut emitter = ZodiacEmitter();
                        let assembly = emitter.Emit(lir_module);
                        if !Logger::HasError() { WriteOutput(asm_name, assembly); }
                    }
#[if !ZODIAC]
                } else {
                    let llvm_start = Instant::Now();
                    module = llvm_lowerer.Lower(mir_module);
                    WriteLine("LLVM module lowered in " + String::FromFloat(llvm_start.Elapsed()) + " seconds.");
#[endif]
                }
            }
#[if !ZODIAC]
        } else if extension == ".ll" || extension == ".bc" {
            if verbose {
                Logger::Log("Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut buffer: LLVMMemoryBufferRef = null;
            let mut message: *mut i8 = null;

            if LLVMCreateMemoryBufferWithContentsOfFile(input_file.Data(), &mut buffer, &mut message) != 0 {
                let final_message = if message != null { message } else { "Unknown reason." };
                Logger::Log(input_file, "Failed to read file: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
                message = null;
            }

            if buffer != null {
                if extension == ".ll" {
                    if LLVMParseIRInContext2(llvm_lowerer.context, buffer, &mut module, &mut message) != 0 {
                        let final_message = if message != null { message } else { "Unknown reason." };
                        Logger::Log(input_file, "Failed to parse LLVM IR: " + final_message.ToString(), LogSeverity::Error);
                    }
                } else {
                    if LLVMParseBitcodeInContext(LLVMGetGlobalContext(), buffer, &mut module, &mut message) != 0 {
                        let final_message = if message != null { message } else { "Unknown reason." };
                        Logger::Log(input_file, "Failed to parse bitcode: " + final_message.ToString(), LogSeverity::Error);
                    }
                }

                if message != null {
                    LLVMDisposeMessage(message);
                    message = null;
                }

                LLVMDisposeMemoryBuffer(buffer);
            }

            if module != null {
                LLVMSetSourceFileName(module, input_file.Data(), input_file.Length());
                LLVMSetModuleDataLayout(module, target.layout);
                LLVMSetTarget(module, target.triple.Data());

                if LLVMVerifyModule(module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
                    let final_message = if message != null { message } else { "Unknown reason." };
                    Logger::Log(input_file, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);
                    LLVMDisposeModule(module);
                    module = null;
                }

                if message != null {
                    LLVMDisposeMessage(message);
                }
            }
        } else if extension == ".asm" || extension == ".s" {
            if emit_asm {
                Logger::Log("Skipping input: '" + input_file + "'.", LogSeverity::Warning);
                continue;
            }

            if verbose {
                Logger::Log("Assembling: '" + input_file + "'.", LogSeverity::Info);
            }

            match File::ReadText(input_file) {
                Result<String, IOError>::Ok(source) => {
                    module = assembler.Assemble(source);
                },
                Result<String, IOError>::Err(error) => {
                    failed = true;
                    Logger::Log(input_file, "Failed to read file: " + error.ToString() + ".", LogSeverity::Error);
                    Logger::Clear();
                    continue;
                }
            }
        } else if extension == ".obj" || extension == ".o" {
            if emit_object {
                Logger::Log("Skipping input: '" + input_file + "'.", LogSeverity::Warning);
            } else {
                objects.PushBack(input_file);
            } continue;
#[endif]
        } else {
            Logger::Log(input_file, "Unsupported file extension '" + extension + "'.", LogSeverity::Error);
        }

        failed |= Logger::HasError();

#[if !ZODIAC]
        if target.backend == TargetBackend::LLVM && !check {
            failed |= module == null;
        }
#[endif]

        if check || failed {
            if !check {
                Logger::Clear();
            } continue;
        }

        if target.backend == TargetBackend::Zodiac {
            continue;
        }

#[if !ZODIAC]
        if opt_level != LLVMCodeGenOptLevel::LLVMCodeGenLevelNone && extension == ".zir" {
            let mut passes = String();

            match opt_level {
                LLVMCodeGenOptLevel::LLVMCodeGenLevelLess => {
                    passes = "default<O1>";
                },
                LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault => {
                    passes = "default<O2>";
                },
                LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive => {
                    passes = "default<O3>";
                },
                _ => {}
            }

            if passes.Size() > 1 {
                let pass_options = LLVMCreatePassBuilderOptions();
                let error = LLVMRunPasses(module, passes.Data(), target.target_machine, pass_options);
                LLVMDisposePassBuilderOptions(pass_options);

                if error != LLVMErrorSuccess as LLVMErrorRef {
                    let message = LLVMGetErrorMessage(error);
                    Logger::Log(input_file, "Failed to optimize module: " + message.ToString(), LogSeverity::Error);
                    LLVMDisposeErrorMessage(message);
                    return 1;
                }
            }
        }

        if emit_llvm && extension != ".ll" {
            let mut message: *mut i8 = null;

            if LLVMPrintModuleToFile(module, (name + ".ll").Data(), &mut message) != 0 {
                let final_message = if message != null { message } else { "Unknown reason." };
                Logger::Log(input_file, "Failed to emit LLVM IR: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
            }
        }

        if emit_bc && extension != ".bc" {
            if LLVMWriteBitcodeToFile(module, (name + ".bc").Data()) != 0 {
                Logger::Log(input_file, "Failed to emit LLVM bitcode.", LogSeverity::Error);
            }
        }

        if emit_asm {
            let mut asm_name = name + ".s";
            if !output_file.Empty() { asm_name = output_file; }
            let result = target.Emit(module, asm_name, LLVMCodeGenFileType::LLVMAssemblyFile);

            if !result.Empty() {
                Logger::Log(input_file, "Failed to emit assembly: " + result, LogSeverity::Error);
                return 1;
            } continue;
        }

        let mut object_name = name + (if triple.Contains("windows") { ".obj" } else { ".o" });

        if !emit_object {
            object_name = JoinPath(temp_path, SplitPath(object_name).1);
        } else if !output_file.Empty() {
            object_name = output_file;
        }

        let result = target.Emit(module, object_name, LLVMCodeGenFileType::LLVMObjectFile);

        if !result.Empty() {
            Logger::Log(input_file, "Failed to emit object: " + result, LogSeverity::Error);
            return 1;
        }

        objects.PushBack(object_name);

        if !emit_object {
            temp_files.PushBack(object_name);
        }
#[endif]
    }

#[if ZODIAC]
    if failed { 1 } else { 0 }
#[else]
    if check || failed || emit_object || emit_asm {
        for temp_file in temp_files {
            RemoveFile(temp_file);
        } return if failed { 1 } else { 0 };
    }

    if output_file.Empty() {
        output_file = SplitExtension(input_files[0]).0;
        if triple.Contains("windows") { output_file += ".exe"; }
    }

#[if WINDOWS]
    let lld_exe = "ld.lld.exe".ToString();
    let lld64_exe = "ld64.lld.exe".ToString();
    let lld_link_exe = "lld-link.exe".ToString();
#[else]
    let lld_exe = "ld.lld".ToString();
    let lld64_exe = "ld64.lld".ToString();
    let lld_link_exe = "lld-link".ToString();
#[endif]
    let mut command = String();
    let arm64 = triple.Contains("aarch64") || triple.Contains("arm64");

    if triple.Contains("windows") {
#[if WINDOWS]
        let (sdk_path, msvc_path) = (GetWindowsSDKPath(), GetMSVCPath());
        let machine = if arm64 { "arm64" } else { "x64" };
        command = "\"" + msvc_path + "\\bin\\Hostx64\\x64\\link.exe\" /NOLOGO /SUBSYSTEM:CONSOLE /NODEFAULTLIB /ENTRY:_start /MACHINE:" + machine;
        if debug { command += " /DEBUG"; }
        command += " /OUT:" + output_file;

        for object in objects {
            command += " " + object;
        }

        if !freestanding {
            command += " \"/LIBPATH:" + msvc_path + "\\lib\\" + machine + "\"";
            command += " \"/LIBPATH:" + sdk_path + "\\um\\" + machine + "\"";
            command += " \"/LIBPATH:" + sdk_path + "\\ucrt\\" + machine + "\"";

            for lib_path in lib_paths {
                command += " \"/LIBPATH:" + lib_path + "\"";
            }

            command += " user32.lib shell32.lib kernel32.lib";

            for lib in libs {
                command += " " + lib + ".lib";
            }
        }
#[else]
        Logger::Log("Cannot link to windows from another platform.", LogSeverity::Error);
        return 1;
#[endif]
    } else if triple.Contains("darwin") || triple.Contains("apple") {
#[if DARWIN]
        command = "cc -arch ".ToString() + (if arm64 { "arm64" } else { "x64" }) + " -o " + output_file;

        for object in objects {
            command += " " + object;
        }

        for lib_path in lib_paths {
            command += " -L" + lib_path + " -Wl,-rpath," + lib_path;
        }

        for lib in libs {
            command += " -l" + lib;
        }
#[else]
        Logger::Log("Cannot link to darwin from another platform.", LogSeverity::Error);
        return 1;
#[endif]
    } else if triple.Contains("linux") {
        command = lld_exe + " --nostdlib --entry _start";

        if !freestanding {
            command += if arm64 { " --dynamic-linker /lib/ld-linux-aarch64.so.1" } else { " --dynamic-linker /lib64/ld-linux-x86-64.so.2" };
        }

        command += " -o " + output_file;

        for object in objects {
            command += " " + object;
        }

        for lib_path in lib_paths {
            command += " -L" + lib_path;
        }

#[if !WINDOWS]
        if arm64 {
            command += " -L/usr/lib/aarch64-linux-gnu -L/lib/aarch64-linux-gnu";
        } else if triple.Contains("x86_64") {
            command += " -L/usr/lib/x86_64-linux-gnu -L/lib/x86_64-linux-gnu";
        }

        command += " -L/usr/lib64 -L/lib64 -L/usr/lib -L/lib";
#[endif]

        for lib in libs {
            command += " -l" + lib;
        }

        if !freestanding {
            command += " -l:libc.so.6";
        }
    } else {
        Logger::Log("Invalid target: '" + triple + "'.", LogSeverity::Error);
        return 1;
    }

    if verbose {
        Logger::Log("Link: '" + command.Replace("\"", "") + "'.", LogSeverity::Info);
    }

    let result = Execute(command.Data());

    if result != 0 {
        Logger::Log("Linking failed with exit code " + String::FromInteger(result as u64) + ".", LogSeverity::Error);

        for temp_file in temp_files {
            RemoveFile(temp_file);
        } return 1;
    }

    WriteLine("Program compiled in " + String::FromFloat(start.Elapsed()) + " seconds.");

    for temp_file in temp_files {
        RemoveFile(temp_file);
    }

    if run {
#[if !WINDOWS]
        if SplitPath(output_file).0.Empty() { output_file = JoinPath(String("."), output_file); }
#[endif]
        WriteLine("Program finished with exit code: " + String::FromInteger(Execute(output_file.Data()) as u64) + ".");
    }

    0
#[endif]
}
