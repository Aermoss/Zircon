#[include "std/str", "std/vec", "std/map", "std/arena",
    "src/Logger.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/AST.zir" : *]

class Parser {
    pub arena: Arena,
    tokens: Vector<Token>,
    previous: SourceSpan,
    index: usize;

    fn New<T>(&mut this, args...) -> *mut T {
        let node = this.arena.New<T>(args...);
        this.Finish(node);
        node
    }

    fn Finish(&this, node: *mut ASTNode) {
        if node != null && node->span.file == this.previous.file && this.previous.end > node->span.end {
            node->span.end = this.previous.end;
        }
    }

    fn Rewind(&mut this, index: usize) {
        this.index = index;
        this.previous = if index > 0 { this.tokens[index - 1].span } else { this.tokens[0].span };
    }

    fn ExpectedAt(&this, token: &Token) -> SourceSpan {
        let (current, previous) = (Sources()->File(token.span.file), Sources()->File(this.previous.file));
        if this.index == 0 || current == null || previous == null { return token.span; }

        if token._type == TokenType::EOF || token.span.file != this.previous.file || current->Line(token.span.start) != previous->Line(this.previous.end) {
            return SourceSpan { file: this.previous.file, start: this.previous.end, end: this.previous.end };
        }

        token.span
    }

    fn Current(&this) -> Token {
        if this.index >= this.tokens.Length() {
            this.tokens[this.tokens.Length() - 1]
        } else {
            this.tokens[this.index]
        }
    }

    fn Peek(&this, offset: usize) -> Token {
        let index = this.index + offset;

        if index >= this.tokens.Length() {
            this.tokens[this.tokens.Length() - 1]
        } else {
            this.tokens[index]
        }
    }

    fn PeekBack(&this, offset: usize) -> Token {
        if offset > this.index {
            this.tokens[0]
        } else {
            this.tokens[this.index - offset]
        }
    }

    fn Advance(&mut this) -> Token {
        let token = this.Current();

        if this.index < this.tokens.Length() {
            this.index += 1;
            this.previous = token.span;
        }

        token
    }

    fn Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            true
        } else {
            false
        }
    }

    fn Expect(&mut this, _type: TokenType) -> Token {
        let token = this.Current();
        if token._type == _type { return this.Advance(); }
        this.ReportExpected(_type, token);

        let mut error: Token;
        (error._type, error.span) = (TokenType::UNKNOWN, token.span);
        error
    }

    fn ReportExpected(&this, _type: TokenType, token: &Token) {
        let span = this.ExpectedAt(token);
        let text = token.Text();

        if token._type == TokenType::EOF {
            Logger::Log("Expected '" + _type.ToString() + "', but reached end of file.", span, LogSeverity::Error);
        } else if !text.Empty() && text != token._type.ToString() {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + text + "' (" + token._type.ToString() + ").", span, LogSeverity::Error);
        } else {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + token._type.ToString() + "'.", span, LogSeverity::Error);
        }
    }

    fn ExpectSuccess(&mut this, _type: TokenType) -> bool {
        let token = this.Current();

        if token._type == _type {
            this.Advance();
            return true;
        }

        this.ReportExpected(_type, token);
        false
    }

    fn IsTypeApplication(&this) -> bool {
        if this.Current()._type != TokenType::LESS { return false; }
        let (mut index, mut depth): (usize, usize) = (1, 1);

        loop {
            let token = this.Peek(index);
            if token._type == TokenType::EOF { return false; }
            let _type = token._type;
            index += 1;

            match _type {
                TokenType::LESS => {
                    depth += 1;
                },
                TokenType::GREATER => {
                    if depth >= 1 {
                        depth -= 1;
                    } else {
                        return false;
                    }
                },
                TokenType::SEMICOLON | TokenType::LBRACE | TokenType::RBRACE => {
                    return false;
                },
                _ => {
                    if _type != TokenType::IDENTIFIER && _type != TokenType::COLON && _type != TokenType::DOUBLE_COLON && _type != TokenType::LPAREN && _type != TokenType::RPAREN
                        && _type != TokenType::MUL && _type != TokenType::BITWISE_AND && _type != TokenType::MUT && _type != TokenType::CONST && _type != TokenType::LBRACKET && _type != TokenType::RBRACKET
                            && _type != TokenType::FUNCTION && _type != TokenType::THREE_DOT && _type != TokenType::ARROW && _type != TokenType::INTEGER && _type != TokenType::COMMA { return false; }
                }
            }

            if depth == 0 {
                let next = this.Peek(index);

                return next._type != TokenType::IDENTIFIER && next._type != TokenType::INTEGER && next._type != TokenType::FLOAT && next._type != TokenType::STRING
                    && next._type != TokenType::CHAR && next._type != TokenType::TRUE && next._type != TokenType::FALSE && next._type != TokenType::NULL;
            }
        }

        false
    }

    fn ParsePath(&mut this) -> *ASTPath {
        let token = this.Current();
        let path = this.New<ASTPath>(this.Match(TokenType::DOUBLE_COLON), token.span);

        loop {
            if this.Match(TokenType::OPERATOR) {
                let mut _identifier = "operator".ToString();

                while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                    _identifier += this.Current().Text();
                    this.Advance();
                }

                path->segments.PushBack(ASTPathSegment(_identifier));
            } else {
                let _identifier = this.Expect(if this.Current()._type != TokenType::THIS { TokenType::IDENTIFIER } else { TokenType::THIS });
                if _identifier._type == TokenType::UNKNOWN { return null; }
                let mut segment = ASTPathSegment(_identifier.Text());

                if this.IsTypeApplication() {
                    this.Advance();

                    while this.Current()._type != TokenType::GREATER {
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        segment.types.PushBack(_type);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                } path->segments.PushBack(segment);
            }

            if !this.Match(TokenType::DOUBLE_COLON) {
                break;
            }
        }

        this.Finish(path);
        path
    }

    fn ParsePrimary(&mut this) -> *ASTExpression {
        let token = this.Current();

        match token._type {
            TokenType::TRUE | TokenType::FALSE => {
                this.Advance();
                this.New<ASTBooleanLiteral>(token._type == TokenType::TRUE, token.span)
            },
            TokenType::CHAR => {
                this.Advance();
                let value = Lexer::Unescape(token.span);

                if !(value.Size() == 2 && value[1] == '\0') && !(value.Size() == 1 && value[0] == '\0') {
                    Logger::Log("Invalid character literal '" + value + "'.", token, LogSeverity::Error);
                    return null;
                }

                this.New<ASTCharacterLiteral>(value[0] as u32, token.span)
            },
            TokenType::INTEGER => {
                this.Advance();
                let text = token.Text();
                let (mut value, mut suffix, mut base): (String, String, HostUnsigned) = (String(), String(), 10);
                let mut index = text.Find('u');

                if index.IsNone() {
                    index = text.Find('i');
                }

                if let Option<usize>::Some(index) = index {
                    value = text.SubString(0, index);
                    suffix = text.SubString(index);
                } else {
                    value = text;
                }

                if value.StartsWith("0x") || value.StartsWith("0X") {
                    (value, base) = (value.SubString(2), 16);
                } else if value.StartsWith("0o") || value.StartsWith("0O") {
                    (value, base) = (value.SubString(2), 8);
                } else if value.StartsWith("0b") || value.StartsWith("0B") {
                    (value, base) = (value.SubString(2), 2);
                }

                match value.ToUnsignedInteger(base) {
                    Option<HostUnsigned>::Some(value) => this.New<ASTIntegerLiteral>(value, suffix, token.span),
                    Option<HostUnsigned>::None => {
                        Logger::Log("Invalid integer literal '" + text + "'.", token, LogSeverity::Error);
                        null
                    }
                }
            },
            TokenType::FLOAT => {
#[if ZODIAC]
                this.Advance();
                Logger::Log("Floating point literals are not supported by the Zodiac compiler.", token, LogSeverity::Error);
                null
#[else]
                this.Advance();
                let (mut value, mut suffix) = (String(), String());
                let text = token.Text();

                if let Option<usize>::Some(index) = text.Find('f') {
                    value = text.SubString(0, index);
                    suffix = text.SubString(index);
                } else {
                    value = text;
                }

                match value.ToFloat() {
                    Option<f64>::Some(value) => this.New<ASTFloatLiteral>(value, suffix, token.span),
                    Option<f64>::None => {
                        Logger::Log("Invalid float literal '" + text + "'.", token, LogSeverity::Error);
                        null
                    }
                }
#[endif]
            },
            TokenType::STRING => {
                this.Advance();
                this.New<ASTStringLiteral>(Lexer::Unescape(token.span), token.span)
            },
            TokenType::NULL => {
                this.Advance();
                this.New<ASTNullLiteral>(token.span)
            },
            TokenType::IDENTIFIER | TokenType::THIS | TokenType::OPERATOR | TokenType::DOUBLE_COLON => this.New<ASTPathExpression>(this.ParsePath(), token.span),
            TokenType::LBRACKET => {
                this.Advance();
                let array = this.New<ASTArrayLiteral>(token.span);

                if !this.Match(TokenType::RBRACKET) {
                    let expression = this.ParseExpression();
                    if expression == null { return null; }
                    array->elements.PushBack(expression);

                    if this.Match(TokenType::SEMICOLON) {
                        array->count = this.ParseExpression();
                        if array->count == null { return null; }
                        if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                        this.Finish(array);
                        return array;
                    }

                    while this.Match(TokenType::COMMA) {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        array->elements.PushBack(expression);
                    }

                    if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                }

                this.Finish(array);
                array
            },
            TokenType::LPAREN => {
                this.Advance();

                if this.Match(TokenType::RPAREN) {
                    return this.New<ASTTupleLiteral>(token.span);
                }

                let mut expression = this.ParseExpression();
                if expression == null { return null; }
                let mut tuple: *mut ASTTupleLiteral = null;

                if this.Match(TokenType::COMMA) {
                    tuple = this.New<ASTTupleLiteral>(token.span);
                    tuple->elements.PushBack(expression);

                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        tuple->elements.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    } expression = tuple;
                }

                if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                this.Finish(tuple);
                expression
            },
            TokenType::UNSAFE | TokenType::LBRACE | TokenType::IF | TokenType::WHILE | TokenType::LOOP | TokenType::FOR | TokenType::MATCH | TokenType::LABEL => this.ParseBlockLikeExpression(),
            TokenType::RETURN => {
                this.Advance();
                let mut value: *ASTExpression = null;

                if this.StartsExpression() {
                    value = this.ParseExpression();
                    if value == null { return null; }
                }

                this.New<ASTReturnExpression>(value, token.span)
            },
            TokenType::BREAK => {
                this.Advance();
                let label = if this.Current()._type == TokenType::LABEL { this.Advance().Text().SubString(1) } else { String() };
                let mut value: *ASTExpression = null;

                if this.StartsExpression() {
                    value = this.ParseExpression();
                    if value == null { return null; }
                }

                this.New<ASTBreakExpression>(label, value, token.span)
            },
            TokenType::CONTINUE => {
                this.Advance();
                let label = if this.Current()._type == TokenType::LABEL { this.Advance().Text().SubString(1) } else { String() };
                this.New<ASTContinueExpression>(label, token.span)
            },
            _ => {
                this.Advance();
                Logger::Log("Unexpected token '" + token.Text() + "'.", token, LogSeverity::Error);
                null
            }
        }
    }

    fn ParsePostfix(&mut this) -> *ASTExpression {
        let expression = this.ParsePrimary();
        if expression == null { return null; }
        this.ParsePostfix(expression)
    }

    fn ParsePostfix(&mut this, mut expression: *ASTExpression) -> *ASTExpression {
        loop {
            let token = this.Current();

            match token._type {
                TokenType::LPAREN => {
                    this.Advance();
                    let call = this.New<ASTCallExpression>(expression, expression->span);

                    if !this.Match(TokenType::RPAREN) {
                        while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                            let expression = this.ParseExpression();
                            if expression == null { return null; }
                            call->arguments.PushBack(expression);

                            if !this.Match(TokenType::COMMA) {
                                break;
                            }
                        }

                        if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    }

                    this.Finish(call);
                    expression = call;
                },
                TokenType::DOT | TokenType::ARROW => {
                    this.Advance();

                    if this.Current()._type == TokenType::INTEGER {
                        let value = this.Advance().Text();

                        match value.ToUnsignedInteger() {
                            Option<HostUnsigned>::Some(index) => {
                                expression = this.New<ASTTupleAccessExpression>(expression, index as usize, token._type == TokenType::ARROW, expression->span);
                            },
                            Option<HostUnsigned>::None => {
                                Logger::Log("Invalid tuple index '" + value + "'.", token, LogSeverity::Error);
                                return null;
                            }
                        }

                        continue;
                    }

                    let member_access = this.New<ASTMemberAccessExpression>(expression, token._type == TokenType::ARROW, expression->span);
                    let member_start = this.Current().span;

                    if this.Match(TokenType::OPERATOR) {
                        member_access->member += "operator";

                        while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                            member_access->member += this.Current().Text();
                            this.Advance();
                        }
                    } else {
                        let identifier = this.Expect(TokenType::IDENTIFIER);
                        if identifier._type == TokenType::UNKNOWN { return null; }
                        member_access->member += identifier.Text();
                    }

                    member_access->member_span = SourceSpan { file: member_start.file, start: member_start.start, end: this.previous.end };

                    if this.IsTypeApplication() {
                        this.Advance();

                        while this.Current()._type != TokenType::GREATER {
                            let _type = this.ParseType();
                            if _type == null { return null; }
                            member_access->types.PushBack(_type);
                            if !this.Match(TokenType::COMMA) { break; }
                        }

                        if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                    }

                    this.Finish(member_access);
                    expression = member_access;
                },
                TokenType::QUESTION_MARK => {
                    this.Advance();
                    expression = this.New<ASTTryExpression>(expression, expression->span);
                },
                TokenType::LBRACKET => {
                    this.Advance();
                    let mut _expression = this.ParseExpression();
                    if _expression == null { return null; }

                    if this.Current()._type == TokenType::TWO_DOT {
                        this.Advance();
                        let inclusive = this.Match(TokenType::ASSIGN);
                        let end = this.ParseExpression();
                        if end == null { return null; }
                        let range = this.New<ASTRangeExpression>(_expression, end, _expression->span);
                        range->inclusive = inclusive;
                        _expression = range;
                    }

                    let access = this.New<ASTIndexAccessExpression>(expression, _expression, expression->span);
                    if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                    access->bracket = token.span;
                    this.Finish(access);
                    expression = access;
                },
                TokenType::LBRACE if this.Peek(1)._type == TokenType::IDENTIFIER && this.Peek(2)._type == TokenType::COLON => {
                    this.Advance();
                    let structure = this.New<ASTStructureLiteral>(expression, expression->span);

                    while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                        if this.Current()._type == TokenType::TWO_DOT {
                            this.Advance();
                            break;
                        }

                        let field_identifier = this.Expect(TokenType::IDENTIFIER);
                        if field_identifier._type == TokenType::UNKNOWN { return null; }
                        if !this.ExpectSuccess(TokenType::COLON) { return null; }
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        structure->fields[field_identifier.Text()] = expression;
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
                    this.Finish(structure);
                    expression = structure;
                },
                TokenType::THREE_DOT => {
                    this.Advance();
                    expression = this.New<ASTPackSplatExpression>(expression, expression->span);
                },
                _ => {
                    break;
                }
            }
        }

        expression
    }

    fn ParseUnaryExpression(&mut this) -> *ASTExpression {
        let token = this.Current();

        match token._type {
            TokenType::BITWISE_AND => {
                this.Advance();
                let mutable = this.Match(TokenType::MUT);
                let expression = this.ParseUnaryExpression();
                if expression == null { return null; }
                this.New<ASTUnaryExpression>(ASTUnaryKind::AddressOf, expression, mutable, token.span)
            },
            TokenType::MUL => {
                this.Advance();
                let expression = this.ParseUnaryExpression();
                if expression == null { return null; }
                this.New<ASTUnaryExpression>(ASTUnaryKind::Dereference, expression, false, token.span)
            },
            TokenType::MINUS => {
                this.Advance();
                let expression = this.ParseUnaryExpression();
                if expression == null { return null; }
                this.New<ASTUnaryExpression>(ASTUnaryKind::Negate, expression, false, token.span)
            },
            TokenType::NOT => {
                this.Advance();
                let expression = this.ParseUnaryExpression();
                if expression == null { return null; }
                this.New<ASTUnaryExpression>(ASTUnaryKind::Not, expression, false, token.span)
            },
            TokenType::NEW => {
                this.Advance();
                let _type = this.ParseType();
                if _type == null { return null; }
                let _new = this.New<ASTNewExpression>(_type, token.span);

                if this.Match(TokenType::LBRACKET) {
                    _new->size = this.ParseExpression();

                    if _new->size == null || !this.ExpectSuccess(TokenType::RBRACKET) {
                        return null;
                    }
                } else if this.Match(TokenType::LPAREN) {
                    _new->initialized = true;

                    if !this.Match(TokenType::RPAREN) {
                        while this.Current()._type != TokenType::RPAREN {
                            let argument = this.ParseExpression();
                            if argument == null { return null; }
                            _new->arguments.PushBack(argument);
                            if !this.Match(TokenType::COMMA) { break; }
                        }

                        if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    }
                }

                this.Finish(_new);
                _new
            },
            TokenType::DELETE => {
                this.Advance();
                let _delete = this.New<ASTDeleteExpression>(token.span);

                if this.Match(TokenType::LBRACKET) {
                    if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                    _delete->array = true;
                }

                _delete->expression = this.ParseExpression();
                if _delete->expression == null { return null; }
                this.Finish(_delete);
                _delete
            },
            TokenType::AWAIT => {
                this.Advance();
                let expression = this.ParseUnaryExpression();
                if expression == null { return null; }
                this.New<ASTAwaitExpression>(expression, token.span)
            },
            _ => this.ParsePostfix()
        }
    }

    fn GetBinaryPrecedence(&this, _type: TokenType) -> i32 {
        match _type {
            TokenType::OR => 1,
            TokenType::AND => 2,
            TokenType::EQUAL | TokenType::NOT_EQUAL => 3,
            TokenType::LESS | TokenType::LESS_EQUAL | TokenType::GREATER | TokenType::GREATER_EQUAL => 4,
            TokenType::BITWISE_OR => 5,
            TokenType::BITWISE_XOR => 6,
            TokenType::BITWISE_AND => 7,
            TokenType::LSHIFT | TokenType::RSHIFT => 8,
            TokenType::PLUS | TokenType::MINUS => 9,
            TokenType::MUL | TokenType::DIV | TokenType::MOD => 10,
            TokenType::AS => 11,
            _ => -1
        }
    }

    fn ParseBinaryKind(&this, _type: TokenType) -> ASTBinaryKind {
        match _type {
            TokenType::PLUS => ASTBinaryKind::Add,
            TokenType::MINUS => ASTBinaryKind::Subtract,
            TokenType::MUL => ASTBinaryKind::Multiply,
            TokenType::DIV => ASTBinaryKind::Divide,
            TokenType::MOD => ASTBinaryKind::Modulo,
            TokenType::EQUAL => ASTBinaryKind::Equal,
            TokenType::NOT_EQUAL => ASTBinaryKind::NotEqual,
            TokenType::LESS => ASTBinaryKind::Less,
            TokenType::LESS_EQUAL => ASTBinaryKind::LessEqual,
            TokenType::GREATER => ASTBinaryKind::Greater,
            TokenType::GREATER_EQUAL => ASTBinaryKind::GreaterEqual,
            TokenType::AND => ASTBinaryKind::LogicalAnd,
            TokenType::OR => ASTBinaryKind::LogicalOr,
            TokenType::BITWISE_AND => ASTBinaryKind::BitwiseAnd,
            TokenType::BITWISE_OR => ASTBinaryKind::BitwiseOr,
            TokenType::BITWISE_XOR => ASTBinaryKind::BitwiseXor,
            TokenType::LSHIFT => ASTBinaryKind::LeftShift,
            _ => ASTBinaryKind::RightShift
        }
    }

    fn ParseBinaryExpression(&mut this, min_precedence: i32) -> *ASTExpression {
        let mut left = this.ParseUnaryExpression();
        if left == null { return null; }

        loop {
            let mut token = this.Current();

            if this.Peek(1)._type == token._type {
                if token._type == TokenType::GREATER {
                    token._type = TokenType::RSHIFT;
                    this.Advance();
                }

                if token._type == TokenType::LESS {
                    token._type = TokenType::LSHIFT;
                    this.Advance();
                }
            }

            let precedence = this.GetBinaryPrecedence(token._type);
            if precedence < min_precedence { break; }
            this.Advance();

            if token._type == TokenType::AS {
                let _type = this.ParseType();
                if _type == null { return null; }
                left = this.New<ASTCastExpression>(left, _type, left->span);
            } else {
                let right = this.ParseBinaryExpression(precedence + 1);
                if right == null { return null; }
                left = this.New<ASTBinaryExpression>(this.ParseBinaryKind(token._type), left, right, left->span);
            }
        }

        left
    }

    fn ParseExpression(&mut this) -> *ASTExpression {
        this.ParseBinaryExpression(0)
    }

    fn ParsePrimaryPattern(&mut this) -> *ASTPattern {
        let token = this.Current();

        if token._type == TokenType::IDENTIFIER && token.Text() == "_" {
            this.Advance();
            return this.New<ASTWildcardPattern>(token.span);
        }

        if this.Match(TokenType::TWO_DOT) {
            if this.Match(TokenType::ASSIGN) {
                let end = this.ParsePatternBound();
                if end == null { return null; }
                return this.New<ASTRangePattern>(null, end, true, token.span);
            } return this.New<ASTRestPattern>(token.span);
        }

        if token._type == TokenType::LPAREN {
            this.Advance();
            let tuple = this.New<ASTTuplePattern>(token.span);

            while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                let element = this.ParsePattern();
                if element == null { return null; }
                tuple->patterns.PushBack(element);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            this.Finish(tuple);
            return tuple;
        }

        if this.Match(TokenType::BITWISE_AND) {
            let mutable = this.Match(TokenType::MUT);
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return null; }
            return this.New<ASTIdentifierPattern>(identifier.Text(), mutable, true, token.span);
        }

        if this.Match(TokenType::MUT) {
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return null; }
            return this.New<ASTIdentifierPattern>(identifier.Text(), true, false, token.span);
        }

        if token._type == TokenType::IDENTIFIER && this.Peek(1)._type != TokenType::DOUBLE_COLON && this.Peek(1)._type != TokenType::LPAREN && this.Peek(1)._type != TokenType::LBRACE && this.Peek(1)._type != TokenType::LESS {
            this.Advance();
            return this.New<ASTIdentifierPattern>(token.Text(), false, false, token.span);
        }

        if token._type == TokenType::IDENTIFIER || token._type == TokenType::DOUBLE_COLON {
            let path = this.ParsePath();
            if path == null { return null; }

            if this.Match(TokenType::LBRACE) {
                let structure = this.New<ASTStructurePattern>(path, token.span);

                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    if this.Current()._type == TokenType::TWO_DOT {
                        let rest = this.Advance();
                        structure->patterns.PushBack(this.New<ASTRestPattern>(rest.span));
                        break;
                    }

                    let field_identifier = this.Expect(TokenType::IDENTIFIER);
                    if field_identifier._type == TokenType::UNKNOWN { return null; }
                    let mut field: *ASTPattern = null;

                    if this.Match(TokenType::COLON) {
                        field = this.ParsePattern();
                        if field == null { return null; }
                    } else {
                        field = this.New<ASTIdentifierPattern>(field_identifier.Text(), false, false, field_identifier.span);
                    }

                    structure->patterns.PushBack(this.New<ASTFieldPattern>(field_identifier.Text(), field, field_identifier.span));
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
                this.Finish(structure);
                return structure;
            }

            if this.Match(TokenType::LPAREN) {
                let variant = this.New<ASTVariantPattern>(path, token.span);

                while this.Current()._type != TokenType::RPAREN {
                    let argument = this.ParsePattern();
                    if argument == null { return null; }
                    variant->patterns.PushBack(argument);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                this.Finish(variant);
                return variant;
            }

            return this.New<ASTPathPattern>(path, token.span);
        }

        let start = this.ParsePatternBound();
        if start == null { return null; }

        if this.Match(TokenType::TWO_DOT) {
            let inclusive = this.Match(TokenType::ASSIGN);
            let mut end: *ASTExpression = null;

            if inclusive || this.IsPatternBound() {
                end = this.ParsePatternBound();
                if end == null { return null; }
            }

            return this.New<ASTRangePattern>(start, end, inclusive, token.span);
        }

        this.New<ASTLiteralPattern>(start, token.span)
    }

    fn IsPatternBound(&this) -> bool {
        match this.Current()._type {
            TokenType::INTEGER | TokenType::FLOAT | TokenType::CHAR | TokenType::MINUS => true,
            _ => false
        }
    }

    fn ParsePatternBound(&mut this) -> *ASTExpression {
        let token = this.Current();

        if this.Match(TokenType::MINUS) {
            let operand = this.ParsePrimary();
            if operand == null { return null; }
            return this.New<ASTUnaryExpression>(ASTUnaryKind::Negate, operand, false, token.span);
        }

        this.ParsePrimary()
    }

    fn ParsePattern(&mut this) -> *ASTPattern {
        let mut left = this.ParsePrimaryPattern();
        if left == null { return null; }

        if this.Match(TokenType::BITWISE_OR) {
            let or = this.New<ASTOrPattern>(left->span);
            or->patterns.PushBack(left);

            loop {
                let right = this.ParsePrimaryPattern();
                if right == null { return null; }
                or->patterns.PushBack(right);

                if !this.Match(TokenType::BITWISE_OR) {
                    break;
                }
            }

            this.Finish(or);
            return or;
        }

        left
    }

    fn ParseType(&mut this) -> *ASTType {
        let start = this.Current();
        let mut references = Vector<bool>();

        if this.Match(TokenType::BITWISE_AND) {
            references.PushBack(this.Match(TokenType::MUT));
        }

        let mut pointers = Vector<bool>();

        while this.Match(TokenType::MUL) {
            if this.Match(TokenType::MUT) {
                pointers.PushBack(true);
            } else {
                pointers.PushBack(false);
            }
        }

        let token = this.Current();

        let mut node: *ASTType = if this.Match(TokenType::NOT) {
            this.New<ASTNeverType>(token.span)
        } else if this.Match(TokenType::FUNCTION) {
            if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
            let function = this.New<ASTFunctionType>(token.span);

            if this.Current()._type != TokenType::RPAREN {
                while this.Current()._type != TokenType::EOF {
                    if this.Match(TokenType::THREE_DOT) {
                        function->var_arg = true;
                        break;
                    }

                    if this.Current()._type == TokenType::MUT || this.Peek(1usize)._type == TokenType::COLON || this.Peek(1usize)._type == TokenType::LBRACKET {
                        let parameter = this.ParseParameter();
                        if parameter == null { return null; }
                        function->parameters.PushBack(parameter->_type);
                    } else {
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        function->parameters.PushBack(_type);
                    }

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }

            if this.Match(TokenType::ARROW) {
                function->_return = this.ParseType();
                if function->_return == null { return null; }
            }

            this.Finish(function);
            function
        } else if this.Match(TokenType::LBRACKET) {
            let element = this.ParseType();
            if element == null { return null; }
            let mut length: *ASTExpression = null;

            if !this.Match(TokenType::RBRACKET) {
                if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                length = this.ParseExpression();
                if length == null { return null; }
                if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
            }

            this.New<ASTArrayType>(element, length, token.span)
        } else if this.Match(TokenType::LPAREN) {
            let tuple = this.New<ASTTupleType>(token.span);

            while this.Current()._type != TokenType::RPAREN {
                let element = this.ParseType();
                if element == null { return null; }
                tuple->elements.PushBack(element);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            this.Finish(tuple);
            tuple
        } else {
            this.New<ASTPathType>(this.ParsePath(), token.span)
        };

        while let Option<bool>::Some(mutable) = pointers.PopBack() {
            node = this.New<ASTPointerType>(node, mutable, start.span);
        }

        if !references.Empty() {
            node = this.New<ASTReferenceType>(node, references[0], start.span);
        }

        node
    }

    fn ParseAssignmentKind(&this, _type: TokenType) -> ASTAssignmentKind {
        match _type {
            TokenType::ASSIGN => ASTAssignmentKind::Assign,
            TokenType::PLUS_ASSIGN => ASTAssignmentKind::AddAssign,
            TokenType::MINUS_ASSIGN => ASTAssignmentKind::SubtractAssign,
            TokenType::MUL_ASSIGN => ASTAssignmentKind::MultiplyAssign,
            TokenType::DIV_ASSIGN => ASTAssignmentKind::DivideAssign,
            TokenType::MOD_ASSIGN => ASTAssignmentKind::ModuloAssign,
            TokenType::AND_ASSIGN => ASTAssignmentKind::AndAssign,
            TokenType::OR_ASSIGN => ASTAssignmentKind::OrAssign,
            TokenType::XOR_ASSIGN => ASTAssignmentKind::XorAssign,
            TokenType::LSHIFT_ASSIGN => ASTAssignmentKind::LeftShiftAssign,
            _ => ASTAssignmentKind::RightShiftAssign
        }
    }

    fn ParseStatement(&mut this) -> *ASTStatement {
        let token = this.Current();

        match token._type {
            TokenType::LET => this.ParseLetStatement(),
            TokenType::ASSEMBLY | TokenType::VOLATILE => this.ParseAssemblyStatement(),
            TokenType::UNSAFE | TokenType::LBRACE | TokenType::IF | TokenType::WHILE | TokenType::LOOP | TokenType::FOR | TokenType::MATCH | TokenType::LABEL => {
                let mut expression = this.ParseBlockLikeExpression();
                if expression == null { return null; }

                if this.Current()._type != TokenType::DOT && this.Current()._type != TokenType::ARROW {
                    let statement = this.New<ASTExpressionStatement>(expression, token.span);
                    statement->semicolon = this.Match(TokenType::SEMICOLON);
                    return statement;
                }

                expression = this.ParsePostfix(expression);
                if expression == null { return null; }
                let statement = this.New<ASTExpressionStatement>(expression, token.span);
                statement->semicolon = this.Current()._type != TokenType::RBRACE;
                if statement->semicolon && !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                statement
            },
            _ => {
                let index = this.index;

                if this.Peek(1)._type != TokenType::RPAREN && this.Match(TokenType::LPAREN) {
                    let mut current: *mut ASTAssignmentExpression = null;
                    let mut root: *mut ASTAssignmentExpression = null;

                    while root == null || this.Match(TokenType::COMMA) {
                        let _expression = this.ParseExpression();
                        if _expression == null { return null; }
                        let assignment = this.New<ASTAssignmentExpression>(ASTAssignmentKind::Assign, _expression, null, token.span);

                        if root != null {
                            current->next = assignment;
                        } else {
                            root = assignment;
                        } current = assignment;
                    }

                    if root->next != null && this.Match(TokenType::RPAREN) && this.Match(TokenType::ASSIGN) {
                        if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                        current = root;

                        while current != null {
                            current->right = this.ParseExpression();
                            if current->right == null { return null; }

                            if current->next != null {
                                if !this.ExpectSuccess(TokenType::COMMA) { return null; }
                            } current = current->next;
                        }

                        if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                        return this.New<ASTExpressionStatement>(root, token.span);
                    } else {
                        this.Rewind(index);
                    }
                }

                let left = this.ParseExpression();
                if left == null { return null; }
                let _operator = this.Current();

                if _operator._type == TokenType::ASSIGN || _operator._type == TokenType::PLUS_ASSIGN || _operator._type == TokenType::MINUS_ASSIGN || _operator._type == TokenType::MUL_ASSIGN || _operator._type == TokenType::DIV_ASSIGN || _operator._type == TokenType::MOD_ASSIGN
                    || _operator._type == TokenType::AND_ASSIGN || _operator._type == TokenType::OR_ASSIGN || _operator._type == TokenType::XOR_ASSIGN || _operator._type == TokenType::LSHIFT_ASSIGN || _operator._type == TokenType::RSHIFT_ASSIGN {

                    this.Advance();
                    let right = this.ParseExpression();
                    if right == null { return null; }
                    let assignment = this.New<ASTAssignmentExpression>(this.ParseAssignmentKind(_operator._type), left, right, left->span);
                    if this.Current()._type != TokenType::RBRACE && !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                    return this.New<ASTExpressionStatement>(assignment, token.span);
                }

                let statement = this.New<ASTExpressionStatement>(left, token.span);
                statement->semicolon = this.Current()._type != TokenType::RBRACE;
                if statement->semicolon && !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                statement
            }
        }
    }

    fn ParseLetStatement(&mut this) -> *ASTLetStatement {
        let token = this.Expect(TokenType::LET);
        if token._type == TokenType::UNKNOWN { return null; }
        let pattern = this.ParsePattern();
        if pattern == null { return null; }
        let mut _type: *ASTType = null;

        if this.Match(TokenType::COLON) {
            _type = this.ParseType();
            if _type == null { return null; }
        }

        let mut initializer: *ASTExpression = null;

        if this.Match(TokenType::ASSIGN) {
            initializer = this.ParseExpression();
            if initializer == null { return null; }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        this.New<ASTLetStatement>(pattern, _type, initializer, token.span)
    }

    fn ParseCondition(&mut this) -> *ASTCondition {
        if this.Match(TokenType::LET) {
            let pattern = this.ParsePattern();
            if pattern == null { return null; }
            if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
            let expression = this.ParseExpression();
            if expression == null { return null; }
            this.arena.New<ASTCondition>(pattern, expression)
        } else {
            let expression = this.ParseExpression();
            if expression == null { return null; }
            this.arena.New<ASTCondition>(expression)
        }
    }

    fn StartsExpression(&this) -> bool {
        let _type = this.Current()._type;
        _type != TokenType::SEMICOLON && _type != TokenType::COMMA && _type != TokenType::RBRACE && _type != TokenType::RPAREN && _type != TokenType::RBRACKET && _type != TokenType::EOF
    }

    fn ParseLabeledExpression(&mut this) -> *ASTExpression {
        let token = this.Advance();
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let label = token.Text().SubString(1);

        match this.Current()._type {
            TokenType::WHILE => {
                let expression = this.ParseWhileExpression();
                if expression != null { (expression->label, expression->span.start) = (label, token.span.start); }
                expression
            },
            TokenType::LOOP => {
                let expression = this.ParseLoopExpression();
                if expression != null { (expression->label, expression->span.start) = (label, token.span.start); }
                expression
            },
            TokenType::FOR => {
                let expression = this.ParseForExpression();
                if expression != null { (expression->label, expression->span.start) = (label, token.span.start); }
                expression
            },
            TokenType::UNSAFE | TokenType::LBRACE => {
                let expression = this.ParseBlockExpression();
                if expression != null { (expression->label, expression->span.start) = (label, token.span.start); }
                expression
            },
            _ => {
                Logger::Log("Labels can only be applied to loops and blocks.", token, LogSeverity::Error);
                null
            }
        }
    }

    fn ParseBlockLikeExpression(&mut this) -> *ASTExpression {
        match this.Current()._type {
            TokenType::LABEL => this.ParseLabeledExpression(),
            TokenType::IF => this.ParseIfExpression(),
            TokenType::WHILE => this.ParseWhileExpression(),
            TokenType::LOOP => this.ParseLoopExpression(),
            TokenType::FOR => this.ParseForExpression(),
            TokenType::MATCH => this.ParseMatchExpression(),
            _ => this.ParseBlockExpression()
        }
    }

    fn ParseIfExpression(&mut this) -> *ASTIfExpression {
        let token = this.Expect(TokenType::IF);
        if token._type == TokenType::UNKNOWN { return null; }
        let condition = this.ParseCondition();
        if condition == null { return null; }
        let body = this.ParseBlock();
        if body == null { return null; }
        let mut _else: *ASTExpression = null;

        if this.Match(TokenType::ELSE) {
            if this.Current()._type == TokenType::IF {
                _else = this.ParseIfExpression();
            } else {
                _else = this.ParseBlock();
            }

            if _else == null { return null; }
        }

        this.New<ASTIfExpression>(condition, body, _else, token.span)
    }

    fn ParseWhileExpression(&mut this) -> *mut ASTWhileExpression {
        let token = this.Expect(TokenType::WHILE);
        if token._type == TokenType::UNKNOWN { return null; }
        let condition = this.ParseCondition();
        if condition == null { return null; }
        let body = this.ParseBlock();
        if body == null { return null; }
        let mut _else: *ASTBlockExpression = null;

        if this.Match(TokenType::ELSE) {
            _else = this.ParseBlock();
            if _else == null { return null; }
        }

        this.New<ASTWhileExpression>(condition, body, _else, token.span)
    }

    fn ParseLoopExpression(&mut this) -> *mut ASTLoopExpression {
        let token = this.Expect(TokenType::LOOP);
        if token._type == TokenType::UNKNOWN { return null; }
        let body = this.ParseBlock();
        if body == null { return null; }
        this.New<ASTLoopExpression>(body, token.span)
    }

    fn ParseForIterable(&mut this) -> *ASTExpression {
        let left = this.ParseBinaryExpression(0);
        if left == null { return null; }

        if this.Current()._type == TokenType::TWO_DOT {
            let token = this.Advance();
            let inclusive = this.Match(TokenType::ASSIGN);
            let right = this.ParseBinaryExpression(0);
            if right == null { return null; }
            let range = this.New<ASTRangeExpression>(left, right, left->span);
            range->inclusive = inclusive;
            return range;
        }

        left
    }

    fn ParseForExpression(&mut this) -> *mut ASTForExpression {
        let token = this.Expect(TokenType::FOR);
        if token._type == TokenType::UNKNOWN { return null; }
        let pattern = this.ParsePattern();
        if pattern == null { return null; }
        if !this.ExpectSuccess(TokenType::IN) { return null; }
        let iterable = this.ParseForIterable();
        if iterable == null { return null; }
        let body = this.ParseBlock();
        if body == null { return null; }
        this.New<ASTForExpression>(pattern, iterable, body, token.span)
    }

    fn ParseMatchExpression(&mut this) -> *ASTMatchExpression {
        let token = this.Expect(TokenType::MATCH);
        if token._type == TokenType::UNKNOWN { return null; }
        let target = this.ParseExpression();
        if target == null { return null; }
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }
        let _match = this.New<ASTMatchExpression>(target, token.span);

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let pattern = this.ParsePattern();
            if pattern == null { return null; }
            let mut guard: *ASTExpression = null;

            if this.Match(TokenType::IF) {
                guard = this.ParseExpression();
                if guard == null { return null; }
            }

            if !this.ExpectSuccess(TokenType::FAT_ARROW) { return null; }
            let block = this.Current()._type == TokenType::LBRACE;
            let mut body: *mut ASTBlockExpression = null;

            if block {
                body = this.ParseBlock();
                if body == null { return null; }
            } else {
                let value = this.ParseExpression();
                if value == null { return null; }
                body = this.New<ASTBlockExpression>(value->span);
                body->tail = value;
            }

            _match->arms.PushBack(this.arena.New<ASTMatchArm>(pattern, guard, body));

            if !this.Match(TokenType::COMMA) && (!block || this.Current()._type == TokenType::RBRACE) {
                break;
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        this.Finish(_match);
        _match
    }

    fn ParseBlockExpression(&mut this) -> *mut ASTBlockExpression {
        let start = this.Current();
        let _unsafe = this.Match(TokenType::UNSAFE);
        let block = this.ParseBlock();
        if block == null { return null; }
        block->_unsafe = _unsafe;
        if _unsafe { block->span.start = start.span.start; }
        block
    }

    fn ParseAssemblyStatement(&mut this) -> *ASTAssemblyStatement {
        let _volatile = this.Match(TokenType::VOLATILE);
        let token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { return null; }
        let node = this.New<ASTAssemblyStatement>(_volatile, token.span);

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let name = this.Advance().Text();
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->inputs.PushBack(this.arena.New<ASTAssemblyOperand>(name, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::ARROW) { return null; }
        }

        let text = this.Expect(TokenType::ASSEMBLY_TEXT);
        if text._type == TokenType::UNKNOWN { return null; }
        node->text = Lexer::AssemblyCode(text.span);

        if this.Match(TokenType::ARROW) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let name = this.Advance().Text();
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->outputs.PushBack(this.arena.New<ASTAssemblyOperand>(name, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                node->clobbers.PushBack(this.Advance().Text());
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        this.Finish(node);
        node
    }

    fn ParseBlock(&mut this) -> *mut ASTBlockExpression {
        let token = this.Expect(TokenType::LBRACE);
        if token._type == TokenType::UNKNOWN { return null; }
        let block = this.New<ASTBlockExpression>(token.span);

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let statement = this.ParseStatement();

            if statement != null {
                block->statements.PushBack(statement);
            } else {
                while this.Current()._type != TokenType::EOF && this.Current()._type != TokenType::RBRACE {
                    let _type = this.Current()._type;

                    if _type == TokenType::SEMICOLON {
                        this.Advance();
                        break;
                    }

                    if _type == TokenType::LET || _type == TokenType::IF || _type == TokenType::WHILE || _type == TokenType::FOR || _type == TokenType::LOOP || _type == TokenType::MATCH || _type == TokenType::RETURN || _type == TokenType::BREAK || _type == TokenType::CONTINUE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE {
                        break;
                    }

                    this.Advance();
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        this.Finish(block);

        if !block->statements.Empty() {
            let last = block->statements.Back();

            if last->kind == ASTStatementKind::Expression && !(last as *ASTExpressionStatement)->semicolon {
                block->tail = (last as *ASTExpressionStatement)->expression;
                block->statements.PopBack();
            }
        }

        block
    }

    fn SynchronizeDeclaration(&mut this) {
        while this.Current()._type != TokenType::EOF {
            let _type = this.Current()._type;

            if _type == TokenType::FUNCTION || _type == TokenType::CLASS || _type == TokenType::ENUMERATION || _type == TokenType::EXTERN || _type == TokenType::INCLUDE || _type == TokenType::CONST || _type == TokenType::STATIC || _type == TokenType::TYPE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE || _type == TokenType::AT {
                break;
            }

            this.Advance();
        }
    }

    fn ParseAttributes(&mut this) -> Vector<(String, Vector<*ASTNode>)> {
        let mut attributes = Vector<(String, Vector<*ASTNode>)>();

        while this.Match(TokenType::AT) {
            let mut pair = (String(), Vector<*ASTNode>());
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return attributes; }
            pair.0 = identifier.Text();

            if this.Match(TokenType::LPAREN) {
                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return attributes; }
                        pair.1.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return attributes; }
                }
            }

            attributes.PushBack(pair);
        }

        attributes
    }

    fn ParseDeclaration(&mut this) -> *ASTDeclaration {
        let attributes = this.ParseAttributes();
        let token = this.Current();

        match token._type {
            TokenType::FUNCTION => this.ParseFunctionDeclaration(attributes, false),
            TokenType::CLASS => this.ParseClassDeclaration(attributes),
            TokenType::STRUCTURE => this.ParseStructureDeclaration(attributes),
            TokenType::ENUMERATION => {
                if this.Peek(2)._type == TokenType::COLON {
                    this.ParseEnumerationDeclaration(attributes)
                } else {
                    this.ParseVariantDeclaration(attributes)
                }
            },
            TokenType::EXTEND => this.ParseExtendDeclaration(),
            TokenType::EXTERN => this.ParseExternDeclaration(),
            TokenType::CONST => this.ParseConstantDeclaration(),
            TokenType::STATIC => this.ParseStaticDeclaration(attributes),
            TokenType::TYPE => this.ParseTypeDeclaration(),
            TokenType::ASSEMBLY | TokenType::VOLATILE => this.ParseAssemblyDeclaration(),
            _ => {
                this.Advance();
                Logger::Log("Expected declaration.", token, LogSeverity::Error);
                null
            }
        }
    }

    fn ParseFunctionDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>, _class: bool) -> *ASTFunctionDeclaration {
        let token = this.Current();
        let (mut no_mangle, mut track_caller) = (false, false);

        for attribute in attributes {
            if attribute.0 != "nomangle" && attribute.0 != "track_caller" {
                Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
                return null;
            }

            if attribute.1.Length() != 0 {
                Logger::Log("Invalid number of arguments for attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
                return null;
            }

            if (attribute.0 == "nomangle" && no_mangle) || (attribute.0 == "track_caller" && track_caller) {
                Logger::Log("Attribute '" + attribute.0 + "' already set.", token, LogSeverity::Error);
                return null;
            }

            if attribute.0 == "nomangle" {
                no_mangle = true;
            } else {
                track_caller = true;
            }
        }

        let mut public = this.Match(TokenType::PUBLIC);
        let _virtual = this.Match(TokenType::VIRTUAL);
        let _override = !_virtual && this.Match(TokenType::OVERRIDE);
        let mut name = String();

        if (_virtual || _override) && !_class {
            Logger::Log("Only methods can be 'virtual' or 'override'.", token, LogSeverity::Error);
            return null;
        }

        if _virtual && !public && this.Current()._type == TokenType::IDENTIFIER {
            Logger::Log("Constructors cannot be virtual.", token, LogSeverity::Error);
            return null;
        }

        if !_class || public || _override || (_virtual && this.Current()._type != TokenType::TILDE) {
            if !this.ExpectSuccess(TokenType::FUNCTION) { return null; }
        } else {
            if this.Match(TokenType::TILDE) {
                name += '~';
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.Text();
                public = true;
            } else if !_virtual && this.Match(TokenType::IDENTIFIER) {
                name += token.Text();
                public = true;
            } else if !this.ExpectSuccess(TokenType::FUNCTION) {
                return null;
            }
        }

        if name.Empty() {
            if this.Match(TokenType::OPERATOR) {
                name += "operator";

                while this.Current()._type != TokenType::LPAREN {
                    name += this.Current().Text();
                    this.Advance();
                }
            } else {
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.Text();
            }
        } else if track_caller {
            Logger::Log("Attribute 'track_caller' cannot be used on constructors or destructors.", token, LogSeverity::Error);
            return null;
        }

        let function = this.New<ASTFunctionDeclaration>(name, public, no_mangle, track_caller, token.span);
        (function->_virtual, function->_override) = (_virtual, _override);

        if this.Match(TokenType::LESS) {
            function->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_identifier = this.Expect(TokenType::IDENTIFIER);
                if type_identifier._type == TokenType::UNKNOWN { return null; }
                function->types.PushBack(type_identifier.Text());
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LPAREN) {
            return null;
        }

        if this.Current()._type != TokenType::RPAREN {
            let mut has_instance = true;

            if this.Match(TokenType::BITWISE_AND) {
                let mutable = this.Match(TokenType::MUT);
                if !this.ExpectSuccess(TokenType::THIS) { return null; }
                function->instance_kind = if mutable { ASTInstanceKind::MutRef } else { ASTInstanceKind::ConstRef };
            } else if this.Match(TokenType::THIS) {
                function->instance_kind = ASTInstanceKind::Copy;
            } else {
                has_instance = false;
            }

            if !has_instance || this.Match(TokenType::COMMA) {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1)._type == TokenType::THREE_DOT {
                        let pack_identifier = this.Expect(TokenType::IDENTIFIER);
                        if pack_identifier._type == TokenType::UNKNOWN { return null; }
                        function->pack_name = pack_identifier.Text();
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function->var_arg = true;
                        break;
                    }

                    let param = this.ParseParameter();
                    if param == null { return null; }
                    function->parameters.PushBack(param);

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RPAREN) {
            return null;
        }

        if this.Match(TokenType::ASYNC) {
            function->_async = true;
        }

        if this.Match(TokenType::ARROW) {
            function->_return = this.ParseType();
            if function->_return == null { return null; }
        } else {
            if token._type != TokenType::PUBLIC && token._type != TokenType::VIRTUAL && token._type != TokenType::OVERRIDE && token._type != TokenType::FUNCTION {
                while (this.Match(TokenType::COLON) && function->constructors.Empty()) || (this.Match(TokenType::COMMA) && !function->constructors.Empty()) {
                    let expression = this.ParseExpression();
                    if expression == null { return null; }

                    if expression->kind == ASTExpressionKind::Call {
                        function->constructors.PushBack(expression as *ASTCallExpression);
                    } else {
                        Logger::Log("Expected a constructor.", token, LogSeverity::Error);
                        break;
                    }
                }
            }
        }

        if this.Current()._type == TokenType::LBRACE {
            let body = this.ParseBlock();
            if body == null { return null; }
            function->body = body;
        } else if !this.ExpectSuccess(TokenType::SEMICOLON) {
            return null;
        }

        function
    }

    fn ParseParameter(&mut this) -> *ASTParameterDeclaration {
        let mutable = this.Match(TokenType::MUT);
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        this.New<ASTParameterDeclaration>(token.Text(), _type, mutable, token.span)
    }

    fn ParseClassDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>) -> *ASTClassDeclaration {
        let token = this.Expect(TokenType::CLASS);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let _class = this.New<ASTClassDeclaration>(identifier.Text(), token.span);

        if this.Match(TokenType::LESS) {
            _class->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_identifier = this.Expect(TokenType::IDENTIFIER);
                if type_identifier._type == TokenType::UNKNOWN { return null; }
                _class->types.PushBack(type_identifier.Text());
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if this.Match(TokenType::COLON) {
            _class->parent = this.ParseType();
            if _class->parent == null { return null; }

            if this.Current()._type == TokenType::COMMA {
                Logger::Log("A class can have only one parent.", this.Current(), LogSeverity::Error);
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            return null;
        }

        let mut state = false;

        if this.Current()._type == TokenType::PUBLIC && this.Peek(1)._type == TokenType::IDENTIFIER && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET) {
            state = true;
        }

        if this.Current()._type == TokenType::IDENTIFIER && (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) {
            state = true;
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let field = this.ParseField();
                if field == null { return null; }
                _class->fields.PushBack(field);

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let token = this.Current();
                let function = this.ParseFunctionDeclaration(attributes, true);
                if function == null { return null; }

                if function->name.StartsWith('~') {
                    if _class->destructor != null {
                        Logger::Log("Multiple destructor declarations are not allowed.", token, LogSeverity::Error);
                        return null;
                    }

                    _class->destructor = function;
                } else if token._type == TokenType::PUBLIC || token._type == TokenType::VIRTUAL || token._type == TokenType::OVERRIDE || token._type == TokenType::FUNCTION {
                    _class->methods.PushBack(function);
                } else {
                    _class->constructors.PushBack(function);
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        _class
    }

    fn ParseStructureDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>) -> *ASTStructureDeclaration {
        let token = this.Expect(TokenType::STRUCTURE);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let structure = this.New<ASTStructureDeclaration>(identifier.Text(), token.span);

        if this.Match(TokenType::LESS) {
            structure->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_identifier = this.Expect(TokenType::IDENTIFIER);
                if type_identifier._type == TokenType::UNKNOWN { return null; }
                structure->types.PushBack(type_identifier.Text());
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            return null;
        }

        let mut state = false;

        if this.Current()._type == TokenType::PUBLIC && this.Peek(1)._type == TokenType::IDENTIFIER && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET) {
            state = true;
        }

        if this.Current()._type == TokenType::IDENTIFIER && (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) {
            state = true;
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let field = this.ParseField();
                if field == null { return null; }
                structure->fields.PushBack(field);

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let function = this.ParseFunctionDeclaration(attributes, false);
                if function == null { return null; }
                structure->methods.PushBack(function);
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        structure
    }

    fn ParseField(&mut this) -> *ASTFieldDeclaration {
        let public = this.Match(TokenType::PUBLIC);
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let mut initializer = null;

        if this.Match(TokenType::ASSIGN) {
            initializer = this.ParseExpression();
            if initializer == null { return null; }
        }

        this.New<ASTFieldDeclaration>(token.Text(), _type, initializer, public, token.span)
    }

    fn ParseEnumerationDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>) -> *ASTEnumerationDeclaration {
        let token = this.Expect(TokenType::ENUMERATION);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let enumeration = this.New<ASTEnumerationDeclaration>(identifier.Text(), token.span);
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        enumeration->underlying_type = this.ParseType();
        if enumeration->underlying_type == null { return null; }
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let member_identifier = this.Expect(TokenType::IDENTIFIER);
            if member_identifier._type == TokenType::UNKNOWN { return null; }
            let member = this.New<ASTEnumerationMember>(member_identifier.Text(), member_identifier.span);

            if this.Match(TokenType::ASSIGN) {
                member->value = this.ParseExpression();
                if member->value == null { return null; }
            }

            enumeration->members.PushBack(member);

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        enumeration
    }

    fn ParseVariantDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>) -> *ASTVariantDeclaration {
        let token = this.Expect(TokenType::ENUMERATION);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let variant = this.New<ASTVariantDeclaration>(identifier.Text(), token.span);

        if this.Match(TokenType::LESS) {
            variant->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_identifier = this.Expect(TokenType::IDENTIFIER);
                if type_identifier._type == TokenType::UNKNOWN { return null; }
                variant->types.PushBack(type_identifier.Text());
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) { 
            return null; 
        }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let member_identifier = this.Expect(TokenType::IDENTIFIER);
            if member_identifier._type == TokenType::UNKNOWN { return null; }
            let member = this.New<ASTVariantMember>(member_identifier.Text(), member_identifier.span);

            if this.Match(TokenType::LPAREN) {
                while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                    let field_type = this.ParseType();
                    if field_type == null { return null; }
                    member->fields.PushBack(this.arena.New<ASTVariantField>(field_type));
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            } else if this.Match(TokenType::LBRACE) {
                member->structure = true;

                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    let field_identifier = this.Expect(TokenType::IDENTIFIER);
                    if field_identifier._type == TokenType::UNKNOWN { return null; }
                    if !this.ExpectSuccess(TokenType::COLON) { return null; }
                    let field_type = this.ParseType();
                    if field_type == null { return null; }
                    member->fields.PushBack(this.arena.New<ASTVariantField>(field_identifier.Text(), field_type));
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
            }

            variant->members.PushBack(member);

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let function = this.ParseFunctionDeclaration(attributes, false);
                if function == null { return null; }
                variant->methods.PushBack(function);
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        variant
    }

    fn ParseExtendDeclaration(&mut this) -> *ASTExtendDeclaration {
        let token = this.Expect(TokenType::EXTEND);
        if token._type == TokenType::UNKNOWN { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let _extend = this.New<ASTExtendDeclaration>(_type, token.span);
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let attributes = this.ParseAttributes();
            let function = this.ParseFunctionDeclaration(attributes, false);
            if function == null { return null; }
            _extend->methods.PushBack(function);
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        _extend
    }

    fn ParseExternDeclaration(&mut this) -> *ASTExternDeclaration {
        let extern_token = this.Expect(TokenType::EXTERN);
        if extern_token._type == TokenType::UNKNOWN { return null; }
        let linkage_token = this.Expect(TokenType::STRING);
        if linkage_token._type == TokenType::UNKNOWN { return null; }
        let extern_block = this.New<ASTExternDeclaration>(Lexer::Unescape(linkage_token.span), extern_token.span);
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let attributes = this.ParseAttributes();

            match this.Current()._type {
                TokenType::FUNCTION => {
                    let function = this.ParseFunctionDeclaration(attributes, false);

                    if function == null {
                        this.SynchronizeDeclaration();
                        continue;
                    }

                    extern_block->declarations.PushBack(function);
                },
                TokenType::STATIC => {
                    let _static = this.ParseStaticDeclaration(attributes);

                    if _static == null {
                        this.SynchronizeDeclaration();
                        continue;
                    }

                    extern_block->declarations.PushBack(_static);
                },
                _ => {
                    Logger::Log("Only function and static declarations allowed in extern block.", this.Current(), LogSeverity::Error);
                    this.Advance();
                    this.SynchronizeDeclaration();
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        extern_block
    }

    fn ParseConstantDeclaration(&mut this) -> *ASTConstantDeclaration {
        let token = this.Expect(TokenType::CONST);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let initializer = this.ParseExpression();
        if initializer == null || !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        this.New<ASTConstantDeclaration>(identifier.Text(), _type, initializer, token.span)
    }

    fn ParseStaticDeclaration(&mut this, attributes: &Vector<(String, Vector<*ASTNode>)>) -> *ASTStaticDeclaration {
        let token = this.Expect(TokenType::STATIC);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut alignment = null;

        for attribute in attributes {
            if attribute.0 == "align" {
                if attribute.1.Length() != 1 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
                    return null;
                }

                if alignment != null {
                    Logger::Log("Attribute '" + attribute.0 + "' already set.", token, LogSeverity::Error);
                    return null;
                }

                alignment = attribute.1[0];
            } else {
                Logger::Log("Invalid attribute '" + attribute.0 + "'.", token, LogSeverity::Error);
                return null;
            }
        }

        let mutable = this.Match(TokenType::MUT);
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let _static = this.New<ASTStaticDeclaration>(identifier.Text(), _type, mutable, alignment, token.span);

        if this.Match(TokenType::ASSIGN) {
            _static->initializer = this.ParseExpression();
            if _static->initializer == null { return null; }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        _static
    }

    fn ParseTypeDeclaration(&mut this) -> *ASTTypeDeclaration {
        let token = this.Expect(TokenType::TYPE);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let type_definition = this.New<ASTTypeDeclaration>(identifier.Text(), _type, token.span);
        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        type_definition
    }

    fn ParseAssemblyDeclaration(&mut this) -> *ASTAssemblyDeclaration {
        let token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { return null; }
        let code = this.Expect(TokenType::ASSEMBLY_TEXT);
        if code._type == TokenType::UNKNOWN { return null; }
        this.New<ASTAssemblyDeclaration>(Lexer::AssemblyCode(code.span), token.span)
    }

    pub fn Parse(&mut this, tokens: &Vector<Token>) -> *ASTModule {
        let module = this.arena.New<ASTModule>();
        this.previous = if tokens.Empty() { SourceSpan { file: 0, start: 0, end: 0 } } else { tokens[0].span };
        (this.tokens, this.index) = (tokens, 0);

        while this.Current()._type != TokenType::EOF {
            let declaration = this.ParseDeclaration();

            if declaration != null {
                module->declarations.PushBack(declaration);
            } else {
                this.SynchronizeDeclaration();
            }
        }

        module
    }
}
