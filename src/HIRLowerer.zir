enum HIRLoweringPass: u8 {
    None, First, Second, Third, Fourth
}

#[include "std/str", "std/vec", "std/map", "std/pair", "std/arena",
    "src/ScopeManager.zir", "src/Scope.zir", "src/Symbol.zir", "src/Generic.zir",
        "src/Token.zir", "src/AST.zir", "src/HIR.zir", "src/Logger.zir" : *]

enum HIRBindingMode: u8 {
    Value, Reference
}

enum HIRBlockTail: u8 {
    Value, Discard, Return
}

class HIRLoweringFrame {
    pub scope: *mut Scope = null,
    pub function: *mut HIRFunctionDeclaration = null,
    pub block: *mut HIRBlockExpression = null,
    pub generic: *mut GenericDeclaration = null,
    pub _type: *HIRType = null,
    pub abi: HIRDeclarationABI = HIRDeclarationABI::Native,
    pub linkage: HIRDeclarationLinkage = HIRDeclarationLinkage::Internal,
    pub _unsafe: bool = false,
    pub temporaries: Vector<*HIRExpression>,
    pub temporary_stack: Vector<Vector<*HIRExpression>>,
    pub loop_scopes: Vector<*mut Scope>,
    pub loop_targets: Vector<*mut HIRLoopExpression>,
    pub loop_temporaries: Vector<usize>;

    HIRLoweringFrame(&mut this, scope: *mut Scope, generic: *mut GenericDeclaration, _type: *HIRType) {
        (this.scope, this.generic, this._type) = (scope, generic, _type);
    }
}

class HIRLowerer {
    context: HIRContext,
    pub module: *mut HIRModule = null,
    pub builder: HIRBuilder,
    pub extension_registry: HIRExtensionRegistry,
    pub scope_manager: ScopeManager,

    pub current_pass: HIRLoweringPass = HIRLoweringPass::None,
    class_data: Map<*ASTNode, Pair<*mut HIRClassDeclaration, *mut Scope>>,
    structure_data: Map<*ASTNode, Pair<*mut HIRStructureDeclaration, *mut Scope>>,
    variant_data: Map<*ASTNode, Pair<*mut HIRVariantDeclaration, *mut Scope>>,
    extend_data: Map<*ASTNode, Pair<*mut HIRExtendDeclaration, *mut Scope>>,
    function_data: Map<*ASTNode, *mut HIRFunctionDeclaration>,

    temporaries: Vector<*HIRExpression>,
    temporary_stack: Vector<Vector<*HIRExpression>>,
    loop_scopes: Vector<*mut Scope>,
    loop_targets: Vector<*mut HIRLoopExpression>,
    loop_temporaries: Vector<usize>,

    pub abi: HIRDeclarationABI = HIRDeclarationABI::Native,
    pub linkage: HIRDeclarationLinkage = HIRDeclarationLinkage::Internal,
    _unsafe: bool = false,

    pub generics: Vector<*mut GenericDeclaration>,
    current_generic: *mut GenericDeclaration = null,
    pub current_type: *HIRType = null;

    HIRLowerer(&mut this) {
        if hir_lowerer != null {
            Logger::Log("Another instance of 'HIRLowerer' already exists!", LogSeverity::Fatal);
        } hir_lowerer = this;
    }

    ~HIRLowerer(&mut this) {
        hir_lowerer = null;
    }

    pub fn SwapFrame(&mut this, frame: &mut HIRLoweringFrame) {
        let (scope, function, block) = (this.scope_manager.current, this.builder.GetCurrentFunction(), this.builder.GetCurrentBlock());
        let (generic, _type, _unsafe) = (this.current_generic, this.current_type, this._unsafe);
        let (abi, linkage) = (this.abi, this.linkage);

        this.scope_manager.current = frame.scope;
        this.builder.SetCurrentFunction(frame.function);
        this.builder.SetCurrentBlock(frame.block);
        (this.current_generic, this.current_type, this._unsafe) = (frame.generic, frame._type, frame._unsafe);
        (this.abi, this.linkage) = (frame.abi, frame.linkage);

        (frame.scope, frame.function, frame.block) = (scope, function, block);
        (frame.generic, frame._type, frame._unsafe) = (generic, _type, _unsafe);
        (frame.abi, frame.linkage) = (abi, linkage);
        this.temporaries.Swap(frame.temporaries);
        this.temporary_stack.Swap(frame.temporary_stack);
        this.loop_scopes.Swap(frame.loop_scopes);
        this.loop_targets.Swap(frame.loop_targets);
        this.loop_temporaries.Swap(frame.loop_temporaries);
    }

    pub fn Lower(&mut this, module: *ASTModule) -> *HIRModule {
        this.module = this.context.arena.New<HIRModule>();
        this.builder = HIRBuilder(&mut this.context, this.module);
        let mut declared = Map<*ASTNode, bool>();

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::First;
            declared[declaration] = this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Second;
            declared[declaration] |= this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Third;
            declared[declaration] |= this.LowerDeclarationThirdPass(declaration);
        }

        for generic in this.generics {
            generic->LowerInstances();
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Fourth;
            declared[declaration] |= this.LowerDeclarationFourthPass(declaration);

            if !declared[declaration] {
                Logger::Log("Unknown declaration '" + declaration->kind.ToString() + "'.", declaration, LogSeverity::Error);
            }
        }

        for generic in this.generics {
            generic->LowerInstances();
        }

        this.class_data.Clear();
        this.structure_data.Clear();
        this.variant_data.Clear();
        this.extend_data.Clear();
        this.function_data.Clear();
        this.module
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *ASTDeclaration) -> bool {
        match declaration->kind {
            ASTDeclarationKind::Class => {
                let _class = declaration as *ASTClassDeclaration;
                let pair = this.LowerClassDeclarationFirstPass(_class, null);

                if !_class->generic && pair.left != null && pair.right != null {
                    this.class_data[declaration] = pair;
                }
            },
            ASTDeclarationKind::Structure => {
                let structure = declaration as *ASTStructureDeclaration;
                let pair = this.LowerStructureDeclarationFirstPass(structure, null);

                if !structure->generic && pair.left != null && pair.right != null {
                    this.structure_data[declaration] = pair;
                }
            },
            ASTDeclarationKind::Variant => {
                let variant = declaration as *ASTVariantDeclaration;
                let pair = this.LowerVariantDeclarationFirstPass(variant, null);

                if !variant->generic && pair.left != null && pair.right != null {
                    this.variant_data[declaration] = pair;
                }
            },
            ASTDeclarationKind::Assembly => {
                this.LowerAssemblyDeclaration(declaration as *ASTAssemblyDeclaration);
            },
            _ => {
                return false;
            }
        }

        true
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *ASTDeclaration) -> bool {
        match declaration->kind {
            ASTDeclarationKind::Constant => {
                this.LowerConstantDeclaration(declaration as *ASTConstantDeclaration);
            },
            ASTDeclarationKind::Class => {
                let _class = declaration as *ASTClassDeclaration;

                if !_class->generic {
                    let cache = this.class_data[declaration];
                    this.LowerClassDeclarationSecondPass(cache.left, _class, cache.right);
                }
            },
            ASTDeclarationKind::Structure => {
                let structure = declaration as *ASTStructureDeclaration;

                if !structure->generic {
                    let cache = this.structure_data[declaration];
                    this.LowerStructureDeclarationSecondPass(cache.left, structure, cache.right);
                }
            },
            ASTDeclarationKind::Enumeration => {
                this.LowerEnumerationDeclaration(declaration as *ASTEnumerationDeclaration);
            },
            ASTDeclarationKind::Variant => {
                let variant = declaration as *ASTVariantDeclaration;

                if !variant->generic {
                    let cache = this.variant_data[declaration];
                    this.LowerVariantDeclarationSecondPass(cache.left, variant, cache.right);
                }
            },
            ASTDeclarationKind::Type => {
                this.LowerTypeDeclaration(declaration as *ASTTypeDeclaration);
            },
            _ => {
                return false;
            }
        }

        true
    }

    fn LowerTypeDeclaration(&mut this, type_definition: *ASTTypeDeclaration) {
        this.scope_manager.current->Set(type_definition->name, this.LowerTypeOrVoid(type_definition->_type), type_definition);
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *ASTDeclaration) -> bool {
        match declaration->kind {
            ASTDeclarationKind::Static => {
                this.LowerStaticDeclaration(declaration as *ASTStaticDeclaration);
            },
            ASTDeclarationKind::Function => {
                let function = declaration as *ASTFunctionDeclaration;
                let data = this.LowerFunctionDeclarationFirstPass(function, null);

                if !function->generic && function->pack_name.Empty() && data != null {
                    this.module->declarations.PushBack(data);
                    this.function_data[declaration] = data;
                }
            },
            ASTDeclarationKind::Class => {
                let _class = declaration as *ASTClassDeclaration;

                if !_class->generic {
                    let cache = this.class_data[declaration];
                    this.LowerClassDeclarationThirdPass(cache.left, _class, cache.right);
                }
            },
            ASTDeclarationKind::Structure => {
                let structure = declaration as *ASTStructureDeclaration;

                if !structure->generic {
                    let cache = this.structure_data[declaration];
                    this.LowerStructureDeclarationThirdPass(cache.left, structure, cache.right);
                }
            },
            ASTDeclarationKind::Variant => {
                let variant = declaration as *ASTVariantDeclaration;

                if !variant->generic {
                    let cache = this.variant_data[declaration];
                    this.LowerVariantDeclarationThirdPass(cache.left, variant, cache.right);
                }
            },
            ASTDeclarationKind::Extend => {
                let pair = this.LowerExtendDeclarationFirstPass(declaration as *ASTExtendDeclaration);

                if pair.left != null && pair.right != null {
                    this.extend_data[declaration] = pair;
                }
            },
            ASTDeclarationKind::Extern => {
                this.LowerExternDeclarationFirstPass(declaration as *ASTExternDeclaration);
            },
            _ => {
                return false;
            }
        }

        true
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *ASTDeclaration) -> bool {
        match declaration->kind {
            ASTDeclarationKind::Function => {
                let function = declaration as *ASTFunctionDeclaration;

                if !function->generic && function->pack_name.Empty() {
                    this.LowerFunctionDeclarationSecondPass(this.function_data[declaration], function);
                }
            },
            ASTDeclarationKind::Class => {
                let _class = declaration as *ASTClassDeclaration;

                if !_class->generic {
                    let cache = this.class_data[declaration];
                    this.LowerClassDeclarationFourthPass(cache.left, _class, cache.right);
                }
            },
            ASTDeclarationKind::Structure => {
                let structure = declaration as *ASTStructureDeclaration;

                if !structure->generic {
                    let cache = this.structure_data[declaration];
                    this.LowerStructureDeclarationFourthPass(cache.left, structure, cache.right);
                }
            },
            ASTDeclarationKind::Variant => {
                let variant = declaration as *ASTVariantDeclaration;

                if !variant->generic {
                    let cache = this.variant_data[declaration];
                    this.LowerVariantDeclarationFourthPass(cache.left, variant, cache.right);
                }
            },
            ASTDeclarationKind::Extend => {
                let cache = this.extend_data[declaration];
                this.LowerExtendDeclarationSecondPass(cache.left, declaration as *ASTExtendDeclaration, cache.right);
            },
            ASTDeclarationKind::Extern => {
                this.LowerExternDeclarationSecondPass(declaration as *ASTExternDeclaration);
            },
            _ => {
                return false;
            }
        }

        true
    }

    fn Coerce(&mut this, _expression: *HIRExpression, target: *HIRType) -> *HIRExpression {
        let expression = unsafe { _expression as *mut HIRExpression };

        if expression == null {
            return expression;
        } else if expression->_type->IsNever() && target != null && !target->IsNever() && !target->IsUnit() {
            return this.builder.Cast(expression, target);
        }

        match expression->kind {
            HIRExpressionKind::Deferred => {
                return this.Coerce(this.LowerExpression((expression as *HIRDeferredExpression)->expression, target), target);
            },
            HIRExpressionKind::Block | HIRExpressionKind::If | HIRExpressionKind::Match | HIRExpressionKind::Loop if expression->_type->IsLiteral() => {
                return this.CoerceBranch(expression, target, false, null);
            },
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Array => {
                let array = expression as *mut HIRArrayLiteral;

                if array->elements.Empty() {
                    if target != null && target->IsArray() {
                        expression->_type = this.context.ArrayType(target->Element(), 0);
                    } return expression;
                }

                for i in 0..array->elements.Size() {
                    array->elements[i] = if target->IsArray() {
                        this.Coerce(array->elements[i], target->Element())
                    } else {
                        this.Coerce(array->elements[i])
                    };
                }

                expression->_type = this.context.ArrayType(array->elements[0]->_type, array->elements.Size());
                return expression;
            },
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Tuple => {
                let tuple = expression as *mut HIRTupleLiteral;
                let mut types = Vector<*HIRType>();

                for i in 0..tuple->elements.Size() {
                    tuple->elements[i] = if target->IsTuple() && (target as *HIRTupleType)->elements.Size() == tuple->elements.Size() {
                        this.Coerce(tuple->elements[i], (target as *HIRTupleType)->elements[i])
                    } else {
                        this.Coerce(tuple->elements[i])
                    };

                    types.PushBack(tuple->elements[i]->_type);
                }

                expression->_type = this.context.TupleType(types);
                return expression;
            },
            _ => {}
        }

        if expression->_type->IsInteger() && expression->_type->IsLiteral() && target->IsPointer() {
            if !(target->IsReference() && target->Pointee().IsInteger()) {
                expression->_type = this.context.IntegerPointerType(false);
            }
        }

        if expression->_type->IsLiteral() {
            if expression->_type->IsInteger() {
                if !target->IsInteger() || target->IsLiteral() {
                    expression->_type = this.context.IntegerType(32, true);
                } else {
                    expression->_type = target;
                }
            } else if !target->IsFloat() || target->IsLiteral() {
                expression->_type = this.context.FloatType(64);
            } else {
                expression->_type = target;
            }
        }

        expression
    }

    fn Coerce(&mut this, _expression: *HIRExpression) -> *HIRExpression {
        let expression = unsafe { _expression as *mut HIRExpression };

        if expression != null {
            match expression->kind {
                HIRExpressionKind::Deferred => {
                    return this.Coerce(this.LowerExpression((expression as *HIRDeferredExpression)->expression, null));
                },
                HIRExpressionKind::Literal if ((expression as *HIRLiteral)->kind == HIRLiteralKind::Array || (expression as *HIRLiteral)->kind == HIRLiteralKind::Tuple) => {
                    return this.Coerce(expression, this.context.UnitType());
                },
                HIRExpressionKind::Block | HIRExpressionKind::If | HIRExpressionKind::Match | HIRExpressionKind::Loop if expression->_type->IsLiteral() => {
                    return this.Coerce(expression, this.context.UnitType());
                },
                _ if expression->_type->IsLiteral() => {
                    if expression->_type->IsInteger() {
                        expression->_type = this.context.IntegerType(32, true);
                    } else {
                        expression->_type = this.context.FloatType(64);
                    }
                },
                _ => {}
            }
        }

        expression
    }

    fn IntegerLiteralValue(&mut this, expression: *HIRExpression, value: &mut u64) -> bool {
        if expression == null || expression->kind != HIRExpressionKind::Literal || (expression as *HIRLiteral)->kind != HIRLiteralKind::Integer {
            return false;
        }

        value = (expression as *HIRIntegerLiteral)->value;
        true
    }

    fn ContainsByValue(&mut this, _type: *HIRType, target: *HIRType, visited: &mut Vector<*HIRType>) -> bool {
        if _type == target { return true; }
        if visited.Contains(_type) { return false; }
        visited.PushBack(_type);

        if _type->IsArray() {
            this.ContainsByValue(_type->Element(), target, visited)
        } else if _type->IsTuple() {
            for element in (_type as *HIRTupleType)->elements {
                if this.ContainsByValue(element, target, visited) { return true; }
            }

            false
        } else if _type->IsClass() {
            for parent in (_type as *HIRClassType)->declaration->parents {
                if this.ContainsByValue(parent, target, visited) { return true; }
            }

            for field in (_type as *HIRClassType)->declaration->fields {
                if this.ContainsByValue(field->_type, target, visited) { return true; }
            }

            false
        } else if _type->IsStructure() {
            for field in (_type as *HIRStructureType)->declaration->fields {
                if this.ContainsByValue(field->_type, target, visited) { return true; }
            }

            false
        } else if _type->IsVariant() {
            for member in (_type as *HIRVariantType)->declaration->members {
                for field in member->fields {
                    if this.ContainsByValue(field->_type, target, visited) { return true; }
                }
            }

            false
        } else {
            false
        }
    }

    fn HasField(&mut this, fields: &Vector<*HIRFieldDeclaration>, name: &String) -> bool {
        for field in fields {
            if field->name == name { return true; }
        }

        false
    }

    fn HasField(&mut this, fields: &Vector<*HIRVariantField>, name: &String) -> bool {
        for field in fields {
            if field->name == name { return true; }
        }

        false
    }

    fn ValidateFieldType(&mut this, name: &String, _type: *HIRType, owner: *HIRType, node: *ASTNode) -> bool {
        if _type->IsNever() {
            Logger::Log("Field '" + name + "' cannot have type '" + _type->ToString() + "'.", node, LogSeverity::Error);
            return false;
        }

        let mut visited = Vector<*HIRType>();

        if this.ContainsByValue(_type, owner, visited) {
            Logger::Log("Recursive type '" + owner->ToString() + "' has infinite size; field '" + name + "' must be behind a pointer.", node, LogSeverity::Error);
            return false;
        }

        true
    }

    fn ImplicitDereference(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null && expression->_type->IsReference() {
            return this.builder.Dereference(expression);
        }

        expression
    }

    fn MakeCompatible(&mut this, expression: *HIRExpression, target: *HIRType) -> *HIRExpression {
        if target->IsPointer() && expression->_type->IsPointer() {
            if target->Pointee().IsClass() && expression->_type->Pointee().IsClass() {
                if expression->_type->Pointee().IsDerivedFrom(target->Pointee()) {
                    return this.builder.Cast(expression, target);
                }
            }
        }

        expression
    }

    fn Validate(&mut this, mut expression: *HIRExpression, target: *HIRType, message: *i8, node: *ASTNode) -> *HIRExpression {
        expression = this.Coerce(expression, target);
        if expression == null { return null; }

        if target->IsReference() && target->Pointee().IsCompatible(expression->_type) {
            expression = this.builder.AddressOf(expression);
        }

        if expression->_type->IsReference() && target->IsCompatible(expression->_type->Pointee()) {
            expression = this.builder.Dereference(expression);
        }

        if !target->IsCompatible(expression->_type) {
            Logger::Log(message.ToString() + " ('" + target->ToString() + "' != '" + expression->_type->ToString() + "').", node, LogSeverity::Error);
            return null;
        }

        if !target->IsMutabilityCompatible(expression->_type) {
            Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
            return null;
        }

        this.MakeCompatible(expression, target)
    }

    fn IsConstantExpression(&mut this, expression: *HIRExpression) -> bool {
        match expression->kind {
            HIRExpressionKind::Literal => {
                let literal = expression as *HIRLiteral;

                match literal->kind {
                    HIRLiteralKind::Array => {
                        for element in (literal as *HIRArrayLiteral)->elements {
                            if !this.IsConstantExpression(element) { return false; }
                        }

                        true
                    },
                    HIRLiteralKind::Tuple => {
                        for element in (literal as *HIRTupleLiteral)->elements {
                            if !this.IsConstantExpression(element) { return false; }
                        }

                        true
                    },
                    HIRLiteralKind::Structure => {
                        for field in (literal as *HIRStructureLiteral)->fields {
                            if !this.IsConstantExpression(field) { return false; }
                        }

                        true
                    },
                    _ => literal->kind != HIRLiteralKind::Variant
                }
            },
            HIRExpressionKind::Cast => this.IsConstantExpression((expression as *HIRCastExpression)->value),
            HIRExpressionKind::Unary => {
                let unary = expression as *HIRUnaryExpression;

                if unary->kind == HIRUnaryKind::AddressOf {
                    if unary->operand->kind != HIRExpressionKind::DeclarationReference { return false; }
                    let kind = (unary->operand as *HIRDeclarationReference)->declaration->kind;
                    return kind == HIRDeclarationKind::Static || kind == HIRDeclarationKind::Function;
                }

                unary->kind != HIRUnaryKind::Dereference && this.IsConstantExpression(unary->operand)
            },
            HIRExpressionKind::Binary => {
                let binary = expression as *HIRBinaryExpression;
                if binary->kind == HIRBinaryKind::LogicalAnd || binary->kind == HIRBinaryKind::LogicalOr { return false; }
                this.IsConstantExpression(binary->left) && this.IsConstantExpression(binary->right)
            },
            HIRExpressionKind::DeclarationReference => (expression as *HIRDeclarationReference)->declaration->kind == HIRDeclarationKind::Function,
            _ => expression->kind == HIRExpressionKind::Intrinsic
        }
    }

    fn LowerConstantDeclaration(&mut this, constant: *ASTConstantDeclaration) {
        let mut initializer: *HIRExpression = null;
        let _type = this.LowerType(constant->_type);
        if _type == null { return; }

        if constant->initializer != null {
            initializer = this.Validate(this.LowerExpression(constant->initializer), _type, "Incompatible constant initializer types", constant->initializer);
            if initializer == null { return; }

            if !this.IsConstantExpression(initializer) {
                Logger::Log("Constant initializer must be a constant expression.", constant->initializer, LogSeverity::Error);
                return;
            }
        }

        let declaration = this.builder.BuildConstantDeclaration(constant->name, _type, initializer);
        this.scope_manager.current->Set(constant->name, declaration, false, constant);
    }

    fn LowerStaticDeclaration(&mut this, _static: *ASTStaticDeclaration) {
        let mut initializer: *HIRExpression = null;
        let _type = this.LowerType(_static->_type);
        if _type == null { return; }

        if _static->initializer != null && !_static->zero_initializer {
            initializer = this.Validate(this.LowerExpression(_static->initializer), _type, "Incompatible static initializer types", _static->initializer);
            if initializer == null { return; }

            if !this.IsConstantExpression(initializer) {
                Logger::Log("Static initializer must be a constant expression.", _static->initializer, LogSeverity::Error);
                return;
            }
        }

        let mut alignment: *HIRExpression = null;

        if _static->alignment != null {
            alignment = this.Coerce(this.LowerExpression(_static->alignment), this.context.IntegerPointerType(false));
            if alignment == null { return; }

            if !alignment->_type->IsIntegerPointer() || alignment->_type->IsSigned() {
                Logger::Log("Static alignment must be of type 'usize'.", _static, LogSeverity::Error);
                return;
            }
        }

        let declaration = this.builder.BuildStaticDeclaration(_static->name, _type, initializer, alignment, _static->mutable, this.linkage);
        this.scope_manager.current->Set(_static->name, declaration, false, _static);
    }

    pub fn LowerFunctionDeclarationFirstPass(&mut this, function: *ASTFunctionDeclaration, instance: *mut GenericInstance) -> *mut HIRFunctionDeclaration {
        if (function->generic || !function->pack_name.Empty()) && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(function);
            this.scope_manager.current->Set(function->name, generic, function);
            this.generics.PushBack(generic);
            return null;
        }

        if (this.current_type == null || !this.current_type->IsClass()) && !function->constructors.Empty() {
            Logger::Log("Constructors can only be declared inside classes.", function, LogSeverity::Error);
            return null;
        }

        let mut parameter_types = Vector<*HIRType>();
        let mut parameters = Vector<*HIRParameterDeclaration>();

        if function->instance_kind != ASTInstanceKind::None {
            if this.current_type == null {
                Logger::Log("Recievers are only allowed in methods.", function, LogSeverity::Error);
                return null;
            }

            let mut _type = this.current_type;

            if function->instance_kind != ASTInstanceKind::Copy {
                _type = this.context.ReferenceType(this.current_type, function->instance_kind == ASTInstanceKind::MutRef);
            }

            parameters.PushBack(this.builder.BuildParameterDeclaration("this".ToString(), _type, false));
            parameter_types.PushBack(_type);
        }

        for parameter in function->parameters {
            let _type = this.LowerType(parameter->_type);
            if _type == null { return null; }

            if _type->IsNever() {
                Logger::Log("Parameter '" + parameter->name + "' cannot have type '" + _type->ToString() + "'.", parameter->_type, LogSeverity::Error);
            }

            parameters.PushBack(this.builder.BuildParameterDeclaration(parameter->name, _type, parameter->mutable));
            parameter_types.PushBack(_type);
        }

        if !function->pack_name.Empty() {
            let start = function->types.Size();

            for i in start..instance->types.Size() {
                let _type = instance->types[i];
                let name = function->pack_name + String::FromInteger((i - start) as u64);
                parameters.PushBack(this.builder.BuildParameterDeclaration(name, _type, false));
                parameter_types.PushBack(_type);
            }
        }

        let _return: *HIRType = if function->_return != null { this.LowerType(function->_return) } else { this.context.UnitType() };
        if _return == null { return null; }
        let declaration = this.builder.BuildFunctionDeclaration(function->name, parameters, _return, this.context.FunctionType(parameter_types, _return), function->no_mangle, function->public, this.abi);

        if function->track_caller {
            if this.abi != HIRDeclarationABI::Native {
                Logger::Log("Attribute 'track_caller' cannot be used on external functions.", function, LogSeverity::Error);
                return null;
            }

            declaration->caller_location = this.builder.BuildParameterDeclaration("caller.location".ToString(), this.CallerLocationType(), false);
        }

        if instance == null {
            this.scope_manager.current->Set(function->name, declaration, this.abi == HIRDeclarationABI::Native && !function->no_mangle, function);
        }

        declaration
    }

    pub fn LowerFunctionDeclarationSecondPass(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->HasSpecialMembers() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        if declaration->caller_location != null {
            this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(declaration->caller_location, false));
        }

        declaration->body = this.LowerBlockExpression(function->body, true, HIRBlockTail::Return, null);
        this.scope_manager.PopScope();

        if declaration->body != null && !declaration->body->_type->IsNever() {
            if declaration->_return->IsNever() {
                Logger::Log("Function '" + function->name + "' has return type '!' but may return.", function, LogSeverity::Error);
            } else if !declaration->_return->IsUnit() {
                Logger::Log("Function '" + function->name + "' does not return a value on all paths.", function, LogSeverity::Error);
            }
        }
    }

    pub fn LowerClassDeclarationFirstPass(&mut this, _class: *ASTClassDeclaration, instance: *mut GenericInstance) -> Pair<*mut HIRClassDeclaration, *mut Scope> {
        if _class->generic && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(_class);
            this.scope_manager.current->Set(_class->name, generic, _class);
            this.generics.PushBack(generic);
            return Pair<*mut HIRClassDeclaration, *mut Scope>(null, null);
        }

        let mut scope: *mut Scope = null;
        let _type = this.context.ClassType(null);
        let declaration = this.builder.BuildClassDeclaration(_class->name, _type);
        _type->declaration = declaration;

        if instance == null {
            this.scope_manager.current->Set(_class->name, _type, _class);
            this.scope_manager.PushScope(_class->name, true);
            scope = this.scope_manager.current;
            this.scope_manager.PopScope();
        }

        Pair<*mut HIRClassDeclaration, *mut Scope>(declaration, scope)
    }

    pub fn LowerClassDeclarationSecondPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for parent in _class->parents {
            let parent_type = this.LowerType(parent);
            if parent_type == null { continue; }
            declaration->parents.PushBack(parent_type);
        }

        for parent in declaration->parents {
            let mut visited = Vector<*HIRType>();

            if this.ContainsByValue(parent, declaration->_type, visited) {
                Logger::Log("Class '" + declaration->name + "' cannot inherit from itself.", _class, LogSeverity::Error);
                declaration->parents.Clear();
                break;
            }
        }

        for field in _class->fields {
            let field_type = this.LowerType(field->_type);
            if field_type == null { continue; }

            if this.HasField(declaration->fields, field->name) {
                Logger::Log("Field '" + field->name + "' is already declared in class '" + declaration->name + "'.", field, LogSeverity::Error);
                continue;
            }

            if !this.ValidateFieldType(field->name, field_type, declaration->_type, field) { continue; }
            let index = declaration->parents.Size() + declaration->fields.Size();
            declaration->fields.PushBack(this.builder.BuildFieldDeclaration(field->name, field_type, index, field->initializer, field->public));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerImplicitDeclaration(&mut this, name: String, _type: *HIRType, _return: *HIRType, other: bool, node: *ASTNode) -> *mut HIRFunctionDeclaration {
        let mut parameter_types = Vector<*HIRType>();
        let mut parameters = Vector<*HIRParameterDeclaration>();

        let this_type = this.context.ReferenceType(_type, true);
        parameters.PushBack(this.builder.BuildParameterDeclaration("this".ToString(), this_type, false));
        parameter_types.PushBack(this_type);

        if other {
            let other_type = this.context.ReferenceType(_type, false);
            parameters.PushBack(this.builder.BuildParameterDeclaration("other".ToString(), other_type, false));
            parameter_types.PushBack(other_type);
        }

        let function = this.builder.BuildFunctionDeclaration(name, parameters, _return, this.context.FunctionType(parameter_types, _return), false, true, HIRDeclarationABI::Native);
        this.scope_manager.current->Set(name, function, true, node);
        function
    }

    fn EnsureArraySpecialMembers(&mut this, _type: *mut HIRArrayType) {
        let previous_type = this.current_type;
        let previous_function = this.builder.GetCurrentFunction();
        let previous_block = this.builder.GetCurrentBlock();
        let name = (_type as *HIRType)->ToString();
        this.scope_manager.PushScope(name, true);
        this.current_type = _type;

        if _type->copy_constructor == null {
            let function = this.LowerImplicitDeclaration(name, _type, this.context.UnitType(), true, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for i in 0.._type->length as u64 {
                let index = this.builder.IntegerLiteral(i, this.context.IntegerPointerType(false));
                let this_element = this.builder.IndexAccess(this_dereferenced, index);
                let other_element = this.builder.IndexAccess(other_dereferenced, index);
                this.LowerFieldCopyConstructor(this_element, other_element, _type->element, null);
            }

            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->copy_constructor = function;
        }

        if _type->destructor == null {
            let function = this.LowerImplicitDeclaration('~' + name, _type, this.context.UnitType(), false, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            for i in 0.._type->length as u64 {
                let index = this.builder.IntegerLiteral(i, this.context.IntegerPointerType(false));
                let this_element = this.builder.IndexAccess(this_dereferenced, index);
                this.LowerFieldDestructor(this_element, _type->element, null);
            }

            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->destructor = function;
        }

        if _type->copy_assign == null {
            let function = this.LowerImplicitDeclaration("operator=".ToString(), _type, this.context.ReferenceType(_type, false), true, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for i in 0.._type->length as u64 {
                let index = this.builder.IntegerLiteral(i, this.context.IntegerPointerType(false));
                let this_element = this.builder.IndexAccess(this_dereferenced, index);
                let other_element = this.builder.IndexAccess(other_dereferenced, index);
                this.LowerFieldCopyAssignment(this_element, other_element, _type->element, null);
            }

            this.builder.BuildExpressionStatement(this.builder.Return(this_reference, Vector<*HIRExpression>()));
            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->copy_assign = function;
        }

        this.scope_manager.PopScope();
        this.builder.SetCurrentFunction(previous_function);
        this.builder.SetCurrentBlock(previous_block);
        this.current_type = previous_type;
    }

    fn EnsureTupleSpecialMembers(&mut this, _type: *mut HIRTupleType) {
        let previous_type = this.current_type;
        let previous_function = this.builder.GetCurrentFunction();
        let previous_block = this.builder.GetCurrentBlock();
        let name = (_type as *HIRType)->ToString();
        this.scope_manager.PushScope(name, true);
        this.current_type = _type;

        if _type->copy_constructor == null {
            let function = this.LowerImplicitDeclaration(name, _type, this.context.UnitType(), true, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for i in 0.._type->elements.Size() {
                let this_element = this.builder.TupleAccess(this_dereferenced, i);
                let other_element = this.builder.TupleAccess(other_dereferenced, i);
                this.LowerFieldCopyConstructor(this_element, other_element, _type->elements[i], null);
            }

            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->copy_constructor = function;
        }

        if _type->destructor == null {
            let function = this.LowerImplicitDeclaration('~' + name, _type, this.context.UnitType(), false, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            for i in 0.._type->elements.Size() {
                let this_element = this.builder.TupleAccess(this_dereferenced, i);
                this.LowerFieldDestructor(this_element, _type->elements[i], null);
            }

            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->destructor = function;
        }

        if _type->copy_assign == null {
            let function = this.LowerImplicitDeclaration("operator=".ToString(), _type, this.context.ReferenceType(_type, false), true, null);
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for i in 0.._type->elements.Size() {
                let this_element = this.builder.TupleAccess(this_dereferenced, i);
                let other_element = this.builder.TupleAccess(other_dereferenced, i);
                this.LowerFieldCopyAssignment(this_element, other_element, _type->elements[i], null);
            }

            this.builder.BuildExpressionStatement(this.builder.Return(this_reference, Vector<*HIRExpression>()));
            this.scope_manager.PopScope();
            this.module->declarations.PushBack(function);
            _type->copy_assign = function;
        }

        this.scope_manager.PopScope();
        this.builder.SetCurrentFunction(previous_function);
        this.builder.SetCurrentBlock(previous_block);
        this.current_type = previous_type;
    }

    fn IsCopyConstructor(&mut this, function: *HIRFunctionDeclaration, _type: *HIRType) -> bool {
        function->parameters.Size() == 2 && *function->parameters[1]->_type == *this.context.ReferenceType(_type, false)
    }

    fn GetCopyConstructor(&mut this, _type: *HIRType) -> *HIRFunctionDeclaration {
        if _type->IsArray() {
            this.EnsureArraySpecialMembers(_type as *mut HIRArrayType);
            (_type as *HIRArrayType)->copy_constructor
        } else if _type->IsTuple() {
            this.EnsureTupleSpecialMembers(_type as *mut HIRTupleType);
            (_type as *HIRTupleType)->copy_constructor
        } else if _type->IsClass() {
            for candidate in (_type as *HIRClassType)->declaration->constructors {
                if this.IsCopyConstructor(candidate, _type) { return candidate; }
            }

            null
        } else if _type->IsStructure() {
            (_type as *HIRStructureType)->declaration->copy_constructor
        } else if _type->IsVariant() {
            (_type as *HIRVariantType)->declaration->copy_constructor
        } else {
            null
        }
    }

    fn GetDestructor(&mut this, _type: *HIRType) -> *HIRFunctionDeclaration {
        if _type->IsArray() {
            this.EnsureArraySpecialMembers(_type as *mut HIRArrayType);
            (_type as *HIRArrayType)->destructor
        } else if _type->IsTuple() {
            this.EnsureTupleSpecialMembers(_type as *mut HIRTupleType);
            (_type as *HIRTupleType)->destructor
        } else if _type->IsClass() {
            (_type as *HIRClassType)->declaration->destructor
        } else if _type->IsStructure() {
            (_type as *HIRStructureType)->declaration->destructor
        } else if _type->IsVariant() {
            (_type as *HIRVariantType)->declaration->destructor
        } else {
            null
        }
    }

    fn IsCopyAssignment(&mut this, function: *HIRFunctionDeclaration, _type: *HIRType) -> bool {
        function->name == "operator=" && function->parameters.Size() == 2 && *function->parameters[1]->_type == *this.context.ReferenceType(_type, false)
    }

    fn GetCopyAssignment(&mut this, _type: *HIRType) -> *HIRFunctionDeclaration {
        if _type->IsArray() {
            this.EnsureArraySpecialMembers(_type as *mut HIRArrayType);
            (_type as *HIRArrayType)->copy_assign
        } else if _type->IsTuple() {
            this.EnsureTupleSpecialMembers(_type as *mut HIRTupleType);
            (_type as *HIRTupleType)->copy_assign
        } else if _type->IsClass() {
            for method in (_type as *HIRClassType)->declaration->methods {
                if this.IsCopyAssignment(method, _type) { return method; }
            }

            null
        } else if _type->IsStructure() {
            (_type as *HIRStructureType)->declaration->copy_assign
        } else if _type->IsVariant() {
            (_type as *HIRVariantType)->declaration->copy_assign
        } else {
            null
        }
    }

    fn LowerCopyOrMoveValue(&mut this, value: *HIRExpression) -> *HIRExpression {
        if !value->_type->HasSpecialMembers() {
            return value;
        }

        if value->category == HIRExpressionCategory::Place {
            let function = this.GetCopyConstructor(value->_type);
            if function == null { return null; }
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.builder.AddressOf(value));
            let callee = this.builder.ReferenceDeclaration(function, false);
            return this.builder.Constructor(callee, values, value->_type);
        }

        this.temporaries.Remove(value);
        value
    }

    pub fn LowerClassDeclarationThirdPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (mut has_copy_constructor, mut has_copy_assign) = (false, false);
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for constructor in _class->constructors {
            let function = this.LowerFunctionDeclarationFirstPass(constructor, null);

            if function != null {
                declaration->constructors.PushBack(function);

                if this.IsCopyConstructor(function, declaration->_type) {
                    has_copy_constructor = true;
                }
            }
        }

        if _class->constructors.Empty() {
            declaration->constructors.PushBack(this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.UnitType(), false, _class));
        }

        if !has_copy_constructor {
            declaration->constructors.PushBack(this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.UnitType(), true, _class));
        }

        if _class->destructor != null {
            let function = this.LowerFunctionDeclarationFirstPass(_class->destructor, null);

            if function != null {
                declaration->destructor = function;
            }
        } else {
            declaration->destructor = this.LowerImplicitDeclaration('~' + declaration->name, declaration->_type, this.context.UnitType(), false, _class);
        }

        for method in _class->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);

                if this.IsCopyAssignment(function, declaration->_type) {
                    has_copy_assign = true;
                }
            }
        }

        if !has_copy_assign {
            declaration->methods.PushBack(this.LowerImplicitDeclaration("operator=".ToString(), declaration->_type, this.context.ReferenceType(declaration->_type, false), true, _class));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerFieldConstructors(&mut this, this_dereferenced: *HIRExpression, fields: &Vector<*HIRFieldDeclaration>) {
        for field in fields {
            let this_field = this.builder.FieldAccess(this_dereferenced, field);

            if field->initializer != null {
                let initializer = this.Validate(this.LowerExpression(field->initializer), field->_type, "Incompatible field initializer types", field->initializer);

                if initializer != null {
                    this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, initializer));
                }
            } else if field->_type->IsClass() {
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (field->_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let mut values = Vector<*HIRExpression>();
                values.PushBack(this_field);
                let function = this.ResolveOverload(candidates, values, null, true);

                if function == null {
                    Logger::Log("Field '" + field->name + "' of type '" + field->_type->ToString() + "' has no default constructor, it must be initialized explicitly.", LogSeverity::Error);
                    continue;
                }

                let call = this.LowerResolvedCallExpression(function, values, null);
                if call == null { continue; }
                this.builder.BuildExpressionStatement(call);
            }
        }
    }

    fn LowerFieldCopyConstructor(&mut this, this_field: *HIRExpression, other_field: *HIRExpression, _type: *HIRType, node: *ASTNode) {
        if _type->HasSpecialMembers() {
            let function = this.GetCopyConstructor(_type);
            if function == null { return; }
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.builder.AddressOf(this_field));
            values.PushBack(this.builder.AddressOf(other_field));
            let call = this.LowerResolvedCallExpression(function, values, node);
            if call == null { return; }
            this.builder.BuildExpressionStatement(call);
        } else {
            this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, other_field));
        }
    }

    fn LowerFieldDestructor(&mut this, this_field: *HIRExpression, _type: *HIRType, node: *ASTNode) {
        if !_type->HasSpecialMembers() { return; }
        let function = this.GetDestructor(_type);
        if function == null { return; }
        let mut values = Vector<*HIRExpression>();
        values.PushBack(this.builder.AddressOf(this_field));
        let call = this.LowerResolvedCallExpression(function, values, node);
        if call == null { return; }
        this.builder.BuildExpressionStatement(call);
    }

    fn LowerFieldCopyAssignment(&mut this, this_field: *HIRExpression, other_field: *HIRExpression, _type: *HIRType, node: *ASTNode) {
        if _type->HasSpecialMembers() {
            let function = this.GetCopyAssignment(_type);
            if function == null { return; }
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.builder.AddressOf(this_field));
            values.PushBack(this.builder.AddressOf(other_field));
            let call = this.LowerResolvedCallExpression(function, values, node);
            if call == null { return; }
            this.builder.BuildExpressionStatement(call);
        } else {
            this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, other_field));
        }
    }

    fn LowerConstructorDeclaration(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration, parents: &Vector<*HIRType>, fields: &Vector<*HIRFieldDeclaration>) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->HasSpecialMembers() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        let block = this.builder.Block();
        this.builder.SetCurrentBlock(block);
        declaration->body = block;

        let this_parameter = declaration->parameters[0];
        let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
        let this_dereferenced = this.builder.Dereference(this_reference);

        for constructor in function->constructors {
            let _type = this.LowerType((constructor->expression as *ASTPathExpression)->path);
            if _type == null { continue; }

            if !_type->IsClass() {
                Logger::Log("Constructor target must be a class.", constructor, LogSeverity::Error);
                continue;
            }

            for parent in parents {
                if *parent != *_type { continue; }
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.builder.Cast(this_reference, this.context.ReferenceType(parent, true)));

                let mut invalid = false;
                values += this.LowerCallArguments(constructor->arguments, constructor, &mut invalid);
                if invalid { break; }

                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, null, false);
                if function == null { break; }
                let call = this.LowerResolvedCallExpression(function, values, null);
                if call == null { break; }
                this.builder.BuildExpressionStatement(call);
                break;
            }
        }

        this.LowerFieldConstructors(this_dereferenced, fields);

        for statement in function->body->statements {
            this.LowerStatement(statement);
        }

        if function->body->tail != null {
            this.LowerBlockTail(function->body->tail, HIRBlockTail::Discard, block, null);
        }

        this.BuildDestructors(this.scope_manager.current, null);
        this.scope_manager.PopScope();
    }

    fn LowerDestructorDeclaration(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration, fields: &Vector<*HIRFieldDeclaration>) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        let this_parameter = declaration->parameters[0];
        let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
        let this_dereferenced = this.builder.Dereference(this_reference);

        for field in fields {
            let this_field = this.builder.FieldAccess(this_dereferenced, field);

            if field->_type->HasSpecialMembers() {
                this.scope_manager.current->instances.PushBack(this_field);
            }
        }

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->HasSpecialMembers() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        let block = this.builder.Block();
        this.builder.SetCurrentBlock(block);
        declaration->body = block;

        for statement in function->body->statements {
            this.LowerStatement(statement);
        }

        if function->body->tail != null {
            this.LowerBlockTail(function->body->tail, HIRBlockTail::Discard, block, null);
        }

        this.BuildDestructors(this.scope_manager.current, null);
        this.scope_manager.PopScope();
    }

    pub fn LowerClassDeclarationFourthPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (mut has_copy_constructor, mut has_copy_assign) = (false, false);
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let parents = (declaration->_type as *HIRClassType)->declaration->parents;
        let fields = (declaration->_type as *HIRClassType)->declaration->fields;
        let mut index: usize = 0;

        for constructor in _class->constructors {
            if constructor->generic || !constructor->pack_name.Empty() { continue; }
            let function = declaration->constructors[index];
            this.LowerConstructorDeclaration(function, constructor, parents, fields);
            index += 1;

            if this.IsCopyConstructor(function, declaration->_type) {
                has_copy_constructor = true;
            }
        }

        if _class->constructors.Empty() {
            let index = declaration->constructors.Size() - (if has_copy_constructor { 1 } else { 2 });
            let function = declaration->constructors[index];
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);
            this.LowerFieldConstructors(this_dereferenced, fields);
            this.scope_manager.PopScope();
        }

        if !has_copy_constructor {
            let function: *mut HIRFunctionDeclaration = declaration->constructors.Back();
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in fields {
                this.LowerFieldCopyConstructor(this.builder.FieldAccess(this_dereferenced, field), this.builder.FieldAccess(other_dereferenced, field), field->_type, _class);
            }

            this.scope_manager.PopScope();
        }

        if _class->destructor != null {
            this.LowerDestructorDeclaration(declaration->destructor, _class->destructor, fields);
        } else {
            let function = declaration->destructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            for field in fields {
                this.LowerFieldDestructor(this.builder.FieldAccess(this_dereferenced, field), field->_type, _class);
            }

            this.scope_manager.PopScope();
        }

        index = 0;

        for method in _class->methods {
            if method->generic || !method->pack_name.Empty() { continue; }
            if index >= declaration->methods.Size() { break; }
            let function = declaration->methods[index];
            this.LowerFunctionDeclarationSecondPass(function, method);
            index += 1;

            if this.IsCopyAssignment(function, declaration->_type) {
                has_copy_assign = true;
            }
        }

        if !has_copy_assign {
            let function: *mut HIRFunctionDeclaration = declaration->methods.Back();
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in fields {
                this.LowerFieldCopyAssignment(this.builder.FieldAccess(this_dereferenced, field), this.builder.FieldAccess(other_dereferenced, field), field->_type, _class);
            }

            this.builder.BuildExpressionStatement(this.builder.Return(this_reference, Vector<*HIRExpression>()));
            this.scope_manager.PopScope();
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationFirstPass(&mut this, structure: *ASTStructureDeclaration, instance: *mut GenericInstance) -> Pair<*mut HIRStructureDeclaration, *mut Scope> {
        if structure->generic && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(structure);
            this.scope_manager.current->Set(structure->name, generic, structure);
            this.generics.PushBack(generic);
            return Pair<*mut HIRStructureDeclaration, *mut Scope>(null, null);
        }

        let mut scope: *mut Scope = null;
        let _type = this.context.StructureType(null);
        let declaration = this.builder.BuildStructureDeclaration(structure->name, _type);
        _type->declaration = declaration;

        if instance == null {
            this.scope_manager.current->Set(structure->name, _type, structure);
            this.scope_manager.PushScope(structure->name, true);
            scope = this.scope_manager.current;
            this.scope_manager.PopScope();
        }

        Pair<*mut HIRStructureDeclaration, *mut Scope>(declaration, scope)
    }

    pub fn LowerStructureDeclarationSecondPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for field in structure->fields {
            let field_type = this.LowerType(field->_type);
            if field_type == null { continue; }

            if this.HasField(declaration->fields, field->name) {
                Logger::Log("Field '" + field->name + "' is already declared in structure '" + declaration->name + "'.", field, LogSeverity::Error);
                continue;
            }

            if !this.ValidateFieldType(field->name, field_type, declaration->_type, field) { continue; }
            declaration->fields.PushBack(this.builder.BuildFieldDeclaration(field->name, field_type, declaration->fields.Size(), field->initializer, field->public));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationThirdPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for method in structure->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);
            }
        }

        declaration->copy_constructor = this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.UnitType(), true, structure);
        declaration->destructor = this.LowerImplicitDeclaration('~' + declaration->name, declaration->_type, this.context.UnitType(), false, structure);
        declaration->copy_assign = this.LowerImplicitDeclaration("operator=".ToString(), declaration->_type, this.context.ReferenceType(declaration->_type, false), true, structure);
        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationFourthPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let mut index: usize = 0;

        for method in structure->methods {
            if method->generic || !method->pack_name.Empty() { continue; }
            if index >= declaration->methods.Size() { break; }
            this.LowerFunctionDeclarationSecondPass(declaration->methods[index], method);
            index += 1;
        }

        if declaration->copy_constructor != null {
            let function = declaration->copy_constructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in declaration->fields {
                this.LowerFieldCopyConstructor(this.builder.FieldAccess(this_dereferenced, field), this.builder.FieldAccess(other_dereferenced, field), field->_type, structure);
            }

            this.scope_manager.PopScope();
        }

        if declaration->destructor != null {
            let function = declaration->destructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            for field in declaration->fields {
                this.LowerFieldDestructor(this.builder.FieldAccess(this_dereferenced, field), field->_type, structure);
            }

            this.scope_manager.PopScope();
        }

        if declaration->copy_assign != null {
            let function = declaration->copy_assign;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in declaration->fields {
                this.LowerFieldCopyAssignment(this.builder.FieldAccess(this_dereferenced, field), this.builder.FieldAccess(other_dereferenced, field), field->_type, structure);
            }

            this.builder.BuildExpressionStatement(this.builder.Return(this_reference, Vector<*HIRExpression>()));
            this.scope_manager.PopScope();
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerEnumerationDeclaration(&mut this, enumeration: *ASTEnumerationDeclaration) {
        let underlying_type = this.LowerType(enumeration->underlying_type);
        if underlying_type == null { return; }

        if !underlying_type->IsInteger() {
            Logger::Log("Expected an integer type.", enumeration, LogSeverity::Error);
            return;
        }

        let _type = this.context.EnumerationType(null, underlying_type as *HIRIntegerType);
        let declaration = this.builder.BuildEnumerationDeclaration(enumeration->name, _type);
        _type->declaration = declaration;

        let mut value: *HIRExpression = this.builder.IntegerLiteral(0, _type);
        this.scope_manager.current->Set(enumeration->name, _type, enumeration);
        this.scope_manager.PushScope(enumeration->name, true);

        for member in enumeration->members {
            if member->value != null {
                value = this.Coerce(this.LowerExpression(member->value), underlying_type);
                if value == null { continue; }

                if underlying_type->IsSame(value->_type) {
                    value = this.builder.Cast(value, _type);
                }

                if !_type->IsCompatible(value->_type) {
                    Logger::Log("Expected an expression of type '" + underlying_type->ToString() + "'.", member->value, LogSeverity::Error);
                    continue;
                }
            }

            let member_declaration = this.builder.BuildEnumerationMember(member->name, value, _type);
            value = this.builder.Binary(HIRBinaryKind::Add, value, this.builder.IntegerLiteral(1, _type), _type);
            this.scope_manager.current->Set(member->name, member_declaration, false, enumeration);
            declaration->members.PushBack(member_declaration);
        }

        this.scope_manager.PopScope();
    }

    pub fn LowerVariantDeclarationFirstPass(&mut this, variant: *ASTVariantDeclaration, instance: *mut GenericInstance) -> Pair<*mut HIRVariantDeclaration, *mut Scope> {
        if variant->generic && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(variant);
            this.scope_manager.current->Set(variant->name, generic, variant);
            this.generics.PushBack(generic);
            return Pair<*mut HIRVariantDeclaration, *mut Scope>(null, null);
        }

        let mut scope: *mut Scope = null;
        let _type = this.context.VariantType(null);
        let declaration = this.builder.BuildVariantDeclaration(variant->name, _type);
        _type->declaration = declaration;

        if instance == null {
            this.scope_manager.current->Set(variant->name, _type, variant);
            this.scope_manager.PushScope(variant->name, true);
            scope = this.scope_manager.current;
            this.scope_manager.PopScope();
        }

        Pair<*mut HIRVariantDeclaration, *mut Scope>(declaration, scope)
    }

    pub fn LowerVariantDeclarationSecondPass(&mut this, declaration: *mut HIRVariantDeclaration, variant: *ASTVariantDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let mut index: usize = 0;

        for member in variant->members {
            let lowered_member = this.builder.BuildVariantMember(member->name, declaration->_type, index);
            index += 1;

            for field in member->fields {
                let field_type = this.LowerType(field->_type);
                if field_type == null { continue; }

                if member->structure && this.HasField(lowered_member->fields, field->name) {
                    Logger::Log("Field '" + field->name + "' is already declared in variant member '" + member->name + "'.", variant, LogSeverity::Error);
                    continue;
                }

                let mut name = field->name;
                if !member->structure { name = member->name + "." + String::FromInteger(lowered_member->fields.Size() as u64); }
                if !this.ValidateFieldType(name, field_type, declaration->_type, variant) { continue; }
                lowered_member->fields.PushBack(this.builder.BuildVariantField(field->name, field_type, lowered_member->fields.Size()));
            }

            lowered_member->structure = member->structure;
            this.scope_manager.current->Set(member->name, lowered_member, false, variant);
            declaration->members.PushBack(lowered_member);
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerVariantDeclarationThirdPass(&mut this, declaration: *mut HIRVariantDeclaration, variant: *ASTVariantDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for method in variant->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);
            }
        }

        declaration->copy_constructor = this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.UnitType(), true, variant);
        declaration->destructor = this.LowerImplicitDeclaration('~' + declaration->name, declaration->_type, this.context.UnitType(), false, variant);
        declaration->copy_assign = this.LowerImplicitDeclaration("operator=".ToString(), declaration->_type, this.context.ReferenceType(declaration->_type, false), true, variant);
        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerVariantDeclarationFourthPass(&mut this, declaration: *mut HIRVariantDeclaration, variant: *ASTVariantDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let mut index: usize = 0;

        for method in variant->methods {
            if method->generic || !method->pack_name.Empty() { continue; }
            if index >= declaration->methods.Size() { break; }
            this.LowerFunctionDeclarationSecondPass(declaration->methods[index], method);
            index += 1;
        }

        if declaration->copy_constructor != null {
            let function = declaration->copy_constructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            this.builder.BuildExpressionStatement(this.builder.Assignment(this.builder.TagAccess(this_dereferenced), this.builder.TagAccess(other_dereferenced)));

            for member in declaration->members {
                let this_tag = this.builder.TagAccess(this_dereferenced);
                let member_tag = this.builder.IntegerLiteral(member->index as u64, this.context.IntegerType(8, false));
                let condition = this.builder.BuildCondition(this.builder.Binary(HIRBinaryKind::Equal, this_tag, member_tag, this.context.BooleanType()));
                let previous_block = this.builder.GetCurrentBlock();
                let then_block = this.builder.Block();
                this.builder.SetCurrentBlock(then_block);

                for field in member->fields {
                    this.LowerFieldCopyConstructor(this.builder.MemberAccess(this_dereferenced, member, field), this.builder.MemberAccess(other_dereferenced, member, field), field->_type, variant);
                }

                this.builder.BuildExpressionStatement(this.builder.Return(null, Vector<*HIRExpression>()));
                this.builder.SetCurrentBlock(previous_block);
                this.builder.BuildExpressionStatement(this.builder.If(condition, Vector<*HIRExpression>(), then_block, null, this.context.UnitType()));
            }

            this.scope_manager.PopScope();
        }

        if declaration->destructor != null {
            let function = declaration->destructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            for member in declaration->members {
                let this_tag = this.builder.TagAccess(this_dereferenced);
                let member_tag = this.builder.IntegerLiteral(member->index as u64, this.context.IntegerType(8, false));
                let condition = this.builder.BuildCondition(this.builder.Binary(HIRBinaryKind::Equal, this_tag, member_tag, this.context.BooleanType()));
                let previous_block = this.builder.GetCurrentBlock();
                let then_block = this.builder.Block();
                this.builder.SetCurrentBlock(then_block);

                for field in member->fields {
                    this.LowerFieldDestructor(this.builder.MemberAccess(this_dereferenced, member, field), field->_type, variant);
                }

                this.builder.BuildExpressionStatement(this.builder.Return(null, Vector<*HIRExpression>()));
                this.builder.SetCurrentBlock(previous_block);
                this.builder.BuildExpressionStatement(this.builder.If(condition, Vector<*HIRExpression>(), then_block, null, this.context.UnitType()));
            }

            this.scope_manager.PopScope();
        }

        if declaration->copy_assign != null {
            let function = declaration->copy_assign;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.Block();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for other_member in declaration->members {
                let this_tag = this.builder.TagAccess(this_dereferenced);
                let other_tag = this.builder.TagAccess(other_dereferenced);
                let member_tag = this.builder.IntegerLiteral(other_member->index as u64, this.context.IntegerType(8, false));
                let condition = this.builder.BuildCondition(this.builder.Binary(HIRBinaryKind::Equal, other_tag, member_tag, this.context.BooleanType()));
                let previous_block = this.builder.GetCurrentBlock();
                let then_block = this.builder.Block();
                this.builder.SetCurrentBlock(then_block);

                let same_condition = this.builder.BuildCondition(this.builder.Binary(HIRBinaryKind::Equal, this_tag, member_tag, this.context.BooleanType()));
                let same_block = this.builder.Block();
                this.builder.SetCurrentBlock(same_block);

                for field in other_member->fields {
                    this.LowerFieldCopyAssignment(this.builder.MemberAccess(this_dereferenced, other_member, field), this.builder.MemberAccess(other_dereferenced, other_member, field), field->_type, variant);
                }

                let different_block = this.builder.Block();
                this.builder.SetCurrentBlock(different_block);

                for this_member in declaration->members {
                    if this_member->index == other_member->index { continue; }
                    let member_tag = this.builder.IntegerLiteral(this_member->index as u64, this.context.IntegerType(8, false));
                    let condition = this.builder.BuildCondition(this.builder.Binary(HIRBinaryKind::Equal, this_tag, member_tag, this.context.BooleanType()));
                    let previous_block = this.builder.GetCurrentBlock();
                    let then_block = this.builder.Block();
                    this.builder.SetCurrentBlock(then_block);

                    for field in this_member->fields {
                        this.LowerFieldDestructor(this.builder.MemberAccess(this_dereferenced, this_member, field), field->_type, variant);
                    }

                    this.builder.SetCurrentBlock(previous_block);
                    this.builder.BuildExpressionStatement(this.builder.If(condition, Vector<*HIRExpression>(), then_block, null, this.context.UnitType()));
                }

                for field in other_member->fields {
                    this.LowerFieldCopyConstructor(this.builder.MemberAccess(this_dereferenced, other_member, field), this.builder.MemberAccess(other_dereferenced, other_member, field), field->_type, variant);
                }

                this.builder.BuildExpressionStatement(this.builder.Assignment(this_tag, member_tag));
                this.builder.SetCurrentBlock(then_block);
                this.builder.BuildExpressionStatement(this.builder.If(same_condition, Vector<*HIRExpression>(), same_block, different_block, this.context.UnitType()));
                this.builder.SetCurrentBlock(previous_block);
                this.builder.BuildExpressionStatement(this.builder.If(condition, Vector<*HIRExpression>(), then_block, null, this.context.UnitType()));
            }

            this.builder.BuildExpressionStatement(this.builder.Return(this_reference, Vector<*HIRExpression>()));
            this.scope_manager.PopScope();
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerExtendDeclarationFirstPass(&mut this, _extend: *ASTExtendDeclaration) -> Pair<*mut HIRExtendDeclaration, *mut Scope> {
        let _type = this.LowerType(_extend->_type);
        let declaration = this.builder.BuildExtendDeclaration(_type);
        this.extension_registry.Register(declaration);
        this.scope_manager.PushScope(_type->ToString(), true);
        let scope = this.scope_manager.current;
        let previous_type = this.current_type;
        this.current_type = _type;

        for method in _extend->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);
            }
        }

        this.current_type = previous_type;
        this.scope_manager.PopScope();
        Pair<*mut HIRExtendDeclaration, *mut Scope>(declaration, scope)
    }

    fn LowerExtendDeclarationSecondPass(&mut this, declaration: *mut HIRExtendDeclaration, _extend: *ASTExtendDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for i in 0.._extend->methods.Size() {
            if i >= declaration->methods.Size() { break; }
            this.LowerFunctionDeclarationSecondPass(declaration->methods[i], _extend->methods[i]);
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerExternDeclarationFirstPass(&mut this, _extern: *ASTExternDeclaration) {
        if this.abi != HIRDeclarationABI::Native {
            Logger::Log("Already in an extern block.", _extern, LogSeverity::Error);
            return;
        }

        if _extern->linkage != "C" {
            Logger::Log("Unknown linkage '" + _extern->linkage + "'.", _extern, LogSeverity::Error);
            return;
        }

        let (previous_abi, previous_linkage) = (this.abi, this.linkage);
        (this.abi, this.linkage) = (HIRDeclarationABI::C, HIRDeclarationLinkage::External);

        for declaration in _extern->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        (this.abi, this.linkage) = (previous_abi, previous_linkage);
    }

    fn LowerExternDeclarationSecondPass(&mut this, _extern: *ASTExternDeclaration) {
        let (previous_abi, previous_linkage) = (this.abi, this.linkage);
        (this.abi, this.linkage) = (HIRDeclarationABI::C, HIRDeclarationLinkage::External);

        for declaration in _extern->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }

        (this.abi, this.linkage) = (previous_abi, previous_linkage);
    }

    fn LowerAssemblyDeclaration(&mut this, assembly: *ASTAssemblyDeclaration) {
        this.builder.BuildAssemblyDeclaration(assembly->text);
    }

    fn LowerStatement(&mut this, statement: *ASTStatement) {
        match statement->kind {
            ASTStatementKind::Variable => {
                this.LowerLetStatement(statement as *ASTLetStatement);
            },
            ASTStatementKind::Expression => {
                let expression = (statement as *ASTExpressionStatement)->expression;

                if expression->kind == ASTExpressionKind::Assignment {
                    let mut assignment = expression as *ASTAssignmentExpression;

                    while assignment != null {
                        let expression = this.LowerAssignmentExpression(assignment);

                        if expression != null {
                            this.builder.BuildExpressionStatement(expression);
                        } else {
                            this.MarkErroneous();
                        }

                        this.BuildTemporaryDestructors(null);
                        assignment = assignment->next;
                    }
                } else {
                    let expression = this.LowerExpression(expression);

                    if expression != null {
                        this.builder.BuildExpressionStatement(expression);
                    } else {
                        this.MarkErroneous();
                    } this.BuildTemporaryDestructors(null);
                }
            },
            ASTStatementKind::Assembly => {
                this.LowerAssemblyStatement(statement as *ASTAssemblyStatement);
            }
        }
    }

    fn LowerLetStatement(&mut this, _let: *ASTLetStatement) {
        let mut _type: *HIRType = null;

        if _let->_type != null {
            _type = this.LowerType(_let->_type);
            if _type == null { return; }
        }

        let mut initializer: *HIRExpression = null;

        if _let->initializer != null {
            initializer = this.LowerExpectedExpression(_let->initializer, _type);
            if initializer == null { return; }

            if _type != null {
                let original_type = initializer->_type;
                initializer = this.Coerce(initializer, _type);
                if initializer == null { return; }

                if _type->IsSame(initializer->_type) && !this.LiteralNeedsExplicitType(original_type, _type) && !initializer->IsBlockLike() {
                    Logger::Log("Unnecessary type annotation, type can be inferred from initializer.", _let->_type, LogSeverity::Warning);
                }
            }
        } else if _type == null {
            Logger::Log("A type annotation is required for a 'let' statement without an initializer.", _let, LogSeverity::Error);
            return;
        }

        let pattern = this.LowerPattern(_let->pattern, _type, initializer, HIRBindingMode::Value);
        if pattern == null { return; }

        if !pattern->IsIrrefutable() {
            Logger::Log("A refutable pattern cannot be used in a 'let' statement.", _let->pattern, LogSeverity::Error);
            return;
        }

        let statement = this.builder.BuildLetStatement(pattern, _type, initializer);
        this.builder.GetCurrentBlock()->statements.PushBack(statement);

        if initializer != null {
            this.BuildTemporaryDestructors(null);
        }
    }

    fn LowerAssemblyStatement(&mut this, assembly: *ASTAssemblyStatement) {
        let mut inputs = Vector<*HIRAssemblyOperand>();

        for input in assembly->inputs {
            let expression = this.Coerce(this.LowerExpression(input->expression));
            if expression == null { continue; }
            inputs.PushBack(this.builder.BuildAssemblyOperand(input->name, expression));
        }

        let mut outputs = Vector<*HIRAssemblyOperand>();

        for output in assembly->outputs {
            if !outputs.Empty() {
                Logger::Log("Multiple outputs are not supported.", assembly, LogSeverity::Error);
            }

            let expression = this.Coerce(this.LowerExpression(output->expression));
            if expression == null { continue; }
            outputs.PushBack(this.builder.BuildAssemblyOperand(output->name, expression));
        }

        this.builder.BuildAssemblyStatement(assembly->_volatile, assembly->text, inputs, outputs, assembly->clobbers);
    }

    fn MarkErroneous(&mut this) {
        this.builder.GetCurrentBlock()->_type = this.context.NeverType();
    }

    fn RegisterTemporary(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null && expression->_type->HasSpecialMembers() {
            this.temporaries.PushBack(expression);
        }

        expression
    }

    fn CommonType(&mut this, left: *HIRType, right: *HIRType) -> *HIRType {
        if left->IsSame(right) || right->IsNever() {
            left
        } else if left->IsNever() {
            right
        } else if left->IsNullPointer() && (right->IsPointer() || right->IsFunction()) {
            right
        } else if right->IsNullPointer() && (left->IsPointer() || left->IsFunction()) {
            left
        } else if left->IsPointer() && right->IsPointer() && left->IsReference() == right->IsReference() {
            let pointee = this.CommonType(left->Pointee(), right->Pointee());
            if pointee == null { return null; }
            let mutable = left->IsMutable() && right->IsMutable();

            if left->IsReference() {
                this.context.ReferenceType(pointee, mutable)
            } else {
                this.context.PointerType(pointee, mutable)
            }
        } else if left->IsArray() && right->IsArray() && left->Length() == right->Length() {
            let element = this.CommonType(left->Element(), right->Element());
            if element == null { return null; }
            this.context.ArrayType(element, left->Length())
        } else if left->IsTuple() && right->IsTuple() {
            let &lefts = (left as *HIRTupleType)->elements;
            let &rights = (right as *HIRTupleType)->elements;
            if lefts.Size() != rights.Size() { return null; }
            let mut elements = Vector<*HIRType>();

            for i in 0..lefts.Size() {
                let element = this.CommonType(lefts[i], rights[i]);
                if element == null { return null; }
                elements.PushBack(element);
            }

            this.context.TupleType(elements)
        } else {
            null
        }
    }

    fn Branches(&mut this, expression: *HIRExpression) -> Vector<*HIRExpression> {
        let mut branches = Vector<*HIRExpression>();

        match expression->kind {
            HIRExpressionKind::Block => {
                let block = expression as *HIRBlockExpression;
                if block->tail != null { branches.PushBack(block->tail); }
            },
            HIRExpressionKind::If => {
                let _if = expression as *HIRIfExpression;
                branches.PushBack(_if->then_body);
                if _if->else_body != null { branches.PushBack(_if->else_body); }
            },
            HIRExpressionKind::Match => {
                for arm in (expression as *HIRMatchExpression)->arms {
                    branches.PushBack(arm->body);
                }
            },
            HIRExpressionKind::Loop => {
                for _break in (expression as *HIRLoopExpression)->breaks {
                    if _break->value != null { branches.PushBack(_break->value); }
                }
            },
            _ => {}
        }

        branches
    }

    fn UnifyBranches(&mut this, expression: *HIRExpression, node: *ASTNode) -> *HIRType {
        let mut concrete: *HIRType = null;

        for branch in this.Branches(expression) {
            if !branch->_type->IsNever() && !branch->_type->IsLiteral() {
                concrete = branch->_type;
                break;
            }
        }

        if concrete != null {
            if concrete->IsInteger() || concrete->IsFloat() {
                if this.CoerceBranch(expression, concrete, false, node) == null { return null; }
            } else {
                if this.CoerceBranch(expression, this.context.UnitType(), false, node) == null { return null; }
            }
        }

        let mut _type: *HIRType = null;

        for branch in this.Branches(expression) {
            if branch->_type->IsNever() { continue; }

            if _type == null {
                _type = branch->_type;
                continue;
            }

            let mut common: *HIRType = null;

            if concrete != null {
                common = this.CommonType(_type, branch->_type);
            } else if branch->_type->IsSame(_type) {
                common = _type;
            }

            if common == null {
                Logger::Log("Incompatible branch types ('" + _type->ToString() + "' != '" + branch->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            } _type = common;
        }

        if _type == null {
            return this.context.NeverType();
        }

        if concrete != null && this.CoerceBranch(expression, _type, true, node) == null {
            return null;
        }

        _type
    }

    fn CoerceBranch(&mut this, expression: *HIRExpression, target: *HIRType, validate: bool, node: *ASTNode) -> *HIRExpression {
        if expression->_type->IsNever() { return expression; }
        let branch = unsafe { expression as *mut HIRExpression };

        match expression->kind {
            HIRExpressionKind::Block => {
                let block = branch as *mut HIRBlockExpression;
                if block->tail == null { return expression; }
                let value = this.CoerceBranch(block->tail, target, validate, node);
                if value == null { return null; }
                block->tail = value;
            },
            HIRExpressionKind::If => {
                let _if = branch as *mut HIRIfExpression;
                if this.CoerceBranch(_if->then_body, target, validate, node) == null { return null; }

                if _if->else_body != null {
                    let else_body = this.CoerceBranch(_if->else_body, target, validate, node);
                    if else_body == null { return null; }
                    _if->else_body = else_body;
                }
            },
            HIRExpressionKind::Match => {
                for arm in (branch as *HIRMatchExpression)->arms {
                    if this.CoerceBranch(arm->body, target, validate, node) == null { return null; }
                }
            },
            HIRExpressionKind::Loop => {
                for _break in (branch as *HIRLoopExpression)->breaks {
                    if _break->value != null {
                        let value = this.CoerceBranch(_break->value, target, validate, node);
                        if value == null { return null; }
                        _break->value = value;
                    }
                }
            },
            _ => {
                if validate {
                    return this.Validate(expression, target, "Incompatible branch types", node);
                } return this.Coerce(expression, target);
            }
        }

        for value in this.Branches(expression) {
            if !value->_type->IsNever() {
                branch->_type = value->_type;
                break;
            }
        }

        expression
    }

    fn GetPendingTemporaryDestructors(&mut this, from: usize) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();
        let mut i = this.temporary_stack.Size();

        while i > from {
            i -= 1;

            for instance in this.temporary_stack[i].Reverse() {
                let function = this.GetDestructor(instance->_type);
                if function == null { continue; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                destructors.PushBack(this.builder.Destructor(this.builder.AddressOf(instance), callee));
            }
        }

        destructors
    }

    fn GetTemporaryDestructorsSince(&mut this, index: usize, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();
        let mut carry = Vector<*HIRExpression>();

        for i in 0..this.temporaries.Size() {
            let instance = this.temporaries[i];

            if i < index {
                carry.PushBack(instance);
                continue;
            }

            if instance == exception { continue; }
            let function = this.GetDestructor(instance->_type);
            if function == null { continue; }
            let callee = this.builder.ReferenceDeclaration(function, false);
            let destructor = this.builder.Destructor(this.builder.AddressOf(instance), callee);
            destructors.Insert(0, destructor);
        }

        this.temporaries.Swap(carry);
        destructors
    }

    fn GetTemporaryDestructors(&mut this, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();

        for instance in this.temporaries.Reverse() {
            if instance == exception { continue; }
            let function = this.GetDestructor(instance->_type);
            if function == null { continue; }
            let callee = this.builder.ReferenceDeclaration(function, false);
            let destructor = this.builder.Destructor(this.builder.AddressOf(instance), callee);
            destructors.PushBack(destructor);
        }

        this.temporaries.Clear();
        destructors
    }

    fn BuildTemporaryDestructors(&mut this, exception: *HIRExpression) {
        for destructor in this.GetTemporaryDestructors(exception) {
            this.builder.BuildExpressionStatement(destructor);
        }
    }

    fn GetDestructors(&mut this, target: *mut Scope, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();
        let mut scope = this.scope_manager.current;

        while scope != null && !scope->global {
            for instance in scope->instances.Reverse() {
                if exception != null {
                    match instance->kind {
                        HIRExpressionKind::BindingReference if exception->kind == HIRExpressionKind::BindingReference => {
                            if (instance as *HIRBindingReference)->binding == (exception as *HIRBindingReference)->binding { continue; }
                        },
                        HIRExpressionKind::DeclarationReference if exception->kind == HIRExpressionKind::DeclarationReference => {
                            if (instance as *HIRDeclarationReference)->declaration == (exception as *HIRDeclarationReference)->declaration { continue; }
                        },
                        _ => {}
                    }
                }

                let function = this.GetDestructor(instance->_type);
                if function == null { continue; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                let destructor = this.builder.Destructor(this.builder.AddressOf(instance), callee);
                destructors.PushBack(destructor);
            }

            if scope == target { break; }
            scope = scope->parent;
        }

        destructors
    }

    fn BuildDestructors(&mut this, target: *mut Scope, exception: *HIRExpression) {
        for destructor in this.GetDestructors(target, exception) {
            this.builder.BuildExpressionStatement(destructor);
        }
    }

    fn IsDeferrableExpression(&mut this, expression: *ASTExpression) -> *HIRType {
        match expression->kind {
            ASTExpressionKind::Literal => {
                let literal = expression as *ASTLiteral;

                match literal->kind {
                    ASTLiteralKind::Integer if (literal as *ASTIntegerLiteral)->suffix.Empty() => this.context.IntegerLiteralType(),
                    ASTLiteralKind::Float if (literal as *ASTFloatLiteral)->suffix.Empty() => this.context.FloatLiteralType(),
                    _ => null
                }
            },
            ASTExpressionKind::Block => {
                let block = expression as *ASTBlockExpression;
                if block->_unsafe || !block->statements.Empty() || block->tail == null { return null; }
                this.IsDeferrableExpression(block->tail)
            },
            ASTExpressionKind::If => {
                let _if = expression as *ASTIfExpression;
                if _if->condition->pattern != null || _if->_else == null { return null; }
                let then_type = this.IsDeferrableExpression(_if->body);
                if then_type == null { return null; }
                let else_type = this.IsDeferrableExpression(_if->_else);
                if else_type == null { return null; }

                if *then_type == *else_type {
                    then_type
                } else {
                    null
                }
            },
            ASTExpressionKind::Binary => {
                let binary = expression as *ASTBinaryExpression;

                if binary->kind == ASTBinaryKind::Equal || binary->kind == ASTBinaryKind::NotEqual || binary->kind == ASTBinaryKind::Greater || binary->kind == ASTBinaryKind::Less || binary->kind == ASTBinaryKind::GreaterEqual || binary->kind == ASTBinaryKind::LessEqual || binary->kind == ASTBinaryKind::LogicalAnd || binary->kind == ASTBinaryKind::LogicalOr {
                    return null;
                }

                let left_type = this.IsDeferrableExpression(binary->left);
                if left_type == null { return null; }
                let right_type = this.IsDeferrableExpression(binary->right);
                if right_type == null { return null; }

                if *left_type == *right_type {
                    left_type
                } else {
                    null
                }
            },
            ASTExpressionKind::Unary => {
                let unary = expression as *ASTUnaryExpression;

                if unary->kind == ASTUnaryKind::Negate || unary->kind == ASTUnaryKind::Not {
                    this.IsDeferrableExpression(unary->operand)
                } else {
                    null
                }
            },
            _ => null
        }
    }

    fn LowerExpectedExpression(&mut this, expression: *ASTExpression, expected: *HIRType) -> *HIRExpression {
        if expected != null && (expression->kind == ASTExpressionKind::Block || expression->kind == ASTExpressionKind::If || expression->kind == ASTExpressionKind::Match) {
            return this.LowerExpression(expression, expected);
        }

        this.LowerExpression(expression)
    }

    fn LowerExpression(&mut this, expression: *ASTExpression) -> *HIRExpression {
        if expression->kind == ASTExpressionKind::Unary || expression->kind == ASTExpressionKind::Binary || expression->kind == ASTExpressionKind::If {
            let _type = this.IsDeferrableExpression(expression);

            if _type != null {
                return this.builder.Deferred(expression, _type);
            }
        }

        this.LowerExpression(expression, null)
    }

    fn LowerExpression(&mut this, expression: *ASTExpression, target: *HIRType) -> *HIRExpression {
        match expression->kind {
            ASTExpressionKind::Literal => this.LowerLiteral(expression as *ASTLiteral),
            ASTExpressionKind::Path => {
                let path = (expression as *ASTPathExpression)->path;
                let symbols = this.scope_manager.Resolve(path, false);
                if symbols.Empty() { return null; }

                for symbol in symbols {
                    match symbol->kind {
                        SymbolKind::Pattern => {
                            return this.builder.ReferenceBinding(symbol->pattern as *HIRIdentifierPattern);
                        },
                        SymbolKind::Expression => {
                            return symbol->expression;
                        },
                        SymbolKind::Declaration => {
                            let declaration = symbol->declaration;

                            match declaration->kind {
                                HIRDeclarationKind::Parameter => {
                                    let parameter = declaration as *HIRParameterDeclaration;
                                    return this.builder.ReferenceDeclaration(parameter, parameter->mutable);
                                },
                                HIRDeclarationKind::Function => {
                                    if (declaration as *HIRFunctionDeclaration)->caller_location != null {
                                        Logger::Log("Cannot take the address of 'track_caller' function '" + path->ToString() + "'.", expression, LogSeverity::Error);
                                        return null;
                                    }

                                    return this.builder.ReferenceDeclaration(declaration as *HIRFunctionDeclaration, false);
                                },
                                HIRDeclarationKind::EnumerationMember => {
                                    return (declaration as *HIREnumerationMember)->value;
                                },
                                HIRDeclarationKind::VariantMember => {
                                    let member = declaration as *HIRVariantMember;

                                    if !member->fields.Empty() {
                                        Logger::Log("Variant member '" + path->ToString() + "' expects " + String::FromInteger(member->fields.Size() as u64) + " argument(s), but none were provided.", expression, LogSeverity::Error);
                                        return null;
                                    }

                                    let literal = this.builder.VariantLiteral(member, Vector<*HIRExpression>());
                                    this.temporaries.PushBack(literal);
                                    return literal;
                                },
                                HIRDeclarationKind::Constant => {
                                    return (declaration as *HIRConstantDeclaration)->initializer;
                                },
                                HIRDeclarationKind::Static => {
                                    let _static = declaration as *HIRStaticDeclaration;
                                    return this.builder.ReferenceDeclaration(_static, _static->mutable);
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                }

                Logger::Log("Symbol '" + path->ToString() + "' cannot be used as an expression.", expression, LogSeverity::Error);
                null
            },
            ASTExpressionKind::Assignment => this.LowerAssignmentExpression(expression as *ASTAssignmentExpression),
            ASTExpressionKind::Call => this.LowerCallExpression(expression as *ASTCallExpression),
            ASTExpressionKind::New => this.LowerNewExpression(expression as *ASTNewExpression),
            ASTExpressionKind::Delete => this.LowerDeleteExpression(expression as *ASTDeleteExpression),
            ASTExpressionKind::Cast => this.LowerCastExpression(expression as *ASTCastExpression),
            ASTExpressionKind::IndexAccess => this.LowerIndexAccessExpression(expression as *ASTIndexAccessExpression),
            ASTExpressionKind::TupleAccess => this.LowerTupleAccessExpression(expression as *ASTTupleAccessExpression),
            ASTExpressionKind::MemberAccess => this.LowerMemberAccessExpression(expression as *ASTMemberAccessExpression),
            ASTExpressionKind::Unary => this.LowerUnaryExpression(expression as *ASTUnaryExpression, target),
            ASTExpressionKind::Binary => this.LowerBinaryExpression(expression as *ASTBinaryExpression, target),
            ASTExpressionKind::Block => {
                let block = expression as *ASTBlockExpression;
                let previous_unsafe = this._unsafe;

                if block->_unsafe {
                    if previous_unsafe {
                        Logger::Log("Unnecessary 'unsafe' block, already in an unsafe context.", block, LogSeverity::Warning);
                    }

                    this._unsafe = true;
                }

                this.scope_manager.PushScope("<block>".ToString(), false);
                let result = this.LowerBlockExpression(block, true, HIRBlockTail::Value, target);
                this.scope_manager.PopScope();
                this._unsafe = previous_unsafe;
                this.RegisterTemporary(result)
            },
            ASTExpressionKind::If => this.RegisterTemporary(this.LowerIfExpression(expression as *ASTIfExpression, target)),
            ASTExpressionKind::While => this.LowerWhileExpression(expression as *ASTWhileExpression),
            ASTExpressionKind::Loop => this.RegisterTemporary(this.LowerLoopExpression(expression as *ASTLoopExpression)),
            ASTExpressionKind::For => this.LowerForExpression(expression as *ASTForExpression),
            ASTExpressionKind::Match => this.RegisterTemporary(this.LowerMatchExpression(expression as *ASTMatchExpression, target)),
            ASTExpressionKind::Return => this.LowerReturnExpression(expression as *ASTReturnExpression),
            ASTExpressionKind::Break => this.LowerBreakExpression(expression as *ASTBreakExpression),
            ASTExpressionKind::Continue => this.LowerContinueExpression(expression as *ASTContinueExpression),
            ASTExpressionKind::Try => this.LowerTryExpression(expression as *ASTTryExpression),
            _ => {
                Logger::Log("Unknown expression '" + expression->kind.ToString() + "'.", expression, LogSeverity::Error);
                null
            }
        }
    }

    fn LowerLiteral(&mut this, literal: *ASTLiteral) -> *HIRExpression {
        match literal->kind {
            ASTLiteralKind::Boolean => this.builder.BooleanLiteral((literal as *ASTBooleanLiteral)->value, this.context.BooleanType()),
            ASTLiteralKind::Character => this.builder.CharacterLiteral((literal as *ASTCharacterLiteral)->value, this.context.IntegerType(8, true)),
            ASTLiteralKind::Integer => {
                let integer = literal as *ASTIntegerLiteral;
                let mut _type = this.context.IntegerLiteralType();

                if !integer->suffix.Empty() {
                    let signed = integer->suffix.StartsWith("i");
                    let suffix = integer->suffix.SubString(1);

                    if suffix == "size" {
                        _type = this.context.IntegerPointerType(signed);
                    } else {
                        let width = suffix.ToUnsignedInteger().Unwrap() as u32;

                        if width == 128 || width == 64 || width == 32 || width == 16 || width == 8 {
                            _type = this.context.IntegerType(width, signed);
                        } else {
                            Logger::Log("Invalid integer suffix '" + integer->suffix +  "'.", literal, LogSeverity::Error);
                            return null;
                        }
                    }
                }

                this.builder.IntegerLiteral(integer->value, _type)
            },
            ASTLiteralKind::Float => {
                let float = literal as *ASTFloatLiteral;
                let mut _type = this.context.FloatLiteralType();

                if !float->suffix.Empty() {
                    let width = float->suffix.SubString(1).ToUnsignedInteger().Unwrap() as u32;

                    if width == 64 || width == 32 {
                        _type = this.context.FloatType(width);
                    } else {
                        Logger::Log("Invalid float suffix '" + float->suffix +  "'.", literal, LogSeverity::Error);
                        return null;
                    }
                }

                this.builder.FloatLiteral(float->value, _type)
            },
            ASTLiteralKind::String => this.builder.StringLiteral((literal as *ASTStringLiteral)->value, this.context.PointerType(this.context.IntegerType(8, true), false)),
            ASTLiteralKind::Array => {
                let mut elements = Vector<*HIRExpression>();
                let mut _type: *HIRType = null;

                for element in (literal as *ASTArrayLiteral)->elements {
                    let mut value = this.LowerExpression(element);
                    if value == null { return null; }
                    value = this.LowerCopyOrMoveValue(value);
                    if value == null { return null; }
                    elements.PushBack(value);

                    if _type == null {
                        _type = value->_type;
                    } else if *_type != *value->_type && !(_type->IsPointer() && value->_type->IsNullPointer()) {
                        Logger::Log("Array elements must have the same type.", element, LogSeverity::Error);
                        return null;
                    }
                }

                if _type == null { _type = this.context.NeverType(); }
                let literal = this.builder.ArrayLiteral(elements, this.context.ArrayType(_type, elements.Size()));
                this.temporaries.PushBack(literal);
                literal
            },
            ASTLiteralKind::Tuple => {
                let mut elements = Vector<*HIRExpression>();
                let mut types = Vector<*HIRType>();

                for element in (literal as *ASTTupleLiteral)->elements {
                    let mut value = this.LowerExpression(element);
                    if value == null { return null; }
                    value = this.LowerCopyOrMoveValue(value);
                    if value == null { return null; }
                    types.PushBack(value->_type);
                    elements.PushBack(value);
                }

                let literal = this.builder.TupleLiteral(elements, this.context.TupleType(types));
                this.temporaries.PushBack(literal);
                literal
            },
            ASTLiteralKind::Structure => {
                let structure = literal as *ASTStructureLiteral;

                if structure->target->kind != ASTExpressionKind::Path {
                    Logger::Log("Structure literal target must be a path.", literal, LogSeverity::Error);
                    return null;
                }

                let path = (structure->target as *ASTPathExpression)->path;

                for symbol in this.scope_manager.ResolveType(path, true) {
                    if symbol->kind != SymbolKind::Type || !symbol->_type->IsStructure() {
                        continue;
                    }

                    let _type = symbol->_type as *HIRStructureType;
                    let fields = _type->Fields();
                    let mut values = Vector<*HIRExpression>();
                    let mut initialized_fields = Vector<usize>();
                    values.Resize(fields.Size());

                    if structure->fields.Size() != fields.Size() {
                        Logger::Log("Structure '" + path->ToString() + "' field count mismatch.", literal, LogSeverity::Error);
                        return null;
                    }

                    for field in structure->fields {
                        let index = _type->Index(field.left);

                        if index == -1 {
                            Logger::Log("Structure '" + path->ToString() + "' doesn't contain any field named '" + field.left + "'.", literal, LogSeverity::Error);
                            return null;
                        }

                        let declaration = fields[index as usize];

                        if !declaration->public && (this.current_type == null || *this.current_type != *_type) {
                            Logger::Log("Field '" + field.left + "' of structure '" + path->ToString() + "' is private.", field.right, LogSeverity::Error);
                            return null;
                        }

                        let mut value = this.Validate(this.LowerExpression(field.right), declaration->_type, "Incompatible structure field types", field.right);
                        if value == null { return null; }
                        value = this.LowerCopyOrMoveValue(value);
                        if value == null { return null; }

                        if initialized_fields.Contains(index as usize) {
                            Logger::Log("Structure '" + path->ToString() + "' field '" + field.left + "' was initialized more than once.", literal, LogSeverity::Error);
                            return null;
                        }

                        initialized_fields.PushBack(index as usize);
                        values[index as usize] = value;
                    }

                    let literal = this.builder.StructureLiteral(values, _type);
                    this.temporaries.PushBack(literal);
                    return literal;
                }

                let symbols = this.scope_manager.Resolve(path, false);
                if symbols.Empty() { return null; }

                for symbol in symbols {
                    if symbol->kind != SymbolKind::Declaration || symbol->declaration->kind != HIRDeclarationKind::VariantMember {
                        continue;
                    }

                    let member = symbol->declaration as *HIRVariantMember;

                    if !member->structure {
                        Logger::Log("Variant member '" + path->ToString() + "' is not a structure.", literal, LogSeverity::Error);
                        return null;
                    }

                    let mut values = Vector<*HIRExpression>();
                    let mut initialized_fields = Vector<usize>();
                    values.Resize(member->fields.Size());

                    if structure->fields.Size() != member->fields.Size() {
                        Logger::Log("Variant member '" + path->ToString() + "' field count mismatch.", literal, LogSeverity::Error);
                        return null;
                    }

                    for field in structure->fields {
                        let mut index: isize = -1;

                        for i in 0..member->fields.Size() {
                            if member->fields[i]->name == field.left {
                                index = i as isize;
                                break;
                            }
                        }

                        if index == -1 {
                            Logger::Log("Variant member '" + path->ToString() + "' doesn't contain any field named '" + field.left + "'.", literal, LogSeverity::Error);
                            return null;
                        }

                        let declaration = member->fields[index as usize];
                        let mut value = this.Validate(this.LowerExpression(field.right), declaration->_type, "Incompatible variant member field types", field.right);
                        if value == null { return null; }
                        value = this.LowerCopyOrMoveValue(value);
                        if value == null { return null; }

                        if initialized_fields.Contains(index as usize) {
                            Logger::Log("Variant member '" + path->ToString() + "' field '" + field.left + "' was initialized more than once.", literal, LogSeverity::Error);
                            return null;
                        }

                        initialized_fields.PushBack(index as usize);
                        values[index as usize] = value;
                    }

                    let literal = this.builder.VariantLiteral(member, values);
                    this.temporaries.PushBack(literal);
                    return literal;
                }

                Logger::Log("Symbol '" + path->ToString() + "' is not a structure.", literal, LogSeverity::Error);
                null
            },
            ASTLiteralKind::Null => this.builder.NullLiteral()
        }
    }

    fn AssignmentToBinaryKind(&this, kind: ASTAssignmentKind) -> ASTBinaryKind {
        match kind {
            ASTAssignmentKind::AddAssign => ASTBinaryKind::Add,
            ASTAssignmentKind::SubtractAssign => ASTBinaryKind::Subtract,
            ASTAssignmentKind::MultiplyAssign => ASTBinaryKind::Multiply,
            ASTAssignmentKind::DivideAssign => ASTBinaryKind::Divide,
            ASTAssignmentKind::ModuloAssign => ASTBinaryKind::Modulo,
            ASTAssignmentKind::LeftShiftAssign => ASTBinaryKind::LeftShift,
            ASTAssignmentKind::RightShiftAssign => ASTBinaryKind::RightShift,
            ASTAssignmentKind::AndAssign => ASTBinaryKind::BitwiseAnd,
            ASTAssignmentKind::OrAssign => ASTBinaryKind::BitwiseOr,
            _ => ASTBinaryKind::BitwiseXor
        }
    }

    fn LowerAssignmentExpression(&mut this, assignment: *ASTAssignmentExpression) -> *HIRExpression {
        let mut left = this.ImplicitDereference(this.LowerExpression(assignment->left));
        if left == null { return null; }

        if left->category != HIRExpressionCategory::Place {
            Logger::Log("Cannot assign to non-place value.", assignment, LogSeverity::Error);
            return null;
        }

        if !left->mutable {
            Logger::Log("Cannot assign to immutable value.", assignment, LogSeverity::Error);
            return null;
        }

        let mut right = this.LowerExpression(assignment->right);
        if right == null { return null; }

        if assignment->kind != ASTAssignmentKind::Assign && !left->_type->IsClass() {
            right = this.ImplicitDereference(right);
        }

        if assignment->kind == ASTAssignmentKind::LeftShiftAssign || assignment->kind == ASTAssignmentKind::RightShiftAssign {
            right = this.Coerce(right);
        } else if left->_type->IsPointer() && (assignment->kind == ASTAssignmentKind::AddAssign || assignment->kind == ASTAssignmentKind::SubtractAssign) {
            right = this.Coerce(right, this.context.IntegerPointerType(false));
        } else {
            right = this.Coerce(right, left->_type);
        }

        if left->_type->HasSpecialMembers() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(left);
            values.PushBack(right);
            let mut function: *HIRFunctionDeclaration = null;

            if left->_type->IsClass() {
                let name = "operator" + assignment->kind.ToString();
                let candidates = left->_type->GetCandidates(name, assignment, false);
                if candidates.Empty() { return null; }
                function = this.ResolveOverload(candidates, values, assignment, false);
                if function == null { return null; }
            } else {
                if assignment->kind != ASTAssignmentKind::Assign {
                    Logger::Log("Cannot perform compound assignment on non-class type.", assignment, LogSeverity::Error);
                    return null;
                }

                function = this.GetCopyAssignment(left->_type);
                if function == null { return null; }
            }

            return this.LowerResolvedCallExpression(function, values, assignment);
        }

        if assignment->kind != ASTAssignmentKind::Assign {
            right = this.LowerResolvedBinaryExpression(this.AssignmentToBinaryKind(assignment->kind), left, right, assignment);
            if right == null { return null; }
        }

        right = this.Validate(right, left->_type, "Incompatible assignment types", assignment);
        if right == null { return null; }
        this.builder.Assignment(left, right)
    }

    fn LowerCallArguments(&mut this, arguments: &Vector<*ASTExpression>, node: *ASTNode, invalid: &mut bool) -> Vector<*HIRExpression> {
        let mut values = Vector<*HIRExpression>();

        for argument in arguments {
            if argument->kind != ASTExpressionKind::PackSplat {
                let value = this.LowerExpression(argument);

                if value == null {
                    invalid = true;
                    return Vector<*HIRExpression>();
                }

                values.PushBack(value);
                continue;
            }

            let splat = argument as *ASTPackSplatExpression;
            let mut expanded = false;

            if this.current_generic != null && this.current_generic->declaration->kind == ASTDeclarationKind::Function && splat->expression->kind == ASTExpressionKind::Path {
                let function = this.current_generic->declaration as *ASTFunctionDeclaration;
                let path = (splat->expression as *ASTPathExpression)->path;

                if !function->pack_name.Empty() && !path->absolute && path->segments.Size() == 1 && path->segments[0].name == function->pack_name && path->segments[0].types.Empty() {
                    let declaration = this.builder.GetCurrentFunction();
                    let mut start = function->parameters.Size();

                    if function->instance_kind != ASTInstanceKind::None {
                        start += 1;
                    }

                    if declaration != null && start <= declaration->parameters.Size() {
                        for i in start..declaration->parameters.Size() {
                            values.PushBack(this.builder.ReferenceDeclaration(declaration->parameters[i], false));
                        } expanded = true;
                    }
                }
            }

            if !expanded {
                Logger::Log("Pack splat can only expand the current function's parameter pack.", node, LogSeverity::Error);
                invalid = true;
                return Vector<*HIRExpression>();
            }
        }

        values
    }

    fn ResolveGenericMethods(&mut this, _type: *HIRType, name: &String, types: &Vector<*ASTType>, values: &Vector<*HIRExpression>, node: *ASTNode) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut lowered_types = Vector<*HIRType>();

        for _type in types {
            let lowered_type = this.LowerType(_type);
            if lowered_type == null { return result; }
            lowered_types.PushBack(lowered_type);
        }

        for generic in this.generics {
            if generic->declaration->kind != ASTDeclarationKind::Function || generic->_type == null || *generic->_type != *_type {
                continue;
            }

            let function = generic->declaration as *ASTFunctionDeclaration;

            if function->name != name {
                continue;
            }

            if !function->public && (this.current_type == null || *this.current_type != *_type) {
                continue;
            }

            if function->pack_name.Empty() && lowered_types.Empty() {
                continue;
            }

            let mut types = Vector<*HIRType>(lowered_types);

            if !function->pack_name.Empty() {
                let mut start = function->parameters.Size();

                if function->instance_kind != ASTInstanceKind::None {
                    start += 1;
                }

                if start <= values.Size() {
                    for i in start..values.Size() {
                        types.PushBack(this.Coerce(values[i])->_type);
                    }
                }
            }

            let instance = generic->Instantiate(types, node);

            if instance != null && instance->declaration != null && instance->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(instance->declaration as *HIRFunctionDeclaration);
            }
        }

        if result.Empty() && _type->IsClass() {
            for parent in (_type as *HIRClassType)->declaration->parents {
                result += this.ResolveGenericMethods(parent, name, types, values, node);
            }
        }

        result
    }

    fn LowerCallExpression(&mut this, call: *ASTCallExpression) -> *HIRExpression {
        if call->expression->kind == ASTExpressionKind::Path {
            let path = (call->expression as *ASTPathExpression)->path;

            if !path->absolute && path->segments.Size() == 1 && path->segments[0].types.Empty() {
                if path->segments[0].name == "sizeof" || path->segments[0].name == "alignof" {
                    if call->arguments.Size() != 1 {
                        Logger::Log("Invalid number of arguments for intrinsic '" + path->segments[0].name + "'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut _type: *HIRType;
                    let argument = call->arguments[0];

                    if argument->kind == ASTExpressionKind::Path {
                        if this.IsPrimitiveTypeName((argument as *ASTPathExpression)->path) {
                            _type = this.LowerType((argument as *ASTPathExpression)->path);
                            if _type == null { return null; }
                        } else {
                            let path = (argument as *ASTPathExpression)->path;
                            let symbols = this.scope_manager.Resolve(path, false);
                            if symbols.Empty() { return null; }

                            for symbol in symbols {
                                match symbol->kind {
                                    SymbolKind::Type => {
                                        _type = symbol->_type;
                                    },
                                    SymbolKind::Pattern => {
                                        _type = (symbol->pattern as *HIRIdentifierPattern)->_type;
                                    },
                                    SymbolKind::Expression => {
                                        _type = symbol->expression->_type;
                                    },
                                    SymbolKind::Declaration => {
                                        _type = (symbol->declaration as *HIRTypedDeclaration)->_type;
                                    },
                                    _ => {}
                                }

                                if _type != null {
                                    break;
                                }
                            }

                            if _type == null {
                                Logger::Log("Symbol '" + path->ToString() + "' cannot be used as a type.", path, LogSeverity::Error);
                                return null;
                            }
                        }
                    } else if argument->kind == ASTExpressionKind::Literal && (argument as *ASTLiteral)->kind == ASTLiteralKind::Tuple && (argument as *ASTTupleLiteral)->elements.Empty() {
                        _type = this.context.UnitType();
                    } else {
                        Logger::Log("Invalid argument kind '" + argument->kind.ToString() + "' for intrinsic '" + path->segments[0].name + "'.", call, LogSeverity::Error);
                        return null;
                    }

                    return this.builder.Intrinsic(if path->segments[0].name == "sizeof" { HIRIntrinsicKind::SizeOf } else { HIRIntrinsicKind::AlignOf }, _type);
                } else if path->segments[0].name == "caller_location" {
                    if call->arguments.Size() != 0 {
                        Logger::Log("Invalid number of arguments for intrinsic '" + path->segments[0].name + "'.", call, LogSeverity::Error);
                        return null;
                    }

                    return this.LowerCallerLocation(call);
                } else if path->segments[0].name == "construct" {
                    if call->arguments.Size() == 0 {
                        Logger::Log("Invalid number of arguments for 'construct'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut invalid = false;
                    let mut values = this.LowerCallArguments(call->arguments, call, &mut invalid);
                    if invalid { return null; }

                    let target = this.ImplicitDereference(values[0]);

                    if !target->_type->IsPointer() {
                        Logger::Log("Construct target must be a pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    if !target->_type->IsMutable() {
                        Logger::Log("Construct target must be a mutable pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    let target_type: *HIRType = target->_type->Pointee();

                    if target_type->IsClass() {
                        let mut candidates = Vector<*HIRFunctionDeclaration>();

                        for candidate in (target_type as *HIRClassType)->declaration->constructors {
                            candidates.PushBack(candidate);
                        }

                        let function = this.ResolveOverload(candidates, values, call, false);
                        if function == null { return null; }
                        let call = this.LowerResolvedCallExpression(function, values, call);
                        if call == null { return null; }
                        this.builder.BuildExpressionStatement(call);
                    } else {
                        values.RemoveAt(0);

                        if values.Size() > 1 {
                            Logger::Log("Primitive type initialization accepts at most 1 argument.", call, LogSeverity::Error);
                            return null;
                        }

                        if values.Size() != 0 {
                            let mut value = this.ImplicitDereference(values[0]);
                            value = this.Validate(value, target_type, "Incompatible primitive type initialization types", call);
                            if value == null { return null; }
                            value = this.LowerCopyOrMoveValue(value);
                            if value == null { return null; }
                            this.builder.BuildExpressionStatement(this.builder.Assignment(this.builder.Dereference(target), value));
                        }
                    } return target;
                } else if path->segments[0].name == "destruct" {
                    if call->arguments.Size() != 1 {
                        Logger::Log("Invalid number of arguments for 'destruct'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut invalid = false;
                    let values = this.LowerCallArguments(call->arguments, call, &mut invalid);
                    if invalid { return null; }

                    let target = this.ImplicitDereference(values[0]);

                    if !target->_type->IsPointer() {
                        Logger::Log("Destruct target must be a pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    if !target->_type->IsMutable() {
                        Logger::Log("Destruct target must be a mutable pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    let target_type: *HIRType = target->_type->Pointee();

                    if target_type->IsClass() {
                        let function = (target_type as *HIRClassType)->declaration->destructor;
                        if function == null { return null; }
                        let callee = this.builder.ReferenceDeclaration(function, false);
                        this.builder.BuildExpressionStatement(this.builder.Destructor(target, callee));
                    } return null;
                }
            }
        }

        let mut invalid = false;
        let mut values = this.LowerCallArguments(call->arguments, call, invalid);
        if invalid { return null; }

        match call->expression->kind {
            ASTExpressionKind::Path => {
                let path = (call->expression as *ASTPathExpression)->path;

                for symbol in this.scope_manager.ResolveType(path, true) {
                    if symbol->kind != SymbolKind::Type || !symbol->_type->IsClass() {
                        continue;
                    }

                    let mut candidates = Vector<*HIRFunctionDeclaration>();

                    for candidate in (symbol->_type as *HIRClassType)->declaration->constructors {
                        candidates.PushBack(candidate);
                    }

                    values.Insert(0, this.builder.NullLiteral());
                    let mut function = this.ResolveOverload(candidates, values, call, true);

                    if function == null {
                        candidates += this.ResolveGenericMethods(symbol->_type, (symbol->_type as *HIRClassType)->declaration->name, Vector<*ASTType>(), values, call);
                        function = this.ResolveOverload(candidates, values, call, false);
                    }

                    if function == null { return null; }
                    let callee = this.builder.ReferenceDeclaration(function, false);
                    if !this.ValidateCallArguments(callee, values, call) { return null; }
                    values.RemoveAt(0);
                    let constructor = this.builder.Constructor(callee, values, symbol->_type);
                    this.temporaries.PushBack(constructor);
                    return constructor;
                }

                for symbol in this.scope_manager.Resolve(path, true) {
                    if symbol->kind != SymbolKind::Declaration || symbol->declaration->kind != HIRDeclarationKind::VariantMember {
                        continue;
                    }

                    let member = symbol->declaration as *HIRVariantMember;

                    if member->structure {
                        Logger::Log("Variant member '" + path->ToString() + "' is a structure.", call, LogSeverity::Error);
                        return null;
                    }

                    if values.Size() != member->fields.Size() {
                        Logger::Log("Variant member '" + path->ToString() + "' expects " + String::FromInteger(member->fields.Size() as u64) + " argument(s), but " + String::FromInteger(values.Size() as u64) + " were provided.", call, LogSeverity::Error);
                        return null;
                    }

                    for i in 0..values.Size() {
                        let mut value = this.Validate(values[i], member->fields[i]->_type, "Incompatible variant member argument types", call);
                        if value == null { return null; }
                        value = this.LowerCopyOrMoveValue(value);
                        if value == null { return null; }
                        values[i] = value;
                    }

                    let literal = this.builder.VariantLiteral(member, values);
                    this.temporaries.PushBack(literal);
                    return literal;
                }

                let candidates = this.scope_manager.ResolveCandidates(path, values, true);

                if !candidates.Empty() {
                    return this.LowerResolvedCallExpression(candidates, values, call);
                }
            },
            ASTExpressionKind::MemberAccess => {
                let member_access = call->expression as *ASTMemberAccessExpression;
                let mut instance = this.ImplicitDereference(this.LowerExpression(member_access->expression));
                if instance == null { return null; }

                if member_access->arrow {
                    if instance->_type->HasMethods() {
                        let mut values = Vector<*HIRExpression>();
                        values.PushBack(instance);
                        let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                        if candidates.Empty() { return null; }
                        instance = this.LowerResolvedCallExpression(candidates, values, member_access);
                        if instance == null { return null; }
                    }

                    if instance->_type->IsPointer() {
                        instance = this.builder.Dereference(instance);
                    } else {
                        Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                        return null;
                    }
                }

                let mut candidates = Vector<*HIRFunctionDeclaration>();

                if !instance->_type->HasMethods() {
                    candidates += this.extension_registry.GetCandidates(instance->_type, member_access->member, call, true);
                } else {
                    candidates += instance->_type->GetCandidates(member_access->member, call, true);
                }

                values.Insert(0, instance);
                candidates += this.ResolveGenericMethods(instance->_type, member_access->member, member_access->types, values, call);

                if !candidates.Empty() {
                    return this.LowerResolvedCallExpression(candidates, values, call);
                } values.RemoveAt(0);
            },
            _ => {}
        }

        let value = this.LowerExpression(call->expression);
        if value == null { return null; }
        this.LowerResolvedCallExpression(value, values, call)
    }

    fn ResolveOverload(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *ASTNode, test: bool) -> *HIRFunctionDeclaration {
        let mut index: usize = 0;
        let mut best: u64 = 0;

        for i in 0..candidates.Size() {
            let function = candidates[i];
            let parameters = function->_type->Parameters();
            if values.Size() != parameters.Size() { continue; }
            let (mut _match, mut score) = (true, 1u64);

            for j in 0..parameters.Size() {
                let mut parameter_score = parameters[j]->ScoreParameter(values[j]->_type);

                if parameter_score != 0 && parameters[j]->IsReference() && !values[j]->_type->IsPointer() && values[j]->category == HIRExpressionCategory::Place {
                    if parameters[j]->IsMutable() && !values[j]->mutable {
                        parameter_score = 0;
                    } else if !parameters[j]->IsMutable() && values[j]->mutable {
                        parameter_score -= 1;
                    }
                }

                if parameter_score != 0 {
                    score += parameter_score;
                } else {
                    _match = false;
                    break;
                }
            }

            if _match && score > best {
                (index, best) = (i, score);
            }
        }

        if best != 0 {
            candidates[index]
        } else {
            if !test {
                if !candidates.Empty() {
                    Logger::Log("Invalid arguments for: '" + candidates[0]->name + "'.", node, LogSeverity::Error);
                } else {
                    Logger::Log("No candidates found for function call!", node, LogSeverity::Fatal);
                }
            }

            null
        }
    }

    fn ValidateCallArguments(&mut this, callee: *HIRExpression, values: &mut Vector<*HIRExpression>, node: *ASTNode) -> bool {
        if !callee->_type->IsFunction() {
            Logger::Log("Callee is not a function.", node, LogSeverity::Error);
            return false;
        }

        let parameter_types = callee->_type->Parameters();

        if values.Size() != parameter_types.Size() {
            Logger::Log("Function expects " + String::FromInteger(parameter_types.Size() as u64) + " argument(s), but " + String::FromInteger(values.Size() as u64) + " were provided.", node, LogSeverity::Error);
            return false;
        }

        for i in 0..parameter_types.Size() {
            let mut message = String();

            if callee->kind == HIRExpressionKind::DeclarationReference {
                message += "Incompatible argument types for function '" + (callee as *HIRDeclarationReference)->declaration->name + '\'';
            } else {
                message += "Incompatible function argument types";
            }

            let mut value = this.Validate(values[i], parameter_types[i], message.Data(), node);            
            if value == null { return false; }
            value = this.LowerCopyOrMoveValue(value);
            if value == null { return false; }
            values[i] = value;
        }

        true
    }

    fn LowerResolvedCallExpression(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        let function = this.ResolveOverload(candidates, values, node, false);
        if function == null { return null; }
        this.LowerResolvedCallExpression(function, values, node)
    }

    fn LowerResolvedCallExpression(&mut this, function: *HIRFunctionDeclaration, values: &Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        this.LowerResolvedCallExpression(this.builder.ReferenceDeclaration(function, false), values, node)
    }

    fn LowerResolvedCallExpression(&mut this, callee: *HIRExpression, mut values: Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        if !this.ValidateCallArguments(callee, values, node) {
            return null;
        }

        let call = this.builder.Call(callee, values);

        if callee->kind == HIRExpressionKind::DeclarationReference {
            let declaration = (callee as *HIRDeclarationReference)->declaration;

            if declaration->kind == HIRDeclarationKind::Function && (declaration as *HIRFunctionDeclaration)->caller_location != null {
                call->location = this.LowerCopyOrMoveValue(this.LowerCallerLocation(node));
                if call->location == null { return null; }
            }
        }

        if (callee->_type as *HIRFunctionType)->_return->HasSpecialMembers() {
            this.temporaries.PushBack(call);
        }

        call
    }

    fn CallerLocationType(&mut this) -> *HIRTupleType {
        let mut types = Vector<*HIRType>();
        types.PushBack(this.context.PointerType(this.context.IntegerType(8, true), false));
        types.PushBack(this.context.IntegerType(32, false));
        types.PushBack(this.context.IntegerType(32, false));
        this.context.TupleType(types)
    }

    fn LowerCallerLocation(&mut this, node: *ASTNode) -> *HIRExpression {
        let function = this.builder.GetCurrentFunction();

        if function != null && function->caller_location != null {
            return this.builder.ReferenceDeclaration(function->caller_location, false);
        }

        let mut token = node->start;

        if node->kind == ASTNodeKind::Expression && (node as *ASTExpression)->kind == ASTExpressionKind::Call {
            let callee = (node as *ASTCallExpression)->expression;
            token = callee->start;

            if callee->kind == ASTExpressionKind::MemberAccess {
                token.column += token.value.Length() as u32;
            }
        }

        let _type = this.CallerLocationType();
        let mut elements = Vector<*HIRExpression>();
        elements.PushBack(this.builder.StringLiteral(token.file, _type->elements[0]));
        elements.PushBack(this.builder.IntegerLiteral(token.row as u64, _type->elements[1]));
        elements.PushBack(this.builder.IntegerLiteral(token.column as u64, _type->elements[2]));
        this.builder.TupleLiteral(elements, _type)
    }

    fn LowerNewExpression(&mut this, _new: *ASTNewExpression) -> *HIRExpression {
        let _type = this.LowerType(_new->_type);
        if _type == null { return null; }

        if _type->IsNever() {
            Logger::Log("Cannot allocate a value of type '" + _type->ToString() + "'.", _new, LogSeverity::Error);
            return null;
        }

        if _new->size != null {
            let size = this.Coerce(this.LowerExpression(_new->size), this.context.IntegerPointerType(false));
            if size == null { return null; }

            if !size->_type->IsIntegerPointer() || size->_type->IsSigned() {
                Logger::Log("Array size must be of type 'usize'.", _new, LogSeverity::Error);
                return null;
            }

            if _type->IsClass() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.builder.NullLiteral());
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, _new, false);
                if function == null { return null; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                this.builder.New(_type, size, false, callee, Vector<*HIRExpression>())
            } else {
                this.builder.New(_type, size, false, null, Vector<*HIRExpression>())
            }
        } else if _new->initialized {
            let mut invalid = false;
            let mut values = this.LowerCallArguments(_new->arguments, _new, &mut invalid);
            if invalid { return null; }

            if _type->IsClass() {
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                values.Insert(0, this.builder.NullLiteral());
                let mut function = this.ResolveOverload(candidates, values, _new, true);

                if function == null {
                    candidates += this.ResolveGenericMethods(_type, (_type as *HIRClassType)->declaration->name, Vector<*ASTType>(), values, _new);
                    function = this.ResolveOverload(candidates, values, _new, false);
                }

                if function == null { return null; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                if !this.ValidateCallArguments(callee, values, _new) { return null; }
                values.RemoveAt(0);
                this.builder.New(_type, null, true, callee, values)
            } else {
                if values.Size() != 1 {
                    Logger::Log("Primitive type initialization requires exactly 1 argument.", _new, LogSeverity::Error);
                    return null;
                }

                values[0] = this.Validate(values[0], _type, "Incompatible primitive type initialization types", _new);
                if values[0] == null { return null; }
                values[0] = this.LowerCopyOrMoveValue(values[0]);
                if values[0] == null { return null; }
                this.builder.New(_type, null, true, null, values)
            }
        } else {
            this.builder.New(_type, null, false, null, Vector<*HIRExpression>())
        }
    }

    fn LowerDeleteExpression(&mut this, _delete: *ASTDeleteExpression) -> *HIRExpression {
        let pointer = this.ImplicitDereference(this.LowerExpression(_delete->expression));
        if pointer == null { return null; }

        if !pointer->_type->IsPointer() {
            Logger::Log("Delete value must be a pointer.", _delete, LogSeverity::Error);
            return null;
        }

        if pointer->_type->Pointee().IsClass() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.builder.NullLiteral());
            let function = (pointer->_type->Pointee() as *HIRClassType)->declaration->destructor;
            if function == null { return null; }
            let callee = this.builder.ReferenceDeclaration(function, false);
            this.builder.Delete(pointer, _delete->array, callee, Vector<*HIRExpression>())
        } else {
            this.builder.Delete(pointer, _delete->array, null, Vector<*HIRExpression>())
        }
    }

    fn LiteralNeedsExplicitType(&mut this, _type: *HIRType, target: *HIRType) -> bool {
        if _type->IsNever() {
            true
        } else if _type->IsArray() && target->IsArray() {
            this.LiteralNeedsExplicitType(_type->Element(), target->Element())
        } else if _type->IsTuple() && target->IsTuple() {
            let &elements = (_type as *HIRTupleType)->elements;
            let &targets = (target as *HIRTupleType)->elements;
            if elements.Size() != targets.Size() { return false; }

            for i in 0..elements.Size() {
                if this.LiteralNeedsExplicitType(elements[i], targets[i]) {
                    return true;
                }
            }

            false
        } else if _type->IsLiteral() {
            if _type->IsInteger() {
                target->IsInteger() && !target->IsSame(this.context.IntegerType(32, true))
            } else if _type->IsFloat() {
                target->IsFloat() && !target->IsSame(this.context.FloatType(64))
            } else {
                false
            }
        } else {
            false
        }
    }

    fn LowerCastExpression(&mut this, cast: *ASTCastExpression) -> *HIRExpression {
        let mut target = this.LowerType(cast->target);
        if target == null { return null; }

        let value = this.Coerce(this.LowerExpression(cast->expression), target);
        if value == null { return null; }

        if *value->_type == *target && this.LiteralNeedsExplicitType(value->_type, target) {
            return value;
        }

        this.LowerResolvedCastExpression(value, target, cast)
    }

    fn LowerResolvedCastExpression(&mut this, mut value: *HIRExpression, target: *HIRType, node: *ASTNode) -> *HIRExpression {
        if !target->IsPointer() {
            value = this.ImplicitDereference(value);
        } else if value->category == HIRExpressionCategory::Place && value->_type->IsReference() && value->_type->Pointee().IsPointer() && !value->_type->Pointee().IsReference() {
            value = this.ImplicitDereference(value);
        }

        let (mut state, mut failed) = (false, false);
        let (mut left, mut right) = (target, value->_type);

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() {
                if left->IsMutable() && !right->IsNullPointer() {
                    failed = true;
                } state = true;
            }

            if left->IsReference() != right->IsReference() {
                state = true;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if *value->_type == target {
            if !state {
                Logger::Log("Redundant cast. ('" + value->_type->ToString() + "' to '" + target->ToString() + "')", node, LogSeverity::Warning);
            } else {
                if !failed || this._unsafe {
                    return this.builder.Cast(value, target);
                } else {
                    Logger::Log("Cannot cast immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    return null;
                }
            }
        }

        if value->_type->IsBoolean() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsCharacter() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsInteger() {
            if target->IsPointer() || target->IsInteger() || target->IsFloat() || target->IsEnumeration() {
                return this.builder.Cast(value, target);
            } else if target->IsCharacter() {
                if value->_type->Width() == 8 && !value->_type->IsSigned() {
                    return this.builder.Cast(value, target);
                }
            }
        } else if value->_type->IsFloat() {
            if target->IsInteger() || target->IsFloat() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsPointer() {
            if target->IsInteger() || target->IsFunction() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsFunction() {
            if target->IsPointer() || target->IsFunction() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsEnumeration() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        }

        if value->_type->IsPointer() && target->IsPointer() {
            if value->_type->Pointee().IsClass() && target->Pointee().IsClass() {
                let (source, destination) = (value->_type->Pointee(), target->Pointee());

                if !destination.IsDerivedFrom(source) && !source.IsDerivedFrom(destination) {
                    let source_name = (source as *HIRClassType)->declaration->name;
                    let destination_name = (destination as *HIRClassType)->declaration->name;
                    Logger::Log("Cannot cast class '" + source_name + "' to unrelated class '" + destination_name + "'.", node, LogSeverity::Error);
                    return null;
                }
            }

            this.builder.Cast(value, target)
        } else {
            Logger::Log("Cannot cast '" + value->_type->ToString() + "' to '" + target->ToString() + "'.", node, LogSeverity::Error);
            null
        }
    }

    fn LowerIndexAccessExpression(&mut this, index_access: *ASTIndexAccessExpression) -> *HIRExpression {
        let value = this.ImplicitDereference(this.LowerExpression(index_access->expression));
        if value == null { return null; }

        let index = this.Coerce(this.ImplicitDereference(this.LowerExpression(index_access->index)), this.context.IntegerPointerType(false));
        if index == null { return null; }

        if value->_type->HasMethods() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(value);
            values.PushBack(index);
            let candidates = value->_type->GetCandidates("operator[]".ToString(), index_access, false);
            if candidates.Empty() { return null; }
            let call = this.LowerResolvedCallExpression(candidates, values, index_access);
            if call == null { return null; }

            if !call->_type->IsReference() {
                Logger::Log("Expected the result of 'operator[]' to be a reference.", index_access, LogSeverity::Error);
                return null;
            }

            return this.builder.Dereference(call);
        }

        if !value->_type->IsPointer() && !value->_type->IsArray() {
            Logger::Log("Indexed value must be a pointer or an array.", index_access, LogSeverity::Error);
            return null;
        }

        if !index->_type->IsIntegerPointer() || index->_type->IsSigned() {
            Logger::Log("Index must be of type 'usize'.", index_access, LogSeverity::Error);
            return null;
        }

        if value->_type->IsPointer() && value->_type->Pointee().IsVoid() {
            Logger::Log("Cannot index a pointer to 'void'.", index_access, LogSeverity::Error);
            return null;
        }

        let mut constant_index: u64 = 0;

        if value->_type->IsArray() && this.IntegerLiteralValue(index, &mut constant_index) && constant_index >= value->_type->Length() as u64 {
            Logger::Log("Index " + String::FromInteger(constant_index) + " is out of bounds for an array of length " + String::FromInteger(value->_type->Length() as u64) + ".", index_access, LogSeverity::Error);
            return null;
        }

        this.builder.IndexAccess(value, index)
    }

    fn LowerTupleAccessExpression(&mut this, tuple_access: *ASTTupleAccessExpression) -> *HIRExpression {
        let mut instance = this.ImplicitDereference(this.LowerExpression(tuple_access->expression));
        if instance == null { return null; }

        if tuple_access->arrow {
            if instance->_type->IsPointer() {
                instance = this.builder.Dereference(instance);
            } else {
                Logger::Log("Expected a pointer type for arrow operator.", tuple_access, LogSeverity::Error);
                return null;
            }
        }

        if !instance->_type->IsTuple() {
            Logger::Log("Cannot access field '" + String::FromInteger(tuple_access->index as u64) + "' of type '" + instance->_type->ToString() + "'.", tuple_access, LogSeverity::Error);
            return null;
        }

        if tuple_access->index >= (instance->_type as *HIRTupleType)->elements.Size() {
            Logger::Log("Field '" + String::FromInteger(tuple_access->index as u64) + "' not found in type '" + instance->_type->ToString() + "'.", tuple_access, LogSeverity::Error);
            return null;
        }

        this.builder.TupleAccess(instance, tuple_access->index)
    }

    fn LowerMemberAccessExpression(&mut this, member_access: *ASTMemberAccessExpression) -> *HIRExpression {
        let mut instance = this.ImplicitDereference(this.LowerExpression(member_access->expression));
        if instance == null { return null; }

        if member_access->arrow {
            if instance->_type->HasMethods() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(instance);
                let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                if candidates.Empty() { return null; }
                instance = this.LowerResolvedCallExpression(candidates, values, member_access);
                if instance == null { return null; }
            }

            if instance->_type->IsPointer() {
                instance = this.builder.Dereference(instance);
            } else {
                Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                return null;
            }
        }

        if !instance->_type->HasFields() {
            Logger::Log("Cannot access field '" + member_access->member + "' of type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }

        let (mut path, mut ambiguous) = (Vector<u32>(), false);
        let field = instance->_type->FindField(member_access->member, path, ambiguous);

        if ambiguous {
            Logger::Log("Field '" + member_access->member + "' is ambiguous in type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }

        if field != null {
            for index in path {
                let parent = (instance->_type as *HIRClassType)->declaration->parents[index as usize];
                instance = this.builder.Dereference(this.builder.Cast(this.builder.AddressOf(instance), this.context.ReferenceType(parent, instance->mutable)));
            }

            if !field->public && (this.current_type == null || *this.current_type != *instance->_type) {
                Logger::Log("Field '" + member_access->member + "' is private.", member_access, LogSeverity::Error);
                return null;
            }

            this.builder.FieldAccess(instance, field)
        } else {
            Logger::Log("Field '" + member_access->member + "' not found in type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            null
        }
    }

    fn LowerUnaryExpression(&mut this, unary: *ASTUnaryExpression, target: *HIRType) -> *HIRExpression {
        let mut value = this.ImplicitDereference(this.LowerExpression(unary->operand));
        if value == null { return null; }

        let mut values = Vector<*HIRExpression>();
        values.PushBack(value);
        let name = "operator" + unary->kind.ToString();
        let candidates = this.extension_registry.GetCandidates(value->_type, name, unary, true);
        let function = this.ResolveOverload(candidates, values, unary, true);

        if function != null {
            return this.LowerResolvedCallExpression(function, values, unary);
        }

        if value->_type->HasMethods() {
            let candidates = value->_type->GetCandidates(name, unary, true);
            let function = this.ResolveOverload(candidates, values, unary, true);

            if function != null {
                return this.LowerResolvedCallExpression(function, values, unary);
            }
        }

        match unary->kind {
            ASTUnaryKind::AddressOf => {
                if value->category != HIRExpressionCategory::Place {
                    Logger::Log("Cannot take reference to non-place value.", unary, LogSeverity::Error);
                    return null;
                }

                if unary->mutable && !value->mutable {
                    Logger::Log("Cannot take mutable reference to immutable value.", unary, LogSeverity::Error);
                    return null;
                }

                this.builder.AddressOf(value, unary->mutable)
            },
            ASTUnaryKind::Dereference => {
                if !value->_type->IsPointer() {
                    Logger::Log("Cannot dereference non-pointer type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }

                if value->_type->Pointee().IsVoid() {
                    Logger::Log("Cannot dereference a value of type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }

                this.builder.Dereference(value)
            },
            _ => {
                let mut operand_target: *HIRType = null;

                if target != null {
                    match unary->kind {
                        ASTUnaryKind::Negate => {
                            if target->IsFloat() || (target->IsInteger() && target->IsSigned()) {
                                operand_target = target;
                            }
                        },
                        ASTUnaryKind::Not => {
                            operand_target = target;
                        },
                        _ => {}
                    }
                }

                if operand_target != null {
                    value = this.Coerce(value, operand_target);
                } else {
                    value = this.Coerce(value);
                }

                match unary->kind {
                    ASTUnaryKind::Negate => {
                        if !value->_type->IsInteger() && !value->_type->IsFloat() {
                            Logger::Log("Cannot negate type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                            return null;
                        }

                        if value->_type->IsInteger() && !value->_type->IsSigned() {
                            Logger::Log("Cannot negate unsigned type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                            return null;
                        }

                        this.builder.Unary(HIRUnaryKind::Negate, value)
                    },
                    ASTUnaryKind::Not => {
                        if !value->_type->IsInteger() && !value->_type->IsBoolean() {
                            Logger::Log("Cannot invert type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                            return null;
                        }

                        this.builder.Unary(HIRUnaryKind::Not, value)
                    },
                    _ => {
                        Logger::Log("Invalid unary operation '" + unary->kind.ToString() + "'.", unary, LogSeverity::Error);
                        null
                    }
                }
            }
        }
    }

    fn LowerBinaryKind(&this, kind: ASTBinaryKind) -> HIRBinaryKind {
        match kind {
            ASTBinaryKind::Add => HIRBinaryKind::Add,
            ASTBinaryKind::Subtract => HIRBinaryKind::Subtract,
            ASTBinaryKind::Multiply => HIRBinaryKind::Multiply,
            ASTBinaryKind::Divide => HIRBinaryKind::Divide,
            ASTBinaryKind::Modulo => HIRBinaryKind::Modulo,
            ASTBinaryKind::Equal => HIRBinaryKind::Equal,
            ASTBinaryKind::NotEqual => HIRBinaryKind::NotEqual,
            ASTBinaryKind::Less => HIRBinaryKind::Less,
            ASTBinaryKind::LessEqual => HIRBinaryKind::LessEqual,
            ASTBinaryKind::Greater => HIRBinaryKind::Greater,
            ASTBinaryKind::GreaterEqual => HIRBinaryKind::GreaterEqual,
            ASTBinaryKind::LogicalAnd => HIRBinaryKind::LogicalAnd,
            ASTBinaryKind::LogicalOr => HIRBinaryKind::LogicalOr,
            ASTBinaryKind::BitwiseAnd => HIRBinaryKind::BitwiseAnd,
            ASTBinaryKind::BitwiseOr => HIRBinaryKind::BitwiseOr,
            ASTBinaryKind::BitwiseXor => HIRBinaryKind::BitwiseXor,
            ASTBinaryKind::LeftShift => HIRBinaryKind::LeftShift,
            _ => HIRBinaryKind::RightShift
        }
    }

    fn LowerBinaryExpression(&mut this, binary: *ASTBinaryExpression, target: *HIRType) -> *HIRExpression {
        let mut operand_target: *HIRType = null;

        if target != null && binary->kind != ASTBinaryKind::Equal && binary->kind != ASTBinaryKind::NotEqual && binary->kind != ASTBinaryKind::Greater && binary->kind != ASTBinaryKind::Less && binary->kind != ASTBinaryKind::GreaterEqual && binary->kind != ASTBinaryKind::LessEqual && binary->kind != ASTBinaryKind::LogicalAnd && binary->kind != ASTBinaryKind::LogicalOr {
            if target->IsInteger() || target->IsFloat() || target->IsBoolean() {
                operand_target = target;
            }
        }

        let mut left = this.ImplicitDereference(this.LowerExpression(binary->left));
        if left == null { return null; }

        if operand_target != null {
            left = this.Coerce(left, operand_target);
        }

        if binary->kind == ASTBinaryKind::LogicalAnd || binary->kind == ASTBinaryKind::LogicalOr {
            if !left->_type->IsBoolean() {
                Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + binary->kind.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            let index = this.temporaries.Size();
            let right = this.ImplicitDereference(this.LowerExpression(binary->right));
            let destructors = this.GetTemporaryDestructorsSince(index, right);
            if right == null { return null; }

            if !right->_type->IsBoolean() {
                Logger::Log("Invalid type '" + right->_type->ToString() + "' for binary operation '" + binary->kind.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            return this.builder.Binary(this.LowerBinaryKind(binary->kind), left, right, destructors, left->_type);
        }

        let mut right = this.ImplicitDereference(this.LowerExpression(binary->right));
        if right == null { return null; }

        if operand_target != null && binary->kind != ASTBinaryKind::LeftShift && binary->kind != ASTBinaryKind::RightShift {
            right = this.Coerce(right, operand_target);
        }

        this.LowerResolvedBinaryExpression(binary->kind, left, right, binary)
    }

    fn LowerResolvedBinaryExpression(&mut this, kind: ASTBinaryKind, mut left: *HIRExpression, mut right: *HIRExpression, node: *ASTNode) -> *HIRExpression {
        let mut values = Vector<*HIRExpression>();
        values.PushBack(left);
        values.PushBack(right);

        let name = "operator" + kind.ToString();
        let candidates = this.extension_registry.GetCandidates(left->_type, name, node, true);
        let function = this.ResolveOverload(candidates, values, node, true);

        if function != null {
            return this.LowerResolvedCallExpression(function, values, node);
        } else if left->_type->HasFields() || right->_type->HasFields() {
            let reciever = if left->_type->HasFields() { left } else { right };
            let argument = if left->_type->HasFields() { right } else { left };

            let mut values = Vector<*HIRExpression>();
            values.PushBack(reciever);
            values.PushBack(argument);

            if reciever->_type->HasMethods() {
                let candidates = reciever->_type->GetCandidates(name, node, true);
                let function = this.ResolveOverload(candidates, values, node, true);

                if function != null {
                    return this.LowerResolvedCallExpression(function, values, node);
                }
            }

            if *left->_type == *right->_type {
                if kind != ASTBinaryKind::Equal && kind != ASTBinaryKind::NotEqual {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    return null;
                }

                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }
        }

        if kind == ASTBinaryKind::LeftShift || kind == ASTBinaryKind::RightShift {
            (left, right) = (this.Coerce(left), this.Coerce(right));
        } else if left->_type->IsPointer() && right->_type->IsInteger() && right->_type->IsLiteral() {
            right = this.Coerce(right, this.context.IntegerPointerType(false));
        } else if right->_type->IsPointer() && left->_type->IsInteger() && left->_type->IsLiteral() {
            left = this.Coerce(left, this.context.IntegerPointerType(false));
        } else {
            (left, right) = (this.Coerce(left, right->_type), this.Coerce(right, left->_type));
        }

        if left->_type->IsUnit() && right->_type->IsUnit() {
            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual {
                this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType())
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '()'.", node, LogSeverity::Error);
                null
            }
        } else if left->_type->IsBoolean() && right->_type->IsBoolean() {
            match kind {
                ASTBinaryKind::Equal | ASTBinaryKind::NotEqual => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType()),
                ASTBinaryKind::LogicalAnd | ASTBinaryKind::BitwiseAnd | ASTBinaryKind::LogicalOr | ASTBinaryKind::BitwiseOr | ASTBinaryKind::BitwiseXor => this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type),
                _ => {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else if left->_type->IsCharacter() && right->_type->IsCharacter() {
            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType())
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                null
            }
        } else if left->_type->IsInteger() && right->_type->IsInteger() {
            if *left->_type != *right->_type && !(kind == ASTBinaryKind::LeftShift || kind == ASTBinaryKind::RightShift) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            let mut constant: u64 = 0;

            if (kind == ASTBinaryKind::Divide || kind == ASTBinaryKind::Modulo) && this.IntegerLiteralValue(right, &mut constant) && constant == 0 {
                Logger::Log(if kind == ASTBinaryKind::Divide { "Division by zero." } else { "Remainder with a divisor of zero." }, node, LogSeverity::Error);
                return null;
            }

            if (kind == ASTBinaryKind::LeftShift || kind == ASTBinaryKind::RightShift) && this.IntegerLiteralValue(right, &mut constant) && constant >= left->_type->Width() as u64 {
                Logger::Log("Shift amount " + String::FromInteger(constant) + " is out of range for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }

            match kind {
                ASTBinaryKind::Add | ASTBinaryKind::Subtract | ASTBinaryKind::Multiply | ASTBinaryKind::Divide | ASTBinaryKind::Modulo => this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type),
                ASTBinaryKind::Equal | ASTBinaryKind::NotEqual | ASTBinaryKind::Greater | ASTBinaryKind::GreaterEqual | ASTBinaryKind::Less | ASTBinaryKind::LessEqual => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType()),
                ASTBinaryKind::BitwiseAnd | ASTBinaryKind::BitwiseOr | ASTBinaryKind::BitwiseXor | ASTBinaryKind::LeftShift | ASTBinaryKind::RightShift => this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type),
                _ => {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else if left->_type->IsFloat() && right->_type->IsFloat() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            match kind {
                ASTBinaryKind::Add | ASTBinaryKind::Subtract | ASTBinaryKind::Multiply | ASTBinaryKind::Divide | ASTBinaryKind::Modulo => this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type),
                ASTBinaryKind::Equal | ASTBinaryKind::NotEqual | ASTBinaryKind::Greater | ASTBinaryKind::GreaterEqual | ASTBinaryKind::Less | ASTBinaryKind::LessEqual => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType()),
                _ => {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else if left->_type->IsPointer() && right->_type->IsPointer() {
            if *left->_type != *right->_type && !(left->_type->IsNullPointer() || right->_type->IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            match kind {
                ASTBinaryKind::Subtract => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.IntegerPointerType(false)),
                ASTBinaryKind::Equal | ASTBinaryKind::NotEqual | ASTBinaryKind::Greater | ASTBinaryKind::GreaterEqual | ASTBinaryKind::Less | ASTBinaryKind::LessEqual => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType()),
                _ => {
                    Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else if (left->_type->IsPointer() && right->_type->IsInteger()) || (left->_type->IsInteger() && right->_type->IsPointer()) {
            let pointer = if left->_type->IsPointer() { left } else { right };
            let index = if left->_type->IsPointer() { right } else { left };

            if !index->_type->IsIntegerPointer() {
                Logger::Log("Pointer arithmetic requires an operand of pointer-sized type.", node, LogSeverity::Error);
                return null;
            }

            if pointer->_type->Pointee().IsVoid() {
                Logger::Log("Pointer arithmetic is not allowed on type '" + pointer->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }

            match kind {
                ASTBinaryKind::Add => this.builder.Binary(this.LowerBinaryKind(kind), left, right, pointer->_type),
                ASTBinaryKind::Subtract => {
                    if left->_type->IsInteger() {
                        Logger::Log("Cannot subtract a pointer from an integer.", node, LogSeverity::Error);
                        return null;
                    }

                    this.builder.Binary(this.LowerBinaryKind(kind), left, right, pointer->_type)
                },
                _ => {
                    Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else if (left->_type->IsFunction() && right->_type->IsNullPointer()) || (left->_type->IsNullPointer() && right->_type->IsFunction()) {
            if *left->_type != *right->_type && !(left->_type->IsNullPointer() || right->_type->IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual {
                this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType())
            } else {
                Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                null
            }
        } else if left->_type->IsEnumeration() && right->_type->IsEnumeration() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            match kind {
                ASTBinaryKind::BitwiseAnd | ASTBinaryKind::BitwiseOr | ASTBinaryKind::BitwiseXor => this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type),
                ASTBinaryKind::Equal | ASTBinaryKind::NotEqual | ASTBinaryKind::Greater | ASTBinaryKind::GreaterEqual | ASTBinaryKind::Less | ASTBinaryKind::LessEqual => this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType()),
                _ => {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    null
                }
            }
        } else {
            Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + kind.ToString() + "'.", node, LogSeverity::Error);
            null
        }
    }

    fn LowerBlockExpression(&mut this, block: *ASTBlockExpression, destruct: bool, tail: HIRBlockTail, expected: *HIRType) -> *mut HIRBlockExpression {
        let previous_block = this.builder.GetCurrentBlock();
        let result = this.builder.Block();
        this.builder.SetCurrentBlock(result);
        this.temporary_stack.PushBack(this.temporaries);
        this.temporaries.Clear();

        for statement in block->statements {
            this.LowerStatement(statement);
        }

        if block->tail != null {
            this.LowerBlockTail(block->tail, tail, result, expected);
        }

        if destruct {
            result->destructors += this.GetDestructors(this.scope_manager.current, null);
        }

        if result->tail == null {
            for statement in result->statements {
                if statement->kind == HIRStatementKind::Expression && (statement as *HIRExpressionStatement)->expression->_type->IsNever() {
                    result->_type = this.context.NeverType();
                    break;
                }
            }
        }

        this.temporaries = this.temporary_stack.PopBack().Unwrap();
        this.builder.SetCurrentBlock(previous_block);
        result
    }

    fn LowerBlockTail(&mut this, expression: *ASTExpression, tail: HIRBlockTail, block: *mut HIRBlockExpression, expected: *HIRType) {
        let returns = tail == HIRBlockTail::Return;
        let mut value = this.LowerExpectedExpression(expression, if returns { this.builder.GetCurrentFunction()->_return } else { expected });

        if value != null && tail == HIRBlockTail::Value && expected != null && !value->_type->IsNever() {
            value = this.Validate(value, expected, "Incompatible types", expression);
        }

        if value == null {
            this.MarkErroneous();
            return;
        }

        if value->_type->IsNever() || (tail == HIRBlockTail::Discard && value->_type->IsUnit()) {
            this.builder.BuildExpressionStatement(value);
            this.BuildTemporaryDestructors(null);
        } else if returns {
            let _return = this.LowerReturn(value, expression, expression);

            if _return != null {
                this.builder.BuildExpressionStatement(_return);
            } else {
                this.MarkErroneous();
            }
        } else if tail == HIRBlockTail::Value {
            let moved = this.LowerCopyOrMoveValue(value);
            if moved == null { return; }
            (block->tail, block->_type) = (moved, moved->_type);
            block->destructors = this.GetTemporaryDestructors(moved);
        } else {
            Logger::Log("Expected a value of type '()', but found '" + value->_type->ToString() + "'; add ';' to discard it.", expression, LogSeverity::Error);
        }
    }

    fn LowerIfExpression(&mut this, _if: *ASTIfExpression, expected: *HIRType) -> *HIRExpression {
        let mut condition: *HIRCondition = null;
        let temporary_index = this.temporaries.Size();
        let expression = this.ImplicitDereference(this.LowerExpression(_if->condition->expression));
        if expression == null { return null; }
        let destructors = this.GetTemporaryDestructorsSince(temporary_index, expression);
        this.scope_manager.PushScope("<then>".ToString(), false);

        if _if->condition->pattern != null {
            let pattern = this.LowerPattern(_if->condition->pattern, null, expression, HIRBindingMode::Value);

            if pattern == null {
                this.scope_manager.PopScope();
                return null;
            }

            condition = this.builder.BuildCondition(pattern, expression);
        } else {
            if expression != null && !expression->_type->IsBoolean() {
                Logger::Log("Invalid condition type '" + expression->_type->ToString() + "'.", _if->condition->expression, LogSeverity::Error);
            }

            condition = this.builder.BuildCondition(expression);
        }

        let then_body = this.LowerBlockExpression(_if->body, true, HIRBlockTail::Value, expected);
        this.scope_manager.PopScope();
        let mut else_body: *HIRExpression = null;

        if _if->_else != null {
            this.scope_manager.PushScope("<else>".ToString(), false);

            if _if->_else->kind == ASTExpressionKind::Block {
                else_body = this.LowerBlockExpression(_if->_else as *ASTBlockExpression, true, HIRBlockTail::Value, expected);
            } else {
                else_body = this.LowerIfExpression(_if->_else as *ASTIfExpression, expected);
            }

            this.scope_manager.PopScope();
            if else_body == null { return null; }
        }

        let result = this.builder.If(condition, destructors, then_body, else_body, this.context.UnitType());

        if else_body != null {
            let _type = this.UnifyBranches(result, _if);
            if _type == null { return null; }
            result->_type = _type;
        } else if !then_body->_type->IsNever() && !then_body->_type->IsUnit() {
            Logger::Log("An 'if' without an 'else' cannot produce a value.", _if, LogSeverity::Error);
            return null;
        }

        result
    }

    fn LowerWhileExpression(&mut this, _while: *ASTWhileExpression) -> *HIRExpression {
        let mut condition: *HIRCondition = null;
        let temporary_index = this.temporaries.Size();
        let expression = this.ImplicitDereference(this.LowerExpression(_while->condition->expression));
        if expression == null { return null; }
        let destructors = this.GetTemporaryDestructorsSince(temporary_index, expression);
        this.scope_manager.PushScope("<while>".ToString(), false);

        if _while->condition->pattern != null {
            let pattern = this.LowerPattern(_while->condition->pattern, null, expression, HIRBindingMode::Value);

            if pattern == null {
                this.scope_manager.PopScope();
                return null;
            }

            condition = this.builder.BuildCondition(pattern, expression);
        } else {
            if expression != null && !expression->_type->IsBoolean() {
                Logger::Log("Invalid condition type '" + expression->_type->ToString() + "'.", _while->condition->expression, LogSeverity::Error);
            }

            condition = this.builder.BuildCondition(expression);
        }

        this.loop_scopes.PushBack(this.scope_manager.current);
        this.loop_targets.PushBack(null);
        this.loop_temporaries.PushBack(this.temporary_stack.Size());
        let while_body = this.LowerBlockExpression(_while->body, true, HIRBlockTail::Discard, null);
        this.loop_temporaries.PopBack();
        this.loop_targets.PopBack();
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        let mut else_body: *HIRBlockExpression = null;

        if _while->_else != null {
            this.scope_manager.PushScope("<else>".ToString(), false);
            else_body = this.LowerBlockExpression(_while->_else, true, HIRBlockTail::Discard, null);
            this.scope_manager.PopScope();
        }

        this.builder.While(condition, destructors, while_body, else_body)
    }

    fn LowerLoopExpression(&mut this, _loop: *ASTLoopExpression) -> *HIRExpression {
        let result = this.builder.Loop();
        this.scope_manager.PushScope("<loop>".ToString(), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.loop_targets.PushBack(result);
        this.loop_temporaries.PushBack(this.temporary_stack.Size());
        result->body = this.LowerBlockExpression(_loop->body, true, HIRBlockTail::Discard, null);
        this.loop_temporaries.PopBack();
        this.loop_targets.PopBack();
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        if result->breaks.Empty() {
            result->_type = this.context.NeverType();
            return result;
        }

        let mut values: usize = 0;

        for _break in result->breaks {
            if _break->value != null {
                values += 1;
            }
        }

        if values == 0 {
            return result;
        } else if values != result->breaks.Size() {
            Logger::Log("Every 'break' of a 'loop' that produces a value must have a value.", _loop, LogSeverity::Error);
            return null;
        }

        let _type = this.UnifyBranches(result, _loop);
        if _type == null { return null; }
        result->_type = _type;
        result
    }

    fn LowerForExpression(&mut this, _for: *ASTForExpression) -> *HIRExpression {
        let (mut start, mut end): (*HIRExpression, *HIRExpression);
        let (mut is_range, mut inclusive) = (false, false);
        let temporary_index = this.temporaries.Size();

        if _for->iterable->kind == ASTExpressionKind::Range {
            let range = _for->iterable as *ASTRangeExpression;
            (is_range, inclusive) = (true, range->inclusive);
            start = this.ImplicitDereference(this.LowerExpression(range->start));
            end = this.ImplicitDereference(this.LowerExpression(range->end));
            if start == null || end == null { return null; }
            start = this.Coerce(start, end->_type);
            end = this.Coerce(end, start->_type);
        } else {
            let iterable = this.ImplicitDereference(this.LowerExpression(_for->iterable));
            if iterable == null { return null; }

            if iterable->_type->IsArray() {
                let index_type = this.context.IntegerPointerType(false);
                let pointer_type = this.context.PointerType(iterable->_type->Element(), iterable->mutable);
                start = this.builder.Cast(this.builder.AddressOf(this.builder.IndexAccess(iterable, this.builder.IntegerLiteral(0, index_type))), pointer_type);
                end = this.builder.Binary(HIRBinaryKind::Add, start, this.builder.IntegerLiteral(iterable->_type->Length() as u64, index_type), pointer_type);
            } else {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(iterable);

                let mut begin_function: *HIRFunctionDeclaration = null;
                let mut end_function: *HIRFunctionDeclaration = null;

                if iterable->_type->HasMethods() {
                    let begin_candidates = iterable->_type->GetCandidates("Begin".ToString(), _for, true);
                    begin_function = this.ResolveOverload(begin_candidates, values, _for, true);

                    let end_candidates = iterable->_type->GetCandidates("End".ToString(), _for, true);
                    end_function = this.ResolveOverload(end_candidates, values, _for, true);
                }

                if begin_function == null || end_function == null {
                    Logger::Log("For loop iterable must provide 'Begin()' and 'End()' methods.", _for, LogSeverity::Error);
                    return null;
                }

                start = this.LowerResolvedCallExpression(begin_function, values, _for);
                end = this.LowerResolvedCallExpression(end_function, values, _for);
                if start == null || end == null { return null; }
            }
        }

        if *start->_type != *end->_type {
            Logger::Log("Start and end expressions of a for loop must have the same type.", _for, LogSeverity::Error);
            return null;
        }

        let iterator_type = start->_type;

        if is_range && !iterator_type->IsInteger() && !iterator_type->IsFloat() {
            Logger::Log("For loop ranges require an integer or floating point type.", _for, LogSeverity::Error);
            return null;
        }

        if !is_range && !iterator_type->IsPointer() {
            Logger::Log("For loop 'Begin()' and 'End()' methods must return pointers.", _for, LogSeverity::Error);
            return null;
        }

        let target = this.builder.IdentifierPattern("target".ToString(), iterator_type, end, false);
        let iterator = this.builder.IdentifierPattern("iterator".ToString(), iterator_type, start, true);
        let (mut item, mut condition, mut step): (*HIRExpression, *HIRExpression, *HIRExpression) = (null, null, null);
        let iterator_reference = this.builder.ReferenceBinding(iterator);
        let target_reference = this.builder.ReferenceBinding(target);

        if is_range {
            let one: *HIRExpression = if iterator_type->IsFloat() {
                this.builder.FloatLiteral(1.0, iterator_type)
            } else {
                this.builder.IntegerLiteral(1, iterator_type)
            };

            item = iterator_reference;
            condition = this.builder.Binary(if inclusive { HIRBinaryKind::LessEqual } else { HIRBinaryKind::Less }, iterator_reference, target_reference, this.context.BooleanType());
            step = this.builder.Assignment(iterator_reference, this.builder.Binary(HIRBinaryKind::Add, iterator_reference, one, iterator_type));
        } else {
            let one: *HIRExpression = this.builder.IntegerLiteral(1, this.context.IntegerPointerType(false));
            step = this.builder.Assignment(iterator_reference, this.builder.Binary(HIRBinaryKind::Add, iterator_reference, one, iterator_type));
            condition = this.builder.Binary(HIRBinaryKind::NotEqual, iterator_reference, target_reference, this.context.BooleanType());
            item = this.builder.Cast(iterator_reference, this.context.ReferenceType(iterator_type->Pointee(), iterator_type->IsMutable()));
        }

        let destructors = this.GetTemporaryDestructorsSince(temporary_index, null);
        this.scope_manager.PushScope("<for>".ToString(), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.loop_targets.PushBack(null);
        this.loop_temporaries.PushBack(this.temporary_stack.Size());
        let previous_block = this.builder.GetCurrentBlock();
        let body = this.builder.Block();
        this.builder.SetCurrentBlock(body);
        this.temporary_stack.PushBack(this.temporaries);
        this.temporaries.Clear();
        let pattern = this.LowerPattern(_for->pattern, null, item, HIRBindingMode::Value);

        if pattern != null {
            if !pattern->IsIrrefutable() {
                Logger::Log("A refutable pattern cannot be used in a 'for' loop.", _for->pattern, LogSeverity::Error);
            } else {
                body->statements.PushBack(this.builder.BuildLetStatement(pattern, null, item));
                this.BuildTemporaryDestructors(null);
            }
        }

        for statement in _for->body->statements {
            this.LowerStatement(statement);
        }

        if _for->body->tail != null {
            this.LowerBlockTail(_for->body->tail, HIRBlockTail::Discard, body, null);
        }

        body->destructors = this.GetDestructors(this.scope_manager.current, null);
        this.temporaries = this.temporary_stack.PopBack().Unwrap();
        this.builder.SetCurrentBlock(previous_block);
        this.loop_temporaries.PopBack();
        this.loop_targets.PopBack();
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.builder.For(iterator, target, condition, step, destructors, body)
    }

    fn LowerMatchExpression(&mut this, _match: *ASTMatchExpression, expected: *HIRType) -> *HIRExpression {
        let temporary_index = this.temporaries.Size();
        let target = this.ImplicitDereference(this.LowerExpression(_match->target));
        if target == null { return null; }

        if !target->_type->IsUnit() && !target->_type->IsBoolean() && !target->_type->IsCharacter() && !target->_type->IsInteger() && !target->_type->IsFloat() && !target->_type->IsStructure() && !target->_type->IsEnumeration() && !target->_type->IsVariant() {
            Logger::Log("Cannot match on a value of type '" + target->_type->ToString() + "'.", _match->target, LogSeverity::Error);
            return null;
        }

        let destructors = this.GetTemporaryDestructorsSince(temporary_index, target);
        let mut arms = Vector<*HIRMatchArm>();

        for arm in _match->arms {
            this.scope_manager.PushScope("<match>".ToString(), false);
            let pattern = this.LowerPattern(arm->pattern, null, target, HIRBindingMode::Value);

            if pattern == null {
                this.scope_manager.PopScope();
                return null;
            }

            let mut guard: *HIRExpression = null;
            let guard_index = this.temporaries.Size();

            if arm->guard != null {
                guard = this.ImplicitDereference(this.LowerExpression(arm->guard));

                if guard == null {
                    this.scope_manager.PopScope();
                    return null;
                }

                if !guard->_type->IsBoolean() {
                    Logger::Log("Match guard must be a boolean expression.", arm->guard, LogSeverity::Error);
                }
            }

            let mut destructors = Vector<*HIRExpression>();

            if guard != null {
                destructors = this.GetTemporaryDestructorsSince(guard_index, guard);
            }

            let body = this.LowerBlockExpression(arm->body, true, HIRBlockTail::Value, expected);
            this.scope_manager.PopScope();
            let match_arm = this.builder.BuildMatchArm(pattern, guard, body);
            match_arm->destructors = destructors;
            arms.PushBack(match_arm);
        }

        let expression = this.builder.Match(target, destructors, arms, this.context.UnitType());
        this.CheckUnreachableArms(_match, arms, target->_type);
        let missing = expression->Uncovered();

        if missing.Size() == 1 && missing[0] == "_" {
            Logger::Log("Non-exhaustive match on '" + target->_type->ToString() + "'; add a '_' arm.", _match, LogSeverity::Error);
        } else if !missing.Empty() {
            let mut names = String();

            for i in 0..missing.Size() {
                if i != 0 { names += ", "; }
                names += "'" + missing[i] + "'";
            }

            Logger::Log("Non-exhaustive match on '" + target->_type->ToString() + "', not covered: " + names + ".", _match, LogSeverity::Error);
        }

        let _type = this.UnifyBranches(expression, _match);
        if _type == null { return null; }
        expression->_type = _type;
        expression
    }

    fn CheckUnreachableArms(&mut this, _match: *ASTMatchExpression, arms: &Vector<*HIRMatchArm>, _type: *HIRType) {
        let checker = HIRPatternChecker();
        let mut rows = Vector<Vector<*HIRPattern>>();
        let mut types = Vector<*HIRType>();
        types.PushBack(_type);

        for i in 0..arms.Size() {
            let (arm, node) = (arms[i], _match->arms[i]);
            let mut vector = Vector<*HIRPattern>();
            vector.PushBack(arm->pattern);

            if !checker.Useful(rows, vector, types) {
                Logger::Log("Unreachable pattern.", node->pattern, LogSeverity::Warning);
            } else if arm->pattern->kind == HIRPatternKind::Or && node->pattern->kind == ASTPatternKind::Or {
                let mut previous = rows;
                let alternatives = (arm->pattern as *HIROrPattern)->patterns;

                for j in 0..alternatives.Size() {
                    let mut alternative = Vector<*HIRPattern>();
                    alternative.PushBack(alternatives[j]);

                    if !checker.Useful(previous, alternative, types) {
                        Logger::Log("Unreachable pattern.", (node->pattern as *ASTOrPattern)->patterns[j], LogSeverity::Warning);
                    } previous.PushBack(alternative);
                }
            }

            if arm->guard == null {
                rows.PushBack(vector);
            }
        }
    }

    fn LowerReturnExpression(&mut this, _return: *ASTReturnExpression) -> *HIRExpression {
        let mut value: *HIRExpression = null;

        if _return->value != null {
            let return_type = this.builder.GetCurrentFunction()->_return;
            value = this.LowerExpectedExpression(_return->value, if return_type->IsNever() { null } else { return_type });
            if value == null { return null; }
        }

        this.LowerReturn(value, _return, _return->value)
    }

    fn LowerReturn(&mut this, mut value: *HIRExpression, node: *ASTNode, value_node: *ASTNode) -> *HIRExpression {
        let return_type = this.builder.GetCurrentFunction()->_return;

        if return_type->IsNever() {
            Logger::Log("Cannot return from a function with return type '!'.", node, LogSeverity::Error);
            return null;
        }

        if value == null && !return_type->IsUnit() {
            Logger::Log("Expected a return value of type '" + return_type->ToString() + "'.", node, LogSeverity::Error);
            return null;
        }

        if value != null {
            value = this.Validate(value, return_type, "Incompatible return types", value_node);
            if value == null { return null; }
            value = this.LowerCopyOrMoveValue(value);
            if value == null { return null; }
        }

        let mut destructors = this.GetTemporaryDestructors(value);
        destructors += this.GetPendingTemporaryDestructors(0);
        destructors += this.GetDestructors(null, value);
        this.builder.Return(value, destructors)
    }

    fn LowerBreakExpression(&mut this, _break: *ASTBreakExpression) -> *HIRExpression {
        if this.loop_scopes.Empty() {
            Logger::Log("Break statement outside of loop.", _break, LogSeverity::Error);
            return null;
        }

        let target = this.loop_targets.Back();
        let mut value: *HIRExpression = null;

        if _break->value != null {
            if target == null {
                Logger::Log("A 'break' with a value is only allowed inside 'loop'.", _break, LogSeverity::Error);
                return null;
            }

            value = this.LowerExpression(_break->value);
            if value == null { return null; }
            value = this.LowerCopyOrMoveValue(value);
            if value == null { return null; }
        }

        let mut destructors = this.GetTemporaryDestructors(value);
        destructors += this.GetPendingTemporaryDestructors(this.loop_temporaries.Back() + 1);
        destructors += this.GetDestructors(this.loop_scopes.Back(), null);
        let result = this.builder.Break(value, destructors);

        if target != null {
            target->breaks.PushBack(result);
        }

        result
    }

    fn LowerContinueExpression(&mut this, _continue: *ASTContinueExpression) -> *HIRExpression {
        if this.loop_scopes.Empty() {
            Logger::Log("Continue statement outside of loop.", _continue, LogSeverity::Error);
            return null;
        }

        let mut destructors = this.GetTemporaryDestructors(null);
        destructors += this.GetPendingTemporaryDestructors(this.loop_temporaries.Back() + 1);
        destructors += this.GetDestructors(this.loop_scopes.Back(), null);
        this.builder.Continue(destructors)
    }

    fn LowerTryExpression(&mut this, _try: *ASTTryExpression) -> *HIRExpression {
        Logger::Log("The '?' operator is not implemented yet.", _try, LogSeverity::Error);
        null
    }

    fn IsUninferred(&mut this, _type: *HIRType) -> bool {
        if _type->IsArray() {
            _type->Element().IsNever() || this.IsUninferred(_type->Element())
        } else if _type->IsTuple() {
            for element in (_type as *HIRTupleType)->elements {
                if this.IsUninferred(element) { return true; }
            }

            false
        } else {
            false
        }
    }

    fn IsTemporary(&mut this, mut expression: *HIRExpression) -> bool {
        loop {
            if expression->category != HIRExpressionCategory::Place {
                return true;
            }

            match expression->kind {
                HIRExpressionKind::IndexAccess if (expression as *HIRIndexAccessExpression)->value->_type->IsArray() => {
                    expression = (expression as *HIRIndexAccessExpression)->value;
                },
                HIRExpressionKind::TupleAccess => {
                    expression = (expression as *HIRTupleAccessExpression)->instance;
                },
                HIRExpressionKind::FieldAccess => {
                    expression = (expression as *HIRFieldAccessExpression)->instance;
                },
                HIRExpressionKind::MemberAccess => {
                    expression = (expression as *HIRMemberAccessExpression)->instance;
                },
                HIRExpressionKind::TagAccess => {
                    expression = (expression as *HIRTagAccessExpression)->instance;
                },
                _ => {
                    return false;
                }
            }
        }
    }

    fn ExpandRestPatterns(&mut this, patterns: &Vector<*ASTPattern>, count: usize, description: &String, node: *ASTNode, expanded: &mut Vector<*ASTPattern>) -> bool {
        let mut rest: isize = -1;

        for i in 0..patterns.Size() {
            if patterns[i]->kind != ASTPatternKind::Rest {
                continue;
            }

            if rest != -1 {
                Logger::Log("'..' can only be used once per pattern.", patterns[i], LogSeverity::Error);
                return false;
            }

            rest = i as isize;
        }

        let explicit = if rest == -1 { patterns.Size() } else { patterns.Size() - 1 };

        if (rest == -1 && explicit != count) || explicit > count {
            Logger::Log(description + " has " + String::FromInteger(count as u64) + " field(s), but the pattern has " + String::FromInteger(explicit as u64) + '.', node, LogSeverity::Error);
            return false;
        }

        for i in 0..patterns.Size() {
            if i as isize == rest {
                for j in 0..count - explicit {
                    expanded.PushBack(null);
                }
            } else {
                expanded.PushBack(patterns[i]);
            }
        }

        true
    }

    fn ResolveFieldPatterns(&mut this, patterns: &Vector<*ASTPattern>, names: &Vector<String>, description: &String, node: *ASTNode, indices: &mut Vector<usize>) -> bool {
        let mut rest = false;

        for pattern in patterns {
            if pattern->kind == ASTPatternKind::Rest {
                rest = true;
                continue;
            }

            let name = (pattern as *ASTFieldPattern)->name;
            let mut index: isize = -1;

            for i in 0..names.Size() {
                if names[i] == name {
                    index = i as isize;
                    break;
                }
            }

            if index == -1 {
                Logger::Log(description + " doesn't contain any field named '" + name + "'.", pattern, LogSeverity::Error);
                return false;
            }

            if indices.Contains(index as usize) {
                Logger::Log("Field '" + name + "' is bound more than once in the pattern.", pattern, LogSeverity::Error);
                return false;
            }

            indices.PushBack(index as usize);
        }

        if !rest && indices.Size() != names.Size() {
            for i in 0..names.Size() {
                if !indices.Contains(i) {
                    Logger::Log("Pattern does not mention field '" + names[i] + "' of " + description + "; use '..' to ignore the remaining fields.", node, LogSeverity::Error);
                    return false;
                }
            }
        }

        true
    }

    fn LowerReferencePattern(&mut this, pattern: *ASTPattern, reference: *HIRExpression) -> *HIRPattern {
        let binding = this.builder.IdentifierPattern("reference".ToString(), reference->_type, reference, false);
        let referent = this.LowerPattern(pattern, null, this.builder.Dereference(this.builder.ReferenceBinding(binding)), HIRBindingMode::Reference);
        if referent == null { return null; }
        this.builder.DereferencePattern(binding, referent)
    }

    fn PatternType(&mut this, target_type: *HIRType, value: *HIRExpression) -> *HIRType {
        if target_type != null { return target_type; }
        if value == null { return null; }

        if value->_type->IsReference() {
            return value->_type->Pointee();
        }

        value->_type
    }

    fn LowerRangeBound(&mut this, bound: *ASTExpression, _type: *HIRType) -> *HIRExpression {
        let lowered = this.Coerce(this.LowerExpression(bound), _type);
        if lowered == null { return null; }

        if lowered->kind != HIRExpressionKind::Literal || ((lowered as *HIRLiteral)->kind != HIRLiteralKind::Integer && (lowered as *HIRLiteral)->kind != HIRLiteralKind::Character) || !lowered->_type->IsSame(_type) {
            Logger::Log("Range pattern bounds must be integer or character literals of type '" + _type->ToString() + "'.", bound, LogSeverity::Error);
            return null;
        }

        lowered
    }

    fn LowerPattern(&mut this, pattern: *ASTPattern, mut target_type: *HIRType, mut value: *HIRExpression, mode: HIRBindingMode) -> *HIRPattern {
        if target_type == null && value != null && value->_type->IsReference() && (pattern->kind == ASTPatternKind::Tuple || pattern->kind == ASTPatternKind::Structure || pattern->kind == ASTPatternKind::Variant || pattern->kind == ASTPatternKind::Path) {
            return this.LowerReferencePattern(pattern, value);
        }

        match pattern->kind {
            ASTPatternKind::Wildcard => this.builder.WildcardPattern(),
            ASTPatternKind::Rest => this.builder.RestPattern(),
            ASTPatternKind::Literal => {
                let expected = this.PatternType(target_type, value);
                let mut literal = this.LowerExpression((pattern as *ASTLiteralPattern)->literal);
                if literal == null { return null; }

                if expected != null {
                    literal = this.Coerce(literal, expected);
                } else {
                    literal = this.Coerce(literal);
                }

                if literal == null { return null; }

                if expected != null && !literal->_type->IsSame(expected) {
                    Logger::Log("Mismatched pattern type, expected '" + expected->ToString() + "' but found '" + literal->_type->ToString() + "'.", pattern, LogSeverity::Error);
                    return null;
                }

                this.builder.LiteralPattern(literal)
            },
            ASTPatternKind::Range => {
                let range = pattern as *ASTRangePattern;
                let expected = this.PatternType(target_type, value);

                if expected == null || (!expected->IsInteger() && !expected->IsCharacter()) {
                    let name = if expected != null { expected->ToString() } else { "unknown".ToString() };
                    Logger::Log("Range patterns can only match integers and characters, not '" + name + "'.", pattern, LogSeverity::Error);
                    return null;
                }

                let start = if range->start != null { this.LowerRangeBound(range->start, expected) } else { null };
                if range->start != null && start == null { return null; }
                let end = if range->end != null { this.LowerRangeBound(range->end, expected) } else { null };
                if range->end != null && end == null { return null; }

                if start != null && end != null {
                    let checker = HIRPatternChecker();
                    let (low, high) = (checker.BoundValue(start, expected), checker.BoundValue(end, expected));

                    if low > high || (!range->inclusive && low == high) {
                        Logger::Log("Lower bound of a range pattern must be " + (if range->inclusive { "less than or equal to" } else { "less than" }).ToString() + " its upper bound.", pattern, LogSeverity::Error);
                        return null;
                    }
                }

                this.builder.RangePattern(start, end, range->inclusive)
            },
            ASTPatternKind::Identifier => {
                let identifier = pattern as *ASTIdentifierPattern;

                if identifier->reference {
                    if mode == HIRBindingMode::Reference {
                        Logger::Log("Binding modifiers can only be used when the default binding mode is by value.", pattern, LogSeverity::Error);
                        return null;
                    } else if value == null {
                        Logger::Log("A '&' binding requires a value to refer to.", pattern, LogSeverity::Error);
                        return null;
                    } else if this.IsTemporary(value) {
                        Logger::Log("Cannot bind a reference to a temporary value.", pattern, LogSeverity::Error);
                        return null;
                    } else if identifier->mutable && !value->mutable {
                        Logger::Log("Cannot take mutable reference to immutable value.", pattern, LogSeverity::Error);
                        return null;
                    }

                    let reference_type = this.context.ReferenceType(value->_type, identifier->mutable);
                    let lowered = this.builder.IdentifierPattern(identifier->name, reference_type, this.builder.AddressOf(value, identifier->mutable), false);
                    this.scope_manager.current->Set(identifier->name, lowered, pattern);
                    return lowered;
                }

                if mode == HIRBindingMode::Reference && value != null && value->category == HIRExpressionCategory::Place && !value->_type->IsReference() {
                    if identifier->mutable {
                        Logger::Log("Binding modifiers can only be used when the default binding mode is by value.", pattern, LogSeverity::Error);
                        return null;
                    }

                    let reference_type = this.context.ReferenceType(value->_type, value->mutable);
                    let lowered = this.builder.IdentifierPattern(identifier->name, reference_type, this.builder.AddressOf(value), false);
                    this.scope_manager.current->Set(identifier->name, lowered, pattern);
                    return lowered;
                }

                if value != null {
                    if target_type != null {
                        value = this.Coerce(value, target_type);
                        if value == null { return null; }

                        if target_type->IsReference() && !value->_type->IsReference() && this.IsTemporary(value) {
                            Logger::Log("Cannot bind a reference to a temporary value.", pattern, LogSeverity::Error);
                            return null;
                        }

                        value = this.Validate(value, target_type, "Incompatible binding initialization types", pattern);
                        if value == null { return null; }
                    } else {
                        value = this.Coerce(value);
                        if value == null { return null; }
                        target_type = value->_type;

                        if target_type->IsNever() {
                            Logger::Log("Cannot bind a value of type '!'.", pattern, LogSeverity::Error);
                            return null;
                        }

                        if this.IsUninferred(target_type) {
                            Logger::Log("Cannot infer the element type of an empty array literal; add a type annotation.", pattern, LogSeverity::Error);
                            return null;
                        }
                    }

                    value = this.LowerCopyOrMoveValue(value);
                    if value == null { return null; }
                } else if target_type->IsClass() {
                    let mut values = Vector<*HIRExpression>();
                    let mut candidates = Vector<*HIRFunctionDeclaration>();

                    for candidate in (target_type as *HIRClassType)->declaration->constructors {
                        candidates.PushBack(candidate);
                    }

                    values.Insert(0, this.builder.NullLiteral());
                    let function = this.ResolveOverload(candidates, values, pattern, true);
                    if function == null { return null; }
                    values.RemoveAt(0);
                    let callee = this.builder.ReferenceDeclaration(function, false);
                    value = this.builder.Constructor(callee, values, target_type);
                }

                let lowered = this.builder.IdentifierPattern(identifier->name, target_type, value, identifier->mutable);
                this.scope_manager.current->Set(identifier->name, lowered, pattern);

                if target_type->HasSpecialMembers() {
                    this.scope_manager.current->instances.PushBack(this.builder.ReferenceBinding(lowered));
                }

                lowered
            },
            ASTPatternKind::Tuple => {
                let tuple = pattern as *ASTTuplePattern;

                if value != null {
                    if target_type != null {
                        value = this.Coerce(value, target_type);
                    } else {
                        value = this.Coerce(value);
                    }

                    if value == null {
                        return null;
                    }
                }

                let mut any_type = target_type;

                if any_type == null && value != null {
                    any_type = value->_type;
                }

                if !any_type->IsTuple() {
                    Logger::Log("Cannot destructure non-tuple type '" + any_type->ToString() + "' with a tuple pattern.", pattern, LogSeverity::Error);
                    return null;
                }

                let tuple_type = any_type as *HIRTupleType;
                let mut expanded = Vector<*ASTPattern>();

                if !this.ExpandRestPatterns(tuple->patterns, tuple_type->elements.Size(), "Tuple type '" + any_type->ToString() + "'", pattern, expanded) {
                    return null;
                }

                let mut patterns = Vector<*HIRPattern>();

                for i in 0..expanded.Size() {
                    if expanded[i] == null {
                        patterns.PushBack(this.builder.WildcardPattern());
                        continue;
                    }

                    let mut element_type: *HIRType = null;
                    if target_type != null { element_type = tuple_type->elements[i]; }
                    let element = if value != null { this.builder.TupleAccess(value, i) } else { null };
                    let lowered_pattern = this.LowerPattern(expanded[i], element_type, element, mode);
                    if lowered_pattern == null { return null; }
                    patterns.PushBack(lowered_pattern);
                }

                this.builder.TuplePattern(patterns, tuple_type)
            },
            ASTPatternKind::Field => {
                let field = pattern as *ASTFieldPattern;
                let lowered_pattern = this.LowerPattern(field->pattern, target_type, value, mode);
                if lowered_pattern == null { return null; }
                this.builder.FieldPattern(field->name, lowered_pattern)
            },
            ASTPatternKind::Structure => {
                let structure = pattern as *ASTStructurePattern;
                let mut patterns = Vector<*HIRPattern>();

                for symbol in this.scope_manager.ResolveType(structure->path, true) {
                    if symbol->kind != SymbolKind::Type || !symbol->_type->IsStructure() {
                        continue;
                    }

                    let declaration = (symbol->_type as *HIRStructureType)->declaration;
                    let description = "structure '" + structure->path->ToString() + "'";

                    if value != null && !value->_type->IsSame(symbol->_type) {
                        Logger::Log("Mismatched pattern type, expected '" + value->_type->ToString() + "' but found " + description + ".", pattern, LogSeverity::Error);
                        return null;
                    }

                    let mut names = Vector<String>();
                    for field in declaration->fields { names.PushBack(field->name); }
                    let mut indices = Vector<usize>();
                    if !this.ResolveFieldPatterns(structure->patterns, names, description, pattern, indices) { return null; }
                    let mut position: usize = 0;

                    for field_pattern in structure->patterns {
                        if field_pattern->kind == ASTPatternKind::Rest { continue; }
                        let declaration_field = declaration->fields[indices[position]];
                        position += 1;

                        if !declaration_field->public && (this.current_type == null || *this.current_type != *symbol->_type) {
                            Logger::Log("Field '" + declaration_field->name + "' of " + description + " is private.", field_pattern, LogSeverity::Error);
                            return null;
                        }

                        let field = if value != null { this.builder.FieldAccess(value, declaration_field) } else { null };
                        let lowered_pattern = this.LowerPattern(field_pattern, null, field, mode);
                        if lowered_pattern == null { return null; }
                        patterns.PushBack(lowered_pattern);
                    }

                    return this.builder.StructurePattern(declaration, patterns);
                }

                let symbols = this.scope_manager.Resolve(structure->path, false);
                if symbols.Empty() { return null; }

                for symbol in symbols {
                    if symbol->kind != SymbolKind::Declaration || symbol->declaration->kind != HIRDeclarationKind::VariantMember {
                        continue;
                    }

                    let member = symbol->declaration as *HIRVariantMember;
                    let description = "variant member '" + structure->path->ToString() + "'";

                    if !member->structure {
                        Logger::Log("Variant member '" + structure->path->ToString() + "' is not a structure.", pattern, LogSeverity::Error);
                        return null;
                    }

                    if value != null && !value->_type->IsSame(member->_type) {
                        Logger::Log("Mismatched pattern type, expected '" + value->_type->ToString() + "' but found " + description + ".", pattern, LogSeverity::Error);
                        return null;
                    }

                    let mut names = Vector<String>();
                    for field in member->fields { names.PushBack(field->name); }
                    let mut indices = Vector<usize>();
                    if !this.ResolveFieldPatterns(structure->patterns, names, description, pattern, indices) { return null; }
                    let mut position: usize = 0;

                    for field_pattern in structure->patterns {
                        if field_pattern->kind == ASTPatternKind::Rest { continue; }
                        let member_field = member->fields[indices[position]];
                        position += 1;
                        let field = if value != null { this.builder.MemberAccess(value, member, member_field) } else { null };
                        let lowered_pattern = this.LowerPattern(field_pattern, null, field, mode);
                        if lowered_pattern == null { return null; }
                        patterns.PushBack(lowered_pattern);
                    }

                    return this.builder.VariantPattern(member, patterns);
                }

                Logger::Log("Symbol '" + structure->path->ToString() + "' is not a structure.", pattern, LogSeverity::Error);
                null
            },
            ASTPatternKind::Variant => {
                let mut patterns = Vector<*HIRPattern>();
                let variant = pattern as *ASTVariantPattern;
                let symbols = this.scope_manager.Resolve(variant->path, false);
                if symbols.Empty() { return null; }

                for symbol in symbols {
                    if symbol->kind != SymbolKind::Declaration {
                        continue;
                    }

                    if symbol->declaration->kind == HIRDeclarationKind::EnumerationMember {
                        Logger::Log("Enumeration member '" + variant->path->ToString() + "' has no fields.", pattern, LogSeverity::Error);
                        return null;
                    }

                    if symbol->declaration->kind != HIRDeclarationKind::VariantMember {
                        continue;
                    }

                    let member = symbol->declaration as *HIRVariantMember;

                    if member->structure {
                        Logger::Log("Variant member '" + variant->path->ToString() + "' is a structure.", pattern, LogSeverity::Error);
                        return null;
                    }

                    if value != null && !value->_type->IsSame(member->_type) {
                        Logger::Log("Mismatched pattern type, expected '" + value->_type->ToString() + "' but found '" + member->_type->ToString() + "'.", pattern, LogSeverity::Error);
                        return null;
                    }

                    let mut expanded = Vector<*ASTPattern>();

                    if !this.ExpandRestPatterns(variant->patterns, member->fields.Size(), "Variant member '" + variant->path->ToString() + "'", pattern, expanded) {
                        return null;
                    }

                    for i in 0..expanded.Size() {
                        if expanded[i] == null {
                            patterns.PushBack(this.builder.WildcardPattern());
                            continue;
                        }

                        let field = if value != null { this.builder.MemberAccess(value, member, member->fields[i]) } else { null };
                        let lowered_pattern = this.LowerPattern(expanded[i], null, field, mode);
                        if lowered_pattern == null { return null; }
                        patterns.PushBack(lowered_pattern);
                    }

                    return this.builder.VariantPattern(member, patterns);
                }

                Logger::Log("Symbol '" + variant->path->ToString() + "' is not a variant member.", pattern, LogSeverity::Error);
                null
            },
            ASTPatternKind::Path => {
                let path = (pattern as *ASTPathPattern)->path;
                let symbols = this.scope_manager.Resolve(path, false);
                if symbols.Empty() { return null; }

                for symbol in symbols {
                    if symbol->kind != SymbolKind::Declaration {
                        continue;
                    }

                    match symbol->declaration->kind {
                        HIRDeclarationKind::EnumerationMember => {
                            let member = symbol->declaration as *HIREnumerationMember;

                            if value != null && !value->_type->IsSame(member->_type) {
                                Logger::Log("Mismatched pattern type, expected '" + value->_type->ToString() + "' but found '" + member->_type->ToString() + "'.", pattern, LogSeverity::Error);
                                return null;
                            }

                            return this.builder.EnumerationPattern(member);
                        },
                        HIRDeclarationKind::VariantMember => {
                            let member = symbol->declaration as *HIRVariantMember;

                            if !member->fields.Empty() {
                                Logger::Log("Variant member '" + path->ToString() + "' has fields; use '" + path->ToString() + (if member->structure { " { ... }" } else { "(...)" }) + "' to match it.", pattern, LogSeverity::Error);
                                return null;
                            }

                            if value != null && !value->_type->IsSame(member->_type) {
                                Logger::Log("Mismatched pattern type, expected '" + value->_type->ToString() + "' but found '" + member->_type->ToString() + "'.", pattern, LogSeverity::Error);
                                return null;
                            }

                            return this.builder.VariantPattern(member, Vector<*HIRPattern>());
                        },
                        _ => {}
                    }
                }

                Logger::Log("Symbol '" + path->ToString() + "' is not an enumeration or variant member.", pattern, LogSeverity::Error);
                null
            },
            ASTPatternKind::Or => {
                let mut patterns = Vector<*HIRPattern>();

                for pattern in (pattern as *ASTOrPattern)->patterns {
                    let lowered_pattern = this.LowerPattern(pattern, target_type, value, mode);
                    if lowered_pattern == null { return null; }
                    patterns.PushBack(lowered_pattern);
                }

                this.builder.OrPattern(patterns)
            }
        }
    }

    fn IsPrimitiveTypeName(&mut this, path: *ASTPath) -> bool {
        if path->absolute || path->segments.Size() != 1 || !path->segments[0].types.Empty() {
            return false;
        }

        let name = path->segments[0].name;

        if name == "void" || name == "bool" || name == "char" || name == "isize" || name == "usize" {
            return true;
        } else if name.Length() < 2 || (name[0] != 'i' && name[0] != 'u' && name[0] != 'f') {
            return false;
        }

        for i in 1..name.Length() {
            if name[i] < '0' || name[i] > '9' { return false; }
        }

        true
    }

    fn LowerType(&mut this, path: *ASTPath) -> *HIRType {
        if path == null {
            return this.context.UnitType();
        }

        if this.IsPrimitiveTypeName(path) {
            let name = path->segments[0].name;

            if name == "void" {
                return this.context.VoidType();
            } else if name == "bool" {
                return this.context.BooleanType();
            } else if name == "char" {
                return this.context.CharacterType();
            } else if name.StartsWith('i') || name.StartsWith('u') {
                let specifier = name.SubString(1);
                let signed = name[0] != 'u';

                if specifier == "size" {
                    return this.context.IntegerPointerType(signed);
                } else {
                    let width = specifier.ToUnsignedInteger().Unwrap() as u32;

                    if width != 8 && width != 16 && width != 32 && width != 64 && width != 128 {
                        Logger::Log("Invalid integer type '" + name + "'.", path, LogSeverity::Error);
                        return null;
                    }

                    return this.context.IntegerType(width, signed);
                }
            } else if name.StartsWith('f') {
                let width = name.SubString(1).ToUnsignedInteger().Unwrap() as u32;

                if width != 32 && width != 64 {
                    Logger::Log("Invalid float type '" + name + "'.", path, LogSeverity::Error);
                    return null;
                }

                return this.context.FloatType(width);
            }
        }

        let mut generic = false;
        let symbols = this.scope_manager.ResolveType(path, false);
        if symbols.Empty() { return null; }

        for symbol in symbols {
            match symbol->kind {
                SymbolKind::Type => {
                    return symbol->_type;
                },
                SymbolKind::Generic => {
                    generic = true;
                },
                _ => {}
            }
        }

        if generic {
            Logger::Log("Generic '" + path->ToString() + "' requires type arguments.", path, LogSeverity::Error);
        } else {
            Logger::Log("Symbol '" + path->ToString() + "' cannot be used as a type.", path, LogSeverity::Error);
        }

        null
    }

    pub fn LowerType(&mut this, _type: *ASTType) -> *HIRType {
        let lowered = this.LowerTypeOrVoid(_type);

        if lowered != null && lowered->IsVoid() {
            Logger::Log("Type 'void' can only be used behind a pointer; use '()' for no value.", _type, LogSeverity::Error);
            return null;
        }

        lowered
    }

    fn LowerTypeOrVoid(&mut this, _type: *ASTType) -> *HIRType {
        if _type == null {
            return this.context.UnitType();
        }

        match _type->kind {
            ASTTypeKind::Never => this.context.NeverType(),
            ASTTypeKind::Path => this.LowerType((_type as *ASTPathType)->path),
            ASTTypeKind::Pointer => {
                let pointer = _type as *ASTPointerType;
                let pointee = this.LowerTypeOrVoid(pointer->pointee);
                if pointee == null { return null; }
                this.context.PointerType(pointee, pointer->mutable)
            },
            ASTTypeKind::Reference => {
                let reference = _type as *ASTReferenceType;
                let pointee = this.LowerType(reference->pointee);
                if pointee == null { return null; }
                this.context.ReferenceType(pointee, reference->mutable)
            },
            ASTTypeKind::Array => {
                let array = _type as *ASTArrayType;
                let element = this.LowerType(array->element);
                if element == null { return null; }

                if array->length != null {
                    if element->IsNever() {
                        Logger::Log("Array elements cannot have type '" + element->ToString() + "'.", array->element, LogSeverity::Error);
                        return null;
                    }

                    let length = this.LowerExpression(array->length);
                    if length == null { return null; }

                    if length->kind != HIRExpressionKind::Literal || (length as *HIRLiteral)->kind != HIRLiteralKind::Integer {
                        Logger::Log("Array length must be an integer literal.", array->length, LogSeverity::Error);
                        return null;
                    }

                    this.context.ArrayType(element, (length as *HIRIntegerLiteral)->value as usize)
                } else {
                    this.context.PointerType(element, true)
                }
            },
            ASTTypeKind::Tuple => {
                let mut elements = Vector<*HIRType>();

                for element in (_type as *ASTTupleType)->elements {
                    let lowered_element = this.LowerType(element);
                    if lowered_element == null { return null; }

                    if lowered_element->IsNever() {
                        Logger::Log("Tuple elements cannot have type '" + lowered_element->ToString() + "'.", element, LogSeverity::Error);
                        return null;
                    }

                    elements.PushBack(lowered_element);
                }

                this.context.TupleType(elements)
            },
            ASTTypeKind::Function => {
                let function = _type as *ASTFunctionType;
                let mut parameters = Vector<*HIRType>();

                for parameter in function->parameters {
                    let lowered_parameter = this.LowerType(parameter);
                    if lowered_parameter == null { return null; }
                    parameters.PushBack(lowered_parameter);
                }

                let _return: *HIRType = if function->_return != null { this.LowerType(function->_return) } else { this.context.UnitType() };
                if _return == null { return null; }
                this.context.FunctionType(parameters, _return)
            }
        }
    }
}

static mut hir_lowerer: *mut HIRLowerer = null;
