enum HIRLoweringPass: u8 {
    None, First, Second, Third, Fourth
}

#[include "std/str", "std/vec", "std/map", "std/pair", "std/arena",
    "src/ScopeManager.zir", "src/Scope.zir", "src/Symbol.zir", "src/Generic.zir",
        "src/Token.zir", "src/AST.zir", "src/HIR.zir", "src/Logger.zir" : *]

class HIRLowerer {
    context: HIRContext,
    pub module: *mut HIRModule = null,
    pub builder: HIRBuilder,
    pub extension_registry: HIRExtensionRegistry,
    pub scope_manager: ScopeManager,

    pub current_pass: HIRLoweringPass = HIRLoweringPass::None,
    class_data: Map<*ASTNode, Pair<*mut HIRClassDeclaration, *mut Scope>>,
    structure_data: Map<*ASTNode, Pair<*mut HIRStructureDeclaration, *mut Scope>>,
    extend_data: Map<*ASTNode, Pair<*mut HIRExtendDeclaration, *mut Scope>>,
    function_data: Map<*ASTNode, *mut HIRFunctionDeclaration>,

    temporaries: Vector<*HIRExpression>,
    loop_scopes: Vector<*mut Scope>,

    pub abi: HIRDeclarationABI = HIRDeclarationABI::Native,
    pub linkage: HIRDeclarationLinkage = HIRDeclarationLinkage::Internal,
    pub _unsafe: bool = false,

    pub generics: Vector<*mut GenericDeclaration>,
    pub current_generic: *mut GenericDeclaration = null,
    pub current_type: *HIRType = null;

    HIRLowerer(&mut this) {
        if hir_lowerer != null {
            Logger::Log("Another instance of 'HIRLowerer' already exists!", LogSeverity::Fatal);
        } hir_lowerer = this;
    }

    ~HIRLowerer(&mut this) {
        hir_lowerer = null;
    }

    pub fn Lower(&mut this, module: *ASTModule) -> *HIRModule {
        this.module = this.context.arena.New<HIRModule>();
        this.builder = HIRBuilder(&mut this.context, this.module);
        let mut declared = Map<*ASTNode, bool>();

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::First;
            declared[declaration] = this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Second;
            declared[declaration] |= this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Third;
            declared[declaration] |= this.LowerDeclarationThirdPass(declaration);
        }

        for generic in this.generics {
            generic->LowerInstances();
        }

        for declaration in module->declarations {
            this.current_pass = HIRLoweringPass::Fourth;
            declared[declaration] |= this.LowerDeclarationFourthPass(declaration);

            if !declared[declaration] {
                Logger::Log("Unknown declaration '" + declaration->kind.ToString() + "'.", declaration, LogSeverity::Error);
            }
        }

        for generic in this.generics {
            generic->LowerInstances();
        }

        this.class_data.Clear();
        this.structure_data.Clear();
        this.extend_data.Clear();
        this.function_data.Clear();
        return this.module;
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *ASTDeclaration) -> bool {
        if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;
            let pair = this.LowerClassDeclarationFirstPass(_class, null);

            if !_class->generic && pair.left != null && pair.right != null {
                this.class_data[declaration] = pair;
            }
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;
            let pair = this.LowerStructureDeclarationFirstPass(structure, null);

            if !structure->generic && pair.left != null && pair.right != null {
                this.structure_data[declaration] = pair;
            }
        } else {
            return false;
        } return true;
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *ASTDeclaration) -> bool {
        if declaration->kind == ASTDeclarationKind::Constant {
            this.LowerConstantDeclaration(declaration as *ASTConstantDeclaration);
        } else if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;

            if !_class->generic {
                let cache = this.class_data[declaration];
                this.LowerClassDeclarationSecondPass(cache.left, _class, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;

            if !structure->generic {
                let cache = this.structure_data[declaration];
                this.LowerStructureDeclarationSecondPass(cache.left, structure, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Enumeration {
            this.LowerEnumerationDeclaration(declaration as *ASTEnumerationDeclaration);
        } else if declaration->kind == ASTDeclarationKind::Type {
            this.LowerTypeDeclaration(declaration as *ASTTypeDeclaration);
        } else {
            return false;
        } return true;
    }

    fn LowerTypeDeclaration(&mut this, type_definition: *ASTTypeDeclaration) {
        this.scope_manager.current->Set(type_definition->name, this.LowerType(type_definition->_type), type_definition);
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *ASTDeclaration) -> bool {
        if declaration->kind == ASTDeclarationKind::Static {
            this.LowerStaticDeclaration(declaration as *ASTStaticDeclaration);
        } else if declaration->kind == ASTDeclarationKind::Function {
            let function = declaration as *ASTFunctionDeclaration;
            let data = this.LowerFunctionDeclarationFirstPass(function, null);

            if !function->generic && function->pack_name.Empty() && data != null {
                this.module->declarations.PushBack(data);
                this.function_data[declaration] = data;
            }
        } else if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;

            if !_class->generic {
                let cache = this.class_data[declaration];
                this.LowerClassDeclarationThirdPass(cache.left, _class, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;

            if !structure->generic {
                let cache = this.structure_data[declaration];
                this.LowerStructureDeclarationThirdPass(cache.left, structure, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Extend {
            let pair = this.LowerExtendDeclarationFirstPass(declaration as *ASTExtendDeclaration);

            if pair.left != null && pair.right != null {
                this.extend_data[declaration] = pair;
            }
        } else if declaration->kind == ASTDeclarationKind::Extern {
            this.LowerExternDeclarationFirstPass(declaration as *ASTExternDeclaration);
        } else if declaration->kind == ASTDeclarationKind::Assembly {
            this.LowerAssemblyDeclaration(declaration as *ASTAssemblyDeclaration);
        } else {
            return false;
        } return true;
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *ASTDeclaration) -> bool {
        if declaration->kind == ASTDeclarationKind::Function {
            let function = declaration as *ASTFunctionDeclaration;

            if !function->generic && function->pack_name.Empty() {
                this.LowerFunctionDeclarationSecondPass(this.function_data[declaration], function);
            }
        } else if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;

            if !_class->generic {
                let cache = this.class_data[declaration];
                this.LowerClassDeclarationFourthPass(cache.left, _class, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;

            if !structure->generic {
                let cache = this.structure_data[declaration];
                this.LowerStructureDeclarationFourthPass(cache.left, structure, cache.right);
            }
        } else if declaration->kind == ASTDeclarationKind::Extend {
            let cache = this.extend_data[declaration];
            this.LowerExtendDeclarationSecondPass(cache.left, declaration as *ASTExtendDeclaration, cache.right);
        } else if declaration->kind == ASTDeclarationKind::Extern {
            this.LowerExternDeclarationSecondPass(declaration as *ASTExternDeclaration);
        } else {
            return false;
        } return true;
    }

    pub fn Coerce(&mut this, _expression: *HIRExpression, target: *HIRType) -> *HIRExpression {
        unsafe {
            let expression = _expression as *mut HIRExpression;
        }

        if expression == null {
            return expression;
        } else if expression->kind == HIRExpressionKind::Deferred {
            return this.Coerce(this.LowerExpression((expression as *HIRDeferredExpression)->expression, target), target);
        }

        if expression->_type->IsInteger() && expression->_type->IsLiteral() && target->IsPointer() {
            if !(target->IsReference() && target->Pointee().IsInteger()) {
                expression->_type = this.context.IntegerPointerType(false);
            }
        }

        if expression->_type->IsLiteral() {
            if expression->_type->IsInteger() {
                if !target->IsInteger() || target->IsLiteral() {
                    expression->_type = this.context.IntegerType(32, true);
                } else {
                    expression->_type = target;
                }
            } else if !target->IsFloat() || target->IsLiteral() {
                expression->_type = this.context.FloatType(64);
            } else {
                expression->_type = target;
            }
        } return expression;
    }

    fn Coerce(&mut this, _expression: *HIRExpression) -> *HIRExpression {
        unsafe {
            let expression = _expression as *mut HIRExpression;
        }

        if expression != null {
            if expression->kind == HIRExpressionKind::Deferred {
                return this.Coerce(this.LowerExpression((expression as *HIRDeferredExpression)->expression, null));
            } else if expression->_type->IsLiteral() {
                if expression->_type->IsInteger() {
                    expression->_type = this.context.IntegerType(32, true);
                } else {
                    expression->_type = this.context.FloatType(64);
                }
            }
        } return expression;
    }

    fn ImplicitDereference(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null && expression->_type->IsReference() {
            return this.builder.Dereference(expression);
        } return expression;
    }

    fn ImplicitAddressOf(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null && (expression->category == HIRExpressionCategory::Place || expression->_type->HasFields()) {
            return this.builder.AddressOf(expression, expression->category == HIRExpressionCategory::Place ? expression->mutable : true);
        } return expression;
    }

    fn MakeCompatible(&mut this, expression: *HIRExpression, target: *HIRType) -> *HIRExpression {
        if target->IsPointer() && expression->_type->IsPointer() {
            if target->Pointee().IsClass() && expression->_type->Pointee().IsClass() {
                if expression->_type->Pointee().IsDerivedFrom(target->Pointee()) {
                    return this.builder.Cast(expression, target);
                }
            }
        } return expression;
    }

    fn LowerConstantDeclaration(&mut this, constant: *ASTConstantDeclaration) {
        let mut initializer: *HIRExpression = null;
        let _type = this.LowerType(constant->_type);
        if _type == null { return; }

        if constant->initializer != null {
            initializer = this.Coerce(this.LowerExpression(constant->initializer), _type);
        }

        let declaration = this.builder.BuildConstantDeclaration(constant->name, _type, initializer);
        this.scope_manager.current->Set(constant->name, declaration, false, constant);
    }

    fn LowerStaticDeclaration(&mut this, _static: *ASTStaticDeclaration) {
        let mut initializer: *HIRExpression = null;
        let _type = this.LowerType(_static->_type);
        if _type == null { return; }

        if _static->initializer != null && !_static->zero_initializer {
            initializer = this.Coerce(this.LowerExpression(_static->initializer), _type);
        }

        let mut alignment: *HIRExpression = null;

        if _static->alignment != null {
            alignment = this.Coerce(this.LowerExpression(_static->alignment), this.context.IntegerPointerType(false));
            if alignment == null { return; }

            if !alignment->_type->IsIntegerPointer() || alignment->_type->IsSigned() {
                Logger::Log("Static alignment must be of type 'usize'.", _static, LogSeverity::Error);
                return;
            }
        }

        let declaration = this.builder.BuildStaticDeclaration(_static->name, _type, initializer, alignment, _static->mutable, this.linkage);
        this.scope_manager.current->Set(_static->name, declaration, false, _static);
    }

    pub fn LowerFunctionDeclarationFirstPass(&mut this, function: *ASTFunctionDeclaration, instance: *mut GenericInstance) -> *mut HIRFunctionDeclaration {
        if (function->generic || !function->pack_name.Empty()) && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(function);
            this.scope_manager.current->Set(function->name, generic, function);
            this.generics.PushBack(generic);
            return null;
        }

        if (this.current_type == null || !this.current_type->IsClass()) && !function->constructors.Empty() {
            Logger::Log("Constructors can only be declared inside classes.", function, LogSeverity::Error);
            return null;
        }

        let mut parameter_types = Vector<*HIRType>();
        let mut parameters = Vector<*HIRParameterDeclaration>();

        if function->instance_kind != ASTInstanceKind::None {
            if this.current_type == null {
                Logger::Log("Recievers are only allowed in methods.", function, LogSeverity::Error);
                return null;
            }

            let mut _type = this.current_type;

            if function->instance_kind != ASTInstanceKind::Copy {
                _type = this.context.ReferenceType(this.current_type, function->instance_kind == ASTInstanceKind::MutRef);
            }

            parameters.PushBack(this.builder.BuildParameterDeclaration("this".ToString(), _type, false));
            parameter_types.PushBack(_type);
        }

        for parameter in function->parameters {
            let _type = this.LowerType(parameter->_type);
            if _type == null { return null; }
            parameters.PushBack(this.builder.BuildParameterDeclaration(parameter->name, _type, parameter->mutable));
            parameter_types.PushBack(_type);
        }

        if !function->pack_name.Empty() {
            let start = function->types.Size();

            for i in start..instance->types.Size() {
                let _type: *HIRType = instance->types[i];
                let name = function->pack_name + String::FromInteger((i - start) as u64);
                parameters.PushBack(this.builder.BuildParameterDeclaration(name, _type, false));
                parameter_types.PushBack(_type);
            }
        }

        let _return = this.LowerType(function->_return);
        if _return == null { return null; }
        let declaration = this.builder.BuildFunctionDeclaration(function->name, parameters, _return, this.context.FunctionType(parameter_types, _return), function->no_mangle, function->public, this.abi);

        if instance == null {
            this.scope_manager.current->Set(function->name, declaration, this.abi == HIRDeclarationABI::Native && !function->no_mangle, function);
        } return declaration;
    }

    pub fn LowerFunctionDeclarationSecondPass(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->IsClass() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        declaration->body = this.LowerBlockStatement(function->body);
        this.scope_manager.PopScope();
    }

    pub fn LowerClassDeclarationFirstPass(&mut this, _class: *ASTClassDeclaration, instance: *mut GenericInstance) -> Pair<*mut HIRClassDeclaration, *mut Scope> {
        if _class->generic && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(_class);
            this.scope_manager.current->Set(_class->name, generic, _class);
            this.generics.PushBack(generic);
            return Pair<*mut HIRClassDeclaration, *mut Scope>(null, null);
        }

        let mut scope: *mut Scope = null;
        let _type = this.context.ClassType(null);
        let declaration = this.builder.BuildClassDeclaration(_class->name, _type);
        _type->declaration = declaration;

        if instance == null {
            this.scope_manager.current->Set(_class->name, _type, _class);
            this.scope_manager.PushScope(_class->name, true);
            scope = this.scope_manager.current;
            this.scope_manager.PopScope();
        }

        return Pair<*mut HIRClassDeclaration, *mut Scope>(declaration, scope);
    }

    pub fn LowerClassDeclarationSecondPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for parent in _class->parents {
            let parent_type = this.LowerType(parent);
            if parent_type == null { continue; }
            declaration->parents.PushBack(parent_type);
        }

        for field in _class->fields {
            let field_type = this.LowerType(field->_type);
            if field_type == null { continue; }
            let index = declaration->parents.Size() + declaration->fields.Size();
            declaration->fields.PushBack(this.builder.BuildFieldDeclaration(field->name, field_type, index, field->initializer, field->public));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerImplicitDeclaration(&mut this, name: String, _type: *HIRType, _return: *HIRType, other: bool, _class: *ASTClassDeclaration) -> *mut HIRFunctionDeclaration {
        let mut parameter_types = Vector<*HIRType>();
        let mut parameters = Vector<*HIRParameterDeclaration>();

        let this_type = this.context.ReferenceType(_type, true);
        parameters.PushBack(this.builder.BuildParameterDeclaration("this".ToString(), this_type, false));
        parameter_types.PushBack(this_type);

        if other {
            let other_type = this.context.ReferenceType(_type, false);
            parameters.PushBack(this.builder.BuildParameterDeclaration("other".ToString(), other_type, false));
            parameter_types.PushBack(other_type);
        }

        let function = this.builder.BuildFunctionDeclaration(name, parameters, _return, this.context.FunctionType(parameter_types, _return), false, true, HIRDeclarationABI::Native);
        this.scope_manager.current->Set(name, function, true, _class);
        return function;
    }

    pub fn LowerClassDeclarationThirdPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (mut has_copy_constructor, mut has_copy_assign) = (false, false);
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for constructor in _class->constructors {
            let function = this.LowerFunctionDeclarationFirstPass(constructor, null);

            if function != null {
                declaration->constructors.PushBack(function);

                if function->parameters.Size() == 2 {
                    let parameter: *HIRParameterDeclaration = function->parameters[1];

                    if *parameter->_type == *this.context.ReferenceType(declaration->_type, false) {
                        has_copy_constructor = true;
                    }
                }
            }
        }

        if _class->constructors.Empty() {
            declaration->constructors.PushBack(this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.VoidType(), false, _class));
        }

        if !has_copy_constructor {
            declaration->constructors.PushBack(this.LowerImplicitDeclaration(declaration->name, declaration->_type, this.context.VoidType(), true, _class));
        }

        if _class->destructor != null {
            let function = this.LowerFunctionDeclarationFirstPass(_class->destructor, null);

            if function != null {
                declaration->destructor = function;
            }
        } else {
            declaration->destructor = this.LowerImplicitDeclaration('~' + declaration->name, declaration->_type, this.context.VoidType(), false, _class);
        }

        for method in _class->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);

                if method->name == "operator=" && function->parameters.Size() == 2 {
                    let parameter: *HIRParameterDeclaration = function->parameters[1];

                    if *parameter->_type == *this.context.ReferenceType(declaration->_type, false) {
                        if *function->_return == *this.context.ReferenceType(declaration->_type, false) {
                            has_copy_assign = true;
                        }
                    }
                }
            }
        }

        if !has_copy_assign {
            declaration->methods.PushBack(this.LowerImplicitDeclaration("operator=".ToString(), declaration->_type, this.context.ReferenceType(declaration->_type, false), true, _class));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerFieldConstructors(&mut this, this_dereferenced: *HIRExpression, fields: &Vector<*HIRFieldDeclaration>) {
        for field in fields {
            let this_field = this.builder.FieldAccess(this_dereferenced, field);

            if field->_type->IsClass() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.ImplicitAddressOf(this_field));
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (field->_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, null, false);
                if function == null { continue; }
                let call = this.LowerResolvedCallExpression(function, values, null);
                if call == null { continue; }
                this.builder.BuildExpressionStatement(call);
            } else if field->initializer != null {
                let initializer = this.Coerce(this.LowerExpression(field->initializer), field->_type);

                if initializer != null {
                    this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, initializer));
                }
            }
        }
    }

    pub fn LowerConstructorDeclaration(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration, parents: &Vector<*HIRType>, fields: &Vector<*HIRFieldDeclaration>) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->IsClass() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        let block = this.builder.BuildBlockStatement();
        this.builder.SetCurrentBlock(block);
        declaration->body = block;

        let this_parameter: *HIRParameterDeclaration = declaration->parameters[0];
        let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
        let this_dereferenced = this.builder.Dereference(this_reference);

        for constructor in function->constructors {
            let _type = this.LowerType((constructor->expression as *ASTPathExpression)->path);
            if _type == null { continue; }

            if !_type->IsClass() {
                Logger::Log("Constructor target must be a class.", constructor, LogSeverity::Error);
                continue;
            }

            for parent in parents {
                if *parent != *_type { continue; }
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.builder.Cast(this_reference, this.context.ReferenceType(parent, true)));

                let mut invalid = false;
                values += this.LowerCallArguments(constructor->arguments, constructor, &mut invalid);
                if invalid { break; }

                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, null, false);
                if function == null { break; }
                let call = this.LowerResolvedCallExpression(function, values, null);
                if call == null { break; }
                this.builder.BuildExpressionStatement(call);
                break;
            }
        }

        this.LowerFieldConstructors(this_dereferenced, fields);

        for statement in function->body->statements {
            this.LowerStatement(statement);
        }

        this.BuildDestructors(this.scope_manager.current, null);
        this.scope_manager.PopScope();
    }

    pub fn LowerFieldDestructors(&mut this, this_dereferenced: *HIRExpression, fields: &Vector<*HIRFieldDeclaration>) {
        for field in fields {
            let this_field = this.builder.FieldAccess(this_dereferenced, field);

            if field->_type->IsClass() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.ImplicitAddressOf(this_field));
                let function = (field->_type as *HIRClassType)->declaration->destructor;
                let call = this.LowerResolvedCallExpression(function, values, null);
                if call == null { continue; }
                this.builder.BuildExpressionStatement(call);
            }
        }
    }

    pub fn LowerDestructorDeclaration(&mut this, declaration: *mut HIRFunctionDeclaration, function: *ASTFunctionDeclaration, fields: &Vector<*HIRFieldDeclaration>) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(declaration);
        this.scope_manager.PushScope(function->name, false);

        let this_parameter: *HIRParameterDeclaration = declaration->parameters[0];
        let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
        let this_dereferenced = this.builder.Dereference(this_reference);

        for field in fields {
            let this_field = this.builder.FieldAccess(this_dereferenced, field);

            if field->_type->IsClass() {
                this.scope_manager.current->instances.PushBack(this_field);
            }
        }

        for parameter in declaration->parameters {
            this.scope_manager.current->Set(parameter->name, parameter, false, function);

            if parameter->_type->IsClass() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceDeclaration(parameter, false));
            }
        }

        let block = this.builder.BuildBlockStatement();
        this.builder.SetCurrentBlock(block);
        declaration->body = block;

        for statement in function->body->statements {
            this.LowerStatement(statement);
        }

        this.BuildDestructors(this.scope_manager.current, null);
        this.scope_manager.PopScope();
    }

    pub fn LowerClassDeclarationFourthPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ASTClassDeclaration, scope: *mut Scope) {
        let (mut has_copy_constructor, mut has_copy_assign) = (false, false);
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let parents = (declaration->_type as *HIRClassType)->declaration->parents;
        let fields = (declaration->_type as *HIRClassType)->declaration->fields;

        for i in 0.._class->constructors.Size() {
            let function: *mut HIRFunctionDeclaration = declaration->constructors[i];
            this.LowerConstructorDeclaration(function, _class->constructors[i], parents, fields);

            if function->parameters.Size() == 2 {
                let parameter: *HIRParameterDeclaration = function->parameters[1];

                if *parameter->_type == *this.context.ReferenceType(declaration->_type, false) {
                    has_copy_constructor = true;
                }
            }
        }

        if _class->constructors.Empty() {
            let index = declaration->constructors.Size() - (has_copy_constructor ? 1 : 2);
            let function: *mut HIRFunctionDeclaration = declaration->constructors[index];
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.BuildBlockStatement();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter: *HIRParameterDeclaration = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);
            this.LowerFieldConstructors(this_dereferenced, fields);
            this.scope_manager.PopScope();
        }

        if !has_copy_constructor {
            let function: *mut HIRFunctionDeclaration = declaration->constructors.Back();
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.BuildBlockStatement();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter: *HIRParameterDeclaration = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter: *HIRParameterDeclaration = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in fields {
                let this_field = this.builder.FieldAccess(this_dereferenced, field);
                let other_field = this.builder.FieldAccess(other_dereferenced, field);

                if field->_type->IsClass() {
                    let mut values = Vector<*HIRExpression>();
                    values.PushBack(this.ImplicitAddressOf(this_field));
                    values.PushBack(this.ImplicitAddressOf(other_field));
                    let mut candidates = Vector<*HIRFunctionDeclaration>();

                    for candidate in (field->_type as *HIRClassType)->declaration->constructors {
                        candidates.PushBack(candidate);
                    }

                    let function = this.ResolveOverload(candidates, values, _class, false);
                    if function == null { continue; }
                    let call = this.LowerResolvedCallExpression(function, values, _class);
                    if call == null { continue; }
                    this.builder.BuildExpressionStatement(call);
                } else {
                    this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, other_field));
                }
            }

            this.scope_manager.PopScope();
        }

        if _class->destructor != null {
            this.LowerDestructorDeclaration(declaration->destructor, _class->destructor, fields);
        } else {
            let function = declaration->destructor;
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.BuildBlockStatement();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter: *HIRParameterDeclaration = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);
            this.LowerFieldDestructors(this_dereferenced, fields);
            this.scope_manager.PopScope();
        }

        let mut index: usize = 0;

        for method in _class->methods {
            if method->generic || !method->pack_name.Empty() { continue; }
            let function: *mut HIRFunctionDeclaration = declaration->methods[index];
            this.LowerFunctionDeclarationSecondPass(function, method);
            index += 1;

            if method->name == "operator=" && function->parameters.Size() == 2 {
                let parameter: *HIRParameterDeclaration = function->parameters[1];

                if *parameter->_type == *this.context.ReferenceType(declaration->_type, false) {
                    if *function->_return == *this.context.ReferenceType(declaration->_type, false) {
                        has_copy_assign = true;
                    }
                }
            }
        }

        if !has_copy_assign {
            let function: *mut HIRFunctionDeclaration = declaration->methods.Back();
            this.scope_manager.PushScope(function->name, false);
            this.builder.SetCurrentFunction(function);
            let block = this.builder.BuildBlockStatement();
            this.builder.SetCurrentBlock(block);
            function->body = block;

            let this_parameter: *HIRParameterDeclaration = function->parameters[0];
            let this_reference = this.builder.ReferenceDeclaration(this_parameter, false);
            let this_dereferenced = this.builder.Dereference(this_reference);

            let other_parameter: *HIRParameterDeclaration = function->parameters[1];
            let other_reference = this.builder.ReferenceDeclaration(other_parameter, false);
            let other_dereferenced = this.builder.Dereference(other_reference);

            for field in fields {
                let this_field = this.builder.FieldAccess(this_dereferenced, field);
                let other_field = this.builder.FieldAccess(other_dereferenced, field);

                if field->_type->IsClass() {
                    let mut values = Vector<*HIRExpression>();
                    values.PushBack(this.ImplicitAddressOf(this_field));
                    values.PushBack(this.ImplicitAddressOf(other_field));
                    let candidates = field->_type->GetCandidates("operator=".ToString(), _class, false);
                    if candidates.Empty() { continue; }
                    let function = this.ResolveOverload(candidates, values, _class, false);
                    if function == null { continue; }
                    let call = this.LowerResolvedCallExpression(function, values, _class);
                    if call == null { continue; }
                    this.builder.BuildExpressionStatement(call);
                } else {
                    this.builder.BuildExpressionStatement(this.builder.Assignment(this_field, other_field));
                }
            }

            this.builder.BuildReturnStatement(this_reference, Vector<*HIRExpression>());
            this.scope_manager.PopScope();
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationFirstPass(&mut this, structure: *ASTStructureDeclaration, instance: *mut GenericInstance) -> Pair<*mut HIRStructureDeclaration, *mut Scope> {
        if structure->generic && instance == null {
            let generic = this.context.arena.New<GenericDeclaration>(structure);
            this.scope_manager.current->Set(structure->name, generic, structure);
            this.generics.PushBack(generic);
            return Pair<*mut HIRStructureDeclaration, *mut Scope>(null, null);
        }

        let mut scope: *mut Scope = null;
        let _type = this.context.StructureType(null);
        let declaration = this.builder.BuildStructureDeclaration(structure->name, _type);
        _type->declaration = declaration;

        if instance == null {
            this.scope_manager.current->Set(structure->name, _type, structure);
            this.scope_manager.PushScope(structure->name, true);
            scope = this.scope_manager.current;
            this.scope_manager.PopScope();
        }

        return Pair<*mut HIRStructureDeclaration, *mut Scope>(declaration, scope);
    }

    pub fn LowerStructureDeclarationSecondPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for field in structure->fields {
            let field_type = this.LowerType(field->_type);
            if field_type == null { continue; }
            declaration->fields.PushBack(this.builder.BuildFieldDeclaration(field->name, field_type, declaration->fields.Size(), field->initializer, field->public));
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationThirdPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for method in structure->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);
            }
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    pub fn LowerStructureDeclarationFourthPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *ASTStructureDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);
        let mut index: usize = 0;

        for method in structure->methods {
            if method->generic || !method->pack_name.Empty() { continue; }
            this.LowerFunctionDeclarationSecondPass(declaration->methods[index], method);
            index += 1;
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerEnumerationDeclaration(&mut this, enumeration: *ASTEnumerationDeclaration) {
        let underlying_type = this.LowerType(enumeration->underlying_type);
        if underlying_type == null { return; }

        if !underlying_type->IsInteger() {
            Logger::Log("Expected an integer type.", enumeration, LogSeverity::Error);
            return;
        }

        let _type = this.context.EnumerationType(null, underlying_type as *HIRIntegerType);
        let declaration = this.builder.BuildEnumerationDeclaration(enumeration->name, _type);
        _type->declaration = declaration;

        let mut value: *HIRExpression = this.builder.IntegerLiteral(0, _type);
        this.scope_manager.current->Set(enumeration->name, _type, enumeration);
        this.scope_manager.PushScope(enumeration->name, true);

        for member in enumeration->members {
            if member->value != null {
                value = this.Coerce(this.LowerExpression(member->value), underlying_type);
                if value == null { continue; }

                if underlying_type->IsSame(value->_type) {
                    value = this.builder.Cast(value, _type);
                }

                if !_type->IsCompatible(value->_type) {
                    Logger::Log("Expected an expression of type '" + underlying_type->ToString() + "'.", member->value, LogSeverity::Error);
                    continue;
                }
            }

            let member_declaration = this.builder.BuildMemberDeclaration(member->name, value, _type);
            value = this.builder.Binary(HIRBinaryKind::Add, value, this.builder.IntegerLiteral(1, _type), _type);
            this.scope_manager.current->Set(member->name, member_declaration, false, enumeration);
            declaration->members.PushBack(member_declaration);
        }

        this.scope_manager.PopScope();
    }

    fn LowerExtendDeclarationFirstPass(&mut this, _extend: *ASTExtendDeclaration) -> Pair<*mut HIRExtendDeclaration, *mut Scope> {
        let _type = this.LowerType(_extend->_type);
        let declaration = this.builder.BuildExtendDeclaration(_type);
        this.extension_registry.Register(declaration);
        this.scope_manager.PushScope(_type->ToString(), true);
        let scope = this.scope_manager.current;
        let previous_type = this.current_type;
        this.current_type = _type;

        for method in _extend->methods {
            let function = this.LowerFunctionDeclarationFirstPass(method, null);

            if function != null {
                declaration->methods.PushBack(function);
            }
        }

        this.current_type = previous_type;
        this.scope_manager.PopScope();
        return Pair<*mut HIRExtendDeclaration, *mut Scope>(declaration, scope);
    }

    fn LowerExtendDeclarationSecondPass(&mut this, declaration: *mut HIRExtendDeclaration, _extend: *ASTExtendDeclaration, scope: *mut Scope) {
        let (previous_type, previous_scope) = (this.current_type, this.scope_manager.current);
        (this.current_type, this.scope_manager.current) = (declaration->_type, scope);

        for i in 0.._extend->methods.Size() {
            this.LowerFunctionDeclarationSecondPass(declaration->methods[i], _extend->methods[i]);
        }

        (this.current_type, this.scope_manager.current) = (previous_type, previous_scope);
    }

    fn LowerExternDeclarationFirstPass(&mut this, _extern: *ASTExternDeclaration) {
        if this.abi != HIRDeclarationABI::Native {
            Logger::Log("Already in an extern block.", _extern, LogSeverity::Error);
            return;
        }

        if _extern->linkage != "C" {
            Logger::Log("Unknown linkage '" + _extern->linkage + "'.", _extern, LogSeverity::Error);
            return;
        }

        let (previous_abi, previous_linkage) = (this.abi, this.linkage);
        (this.abi, this.linkage) = (HIRDeclarationABI::C, HIRDeclarationLinkage::External);

        for declaration in _extern->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        (this.abi, this.linkage) = (previous_abi, previous_linkage);
    }

    fn LowerExternDeclarationSecondPass(&mut this, _extern: *ASTExternDeclaration) {
        let (previous_abi, previous_linkage) = (this.abi, this.linkage);
        (this.abi, this.linkage) = (HIRDeclarationABI::C, HIRDeclarationLinkage::External);

        for declaration in _extern->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }

        (this.abi, this.linkage) = (previous_abi, previous_linkage);
    }

    fn LowerAssemblyDeclaration(&mut this, assembly: *ASTAssemblyDeclaration) {}

    fn LowerStatement(&mut this, statement: *ASTStatement) {
        if statement->kind == ASTStatementKind::Return {
            this.LowerReturnStatement(statement as *ASTReturnStatement);
        } else if statement->kind == ASTStatementKind::Expression {
            let expression = (statement as *ASTExpressionStatement)->expression;

            if expression->kind == ASTExpressionKind::Assignment {
                let mut assignment = expression as *ASTAssignmentExpression;

                while assignment != null {
                    let expression = this.LowerAssignmentExpression(assignment);

                    if expression != null {
                        this.builder.BuildExpressionStatement(expression);
                    }

                    this.BuildTemporaryDestructors(null);
                    assignment = assignment->next;
                }
            } else {
                let expression = this.LowerExpression(expression);

                if expression != null {
                    this.builder.BuildExpressionStatement(expression);
                } this.BuildTemporaryDestructors(null);
            }
        } else if statement->kind == ASTStatementKind::If {
            this.LowerIfStatement(statement as *ASTIfStatement);
        } else if statement->kind == ASTStatementKind::While {
            this.LowerWhileStatement(statement as *ASTWhileStatement);
        } else if statement->kind == ASTStatementKind::For {
            this.LowerForStatement(statement as *ASTForStatement);
        } else if statement->kind == ASTStatementKind::Loop {
            this.LowerLoopStatement(statement as *ASTLoopStatement);
        } else if statement->kind == ASTStatementKind::Unsafe {
            this.LowerUnsafeStatement(statement as *ASTUnsafeStatement);
        } else if statement->kind == ASTStatementKind::Block {
            this.LowerBlockStatement(statement as *ASTBlockStatement);
        } else if statement->kind == ASTStatementKind::Continue {
            this.LowerContinueStatement(statement as *ASTContinueStatement);
        } else if statement->kind == ASTStatementKind::Break {
            this.LowerBreakStatement(statement as *ASTBreakStatement);
        } else if statement->kind == ASTStatementKind::Variable {
            this.LowerVariableStatement(statement as *ASTVariableStatement);
        } else if statement->kind == ASTStatementKind::Assembly {
            this.LowerAssemblyStatement(statement as *ASTAssemblyStatement);
        } else {
            Logger::Log("Unknown statement '" + statement->kind.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    fn LowerReturnStatement(&mut this, _return: *ASTReturnStatement) {
        let mut value: *HIRExpression = null;

        if _return->expression != null {
            let function = this.builder.GetCurrentFunction();
            let return_type = function->_return;
            value = this.Coerce(this.LowerExpression(_return->expression), return_type);
            if value == null { return; }

            if return_type->IsReference() && return_type->Pointee().IsCompatible(value->_type) {
                value = this.ImplicitAddressOf(value);
            }

            if value->_type->IsReference() && return_type->IsCompatible(value->_type->Pointee()) {
                value = this.ImplicitDereference(value);
            }

            if value->_type->IsClass() && value->category == HIRExpressionCategory::Place {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.ImplicitAddressOf(value));
                let arguments = Vector<*HIRExpression>(values);
                values.Insert(0, this.builder.NullLiteral());
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (value->_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, _return->expression, false);
                if function == null { return; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                value = this.builder.Constructor(callee, arguments, value->_type);
            }

            if !return_type->IsCompatible(value->_type) {
                Logger::Log("Incompatible return types. ('" + return_type->ToString() + "' != '" + value->_type->ToString() + "').", _return->expression, LogSeverity::Error);
                return;
            }

            if !return_type->IsMutabilityCompatible(value->_type) {
                Logger::Log("Cannot assign immutable pointer to mutable pointer.", _return->expression, LogSeverity::Error);
                return;
            }

            value = this.MakeCompatible(value, return_type);
        }

        let mut destructors = this.GetTemporaryDestructors(value);
        destructors += this.GetDestructors(null, value);
        this.builder.BuildReturnStatement(value, destructors);
    }

    fn LowerIfStatement(&mut this, _if: *ASTIfStatement) {
        let condition = this.ImplicitDereference(this.LowerExpression(_if->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", _if->condition, LogSeverity::Error);
        }

        let destructors = this.GetTemporaryDestructors(condition);

        this.scope_manager.PushScope("<then>".ToString(), false);
        let (then_body, mut else_body: *HIRBlockStatement) = (this.LowerBlockStatement(_if->body), null);
        this.scope_manager.PopScope();

        if _if->_else != null {
            this.scope_manager.PushScope("<else>".ToString(), false);

            if _if->_else->kind == ASTStatementKind::Block {
                else_body = this.LowerBlockStatement(_if->_else as *ASTBlockStatement);
            } else {
                let prev_block = this.builder.GetCurrentBlock();
                let else_block = this.builder.BuildBlockStatement();
                this.builder.SetCurrentBlock(else_block);
                this.LowerStatement(_if->_else);
                this.builder.SetCurrentBlock(prev_block);
                else_body = else_block;
            }

            this.scope_manager.PopScope();
        }

        this.builder.BuildIfStatement(condition, destructors, then_body, else_body);
    }

    fn LowerWhileStatement(&mut this, _while: *ASTWhileStatement) {
        let condition = this.ImplicitDereference(this.LowerExpression(_while->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", _while->condition, LogSeverity::Error);
        }

        let destructors = this.GetTemporaryDestructors(condition);

        this.scope_manager.PushScope("<while>".ToString(), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        let (while_body, mut else_body: *HIRBlockStatement) = (this.LowerBlockStatement(_while->body), null);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        if _while->_else != null {
            this.scope_manager.PushScope("<else>".ToString(), false);
            else_body = this.LowerBlockStatement(_while->_else);
            this.scope_manager.PopScope();
        }

        this.builder.BuildWhileStatement(condition, destructors, while_body, else_body);
    }

    fn LowerForStatement(&mut this, _for: *ASTForStatement) {
        let (mut start: *HIRExpression, mut end: *HIRExpression);
        let (mut is_range, mut inclusive) = (false, false);
        let temporary_index = this.temporaries.Size();

        if _for->iterable->kind == ASTExpressionKind::Range {
            let range = _for->iterable as *ASTRangeExpression;
            (is_range, inclusive) = (true, range->inclusive);
            start = this.LowerExpression(range->start);
            end = this.LowerExpression(range->end);
            if start == null || end == null { return; }
            start = this.Coerce(start, end->_type);
            end = this.Coerce(end, start->_type);
        } else {
            let iterable = this.ImplicitDereference(this.LowerExpression(_for->iterable));
            if iterable == null { return; }

            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(iterable));
            let mut begin_function: *HIRFunctionDeclaration = null;
            let mut end_function: *HIRFunctionDeclaration = null;

            if iterable->_type->HasMethods() {
                let begin_candidates = iterable->_type->GetCandidates("Begin".ToString(), _for, true);
                begin_function = this.ResolveOverload(begin_candidates, values, _for, true);

                let end_candidates = iterable->_type->GetCandidates("End".ToString(), _for, true);
                end_function = this.ResolveOverload(end_candidates, values, _for, true);
            }

            if begin_function == null || end_function == null {
                Logger::Log("For loop iterable must provide 'Begin()' and 'End()' methods.", _for, LogSeverity::Error);
                return;
            }

            start = this.LowerResolvedCallExpression(begin_function, values, _for);
            end = this.LowerResolvedCallExpression(end_function, values, _for);
            if start == null || end == null { return; }
        }

        if *start->_type != *end->_type {
            Logger::Log("Start and end expressions of a for loop must have the same type.", _for, LogSeverity::Error);
            return;
        }

        let iterator_type = start->_type;

        if is_range && !iterator_type->IsInteger() && !iterator_type->IsFloat() {
            Logger::Log("For loop ranges require an integer or floating point type.", _for, LogSeverity::Error);
            return;
        }

        if !is_range && !iterator_type->IsPointer() && !iterator_type->HasMethods() {
            Logger::Log("For loop requires a pointer iterator or an iterator class.", _for, LogSeverity::Error);
            return;
        }

        let iterator = this.builder.BuildVariableStatement("iterator".ToString(), iterator_type, start, false);
        let (mut alias: *HIRExpression, mut condition: *HIRExpression, mut step: *HIRExpression) = (null, null, null);
        let iterator_reference = this.builder.ReferenceVariable(iterator);

        if is_range {
            let mut one: *HIRExpression = null;

            if iterator_type->IsFloat() {
                one = this.builder.FloatLiteral(1.0, iterator_type);
            } else {
                one = this.builder.IntegerLiteral(1, iterator_type);
            }

            alias = iterator_reference;
            condition = this.builder.Binary(inclusive ? HIRBinaryKind::LessEqual : HIRBinaryKind::Less, iterator_reference, end, this.context.BooleanType());
            step = this.builder.Assignment(iterator_reference, this.builder.Binary(HIRBinaryKind::Add, iterator_reference, one, iterator_type));
        } else if iterator_type->IsPointer() {
            let one: *HIRExpression = this.builder.IntegerLiteral(1, this.context.IntegerPointerType(false));
            step = this.builder.Assignment(iterator_reference, this.builder.Binary(HIRBinaryKind::Add, iterator_reference, one, iterator_type));
            condition = this.builder.Binary(HIRBinaryKind::NotEqual, iterator_reference, end, this.context.BooleanType());
            alias = this.builder.Dereference(iterator_reference);
        } else {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(iterator_reference);
            values.PushBack(end);
            let condition_candidates = iterator_type->GetCandidates("operator!=".ToString(), _for, false);
            if condition_candidates.Empty() { return; }
            let condition_call = this.LowerResolvedCallExpression(condition_candidates, values, _for);
            if condition_call == null { return; }
            condition = condition_call;

            values.Back() = this.builder.IntegerLiteral(1, this.context.IntegerPointerType(false));
            let step_candidates = iterator_type->GetCandidates("operator+=".ToString(), _for, false);
            if step_candidates.Empty() { return; }
            let step_call = this.LowerResolvedCallExpression(step_candidates, values, _for);
            if step_call == null { return; }
            step = step_call;

            values.PopBack();
            let dereference_candidates = iterator_type->GetCandidates("operator*".ToString(), _for, false);
            if dereference_candidates.Empty() { return; }
            let dereference_call = this.LowerResolvedCallExpression(dereference_candidates, values, _for);
            if dereference_call == null { return; }
            alias = dereference_call;
        }

        let destructors = this.GetTemporaryDestructorsSince(temporary_index, null);

        this.scope_manager.PushScope("<for>".ToString(), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.scope_manager.current->Set(_for->variable, alias, _for);
        let body = this.LowerBlockStatement(_for->body);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.builder.BuildForStatement(iterator, condition, step, destructors, body);
    }

    fn LowerLoopStatement(&mut this, _loop: *ASTLoopStatement) {
        this.scope_manager.PushScope("<loop>".ToString(), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        let body = this.LowerBlockStatement(_loop->body);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.builder.BuildLoopStatement(body);
    }

    fn GetTemporaryDestructorsSince(&mut this, index: usize, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();
        let mut carry = Vector<*HIRExpression>();

        for i in 0..this.temporaries.Size() {
            let instance: *HIRExpression = this.temporaries[i];

            if i < index {
                carry.PushBack(instance);
                continue;
            }

            if instance == exception { continue; }
            let function = (instance->_type as *HIRClassType)->declaration->destructor;
            let callee = this.builder.ReferenceDeclaration(function, false);
            let destructor = this.builder.Destructor(this.builder.AddressOf(instance, true), callee);
            destructors.Insert(0, destructor);
        }

        this.temporaries.Swap(carry);
        return destructors;
    }

    fn GetTemporaryDestructors(&mut this, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();

        for instance in this.temporaries.Reverse() {
            if instance == exception { continue; }
            let function = (instance->_type as *HIRClassType)->declaration->destructor;
            let callee = this.builder.ReferenceDeclaration(function, false);
            let destructor = this.builder.Destructor(this.builder.AddressOf(instance, true), callee);
            destructors.PushBack(destructor);
        }

        this.temporaries.Clear();
        return destructors;
    }

    fn BuildTemporaryDestructors(&mut this, exception: *HIRExpression) {
        for destructor in this.GetTemporaryDestructors(exception) {
            this.builder.BuildExpressionStatement(destructor);
        }
    }

    fn GetDestructors(&mut this, target: *mut Scope, exception: *HIRExpression) -> Vector<*HIRExpression> {
        let mut destructors = Vector<*HIRExpression>();
        let mut scope = this.scope_manager.current;

        while scope != null && !scope->global {
            for instance in scope->instances.Reverse() {
                if exception != null {
                    if instance->kind == HIRExpressionKind::VariableReference && exception->kind == HIRExpressionKind::VariableReference {
                        if (instance as *HIRVariableReference)->variable == (exception as *HIRVariableReference)->variable { continue; }
                    } else if instance->kind == HIRExpressionKind::DeclarationReference && exception->kind == HIRExpressionKind::DeclarationReference {
                        if (instance as *HIRDeclarationReference)->declaration == (exception as *HIRDeclarationReference)->declaration { continue; }
                    }
                }

                let function = (instance->_type as *HIRClassType)->declaration->destructor;
                let callee = this.builder.ReferenceDeclaration(function, false);
                let destructor = this.builder.Destructor(this.builder.AddressOf(instance, true), callee);
                destructors.PushBack(destructor);
            }

            if scope == target { break; }
            scope = scope->parent;
        } return destructors;
    }

    fn BuildDestructors(&mut this, target: *mut Scope, exception: *HIRExpression) {
        for destructor in this.GetDestructors(target, exception) {
            this.builder.BuildExpressionStatement(destructor);
        }
    }

    fn LowerContinueStatement(&mut this, _continue: *ASTContinueStatement) {
        if this.loop_scopes.Empty() {
            Logger::Log("Continue statement outside of loop.", _continue, LogSeverity::Error);
            return;
        }

        this.BuildDestructors(this.loop_scopes.Back(), null);
        this.builder.BuildContinueStatement();
    }

    fn LowerBreakStatement(&mut this, _break: *ASTBreakStatement) {
        if this.loop_scopes.Empty() {
            Logger::Log("Break statement outside of loop.", _break, LogSeverity::Error);
            return;
        }

        this.BuildDestructors(this.loop_scopes.Back(), null);
        this.builder.BuildBreakStatement();
    }

    fn LowerUnsafeStatement(&mut this, _unsafe: *ASTUnsafeStatement) {
        if this._unsafe {
            Logger::Log("Already in an unsafe statement.", _unsafe, LogSeverity::Error);
            return;
        }

        this._unsafe = true;
        this.builder.GetCurrentBlock()->statements.PushBack(this.LowerBlockStatement(_unsafe->body));
        this._unsafe = false;
    }

    fn LowerBlockStatement(&mut this, block: *ASTBlockStatement) -> *HIRBlockStatement {
        let prev_block = this.builder.GetCurrentBlock();
        let statement = this.builder.BuildBlockStatement();
        this.builder.SetCurrentBlock(statement);

        for statement in block->statements {
            this.LowerStatement(statement);
        }

        this.BuildDestructors(this.scope_manager.current, null);
        this.builder.SetCurrentBlock(prev_block);
        return statement;
    }

    fn LowerVariableStatement(&mut this, variable: *ASTVariableStatement) {
        let mut initializer: *HIRExpression = null;
        let mut _type: *HIRType = null;

        if variable->_type != null {
            _type = this.LowerType(variable->_type);

            if variable->initializer != null {
                initializer = this.Coerce(this.LowerExpression(variable->initializer), _type);

                if initializer != null {
                    let same = _type->IsSame(initializer->_type);

                    if _type->IsReference() && _type->Pointee().IsCompatible(initializer->_type) {
                        initializer = this.ImplicitAddressOf(initializer);
                    }

                    if initializer->_type->IsReference() && _type->IsCompatible(initializer->_type->Pointee()) {
                        initializer = this.ImplicitDereference(initializer);
                    }

                    if !_type->IsCompatible(initializer->_type) {
                        Logger::Log("Incompatible variable initialization types. ('" + _type->ToString() + "' != '" + initializer->_type->ToString() + "').", variable, LogSeverity::Error);
                        return;
                    }

                    if !_type->IsMutabilityCompatible(initializer->_type) {
                        Logger::Log("Cannot assign immutable pointer to mutable pointer.", variable, LogSeverity::Error);
                        return;
                    }

                    if same && !this.LiteralNeedsExplicitType(variable->initializer, _type) {
                        Logger::Log("Unnecessary type annotation, type can be inferred from initializer.", variable, LogSeverity::Warning);
                    }

                    initializer = this.MakeCompatible(initializer, _type);
                }
            }
        } else if variable->initializer != null {
            initializer = this.Coerce(this.LowerExpression(variable->initializer));
            _type = initializer->_type;
        } else {
            Logger::Log("Type annotation required for variable '" + variable->name + "' without initializer.", variable, LogSeverity::Error);
        }

        if _type != null {
            let construct = _type->IsClass() && (initializer != null ? initializer->_type->IsClass() && initializer->category == HIRExpressionCategory::Place : true);
            let statement = this.builder.BuildVariableStatement(variable->name, _type, !construct ? initializer : null, variable->mutable);
            this.scope_manager.current->Set(variable->name, statement, variable);
            this.builder.GetCurrentBlock()->statements.PushBack(statement);

            if construct {
                let mut values = Vector<*HIRExpression>();
                let reciever = this.builder.ReferenceVariable(statement);
                (reciever as *mut HIRExpression)->mutable = true;
                values.PushBack(reciever);

                if initializer != null { values.PushBack(initializer); }
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, variable, initializer == null);
                if initializer != null && function == null { return; }

                if function != null {
                    let call = this.LowerResolvedCallExpression(function, values, variable);

                    if call != null {
                        this.builder.BuildExpressionStatement(call);
                    }
                }
            }

            if _type->IsClass() {
                this.scope_manager.current->instances.PushBack(this.builder.ReferenceVariable(statement));
                this.BuildTemporaryDestructors(initializer);
            } else {
                this.BuildTemporaryDestructors(null);
            }
        }

        if variable->next != null {
            this.LowerVariableStatement(variable->next);
        }
    }

    fn LowerAssemblyStatement(&mut this, assembly: *ASTAssemblyStatement) {
        if assembly->outputs.Size() > 1 {
            Logger::Log("Multiple outputs are not supported.", assembly, LogSeverity::Error);
        }
    }

    fn IsDeferrableExpression(&mut this, expression: *ASTExpression) -> *HIRType {
        if expression->kind == ASTExpressionKind::Literal {
            let literal = expression as *ASTLiteral;

            if literal->kind == ASTLiteralKind::Integer && (literal as *ASTIntegerLiteral)->suffix.Empty() {
                return this.context.IntegerLiteralType();
            } else if literal->kind == ASTLiteralKind::Float && (literal as *ASTFloatLiteral)->suffix.Empty() {
                return this.context.FloatLiteralType();
            } else {
                return null;
            }
        } else if expression->kind == ASTExpressionKind::Ternary {
            let ternary = expression as *ASTTernaryExpression;
            let then_type = this.IsDeferrableExpression(ternary->then);
            if then_type == null { return null; }
            let else_type = this.IsDeferrableExpression(ternary->_else);
            if else_type == null { return null; }

            if *then_type == *else_type {
                return then_type;
            } else {
                return null;
            }
        } else if expression->kind == ASTExpressionKind::Binary {
            let binary = expression as *ASTBinaryExpression;

            if binary->kind == ASTBinaryKind::Equal || binary->kind == ASTBinaryKind::NotEqual || binary->kind == ASTBinaryKind::Greater || binary->kind == ASTBinaryKind::Less || binary->kind == ASTBinaryKind::GreaterEqual || binary->kind == ASTBinaryKind::LessEqual || binary->kind == ASTBinaryKind::LogicalAnd || binary->kind == ASTBinaryKind::LogicalOr {
                return null;
            }

            let left_type = this.IsDeferrableExpression(binary->left);
            if left_type == null { return null; }
            let right_type = this.IsDeferrableExpression(binary->right);
            if right_type == null { return null; }

            if *left_type == *right_type {
                return left_type;
            } else {
                return null;
            }
        } else if expression->kind == ASTExpressionKind::Unary {
            let unary = expression as *ASTUnaryExpression;

            if unary->kind == ASTUnaryKind::Negate || unary->kind == ASTUnaryKind::Not {
                return this.IsDeferrableExpression(unary->operand);
            } else {
                return null;
            }
        } else {
            return null;
        }
    }

    fn LowerExpression(&mut this, expression: *ASTExpression) -> *HIRExpression {
        if expression->kind == ASTExpressionKind::Unary || expression->kind == ASTExpressionKind::Binary || expression->kind == ASTExpressionKind::Ternary {
            let _type = this.IsDeferrableExpression(expression);

            if _type != null {
                return this.builder.Deferred(expression, _type);
            }
        }

        return this.LowerExpression(expression, null);
    }

    pub fn LowerExpression(&mut this, expression: *ASTExpression, target: *HIRType) -> *HIRExpression {
        if expression->kind == ASTExpressionKind::Literal {
            return this.LowerLiteral(expression as *ASTLiteral);
        } else if expression->kind == ASTExpressionKind::Path {
            let path = (expression as *ASTPathExpression)->path;
            let symbols = this.scope_manager.Resolve(path, false);
            if symbols.Empty() { return null; }

            for symbol in symbols {
                if symbol->kind == SymbolKind::Expression {
                    return symbol->expression;
                } else if symbol->kind == SymbolKind::Statement {
                    return this.builder.ReferenceVariable(symbol->statement as *HIRVariableStatement);
                } else if symbol->kind == SymbolKind::Declaration {
                    let declaration = symbol->declaration;

                    if declaration->kind == HIRDeclarationKind::Member {
                        return (declaration as *HIRMemberDeclaration)->value;
                    } else if declaration->kind == HIRDeclarationKind::Constant {
                        return (declaration as *HIRConstantDeclaration)->initializer;
                    } else if declaration->kind == HIRDeclarationKind::Static {
                        return this.builder.ReferenceDeclaration(declaration, (declaration as *HIRStaticDeclaration)->mutable);
                    } else if declaration->kind == HIRDeclarationKind::Parameter {
                        return this.builder.ReferenceDeclaration(declaration, (declaration as *HIRParameterDeclaration)->mutable);
                    } else {
                        return this.builder.ReferenceDeclaration(declaration, false);
                    }
                }
            }

            Logger::Log("Symbol '" + path->ToString() + "' cannot be used as an expression.", expression, LogSeverity::Error);
            return null;
        } else if expression->kind == ASTExpressionKind::Assignment {
            return this.LowerAssignmentExpression(expression as *ASTAssignmentExpression);
        } else if expression->kind == ASTExpressionKind::Call {
            return this.LowerCallExpression(expression as *ASTCallExpression);
        } else if expression->kind == ASTExpressionKind::New {
            return this.LowerNewExpression(expression as *ASTNewExpression);
        } else if expression->kind == ASTExpressionKind::Delete {
            return this.LowerDeleteExpression(expression as *ASTDeleteExpression);
        } else if expression->kind == ASTExpressionKind::Cast {
            return this.LowerCastExpression(expression as *ASTCastExpression);
        } else if expression->kind == ASTExpressionKind::IndexAccess {
            return this.LowerIndexAccessExpression(expression as *ASTIndexAccessExpression);
        } else if expression->kind == ASTExpressionKind::MemberAccess {
            return this.LowerMemberAccessExpression(expression as *ASTMemberAccessExpression);
        } else if expression->kind == ASTExpressionKind::Unary {
            return this.LowerUnaryExpression(expression as *ASTUnaryExpression, target);
        } else if expression->kind == ASTExpressionKind::Binary {
            return this.LowerBinaryExpression(expression as *ASTBinaryExpression, target);
        } else if expression->kind == ASTExpressionKind::Ternary {
            return this.LowerTernaryExpression(expression as *ASTTernaryExpression, target);
        } else {
            Logger::Log("Unknown expression '" + expression->kind.ToString() + "'.", expression, LogSeverity::Error);
            return null;
        }
    }

    fn LowerLiteral(&mut this, literal: *ASTLiteral) -> *HIRExpression {
        if literal->kind == ASTLiteralKind::Boolean {
            return this.builder.BooleanLiteral((literal as *ASTBooleanLiteral)->value, this.context.BooleanType());
        } else if literal->kind == ASTLiteralKind::Character {
            return this.builder.CharacterLiteral((literal as *ASTCharacterLiteral)->value, this.context.IntegerType(8, true));
        } else if literal->kind == ASTLiteralKind::Integer {
            let integer = literal as *ASTIntegerLiteral;
            let mut _type = this.context.IntegerLiteralType();

            if !integer->suffix.Empty() {
                let signed = integer->suffix.StartsWith("i");
                let suffix = integer->suffix.SubString(1);

                if suffix == "size" {
                    _type = this.context.IntegerPointerType(signed);
                } else {
                    let width = suffix.ToInteger() as u32;

                    if width == 128 || width == 64 || width == 32 || width == 16 || width == 8 {
                        _type = this.context.IntegerType(width, signed);
                    } else {
                        Logger::Log("Invalid integer suffix '" + integer->suffix +  "'.", literal, LogSeverity::Error);
                        return null;
                    }
                }
            }

            return this.builder.IntegerLiteral(integer->value, _type);
        } else if literal->kind == ASTLiteralKind::Float {
            let float = literal as *ASTFloatLiteral;
            let mut _type = this.context.FloatLiteralType();

            if !float->suffix.Empty() {
                let width = float->suffix.SubString(1).ToInteger() as u32;

                if width == 64 || width == 32 {
                    _type = this.context.FloatType(width);
                } else {
                    Logger::Log("Invalid float suffix '" + float->suffix +  "'.", literal, LogSeverity::Error);
                    return null;
                }
            }

            return this.builder.FloatLiteral(float->value, _type);
        } else if literal->kind == ASTLiteralKind::String {
            return this.builder.StringLiteral((literal as *ASTStringLiteral)->value, this.context.PointerType(this.context.IntegerType(8, true), false));
        } else if literal->kind == ASTLiteralKind::Array {
            let mut elements = Vector<*HIRExpression>();
            let mut _type: *HIRType = null;

            for element in (literal as *ASTArrayLiteral)->elements {
                let value = this.LowerExpression(element);
                if value == null { return null; }
                elements.PushBack(value);

                if _type == null {
                    _type = value->_type;
                } else if *_type != *value->_type {
                    Logger::Log("Array elements must have the same type.", element, LogSeverity::Error);
                    return null;
                }
            }

            return this.builder.ArrayLiteral(elements, this.context.ArrayType(_type, elements.Size()));
        } else if literal->kind == ASTLiteralKind::Structure {
            let structure = literal as *ASTStructureLiteral;

            if structure->expression->kind != ASTExpressionKind::Path {
                Logger::Log("Structure initializer target must be a path.", literal, LogSeverity::Error);
                return null;
            }

            let _type = this.LowerType((structure->expression as *ASTPathExpression)->path);
            if _type == null { return null; }

            if !_type->IsStructure() {
                Logger::Log("Structure initializer target must be a structure.", literal, LogSeverity::Error);
                return null;
            }

            let fields = _type->Fields();
            let mut values = Vector<*HIRExpression>();
            values.Resize(fields.Size());

            if structure->fields.Size() != fields.Size() {
                Logger::Log("Structure '" + (_type as *HIRStructureType)->declaration->name + "' argument count mismatch.", literal, LogSeverity::Error);
                return null;
            }

            for field in structure->fields {
                let index = _type->Index(field.left);

                if index == -1 {
                    Logger::Log("Unknown field '" + field.left + "' for structure '" + (_type as *HIRStructureType)->declaration->name + "'.", literal, LogSeverity::Error);
                    return null;
                }

                let declaration: *HIRFieldDeclaration = fields[index as usize];
                let value = this.Coerce(this.LowerExpression(field.right), declaration->_type);
                if value == null { return null; }
                values[index as usize] = value;
            }

            return this.builder.StructureLiteral(values, _type);
        } else if literal->kind == ASTLiteralKind::Null {
            return this.builder.NullLiteral();
        } else {
            Logger::Log("Unknown literal type '" + literal->kind.ToString() + "'.", literal, LogSeverity::Error);
            return null;
        }
    }

    fn AssignmentToBinaryKind(&this, kind: ASTAssignmentKind) -> ASTBinaryKind {
        if kind == ASTAssignmentKind::AddAssign { return ASTBinaryKind::Add; }
        else if kind == ASTAssignmentKind::SubtractAssign { return ASTBinaryKind::Subtract; }
        else if kind == ASTAssignmentKind::MultiplyAssign { return ASTBinaryKind::Multiply; }
        else if kind == ASTAssignmentKind::DivideAssign { return ASTBinaryKind::Divide; }
        else if kind == ASTAssignmentKind::ModuloAssign { return ASTBinaryKind::Modulo; }
        else if kind == ASTAssignmentKind::LeftShiftAssign { return ASTBinaryKind::LeftShift; }
        else if kind == ASTAssignmentKind::RightShiftAssign { return ASTBinaryKind::RightShift; }
        else if kind == ASTAssignmentKind::AndAssign { return ASTBinaryKind::BitwiseAnd; }
        else if kind == ASTAssignmentKind::OrAssign { return ASTBinaryKind::BitwiseOr; }
        else { return ASTBinaryKind::BitwiseXor; }
    }

    fn LowerAssignmentExpression(&mut this, assignment: *ASTAssignmentExpression) -> *HIRExpression {
        let mut left = this.ImplicitDereference(this.LowerExpression(assignment->left));
        if left == null { return null; }

        let mut right = this.LowerExpression(assignment->right);
        if right == null { return null; }

        if left->_type->IsPointer() && (assignment->kind == ASTAssignmentKind::AddAssign || assignment->kind == ASTAssignmentKind::SubtractAssign) {
            right = this.Coerce(right, this.context.IntegerPointerType(false));
        } else {
            right = this.Coerce(right, left->_type);
        }

        if left->_type->HasFields() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(left));
            values.PushBack(right);

            let name = "operator" + assignment->kind.ToString();
            let candidates = left->_type->GetCandidates(name, assignment, false);
            if candidates.Empty() { return null; }
            let function = this.ResolveOverload(candidates, values, assignment, false);
            if function == null { return null; }
            return this.LowerResolvedCallExpression(function, values, assignment);
        }

        if left->category != HIRExpressionCategory::Place {
            Logger::Log("Cannot assign to non-place value.", assignment, LogSeverity::Error);
            return null;
        }

        if !left->mutable {
            Logger::Log("Cannot assign to immutable value.", assignment, LogSeverity::Error);
            return null;
        }

        if assignment->kind != ASTAssignmentKind::Assign {
            right = this.LowerResolvedBinaryExpression(this.AssignmentToBinaryKind(assignment->kind), left, right, assignment);
            if right == null { return null; }
        }

        if right->_type->IsReference() && left->_type->IsCompatible(right->_type->Pointee()) {
            right = this.ImplicitDereference(right);
        }

        if !left->_type->IsCompatible(right->_type) {
            Logger::Log("Incompatible assignment types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", assignment, LogSeverity::Error);
            return null;
        }

        if !left->_type->IsMutabilityCompatible(right->_type) {
            Logger::Log("Cannot assign immutable pointer to mutable pointer.", assignment, LogSeverity::Error);
            return null;
        }

        return this.builder.Assignment(left, this.MakeCompatible(right, left->_type));
    }

    fn LowerCallArguments(&mut this, arguments: &Vector<*ASTExpression>, node: *ASTNode, invalid: &mut bool) -> Vector<*HIRExpression> {
        let mut values = Vector<*HIRExpression>();

        for argument in arguments {
            if argument->kind != ASTExpressionKind::PackSplat {
                let value = this.LowerExpression(argument);

                if value == null {
                    invalid = true;
                    return Vector<*HIRExpression>();
                }

                values.PushBack(value);
                continue;
            }

            let splat = argument as *ASTPackSplatExpression;
            let mut expanded = false;

            if this.current_generic != null && this.current_generic->declaration->kind == ASTDeclarationKind::Function && splat->expression->kind == ASTExpressionKind::Path {
                let function = this.current_generic->declaration as *ASTFunctionDeclaration;
                let path = (splat->expression as *ASTPathExpression)->path;

                if !function->pack_name.Empty() && !path->absolute && path->segments.Size() == 1 && path->segments[0].name == function->pack_name && path->segments[0].types.Empty() {
                    let declaration = this.builder.GetCurrentFunction();
                    let mut start = function->parameters.Size();

                    if function->instance_kind != ASTInstanceKind::None {
                        start += 1;
                    }

                    if declaration != null && start <= declaration->parameters.Size() {
                        for i in start..declaration->parameters.Size() {
                            let parameter: *HIRParameterDeclaration = declaration->parameters[i];
                            values.PushBack(this.builder.ReferenceDeclaration(parameter, false));
                        } expanded = true;
                    }
                }
            }

            if !expanded {
                Logger::Log("Pack splat can only expand the current function's parameter pack.", node, LogSeverity::Error);
                invalid = true;
                return Vector<*HIRExpression>();
            }
        } return values;
    }

    fn ResolveGenericMethods(&mut this, _type: *HIRType, name: &String, types: &Vector<*ASTType>, values: &Vector<*HIRExpression>, node: *ASTNode) -> Vector<*HIRFunctionDeclaration> {
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut lowered_types = Vector<*HIRType>();

        for _type in types {
            let lowered_type = this.LowerType(_type);
            if lowered_type == null { return result; }
            lowered_types.PushBack(lowered_type);
        }

        for generic in this.generics {
            if generic->declaration->kind != ASTDeclarationKind::Function || generic->_type == null || *generic->_type != *_type {
                continue;
            }

            let function = generic->declaration as *ASTFunctionDeclaration;

            if function->name != name {
                continue;
            }

            if !function->public && (this.current_type == null || *this.current_type != *_type) {
                continue;
            }

            if function->pack_name.Empty() && lowered_types.Empty() {
                continue;
            }

            let mut types = Vector<*HIRType>(lowered_types);

            if !function->pack_name.Empty() {
                let mut start = function->parameters.Size();

                if function->instance_kind != ASTInstanceKind::None {
                    start += 1;
                }

                if start <= values.Size() {
                    for i in start..values.Size() {
                        types.PushBack(values[i]->_type);
                    }
                }
            }

            let instance = generic->Instantiate(types, node);

            if instance != null && instance->declaration != null && instance->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(instance->declaration as *HIRFunctionDeclaration);
            }
        }

        if result.Empty() && _type->IsClass() {
            for parent in (_type as *HIRClassType)->declaration->parents {
                result += this.ResolveGenericMethods(parent, name, types, values, node);
            }
        } return result;
    }

    fn LowerCallExpression(&mut this, call: *ASTCallExpression) -> *HIRExpression {
        if call->expression->kind == ASTExpressionKind::Path {
            let path = (call->expression as *ASTPathExpression)->path;

            if !path->absolute && path->segments.Size() == 1 && path->segments[0].types.Empty() {
                if path->segments[0].name == "sizeof" || path->segments[0].name == "alignof" {
                    if call->arguments.Size() != 1 {
                        Logger::Log("Invalid number of arguments for intrinsic '" + path->segments[0].name + "'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut _type: *HIRType;
                    let argument: *ASTExpression = call->arguments[0];

                    if argument->kind == ASTExpressionKind::Path {
                        let path = (argument as *ASTPathExpression)->path;
                        let symbols = this.scope_manager.Resolve(path, false);
                        if symbols.Empty() { return null; }

                        for symbol in symbols {
                            if symbol->kind == SymbolKind::Statement {
                                _type = (symbol->statement as *HIRVariableStatement)->_type;
                            } else if symbol->kind == SymbolKind::Declaration {
                                _type = symbol->declaration->_type;
                            } else {
                                _type = symbol->_type;
                            }

                            if _type != null {
                                break;
                            }
                        }

                        if _type == null {
                            Logger::Log("Symbol '" + path->ToString() + "' cannot be used as a type.", path, LogSeverity::Error);
                            return null;
                        }
                    } else {
                        Logger::Log("Invalid argument kind '" + argument->kind.ToString() + "' for intrinsic '" + path->segments[0].name + "'.", call, LogSeverity::Error);
                        return null;
                    }

                    return this.builder.Intrinsic(path->segments[0].name == "sizeof" ? HIRIntrinsicKind::SizeOf : HIRIntrinsicKind::AlignOf, _type);
                } else if path->segments[0].name == "construct" {
                    if call->arguments.Size() == 0 {
                        Logger::Log("Invalid number of arguments for 'construct'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut invalid = false;
                    let mut values = this.LowerCallArguments(call->arguments, call, &mut invalid);
                    if invalid { return null; }

                    let target = this.ImplicitDereference(values[0]);

                    if !target->_type->IsPointer() {
                        Logger::Log("Construct target must be a pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    let target_type: *HIRType = target->_type->Pointee();

                    if target_type->IsClass() {
                        let mut candidates = Vector<*HIRFunctionDeclaration>();

                        for candidate in (target_type as *HIRClassType)->declaration->constructors {
                            candidates.PushBack(candidate);
                        }

                        let function = this.ResolveOverload(candidates, values, call, false);
                        if function == null { return null; }
                        let call = this.LowerResolvedCallExpression(function, values, call);
                        if call == null { return null; }
                        this.builder.BuildExpressionStatement(call);
                    } else {
                        values.RemoveAt(0);

                        if values.Size() > 1 {
                            Logger::Log("Primitive type initialization accepts at most 1 argument.", call, LogSeverity::Error);
                            return null;
                        }

                        if values.Size() != 0 {
                            let mut value = this.ImplicitDereference(values[0]);

                            if target_type->IsCompatible(value->_type) {
                                if target_type->IsMutabilityCompatible(value->_type) {
                                    this.builder.BuildExpressionStatement(this.builder.Assignment(target, this.MakeCompatible(value, target_type)));
                                } else {
                                    Logger::Log("Cannot assign immutable pointer to mutable pointer.", call, LogSeverity::Error);
                                    return null;
                                }
                            } else {
                                Logger::Log("Incompatible primitive type initialization types. ('" + target_type->ToString() + "' != '" + value->_type->ToString() + "').", call, LogSeverity::Error);
                                return null;
                            }
                        }
                    } return target;
                } else if path->segments[0].name == "destruct" {
                    if call->arguments.Size() != 1 {
                        Logger::Log("Invalid number of arguments for 'destruct'.", call, LogSeverity::Error);
                        return null;
                    }

                    let mut invalid = false;
                    let values = this.LowerCallArguments(call->arguments, call, &mut invalid);
                    if invalid { return null; }

                    let target = this.ImplicitDereference(values[0]);

                    if !target->_type->IsPointer() {
                        Logger::Log("Destruct target must be a pointer.", call, LogSeverity::Error);
                        return null;
                    }

                    let target_type: *HIRType = target->_type->Pointee();

                    if target_type->IsClass() {
                        let function = (target_type as *HIRClassType)->declaration->destructor;
                        let callee = this.builder.ReferenceDeclaration(function, false);
                        this.builder.BuildExpressionStatement(this.builder.Destructor(target, callee));
                    } return null;
                }
            }
        }

        let mut invalid = false;
        let mut values = this.LowerCallArguments(call->arguments, call, invalid);
        if invalid { return null; }

        if call->expression->kind == ASTExpressionKind::Path {
            let path = (call->expression as *ASTPathExpression)->path;

            for symbol in this.scope_manager.ResolveType(path, true) {
                if symbol->kind == SymbolKind::Type && symbol->_type->IsClass() {
                    let mut candidates = Vector<*HIRFunctionDeclaration>();

                    for candidate in (symbol->_type as *HIRClassType)->declaration->constructors {
                        candidates.PushBack(candidate);
                    }

                    values.Insert(0, this.builder.NullLiteral());
                    let function = this.ResolveOverload(candidates, values, call, false);
                    if function == null { return null; }
                    let callee = this.builder.ReferenceDeclaration(function, false);
                    if !this.ValidateCallArguments(callee, values, call) { return null; }
                    values.RemoveAt(0);
                    let constructor = this.builder.Constructor(callee, values, symbol->_type);
                    this.temporaries.PushBack(constructor);
                    return constructor;
                }
            }

            let candidates = this.scope_manager.ResolveCandidates(path, values, true);

            if !candidates.Empty() {
                return this.LowerResolvedCallExpression(candidates, values, call);
            }
        } else if call->expression->kind == ASTExpressionKind::MemberAccess {
            let member_access = call->expression as *ASTMemberAccessExpression;
            let mut instance = this.ImplicitDereference(this.LowerExpression(member_access->expression));
            if instance == null { return null; }

            if member_access->arrow {
                if instance->_type->HasMethods() {
                    let mut values = Vector<*HIRExpression>();
                    values.PushBack(this.ImplicitAddressOf(instance));

                    let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                    if candidates.Empty() { return null; }

                    instance = this.ImplicitDereference(this.LowerResolvedCallExpression(candidates, values, member_access));
                } else if instance->_type->IsPointer() {
                    instance = this.builder.Dereference(instance);
                } else {
                    Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                    return null;
                }
            }

            let mut candidates = Vector<*HIRFunctionDeclaration>();
            values.Insert(0, this.ImplicitAddressOf(instance));

            if !instance->_type->HasMethods() {
                candidates += this.extension_registry.GetCandidates(instance->_type, member_access->member, call, true);
            } else {
                candidates += instance->_type->GetCandidates(member_access->member, call, true);
            }

            candidates += this.ResolveGenericMethods(instance->_type, member_access->member, member_access->types, values, call);

            if !candidates.Empty() {
                return this.LowerResolvedCallExpression(candidates, values, call);
            } values.RemoveAt(0);
        }

        let value = this.LowerExpression(call->expression);
        if value == null { return null; }
        return this.LowerResolvedCallExpression(value, values, call);
    }

    fn ResolveOverload(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *ASTNode, test: bool) -> *HIRFunctionDeclaration {
        let mut index: usize = 0;
        let mut best: u64 = 0;

        for i in 0..candidates.Size() {
            let function: *HIRFunctionDeclaration = candidates[i];
            let parameters = function->_type->Parameters();
            if values.Size() != parameters.Size() { continue; }
            let (mut _match, mut score: u64) = (true, 1);

            for j in 0..parameters.Size() {
                let parameter_score = parameters[j]->ScoreParameter(values[j]->_type);

                if parameter_score != 0 {
                    score += parameter_score;
                } else {
                    _match = false;
                    break;
                }
            }

            if _match && score > best {
                (index, best) = (i, score);
            }
        }

        if best != 0 {
            return candidates[index];
        } else {
            if !test {
                if !candidates.Empty() {
                    let candidate: *HIRFunctionDeclaration = candidates[0];
                    Logger::Log("Invalid arguments for: '" + candidate->name + "'.", node, LogSeverity::Error);
                } else {
                    Logger::Log("No candidates found for function call!", node, LogSeverity::Fatal);
                }
            } return null;
        }
    }

    fn ValidateCallArguments(&mut this, callee: *HIRExpression, values: &mut Vector<*HIRExpression>, node: *ASTNode) -> bool {
        if !callee->_type->IsFunction() {
            Logger::Log("Callee is not a function.", node, LogSeverity::Error);
            return false;
        }

        let parameter_types = callee->_type->Parameters();

        for i in 0..parameter_types.Size() {
            let parameter_type: *HIRType = parameter_types[i];
            let mut value = this.Coerce(values[i], parameter_type);

            if parameter_type->IsReference() && parameter_type->Pointee().IsCompatible(value->_type) {
                value = this.ImplicitAddressOf(value);
            }

            if value->_type->IsReference() && parameter_type->IsCompatible(value->_type->Pointee()) {
                value = this.ImplicitDereference(value);
            }

            if value->_type->IsClass() {
                if value->category == HIRExpressionCategory::Place {
                    let mut values = Vector<*HIRExpression>();
                    values.PushBack(this.ImplicitAddressOf(value));
                    let arguments = Vector<*HIRExpression>(values);
                    values.Insert(0, this.builder.NullLiteral());
                    let mut candidates = Vector<*HIRFunctionDeclaration>();

                    for candidate in (value->_type as *HIRClassType)->declaration->constructors {
                        candidates.PushBack(candidate);
                    }

                    let function = this.ResolveOverload(candidates, values, node, false);
                    if function == null { return false; }
                    let callee = this.builder.ReferenceDeclaration(function, false);
                    value = this.builder.Constructor(callee, arguments, value->_type);
                } else {
                    this.temporaries.Remove(value);
                }
            }

            if !parameter_type->IsCompatible(value->_type) {
                if callee->kind == HIRExpressionKind::DeclarationReference {
                    let name = (callee as *HIRDeclarationReference)->declaration->name;
                    Logger::Log("Incompatible argument types for function '" + name + "'. ('" + parameter_type->ToString() + "' != '" + value->_type->ToString() + "').", node, LogSeverity::Error);
                } else {
                    Logger::Log("Incompatible argument types for function. ('" + parameter_type->ToString() + "' != '" + value->_type->ToString() + "').", node, LogSeverity::Error);
                } return false;
            }

            if !parameter_type->IsMutabilityCompatible(value->_type) {
                Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
                return false;
            }

            values[i] = this.MakeCompatible(value, parameter_type);
        } return true;
    }

    fn LowerResolvedCallExpression(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        let function = this.ResolveOverload(candidates, values, node, false);
        if function == null { return null; }
        return this.LowerResolvedCallExpression(function, values, node);
    }

    fn LowerResolvedCallExpression(&mut this, function: *HIRFunctionDeclaration, values: &Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        return this.LowerResolvedCallExpression(this.builder.ReferenceDeclaration(function, false), values, node);
    }

    fn LowerResolvedCallExpression(&mut this, callee: *HIRExpression, mut values: Vector<*HIRExpression>, node: *ASTNode) -> *HIRCallExpression {
        if !this.ValidateCallArguments(callee, values, node) {
            return null;
        }

        let call = this.builder.Call(callee, values);

        if callee->_type->Return().HasFields() {
            this.temporaries.PushBack(call);
        } return call;
    }

    fn LowerNewExpression(&mut this, _new: *ASTNewExpression) -> *HIRExpression {
        let _type = this.LowerType(_new->_type);
        if _type == null { return null; }

        if _new->size != null {
            let size = this.Coerce(this.LowerExpression(_new->size), this.context.IntegerPointerType(false));
            if size == null { return null; }

            if !size->_type->IsIntegerPointer() || size->_type->IsSigned() {
                Logger::Log("Array size must be of type 'usize'.", _new, LogSeverity::Error);
                return null;
            }

            if _type->IsClass() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.builder.NullLiteral());
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, _new, false);
                if function == null { return null; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                return this.builder.New(_type, size, false, callee, Vector<*HIRExpression>());
            } else {
                return this.builder.New(_type, size, false, null, Vector<*HIRExpression>());
            }
        } else if _new->initialized {
            let mut invalid = false;
            let mut values = this.LowerCallArguments(_new->arguments, _new, &mut invalid);
            if invalid { return null; }

            if _type->IsClass() {
                let arguments = Vector<*HIRExpression>(values);
                values.Insert(0, this.builder.NullLiteral());
                let mut candidates = Vector<*HIRFunctionDeclaration>();

                for candidate in (_type as *HIRClassType)->declaration->constructors {
                    candidates.PushBack(candidate);
                }

                let function = this.ResolveOverload(candidates, values, _new, false);
                if function == null { return null; }
                let callee = this.builder.ReferenceDeclaration(function, false);
                return this.builder.New(_type, null, true, callee, arguments);
            } else {
                if values.Size() != 1 {
                    Logger::Log("Primitive type initialization requires exactly 1 argument.", _new, LogSeverity::Error);
                    return null;
                }

                let value = values[0];

                if _type->IsCompatible(value->_type) {
                    if _type->IsMutabilityCompatible(value->_type) {
                        values[0] = this.MakeCompatible(value, _type);
                        return this.builder.New(_type, null, true, null, values);
                    } else {
                        Logger::Log("Cannot assign immutable pointer to mutable pointer.", _new, LogSeverity::Error);
                        return null;
                    }
                } else {
                    Logger::Log("Incompatible primitive type initialization types. ('" + _type->ToString() + "' != '" + value->_type->ToString() + "').", _new, LogSeverity::Error);
                    return null;
                }
            }
        } else {
            return this.builder.New(_type, null, false, null, Vector<*HIRExpression>());
        }
    }

    fn LowerDeleteExpression(&mut this, _delete: *ASTDeleteExpression) -> *HIRExpression {
        let pointer = this.LowerExpression(_delete->expression);
        if pointer == null { return null; }

        if !pointer->_type->IsPointer() {
            Logger::Log("Delete value must be a pointer.", _delete, LogSeverity::Error);
            return null;
        }

        if pointer->_type->Pointee().IsClass() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.builder.NullLiteral());
            let function = (pointer->_type->Pointee() as *HIRClassType)->declaration->destructor;
            let callee = this.builder.ReferenceDeclaration(function, false);
            return this.builder.Delete(pointer, _delete->array, callee, Vector<*HIRExpression>());
        } else {
            return this.builder.Delete(pointer, _delete->array, null, Vector<*HIRExpression>());
        }
    }

    fn LiteralNeedsExplicitType(&mut this, expression: *ASTExpression, target: *HIRType) -> bool {
        let _type = this.IsDeferrableExpression(expression);

        if _type == null {
            return false;
        } else if _type->IsInteger() {
            return target->IsInteger() && !target->IsSame(this.context.IntegerType(32, true));
        } else if _type->IsFloat() {
            return target->IsFloat() && !target->IsSame(this.context.FloatType(64));
        } else {
            return false;
        }
    }

    fn LowerCastExpression(&mut this, cast: *ASTCastExpression) -> *HIRExpression {
        let mut target = this.LowerType(cast->target);
        if target == null { return null; }

        let value = this.Coerce(this.LowerExpression(cast->expression), target);
        if value == null { return null; }

        if *value->_type == *target && this.LiteralNeedsExplicitType(cast->expression, target) {
            return value;
        }

        return this.LowerResolvedCastExpression(value, target, cast);
    }

    fn LowerResolvedCastExpression(&mut this, mut value: *HIRExpression, target: *HIRType, node: *ASTNode) -> *HIRExpression {
        if !target->IsPointer() {
            value = this.ImplicitDereference(value);
        }

        let (mut state, mut failed) = (false, false);
        let (mut left, mut right) = (target, value->_type);

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() {
                if left->IsMutable() && !right->IsNullPointer() {
                    failed = true;
                } state = true;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if *value->_type == target {
            if !state {
                Logger::Log("Redundant cast. ('" + value->_type->ToString() + "' to '" + target->ToString() + "')", node, LogSeverity::Warning);
            } else {
                if !failed || this._unsafe {
                    return this.builder.Cast(value, target);
                } else {
                    Logger::Log("Cannot cast immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    return null;
                }
            }
        }

        if value->_type->IsBoolean() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsCharacter() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsInteger() {
            if target->IsPointer() || target->IsInteger() || target->IsFloat() || target->IsEnumeration() {
                return this.builder.Cast(value, target);
            } else if target->IsCharacter() {
                if value->_type->Width() == 8 && !value->_type->IsSigned() {
                    return this.builder.Cast(value, target);
                }
            }
        } else if value->_type->IsFloat() {
            if target->IsInteger() || target->IsFloat() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsPointer() {
            if target->IsInteger() || target->IsFunction() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsFunction() {
            if target->IsPointer() || target->IsFunction() {
                return this.builder.Cast(value, target);
            }
        } else if value->_type->IsEnumeration() {
            if target->IsInteger() {
                return this.builder.Cast(value, target);
            }
        }

        if value->_type->IsPointer() && target->IsPointer() {
            if value->_type->Pointee().IsClass() && target->Pointee().IsClass() {
                let (source, destination) = (value->_type->Pointee(), target->Pointee());

                if !destination.IsDerivedFrom(source) && !source.IsDerivedFrom(destination) {
                    let source_name = (source as *HIRClassType)->declaration->name;
                    let destination_name = (destination as *HIRClassType)->declaration->name;
                    Logger::Log("Cannot cast class '" + source_name + "' to unrelated class '" + destination_name + "'.", node, LogSeverity::Error);
                    return null;
                }
            }

            return this.builder.Cast(value, target);
        } else {
            Logger::Log("Cannot cast '" + value->_type->ToString() + "' to '" + target->ToString() + "'.", node, LogSeverity::Error);
            return null;
        }
    }

    fn LowerIndexAccessExpression(&mut this, index_access: *ASTIndexAccessExpression) -> *HIRExpression {
        let value = this.ImplicitDereference(this.LowerExpression(index_access->expression));

        if value == null {
            return null;
        }

        let index = this.Coerce(this.ImplicitDereference(this.LowerExpression(index_access->index)), this.context.IntegerPointerType(false));

        if index == null {
            return null;
        }

        if value->_type->HasMethods() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(value));
            values.PushBack(index);

            let candidates = value->_type->GetCandidates("operator[]".ToString(), index_access, false);
            if candidates.Empty() { return null; }
            return this.LowerResolvedCallExpression(candidates, values, index_access);
        }

        if !value->_type->IsPointer() && !value->_type->IsArray() {
            Logger::Log("Indexed value must be a pointer or an array.", index_access, LogSeverity::Error);
            return null;
        }

        if !index->_type->IsIntegerPointer() || index->_type->IsSigned() {
            Logger::Log("Index must be of type 'usize'.", index_access, LogSeverity::Error);
            return null;
        }

        return this.builder.IndexAccess(value, index);
    }

    fn LowerMemberAccessExpression(&mut this, member_access: *ASTMemberAccessExpression) -> *HIRExpression {
        let mut instance = this.ImplicitDereference(this.LowerExpression(member_access->expression));

        if instance == null {
            return null;
        }

        if member_access->arrow {
            if instance->_type->HasMethods() {
                let mut values = Vector<*HIRExpression>();
                values.PushBack(this.ImplicitAddressOf(instance));

                let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                if candidates.Empty() { return null; }

                instance = this.ImplicitDereference(this.LowerResolvedCallExpression(candidates, values, member_access));
            } else if instance->_type->IsPointer() {
                instance = this.builder.Dereference(instance);
            } else {
                Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                return null;
            }
        }

        if !instance->_type->HasFields() {
            Logger::Log("Cannot access field '" + member_access->member + "' of type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }

        let (mut path, mut ambiguous) = (Vector<u32>(), false);
        let field = instance->_type->FindField(member_access->member, path, ambiguous);

        if ambiguous {
            Logger::Log("Field '" + member_access->member + "' is ambiguous in type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }

        if field != null {
            for index in path {
                let parent: *HIRType = (instance->_type as *HIRClassType)->declaration->parents[index as usize];
                let address = this.builder.AddressOf(instance, instance->mutable);
                let cast = this.builder.Cast(address, this.context.ReferenceType(parent, instance->mutable));
                instance = this.builder.Dereference(cast);
            }

            if !field->public && (this.current_type != null && *this.current_type != *instance->_type) {
                Logger::Log("Field '" + member_access->member + "' is private.", member_access, LogSeverity::Error);
                return null;
            }

            return this.builder.FieldAccess(instance, field);
        } else {
            Logger::Log("Field '" + member_access->member + "' not found in type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }
    }

    fn LowerUnaryExpression(&mut this, unary: *ASTUnaryExpression, target: *HIRType) -> *HIRExpression {
        let raw = this.LowerExpression(unary->operand);
        let mut value = this.ImplicitDereference(raw);
        if value == null { return null; }

        let mut values = Vector<*HIRExpression>();
        values.PushBack(this.ImplicitAddressOf(value));

        let name = "operator" + unary->kind.ToString();
        let candidates = this.extension_registry.GetCandidates(value->_type, name, unary, true);
        let function = this.ResolveOverload(candidates, values, unary, true);

        if function != null {
            return this.LowerResolvedCallExpression(function, values, unary);
        }

        if value->_type->HasMethods() {
            let candidates = value->_type->GetCandidates(name, unary, true);
            let function = this.ResolveOverload(candidates, values, unary, true);

            if function != null {
                return this.LowerResolvedCallExpression(function, values, unary);
            }
        }

        if unary->kind == ASTUnaryKind::AddressOf {
            if raw->category != HIRExpressionCategory::Place {
                Logger::Log("Cannot take reference to non-place value.", unary, LogSeverity::Error);
                return null;
            }

            if unary->mutable && !raw->mutable {
                Logger::Log("Cannot take mutable reference to immutable value.", unary, LogSeverity::Error);
                return null;
            }

            return this.builder.AddressOf(raw, unary->mutable);
        } else if unary->kind == ASTUnaryKind::Dereference {
            if !raw->_type->IsPointer() {
                Logger::Log("Cannot dereference non-pointer type '" + raw->_type->ToString() + "'.", unary, LogSeverity::Error);
                return null;
            }

            return this.builder.Dereference(raw);
        } else {
            let mut operand_target: *HIRType = null;

            if target != null {
                if unary->kind == ASTUnaryKind::Negate {
                    if target->IsFloat() || (target->IsInteger() && target->IsSigned()) {
                        operand_target = target;
                    }
                } else if unary->kind == ASTUnaryKind::Not {
                    operand_target = target;
                }
            }

            if operand_target != null {
                value = this.Coerce(value, operand_target);
            } else {
                value = this.Coerce(value);
            }

            if unary->kind == ASTUnaryKind::Negate {
                if !value->_type->IsInteger() && !value->_type->IsFloat() {
                    Logger::Log("Cannot negate type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }

                if value->_type->IsInteger() && !value->_type->IsSigned() {
                    Logger::Log("Cannot negate unsigned type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }

                return this.builder.Unary(HIRUnaryKind::Negate, value);
            } else if unary->kind == ASTUnaryKind::Not {
                if !value->_type->IsInteger() && !value->_type->IsBoolean() {
                    Logger::Log("Cannot invert type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }

                return this.builder.Unary(HIRUnaryKind::Not, value);
            } else {
                Logger::Log("Invalid unary operation '" + unary->kind.ToString() + "'.", unary, LogSeverity::Error);
                return null;
            }
        }
    }

    fn LowerBinaryKind(&this, kind: ASTBinaryKind) -> HIRBinaryKind {
        if kind == ASTBinaryKind::Add { return HIRBinaryKind::Add; }
        else if kind == ASTBinaryKind::Subtract { return HIRBinaryKind::Subtract; }
        else if kind == ASTBinaryKind::Multiply { return HIRBinaryKind::Multiply; }
        else if kind == ASTBinaryKind::Divide { return HIRBinaryKind::Divide; }
        else if kind == ASTBinaryKind::Modulo { return HIRBinaryKind::Modulo; }
        else if kind == ASTBinaryKind::Equal { return HIRBinaryKind::Equal; }
        else if kind == ASTBinaryKind::NotEqual { return HIRBinaryKind::NotEqual; }
        else if kind == ASTBinaryKind::Less { return HIRBinaryKind::Less; }
        else if kind == ASTBinaryKind::LessEqual { return HIRBinaryKind::LessEqual; }
        else if kind == ASTBinaryKind::Greater { return HIRBinaryKind::Greater; }
        else if kind == ASTBinaryKind::GreaterEqual { return HIRBinaryKind::GreaterEqual; }
        else if kind == ASTBinaryKind::LogicalAnd { return HIRBinaryKind::LogicalAnd; }
        else if kind == ASTBinaryKind::LogicalOr { return HIRBinaryKind::LogicalOr; }
        else if kind == ASTBinaryKind::BitwiseAnd { return HIRBinaryKind::BitwiseAnd; }
        else if kind == ASTBinaryKind::BitwiseOr { return HIRBinaryKind::BitwiseOr; }
        else if kind == ASTBinaryKind::BitwiseXor { return HIRBinaryKind::BitwiseXor; }
        else if kind == ASTBinaryKind::LeftShift { return HIRBinaryKind::LeftShift; }
        else { return HIRBinaryKind::RightShift; }
    }

    fn LowerBinaryExpression(&mut this, binary: *ASTBinaryExpression, target: *HIRType) -> *HIRExpression {
        let mut operand_target: *HIRType = null;

        if target != null && binary->kind != ASTBinaryKind::Equal && binary->kind != ASTBinaryKind::NotEqual && binary->kind != ASTBinaryKind::Greater && binary->kind != ASTBinaryKind::Less && binary->kind != ASTBinaryKind::GreaterEqual && binary->kind != ASTBinaryKind::LessEqual && binary->kind != ASTBinaryKind::LogicalAnd && binary->kind != ASTBinaryKind::LogicalOr {
            if target->IsInteger() || target->IsFloat() || target->IsBoolean() {
                operand_target = target;
            }
        }

        let mut left = this.LowerExpression(binary->left);
        if left == null { return null; }

        if operand_target != null {
            left = this.Coerce(left, operand_target);
        }

        if binary->kind == ASTBinaryKind::LogicalAnd || binary->kind == ASTBinaryKind::LogicalOr {
            if !left->_type->IsBoolean() {
                Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + binary->kind.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            let index = this.temporaries.Size();
            let right = this.LowerExpression(binary->right);
            let destructors = this.GetTemporaryDestructorsSince(index, right);
            if right == null { return null; }

            if !right->_type->IsBoolean() {
                Logger::Log("Invalid type '" + right->_type->ToString() + "' for binary operation '" + binary->kind.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            return this.builder.Binary(this.LowerBinaryKind(binary->kind), left, right, destructors, left->_type);
        }

        let mut right = this.LowerExpression(binary->right);
        if right == null { return null; }

        if operand_target != null {
            right = this.Coerce(right, operand_target);
        }

        return this.LowerResolvedBinaryExpression(binary->kind, left, right, binary);
    }

    fn LowerResolvedBinaryExpression(&mut this, kind: ASTBinaryKind, mut left: *HIRExpression, mut right: *HIRExpression, node: *ASTNode) -> *HIRExpression {
        let (left_raw, right_raw) = (left, right);
        (left, right) = (this.ImplicitDereference(left), this.ImplicitDereference(right));

        let mut values = Vector<*HIRExpression>();
        values.PushBack(left);
        values.PushBack(right);

        let name = "operator" + kind.ToString();
        let candidates = this.extension_registry.GetCandidates(left->_type, name, node, true);
        let function = this.ResolveOverload(candidates, values, node, true);

        if function != null {
            return this.LowerResolvedCallExpression(function, values, node);
        } else if left->_type->HasFields() || right->_type->HasFields() {
            let instance = left->_type->HasFields() ? left : right;
            let value = left->_type->HasFields() ? right_raw : left_raw;

            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(instance));
            values.PushBack(value);

            if instance->_type->HasMethods() {
                let candidates = instance->_type->GetCandidates(name, node, true);
                let function = this.ResolveOverload(candidates, values, node, true);

                if function != null {
                    return this.LowerResolvedCallExpression(function, values, node);
                }
            }

            if *left->_type == *right->_type {
                if kind != ASTBinaryKind::Equal && kind != ASTBinaryKind::NotEqual {
                    Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    return null;
                }

                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }
        }

        if left->_type->IsPointer() && right->_type->IsInteger() && right->_type->IsLiteral() {
            right = this.Coerce(right, this.context.IntegerPointerType(false));
        } else if right->_type->IsPointer() && left->_type->IsInteger() && left->_type->IsLiteral() {
            left = this.Coerce(left, this.context.IntegerPointerType(false));
        } else {
            (left, right) = (this.Coerce(left, right->_type), this.Coerce(right, left->_type));
        }

        if left->_type->IsBoolean() && right->_type->IsBoolean() {
            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else if kind == ASTBinaryKind::LogicalAnd || kind == ASTBinaryKind::BitwiseAnd || kind == ASTBinaryKind::LogicalOr || kind == ASTBinaryKind::BitwiseOr || kind == ASTBinaryKind::BitwiseXor {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type);
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsCharacter() && right->_type->IsCharacter() {
            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsInteger() && right->_type->IsInteger() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Add || kind == ASTBinaryKind::Subtract || kind == ASTBinaryKind::Multiply || kind == ASTBinaryKind::Divide || kind == ASTBinaryKind::Modulo {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type);
            } else if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else if kind == ASTBinaryKind::BitwiseAnd || kind == ASTBinaryKind::BitwiseOr || kind == ASTBinaryKind::BitwiseXor || kind == ASTBinaryKind::LeftShift || kind == ASTBinaryKind::RightShift {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type);
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsFloat() && right->_type->IsFloat() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Add || kind == ASTBinaryKind::Subtract || kind == ASTBinaryKind::Multiply || kind == ASTBinaryKind::Divide || kind == ASTBinaryKind::Modulo {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type);
            } else if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsPointer() && right->_type->IsPointer() {
            if *left->_type != *right->_type && !(left->_type->IsNullPointer() || right->_type->IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Subtract {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.IntegerPointerType(false));
            } else if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if (left->_type->IsPointer() && right->_type->IsInteger()) || (left->_type->IsInteger() && right->_type->IsPointer()) {
            let pointer = left->_type->IsPointer() ? left : right;
            let index = left->_type->IsPointer() ? right : left;

            if !index->_type->IsIntegerPointer() {
                Logger::Log("Pointer arithmetic requires an operand of pointer-sized type.", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Add {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, pointer->_type);
            } else if kind == ASTBinaryKind::Subtract {
                if left->_type->IsInteger() {
                    Logger::Log("Cannot subtract a pointer from an integer.", node, LogSeverity::Error);
                    return null;
                }

                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, pointer->_type);
            } else {
                Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if (left->_type->IsFunction() && right->_type->IsNullPointer()) || (left->_type->IsNullPointer() && right->_type->IsFunction()) {
            if *left->_type != *right->_type && !(left->_type->IsNullPointer() || right->_type->IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Invalid pointer binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsEnumeration() && right->_type->IsEnumeration() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if kind == ASTBinaryKind::BitwiseAnd || kind == ASTBinaryKind::BitwiseOr || kind == ASTBinaryKind::BitwiseXor {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, left->_type);
            } else if kind == ASTBinaryKind::Equal || kind == ASTBinaryKind::NotEqual || kind == ASTBinaryKind::Greater || kind == ASTBinaryKind::GreaterEqual || kind == ASTBinaryKind::Less || kind == ASTBinaryKind::LessEqual {
                return this.builder.Binary(this.LowerBinaryKind(kind), left, right, this.context.BooleanType());
            } else {
                Logger::Log("Invalid binary operation '" + kind.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else {
            Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + kind.ToString() + "'.", node, LogSeverity::Error);
            return null;
        }
    }

    fn LowerTernaryExpression(&mut this, ternary: *ASTTernaryExpression, target: *HIRType) -> *HIRExpression {
        let condition = this.ImplicitDereference(this.LowerExpression(ternary->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", ternary->condition, LogSeverity::Error);
        }

        let then_index = this.temporaries.Size();
        let mut then_value = this.LowerExpression(ternary->then);
        let then_destructors = this.GetTemporaryDestructorsSince(then_index, then_value);
        if then_value == null { return null; }

        let else_index = this.temporaries.Size();
        let mut else_value = this.LowerExpression(ternary->_else);
        let else_destructors = this.GetTemporaryDestructorsSince(else_index, else_value);
        if else_value == null { return null; }

        then_value = this.Coerce(then_value, target != null ? target : else_value->_type);
        else_value = this.Coerce(else_value, target != null ? target : then_value->_type);

        let mutable = then_value->mutable && else_value->mutable ? true : false;
        let category = (then_value->category == HIRExpressionCategory::Place && else_value->category == HIRExpressionCategory::Place)
            ? HIRExpressionCategory::Place : HIRExpressionCategory::Value;
        return this.builder.Ternary(condition, then_value, then_destructors, else_value, else_destructors, category, mutable);
    }

    pub fn LowerType(&mut this, path: *ASTPath) -> *HIRType {
        if path == null {
            return this.context.VoidType();
        }

        if !path->absolute && path->segments.Size() == 1 && path->segments[0].types.Empty() {
            let name = path->segments[0].name;

            if name == "void" {
                return this.context.VoidType();
            } else if name == "bool" {
                return this.context.BooleanType();
            } else if name == "char" {
                return this.context.CharacterType();
            } else if name.StartsWith('i') || name.StartsWith('u') {
                let specifier = name.SubString(1);
                let signed = name[0] != 'u';

                if specifier == "size" {
                    return this.context.IntegerPointerType(signed);
                } else {
                    let width = specifier.ToUnsignedInteger() as u32;

                    if width != 8 && width != 16 && width != 32 && width != 64 && width != 128 {
                        Logger::Log("Invalid integer type '" + name + "'.", path, LogSeverity::Error);
                        return null;
                    }

                    return this.context.IntegerType(width, signed);
                }
            } else if name.StartsWith('f') {
                let width = name.SubString(1).ToUnsignedInteger() as u32;

                if width != 32 && width != 64 {
                    Logger::Log("Invalid float type '" + name + "'.", path, LogSeverity::Error);
                    return null;
                }

                return this.context.FloatType(width);
            }
        }

        let mut generic = false;
        let symbols = this.scope_manager.ResolveType(path, false);
        if symbols.Empty() { return null; }

        for symbol in symbols {
            if symbol->kind == SymbolKind::Type {
                return symbol->_type;
            } else if symbol->kind == SymbolKind::Generic {
                generic = true;
            }
        }

        if generic {
            Logger::Log("Generic '" + path->ToString() + "' requires type arguments.", path, LogSeverity::Error);
        } else {
            Logger::Log("Symbol '" + path->ToString() + "' cannot be used as a type.", path, LogSeverity::Error);
        } return null;
    }

    pub fn LowerType(&mut this, _type: *ASTType) -> *HIRType {
        if _type == null {
            return this.context.VoidType();
        }

        if _type->kind == ASTTypeKind::Path {
            return this.LowerType((_type as *ASTPathType)->path);
        } else if _type->kind == ASTTypeKind::Pointer {
            let pointer = _type as *ASTPointerType;
            let pointee = this.LowerType(pointer->pointee);
            if pointee == null { return null; }
            return this.context.PointerType(pointee, pointer->mutable);
        } else if _type->kind == ASTTypeKind::Reference {
            let reference = _type as *ASTReferenceType;
            let pointee = this.LowerType(reference->pointee);
            if pointee == null { return null; }
            return this.context.ReferenceType(pointee, reference->mutable);
        } else if _type->kind == ASTTypeKind::Array {
            let array = _type as *ASTArrayType;
            let element = this.LowerType(array->element);
            if element == null { return null; }

            if array->length != null {
                let length = this.LowerExpression(array->length);
                if length == null { return null; }

                if length->kind != HIRExpressionKind::Literal && (length as *HIRLiteral)->kind != HIRLiteralKind::Integer {
                    Logger::Log("Array length must be an integer literal.", array->length, LogSeverity::Error);
                    return null;
                }

                return this.context.ArrayType(element, (length as *HIRIntegerLiteral)->value as usize);
            } else {
                return this.context.PointerType(element, true);
            }
        } else if _type->kind == ASTTypeKind::Function {
            let function = _type as *ASTFunctionType;
            let mut parameters = Vector<*HIRType>();

            for parameter in function->parameters {
                let _type = this.LowerType(parameter);
                if _type == null { return null; }
                parameters.PushBack(_type);
            }

            let _return = this.LowerType(function->_return);
            if _return == null { return null; }
            return this.context.FunctionType(parameters, _return);
        } else {
            Logger::Log("Unknown type '" + _type->kind.ToString() + "'.", _type, LogSeverity::Error);
            return null;
        }
    }
}

static mut hir_lowerer: *mut HIRLowerer = null;
