#[include "std/map", "std/arena", "src/HIR.zir", "src/MIR.zir", "src/Mangler.zir" : *]

class MIRLowerer {
    pub context: MIRContext,
    builder: MIRBuilder,
    target_info: TargetInfo,
    bindings: Map<*HIRIdentifierPattern, *MIRValue>,
    parameters: Map<*HIRDeclaration, *MIRValue>,
    temporaries: Map<*HIRExpression, *MIRValue>,
    namespaces: Vector<String>,
    strings: Map<String, *MIRStaticDeclaration>,
    declarations: Map<*HIRDeclaration, *mut MIRTypedDeclaration>,
    types: Map<*HIRType, *mut MIRTypedDeclaration>,
    runtime_functions: Map<String, *MIRFunctionDeclaration>,
    break_blocks: Vector<*mut MIRBlock>,
    continue_blocks: Vector<*mut MIRBlock>,
    break_destinations: Vector<*MIRValue>,
    indirect_return: *MIRValue,
    current_return: *HIRType,
    module: *mut MIRModule;

    MIRLowerer(&mut this, target_info: &TargetInfo) {
        this.target_info = target_info;
    }

    pub fn Lower(&mut this, module: *HIRModule) -> *MIRModule {
        this.module = this.context.arena.New<MIRModule>();
        this.builder = MIRBuilder(&mut this.context, this.module);
        this.LowerModule(module);
        this.module
    }

    fn LowerModule(&mut this, module: *HIRModule) {
        for declaration in module->declarations {
            this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFifthPass(declaration);
        }
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *HIRDeclaration) {
        match declaration->kind {
            HIRDeclarationKind::Class => {
                this.LowerClassDeclarationFirstPass(declaration as *HIRClassDeclaration);
            },
            HIRDeclarationKind::Structure => {
                this.LowerStructureDeclarationFirstPass(declaration as *HIRStructureDeclaration);
            },
            HIRDeclarationKind::Variant => {
                this.LowerVariantDeclarationFirstPass(declaration as *HIRVariantDeclaration);
            },
            HIRDeclarationKind::Assembly => {
                this.LowerAssemblyDeclaration(declaration as *HIRAssemblyDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *HIRDeclaration) {
        match declaration->kind {
            HIRDeclarationKind::Class => {
                this.LowerClassDeclarationSecondPass(declaration as *HIRClassDeclaration);
            },
            HIRDeclarationKind::Structure => {
                this.LowerStructureDeclarationSecondPass(declaration as *HIRStructureDeclaration);
            },
            HIRDeclarationKind::Variant => {
                this.LowerVariantDeclarationSecondPass(declaration as *HIRVariantDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *HIRDeclaration) {
        match declaration->kind {
            HIRDeclarationKind::Constant => {
                this.LowerConstantDeclarationFirstPass(declaration as *HIRConstantDeclaration);
            },
            HIRDeclarationKind::Static => {
                this.LowerStaticDeclarationFirstPass(declaration as *HIRStaticDeclaration);
            },
            HIRDeclarationKind::Class => {
                this.LowerClassDeclarationThirdPass(declaration as *HIRClassDeclaration);
            },
            HIRDeclarationKind::Structure => {
                this.LowerStructureDeclarationThirdPass(declaration as *HIRStructureDeclaration);
            },
            HIRDeclarationKind::Variant => {
                this.LowerVariantDeclarationThirdPass(declaration as *HIRVariantDeclaration);
            },
            HIRDeclarationKind::Extend => {
                this.LowerExtendDeclarationFirstPass(declaration as *HIRExtendDeclaration);
            },
            HIRDeclarationKind::Function => {
                this.LowerFunctionDeclarationFirstPass(declaration as *HIRFunctionDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *HIRDeclaration) {
        match declaration->kind {
            HIRDeclarationKind::Constant => {
                this.LowerConstantDeclarationSecondPass(declaration as *HIRConstantDeclaration);
            },
            HIRDeclarationKind::Static => {
                this.LowerStaticDeclarationSecondPass(declaration as *HIRStaticDeclaration);
            },
            _ => {}
        }
    }

    fn LowerDeclarationFifthPass(&mut this, declaration: *HIRDeclaration) {
        match declaration->kind {
            HIRDeclarationKind::Class => {
                this.LowerClassDeclarationFourthPass(declaration as *HIRClassDeclaration);
            },
            HIRDeclarationKind::Structure => {
                this.LowerStructureDeclarationFourthPass(declaration as *HIRStructureDeclaration);
            },
            HIRDeclarationKind::Variant => {
                this.LowerVariantDeclarationFourthPass(declaration as *HIRVariantDeclaration);
            },
            HIRDeclarationKind::Extend => {
                this.LowerExtendDeclarationSecondPass(declaration as *HIRExtendDeclaration);
            },
            HIRDeclarationKind::Function => {
                this.LowerFunctionDeclarationSecondPass(declaration as *HIRFunctionDeclaration);
            },
            _ => {}
        }
    }

    fn LowerConstantDeclarationFirstPass(&mut this, constant: *HIRConstantDeclaration) {
        let _type = this.LowerType(constant->_type);
        if _type == null { return; }
        this.declarations[constant] = this.builder.BuildConstant(constant->name, _type, null);
    }

    fn LowerConstantDeclarationSecondPass(&mut this, constant: *HIRConstantDeclaration) {
        let initializer = this.LowerConstantExpression(constant->initializer);
        if initializer == null { return; }
        (this.declarations[constant] as *mut MIRConstantDeclaration)->initializer = initializer;
    }

    fn LowerLinkage(&this, linkage: HIRDeclarationLinkage) -> MIRDeclarationLinkage {
        match linkage {
            HIRDeclarationLinkage::Private => MIRDeclarationLinkage::Private,
            HIRDeclarationLinkage::Internal => MIRDeclarationLinkage::Internal,
            _ => MIRDeclarationLinkage::External,
        }
    }

    fn LowerStaticDeclarationFirstPass(&mut this, _static: *HIRStaticDeclaration) {
        let _type = this.LowerType(_static->_type);
        if _type == null { return; }
        this.declarations[_static] = this.builder.BuildStatic(_static->name, _type, _static->mutable, null, this.LowerLinkage(_static->linkage));
    }

    fn LowerStaticDeclarationSecondPass(&mut this, _static: *HIRStaticDeclaration) {
        if _static->initializer == null { return; }
        let initializer = this.LowerConstantExpression(_static->initializer);
        if initializer == null { return; }
        (this.declarations[_static] as *mut MIRStaticDeclaration)->initializer = initializer;
    }

    fn IsAggregate(&mut this, _type: *HIRType) -> bool {
        _type != null && _type->HasSpecialMembers()
    }

    fn IsIndirectAggregate(&mut this, _type: *HIRType) -> bool {
        if !this.IsAggregate(_type) { return false; }
        let size = _type->Size();
        (size != 1 && size != 2 && size != 4 && size != 8) || !_type->IsTrivial()
    }

    fn LowerAggregateType(&mut this, _type: *HIRType) -> *MIRType {
        let lowered_type = this.LowerType(_type);

        if !this.IsAggregate(_type) {
            lowered_type
        } else if this.IsIndirectAggregate(_type) {
            this.context.PointerType(lowered_type)
        } else {
            this.context.IntegerType(_type->Size() as u32 * 8)
        }
    }

    fn LowerFunctionDeclarationFirstPass(&mut this, function: *HIRFunctionDeclaration) {
        let mut name = function->name;

        if function->abi == HIRDeclarationABI::Native && !function->no_mangle {
            let mut types = Vector<*HIRType>();
            if function->instance != null { types = function->instance->types; }
            name = Mangler::MangleFunction(name, function->_type, types, this.namespaces);
        }

        let mut parameters = Vector<*MIRParameter>();
        let mut _return = this.LowerAggregateType(function->_return);
        if _return == null { return; }

        if this.IsIndirectAggregate(function->_return) {
            let lowered_parameter = this.builder.BuildParameter("sret".ToString(), 0, _return);
            (_return, lowered_parameter->sret) = (this.context.VoidType(), this.LowerType(function->_return));
            parameters.PushBack(lowered_parameter);
        }

        for parameter in function->parameters {
            let lowered_type = this.LowerAggregateType(parameter->_type);
            let lowered_parameter = this.builder.BuildParameter(parameter->name, parameters.Size() as u32, lowered_type);
            parameters.PushBack(lowered_parameter);

            if this.IsAggregate(parameter->_type) && lowered_type->kind == MIRTypeKind::Pointer && function->abi == HIRDeclarationABI::C {
                lowered_parameter->byval = this.LowerType(parameter->_type);
            }
        }

        this.declarations[function] = this.builder.BuildFunction(name, parameters, _return, this.LowerLinkage(function->linkage));
    }

    fn LowerFunctionDeclarationSecondPass(&mut this, function: *HIRFunctionDeclaration) {
        if function->body == null { return; }
        this.builder.SetCurrentFunction(this.declarations[function] as *mut MIRFunctionDeclaration);
        this.builder.SetCurrentBlock(this.builder.BuildBlock("entry".ToString()));
        let indirect_return = this.IsIndirectAggregate(function->_return);
        this.current_return = function->_return;

        if indirect_return {
            this.indirect_return = this.builder.GetCurrentFunction()->parameters[0];
        } else {
            this.indirect_return = null;
        }

        for i in 0..function->parameters.Size() {
            let parameter = function->parameters[i];
            let lowered = this.builder.GetCurrentFunction()->parameters[(indirect_return ? 1 : 0) + i];

            if this.IsIndirectAggregate(parameter->_type) {
                this.parameters[parameter] = lowered;
            } else if this.IsAggregate(parameter->_type) {
                let alloca = this.builder.BuildAlloca(parameter->name, this.LowerType(parameter->_type));
                let target = this.context.PointerType(this.LowerAggregateType(parameter->_type));
                let pointer = this.builder.BuildCast("abi.cast".ToString(), MIRCastKind::Bitcast, alloca, target);
                this.builder.BuildStore(lowered, pointer)->alignment = parameter->_type->Alignment() as u32;
                this.parameters[parameter] = alloca;
            } else if parameter->addressable {
                let alloca = this.builder.BuildAlloca(parameter->name, this.LowerType(parameter->_type));
                this.builder.BuildStore(lowered, alloca);
                this.parameters[parameter] = alloca;
            } else {
                this.parameters[parameter] = lowered;
            }
        }

        this.LowerBlockExpression(function->body, null);

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            if function->_return->IsVoid() {
                this.builder.BuildReturn(null);
            } else {
                this.builder.BuildUnreachable();
            }
        }

        this.temporaries.Clear();
        this.parameters.Clear();
        this.bindings.Clear();
    }

    fn LowerClassDeclarationFirstPass(&mut this, _class: *HIRClassDeclaration) {
        this.types[_class->_type] = this.builder.BuildType(_class->name, this.context.StructureType(_class->name));
    }

    fn LowerClassDeclarationSecondPass(&mut this, _class: *HIRClassDeclaration) {
        let mut fields = Vector<*MIRType>();

        for parent in _class->parents {
            let lowered_parent = this.LowerType(parent);
            if lowered_parent == null { return; }
            fields.PushBack(lowered_parent);
        }

        for field in _class->fields {
            let lowered_field = this.LowerType(field->_type);
            if lowered_field == null { return; }
            fields.PushBack(lowered_field);
        }

        (this.types[_class->_type]->_type as *mut MIRStructureType)->SetBody(fields);
    }

    fn LowerClassDeclarationThirdPass(&mut this, _class: *HIRClassDeclaration) {
        let mut types = Vector<*HIRType>();
        if _class->instance != null { types = _class->instance->types; }
        this.namespaces.PushBack(Mangler::MangleName(_class->name, types, this.namespaces));

        for constructor in _class->constructors {
            this.LowerFunctionDeclarationFirstPass(constructor);
        }

        if _class->destructor != null {
            this.LowerFunctionDeclarationFirstPass(_class->destructor);
        }

        for method in _class->methods {
            this.LowerFunctionDeclarationFirstPass(method);
        }

        this.namespaces.PopBack();
    }

    fn LowerClassDeclarationFourthPass(&mut this, _class: *HIRClassDeclaration) {
        for constructor in _class->constructors {
            this.LowerFunctionDeclarationSecondPass(constructor);
        }

        if _class->destructor != null {
            this.LowerFunctionDeclarationSecondPass(_class->destructor);
        }

        for method in _class->methods {
            this.LowerFunctionDeclarationSecondPass(method);
        }
    }

    fn LowerStructureDeclarationFirstPass(&mut this, structure: *HIRStructureDeclaration) {
        this.types[structure->_type] = this.builder.BuildType(structure->name, this.context.StructureType(structure->name));
    }

    fn LowerStructureDeclarationSecondPass(&mut this, structure: *HIRStructureDeclaration) {
        let mut fields = Vector<*MIRType>();

        for field in structure->fields {
            let lowered_field = this.LowerType(field->_type);
            if lowered_field == null { return; }
            fields.PushBack(lowered_field);
        }

        (this.types[structure->_type]->_type as *mut MIRStructureType)->SetBody(fields);
    }

    fn LowerStructureDeclarationThirdPass(&mut this, structure: *HIRStructureDeclaration) {
        let mut types = Vector<*HIRType>();
        if structure->instance != null { types = structure->instance->types; }
        this.namespaces.PushBack(Mangler::MangleName(structure->name, types, this.namespaces));

        if structure->copy_constructor != null {
            this.LowerFunctionDeclarationFirstPass(structure->copy_constructor);
        }

        if structure->destructor != null {
            this.LowerFunctionDeclarationFirstPass(structure->destructor);
        }

        for method in structure->methods {
            this.LowerFunctionDeclarationFirstPass(method);
        }

        if structure->copy_assign != null {
            this.LowerFunctionDeclarationFirstPass(structure->copy_assign);
        }

        this.namespaces.PopBack();
    }

    fn LowerStructureDeclarationFourthPass(&mut this, structure: *HIRStructureDeclaration) {
        if structure->copy_constructor != null {
            this.LowerFunctionDeclarationSecondPass(structure->copy_constructor);
        }

        if structure->destructor != null {
            this.LowerFunctionDeclarationSecondPass(structure->destructor);
        }

        for method in structure->methods {
            this.LowerFunctionDeclarationSecondPass(method);
        }

        if structure->copy_assign != null {
            this.LowerFunctionDeclarationSecondPass(structure->copy_assign);
        }
    }

    fn LowerVariantDeclarationFirstPass(&mut this, variant: *HIRVariantDeclaration) {
        this.types[variant->_type] = this.builder.BuildType(variant->name, this.context.StructureType(variant->name));
    }

    fn LowerVariantDeclarationSecondPass(&mut this, variant: *HIRVariantDeclaration) {
        let alignment = variant->_type->Alignment();
        let mut fields = Vector<*MIRType>();
        fields.PushBack(this.context.ArrayType(this.context.IntegerType(alignment as u32 * 8), variant->_type->Size() / alignment));
        (this.types[variant->_type]->_type as *mut MIRStructureType)->SetBody(fields);
    }

    fn LowerVariantDeclarationThirdPass(&mut this, variant: *HIRVariantDeclaration) {
        let mut types = Vector<*HIRType>();
        if variant->instance != null { types = variant->instance->types; }
        this.namespaces.PushBack(Mangler::MangleName(variant->name, types, this.namespaces));

        if variant->copy_constructor != null {
            this.LowerFunctionDeclarationFirstPass(variant->copy_constructor);
        }

        if variant->destructor != null {
            this.LowerFunctionDeclarationFirstPass(variant->destructor);
        }

        for method in variant->methods {
            this.LowerFunctionDeclarationFirstPass(method);
        }

        if variant->copy_assign != null {
            this.LowerFunctionDeclarationFirstPass(variant->copy_assign);
        }

        this.namespaces.PopBack();
    }

    fn LowerVariantDeclarationFourthPass(&mut this, variant: *HIRVariantDeclaration) {
        if variant->copy_constructor != null {
            this.LowerFunctionDeclarationSecondPass(variant->copy_constructor);
        }

        if variant->destructor != null {
            this.LowerFunctionDeclarationSecondPass(variant->destructor);
        }

        for method in variant->methods {
            this.LowerFunctionDeclarationSecondPass(method);
        }

        if variant->copy_assign != null {
            this.LowerFunctionDeclarationSecondPass(variant->copy_assign);
        }
    }

    fn LowerExtendDeclarationFirstPass(&mut this, _extend: *HIRExtendDeclaration) {
        this.namespaces.PushBack(Mangler::MangleName(_extend->name, Vector<*HIRType>(), this.namespaces));

        for method in _extend->methods {
            this.LowerFunctionDeclarationFirstPass(method);
        }

        this.namespaces.PopBack();
    }

    fn LowerExtendDeclarationSecondPass(&mut this, _extend: *HIRExtendDeclaration) {
        for method in _extend->methods {
            this.LowerFunctionDeclarationSecondPass(method);
        }
    }

    fn LowerAssemblyDeclaration(&mut this, assembly: *HIRAssemblyDeclaration) {
        this.builder.BuildAssembly(assembly->text);
    }

    fn LowerStatement(&mut this, statement: *HIRStatement) {
        match statement->kind {
            HIRStatementKind::Variable => {
                this.LowerLetStatement(statement as *HIRLetStatement);
            },
            HIRStatementKind::Expression => {
                let expression = (statement as *HIRExpressionStatement)->expression;

                if expression->IsControl() && !expression->_type->HasSpecialMembers() {
                    this.LowerControlExpression(expression, null);
                } else {
                    this.LowerExpression(expression);
                }
            },
            HIRStatementKind::Assembly => {
                this.LowerAssemblyStatement(statement as *HIRAssemblyStatement);
            }
        }
    }

    fn LowerLetStatement(&mut this, _let: *HIRLetStatement) {
        this.BindPattern(_let->pattern);
    }

    fn LowerAssemblyStatement(&mut this, assembly: *HIRAssemblyStatement) {
        let mut inputs = Vector<*MIRAssemblyOperand>();

        for input in assembly->inputs {
            let value = this.LowerExpression(input->expression);
            if value == null { continue; }
            inputs.PushBack(this.builder.BuildAssemblyOperand(input->name, value));
        }

        let mut outputs = Vector<*MIRAssemblyOperand>();

        for output in assembly->outputs {
            let value = this.LowerPlaceExpression(output->expression);
            if value == null { continue; }
            outputs.PushBack(this.builder.BuildAssemblyOperand(output->name, value));
        }

        this.builder.BuildAssembly(assembly->_volatile, assembly->text, inputs, outputs, assembly->clobbers);
    }

    fn EnsureReachable(&mut this) {
        if this.builder.GetCurrentBlock()->HasTerminator() {
            this.builder.SetCurrentBlock(this.builder.BuildBlock("unreachable".ToString()));
        }
    }

    fn LowerControlExpression(&mut this, expression: *HIRExpression, destination: *MIRValue) {
        match expression->kind {
            HIRExpressionKind::Block => {
                this.LowerBlockExpression(expression as *HIRBlockExpression, destination);
            },
            HIRExpressionKind::If => {
                this.LowerIfExpression(expression as *HIRIfExpression, destination);
            },
            HIRExpressionKind::While => {
                this.LowerWhileExpression(expression as *HIRWhileExpression);
            },
            HIRExpressionKind::Loop => {
                this.LowerLoopExpression(expression as *HIRLoopExpression, destination);
            },
            HIRExpressionKind::For => {
                this.LowerForExpression(expression as *HIRForExpression);
            },
            HIRExpressionKind::Match => {
                this.LowerMatchExpression(expression as *HIRMatchExpression, destination);
            },
            HIRExpressionKind::Return => {
                this.LowerReturnExpression(expression as *HIRReturnExpression);
            },
            HIRExpressionKind::Break => {
                this.LowerBreakExpression(expression as *HIRBreakExpression);
            },
            HIRExpressionKind::Continue => {
                this.LowerContinueExpression(expression as *HIRContinueExpression);
            },
            _ => {
                if destination != null {
                    this.LowerExpressionTo(expression, destination);
                } else {
                    this.LowerExpression(expression);
                }
            }
        }
    }

    fn LowerBlockExpression(&mut this, block: *HIRBlockExpression, destination: *MIRValue) {
        for statement in block->statements {
            if this.builder.GetCurrentBlock()->HasTerminator() { break; }
            this.LowerStatement(statement);
        }

        if block->tail != null && !this.builder.GetCurrentBlock()->HasTerminator() {
            this.LowerControlExpression(block->tail, destination);
        }

        for destructor in block->destructors {
            if this.builder.GetCurrentBlock()->HasTerminator() { break; }
            this.LowerExpression(destructor);
        }
    }

    fn LowerIfExpression(&mut this, _if: *HIRIfExpression, destination: *MIRValue) {
        let mut condition: *MIRValue = null;

        if _if->condition->pattern != null {
            let target = this.LowerPlaceExpression(_if->condition->expression);
            if target == null { return; }
            condition = this.TestPattern(_if->condition->pattern, target);
            if condition == null { return; }
        } else {
            condition = this.LowerExpression(_if->condition->expression);
            if condition == null { return; }
        }

        for destructor in _if->destructors {
            this.LowerExpression(destructor);
        }

        let then_block = this.builder.BuildBlock("if.then".ToString());
        let mut merge_block: *mut MIRBlock = null;

        if _if->else_body == null {
            merge_block = this.builder.BuildBlock("if.merge".ToString());
            this.builder.BuildConditionalBranch(condition, then_block, merge_block);
        } else {
            let else_block = this.builder.BuildBlock("if.else".ToString());
            this.builder.BuildConditionalBranch(condition, then_block, else_block);
            this.builder.SetCurrentBlock(else_block);
            this.LowerControlExpression(_if->else_body, destination);

            if !this.builder.GetCurrentBlock()->HasTerminator() {
                merge_block = this.builder.BuildBlock("if.merge".ToString());
                this.builder.BuildBranch(merge_block);
            }
        }

        this.builder.SetCurrentBlock(then_block);

        if _if->condition->pattern != null {
            this.BindPattern(_if->condition->pattern);
        }

        this.LowerBlockExpression(_if->then_body, destination);

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            if merge_block == null {
                merge_block = this.builder.BuildBlock("if.merge".ToString());
            } this.builder.BuildBranch(merge_block);
        }

        if merge_block != null {
            this.builder.SetCurrentBlock(merge_block);
        }
    }

    fn LowerWhileExpression(&mut this, _while: *HIRWhileExpression) {
        let condition_block = this.builder.BuildBlock("while.cond".ToString());
        let body_block = this.builder.BuildBlock("while.body".ToString());
        let end_block = this.builder.BuildBlock("while.end".ToString());
        this.builder.BuildBranch(condition_block);

        this.builder.SetCurrentBlock(condition_block);
        let mut condition: *MIRValue = null;

        if _while->condition->pattern != null {
            let target = this.LowerPlaceExpression(_while->condition->expression);
            if target == null { return; }
            condition = this.TestPattern(_while->condition->pattern, target);
            if condition == null { return; }
        } else {
            condition = this.LowerExpression(_while->condition->expression);
            if condition == null { return; }
        }

        for destructor in _while->destructors {
            this.LowerExpression(destructor);
        }

        this.builder.BuildConditionalBranch(condition, body_block, end_block);
        this.builder.SetCurrentBlock(body_block);

        if _while->condition->pattern != null {
            this.BindPattern(_while->condition->pattern);
        }

        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(condition_block);
        this.break_destinations.PushBack(null);
        this.LowerBlockExpression(_while->while_body, null);
        this.break_destinations.PopBack();
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            this.builder.BuildBranch(condition_block);
        }

        this.builder.SetCurrentBlock(end_block);
    }

    fn LowerLoopExpression(&mut this, _loop: *HIRLoopExpression, destination: *MIRValue) {
        let body_block = this.builder.BuildBlock("loop.body".ToString());
        let end_block = this.builder.BuildBlock("loop.end".ToString());
        this.builder.BuildBranch(body_block);

        this.builder.SetCurrentBlock(body_block);
        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(body_block);
        this.break_destinations.PushBack(destination);
        this.LowerBlockExpression(_loop->body, null);
        this.break_destinations.PopBack();
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            this.builder.BuildBranch(body_block);
        }

        this.builder.SetCurrentBlock(end_block);
    }

    fn LowerForExpression(&mut this, _for: *HIRForExpression) {
        this.BindPattern(_for->iterator);
        this.BindPattern(_for->target);

        let condition_block = this.builder.BuildBlock("for.cond".ToString());
        let body_block = this.builder.BuildBlock("for.body".ToString());
        let step_block = this.builder.BuildBlock("for.step".ToString());
        let end_block = this.builder.BuildBlock("for.end".ToString());
        this.builder.BuildBranch(condition_block);

        this.builder.SetCurrentBlock(condition_block);
        let condition = this.LowerExpression(_for->condition);
        if condition == null { return; }
        this.builder.BuildConditionalBranch(condition, body_block, end_block);

        this.builder.SetCurrentBlock(body_block);
        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(step_block);
        this.break_destinations.PushBack(null);
        this.LowerBlockExpression(_for->body, null);
        this.break_destinations.PopBack();
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            this.builder.BuildBranch(step_block);
        }

        this.builder.SetCurrentBlock(step_block);
        this.LowerExpression(_for->step);

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            this.builder.BuildBranch(condition_block);
        }

        this.builder.SetCurrentBlock(end_block);

        for destructor in _for->destructors {
            this.LowerExpression(destructor);
        }
    }

    fn LowerMatchExpression(&mut this, _match: *HIRMatchExpression, destination: *MIRValue) {
        let target = this.LowerPlaceExpression(_match->target);
        if target == null { return; }

        for destructor in _match->destructors {
            this.LowerExpression(destructor);
        }

        let merge_block = this.builder.BuildBlock("match.merge".ToString());

        for arm in _match->arms {
            let result = this.TestPattern(arm->pattern, target);
            if result == null { return; }
            let body_block = this.builder.BuildBlock("match.body".ToString());
            let next_block = this.builder.BuildBlock("match.next".ToString());
            this.builder.BuildConditionalBranch(result, body_block, next_block);
            this.builder.SetCurrentBlock(body_block);
            this.BindPattern(arm->pattern);

            if arm->guard != null {
                let guard = this.LowerExpression(arm->guard);
                if guard == null { return; }

                for destructor in arm->destructors {
                    this.LowerExpression(destructor);
                }

                let guard_block = this.builder.BuildBlock("match.guard".ToString());
                this.builder.BuildConditionalBranch(guard, guard_block, next_block);
                this.builder.SetCurrentBlock(guard_block);
            }

            this.LowerBlockExpression(arm->body, destination);

            if !this.builder.GetCurrentBlock()->HasTerminator() {
                this.builder.BuildBranch(merge_block);
            }

            this.builder.SetCurrentBlock(next_block);
        }

        if !this.builder.GetCurrentBlock()->HasTerminator() {
            if _match->IsExhaustive() {
                this.builder.BuildUnreachable();
            } else {
                this.builder.BuildBranch(merge_block);
            }
        }

        this.builder.SetCurrentBlock(merge_block);
    }

    fn LowerReturnExpression(&mut this, _return: *HIRReturnExpression) {
        if this.indirect_return != null {
            this.LowerExpressionTo(_return->value, this.indirect_return);
            for destructor in _return->destructors { this.LowerExpression(destructor); }
            this.builder.BuildReturn(null);
        } else if this.IsAggregate(this.current_return) {
            let _type = this.LowerType(this.current_return);
            if _type == null { return; }
            let alloca = this.builder.BuildAlloca("abi.aggregate".ToString(), _type);
            this.LowerExpressionTo(_return->value, alloca);
            let target = this.context.PointerType(this.LowerAggregateType(this.current_return));
            let pointer = this.builder.BuildCast("abi.cast".ToString(), MIRCastKind::Bitcast, alloca, target);
            let load = this.builder.BuildLoad("abi.value".ToString(), pointer);
            load->alignment = this.current_return->Alignment() as u32;
            for destructor in _return->destructors { this.LowerExpression(destructor); }
            this.builder.BuildReturn(load);
        } else {
            let mut value: *MIRValue = null;

            if _return->value != null {
                value = this.LowerExpression(_return->value);
                if value == null { return; }
            }

            for destructor in _return->destructors {
                this.LowerExpression(destructor);
            } this.builder.BuildReturn(value);
        }
    }

    fn LowerBreakExpression(&mut this, _break: *HIRBreakExpression) {
        if _break->value != null {
            let mut destination: *MIRValue = null;

            if !this.break_destinations.Empty() {
                destination = this.break_destinations.Back();
            }

            this.LowerControlExpression(_break->value, destination);
        }

        for destructor in _break->destructors {
            this.LowerExpression(destructor);
        }

        if !this.break_blocks.Empty() {
            this.builder.BuildBranch(this.break_blocks.Back());
        }
    }

    fn LowerContinueExpression(&mut this, _continue: *HIRContinueExpression) {
        for destructor in _continue->destructors {
            this.LowerExpression(destructor);
        }

        if !this.continue_blocks.Empty() {
            this.builder.BuildBranch(this.continue_blocks.Back());
        }
    }

    fn LowerConstantExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if expression->kind == HIRExpressionKind::Literal {
            let literal = expression as *HIRLiteral;
            let _type = this.LowerType(literal->_type);
            if _type == null { return null; }

            match literal->kind {
                HIRLiteralKind::String => {
                    return this.builder.ConstantString((literal as *HIRStringLiteral)->value, _type);
                },
                HIRLiteralKind::Array => {
                    let mut elements = Vector<*MIRValue>();

                    for element in (literal as *HIRArrayLiteral)->elements {
                        let lowered_element = this.LowerConstantExpression(element);
                        if lowered_element == null { return null; }
                        elements.PushBack(lowered_element);
                    }

                    return this.builder.ConstantArray(elements, _type);
                },
                HIRLiteralKind::Tuple => {
                    let mut elements = Vector<*MIRValue>();

                    for element in (literal as *HIRTupleLiteral)->elements {
                        let lowered_element = this.LowerConstantExpression(element);
                        if lowered_element == null { return null; }
                        elements.PushBack(lowered_element);
                    }

                    return this.builder.ConstantStruct(elements, _type);
                },
                HIRLiteralKind::Structure => {
                    let mut fields = Vector<*MIRValue>();

                    for field in (literal as *HIRStructureLiteral)->fields {
                        let lowered_field = this.LowerConstantExpression(field);
                        if lowered_field == null { return null; }
                        fields.PushBack(lowered_field);
                    }

                    return this.builder.ConstantStruct(fields, _type);
                },
                _ => {}
            }
        }

        this.LowerExpression(expression)
    }

    fn LowerPlaceExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if this.temporaries.Has(expression) {
            return this.temporaries[expression];
        } else {
            match expression->kind {
                HIRExpressionKind::BindingReference => {
                    return this.bindings.Get((expression as *HIRBindingReference)->binding, null);
                },
                HIRExpressionKind::DeclarationReference => {
                    let declaration = (expression as *HIRDeclarationReference)->declaration;

                    if this.declarations.Has(declaration) {
                        return this.builder.ReferenceDeclaration(this.declarations[declaration]);
                    } else if declaration->kind == HIRDeclarationKind::Parameter && (declaration as *HIRParameterDeclaration)->addressable {
                        return this.parameters.Get(declaration, null);
                    }
                },
                _ => {}
            }
        }

        match expression->kind {
            HIRExpressionKind::IndexAccess => this.LowerIndexAccessExpression(expression as *HIRIndexAccessExpression),
            HIRExpressionKind::TupleAccess => this.LowerTupleAccessExpression(expression as *HIRTupleAccessExpression),
            HIRExpressionKind::FieldAccess => this.LowerFieldAccessExpression(expression as *HIRFieldAccessExpression),
            HIRExpressionKind::MemberAccess => this.LowerMemberAccessExpression(expression as *HIRMemberAccessExpression),
            HIRExpressionKind::TagAccess => this.LowerTagAccessExpression(expression as *HIRTagAccessExpression),
            HIRExpressionKind::Unary if (expression as *HIRUnaryExpression)->kind == HIRUnaryKind::Dereference => this.LowerUnaryExpression(expression as *HIRUnaryExpression),
            HIRExpressionKind::Ternary if expression->category == HIRExpressionCategory::Place => this.LowerTernaryPlaceExpression(expression as *HIRTernaryExpression),
            _ => {
                let alloca = this.builder.BuildAlloca("temporary".ToString(), this.LowerType(expression->_type));
                this.LowerExpressionTo(expression, alloca);
                this.temporaries[expression] = alloca;
                alloca
            }
        }
    }

    fn LowerExpressionTo(&mut this, expression: *HIRExpression, destination: *MIRValue) {
        match expression->kind {
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Array => {
                this.LowerArrayLiteral(expression as *HIRArrayLiteral, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Tuple => {
                this.LowerTupleLiteral(expression as *HIRTupleLiteral, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Structure => {
                this.LowerStructureLiteral(expression as *HIRStructureLiteral, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind == HIRLiteralKind::Variant => {
                this.LowerVariantLiteral(expression as *HIRVariantLiteral, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Call => {
                this.LowerCallExpression(expression as *HIRCallExpression, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Constructor => {
                this.LowerConstructorExpression(expression as *HIRConstructorExpression, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Ternary if expression->category == HIRExpressionCategory::Value && this.IsAggregate(expression->_type) => {
                this.LowerTernaryExpressionTo(expression as *HIRTernaryExpression, destination);
                this.temporaries[expression] = destination;
            },
            HIRExpressionKind::Block | HIRExpressionKind::If | HIRExpressionKind::While | HIRExpressionKind::Loop | HIRExpressionKind::For | HIRExpressionKind::Match | HIRExpressionKind::Return | HIRExpressionKind::Break | HIRExpressionKind::Continue => {
                this.LowerControlExpression(expression, destination);
                this.temporaries[expression] = destination;
                this.EnsureReachable();
            },
            _ => {
                let value = this.LowerExpression(expression);
                if value == null { return; }
                this.builder.BuildStore(value, destination);
            }
        }
    }

    fn LowerExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if expression->kind == HIRExpressionKind::DeclarationReference {
            let declaration = (expression as *HIRDeclarationReference)->declaration;

            if declaration->kind == HIRDeclarationKind::Parameter && !(declaration as *HIRParameterDeclaration)->addressable {
                return this.parameters.Get(declaration, null);
            }
        }

        match expression->kind {
            HIRExpressionKind::Literal if (expression as *HIRLiteral)->kind != HIRLiteralKind::Array && (expression as *HIRLiteral)->kind != HIRLiteralKind::Tuple && (expression as *HIRLiteral)->kind != HIRLiteralKind::Structure && (expression as *HIRLiteral)->kind != HIRLiteralKind::Variant => this.LowerLiteral(expression as *HIRLiteral),
            HIRExpressionKind::Intrinsic => this.LowerIntrinsicExpression(expression as *HIRIntrinsicExpression),
            HIRExpressionKind::Assignment => this.LowerAssignmentExpression(expression as *HIRAssignmentExpression),
            HIRExpressionKind::Call if !this.IsAggregate(expression->_type) => this.LowerCallExpression(expression as *HIRCallExpression, null),
            HIRExpressionKind::Destructor => this.LowerDestructorExpression(expression as *HIRDestructorExpression),
            HIRExpressionKind::New => this.LowerNewExpression(expression as *HIRNewExpression),
            HIRExpressionKind::Delete => this.LowerDeleteExpression(expression as *HIRDeleteExpression),
            HIRExpressionKind::Cast => this.LowerCastExpression(expression as *HIRCastExpression),
            HIRExpressionKind::Unary if (expression as *HIRUnaryExpression)->kind != HIRUnaryKind::Dereference => this.LowerUnaryExpression(expression as *HIRUnaryExpression),
            HIRExpressionKind::Binary => this.LowerBinaryExpression(expression as *HIRBinaryExpression),
            HIRExpressionKind::Ternary if !this.IsAggregate(expression->_type) => this.LowerTernaryExpression(expression as *HIRTernaryExpression),
            HIRExpressionKind::Block | HIRExpressionKind::If | HIRExpressionKind::While | HIRExpressionKind::Loop | HIRExpressionKind::For | HIRExpressionKind::Match | HIRExpressionKind::Return | HIRExpressionKind::Break | HIRExpressionKind::Continue if expression->_type->IsVoid() || expression->_type->IsNever() => {
                this.LowerControlExpression(expression, null);
                this.EnsureReachable();
                this.builder.ConstantUndef(this.LowerType(expression->_type))
            },
            _ => {
                let place = this.LowerPlaceExpression(expression);
                if place == null { return null; }
                if place->_type->kind == MIRTypeKind::Function { return place; }
                this.builder.BuildLoad("load".ToString(), place)
            }
        }
    }

    fn LowerLiteral(&mut this, literal: *HIRLiteral) -> *MIRValue {
        let _type = this.LowerType(literal->_type);

        match literal->kind {
            HIRLiteralKind::Boolean => this.builder.ConstantInteger((literal as *HIRBooleanLiteral)->value ? 1 : 0, _type),
            HIRLiteralKind::Character => this.builder.ConstantInteger((literal as *HIRCharacterLiteral)->value as u64, _type),
            HIRLiteralKind::Integer => this.builder.ConstantInteger((literal as *HIRIntegerLiteral)->value, _type),
            HIRLiteralKind::Float => this.builder.ConstantFloat((literal as *HIRFloatLiteral)->value, _type),
            HIRLiteralKind::String => {
                let value = (literal as *HIRStringLiteral)->value;
                let mut _static: *MIRStaticDeclaration = null;

                if this.strings.Has(value) {
                    _static = this.strings[value];
                } else {
                    let name = "string." + String::FromInteger(this.strings.Size() as u64);
                    let array_type = this.context.ArrayType(this.context.IntegerType(8), value.Length() + 1);
                    let initializer = this.builder.ConstantString(value, array_type);
                    _static = this.builder.BuildStatic(name, array_type, false, initializer, MIRDeclarationLinkage::Private);
                    this.strings[value] = _static;
                }

                let reference = this.builder.ReferenceDeclaration(_static);
                this.builder.BuildCast("string.cast".ToString(), MIRCastKind::Bitcast, reference, _type)
            },
            HIRLiteralKind::Null => this.builder.ConstantNull(_type),
            _ => null
        }
    }

    fn LowerArrayLiteral(&mut this, literal: *HIRArrayLiteral, destination: *MIRValue) {
        let _type = this.LowerType(literal->_type) as *MIRArrayType;
        if _type == null { return; }
        let base = this.builder.BuildCast("array.cast".ToString(), MIRCastKind::Bitcast, destination, this.context.PointerType(_type->element));
        let size_type = this.context.IntegerType(this.target_info.pointer_size as u32 * 8);

        for i in 0..literal->elements.Size() {
            this.LowerExpressionTo(literal->elements[i], this.builder.BuildArrayGEP("array.element".ToString(), base, this.builder.ConstantInteger(i as u64, size_type)));
        }
    }

    fn LowerTupleLiteral(&mut this, literal: *HIRTupleLiteral, destination: *MIRValue) {
        let _type = this.LowerType(literal->_type) as *MIRStructureType;
        if _type == null { return; }

        for i in 0..literal->elements.Size() {
            this.LowerExpressionTo(literal->elements[i], this.builder.BuildStructGEP("tuple.element".ToString(), destination, i as u32, this.context.PointerType(_type->fields[i])));
        }
    }

    fn LowerStructureLiteral(&mut this, literal: *HIRStructureLiteral, destination: *MIRValue) {
        let _type = this.LowerType(literal->_type) as *MIRStructureType;
        if _type == null { return; }

        for i in 0..literal->fields.Size() {
            this.LowerExpressionTo(literal->fields[i], this.builder.BuildStructGEP("struct.field".ToString(), destination, i as u32, this.context.PointerType(_type->fields[i])));
        }
    }

    fn LowerVariantLiteral(&mut this, literal: *HIRVariantLiteral, destination: *MIRValue) {
        let member = literal->member;
        let tag_type = this.context.IntegerType(8);
        let mut fields = Vector<*MIRType>();
        fields.PushBack(tag_type);

        for field in member->fields {
            fields.PushBack(this.LowerType(field->_type));
        }

        let member_type = this.context.StructureType(fields);
        let pointer = this.builder.BuildCast("variant.cast".ToString(), MIRCastKind::Bitcast, destination, this.context.PointerType(member_type));
        let tag_pointer = this.builder.BuildStructGEP("variant.tag".ToString(), pointer, 0, this.context.PointerType(tag_type));
        this.builder.BuildStore(this.builder.ConstantInteger(member->index as u64, tag_type), tag_pointer);

        for i in 0..literal->fields.Size() {
            this.LowerExpressionTo(literal->fields[i], this.builder.BuildStructGEP("variant.field".ToString(), pointer, (i + 1) as u32, this.context.PointerType(fields[i + 1])));
        }
    }

    fn LowerIntrinsicExpression(&mut this, intrinsic: *HIRIntrinsicExpression) -> *MIRValue {
        let value = intrinsic->kind == HIRIntrinsicKind::SizeOf ? intrinsic->_type->Size() : intrinsic->_type->Alignment();
        this.builder.ConstantInteger(value as u64, this.LowerType((intrinsic as *HIRExpression)->_type))
    }

    fn LowerAssignmentExpression(&mut this, assignment: *HIRAssignmentExpression) -> *MIRValue {
        let place = this.LowerPlaceExpression(assignment->left);
        let value = this.LowerExpression(assignment->right);
        if place == null || value == null { return null; }
        this.builder.BuildStore(value, place);
        value
    }

    fn LowerCallArguments(&mut this, arguments: Vector<*HIRExpression>, types: Vector<*HIRType>) -> Vector<*MIRValue> {
        let mut lowered_arguments = Vector<*MIRValue>();

        for i in 0..arguments.Size() {
            let (argument, _type) = (arguments[i], types[i]);

            if this.IsAggregate(_type) {
                let lowered_type = this.LowerType(_type);
                if lowered_type == null { return Vector<*MIRValue>(); }
                let alloca = this.builder.BuildAlloca("abi.aggregate".ToString(), lowered_type);
                this.LowerExpressionTo(argument, alloca);

                if this.IsIndirectAggregate(_type) {
                    lowered_arguments.PushBack(alloca);
                } else {
                    let target = this.context.PointerType(this.LowerAggregateType(_type));
                    let pointer = this.builder.BuildCast("abi.cast".ToString(), MIRCastKind::Bitcast, alloca, target);
                    let load = this.builder.BuildLoad("abi.value".ToString(), pointer);
                    load->alignment = _type->Alignment() as u32;
                    lowered_arguments.PushBack(load);
                }
            } else {
                let value = this.LowerExpression(argument);
                if value == null { return Vector<*MIRValue>(); }
                lowered_arguments.PushBack(value);
            }
        }

        lowered_arguments
    }

    fn LowerCallExpression(&mut this, call: *HIRCallExpression, destination: *MIRValue) -> *MIRValue {
        let _return = call->callee->_type->Return();
        let parameters = call->callee->_type->Parameters();
        let callee = this.LowerExpression(call->callee);
        if callee == null { return null; }

        let mut arguments = Vector<*MIRValue>();
        if this.IsIndirectAggregate(_return) { arguments.PushBack(destination); }
        arguments += this.LowerCallArguments(call->arguments, parameters);
        let result = this.builder.BuildCall("call".ToString(), callee, arguments);

        if _return.IsNever() {
            this.builder.BuildUnreachable();
            this.builder.SetCurrentBlock(this.builder.BuildBlock("unreachable".ToString()));
        } else if this.IsIndirectAggregate(_return) {
            return destination;
        } else if this.IsAggregate(_return) {
            let target = this.context.PointerType(this.LowerAggregateType(_return));
            let pointer = this.builder.BuildCast("abi.cast".ToString(), MIRCastKind::Bitcast, destination, target);
            this.builder.BuildStore(result, pointer)->alignment = _return.Alignment() as u32;
            return destination;
        } else if destination != null {
            this.builder.BuildStore(result, destination);
        }

        result
    }

    fn LowerConstructorExpression(&mut this, constructor: *HIRConstructorExpression, destination: *MIRValue) -> *MIRValue {
        let callee = this.LowerExpression(constructor->callee);
        if callee == null { return null; }
        let mut arguments = Vector<*MIRValue>();
        arguments.PushBack(destination);
        let mut types = Vector<*HIRType>(constructor->callee->_type->Parameters());
        types.RemoveAt(0);
        arguments += this.LowerCallArguments(constructor->arguments, types);
        this.builder.BuildCall("constructor".ToString(), callee, arguments);
        destination
    }

    fn LowerDestructorExpression(&mut this, destructor: *HIRDestructorExpression) -> *MIRValue {
        let instance = this.LowerExpression(destructor->instance);
        if instance == null { return null; }
        let callee = this.LowerExpression(destructor->callee);
        if callee == null { return null; }
        let mut arguments = Vector<*MIRValue>();
        arguments.PushBack(instance);
        this.builder.BuildCall("destructor".ToString(), callee, arguments);
        null
    }

    fn LowerRuntimeFunction(&mut this, name: String, parameter_types: &Vector<*MIRType>, _return: *MIRType) -> *MIRFunctionDeclaration {
        for declaration in this.module->declarations {
            if declaration->kind == MIRDeclarationKind::Function {
                let function = declaration as *MIRFunctionDeclaration;

                if function->name == name {
                    return function;
                }
            }
        }

        let mut parameters = Vector<*MIRParameter>();

        for i in 0..parameter_types.Size() {
            parameters.PushBack(this.builder.BuildParameter('_' + String::FromInteger(i as u64), i as u32, parameter_types[i]));
        }

        if this.runtime_functions.Has(name) { return this.runtime_functions[name]; }
        let function = this.builder.BuildFunction(name, parameters, _return, MIRDeclarationLinkage::External);
        this.runtime_functions[name] = function;
        function
    }

    fn ArrayCookieSize(&mut this, element: *HIRType) -> u64 {
        let (pointer_size, alignment) = (this.target_info.pointer_size as u64, element->Alignment() as u64);
        alignment > pointer_size ? alignment : pointer_size
    }

    fn LowerNewExpression(&mut this, _new: *HIRNewExpression) -> *MIRValue {
        let mut parameters = Vector<*MIRType>();
        let size_type = this.context.IntegerType(this.target_info.pointer_size as u32 * 8);
        parameters.PushBack(size_type);
        let malloc = this.LowerRuntimeFunction("malloc".ToString(), parameters, this.context.PointerType(this.context.VoidType()));
        let mut allocation_size: *MIRValue = this.builder.ConstantInteger(_new->_type->Size() as u64, size_type);
        let callee = this.builder.ReferenceDeclaration(malloc);
        let mut pointer: *MIRValue = null;

        if _new->size != null {
            let size = this.LowerExpression(_new->size);
            if size == null { return null; }
            allocation_size = this.builder.BuildBinary("new.size".ToString(), MIRBinaryKind::Mul, size, allocation_size, size_type);
            let cookie_size = this.ArrayCookieSize(_new->_type);

            let mut arguments = Vector<*MIRValue>();
            arguments.PushBack(this.builder.BuildBinary("new.size".ToString(), MIRBinaryKind::Add, allocation_size, this.builder.ConstantInteger(cookie_size, size_type), size_type));
            pointer = this.builder.BuildCall("new".ToString(), callee, arguments);
            this.builder.BuildStore(size, this.builder.BuildCast("new.cast".ToString(), MIRCastKind::Bitcast, pointer, this.context.PointerType(size_type)));
            pointer = this.builder.BuildCast("new.cast".ToString(), MIRCastKind::Bitcast, pointer, this.context.PointerType(this.context.IntegerType(8)));
            pointer = this.builder.BuildArrayGEP("new.gep".ToString(), pointer, this.builder.ConstantInteger(cookie_size, size_type));
            pointer = this.builder.BuildCast("new.cast".ToString(), MIRCastKind::Bitcast, pointer, this.context.PointerType(this.LowerType(_new->_type)));

            if _new->callee != null {
                let alloca = this.builder.BuildAlloca("new.index".ToString(), size_type);
                this.builder.BuildStore(this.builder.ConstantInteger(0, size_type), alloca);
                let condition_block = this.builder.BuildBlock("new.cond".ToString());
                let loop_block = this.builder.BuildBlock("new.loop".ToString());
                let end_block = this.builder.BuildBlock("new.end".ToString());
                this.builder.BuildBranch(condition_block);

                this.builder.SetCurrentBlock(condition_block);
                let index = this.builder.BuildLoad("new.index.load".ToString(), alloca);
                let condition = this.builder.BuildBinary("new.lt".ToString(), MIRBinaryKind::ICmpUlt, index, size, this.context.IntegerType(1));
                this.builder.BuildConditionalBranch(condition, loop_block, end_block);

                this.builder.SetCurrentBlock(loop_block);
                let mut arguments = Vector<*MIRValue>();
                arguments.PushBack(this.builder.BuildArrayGEP("new.gep".ToString(), pointer, index));
                let callee = this.LowerExpression(_new->callee);
                this.builder.BuildCall("new.constructor".ToString(), callee, arguments);
                this.builder.BuildStore(this.builder.BuildBinary("new.add".ToString(), MIRBinaryKind::Add, index, this.builder.ConstantInteger(1, size_type), size_type), alloca);
                this.builder.BuildBranch(condition_block);
                this.builder.SetCurrentBlock(end_block);
            }
        } else {
            let mut arguments = Vector<*MIRValue>();
            arguments.PushBack(allocation_size);
            pointer = this.builder.BuildCall("new".ToString(), callee, arguments);
            pointer = this.builder.BuildCast("new.cast".ToString(), MIRCastKind::Bitcast, pointer, this.context.PointerType(this.LowerType(_new->_type)));

            if _new->callee != null {
                let callee = this.LowerExpression(_new->callee);
                if callee == null { return null; }
                let mut arguments = Vector<*MIRValue>();
                arguments.PushBack(pointer);
                let mut types = Vector<*HIRType>(_new->callee->_type->Parameters());
                types.RemoveAt(0);
                arguments += this.LowerCallArguments(_new->arguments, types);
                this.builder.BuildCall("new.constructor".ToString(), callee, arguments);
            }
        }

        pointer
    }

    fn LowerDeleteExpression(&mut this, _delete: *HIRDeleteExpression) -> *MIRValue {
        let pointer = this.LowerExpression(_delete->value);
        if pointer == null { return null; }
        let mut parameters = Vector<*MIRType>();
        parameters.PushBack(this.context.PointerType(this.context.VoidType()));
        let free = this.LowerRuntimeFunction("free".ToString(), parameters, this.context.VoidType());
        let callee = this.builder.ReferenceDeclaration(free);
        let pointer_type = pointer->_type as *MIRPointerType;
        let mut raw_pointer = pointer;

        if pointer_type->pointee->kind != MIRTypeKind::Integer || (pointer_type->pointee as *MIRIntegerType)->width != 8 {
            raw_pointer = this.builder.BuildCast("delete.cast".ToString(), MIRCastKind::Bitcast, pointer, this.context.PointerType(this.context.IntegerType(8)));
        }

        if _delete->array {
            let size_type = this.context.IntegerType(this.target_info.pointer_size as u32 * 8);
            let cookie_size = this.ArrayCookieSize(_delete->value->_type->Pointee());
            raw_pointer = this.builder.BuildArrayGEP("delete.gep".ToString(), raw_pointer, this.builder.ConstantInteger(-(cookie_size as i64) as u64, size_type));

            if _delete->callee != null {
                let size = this.builder.BuildLoad("delete.size".ToString(), this.builder.BuildCast("delete.cast".ToString(), MIRCastKind::Bitcast, raw_pointer, this.context.PointerType(size_type)));

                let alloca = this.builder.BuildAlloca("delete.index".ToString(), size_type);
                this.builder.BuildStore(this.builder.ConstantInteger(0, size_type), alloca);
                let condition_block = this.builder.BuildBlock("delete.cond".ToString());
                let loop_block = this.builder.BuildBlock("delete.loop".ToString());
                let end_block = this.builder.BuildBlock("delete.end".ToString());
                this.builder.BuildBranch(condition_block);

                this.builder.SetCurrentBlock(condition_block);
                let index = this.builder.BuildLoad("delete.index.load".ToString(), alloca);
                let condition = this.builder.BuildBinary("delete.lt".ToString(), MIRBinaryKind::ICmpUlt, index, size, this.context.IntegerType(1));
                this.builder.BuildConditionalBranch(condition, loop_block, end_block);

                this.builder.SetCurrentBlock(loop_block);
                let callee = this.LowerExpression(_delete->callee);
                if callee == null { return null; }
                let mut arguments = Vector<*MIRValue>();
                arguments.PushBack(this.builder.BuildArrayGEP("delete.gep".ToString(), pointer, index));
                this.builder.BuildCall("delete.destructor".ToString(), callee, arguments);
                this.builder.BuildStore(this.builder.BuildBinary("delete.add".ToString(), MIRBinaryKind::Add, index, this.builder.ConstantInteger(1, size_type), size_type), alloca);
                this.builder.BuildBranch(condition_block);
                this.builder.SetCurrentBlock(end_block);
            }
        } else if _delete->callee != null {
            let callee = this.LowerExpression(_delete->callee);
            if callee == null { return null; }
            let mut arguments = Vector<*MIRValue>();
            arguments.PushBack(pointer);
            this.builder.BuildCall("delete.destructor".ToString(), callee, arguments);
        }

        let mut arguments = Vector<*MIRValue>();
        arguments.PushBack(raw_pointer);
        this.builder.BuildCall("delete".ToString(), callee, arguments);
        null
    }

    fn UpcastPointer(&mut this, mut value: *MIRValue, mut source: *HIRType, path: &Vector<u32>) -> *MIRValue {
        for index in path {
            let destination = (source as *HIRClassType)->declaration->parents[index as usize];
            value = this.builder.BuildStructGEP("cast.base".ToString(), value, index, this.context.PointerType(this.LowerType(destination)));
            source = destination;
        }

        value
    }

    fn LowerCastExpression(&mut this, cast: *HIRCastExpression) -> *MIRValue {
        let mut lowered: *MIRInstruction = null;
        let target_type = cast->_type;

        let value_type = cast->value->_type;
        let mut value = this.LowerExpression(cast->value);
        if value == null { return null; }

        if value_type->IsNever() {
            return this.builder.ConstantUndef(this.LowerType(target_type));
        } else if value_type->IsBoolean() {
            if target_type->IsInteger() {
                return this.builder.BuildCast("cast".ToString(), MIRCastKind::ZExt, value, this.LowerType(target_type));
            }
        } else if value_type->IsCharacter() {
            if target_type->IsInteger() {
                if value_type->Width() < target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::ZExt, value, this.LowerType(target_type));
                } else if value_type->Width() > target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::Trunc, value, this.LowerType(target_type));
                }
            }
        } else if value_type->IsInteger() {
            if target_type->IsCharacter() {
                if value_type->Width() == 8 && !value_type->IsSigned() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::ZExt, value, this.LowerType(target_type));
                }
            }

            if target_type->IsInteger() || target_type->IsEnumeration() {
                if value_type->Width() < target_type->Width() {
                    if value_type->IsSigned() {
                        return this.builder.BuildCast("cast".ToString(), MIRCastKind::SExt, value, this.LowerType(target_type));
                    } else {
                        return this.builder.BuildCast("cast".ToString(), MIRCastKind::ZExt, value, this.LowerType(target_type));
                    }
                } else if value_type->Width() > target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::Trunc, value, this.LowerType(target_type));
                }
            }

            if target_type->IsFloat() {
                if value_type->IsSigned() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::SIToFP, value, this.LowerType(target_type));
                } else {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::UIToFP, value, this.LowerType(target_type));
                }
            }

            if target_type->IsPointer() {
                return this.builder.BuildCast("cast".ToString(), MIRCastKind::IntToPtr, value, this.LowerType(target_type));
            }
        } else if value_type->IsFloat() {
            if target_type->IsInteger() {
                if target_type->IsSigned() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::FPToSI, value, this.LowerType(target_type));
                } else {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::FPToUI, value, this.LowerType(target_type));
                }
            }

            if target_type->IsFloat() {
                if value_type->Width() < target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::FPExt, value, this.LowerType(target_type));
                } else if value_type->Width() > target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::FPTrunc, value, this.LowerType(target_type));
                }
            }
        } else if value_type->IsPointer() {
            if target_type->IsInteger() {
                return this.builder.BuildCast("cast".ToString(), MIRCastKind::PtrToInt, value, this.LowerType(target_type));
            }

            if target_type->IsPointer() {
                if value_type->Pointee().IsClass() && target_type->Pointee().IsClass() {
                    let (source, destination) = (value_type->Pointee(), target_type->Pointee());
                    let mut path = Vector<u32>();

                    if source.FindParentPath(destination, path) {
                        return this.UpcastPointer(value, source, path);
                    } else {
                        path.Clear();

                        if destination.FindParentPath(source, path) {
                            let result_type = this.context.PointerType(this.LowerType(destination));
                            let size_type = this.context.IntegerType(this.target_info.pointer_size as u32 * 8);
                            let base = this.UpcastPointer(this.builder.ConstantNull(result_type), destination, path);
                            let offset = this.builder.BuildCast("cast.offset".ToString(), MIRCastKind::PtrToInt, base, size_type);
                            let address = this.builder.BuildCast("cast.address".ToString(), MIRCastKind::PtrToInt, value, size_type);
                            let adjusted = this.builder.BuildBinary("cast.adjust".ToString(), MIRBinaryKind::Sub, address, offset, size_type);
                            return this.builder.BuildCast("cast.derived".ToString(), MIRCastKind::IntToPtr, adjusted, result_type);
                        }
                    }
                }

                return this.builder.BuildCast("cast".ToString(), MIRCastKind::Bitcast, value, this.LowerType(target_type));
            }

            if target_type->IsFunction() {
                return this.builder.BuildCast("cast".ToString(), MIRCastKind::Bitcast, value, this.LowerType(target_type));
            }
        } else if value_type->IsFunction() {
            if target_type->IsPointer() || target_type->IsFunction() {
                return this.builder.BuildCast("cast".ToString(), MIRCastKind::Bitcast, value, this.LowerType(target_type));
            }
        } else if value_type->IsEnumeration() {
            if target_type->IsInteger() {
                if value_type->Width() < target_type->Width() {
                    if value_type->IsSigned() {
                        return this.builder.BuildCast("cast".ToString(), MIRCastKind::SExt, value, this.LowerType(target_type));
                    } else {
                        return this.builder.BuildCast("cast".ToString(), MIRCastKind::ZExt, value, this.LowerType(target_type));
                    }
                } else if value_type->Width() > target_type->Width() {
                    return this.builder.BuildCast("cast".ToString(), MIRCastKind::Trunc, value, this.LowerType(target_type));
                }
            }
        }

        value
    }

    fn LowerIndexAccessExpression(&mut this, index_access: *HIRIndexAccessExpression) -> *MIRValue {
        let mut value: *MIRValue = null;

        if index_access->value->_type->IsArray() {
            value = this.LowerPlaceExpression(index_access->value);
            if value == null { return null; }
            let array_type = this.LowerType(index_access->value->_type) as *MIRArrayType;
            value = this.builder.BuildCast("array.cast".ToString(), MIRCastKind::Bitcast, value, this.context.PointerType(array_type->element));
        } else {
            value = this.LowerExpression(index_access->value);
        }

        let index = this.LowerExpression(index_access->index);
        if value == null || index == null { return null; }
        this.builder.BuildArrayGEP("index.access".ToString(), value, index)
    }

    fn LowerTupleAccessExpression(&mut this, tuple_access: *HIRTupleAccessExpression) -> *MIRValue {
        let instance = this.LowerPlaceExpression(tuple_access->instance);
        if instance == null { return null; }
        let element_type = this.context.PointerType(this.LowerType(tuple_access->_type));
        this.builder.BuildStructGEP("tuple.access".ToString(), instance, tuple_access->index as u32, element_type)
    }

    fn LowerFieldAccessExpression(&mut this, field_access: *HIRFieldAccessExpression) -> *MIRValue {
        let instance = this.LowerPlaceExpression(field_access->instance);
        if instance == null { return null; }
        let field_type = this.context.PointerType(this.LowerType(field_access->_type));
        this.builder.BuildStructGEP("field.access".ToString(), instance, field_access->field->index as u32, field_type)
    }

    fn LowerMemberAccessExpression(&mut this, member_access: *HIRMemberAccessExpression) -> *MIRValue {
        let member = member_access->member;
        let tag_type = this.context.IntegerType(8);
        let mut fields = Vector<*MIRType>();
        fields.PushBack(tag_type);

        for field in member->fields {
            fields.PushBack(this.LowerType(field->_type));
        }

        let member_type = this.context.StructureType(fields);
        let instance = this.LowerPlaceExpression(member_access->instance);
        if instance == null { return null; }
        let pointer = this.builder.BuildCast("member.cast".ToString(), MIRCastKind::Bitcast, instance, this.context.PointerType(member_type));
        let index = member_access->field->index + 1;
        this.builder.BuildStructGEP("member.access".ToString(), pointer, index as u32, this.context.PointerType(fields[index]))
    }

    fn LowerTagAccessExpression(&mut this, tag_access: *HIRTagAccessExpression) -> *MIRValue {
        let instance = this.LowerPlaceExpression(tag_access->instance);
        if instance == null { return null; }
        this.builder.BuildCast("tag.cast".ToString(), MIRCastKind::Bitcast, instance, this.context.PointerType(this.context.IntegerType(8)))
    }

    fn LowerUnaryExpression(&mut this, unary: *HIRUnaryExpression) -> *MIRValue {
        if unary->kind == HIRUnaryKind::AddressOf {
            this.LowerPlaceExpression(unary->operand)
        } else {
            let operand = this.LowerExpression(unary->operand);
            if operand == null { return null; }

            match unary->kind {
                HIRUnaryKind::Dereference => operand,
                HIRUnaryKind::Negate => {
                    if unary->operand->_type->IsFloat() {
                        this.builder.BuildUnary("neg".ToString(), MIRUnaryKind::FNeg, operand)
                    } else {
                        this.builder.BuildUnary("neg".ToString(), MIRUnaryKind::Neg, operand)
                    }
                },
                HIRUnaryKind::Not => this.builder.BuildUnary("not".ToString(), MIRUnaryKind::Not, operand),
                _ => null
            }
        }
    }

    fn LowerBinaryExpression(&mut this, binary: *HIRBinaryExpression) -> *MIRValue {
        let result_type = this.LowerType(binary->_type);
        if result_type == null { return null; }

        let left_type = binary->left->_type;
        let left = this.LowerExpression(binary->left);
        if left == null { return null; }

        if binary->kind == HIRBinaryKind::LogicalAnd || binary->kind == HIRBinaryKind::LogicalOr { 
            let mut right_block = this.builder.BuildBlock("binary.right".ToString());
            let merge_block = this.builder.BuildBlock("binary.merge".ToString());
            let left_block = this.builder.GetCurrentBlock();

            if binary->kind == HIRBinaryKind::LogicalAnd {
                this.builder.BuildConditionalBranch(left, right_block, merge_block);
            } else {
                this.builder.BuildConditionalBranch(left, merge_block, right_block);
            }

            this.builder.SetCurrentBlock(right_block);
            let right = this.LowerExpression(binary->right);
            if right == null { return null; }

            for destructor in binary->destructors {
                this.LowerExpression(destructor);
            }

            right_block = this.builder.GetCurrentBlock();
            this.builder.BuildBranch(merge_block);

            this.builder.SetCurrentBlock(merge_block);
            let phi = this.builder.BuildPhi("short.circuit".ToString(), result_type);
            phi->AddIncoming(left, left_block);
            phi->AddIncoming(right, right_block);
            return phi;
        }

        let right_type = binary->right->_type;
        let mut right = this.LowerExpression(binary->right);
        if right == null { return null; }

        if (binary->kind == HIRBinaryKind::LeftShift || binary->kind == HIRBinaryKind::RightShift) && right_type->Width() != left_type->Width() {
            if right_type->Width() < left_type->Width() {
                right = this.builder.BuildCast("shift.cast".ToString(), right_type->IsSigned() ? MIRCastKind::SExt : MIRCastKind::ZExt, right, result_type);
            } else {
                right = this.builder.BuildCast("shift.cast".ToString(), MIRCastKind::Trunc, right, result_type);
            }
        }

        if left_type->IsBoolean() && right_type->IsBoolean() {
            match binary->kind {
                HIRBinaryKind::BitwiseAnd => this.builder.BuildBinary("and".ToString(), MIRBinaryKind::And, left, right, result_type),
                HIRBinaryKind::BitwiseOr => this.builder.BuildBinary("or".ToString(), MIRBinaryKind::Or, left, right, result_type),
                HIRBinaryKind::BitwiseXor => this.builder.BuildBinary("xor".ToString(), MIRBinaryKind::Xor, left, right, result_type),
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                _ => null
            }
        } else if left_type->IsCharacter() && right_type->IsCharacter() {
            match binary->kind {
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                HIRBinaryKind::Less => this.builder.BuildBinary("lt".ToString(), MIRBinaryKind::ICmpUlt, left, right, result_type),
                HIRBinaryKind::LessEqual => this.builder.BuildBinary("le".ToString(), MIRBinaryKind::ICmpUle, left, right, result_type),
                HIRBinaryKind::Greater => this.builder.BuildBinary("gt".ToString(), MIRBinaryKind::ICmpUgt, left, right, result_type),
                HIRBinaryKind::GreaterEqual => this.builder.BuildBinary("ge".ToString(), MIRBinaryKind::ICmpUge, left, right, result_type),
                _ => null
            }
        } else if left_type->IsInteger() && right_type->IsInteger() {
            let signed = left_type->IsSigned();

            match binary->kind {
                HIRBinaryKind::Add => this.builder.BuildBinary("add".ToString(), MIRBinaryKind::Add, left, right, result_type),
                HIRBinaryKind::Subtract => this.builder.BuildBinary("sub".ToString(), MIRBinaryKind::Sub, left, right, result_type),
                HIRBinaryKind::Multiply => this.builder.BuildBinary("mul".ToString(), MIRBinaryKind::Mul, left, right, result_type),
                HIRBinaryKind::Divide => this.builder.BuildBinary("div".ToString(), signed ? MIRBinaryKind::SDiv : MIRBinaryKind::UDiv, left, right, result_type),
                HIRBinaryKind::Modulo => this.builder.BuildBinary("rem".ToString(), signed ? MIRBinaryKind::SRem : MIRBinaryKind::URem, left, right, result_type),
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                HIRBinaryKind::Less => this.builder.BuildBinary("lt".ToString(), signed ? MIRBinaryKind::ICmpSlt : MIRBinaryKind::ICmpUlt, left, right, result_type),
                HIRBinaryKind::LessEqual => this.builder.BuildBinary("le".ToString(), signed ? MIRBinaryKind::ICmpSle : MIRBinaryKind::ICmpUle, left, right, result_type),
                HIRBinaryKind::Greater => this.builder.BuildBinary("gt".ToString(), signed ? MIRBinaryKind::ICmpSgt : MIRBinaryKind::ICmpUgt, left, right, result_type),
                HIRBinaryKind::GreaterEqual => this.builder.BuildBinary("ge".ToString(), signed ? MIRBinaryKind::ICmpSge : MIRBinaryKind::ICmpUge, left, right, result_type),
                HIRBinaryKind::BitwiseAnd => this.builder.BuildBinary("and".ToString(), MIRBinaryKind::And, left, right, result_type),
                HIRBinaryKind::BitwiseOr => this.builder.BuildBinary("or".ToString(), MIRBinaryKind::Or, left, right, result_type),
                HIRBinaryKind::BitwiseXor => this.builder.BuildBinary("xor".ToString(), MIRBinaryKind::Xor, left, right, result_type),
                HIRBinaryKind::LeftShift => this.builder.BuildBinary("shl".ToString(), MIRBinaryKind::Shl, left, right, result_type),
                HIRBinaryKind::RightShift => this.builder.BuildBinary("shr".ToString(), signed ? MIRBinaryKind::AShr : MIRBinaryKind::LShr, left, right, result_type),
                _ => null
            }
        } else if left_type->IsFloat() && right_type->IsFloat() {
            match binary->kind {
                HIRBinaryKind::Add => this.builder.BuildBinary("add".ToString(), MIRBinaryKind::FAdd, left, right, result_type),
                HIRBinaryKind::Subtract => this.builder.BuildBinary("sub".ToString(), MIRBinaryKind::FSub, left, right, result_type),
                HIRBinaryKind::Multiply => this.builder.BuildBinary("mul".ToString(), MIRBinaryKind::FMul, left, right, result_type),
                HIRBinaryKind::Divide => this.builder.BuildBinary("div".ToString(), MIRBinaryKind::FDiv, left, right, result_type),
                HIRBinaryKind::Modulo => this.builder.BuildBinary("rem".ToString(), MIRBinaryKind::FRem, left, right, result_type),
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::FCmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::FCmpNe, left, right, result_type),
                HIRBinaryKind::Less => this.builder.BuildBinary("lt".ToString(), MIRBinaryKind::FCmpLt, left, right, result_type),
                HIRBinaryKind::LessEqual => this.builder.BuildBinary("le".ToString(), MIRBinaryKind::FCmpLe, left, right, result_type),
                HIRBinaryKind::Greater => this.builder.BuildBinary("gt".ToString(), MIRBinaryKind::FCmpGt, left, right, result_type),
                HIRBinaryKind::GreaterEqual => this.builder.BuildBinary("ge".ToString(), MIRBinaryKind::FCmpGe, left, right, result_type),
                _ => null
            }
        } else if left_type->IsPointer() && right_type->IsPointer() {
            match binary->kind {
                HIRBinaryKind::Subtract => {
                    let element_type = left_type->IsNullPointer() ? right_type->Pointee() : left_type->Pointee();
                    let size_type = this.context.IntegerType(this.target_info.pointer_size as u32 * 8);
                    let left = this.builder.BuildCast("ptr.diff.left".ToString(), MIRCastKind::PtrToInt, left, size_type);
                    let right = this.builder.BuildCast("ptr.diff.right".ToString(), MIRCastKind::PtrToInt, right, size_type);
                    let difference = this.builder.BuildBinary("ptr.diff.bytes".ToString(), MIRBinaryKind::Sub, left, right, size_type);
                    let size_value = this.builder.ConstantInteger(element_type.Size() as u64, size_type);
                    this.builder.BuildBinary("ptr.diff".ToString(), MIRBinaryKind::UDiv, difference, size_value, size_type)
                },
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                HIRBinaryKind::Greater => this.builder.BuildBinary("gt".ToString(), MIRBinaryKind::ICmpUgt, left, right, result_type),
                HIRBinaryKind::GreaterEqual => this.builder.BuildBinary("ge".ToString(), MIRBinaryKind::ICmpUge, left, right, result_type),
                HIRBinaryKind::Less => this.builder.BuildBinary("lt".ToString(), MIRBinaryKind::ICmpUlt, left, right, result_type),
                HIRBinaryKind::LessEqual => this.builder.BuildBinary("le".ToString(), MIRBinaryKind::ICmpUle, left, right, result_type),
                _ => null
            }
        } else if (left_type->IsPointer() && right_type->IsInteger()) || (left_type->IsInteger() && right_type->IsPointer()) {
            let mut pointer = left_type->IsPointer() ? left : right;
            let mut index = left_type->IsPointer() ? right : left;

            match binary->kind {
                HIRBinaryKind::Add => this.builder.BuildArrayGEP("ptr.add".ToString(), pointer, index),
                HIRBinaryKind::Subtract if left_type->IsPointer() => this.builder.BuildArrayGEP("ptr.sub".ToString(), pointer, this.builder.BuildUnary("ptr.neg".ToString(), MIRUnaryKind::Neg, index)),
                _ => null
            }
        } else if (left_type->IsFunction() && right_type->IsNullPointer()) || (left_type->IsNullPointer() && right_type->IsFunction()) {
            match binary->kind {
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                _ => null
            }
        } else if left_type->IsEnumeration() && right_type->IsEnumeration() {
            let signed = left_type->IsSigned();

            match binary->kind {
                HIRBinaryKind::Equal => this.builder.BuildBinary("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type),
                HIRBinaryKind::NotEqual => this.builder.BuildBinary("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type),
                HIRBinaryKind::Less => this.builder.BuildBinary("lt".ToString(), signed ? MIRBinaryKind::ICmpSlt : MIRBinaryKind::ICmpUlt, left, right, result_type),
                HIRBinaryKind::LessEqual => this.builder.BuildBinary("le".ToString(), signed ? MIRBinaryKind::ICmpSle : MIRBinaryKind::ICmpUle, left, right, result_type),
                HIRBinaryKind::Greater => this.builder.BuildBinary("gt".ToString(), signed ? MIRBinaryKind::ICmpSgt : MIRBinaryKind::ICmpUgt, left, right, result_type),
                HIRBinaryKind::GreaterEqual => this.builder.BuildBinary("ge".ToString(), signed ? MIRBinaryKind::ICmpSge : MIRBinaryKind::ICmpUge, left, right, result_type),
                HIRBinaryKind::BitwiseAnd => this.builder.BuildBinary("and".ToString(), MIRBinaryKind::And, left, right, result_type),
                HIRBinaryKind::BitwiseOr => this.builder.BuildBinary("or".ToString(), MIRBinaryKind::Or, left, right, result_type),
                HIRBinaryKind::BitwiseXor => this.builder.BuildBinary("xor".ToString(), MIRBinaryKind::Xor, left, right, result_type),
                _ => null
            }
        } else { null }
    }

    fn LowerTernaryPlaceExpression(&mut this, ternary: *HIRTernaryExpression) -> *MIRValue {
        let condition = this.LowerExpression(ternary->condition);
        if condition == null { return null; }

        let mut then_block = this.builder.BuildBlock("ternary.then".ToString());
        let mut else_block = this.builder.BuildBlock("ternary.else".ToString());
        let merge_block = this.builder.BuildBlock("ternary.merge".ToString());
        this.builder.BuildConditionalBranch(condition, then_block, else_block);

        this.builder.SetCurrentBlock(then_block);
        let then_place = this.LowerPlaceExpression(ternary->then_value);
        if then_place == null { return null; }

        for destructor in ternary->then_destructors {
            this.LowerExpression(destructor);
        }

        then_block = this.builder.GetCurrentBlock();
        this.builder.BuildBranch(merge_block);

        this.builder.SetCurrentBlock(else_block);
        let else_place = this.LowerPlaceExpression(ternary->else_value);
        if else_place == null { return null; }

        for destructor in ternary->else_destructors {
            this.LowerExpression(destructor);
        }

        else_block = this.builder.GetCurrentBlock();
        this.builder.BuildBranch(merge_block);

        this.builder.SetCurrentBlock(merge_block);
        let phi = this.builder.BuildPhi("ternary.place".ToString(), then_place->_type);
        phi->AddIncoming(then_place, then_block);
        phi->AddIncoming(else_place, else_block);
        phi
    }

    fn LowerTernaryExpressionTo(&mut this, ternary: *HIRTernaryExpression, destination: *MIRValue) {
        let condition = this.LowerExpression(ternary->condition);
        if condition == null { return; }

        let then_block = this.builder.BuildBlock("ternary.then".ToString());
        let else_block = this.builder.BuildBlock("ternary.else".ToString());
        let merge_block = this.builder.BuildBlock("ternary.merge".ToString());
        this.builder.BuildConditionalBranch(condition, then_block, else_block);

        this.builder.SetCurrentBlock(then_block);
        this.LowerExpressionTo(ternary->then_value, destination);

        for destructor in ternary->then_destructors {
            this.LowerExpression(destructor);
        }

        this.builder.BuildBranch(merge_block);
        this.builder.SetCurrentBlock(else_block);
        this.LowerExpressionTo(ternary->else_value, destination);

        for destructor in ternary->else_destructors {
            this.LowerExpression(destructor);
        }

        this.builder.BuildBranch(merge_block);
        this.builder.SetCurrentBlock(merge_block);
    }

    fn LowerTernaryExpression(&mut this, ternary: *HIRTernaryExpression) -> *MIRValue {
        let condition = this.LowerExpression(ternary->condition);
        if condition == null { return null; }

        let mut then_block = this.builder.BuildBlock("ternary.then".ToString());
        let mut else_block = this.builder.BuildBlock("ternary.else".ToString());
        let merge_block = this.builder.BuildBlock("ternary.merge".ToString());
        this.builder.BuildConditionalBranch(condition, then_block, else_block);

        this.builder.SetCurrentBlock(then_block);
        let then_value = this.LowerExpression(ternary->then_value);
        if then_value == null { return null; }

        for destructor in ternary->then_destructors {
            this.LowerExpression(destructor);
        }

        then_block = this.builder.GetCurrentBlock();
        this.builder.BuildBranch(merge_block);

        this.builder.SetCurrentBlock(else_block);
        let else_value = this.LowerExpression(ternary->else_value);
        if else_value == null { return null; }

        for destructor in ternary->else_destructors {
            this.LowerExpression(destructor);
        }

        else_block = this.builder.GetCurrentBlock();
        this.builder.BuildBranch(merge_block);

        this.builder.SetCurrentBlock(merge_block);
        let phi = this.builder.BuildPhi("ternary".ToString(), then_value->_type);
        phi->AddIncoming(then_value, then_block);
        phi->AddIncoming(else_value, else_block);
        phi
    }

    fn TestPattern(&mut this, pattern: *HIRPattern, target: *MIRValue) -> *MIRValue {
        match pattern->kind {
            HIRPatternKind::Literal => this.TestLiteralPattern(pattern as *HIRLiteralPattern, target),
            HIRPatternKind::Range => this.TestRangePattern(pattern as *HIRRangePattern, target),
            HIRPatternKind::Tuple => this.TestTuplePattern(pattern as *HIRTuplePattern, target),
            HIRPatternKind::Field => this.TestPattern((pattern as *HIRFieldPattern)->pattern, target),
            HIRPatternKind::Structure => this.TestStructurePattern(pattern as *HIRStructurePattern, target),
            HIRPatternKind::Enumeration => this.TestEnumerationPattern(pattern as *HIREnumerationPattern, target),
            HIRPatternKind::Variant => this.TestVariantPattern(pattern as *HIRVariantPattern, target),
            HIRPatternKind::Or => this.TestOrPattern(pattern as *HIROrPattern, target),
            HIRPatternKind::Dereference => this.TestPattern((pattern as *HIRDereferencePattern)->pattern, this.builder.BuildLoad("pattern.deref".ToString(), target)),
            _ => this.builder.ConstantInteger(1, this.context.IntegerType(1))
        }
    }

    fn TestLiteralPattern(&mut this, pattern: *HIRLiteralPattern, target: *MIRValue) -> *MIRValue {
        let literal = this.LowerExpression(pattern->literal);
        if literal == null { return null; }
        let value = this.builder.BuildLoad("pattern.load".ToString(), target);
        let kind = pattern->literal->_type->IsFloat() ? MIRBinaryKind::FCmpEq : MIRBinaryKind::ICmpEq;
        this.builder.BuildBinary("pattern.eq".ToString(), kind, value, literal, this.context.IntegerType(1))
    }

    fn TestRangePattern(&mut this, range: *HIRRangePattern, target: *MIRValue) -> *MIRValue {
        let bool_type = this.context.IntegerType(1);
        let value = this.builder.BuildLoad("pattern.load".ToString(), target);
        let signed = (range->start != null ? range->start : range->end)->_type->IsSigned();
        let mut condition: *MIRValue = this.builder.ConstantInteger(1, bool_type);

        if range->start != null {
            let start = this.LowerExpression(range->start);
            if start == null { return null; }
            condition = this.builder.BuildBinary("pattern.ge".ToString(), signed ? MIRBinaryKind::ICmpSge : MIRBinaryKind::ICmpUge, value, start, bool_type);
        }

        if range->end != null {
            let end = this.LowerExpression(range->end);
            if end == null { return null; }
            let kind = range->inclusive ? (signed ? MIRBinaryKind::ICmpSle : MIRBinaryKind::ICmpUle) : (signed ? MIRBinaryKind::ICmpSlt : MIRBinaryKind::ICmpUlt);
            let compare = this.builder.BuildBinary("pattern.le".ToString(), kind, value, end, bool_type);
            condition = this.builder.BuildBinary("pattern.and".ToString(), MIRBinaryKind::And, condition, compare, bool_type);
        }

        condition
    }

    fn TestTuplePattern(&mut this, tuple: *HIRTuplePattern, target: *MIRValue) -> *MIRValue {
        let bool_type = this.context.IntegerType(1);
        let mut condition: *MIRValue = this.builder.ConstantInteger(1, bool_type);

        for i in 0..tuple->patterns.Size() {
            let element_type = this.LowerType(tuple->_type->elements[i]);
            if element_type == null { return null; }
            let field_type = this.context.PointerType(element_type);
            let place = this.builder.BuildStructGEP("pattern.tuple".ToString(), target, i as u32, field_type);
            let result = this.TestPattern(tuple->patterns[i], place);
            if result == null { return null; }
            condition = this.builder.BuildBinary("pattern.and".ToString(), MIRBinaryKind::And, condition, result, bool_type);
        }

        condition
    }

    fn TestStructurePattern(&mut this, structure: *HIRStructurePattern, target: *MIRValue) -> *MIRValue {
        let bool_type = this.context.IntegerType(1);
        let mut condition: *MIRValue = this.builder.ConstantInteger(1, bool_type);

        for pattern in structure->patterns {
            let field = pattern as *HIRFieldPattern;
            let mut declaration: *HIRFieldDeclaration = null;

            for candidate in structure->declaration->fields {
                if candidate->name == field->name {
                    declaration = candidate;
                    break;
                }
            }

            if declaration == null { return null; }
            let field_type = this.context.PointerType(this.LowerType(declaration->_type));
            let place = this.builder.BuildStructGEP("pattern.field".ToString(), target, declaration->index as u32, field_type);
            let result = this.TestPattern(field->pattern, place);
            if result == null { return null; }
            condition = this.builder.BuildBinary("pattern.and".ToString(), MIRBinaryKind::And, condition, result, bool_type);
        }

        condition
    }

    fn TestEnumerationPattern(&mut this, enumeration: *HIREnumerationPattern, target: *MIRValue) -> *MIRValue {
        let value = this.LowerExpression(enumeration->member->value);
        if value == null { return null; }
        this.builder.BuildBinary("pattern.eq".ToString(), MIRBinaryKind::ICmpEq, this.builder.BuildLoad("pattern.load".ToString(), target), value, this.context.IntegerType(1))
    }

    fn TestVariantPattern(&mut this, variant: *HIRVariantPattern, target: *MIRValue) -> *MIRValue {
        let member = variant->member;
        let tag_type = this.context.IntegerType(8);
        let bool_type = this.context.IntegerType(1);
        let mut fields = Vector<*MIRType>();
        fields.PushBack(tag_type);

        for field in member->fields {
            fields.PushBack(this.LowerType(field->_type));
        }

        let member_type = this.context.StructureType(fields);
        let pointer = this.builder.BuildCast("variant.cast".ToString(), MIRCastKind::Bitcast, target, this.context.PointerType(member_type));
        let tag_pointer = this.builder.BuildStructGEP("variant.tag".ToString(), pointer, 0, this.context.PointerType(tag_type));
        let (tag, member_tag) = (this.builder.BuildLoad("variant.tag.load".ToString(), tag_pointer), this.builder.ConstantInteger(member->index as u64, tag_type));
        let tag_test = this.builder.BuildBinary("pattern.tag.eq".ToString(), MIRBinaryKind::ICmpEq, tag, member_tag, bool_type);
        let mut refutable = false;

        for pattern in variant->patterns {
            if !pattern->IsIrrefutable() { refutable = true; }
        }

        if !refutable { return tag_test; }
        let (tag_block, mut fields_block, merge_block) = (this.builder.GetCurrentBlock(), this.builder.BuildBlock("variant.fields".ToString()), this.builder.BuildBlock("variant.merge".ToString()));
        this.builder.BuildConditionalBranch(tag_test, fields_block, merge_block);
        this.builder.SetCurrentBlock(fields_block);
        let mut condition: *MIRValue = this.builder.ConstantInteger(1, bool_type);

        if member->structure {
            for pattern in variant->patterns {
                let field = pattern as *HIRFieldPattern;
                let mut index: isize = -1;

                for i in 0..member->fields.Size() {
                    if member->fields[i]->name == field->name {
                        index = i as isize;
                        break;
                    }
                }

                if index == -1 { return null; }
                let field_pointer = this.builder.BuildStructGEP("variant.field".ToString(), pointer, (index + 1) as u32, this.context.PointerType(fields[(index + 1) as usize]));
                let result = this.TestPattern(field->pattern, field_pointer);
                if result == null { return null; }
                condition = this.builder.BuildBinary("pattern.and".ToString(), MIRBinaryKind::And, condition, result, bool_type);
            }
        } else {
            for i in 0..variant->patterns.Size() {
                let field_pointer = this.builder.BuildStructGEP("variant.field".ToString(), pointer, (i + 1) as u32, this.context.PointerType(fields[i + 1]));
                let result = this.TestPattern(variant->patterns[i], field_pointer);
                if result == null { return null; }
                condition = this.builder.BuildBinary("pattern.and".ToString(), MIRBinaryKind::And, condition, result, bool_type);
            }
        }

        fields_block = this.builder.GetCurrentBlock();
        this.builder.BuildBranch(merge_block);
        this.builder.SetCurrentBlock(merge_block);
        let phi = this.builder.BuildPhi("variant.result".ToString(), bool_type);
        phi->AddIncoming(this.builder.ConstantInteger(0, bool_type), tag_block);
        phi->AddIncoming(condition, fields_block);
        phi
    }

    fn TestOrPattern(&mut this, or: *HIROrPattern, target: *MIRValue) -> *MIRValue {
        let bool_type = this.context.IntegerType(1);
        let mut condition: *MIRValue = this.builder.ConstantInteger(0, bool_type);

        for pattern in or->patterns {
            let result = this.TestPattern(pattern, target);
            if result == null { return null; }
            condition = this.builder.BuildBinary("pattern.or".ToString(), MIRBinaryKind::Or, condition, result, bool_type);
        }

        condition
    }

    fn BindPattern(&mut this, pattern: *HIRPattern) {
        match pattern->kind {
            HIRPatternKind::Identifier => {
                let identifier = pattern as *HIRIdentifierPattern;
                let _type = this.LowerType(identifier->_type);
                if _type == null { return; }
                let alloca = this.builder.BuildAlloca(identifier->name, _type);
                this.bindings[identifier] = alloca;

                if identifier->value != null {
                    this.LowerExpressionTo(identifier->value, alloca);
                }
            },
            HIRPatternKind::Tuple => {
                for pattern in (pattern as *HIRTuplePattern)->patterns {
                    this.BindPattern(pattern);
                }
            },
            HIRPatternKind::Field => {
                this.BindPattern((pattern as *HIRFieldPattern)->pattern);
            },
            HIRPatternKind::Structure => {
                for pattern in (pattern as *HIRStructurePattern)->patterns {
                    this.BindPattern(pattern);
                }
            },
            HIRPatternKind::Variant => {
                for pattern in (pattern as *HIRVariantPattern)->patterns {
                    this.BindPattern(pattern);
                }
            },
            HIRPatternKind::Dereference => {
                let dereference = pattern as *HIRDereferencePattern;
                this.BindPattern(dereference->binding);
                this.BindPattern(dereference->pattern);
            },
            _ => {}
        }
    }

    pub fn LowerType(&mut this, _type: *HIRType) -> *MIRType {
        if _type->IsNever() || _type->IsVoid() {
            this.context.VoidType()
        } else if _type->IsBoolean() || _type->IsCharacter() || _type->IsInteger() || _type->IsEnumeration() {
            this.context.IntegerType(_type->Width())
        } else if _type->IsFloat() {
            this.context.FloatType(_type->Width())
        } else if _type->IsPointer() {
            let pointee = this.LowerType(_type->Pointee());
            if pointee == null { return null; }
            this.context.PointerType(pointee)
        } else if _type->IsArray() {
            let element = this.LowerType(_type->Element());
            if element == null { return null; }
            this.context.ArrayType(element, _type->Length())
        } else if _type->IsTuple() {
            let mut elements = Vector<*MIRType>();

            for element in (_type as *HIRTupleType)->elements {
                let lowered_element = this.LowerType(element);
                if lowered_element == null { return null; }
                elements.PushBack(lowered_element);
            }

            this.context.StructureType(elements)
        } else if _type->IsClass() || _type->IsStructure() || _type->IsVariant() {
            let declaration = this.types.Get(_type, null);
            declaration != null ? declaration->_type : null
        } else if _type->IsFunction() {
            let mut parameters = Vector<*MIRType>();
            let mut _return = this.LowerAggregateType(_type->Return());
            if _return == null { return null; }

            if this.IsIndirectAggregate(_type->Return()) {
                parameters.PushBack(_return);
                _return = this.context.VoidType();
            }

            for parameter in _type->Parameters() {
                let lowered_parameter = this.LowerAggregateType(parameter);
                if lowered_parameter == null { return null; }
                parameters.PushBack(lowered_parameter);
            }

            this.context.FunctionType(parameters, _return)
        } else {
            null
        }
    }
}
