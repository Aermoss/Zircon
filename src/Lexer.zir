#[include "std/str", "std/vec", "src/Logger.zir", "src/Token.zir" : *]

class Lexer {
    file: *SourceFile = null,
    file_id: u32 = 0,
    length: usize = 0,
    index: usize = 0,
    preprocessor: bool = false,
    assembly: bool = false;

    fn IsDigit(&this, character: i8) -> bool {
        character >= '0' && character <= '9'
    }

    fn IsHexDigit(&this, character: i8) -> bool {
        (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
    }

    fn IsBinDigit(&this, character: i8) -> bool {
        character == '0' || character == '1'
    }

    fn IsOctDigit(&this, character: i8) -> bool {
        character >= '0' && character <= '7'
    }

    fn IsAlpha(&this, character: i8) -> bool {
        (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_'
    }

    fn IsAlphaNum(&this, character: i8) -> bool {
        this.IsAlpha(character) || this.IsDigit(character)
    }

    fn CurrentChar(&this) -> i8 {
        if this.index >= this.length { return '\0'; }
        this.file->text.Data()[this.index]
    }

    fn PeekChar(&this, offset: usize) -> i8 {
        let peek_index = this.index + offset;
        if peek_index >= this.length { return '\0'; }
        this.file->text.Data()[peek_index]
    }

    fn Advance(&mut this, count: usize) {
        this.index = if this.index + count < this.length { this.index + count } else { this.length };
    }

    fn Span(&this) -> SourceSpan {
        SourceSpan { file: this.file_id, start: this.index as u32, end: this.index as u32 }
    }

    fn Open(&mut this, file: u32) {
        this.file_id = file;
        this.file = Sources()->File(file);
        this.length = this.file->text.Length();
    }

    pub fn Unescape(span: SourceSpan) -> String {
        let mut lexer: Lexer;
        lexer.Open(span.file);
        lexer.index = span.start as usize;
        lexer.ScanString(false)
    }

    pub fn AssemblyCode(span: SourceSpan) -> String {
        let mut lexer: Lexer;
        lexer.Open(span.file);
        lexer.index = span.start as usize;
        lexer.ScanAssembly(false)
    }

    fn SkipWhitespace(&mut this) {
        while this.CurrentChar() == ' ' || this.CurrentChar() == '\t' || this.CurrentChar() == '\r' {
            this.Advance(1);
        }
    }

    fn SkipComment(&mut this) -> bool {
        if this.CurrentChar() == '/' {
            if this.PeekChar(1) == '/' {
                while this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
                    this.Advance(1);
                } return true;
            } else if this.PeekChar(1) == '*' {
                let span = this.Span();
                this.Advance(2);

                while this.CurrentChar() != '\0' {
                    if this.CurrentChar() == '*' && this.PeekChar(1) == '/' {
                        this.Advance(2);
                        return true;
                    } this.Advance(1);
                }

                Logger::Log("Unterminated block comment.", span, LogSeverity::Error);
                return true;
            }
        }

        false
    }

    fn ScanString(&mut this, report: bool) -> String {
        let span = this.Span();
        let quote_char = this.CurrentChar();
        let mut value = String();
        this.Advance(1);

        while this.CurrentChar() != quote_char && this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
            if this.CurrentChar() == '\\' {
                this.Advance(1);

                if this.CurrentChar() != '\0' {
                    let escaped = this.CurrentChar();

                    if escaped == '\'' {
                        value += "'";
                    } else if escaped == '"' {
                        value += "\"";
                    } else if escaped == '?' {
                        value += "\?";
                    } else if escaped == '\\' {
                        value += "\\";
                    } else if escaped == 'a' {
                        value += "\a";
                    } else if escaped == 'b' {
                        value += "\b";
                    } else if escaped == 'f' {
                        value += "\f";
                    } else if escaped == 'n' {
                        value += "\n";
                    } else if escaped == 'r' {
                        value += "\r";
                    } else if escaped == 't' {
                        value += "\t";
                    } else if escaped == 'v' {
                        value += "\v";
                    } else if escaped == 'x' {
                        this.Advance(1);
                        let mut digits = String();

                        while this.IsHexDigit(this.CurrentChar()) {
                            digits += this.CurrentChar();
                            this.Advance(1);
                        } else {
                            if report { Logger::Log("Invalid hexadecimal escape sequence.", span, LogSeverity::Error); }
                        }

                        if report && digits.Size() > 3 {
                            Logger::Log("Hexadecimal escape sequence too long.", span, LogSeverity::Error);
                        }

                        if !digits.Empty() {
                            value += digits.ToUnsignedInteger(16).Unwrap() as i8;
                        }

                        this.index -= 1;
                    } else {
                        let mut digits = String();

                        while this.IsOctDigit(this.CurrentChar()) {
                            digits += this.CurrentChar();
                            this.Advance(1);
                        } else {
                            if report { Logger::Log("Invalid octal escape sequence.", span, LogSeverity::Error); }
                        }

                        if report && digits.Size() > 4 {
                            Logger::Log("Octal escape sequence too long.", span, LogSeverity::Error);
                        }

                        if !digits.Empty() {
                            value += digits.ToUnsignedInteger(8).Unwrap() as i8;
                        }

                        this.index -= 1;
                    } this.Advance(1);
                }
            } else {
                value += this.CurrentChar();
                this.Advance(1);
            }
        }

        if this.CurrentChar() == quote_char {
            this.Advance(1);
        } else if report {
            Logger::Log("Unterminated string literal.", span, LogSeverity::Error);
        }

        value
    }

    fn LexString(&mut this) -> Token {
        let mut token: Token;
        token.span = this.Span();
        token._type = if this.CurrentChar() != '"' { TokenType::Character } else { TokenType::String };
        this.ScanString(true);
        token
    }

    fn IsLabel(&this) -> bool {
        if this.CurrentChar() != '\'' || !this.IsAlpha(this.PeekChar(1)) {
            return false;
        }

        let mut offset: usize = 2;

        while this.IsAlphaNum(this.PeekChar(offset)) {
            offset += 1;
        }

        this.PeekChar(offset) != '\''
    }

    fn LexLabel(&mut this) -> Token {
        let mut token: Token;
        (token._type, token.span) = (TokenType::Label, this.Span());
        this.Advance(1);

        while this.IsAlphaNum(this.CurrentChar()) {
            this.Advance(1);
        }

        token
    }

    fn LexNumber(&mut this) -> Token {
        let mut token: Token;
        token.span = this.Span();
        token._type = TokenType::Integer;

        if this.CurrentChar() == '0' {
            this.Advance(1);

            if this.CurrentChar() == 'x' || this.CurrentChar() == 'X' {
                this.Advance(1);

                while this.IsHexDigit(this.CurrentChar()) {
                    this.Advance(1);
                }
            } else if this.CurrentChar() == 'b' || this.CurrentChar() == 'B' {
                this.Advance(1);

                while this.IsBinDigit(this.CurrentChar()) {
                    this.Advance(1);
                }
            } else if this.CurrentChar() == 'o' || this.CurrentChar() == 'O' {
                this.Advance(1);

                while this.IsOctDigit(this.CurrentChar()) {
                    this.Advance(1);
                }
            } else {
                while this.IsDigit(this.CurrentChar()) {
                    this.Advance(1);
                }
            }
        } else {
            while this.IsDigit(this.CurrentChar()) {
                this.Advance(1);
            }
        }

        if this.CurrentChar() == '.' && this.IsDigit(this.PeekChar(1)) {
            token._type = TokenType::Float;
            this.Advance(1);

            while this.IsDigit(this.CurrentChar()) {
                this.Advance(1);
            }
        }

        if this.CurrentChar() == 'e' || this.CurrentChar() == 'E' {
            token._type = TokenType::Float;
            this.Advance(1);

            if this.CurrentChar() == '+' || this.CurrentChar() == '-' {
                this.Advance(1);
            }

            while this.IsDigit(this.CurrentChar()) {
                this.Advance(1);
            }
        }

        if this.CurrentChar() == 'i' || this.CurrentChar() == 'u' {
            this.Advance(1);

            while this.IsAlphaNum(this.CurrentChar()) {
                this.Advance(1);
            }
        } else if this.CurrentChar() == 'f' {
            token._type = TokenType::Float;
            this.Advance(1);

            while this.IsDigit(this.CurrentChar()) {
                this.Advance(1);
            }
        }

        token
    }

    fn LexIdentifier(&mut this) -> Token {
        let mut token: Token;
        token.span = this.Span();
        let start = this.index;

        loop {
            let byte = this.CurrentChar() as u8;

            if byte > 0x7F {
                this.Advance(if (byte & 0xE0) == 0xC0 { 2 } else if (byte & 0xF0) == 0xE0 { 3 } else { 4 });
            } else {
                let accepted = if this.index > start {
                    this.IsAlphaNum(byte as i8)
                } else {
                    this.IsAlpha(byte as i8)
                };

                if accepted {
                    this.Advance(1);
                } else {
                    break;
                }
            }
        }

        let text = String(this.file->text, start, this.index - start);

        if this.preprocessor {
            token._type = StringToDirective(text);
        } else {
            token._type = StringToKeyword(text);

            if token._type == TokenType::Assembly {
                this.assembly = true;
            }
        }

        if token._type == TokenType::Unknown {
            token._type = TokenType::Identifier;
        }

        token
    }

    fn LexSymbol(&mut this) -> Token {
        let mut token: Token;
        token.span = this.Span();
        let current = this.CurrentChar();
        let next = this.PeekChar(1);

        if current == '@' {
            token._type = TokenType::At;
            this.Advance(1);
        } else if current == '#' && next == '[' {
            this.preprocessor = true;
            token._type = TokenType::PreprocessorStart;
            this.Advance(2);
        } else if current == '+' {
            if next == '=' {
                token._type = TokenType::PlusAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::Plus;
                this.Advance(1);
            }
        } else if current == '-' {
            if next == '=' {
                token._type = TokenType::MinusAssign;
                this.Advance(2);
            } else if next == '>' {
                token._type = TokenType::Arrow;
                this.Advance(2);
            } else {
                token._type = TokenType::Minus;
                this.Advance(1);
            }
        } else if current == '*' {
            if next == '=' {
                token._type = TokenType::MulAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::Mul;
                this.Advance(1);
            }
        } else if current == '/' {
            if next == '=' {
                token._type = TokenType::DivAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::Div;
                this.Advance(1);
            }
        } else if current == '%' {
            if next == '=' {
                token._type = TokenType::ModAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::Mod;
                this.Advance(1);
            }
        } else if current == '<' {
            if next == '<' && this.PeekChar(2) == '=' {
                token._type = TokenType::LeftShiftAssign;
                this.Advance(3);
            } else if next == '=' {
                token._type = TokenType::LessEqual;
                this.Advance(2);
            } else {
                token._type = TokenType::Less;
                this.Advance(1);
            }
        } else if current == '>' {
            if next == '>' && this.PeekChar(2) == '=' {
                token._type = TokenType::RightShiftAssign;
                this.Advance(3);
            } else if next == '=' {
                token._type = TokenType::GreaterEqual;
                this.Advance(2);
            } else {
                token._type = TokenType::Greater;
                this.Advance(1);
            }
        } else if current == '&' {
            if next == '&' {
                token._type = TokenType::And;
                this.Advance(2);
            } else if next == '=' {
                token._type = TokenType::AndAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::BitwiseAnd;
                this.Advance(1);
            }
        } else if current == '|' {
            if next == '|' {
                token._type = TokenType::Or;
                this.Advance(2);
            } else if next == '=' {
                token._type = TokenType::OrAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::BitwiseOr;
                this.Advance(1);
            }
        } else if current == '^' {
            if next == '=' {
                token._type = TokenType::XorAssign;
                this.Advance(2);
            } else {
                token._type = TokenType::BitwiseXor;
                this.Advance(1);
            }
        } else if current == '=' {
            if next == '=' {
                token._type = TokenType::Equal;
                this.Advance(2);
            } else if next == '>' {
                token._type = TokenType::FatArrow;
                this.Advance(2);
            } else {
                token._type = TokenType::Assign;
                this.Advance(1);
            }
        } else if current == '!' {
            if next == '=' {
                token._type = TokenType::NotEqual;
                this.Advance(2);
            } else {
                token._type = TokenType::Not;
                this.Advance(1);
            }
        } else if current == '?' {
            token._type = TokenType::QuestionMark;
            this.Advance(1);
        } else if current == '~' {
            token._type = TokenType::Tilde;
            this.Advance(1);
        } else if current == '.' {
            if next == '.' {
                if this.PeekChar(2) == '.' {
                    token._type = TokenType::ThreeDot;
                    this.Advance(3);
                } else {
                    token._type = TokenType::TwoDot;
                    this.Advance(2);
                }
            } else {
                token._type = TokenType::Dot;
                this.Advance(1);
            }
        } else if current == ',' {
            token._type = TokenType::Comma;
            this.Advance(1);
        } else if current == ':' {
            if next == ':' {
                token._type = TokenType::DoubleColon;
                this.Advance(2);
            } else {
                token._type = TokenType::Colon;
                this.Advance(1);
            }
        } else if current == ';' {
            if this.assembly {
                Logger::Log("Expected an assembly block before the semicolon.", token, LogSeverity::Error);
            }

            token._type = TokenType::Semicolon;
            this.Advance(1);
        } else if current == '(' {
            token._type = TokenType::LeftParen;
            this.Advance(1);
        } else if current == ')' {
            token._type = TokenType::RightParen;
            this.Advance(1);
        } else if current == '[' {
            token._type = TokenType::LeftBracket;
            this.Advance(1);
        } else if current == ']' {
            if this.preprocessor {
                this.preprocessor = false;
                token._type = TokenType::PreprocessorEnd;
                this.Advance(1);
            } else {
                token._type = TokenType::RightBracket;
                this.Advance(1);
            }
        } else if current == '{' {
            token._type = TokenType::LeftBrace;
            this.Advance(1);
        } else if current == '}' {
            token._type = TokenType::RightBrace;
            this.Advance(1);
        } else if current == '\\' {
            token._type = TokenType::Backslash;
            this.Advance(1);
        } else {
            Logger::Log("Invalid symbol '" + current.ToString() + "'.", token, LogSeverity::Error);
            this.Advance(1);
        }

        token
    }

    fn ScanAssembly(&mut this, report: bool) -> String {
        let span = this.Span();
        let (mut state, mut indent) = (true, 1usize);
        let (mut value, mut accumulator) = (String(), String());
        this.Advance(1);

        while this.CurrentChar() != '\0' {
            let mut character = this.CurrentChar();

            if character == '\r' {
                if this.PeekChar(1) == '\n' {
                    this.Advance(1);
                } character = '\n';
            }

            if character == '{' {
                indent += 1;
            } else if character == '}' {
                indent -= 1;

                if indent == 0 {
                    break;
                }
            }

            if character != ' ' && character != '\t' && character != '\n' {
                if !accumulator.Empty() {
                    value += accumulator;
                    accumulator.Clear();
                }

                state = false;
                value += character;
            } else if !state {
                state = character == '\n';
                accumulator += character;
            } this.Advance(1);
        }

        if report && indent > 0 {
            Logger::Log("Unterminated assembly block.", span, LogSeverity::Error);
        }

        this.Advance(1);
        this.assembly = false;
        value
    }

    fn LexAssembly(&mut this) -> Token {
        let mut token: Token;
        (token._type, token.span) = (TokenType::AssemblyText, this.Span());
        this.ScanAssembly(true);
        token
    }

    pub fn Lex(&mut this, text: &String, file: &String) -> Vector<Token> {
        this.Open(Sources()->Add(file, text));
        this.index = 0;
        let mut tokens = Vector<Token>();

        while this.CurrentChar() != '\0' {
            this.SkipWhitespace();

            if this.CurrentChar() == '\0' {
                break;
            }

            if this.CurrentChar() == '\n' {
                this.Advance(1);
                continue;
            }

            if this.SkipComment() {
                continue;
            }

            let character = this.CurrentChar();

            let mut token = if this.IsLabel() {
                this.LexLabel()
            } else if character == '"' || character == '\'' {
                this.LexString()
            } else if this.IsDigit(character) {
                this.LexNumber()
            } else if this.IsAlpha(character) || (character as u8) > 0x7F {
                this.LexIdentifier()
            } else if this.assembly && character == '{' {
                this.LexAssembly()
            } else {
                this.LexSymbol()
            };

            token.span.end = this.index as u32;
            tokens.PushBack(token);
        }

        let mut eof: Token;
        (eof._type, eof.span) = (TokenType::EndOfFile, this.Span());
        tokens.PushBack(eof);
        tokens
    }
}
