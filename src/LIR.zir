#[include "std/str", "std/vec", "std/arena" : *]

enum LIROperandKind: u8 {
    Register, Immediate, Memory, Block, Symbol
}

class LIROperand {
    pub kind: LIROperandKind;

    LIROperand(&mut this, kind: LIROperandKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == LIROperandKind::Register {
            return (this as *LIRRegisterOperand)->ToString();
        } else if this.kind == LIROperandKind::Immediate {
            return (this as *LIRImmediateOperand)->ToString();
        } else if this.kind == LIROperandKind::Memory {
            return (this as *LIRMemoryOperand)->ToString();
        } else if this.kind == LIROperandKind::Block {
            return (this as *LIRBlockOperand)->ToString();
        } else if this.kind == LIROperandKind::Symbol {
            return (this as *LIRSymbolOperand)->ToString();
        } else {
            return "<invalid operand>".ToString();
        }
    }
}

enum LIRRegisterKind: u8 {
    Virtual, Physical
}

class LIRRegisterOperand : LIROperand {
    pub kind: LIRRegisterKind;

    LIRRegisterOperand(&mut this, kind: LIRRegisterKind) : LIROperand(LIROperandKind::Register) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == LIRRegisterKind::Virtual {
            return (this as *LIRVirtualRegister)->ToString();
        } else if this.kind == LIRRegisterKind::Physical {
            return (this as *LIRPhysicalRegister)->ToString();
        } else {
            return "<invalid register>".ToString();
        }
    }
}

class LIRVirtualRegister : LIRRegisterOperand {
    pub index: u32;

    LIRVirtualRegister(&mut this, index: u32) : LIRRegisterOperand(LIRRegisterKind::Virtual) {
        this.index = index;
    }

    pub fn ToString(&this) -> String {
        return 'v' + String::FromInteger(this.index as u64);
    }
}

const LIR_ZERO: u8 = 0;
const LIR_RA: u8 = 1;
const LIR_SP: u8 = 2;
const LIR_FP: u8 = 5;
const LIR_S1: u8 = 6;
const LIR_S11: u8 = 16;
const LIR_T0: u8 = 17;
const LIR_T5: u8 = 22;
const LIR_T6: u8 = 23;
const LIR_A0: u8 = 24;
const LIR_A7: u8 = 31;
const LIR_ARGUMENT_COUNT: usize = 8;

fn LIRRegisterName(index: u8) -> String {
    if index == 0 { return "zero".ToString(); }
    else if index == 1 { return "ra".ToString(); }
    else if index == 2 { return "sp".ToString(); }
    else if index == 3 { return "gp".ToString(); }
    else if index == 4 { return "tp".ToString(); }
    else if index == 5 { return "fp".ToString(); }
    else if index <= 16 { return 's' + String::FromInteger((index - 5) as u64); }
    else if index <= 23 { return 't' + String::FromInteger((index - 17) as u64); }
    else if index <= 31 { return 'a' + String::FromInteger((index - 24) as u64); }
    else { return "<invalid register>".ToString(); }
}

fn LIRRegisterIndex(name: &String) -> i32 {
    if name == "zero" { return 0; }
    else if name == "ra" { return 1; }
    else if name == "sp" { return 2; }
    else if name == "gp" { return 3; }
    else if name == "tp" { return 4; }
    else if name == "fp" { return 5; }
    else if name.Length() < 2 { return -1; }
    let rest = name.SubString(1);

    for character in rest {
        if character < '0' || character > '9' {
            return -1;
        }
    }

    let index = rest.ToInteger(10) as i32;
    if name.StartsWith('x') && index <= 31 { return index; }
    else if name.StartsWith('s') && index <= 11 { return index + 5; }
    else if name.StartsWith('t') && index <= 6 { return index + 17; }
    else if name.StartsWith('a') && index <= 7 { return index + 24; }
    else { return -1; }
}

class LIRPhysicalRegister : LIRRegisterOperand {
    pub index: u8,
    pub name: String;

    LIRPhysicalRegister(&mut this, index: u8, name: String) : LIRRegisterOperand(LIRRegisterKind::Physical) {
        (this.index, this.name) = (index, name);
    }

    pub fn ToString(&this) -> String {
        if this.name.Empty() {
            return 'x' + String::FromInteger(this.index as u64);
        } return this.name;
    }
}

class LIRImmediateOperand : LIROperand {
    pub value: i64;

    LIRImmediateOperand(&mut this, value: i64) : LIROperand(LIROperandKind::Immediate) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class LIRMemoryOperand : LIROperand {
    pub base: *LIROperand,
    pub offset: i32;

    LIRMemoryOperand(&mut this, base: *LIROperand, offset: i32) : LIROperand(LIROperandKind::Memory) {
        (this.base, this.offset) = (base, offset);
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.offset as i64) + '(' + this.base->ToString() + ')';
    }
}

class LIRBlockOperand : LIROperand {
    pub block: *LIRBlock;

    LIRBlockOperand(&mut this, block: *LIRBlock) : LIROperand(LIROperandKind::Block) {
        this.block = block;
    }

    pub fn ToString(&this) -> String {
        return this.block->ToString();
    }
}

class LIRSymbolOperand : LIROperand {
    pub name: String;

    LIRSymbolOperand(&mut this, name: String) : LIROperand(LIROperandKind::Symbol) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        return "@\"" + this.name + '"';
    }
}

enum LIROpcode: u16 {
    Nop,
    Lb, Lbu, Lh, Lhu, Lw, Lui, Auipc, Sb, Sh, Sw,
    B, Br, Bl, Blr, Beq, Bne, Blt, Bltu, Bge, Bgeu,
    Slt, Slti, Sltu, Sltiu,
    Add, Addi, Sub, Subi,
    Mul, Mulh, Mulhsu, Mulhu, Div, Divu, Rem, Remu,
    And, Andi, Or, Ori, Xor, Xori,
    Sll, Slli, Srl, Srli, Sra, Srai,
    Hlt,
    Li, La, Ret, Asm
}

extend LIROpcode {
    pub fn ToString(this) -> String {
        if this == LIROpcode::Nop { return "nop".ToString(); }
        else if this == LIROpcode::Lb { return "lb".ToString(); }
        else if this == LIROpcode::Lbu { return "lbu".ToString(); }
        else if this == LIROpcode::Lh { return "lh".ToString(); }
        else if this == LIROpcode::Lhu { return "lhu".ToString(); }
        else if this == LIROpcode::Lw { return "lw".ToString(); }
        else if this == LIROpcode::Lui { return "lui".ToString(); }
        else if this == LIROpcode::Auipc { return "auipc".ToString(); }
        else if this == LIROpcode::Sb { return "sb".ToString(); }
        else if this == LIROpcode::Sh { return "sh".ToString(); }
        else if this == LIROpcode::Sw { return "sw".ToString(); }
        else if this == LIROpcode::B { return "b".ToString(); }
        else if this == LIROpcode::Br { return "br".ToString(); }
        else if this == LIROpcode::Bl { return "bl".ToString(); }
        else if this == LIROpcode::Blr { return "blr".ToString(); }
        else if this == LIROpcode::Beq { return "beq".ToString(); }
        else if this == LIROpcode::Bne { return "bne".ToString(); }
        else if this == LIROpcode::Blt { return "blt".ToString(); }
        else if this == LIROpcode::Bltu { return "bltu".ToString(); }
        else if this == LIROpcode::Bge { return "bge".ToString(); }
        else if this == LIROpcode::Bgeu { return "bgeu".ToString(); }
        else if this == LIROpcode::Slt { return "slt".ToString(); }
        else if this == LIROpcode::Slti { return "slti".ToString(); }
        else if this == LIROpcode::Sltu { return "sltu".ToString(); }
        else if this == LIROpcode::Sltiu { return "sltiu".ToString(); }
        else if this == LIROpcode::Add { return "add".ToString(); }
        else if this == LIROpcode::Addi { return "addi".ToString(); }
        else if this == LIROpcode::Sub { return "sub".ToString(); }
        else if this == LIROpcode::Subi { return "subi".ToString(); }
        else if this == LIROpcode::Mul { return "mul".ToString(); }
        else if this == LIROpcode::Mulh { return "mulh".ToString(); }
        else if this == LIROpcode::Mulhsu { return "mulhsu".ToString(); }
        else if this == LIROpcode::Mulhu { return "mulhu".ToString(); }
        else if this == LIROpcode::Div { return "div".ToString(); }
        else if this == LIROpcode::Divu { return "divu".ToString(); }
        else if this == LIROpcode::Rem { return "rem".ToString(); }
        else if this == LIROpcode::Remu { return "remu".ToString(); }
        else if this == LIROpcode::And { return "and".ToString(); }
        else if this == LIROpcode::Andi { return "andi".ToString(); }
        else if this == LIROpcode::Or { return "or".ToString(); }
        else if this == LIROpcode::Ori { return "ori".ToString(); }
        else if this == LIROpcode::Xor { return "xor".ToString(); }
        else if this == LIROpcode::Xori { return "xori".ToString(); }
        else if this == LIROpcode::Sll { return "sll".ToString(); }
        else if this == LIROpcode::Slli { return "slli".ToString(); }
        else if this == LIROpcode::Srl { return "srl".ToString(); }
        else if this == LIROpcode::Srli { return "srli".ToString(); }
        else if this == LIROpcode::Sra { return "sra".ToString(); }
        else if this == LIROpcode::Srai { return "srai".ToString(); }
        else if this == LIROpcode::Hlt { return "hlt".ToString(); }
        else if this == LIROpcode::Li { return "li".ToString(); }
        else if this == LIROpcode::La { return "la".ToString(); }
        else if this == LIROpcode::Ret { return "ret".ToString(); }
        else if this == LIROpcode::Asm { return "asm".ToString(); }
        else { return "<invalid instruction>".ToString(); }
    }
}

class LIRInstruction {
    pub opcode: LIROpcode,
    pub defines: Vector<*LIROperand>,
    pub uses: Vector<*LIROperand>,
    pub implicit_defines: Vector<*LIROperand>,
    pub implicit_uses: Vector<*LIROperand>,
    pub text: String;

    LIRInstruction(&mut this, opcode: LIROpcode, defines: Vector<*LIROperand>, uses: Vector<*LIROperand>) {
        (this.opcode, this.defines, this.uses) = (opcode, defines, uses);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if !this.defines.Empty() {
            for i in 0..this.defines.Size() {
                if i > 0 { result += ", "; }
                result += this.defines[i]->ToString();
            } result += " = ";
        }

        result += this.opcode.ToString();

        if this.opcode == LIROpcode::Asm {
            result += " \"" + this.text.Escape() + '"';
        }

        if !this.uses.Empty() {
            result += ' ';

            for i in 0..this.uses.Size() {
                if i > 0 { result += ", "; }
                result += this.uses[i]->ToString();
            }
        }

        if !this.implicit_uses.Empty() {
            result += " [";

            for i in 0..this.implicit_uses.Size() {
                if i > 0 { result += ", "; }
                result += this.implicit_uses[i]->ToString();
            } result += ']';
        } return result;
    }
}

class LIRBlock {
    pub name: String,
    pub index: u32 = 0,
    pub instructions: Vector<*LIRInstruction>,
    pub predecessors: Vector<*LIRBlock>,
    pub successors: Vector<*LIRBlock>;

    LIRBlock(&mut this, name: String) {
        this.name = name;
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = this.name + ':';

        for instruction in this.instructions {
            result += "\n  " + instruction->ToString();
        } return result;
    }

    pub fn ToString(&this) -> String {
        return this.name;
    }
}

class LIRFunction {
    pub name: String,
    pub blocks: Vector<*mut LIRBlock>,
    pub global: bool = true,
    pub has_calls: bool = false,
    pub register_index: u32 = 0,
    pub frame_size: u32 = 0,
    pub outgoing_size: u32 = 0,
    pub saved_registers: Vector<u8>;

    LIRFunction(&mut this, name: String) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        let mut result = "fn @\"" + this.name + '"';

        if !this.blocks.Empty() {
            result += " {\n";

            for i in 0..this.blocks.Size() {
                if i != 0 { result += '\n'; }
                result += this.blocks[i]->ToDefinitionString() + '\n';
            } result += '}';
        } return result;
    }
}

class LIRRelocation {
    pub offset: u32,
    pub symbol: String;

    LIRRelocation(&mut this) {}

    LIRRelocation(&mut this, offset: u32, symbol: String) {
        (this.offset, this.symbol) = (offset, symbol);
    }
}

class LIRGlobal {
    pub name: String,
    pub global: bool,
    pub alignment: u32,
    pub data: Vector<u8>,
    pub relocations: Vector<LIRRelocation>;

    LIRGlobal(&mut this, name: String, global: bool, alignment: u32, size: u32) {
        (this.name, this.global, this.alignment) = (name, global, alignment);

        for i in 0..size {
            this.data.PushBack(0);
        }
    }

    pub fn ToString(&this) -> String {
        let mut result = "global @\"" + this.name + "\" = [";

        for i in 0..this.data.Size() {
            if i > 0 { result += ", "; }
            result += String::FromInteger(this.data[i] as u64);
        } result += ']';

        for relocation in this.relocations {
            result += ", @\"" + relocation.symbol + "\" at " + String::FromInteger(relocation.offset as u64);
        } return result;
    }
}

class LIRModule {
    pub functions: Vector<*mut LIRFunction>,
    pub globals: Vector<*mut LIRGlobal>,
    pub assembly: Vector<String>;

    LIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *LIRFunction = null;

        for global in this.globals {
            result += global->ToString() + '\n';
        }

        if !this.globals.Empty() && !this.functions.Empty() {
            result += '\n';
        }

        for function in this.functions {
            if previous != null {
                result += '\n';

                if !function->blocks.Empty() || !previous->blocks.Empty() {
                    result += '\n';
                }
            }

            result += function->ToString();
            previous = function;
        } return result;
    }
}

class LIRContext {
    pub arena: Arena;

    LIRContext(&mut this) {}
}

class LIRBuilder {
    context: *mut LIRContext,
    module: *mut LIRModule,
    function: *mut LIRFunction = null,
    block: *mut LIRBlock = null;

    LIRBuilder(&mut this) {}

    LIRBuilder(&mut this, context: *mut LIRContext, module: *mut LIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn VirtualRegister(&mut this) -> *mut LIRVirtualRegister {
        let register = this.context->arena.New<LIRVirtualRegister>(this.function->register_index);
        this.function->register_index += 1;
        return register;
    }

    pub fn PhysicalRegister(&mut this, index: u8, name: String) -> *mut LIRPhysicalRegister {
        return this.context->arena.New<LIRPhysicalRegister>(index, name);
    }

    pub fn PhysicalRegister(&mut this, index: u8) -> *mut LIRPhysicalRegister {
        return this.context->arena.New<LIRPhysicalRegister>(index, LIRRegisterName(index));
    }

    pub fn ImmediateOperand(&mut this, value: i64) -> *mut LIRImmediateOperand {
        return this.context->arena.New<LIRImmediateOperand>(value);
    }

    pub fn MemoryOperand(&mut this, base: *LIROperand, offset: i32) -> *mut LIRMemoryOperand {
        return this.context->arena.New<LIRMemoryOperand>(base, offset);
    }

    pub fn BlockOperand(&mut this, block: *LIRBlock) -> *mut LIRBlockOperand {
        return this.context->arena.New<LIRBlockOperand>(block);
    }

    pub fn SymbolOperand(&mut this, name: String) -> *mut LIRSymbolOperand {
        return this.context->arena.New<LIRSymbolOperand>(name);
    }

    pub fn BuildInstruction(&mut this, opcode: LIROpcode, defines: Vector<*LIROperand>, uses: Vector<*LIROperand>) -> *mut LIRInstruction {
        let instruction = this.context->arena.New<LIRInstruction>(opcode, defines, uses);
        this.block->instructions.PushBack(instruction);
        return instruction;
    }

    pub fn BuildBlock(&mut this, name: String) -> *mut LIRBlock {
        let block = this.context->arena.New<LIRBlock>(name);
        this.function->blocks.PushBack(block);
        return block;
    }

    pub fn SetCurrentBlock(&mut this, block: *mut LIRBlock) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&mut this) -> *mut LIRBlock {
        return this.block;
    }

    pub fn BuildGlobal(&mut this, name: String, global: bool, alignment: u32, size: u32) -> *mut LIRGlobal {
        let lowered = this.context->arena.New<LIRGlobal>(name, global, alignment, size);
        this.module->globals.PushBack(lowered);
        return lowered;
    }

    pub fn BuildFunction(&mut this, name: String) -> *mut LIRFunction {
        let function = this.context->arena.New<LIRFunction>(name);
        this.module->functions.PushBack(function);
        return function;
    }

    pub fn SetCurrentFunction(&mut this, function: *mut LIRFunction) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&mut this) -> *mut LIRFunction {
        return this.function;
    }
}
