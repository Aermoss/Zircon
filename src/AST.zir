#[include "std/str", "std/vec", "std/map", "std/pair", "src/Token.zir" : *]

enum ASTNodeKind: i32 {
    Path, Declaration, Statement, Expression, Pattern, Type
}

extend ASTNodeKind {
    pub fn ToString(this) -> String {
        if this == ASTNodeKind::Path { return "Path".ToString(); }
        else if this == ASTNodeKind::Declaration { return "Declaration".ToString(); }
        else if this == ASTNodeKind::Statement { return "Statement".ToString(); }
        else if this == ASTNodeKind::Expression { return "Expression".ToString(); }
        else if this == ASTNodeKind::Pattern { return "Pattern".ToString(); }
        else if this == ASTNodeKind::Type { return "Type".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub start: Token,
    pub end: Token;

    ASTNode(&mut this, kind: ASTNodeKind, start: Token) {
        (this.kind, this.start) = (kind, start);
    }
}

class ASTPathSegment {
    pub name: String,
    pub types: Vector<*ASTType>;

    ASTPathSegment(&mut this) {}

    ASTPathSegment(&mut this, name: String) {
        this.name = name;
    }
}

class ASTPath : ASTNode {
    pub segments: Vector<ASTPathSegment>,
    pub absolute: bool;

    ASTPath(&mut this, absolute: bool, start: Token) : ASTNode(ASTNodeKind::Path, start) {
        this.absolute = absolute;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.absolute {
            result += "::";
        }

        for i in 0..this.segments.Size() {
            let segment = this.segments[i];
            result += segment.name;

            if !segment.types.Empty() {
                result += "<";

                for j in 0..segment.types.Size() {
                    let _type: *ASTType = segment.types[j];
                    result += _type->kind.ToString();

                    if j < segment.types.Size() - 1 {
                        result += ", ";
                    }
                }

                result += ">";
            }

            if i < this.segments.Size() - 1 {
                result += "::";
            }
        } return result;
    }
}

enum ASTTypeKind: u8 {
    Path, Pointer, Reference, Array, Tuple, Function
}

extend ASTTypeKind {
    pub fn ToString(this) -> String {
        if this == ASTTypeKind::Path { return "Path".ToString(); }
        else if this == ASTTypeKind::Pointer { return "Pointer".ToString(); }
        else if this == ASTTypeKind::Reference { return "Reference".ToString(); }
        else if this == ASTTypeKind::Array { return "Array".ToString(); }
        else if this == ASTTypeKind::Tuple { return "Tuple".ToString(); }
        else if this == ASTTypeKind::Function { return "Function".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTType : ASTNode {
    pub kind: ASTTypeKind;

    ASTType(&mut this, kind: ASTTypeKind, start: Token) : ASTNode(ASTNodeKind::Type, start) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == ASTTypeKind::Path {
            return (this as *ASTPathType)->ToString();
        } else if this.kind == ASTTypeKind::Pointer {
            return (this as *ASTPointerType)->ToString();
        } else if this.kind == ASTTypeKind::Reference {
            return (this as *ASTReferenceType)->ToString();
        } else if this.kind == ASTTypeKind::Array {
            return (this as *ASTArrayType)->ToString();
        } else if this.kind == ASTTypeKind::Tuple {
            return (this as *ASTTupleType)->ToString();
        } else if this.kind == ASTTypeKind::Function {
            return (this as *ASTFunctionType)->ToString();
        } else {
            return "<invalid type>".ToString();
        }
    }
}

class ASTPathType : ASTType {
    pub path: *ASTPath;

    ASTPathType(&mut this, path: *ASTPath, start: Token) : ASTType(ASTTypeKind::Path, start) {
        this.path = path;
    }

    pub fn ToString(&this) -> String {
        return this.path->ToString();
    }
}

class ASTPointerType : ASTType {
    pub pointee: *ASTType,
    pub mutable: bool;

    ASTPointerType(&mut this, pointee: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Pointer, start) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "*mut " : "*") + this.pointee->ToString();
    }
}

class ASTReferenceType : ASTType {
    pub pointee: *ASTType,
    pub mutable: bool;

    ASTReferenceType(&mut this, pointee: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Reference, start) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "&mut " : "&") + this.pointee->ToString();
    }
}

class ASTArrayType : ASTType {
    pub element: *ASTType,
    pub length: *ASTExpression;

    ASTArrayType(&mut this, element: *ASTType, length: *ASTExpression, start: Token) : ASTType(ASTTypeKind::Array, start) {
        (this.element, this.length) = (element, length);
    }

    pub fn ToString(&this) -> String {
        return '[' + this.element->ToString() + "; " + this.length->ToString() + ']';
    }
}

class ASTTupleType : ASTType {
    pub elements: Vector<*ASTType>;

    ASTTupleType(&mut this, start: Token) : ASTType(ASTTypeKind::Tuple, start) {}

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.elements.Size() {
            if i != 0 { result += ", "; }
            let element: *ASTType = this.elements[i];
            result += element->ToString();
        } return result + ')';
    }
}

class ASTFunctionType : ASTType {
    pub var_arg: bool = false,
    pub parameters: Vector<*ASTType>,
    pub _return: *ASTType = null;

    ASTFunctionType(&mut this, start: Token) : ASTType(ASTTypeKind::Function, start) {}

    pub fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *ASTType = this.parameters[i];
            result += parameter->ToString();
        }

        if this.var_arg {
            if !this.parameters.Empty() {
                result += ", ";
            } result += "...";
        } result += ')';

        if this._return != null {
            result += " -> " + this._return->ToString();
        } return result;
    }
}

enum ASTPatternKind: u8 {
    Wildcard, Rest, Literal, Identifier, Tuple, Field, Structure, Variant, Or
}

extend ASTPatternKind {
    pub fn ToString(this) -> String {
        if this == ASTPatternKind::Wildcard { return "Wildcard".ToString(); }
        else if this == ASTPatternKind::Rest { return "Rest".ToString(); }
        else if this == ASTPatternKind::Literal { return "Literal".ToString(); }
        else if this == ASTPatternKind::Identifier { return "Identifier".ToString(); }
        else if this == ASTPatternKind::Tuple { return "Tuple".ToString(); }
        else if this == ASTPatternKind::Field { return "Field".ToString(); }
        else if this == ASTPatternKind::Structure { return "Structure".ToString(); }
        else if this == ASTPatternKind::Variant { return "Variant".ToString(); }
        else if this == ASTPatternKind::Or { return "Or".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTPattern : ASTNode {
    pub kind: ASTPatternKind;

    ASTPattern(&mut this, kind: ASTPatternKind, start: Token) : ASTNode(ASTNodeKind::Pattern, start) {
        this.kind = kind;
    }
}

class ASTWildcardPattern : ASTPattern {
    ASTWildcardPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Wildcard, start) {}
}

class ASTRestPattern : ASTPattern {
    ASTRestPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Rest, start) {}
}

class ASTLiteralPattern : ASTPattern {
    pub literal: *ASTExpression;

    ASTLiteralPattern(&mut this, literal: *ASTExpression, start: Token) : ASTPattern(ASTPatternKind::Literal, start) {
        this.literal = literal;
    }
}

class ASTIdentifierPattern : ASTPattern {
    pub name: String,
    pub mutable: bool;

    ASTIdentifierPattern(&mut this, name: String, mutable: bool, start: Token) : ASTPattern(ASTPatternKind::Identifier, start) {
        (this.name, this.mutable) = (name, mutable);
    }
}

class ASTTuplePattern : ASTPattern {
    pub patterns: Vector<*ASTPattern>;

    ASTTuplePattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Tuple, start) {}
}

class ASTFieldPattern : ASTPattern {
    pub name: String,
    pub pattern: *ASTPattern;

    ASTFieldPattern(&mut this, name: String, pattern: *ASTPattern, start: Token) : ASTPattern(ASTPatternKind::Field, start) {
        (this.name, this.pattern) = (name, pattern);
    }
}

class ASTStructurePattern : ASTPattern {
    pub path: *ASTPath,
    pub patterns: Vector<*ASTPattern>;

    ASTStructurePattern(&mut this, path: *ASTPath, start: Token) : ASTPattern(ASTPatternKind::Structure, start) {
        this.path = path;
    }
}

class ASTVariantPattern : ASTPattern {
    pub path: *ASTPath,
    pub patterns: Vector<*ASTPattern>;

    ASTVariantPattern(&mut this, path: *ASTPath, start: Token) : ASTPattern(ASTPatternKind::Variant, start) {
        this.path = path;
    }
}

class ASTOrPattern : ASTPattern {
    pub patterns: Vector<*ASTPattern>;

    ASTOrPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Or, start) {}
}

enum ASTExpressionKind: u8 {
    Literal, Path, Unary, Binary, Ternary, Call,
    PackSplat, MemberAccess, IndexAccess, Cast, New, Delete,
    Assignment, Await, Tuple, Range
}

extend ASTExpressionKind {
    pub fn ToString(this) -> String {
        if this == ASTExpressionKind::Literal { return "Literal".ToString(); }
        else if this == ASTExpressionKind::Path { return "Path".ToString(); }
        else if this == ASTExpressionKind::Unary { return "Unary".ToString(); }
        else if this == ASTExpressionKind::Binary { return "Binary".ToString(); }
        else if this == ASTExpressionKind::Ternary { return "Ternary".ToString(); }
        else if this == ASTExpressionKind::Call { return "Call".ToString(); }
        else if this == ASTExpressionKind::PackSplat { return "PackSplat".ToString(); }
        else if this == ASTExpressionKind::MemberAccess { return "MemberAccess".ToString(); }
        else if this == ASTExpressionKind::IndexAccess { return "IndexAccess".ToString(); }
        else if this == ASTExpressionKind::Cast { return "Cast".ToString(); }
        else if this == ASTExpressionKind::New { return "New".ToString(); }
        else if this == ASTExpressionKind::Delete { return "Delete".ToString(); }
        else if this == ASTExpressionKind::Assignment { return "Assignment".ToString(); }
        else if this == ASTExpressionKind::Await { return "Await".ToString(); }
        else if this == ASTExpressionKind::Tuple { return "Tuple".ToString(); }
        else if this == ASTExpressionKind::Range { return "Range".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTExpression : ASTNode {
    pub kind: ASTExpressionKind;

    ASTExpression(&mut this, kind: ASTExpressionKind, start: Token) : ASTNode(ASTNodeKind::Expression, start) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == ASTExpressionKind::Literal {
            return (this as *ASTLiteral)->ToString();
        } else if this.kind == ASTExpressionKind::Path {
            return (this as *ASTPathExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Unary {
            return (this as *ASTUnaryExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Binary {
            return (this as *ASTBinaryExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Ternary {
            return (this as *ASTTernaryExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Call {
            return (this as *ASTCallExpression)->ToString();
        } else if this.kind == ASTExpressionKind::PackSplat {
            return (this as *ASTPackSplatExpression)->ToString();
        } else if this.kind == ASTExpressionKind::MemberAccess {
            return (this as *ASTMemberAccessExpression)->ToString();
        } else if this.kind == ASTExpressionKind::IndexAccess {
            return (this as *ASTIndexAccessExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Cast {
            return (this as *ASTCastExpression)->ToString();
        } else if this.kind == ASTExpressionKind::New {
            return (this as *ASTNewExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Delete {
            return (this as *ASTDeleteExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Assignment {
            return (this as *ASTAssignmentExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Await {
            return (this as *ASTAwaitExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Tuple {
            return (this as *ASTTupleExpression)->ToString();
        } else if this.kind == ASTExpressionKind::Range {
            return (this as *ASTRangeExpression)->ToString();
        } else {
            return "<invalid expression>".ToString();
        }
    }
}

enum ASTLiteralKind: u8 {
    Boolean, Character, Integer, Float, String, Array, Structure, Null
}

extend ASTLiteralKind {
    pub fn ToString(this) -> String {
        if this == ASTLiteralKind::Boolean { return "Boolean".ToString(); }
        else if this == ASTLiteralKind::Character { return "Character".ToString(); }
        else if this == ASTLiteralKind::Integer { return "Integer".ToString(); }
        else if this == ASTLiteralKind::Float { return "Float".ToString(); }
        else if this == ASTLiteralKind::String { return "String".ToString(); }
        else if this == ASTLiteralKind::Array { return "Array".ToString(); }
        else if this == ASTLiteralKind::Structure { return "Structure".ToString(); }
        else if this == ASTLiteralKind::Null { return "Null".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTLiteral : ASTExpression {
    pub kind: ASTLiteralKind;

    ASTLiteral(&mut this, kind: ASTLiteralKind, start: Token) : ASTExpression(ASTExpressionKind::Literal, start) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == ASTLiteralKind::Boolean {
            return (this as *ASTBooleanLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Character {
            return (this as *ASTCharacterLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Integer {
            return (this as *ASTIntegerLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Float {
            return (this as *ASTFloatLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::String {
            return (this as *ASTStringLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Array {
            return (this as *ASTArrayLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Structure {
            return (this as *ASTStructureLiteral)->ToString();
        } else if this.kind == ASTLiteralKind::Null {
            return (this as *ASTNullLiteral)->ToString();
        } else {
            return "<invalid literal>".ToString();
        }
    }
}

class ASTBooleanLiteral : ASTLiteral {
    pub value: bool;

    ASTBooleanLiteral(&mut this, value: bool, start: Token) : ASTLiteral(ASTLiteralKind::Boolean, start) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return (this.value ? "true" : "false").ToString();
    }
}

class ASTCharacterLiteral : ASTLiteral {
    pub value: u32;

    ASTCharacterLiteral(&mut this, value: u32, start: Token) : ASTLiteral(ASTLiteralKind::Character, start) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '\'' + String(this.value as i8).Escape() + '\'';
    }
}

class ASTIntegerLiteral : ASTLiteral {
    pub value: u64,
    pub suffix: String;

    ASTIntegerLiteral(&mut this, value: u64, suffix: String, start: Token) : ASTLiteral(ASTLiteralKind::Integer, start) {
        (this.value, this.suffix) = (value, suffix);
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value) + this.suffix;
    }
}

class ASTFloatLiteral : ASTLiteral {
    pub value: f64,
    pub suffix: String;

    ASTFloatLiteral(&mut this, value: f64, suffix: String, start: Token) : ASTLiteral(ASTLiteralKind::Float, start) {
        (this.value, this.suffix) = (value, suffix);
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value) + this.suffix;
    }
}

class ASTStringLiteral : ASTLiteral {
    pub value: String;

    ASTStringLiteral(&mut this, value: String, start: Token) : ASTLiteral(ASTLiteralKind::String, start) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class ASTArrayLiteral : ASTLiteral {
    pub elements: Vector<*ASTExpression>;

    ASTArrayLiteral(&mut this, start: Token) : ASTLiteral(ASTLiteralKind::Array, start) {}

    pub fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.elements.Size() {
            if i > 0 { result += ", "; }
            let element: *ASTExpression = this.elements[i];
            result += element->ToString();
        } return result + '}';
    }
}

class ASTStructureLiteral : ASTLiteral {
    pub target: *ASTExpression,
    pub fields: Map<String, *ASTExpression>;

    ASTStructureLiteral(&mut this, target: *ASTExpression, start: Token) : ASTLiteral(ASTLiteralKind::Structure, start) {
        this.target = target;
    }

    pub fn ToString(&this) -> String {
        let mut result = this.target->ToString() + " { ";

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }
            let (name, expression) = (this.fields[i].left, this.fields[i].right);
            result += name + ": " + expression->ToString();
        } return result + " }";
    }
}

class ASTNullLiteral : ASTLiteral {
    ASTNullLiteral(&mut this, start: Token) : ASTLiteral(ASTLiteralKind::Null, start) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

class ASTPathExpression : ASTExpression {
    pub path: *ASTPath;

    ASTPathExpression(&mut this, path: *ASTPath, start: Token) : ASTExpression(ASTExpressionKind::Path, start) {
        this.path = path;
    }

    pub fn ToString(&this) -> String {
        return this.path->ToString();
    }
}

enum ASTUnaryKind: u8 {
    AddressOf, Dereference, Negate, Not
}

extend ASTUnaryKind {
    pub fn ToString(this) -> String {
        if this == ASTUnaryKind::AddressOf { return '&'.ToString(); }
        else if this == ASTUnaryKind::Dereference { return '*'.ToString(); }
        else if this == ASTUnaryKind::Negate { return '-'.ToString(); }
        else if this == ASTUnaryKind::Not { return '!'.ToString(); }
        else { return "<invalid unary>".ToString(); }
    }
}

class ASTUnaryExpression : ASTExpression {
    pub kind: ASTUnaryKind,
    pub operand: *ASTExpression,
    pub mutable: bool;

    ASTUnaryExpression(&mut this, kind: ASTUnaryKind, operand: *ASTExpression, mutable: bool, start: Token) : ASTExpression(ASTExpressionKind::Unary, start) {
        (this.kind, this.operand, this.mutable) = (kind, operand, mutable);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + this.operand->ToString();
    }
}

enum ASTBinaryKind: u8 {
    Add, Subtract, Multiply, Divide, Modulo,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual,
    LogicalAnd, LogicalOr, BitwiseAnd, BitwiseOr, BitwiseXor,
    LeftShift, RightShift
}

extend ASTBinaryKind {
    pub fn ToString(this) -> String {
        if this == ASTBinaryKind::Add { return '+'.ToString(); }
        else if this == ASTBinaryKind::Subtract { return '-'.ToString(); }
        else if this == ASTBinaryKind::Multiply { return '*'.ToString(); }
        else if this == ASTBinaryKind::Divide { return '/'.ToString(); }
        else if this == ASTBinaryKind::Modulo { return '%'.ToString(); }
        else if this == ASTBinaryKind::Equal { return "==".ToString(); }
        else if this == ASTBinaryKind::NotEqual { return "!=".ToString(); }
        else if this == ASTBinaryKind::Less { return '<'.ToString(); }
        else if this == ASTBinaryKind::LessEqual { return "<=".ToString(); }
        else if this == ASTBinaryKind::Greater { return '>'.ToString(); }
        else if this == ASTBinaryKind::GreaterEqual { return ">=".ToString(); }
        else if this == ASTBinaryKind::LogicalAnd { return "&&".ToString(); }
        else if this == ASTBinaryKind::LogicalOr { return "||".ToString(); }
        else if this == ASTBinaryKind::BitwiseAnd { return '&'.ToString(); }
        else if this == ASTBinaryKind::BitwiseOr { return '|'.ToString(); }
        else if this == ASTBinaryKind::BitwiseXor { return '^'.ToString(); }
        else if this == ASTBinaryKind::LeftShift { return "<<".ToString(); }
        else if this == ASTBinaryKind::RightShift { return ">>".ToString(); }
        else { return "<invalid binary>".ToString(); }
    }
}

class ASTBinaryExpression : ASTExpression {
    pub kind: ASTBinaryKind,
    pub left: *ASTExpression,
    pub right: *ASTExpression;

    ASTBinaryExpression(&mut this, kind: ASTBinaryKind, left: *ASTExpression, right: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Binary, start) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        return this.left->ToString() + ' ' + this.kind.ToString() + ' ' + this.right->ToString();
    }
}

class ASTTernaryExpression : ASTExpression {
    pub condition: *ASTExpression,
    pub then: *ASTExpression,
    pub _else: *ASTExpression;

    ASTTernaryExpression(&mut this, condition: *ASTExpression, then: *ASTExpression, _else: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Ternary, start) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }

    pub fn ToString(&this) -> String {
        return this.condition->ToString() + " ? " + this.then->ToString() + " : " + this._else->ToString();
    }
}

class ASTCallExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub arguments: Vector<*ASTExpression>;

    ASTCallExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Call, start) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        let mut result = this.expression->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *ASTExpression = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class ASTPackSplatExpression : ASTExpression {
    pub expression: *ASTExpression;

    ASTPackSplatExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::PackSplat, start) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return this.expression->ToString() + "...";
    }
}

class ASTMemberAccessExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub member: String,
    pub types: Vector<*ASTType>,
    pub arrow: bool;

    ASTMemberAccessExpression(&mut this, expression: *ASTExpression, arrow: bool, start: Token) : ASTExpression(ASTExpressionKind::MemberAccess, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }

    pub fn ToString(&this) -> String {
        return this.expression->ToString() + (this.arrow ? "->" : ".") + this.member;
    }
}

class ASTIndexAccessExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub index: *ASTExpression;

    ASTIndexAccessExpression(&mut this, expression: *ASTExpression, index: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::IndexAccess, start) {
        (this.expression, this.index) = (expression, index);
    }

    pub fn ToString(&this) -> String {
        return this.expression->ToString() + '[' + this.index->ToString() + ']';
    }
}

class ASTCastExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub target: *ASTType;

    ASTCastExpression(&mut this, expression: *ASTExpression, target: *ASTType, start: Token) : ASTExpression(ASTExpressionKind::Cast, start) {
        (this.expression, this.target) = (expression, target);
    }

    pub fn ToString(&this) -> String {
        return '(' + this.expression->ToString() + " as " + this.target->ToString() + ')';
    }
}

class ASTNewExpression : ASTExpression {
    pub _type: *ASTType,
    pub arguments: Vector<*ASTExpression>,
    pub size: *ASTExpression = null,
    pub initialized: bool = false;

    ASTNewExpression(&mut this, _type: *ASTType, start: Token) : ASTExpression(ASTExpressionKind::New, start) {
        this._type = _type;
    }

    pub fn ToString(&this) -> String {
        let mut result = "new " + this._type->ToString();

        if this.size != null {
            result += '[' + this.size->ToString() + ']';
        } else if this.initialized {
            result += '(';

            for i in 0..this.arguments.Size() {
                if i != 0 { result += ", "; }
                let argument: *ASTExpression = this.arguments[i];
                result += argument->ToString();
            } result += ')';
        } return result;
    }
}

class ASTDeleteExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub array: bool = false;

    ASTDeleteExpression(&mut this, start: Token) : ASTExpression(ASTExpressionKind::Delete, start) {}

    pub fn ToString(&this) -> String {
        return (this.array ? "delete[] " : "delete ") + this.expression->ToString();
    }
}

enum ASTAssignmentKind: u8 {
    Assign,
    AddAssign, SubtractAssign, MultiplyAssign, DivideAssign, ModuloAssign,
    AndAssign, OrAssign, XorAssign, LeftShiftAssign, RightShiftAssign
}

extend ASTAssignmentKind {
    pub fn ToString(this) -> String {
        if this == ASTAssignmentKind::Assign { return '='.ToString(); }
        else if this == ASTAssignmentKind::AddAssign { return "+=".ToString(); }
        else if this == ASTAssignmentKind::SubtractAssign { return "-=".ToString(); }
        else if this == ASTAssignmentKind::MultiplyAssign { return "*=".ToString(); }
        else if this == ASTAssignmentKind::DivideAssign { return "/=".ToString(); }
        else if this == ASTAssignmentKind::ModuloAssign { return "%=".ToString(); }
        else if this == ASTAssignmentKind::LeftShiftAssign { return "<<=".ToString(); }
        else if this == ASTAssignmentKind::RightShiftAssign { return ">>=".ToString(); }
        else if this == ASTAssignmentKind::AndAssign { return "&=".ToString(); }
        else if this == ASTAssignmentKind::OrAssign { return "|=".ToString(); }
        else if this == ASTAssignmentKind::XorAssign { return "^=".ToString(); }
        else { return "<invalid assignment>".ToString(); }
    }
}

class ASTAssignmentExpression : ASTExpression {
    pub kind: ASTAssignmentKind,
    pub left: *ASTExpression,
    pub right: *ASTExpression,
    pub next: *mut ASTAssignmentExpression = null;

    ASTAssignmentExpression(&mut this, kind: ASTAssignmentKind, left: *ASTExpression, right: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Assignment, start) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        if this.next == null {
            return this.left->ToString() + ' ' + this.kind.ToString() + ' ' + this.right->ToString();
        } else {
            let root: *ASTAssignmentExpression = this;
            let (mut current, mut result) = (root, '('.ToString());

            while current != null {
                if current != root { result += ", "; }
                result += current->left->ToString();
                current = current->next;
            }

            (current, result) = (root, result + ") = (");

            while current != null {
                if current != root { result += ", "; }
                result += current->right->ToString();
                current = current->next;
            } return result + ')';
        }
    }
}

class ASTAwaitExpression : ASTExpression {
    pub expression: *ASTExpression;

    ASTAwaitExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Await, start) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return "await " + this.expression->ToString();
    }
}

class ASTTupleExpression : ASTExpression {
    pub values: Vector<*ASTExpression>;

    ASTTupleExpression(&mut this, start: Token) : ASTExpression(ASTExpressionKind::Tuple, start) {}

    pub fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.values.Size() {
            if i != 0 { result += ", "; }
            let value: *ASTExpression = this.values[i];
            result += value->ToString();
        } return result + ')';
    }
}

class ASTRangeExpression : ASTExpression {
    pub start: *ASTExpression,
    pub end: *ASTExpression,
    pub inclusive: bool = false;

    ASTRangeExpression(&mut this, start: *ASTExpression, end: *ASTExpression, _start: Token) : ASTExpression(ASTExpressionKind::Range, _start) {
        (this.start, this.end) = (start, end);
    }

    pub fn ToString(&this) -> String {
        return this.start->ToString() + (this.inclusive ? "..=" : "..") + this.end->ToString();
    }
}

enum ASTStatementKind: u8 {
    Block, Variable, Expression, If, While, Loop, For, Match, Return, Break, Continue, Unsafe, Assembly
}

extend ASTStatementKind {
    pub fn ToString(this) -> String {
        if this == ASTStatementKind::Block { return "Block".ToString(); }
        else if this == ASTStatementKind::Variable { return "Variable".ToString(); }
        else if this == ASTStatementKind::Expression { return "Expression".ToString(); }
        else if this == ASTStatementKind::If { return "If".ToString(); }
        else if this == ASTStatementKind::While { return "While".ToString(); }
        else if this == ASTStatementKind::Loop { return "Loop".ToString(); }
        else if this == ASTStatementKind::For { return "For".ToString(); }
        else if this == ASTStatementKind::Match { return "Match".ToString(); }
        else if this == ASTStatementKind::Return { return "Return".ToString(); }
        else if this == ASTStatementKind::Break { return "Break".ToString(); }
        else if this == ASTStatementKind::Continue { return "Continue".ToString(); }
        else if this == ASTStatementKind::Unsafe { return "Unsafe".ToString(); }
        else if this == ASTStatementKind::Assembly { return "Assembly".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTStatement : ASTNode {
    pub kind: ASTStatementKind;

    ASTStatement(&mut this, kind: ASTStatementKind, start: Token) : ASTNode(ASTNodeKind::Statement, start) {
        this.kind = kind;
    }
