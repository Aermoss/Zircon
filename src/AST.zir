    pub pack_name: String,
    pub var_arg: bool = false,
    pub _async: bool = false,
    pub _return: *ASTType = null,
    pub constructors: Vector<*ASTCallExpression>,
    pub body: *ASTBlockStatement = null,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTFunctionDeclaration(&mut this, name: String, public: bool, no_mangle: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Function, start) {
        (this.name, this.public, this.no_mangle) = (name, public, no_mangle);
    }
}

