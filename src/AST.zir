enum ASTStatementKind: u8 {
    Variable, Expression, Assembly
}

extend ASTStatementKind {
    pub fn ToString(this) -> String {
        match this {
            ASTStatementKind::Variable => "Variable",
            ASTStatementKind::Expression => "Expression",
            ASTStatementKind::Assembly => "Assembly"
        }.ToString()
    }
}

class ASTStatement : ASTNode {
    pub kind: ASTStatementKind;

    ASTStatement(&mut this, kind: ASTStatementKind, start: Token) : ASTNode(ASTNodeKind::Statement, start) {
        this.kind = kind;
    }
}

class ASTLetStatement : ASTStatement {
    pub pattern: *ASTPattern,
    pub _type: *ASTType,
    pub initializer: *ASTExpression;

    ASTLetStatement(&mut this, pattern: *ASTPattern, _type: *ASTType, initializer: *ASTExpression, start: Token) : ASTStatement(ASTStatementKind::Variable, start) {
        (this.pattern, this._type, this.initializer) = (pattern, _type, initializer);
    }
}

class ASTExpressionStatement : ASTStatement {
    pub expression: *ASTExpression,
    pub semicolon: bool = true;

    ASTExpressionStatement(&mut this, expression: *ASTExpression, start: Token) : ASTStatement(ASTStatementKind::Expression, start) {
        this.expression = expression;
    }
}

class ASTAssemblyOperand {
    pub name: String,
    pub expression: *ASTExpression;

    ASTAssemblyOperand(&mut this, name: String, expression: *ASTExpression) {
        (this.name, this.expression) = (name, expression);
    }
}

class ASTAssemblyStatement : ASTStatement {
    pub _volatile: bool,
    pub text: String,
    pub inputs: Vector<*ASTAssemblyOperand>,
    pub outputs: Vector<*ASTAssemblyOperand>,
    pub clobbers: Vector<String>;

    ASTAssemblyStatement(&mut this, _volatile: bool, start: Token) : ASTStatement(ASTStatementKind::Assembly, start) {
        this._volatile = _volatile;
    }
}

enum ASTDeclarationKind: u8 {
    Parameter, Function, Field, Class, Structure, EnumerationMember, Enumeration, VariantMember, Variant, Constant, Static, Extend, Type, Extern, Assembly
}

extend ASTDeclarationKind {
    pub fn ToString(this) -> String {
        match this {
            ASTDeclarationKind::Parameter => "Parameter",
            ASTDeclarationKind::Function => "Function",
            ASTDeclarationKind::Field => "Field",
            ASTDeclarationKind::Class => "Class",
            ASTDeclarationKind::Structure => "Structure",
            ASTDeclarationKind::EnumerationMember => "EnumerationMember",
            ASTDeclarationKind::Enumeration => "Enumeration",
            ASTDeclarationKind::VariantMember => "VariantMember",
            ASTDeclarationKind::Variant => "Variant",
            ASTDeclarationKind::Constant => "Constant",
            ASTDeclarationKind::Static => "Static",
            ASTDeclarationKind::Extend => "Extend",
            ASTDeclarationKind::Type => "Type",
            ASTDeclarationKind::Extern => "Extern",
            ASTDeclarationKind::Assembly => "Assembly"
        }.ToString()
    }
}

class ASTDeclaration : ASTNode {
    pub kind: ASTDeclarationKind;

    ASTDeclaration(&mut this, kind: ASTDeclarationKind, start: Token) : ASTNode(ASTNodeKind::Declaration, start) {
        this.kind = kind;
    }
}

class ASTParameterDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub mutable: bool;

    ASTParameterDeclaration(&mut this, name: String, _type: *ASTType, mutable: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Parameter, start) {
        (this.name, this._type, this.mutable) = (name, _type, mutable);
    }
}

enum ASTInstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class ASTFunctionDeclaration : ASTDeclaration {
    pub no_mangle: bool,
    pub track_caller: bool,
    pub public: bool,
    pub name: String,
    pub instance_kind: ASTInstanceKind = ::ASTInstanceKind::None,
    pub parameters: Vector<*ASTParameterDeclaration>,
    pub pack_name: String,
    pub var_arg: bool = false,
    pub _async: bool = false,
    pub _virtual: bool = false,
    pub _override: bool = false,
    pub _return: *ASTType = null,
    pub constructors: Vector<*ASTCallExpression>,
    pub body: *ASTBlockExpression = null,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTFunctionDeclaration(&mut this, name: String, public: bool, no_mangle: bool, track_caller: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Function, start) {
        (this.name, this.public, this.no_mangle, this.track_caller) = (name, public, no_mangle, track_caller);
    }
}

class ASTFieldDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub initializer: *ASTExpression,
    pub public: bool;

    ASTFieldDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTExpression, public: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Field, start) {
        (this.name, this._type, this.initializer, this.public) = (name, _type, initializer, public);
    }
}

class ASTClassDeclaration : ASTDeclaration {
    pub name: String,
    pub parent: *ASTType = null,
    pub fields: Vector<*ASTFieldDeclaration>,
    pub constructors: Vector<*ASTFunctionDeclaration>,
    pub destructor: *ASTFunctionDeclaration = null,
    pub methods: Vector<*ASTFunctionDeclaration>,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTClassDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Class, start) {
        this.name = name;
    }
}

class ASTStructureDeclaration : ASTDeclaration {
    pub name: String,
    pub fields: Vector<*ASTFieldDeclaration>,
    pub methods: Vector<*ASTFunctionDeclaration>,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTStructureDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Structure, start) {
        this.name = name;
    }
}

class ASTEnumerationMember : ASTDeclaration {
    pub name: String,
    pub value: *ASTExpression = null;

    ASTEnumerationMember(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::EnumerationMember, start) {
        this.name = name;
    }
}

class ASTEnumerationDeclaration : ASTDeclaration {
    pub name: String,
    pub underlying_type: *ASTType = null,
    pub members: Vector<*ASTEnumerationMember>;

    ASTEnumerationDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Enumeration, start) {
        this.name = name;
    }
}

class ASTVariantField {
    pub name: String,
    pub _type: *ASTType;

    ASTVariantField(&mut this, name: String, _type: *ASTType) {
        (this.name, this._type) = (name, _type);
    }

    ASTVariantField(&mut this, _type: *ASTType) {
        this._type = _type;
    }
}

class ASTVariantMember : ASTDeclaration {
    pub name: String,
