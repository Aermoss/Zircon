#[include "std/str", "std/vec", "std/map", "src/Token.zir" : *]

enum ASTNodeKind: i32 {
    Path, Declaration, Statement, Expression, Pattern, Type
}

extend ASTNodeKind {
    pub fn ToString(this) -> String {
        match this {
            ASTNodeKind::Path => "Path",
            ASTNodeKind::Declaration => "Declaration",
            ASTNodeKind::Statement => "Statement",
            ASTNodeKind::Expression => "Expression",
            ASTNodeKind::Pattern => "Pattern",
            ASTNodeKind::Type => "Type"
        }.ToString()
    }
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub start: Token,
    pub end: Token;

    ASTNode(&mut this, kind: ASTNodeKind, start: Token) {
        (this.kind, this.start) = (kind, start);
    }

    virtual ~ASTNode(&mut this) {}
}

class ASTPathSegment {
    pub name: String,
    pub types: Vector<*ASTType>;

    ASTPathSegment(&mut this) {}

    ASTPathSegment(&mut this, name: String) {
        this.name = name;
    }
}

class ASTPath : ASTNode {
    pub segments: Vector<ASTPathSegment>,
    pub absolute: bool;

    ASTPath(&mut this, absolute: bool, start: Token) : ASTNode(ASTNodeKind::Path, start) {
        this.absolute = absolute;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.absolute {
            result += "::";
        }

        for i in 0..this.segments.Length() {
            let segment = this.segments[i];
            result += segment.name;

            if !segment.types.Empty() {
                result += "<";

                for j in 0..segment.types.Length() {
                    result += segment.types[j]->kind.ToString();

                    if j < segment.types.Length() - 1 {
                        result += ", ";
                    }
                }

                result += ">";
            }

            if i < this.segments.Length() - 1 {
                result += "::";
            }
        }

        result
    }
}

enum ASTTypeKind: u8 {
    Never, Path, Pointer, Reference, Array, Tuple, Function
}

extend ASTTypeKind {
    pub fn ToString(this) -> String {
        match this {
            ASTTypeKind::Never => "Never",
            ASTTypeKind::Path => "Path",
            ASTTypeKind::Pointer => "Pointer",
            ASTTypeKind::Reference => "Reference",
            ASTTypeKind::Array => "Array",
            ASTTypeKind::Tuple => "Tuple",
            ASTTypeKind::Function => "Function"
        }.ToString()
    }
}

class ASTType : ASTNode {
    pub kind: ASTTypeKind;

    ASTType(&mut this, kind: ASTTypeKind, start: Token) : ASTNode(ASTNodeKind::Type, start) {
        this.kind = kind;
    }

    pub virtual fn ToString(&this) -> String;
}

class ASTNeverType : ASTType {
    ASTNeverType(&mut this, start: Token) : ASTType(ASTTypeKind::Never, start) {}

    pub override fn ToString(&this) -> String {
        '!'.ToString()
    }
}

class ASTPathType : ASTType {
    pub path: *ASTPath;

    ASTPathType(&mut this, path: *ASTPath, start: Token) : ASTType(ASTTypeKind::Path, start) {
        this.path = path;
    }

    pub override fn ToString(&this) -> String {
        this.path->ToString()
    }
}

class ASTPointerType : ASTType {
    pub pointee: *ASTType,
    pub mutable: bool;

    ASTPointerType(&mut this, pointee: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Pointer, start) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub override fn ToString(&this) -> String {
        (if this.mutable { "*mut " } else { "*" }) + this.pointee->ToString()
    }
}

class ASTReferenceType : ASTType {
    pub pointee: *ASTType,
    pub mutable: bool;

    ASTReferenceType(&mut this, pointee: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Reference, start) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub override fn ToString(&this) -> String {
        (if this.mutable { "&mut " } else { "&" }) + this.pointee->ToString()
    }
}

class ASTArrayType : ASTType {
    pub element: *ASTType,
    pub length: *ASTExpression;

    ASTArrayType(&mut this, element: *ASTType, length: *ASTExpression, start: Token) : ASTType(ASTTypeKind::Array, start) {
        (this.element, this.length) = (element, length);
    }

    pub override fn ToString(&this) -> String {
        if this.length == null {
            return '[' + this.element->ToString() + ']';
        }

        '[' + this.element->ToString() + "; " + this.length->ToString() + ']'
    }
}

class ASTTupleType : ASTType {
    pub elements: Vector<*ASTType>;

    ASTTupleType(&mut this, start: Token) : ASTType(ASTTypeKind::Tuple, start) {}

    pub override fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.elements.Length() {
            if i != 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ')'
    }
}

class ASTFunctionType : ASTType {
    pub var_arg: bool = false,
    pub parameters: Vector<*ASTType>,
    pub _return: *ASTType = null;

    ASTFunctionType(&mut this, start: Token) : ASTType(ASTTypeKind::Function, start) {}

    pub override fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Length() {
            if i != 0 { result += ", "; }
            result += this.parameters[i]->ToString();
        }

        if this.var_arg {
            if !this.parameters.Empty() {
                result += ", ";
            } result += "...";
        } result += ')';

        if this._return != null {
            result += " -> " + this._return->ToString();
        }

        result
    }
}

enum ASTPatternKind: u8 {
    Wildcard, Rest, Literal, Range, Identifier, Tuple, Field, Structure, Variant, Path, Or
}

extend ASTPatternKind {
    pub fn ToString(this) -> String {
        match this {
            ASTPatternKind::Wildcard => "Wildcard",
            ASTPatternKind::Rest => "Rest",
            ASTPatternKind::Literal => "Literal",
            ASTPatternKind::Range => "Range",
            ASTPatternKind::Identifier => "Identifier",
            ASTPatternKind::Tuple => "Tuple",
            ASTPatternKind::Field => "Field",
            ASTPatternKind::Structure => "Structure",
            ASTPatternKind::Variant => "Variant",
            ASTPatternKind::Path => "Path",
            ASTPatternKind::Or => "Or"
        }.ToString()
    }
}

class ASTPattern : ASTNode {
    pub kind: ASTPatternKind;

    ASTPattern(&mut this, kind: ASTPatternKind, start: Token) : ASTNode(ASTNodeKind::Pattern, start) {
        this.kind = kind;
    }
}

class ASTWildcardPattern : ASTPattern {
    ASTWildcardPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Wildcard, start) {}
}

class ASTRestPattern : ASTPattern {
    ASTRestPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Rest, start) {}
}

class ASTLiteralPattern : ASTPattern {
    pub literal: *ASTExpression;

    ASTLiteralPattern(&mut this, literal: *ASTExpression, start: Token) : ASTPattern(ASTPatternKind::Literal, start) {
        this.literal = literal;
    }
}

class ASTRangePattern : ASTPattern {
    pub start: *ASTExpression,
    pub end: *ASTExpression,
    pub inclusive: bool;

    ASTRangePattern(&mut this, start: *ASTExpression, end: *ASTExpression, inclusive: bool, token: Token) : ASTPattern(ASTPatternKind::Range, token) {
        (this.start, this.end, this.inclusive) = (start, end, inclusive);
    }
}

class ASTIdentifierPattern : ASTPattern {
    pub name: String,
    pub mutable: bool,
    pub reference: bool;

    ASTIdentifierPattern(&mut this, name: String, mutable: bool, reference: bool, start: Token) : ASTPattern(ASTPatternKind::Identifier, start) {
        (this.name, this.mutable, this.reference) = (name, mutable, reference);
    }
}

class ASTTuplePattern : ASTPattern {
    pub patterns: Vector<*ASTPattern>;

    ASTTuplePattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Tuple, start) {}
}

class ASTFieldPattern : ASTPattern {
    pub name: String,
    pub pattern: *ASTPattern;

    ASTFieldPattern(&mut this, name: String, pattern: *ASTPattern, start: Token) : ASTPattern(ASTPatternKind::Field, start) {
        (this.name, this.pattern) = (name, pattern);
    }
}

class ASTStructurePattern : ASTPattern {
    pub path: *ASTPath,
    pub patterns: Vector<*ASTPattern>;

    ASTStructurePattern(&mut this, path: *ASTPath, start: Token) : ASTPattern(ASTPatternKind::Structure, start) {
        this.path = path;
    }
}

class ASTVariantPattern : ASTPattern {
    pub path: *ASTPath,
    pub patterns: Vector<*ASTPattern>;

    ASTVariantPattern(&mut this, path: *ASTPath, start: Token) : ASTPattern(ASTPatternKind::Variant, start) {
        this.path = path;
    }
}

class ASTPathPattern : ASTPattern {
    pub path: *ASTPath;

    ASTPathPattern(&mut this, path: *ASTPath, start: Token) : ASTPattern(ASTPatternKind::Path, start) {
        this.path = path;
    }
}

class ASTOrPattern : ASTPattern {
    pub patterns: Vector<*ASTPattern>;

    ASTOrPattern(&mut this, start: Token) : ASTPattern(ASTPatternKind::Or, start) {}
}

enum ASTExpressionKind: u8 {
    Literal, Path, Unary, Binary, Call,
    PackSplat, MemberAccess, TupleAccess, IndexAccess, Cast,
    New, Delete, Assignment, Await, Range,
    Block, If, While, Loop, For, Match, Return, Break, Continue, Try
}

extend ASTExpressionKind {
    pub fn ToString(this) -> String {
        match this {
            ASTExpressionKind::Literal => "Literal",
            ASTExpressionKind::Path => "Path",
            ASTExpressionKind::Unary => "Unary",
            ASTExpressionKind::Binary => "Binary",
            ASTExpressionKind::Call => "Call",
            ASTExpressionKind::PackSplat => "PackSplat",
            ASTExpressionKind::MemberAccess => "MemberAccess",
            ASTExpressionKind::TupleAccess => "TupleAccess",
            ASTExpressionKind::IndexAccess => "IndexAccess",
            ASTExpressionKind::Cast => "Cast",
            ASTExpressionKind::New => "New",
            ASTExpressionKind::Delete => "Delete",
            ASTExpressionKind::Assignment => "Assignment",
            ASTExpressionKind::Await => "Await",
            ASTExpressionKind::Range => "Range",
            ASTExpressionKind::Block => "Block",
            ASTExpressionKind::If => "If",
            ASTExpressionKind::While => "While",
            ASTExpressionKind::Loop => "Loop",
            ASTExpressionKind::For => "For",
            ASTExpressionKind::Match => "Match",
            ASTExpressionKind::Return => "Return",
            ASTExpressionKind::Break => "Break",
            ASTExpressionKind::Continue => "Continue",
            ASTExpressionKind::Try => "Try"
        }.ToString()
    }
}

class ASTExpression : ASTNode {
    pub kind: ASTExpressionKind;

    ASTExpression(&mut this, kind: ASTExpressionKind, start: Token) : ASTNode(ASTNodeKind::Expression, start) {
        this.kind = kind;
    }

    pub virtual fn ToString(&this) -> String;
}

enum ASTLiteralKind: u8 {
    Boolean, Character, Integer, Float, String, Array, Tuple, Structure, Null
}

extend ASTLiteralKind {
    pub fn ToString(this) -> String {
        match this {
            ASTLiteralKind::Boolean => "Boolean",
            ASTLiteralKind::Character => "Character",
            ASTLiteralKind::Integer => "Integer",
            ASTLiteralKind::Float => "Float",
            ASTLiteralKind::String => "String",
            ASTLiteralKind::Array => "Array",
            ASTLiteralKind::Tuple => "Tuple",
            ASTLiteralKind::Structure => "Structure",
            ASTLiteralKind::Null => "Null"
        }.ToString()
    }
}

class ASTLiteral : ASTExpression {
    pub kind: ASTLiteralKind;

    ASTLiteral(&mut this, kind: ASTLiteralKind, start: Token) : ASTExpression(ASTExpressionKind::Literal, start) {
        this.kind = kind;
    }
}

class ASTBooleanLiteral : ASTLiteral {
    pub value: bool;

    ASTBooleanLiteral(&mut this, value: bool, start: Token) : ASTLiteral(ASTLiteralKind::Boolean, start) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        (if this.value { "true" } else { "false" }).ToString()
    }
}

class ASTCharacterLiteral : ASTLiteral {
    pub value: u32;

    ASTCharacterLiteral(&mut this, value: u32, start: Token) : ASTLiteral(ASTLiteralKind::Character, start) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        '\'' + String(this.value as i8).Escape() + '\''
    }
}

class ASTIntegerLiteral : ASTLiteral {
    pub value: u64,
    pub suffix: String;

    ASTIntegerLiteral(&mut this, value: u64, suffix: String, start: Token) : ASTLiteral(ASTLiteralKind::Integer, start) {
        (this.value, this.suffix) = (value, suffix);
    }

    pub override fn ToString(&this) -> String {
        String::FromInteger(this.value) + this.suffix
    }
}

class ASTFloatLiteral : ASTLiteral {
    pub value: f64,
    pub suffix: String;

    ASTFloatLiteral(&mut this, value: f64, suffix: String, start: Token) : ASTLiteral(ASTLiteralKind::Float, start) {
        (this.value, this.suffix) = (value, suffix);
    }

    pub override fn ToString(&this) -> String {
        String::FromFloat(this.value) + this.suffix
    }
}

class ASTStringLiteral : ASTLiteral {
    pub value: String;

    ASTStringLiteral(&mut this, value: String, start: Token) : ASTLiteral(ASTLiteralKind::String, start) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        '"' + this.value.Escape() + '"'
    }
}

class ASTArrayLiteral : ASTLiteral {
    pub elements: Vector<*ASTExpression>,
    pub count: *ASTExpression = null;

    ASTArrayLiteral(&mut this, start: Token) : ASTLiteral(ASTLiteralKind::Array, start) {}

    pub override fn ToString(&this) -> String {
        if this.count != null {
            return '[' + this.elements[0]->ToString() + "; " + this.count->ToString() + ']';
        }

        let mut result = '['.ToString();

        for i in 0..this.elements.Length() {
            if i > 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ']'
    }
}

class ASTTupleLiteral : ASTLiteral {
    pub elements: Vector<*ASTExpression>;

    ASTTupleLiteral(&mut this, start: Token) : ASTLiteral(ASTLiteralKind::Tuple, start) {}

    pub override fn ToString(&this) -> String {
        let mut result = '('.ToString();

        for i in 0..this.elements.Length() {
            if i != 0 { result += ", "; }
            result += this.elements[i]->ToString();
        }

        result + ')'
    }
}

class ASTStructureLiteral : ASTLiteral {
    pub target: *ASTExpression,
    pub fields: Map<String, *ASTExpression>;

    ASTStructureLiteral(&mut this, target: *ASTExpression, start: Token) : ASTLiteral(ASTLiteralKind::Structure, start) {
        this.target = target;
    }

    pub override fn ToString(&this) -> String {
        let mut result = this.target->ToString() + " { ";

        for i in 0..this.fields.Length() {
            if i > 0 { result += ", "; }
            let (name, expression) = this.fields[i];
            result += name + ": " + expression->ToString();
        }

        result + " }"
    }
}

class ASTNullLiteral : ASTLiteral {
    ASTNullLiteral(&mut this, start: Token) : ASTLiteral(ASTLiteralKind::Null, start) {}

    pub override fn ToString(&this) -> String {
        "null".ToString()
    }
}

class ASTPathExpression : ASTExpression {
    pub path: *ASTPath;

    ASTPathExpression(&mut this, path: *ASTPath, start: Token) : ASTExpression(ASTExpressionKind::Path, start) {
        this.path = path;
    }

    pub override fn ToString(&this) -> String {
        this.path->ToString()
    }
}

enum ASTUnaryKind: u8 {
    AddressOf, Dereference, Negate, Not
}

extend ASTUnaryKind {
    pub fn ToString(this) -> String {
        match this {
            ASTUnaryKind::AddressOf => '&',
            ASTUnaryKind::Dereference => '*',
            ASTUnaryKind::Negate => '-',
            ASTUnaryKind::Not => '!'
        }.ToString()
    }
}

class ASTUnaryExpression : ASTExpression {
    pub kind: ASTUnaryKind,
    pub operand: *ASTExpression,
    pub mutable: bool;

    ASTUnaryExpression(&mut this, kind: ASTUnaryKind, operand: *ASTExpression, mutable: bool, start: Token) : ASTExpression(ASTExpressionKind::Unary, start) {
        (this.kind, this.operand, this.mutable) = (kind, operand, mutable);
    }

    pub override fn ToString(&this) -> String {
        this.kind.ToString() + this.operand->ToString()
    }
}

enum ASTBinaryKind: u8 {
    Add, Subtract, Multiply, Divide, Modulo,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual,
    LogicalAnd, LogicalOr, BitwiseAnd, BitwiseOr, BitwiseXor,
    LeftShift, RightShift
}

extend ASTBinaryKind {
    pub fn ToString(this) -> String {
        match this {
            ASTBinaryKind::Add => '+'.ToString(),
            ASTBinaryKind::Subtract => '-'.ToString(),
            ASTBinaryKind::Multiply => '*'.ToString(),
            ASTBinaryKind::Divide => '/'.ToString(),
            ASTBinaryKind::Modulo => '%'.ToString(),
            ASTBinaryKind::Equal => "==".ToString(),
            ASTBinaryKind::NotEqual => "!=".ToString(),
            ASTBinaryKind::Less => '<'.ToString(),
            ASTBinaryKind::LessEqual => "<=".ToString(),
            ASTBinaryKind::Greater => '>'.ToString(),
            ASTBinaryKind::GreaterEqual => ">=".ToString(),
            ASTBinaryKind::LogicalAnd => "&&".ToString(),
            ASTBinaryKind::LogicalOr => "||".ToString(),
            ASTBinaryKind::BitwiseAnd => '&'.ToString(),
            ASTBinaryKind::BitwiseOr => '|'.ToString(),
            ASTBinaryKind::BitwiseXor => '^'.ToString(),
            ASTBinaryKind::LeftShift => "<<".ToString(),
            ASTBinaryKind::RightShift => ">>".ToString()
        }
    }
}

class ASTBinaryExpression : ASTExpression {
    pub kind: ASTBinaryKind,
    pub left: *ASTExpression,
    pub right: *ASTExpression;

    ASTBinaryExpression(&mut this, kind: ASTBinaryKind, left: *ASTExpression, right: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Binary, start) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub override fn ToString(&this) -> String {
        this.left->ToString() + ' ' + this.kind.ToString() + ' ' + this.right->ToString()
    }
}

class ASTCallExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub arguments: Vector<*ASTExpression>;

    ASTCallExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Call, start) {
        this.expression = expression;
    }

    pub override fn ToString(&this) -> String {
        let mut result = this.expression->ToString() + '(';

        for i in 0..this.arguments.Length() {
            if i != 0 { result += ", "; }
            result += this.arguments[i]->ToString();
        }

        result + ')'
    }
}

class ASTPackSplatExpression : ASTExpression {
    pub expression: *ASTExpression;

    ASTPackSplatExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::PackSplat, start) {
        this.expression = expression;
    }

    pub override fn ToString(&this) -> String {
        this.expression->ToString() + "..."
    }
}

class ASTMemberAccessExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub member: String,
    pub types: Vector<*ASTType>,
    pub arrow: bool;

    ASTMemberAccessExpression(&mut this, expression: *ASTExpression, arrow: bool, start: Token) : ASTExpression(ASTExpressionKind::MemberAccess, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }

    pub override fn ToString(&this) -> String {
        this.expression->ToString() + (if this.arrow { "->" } else { "." }) + this.member
    }
}

class ASTTupleAccessExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub index: usize,
    pub arrow: bool;

    ASTTupleAccessExpression(&mut this, expression: *ASTExpression, index: usize, arrow: bool, start: Token) : ASTExpression(ASTExpressionKind::TupleAccess, start) {
        (this.expression, this.index, this.arrow) = (expression, index, arrow);
    }

    pub override fn ToString(&this) -> String {
        this.expression->ToString() + (if this.arrow { "->" } else { "." }) + String::FromInteger(this.index as u64)
    }
}

class ASTIndexAccessExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub index: *ASTExpression;

    ASTIndexAccessExpression(&mut this, expression: *ASTExpression, index: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::IndexAccess, start) {
        (this.expression, this.index) = (expression, index);
    }

    pub override fn ToString(&this) -> String {
        this.expression->ToString() + '[' + this.index->ToString() + ']'
    }
}

class ASTCastExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub target: *ASTType;

    ASTCastExpression(&mut this, expression: *ASTExpression, target: *ASTType, start: Token) : ASTExpression(ASTExpressionKind::Cast, start) {
        (this.expression, this.target) = (expression, target);
    }

    pub override fn ToString(&this) -> String {
        '(' + this.expression->ToString() + " as " + this.target->ToString() + ')'
    }
}

class ASTNewExpression : ASTExpression {
    pub _type: *ASTType,
    pub arguments: Vector<*ASTExpression>,
    pub size: *ASTExpression = null,
    pub initialized: bool = false;

    ASTNewExpression(&mut this, _type: *ASTType, start: Token) : ASTExpression(ASTExpressionKind::New, start) {
        this._type = _type;
    }

    pub override fn ToString(&this) -> String {
        let mut result = "new " + this._type->ToString();

        if this.size != null {
            result += '[' + this.size->ToString() + ']';
        } else if this.initialized {
            result += '(';

            for i in 0..this.arguments.Length() {
                if i != 0 { result += ", "; }
                result += this.arguments[i]->ToString();
            } result += ')';
        }

        result
    }
}

class ASTDeleteExpression : ASTExpression {
    pub expression: *ASTExpression,
    pub array: bool = false;

    ASTDeleteExpression(&mut this, start: Token) : ASTExpression(ASTExpressionKind::Delete, start) {}

    pub override fn ToString(&this) -> String {
        (if this.array { "delete[] " } else { "delete " }) + this.expression->ToString()
    }
}

enum ASTAssignmentKind: u8 {
    Assign,
    AddAssign, SubtractAssign, MultiplyAssign, DivideAssign, ModuloAssign,
    AndAssign, OrAssign, XorAssign, LeftShiftAssign, RightShiftAssign
}

extend ASTAssignmentKind {
    pub fn ToString(this) -> String {
        match this {
            ASTAssignmentKind::Assign => '='.ToString(),
            ASTAssignmentKind::AddAssign => "+=".ToString(),
            ASTAssignmentKind::SubtractAssign => "-=".ToString(),
            ASTAssignmentKind::MultiplyAssign => "*=".ToString(),
            ASTAssignmentKind::DivideAssign => "/=".ToString(),
            ASTAssignmentKind::ModuloAssign => "%=".ToString(),
            ASTAssignmentKind::LeftShiftAssign => "<<=".ToString(),
            ASTAssignmentKind::RightShiftAssign => ">>=".ToString(),
            ASTAssignmentKind::AndAssign => "&=".ToString(),
            ASTAssignmentKind::OrAssign => "|=".ToString(),
            ASTAssignmentKind::XorAssign => "^=".ToString()
        }
    }
}

class ASTAssignmentExpression : ASTExpression {
    pub kind: ASTAssignmentKind,
    pub left: *ASTExpression,
    pub right: *ASTExpression,
    pub next: *mut ASTAssignmentExpression = null;

    ASTAssignmentExpression(&mut this, kind: ASTAssignmentKind, left: *ASTExpression, right: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Assignment, start) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub override fn ToString(&this) -> String {
        if this.next == null {
            this.left->ToString() + ' ' + this.kind.ToString() + ' ' + this.right->ToString()
        } else {
            let root: *ASTAssignmentExpression = this;
            let (mut current, mut result) = (root, '('.ToString());

            while current != null {
                if current != root { result += ", "; }
                result += current->left->ToString();
                current = current->next;
            }

            (current, result) = (root, result + ") = (");

            while current != null {
                if current != root { result += ", "; }
                result += current->right->ToString();
                current = current->next;
            }

            result + ')'
        }
    }
}

class ASTAwaitExpression : ASTExpression {
    pub expression: *ASTExpression;

    ASTAwaitExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Await, start) {
        this.expression = expression;
    }

    pub override fn ToString(&this) -> String {
        "await " + this.expression->ToString()
    }
}

class ASTRangeExpression : ASTExpression {
    pub start: *ASTExpression,
    pub end: *ASTExpression,
    pub inclusive: bool = false;

    ASTRangeExpression(&mut this, start: *ASTExpression, end: *ASTExpression, _start: Token) : ASTExpression(ASTExpressionKind::Range, _start) {
        (this.start, this.end) = (start, end);
    }

    pub override fn ToString(&this) -> String {
        this.start->ToString() + (if this.inclusive { "..=" } else { ".." }) + this.end->ToString()
    }
}

class ASTBlockExpression : ASTExpression {
    pub statements: Vector<*ASTStatement>,
    pub tail: *ASTExpression = null,
    pub _unsafe: bool = false;

    ASTBlockExpression(&mut this, start: Token) : ASTExpression(ASTExpressionKind::Block, start) {}

    pub override fn ToString(&this) -> String {
        (if this._unsafe { "unsafe { ... }" } else { "{ ... }" }).ToString()
    }
}

class ASTCondition {
    pub pattern: *ASTPattern = null,
    pub expression: *ASTExpression;

    ASTCondition(&mut this, expression: *ASTExpression) {
        this.expression = expression;
    }

    ASTCondition(&mut this, pattern: *ASTPattern, expression: *ASTExpression) {
        (this.pattern, this.expression) = (pattern, expression);
    }

    pub fn ToString(&this) -> String {
        if this.pattern != null {
            return "let ... = " + this.expression->ToString();
        }

        this.expression->ToString()
    }
}

class ASTIfExpression : ASTExpression {
    pub condition: *ASTCondition,
    pub body: *ASTBlockExpression,
    pub _else: *ASTExpression;

    ASTIfExpression(&mut this, condition: *ASTCondition, body: *ASTBlockExpression, _else: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::If, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }

    pub override fn ToString(&this) -> String {
        "if " + this.condition->ToString() + " { ... }"
    }
}

class ASTWhileExpression : ASTExpression {
    pub condition: *ASTCondition,
    pub body: *ASTBlockExpression,
    pub _else: *ASTBlockExpression;

    ASTWhileExpression(&mut this, condition: *ASTCondition, body: *ASTBlockExpression, _else: *ASTBlockExpression, start: Token) : ASTExpression(ASTExpressionKind::While, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }

    pub override fn ToString(&this) -> String {
        "while " + this.condition->ToString() + " { ... }"
    }
}

class ASTLoopExpression : ASTExpression {
    pub body: *ASTBlockExpression;

    ASTLoopExpression(&mut this, body: *ASTBlockExpression, start: Token) : ASTExpression(ASTExpressionKind::Loop, start) {
        this.body = body;
    }

    pub override fn ToString(&this) -> String {
        "loop { ... }".ToString()
    }
}

class ASTForExpression : ASTExpression {
    pub pattern: *ASTPattern,
    pub iterable: *ASTExpression,
    pub body: *ASTBlockExpression;

    ASTForExpression(&mut this, pattern: *ASTPattern, iterable: *ASTExpression, body: *ASTBlockExpression, start: Token) : ASTExpression(ASTExpressionKind::For, start) {
        (this.pattern, this.iterable, this.body) = (pattern, iterable, body);
    }

    pub override fn ToString(&this) -> String {
        "for ... in " + this.iterable->ToString() + " { ... }"
    }
}

class ASTMatchArm {
    pub pattern: *ASTPattern,
    pub guard: *ASTExpression,
    pub body: *ASTBlockExpression;

    ASTMatchArm(&mut this, pattern: *ASTPattern, guard: *ASTExpression, body: *ASTBlockExpression) {
        (this.pattern, this.guard, this.body) = (pattern, guard, body);
    }
}

class ASTMatchExpression : ASTExpression {
    pub target: *ASTExpression,
    pub arms: Vector<*ASTMatchArm>;

    ASTMatchExpression(&mut this, target: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Match, start) {
        this.target = target;
    }

    pub override fn ToString(&this) -> String {
        "match " + this.target->ToString() + " { ... }"
    }
}

class ASTReturnExpression : ASTExpression {
    pub value: *ASTExpression;

    ASTReturnExpression(&mut this, value: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Return, start) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        if this.value != null {
            return "return " + this.value->ToString();
        }

        "return".ToString()
    }
}

class ASTBreakExpression : ASTExpression {
    pub value: *ASTExpression;

    ASTBreakExpression(&mut this, value: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Break, start) {
        this.value = value;
    }

    pub override fn ToString(&this) -> String {
        if this.value != null {
            return "break " + this.value->ToString();
        }

        "break".ToString()
    }
