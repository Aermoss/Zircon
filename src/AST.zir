        this.name = name;
    }
}

class ASTVariantDeclaration : ASTDeclaration {
    pub name: String,
    pub members: Vector<*ASTVariantMember>,
    pub methods: Vector<*ASTFunctionDeclaration>,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTVariantDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Variant, start) {
        this.name = name;
    }
}

class ASTConstantDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub initializer: *ASTExpression;

    ASTConstantDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTExpression, start: Token) : ASTDeclaration(ASTDeclarationKind::Constant, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class ASTStaticDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub mutable: bool,
    pub initializer: *ASTExpression = null,
    pub alignment: *ASTExpression;

    ASTStaticDeclaration(&mut this, name: String, _type: *ASTType, mutable: bool, alignment: *ASTExpression, start: Token) : ASTDeclaration(ASTDeclarationKind::Static, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

class ASTExtendDeclaration : ASTDeclaration {
    pub _type: *ASTType,
    pub methods: Vector<*ASTFunctionDeclaration>;

    ASTExtendDeclaration(&mut this, _type: *ASTType, start: Token) : ASTDeclaration(ASTDeclarationKind::Extend, start) {
        this._type = _type;
    }
}

class ASTTypeDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType;

    ASTTypeDeclaration(&mut this, name: String, _type: *ASTType, start: Token) : ASTDeclaration(ASTDeclarationKind::Type, start) {
        (this.name, this._type) = (name, _type);
    }
}

class ASTExternDeclaration : ASTDeclaration {
