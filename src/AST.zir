class ASTContinueExpression : ASTExpression {
    ASTContinueExpression(&mut this, start: Token) : ASTExpression(ASTExpressionKind::Continue, start) {}

    pub override fn ToString(&this) -> String {
        "continue".ToString()
    }
}

class ASTTryExpression : ASTExpression {
    pub expression: *ASTExpression;

    ASTTryExpression(&mut this, expression: *ASTExpression, start: Token) : ASTExpression(ASTExpressionKind::Try, start) {
        this.expression = expression;
    }

    pub override fn ToString(&this) -> String {
        this.expression->ToString() + "?"
    }
