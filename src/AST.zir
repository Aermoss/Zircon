enum ASTDeclarationKind: u8 {
    Parameter, Function, Field, Class, Structure, EnumerationMember, Enumeration, VariantMember, Variant, Constant, Static, Extend, Type, Extern, Assembly
}

extend ASTDeclarationKind {
    pub fn ToString(this) -> String {
        if this == ASTDeclarationKind::Parameter { return "Parameter".ToString(); }
        else if this == ASTDeclarationKind::Function { return "Function".ToString(); }
        else if this == ASTDeclarationKind::Field { return "Field".ToString(); }
        else if this == ASTDeclarationKind::Class { return "Class".ToString(); }
        else if this == ASTDeclarationKind::Structure { return "Structure".ToString(); }
        else if this == ASTDeclarationKind::EnumerationMember { return "EnumerationMember".ToString(); }
        else if this == ASTDeclarationKind::Enumeration { return "Enumeration".ToString(); }
        else if this == ASTDeclarationKind::VariantMember { return "VariantMember".ToString(); }
        else if this == ASTDeclarationKind::Variant { return "Variant".ToString(); }
        else if this == ASTDeclarationKind::Constant { return "Constant".ToString(); }
        else if this == ASTDeclarationKind::Static { return "Static".ToString(); }
        else if this == ASTDeclarationKind::Extend { return "Extend".ToString(); }
        else if this == ASTDeclarationKind::Type { return "Type".ToString(); }
        else if this == ASTDeclarationKind::Extern { return "Extern".ToString(); }
        else if this == ASTDeclarationKind::Assembly { return "Assembly".ToString(); }
        else { return "Unknown".ToString(); }
    }
}

class ASTDeclaration : ASTNode {
    pub kind: ASTDeclarationKind;

    ASTDeclaration(&mut this, kind: ASTDeclarationKind, start: Token) : ASTNode(ASTNodeKind::Declaration, start) {
        this.kind = kind;
    }
}


