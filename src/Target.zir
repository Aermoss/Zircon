#[include "std/str" : *]

#[if !ZODIAC]
#[include "std/io", "std/std", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Target.zir", "vendor/llvm-c/TargetMachine.zir", "src/Logger.zir" : *]
#[endif]

class TargetInfo {
    pub pointer_size: usize,
    pub pointer_align: usize,
    pub stack_align: usize;

    TargetInfo(&mut this) {}

    TargetInfo(&mut this, pointer_size: usize, pointer_align: usize, stack_align: usize) {
        (this.pointer_size, this.pointer_align, this.stack_align) = (pointer_size, pointer_align, stack_align);
    }
}

enum TargetBackend: u8 {
    LLVM, Zodiac
}

#[if ZODIAC]
class Target {
    pub backend: TargetBackend = TargetBackend::Zodiac,
    pub triple: String;

    Target(&mut this, triple: &String) {
        this.triple = triple;
    }

    pub fn Info(&this) -> TargetInfo {
        TargetInfo(4, 4, 4)
    }
}
#[else]
class Target {
    pub backend: TargetBackend = TargetBackend::LLVM,
    pub target: LLVMTargetRef = null,
    pub target_machine: LLVMTargetMachineRef = null,
    pub layout: LLVMTargetDataRef = null,

    pub triple: String,
    pub arch: String,
    pub code_model: String,
    pub features: String;

    Target(&mut this, triple: &String, arch: &String, code_model: &String, features: &String, opt_level: LLVMCodeGenOptLevel) {
        (this.triple, this.arch, this.code_model, this.features) = (triple, arch, code_model, features);
        if this.triple.Empty() { this.triple = LLVMGetDefaultTargetTriple(); }

        if this.triple.StartsWith("zodiac") {
            this.backend = TargetBackend::Zodiac;
            return;
        }

        if this.arch == "native" { this.arch = LLVMGetHostCPUName(); }
        if this.arch.Empty() { this.arch = "generic"; }
        let mut message: *mut i8 = null;

        if LLVMGetTargetFromTriple(this.triple.Data(), &mut this.target, &mut message) != 0 {
            let final_message = if message != null { message } else { "Unknown reason." };
            WriteLine("\x1b[31mFailed to get target from triple: " + final_message.ToString() + ".\x1b[0m");
            if message != null { LLVMDisposeMessage(message); }
            Exit(1);
        }

        if message != null {
            LLVMDisposeMessage(message);
        }

        let mut model = LLVMCodeModel::LLVMCodeModelDefault;

        if code_model == "tiny" { model = LLVMCodeModel::LLVMCodeModelTiny; }
        else if code_model == "small" { model = LLVMCodeModel::LLVMCodeModelSmall; }
        else if code_model == "medium" { model = LLVMCodeModel::LLVMCodeModelMedium; }
        else if code_model == "large" { model = LLVMCodeModel::LLVMCodeModelLarge; }
        else if code_model == "kernel" { model = LLVMCodeModel::LLVMCodeModelKernel; }
        else if code_model != "default" {
            WriteLine("\x1b[31mInvalid code model: '" + code_model + "''.\x1b[0m");
            Exit(1);
        }

        this.target_machine = LLVMCreateTargetMachine(this.target, this.triple.Data(), this.arch.Data(), this.features.Data(), opt_level, LLVMRelocMode::LLVMRelocDefault, model);
        this.layout = LLVMCreateTargetDataLayout(this.target_machine);
    }

    ~Target(&mut this) {
        if this.target_machine != null {
            LLVMDisposeTargetMachine(this.target_machine);
        }
    }

    pub fn Info(&this) -> TargetInfo {
        if this.backend == TargetBackend::Zodiac {
            return TargetInfo(4, 4, 4);
        }

        TargetInfo(LLVMPointerSize(this.layout) as usize, LLVMPointerSize(this.layout) as usize, 16)
    }

    pub fn Emit(&this, module: LLVMModuleRef, file_name: &String, file_type: LLVMCodeGenFileType) -> String {
        let mut message: *mut i8 = null;
        let mut result = String();

        if LLVMTargetMachineEmitToFile(this.target_machine, module, file_name.Data(), file_type, &mut message) != 0 {
            if message != null {
                result += message;
                LLVMDisposeMessage(message);
            } else {
                result += "Unknown reason.";
            } return result;
        }

        if message != null {
            LLVMDisposeMessage(message);
        }

        result
    }
}
#[endif]
