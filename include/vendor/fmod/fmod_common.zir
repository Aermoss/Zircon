type FMOD_DEBUG_CALLBACK = fn(FMOD_DEBUG_FLAGS, *i8, i32, *i8, *i8) -> FMOD_RESULT;
type FMOD_SYSTEM_CALLBACK = fn(*mut FMOD_SYSTEM, FMOD_SYSTEM_CALLBACK_TYPE, *mut void, *mut void, *mut void) -> FMOD_RESULT;
type FMOD_CHANNELCONTROL_CALLBACK = fn(*mut FMOD_CHANNELCONTROL, FMOD_CHANNELCONTROL_TYPE, FMOD_CHANNELCONTROL_CALLBACK_TYPE, *mut void, *mut void) -> FMOD_RESULT;
type FMOD_DSP_CALLBACK = fn(*mut FMOD_DSP, FMOD_DSP_CALLBACK_TYPE, *mut void) -> FMOD_RESULT;
type FMOD_SOUND_NONBLOCK_CALLBACK = fn(*mut FMOD_SOUND, FMOD_RESULT) -> FMOD_RESULT;
type FMOD_SOUND_PCMREAD_CALLBACK = fn(*mut FMOD_SOUND, *mut void, u32) -> FMOD_RESULT;
type FMOD_SOUND_PCMSETPOS_CALLBACK = fn(*mut FMOD_SOUND, i32, u32, FMOD_TIMEUNIT) -> FMOD_RESULT;
type FMOD_FILE_OPEN_CALLBACK = fn(*i8, *mut u32, *mut *mut void, *mut void) -> FMOD_RESULT;
type FMOD_FILE_CLOSE_CALLBACK = fn(*mut void, *mut void) -> FMOD_RESULT;
type FMOD_FILE_READ_CALLBACK = fn(*mut void, *mut void, u32, *mut u32, *mut void) -> FMOD_RESULT;
type FMOD_FILE_SEEK_CALLBACK = fn(*mut void, u32, *mut void) -> FMOD_RESULT;
type FMOD_FILE_ASYNCREAD_CALLBACK = fn(*mut FMOD_ASYNCREADINFO, *mut void) -> FMOD_RESULT;
type FMOD_FILE_ASYNCCANCEL_CALLBACK = fn(*mut FMOD_ASYNCREADINFO, *mut void) -> FMOD_RESULT;
type FMOD_FILE_ASYNCDONE_FUNC = fn(*mut FMOD_ASYNCREADINFO, FMOD_RESULT);
type FMOD_MEMORY_ALLOC_CALLBACK = fn(u32, FMOD_MEMORY_TYPE, *i8) -> *mut void;
type FMOD_MEMORY_REALLOC_CALLBACK = fn(*mut void, u32, FMOD_MEMORY_TYPE, *i8) -> *mut void;
type FMOD_MEMORY_FREE_CALLBACK = fn(*mut void, FMOD_MEMORY_TYPE, *i8);
type FMOD_3D_ROLLOFF_CALLBACK = fn(*mut FMOD_CHANNELCONTROL, f32) -> f32;

