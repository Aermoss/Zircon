const FMOD_OUTPUT_PLUGIN_VERSION: i32 = 5;
const FMOD_OUTPUT_METHOD_MIX_DIRECT: i32 = 0;
const FMOD_OUTPUT_METHOD_MIX_BUFFERED: i32 = 1;

type FMOD_OUTPUT_METHOD = u32;
type FMOD_OUTPUT_GETNUMDRIVERS_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut i32) -> FMOD_RESULT;
type FMOD_OUTPUT_GETDRIVERINFO_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, i32, *mut i8, i32, *mut FMOD_GUID, *mut i32, *mut FMOD_SPEAKERMODE, *mut i32) -> FMOD_RESULT;
type FMOD_OUTPUT_INIT_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, i32, FMOD_INITFLAGS, *mut i32, *mut FMOD_SPEAKERMODE, *mut i32, *mut FMOD_SOUND_FORMAT, i32, *mut i32, *mut i32, *mut void) -> FMOD_RESULT;
type FMOD_OUTPUT_START_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_STOP_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_CLOSE_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_UPDATE_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_GETHANDLE_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut *mut void) -> FMOD_RESULT;
type FMOD_OUTPUT_MIXER_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_OBJECT3DGETINFO_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut i32) -> FMOD_RESULT;
type FMOD_OUTPUT_OBJECT3DALLOC_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut *mut void) -> FMOD_RESULT;
type FMOD_OUTPUT_OBJECT3DFREE_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut void) -> FMOD_RESULT;
type FMOD_OUTPUT_OBJECT3DUPDATE_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, *mut void, *FMOD_OUTPUT_OBJECT3DINFO) -> FMOD_RESULT;
type FMOD_OUTPUT_OPENPORT_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, FMOD_PORT_TYPE, FMOD_PORT_INDEX, *mut i32, *mut i32, *mut i32, *mut FMOD_SOUND_FORMAT) -> FMOD_RESULT;
type FMOD_OUTPUT_CLOSEPORT_CALLBACK = fn(*mut FMOD_OUTPUT_STATE, i32) -> FMOD_RESULT;
type FMOD_OUTPUT_DEVICELISTCHANGED_CALLBACK = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_READFROMMIXER_FUNC = fn(*mut FMOD_OUTPUT_STATE, *mut void, u32) -> FMOD_RESULT;
type FMOD_OUTPUT_COPYPORT_FUNC = fn(*mut FMOD_OUTPUT_STATE, i32, *mut void, u32) -> FMOD_RESULT;
type FMOD_OUTPUT_REQUESTRESET_FUNC = fn(*mut FMOD_OUTPUT_STATE) -> FMOD_RESULT;
type FMOD_OUTPUT_ALLOC_FUNC = fn(u32, u32, *i8, i32) -> *mut void;
type FMOD_OUTPUT_FREE_FUNC = fn(*mut void, *i8, i32);
type FMOD_OUTPUT_LOG_FUNC = fn(FMOD_DEBUG_FLAGS, *i8, i32, *i8, *i8, ...);

struct FMOD_OUTPUT_DESCRIPTION {
    pub apiversion: u32,
    pub name: *i8,
    pub version: u32,
    pub method: FMOD_OUTPUT_METHOD,
    pub getnumdrivers: FMOD_OUTPUT_GETNUMDRIVERS_CALLBACK,
    pub getdriverinfo: FMOD_OUTPUT_GETDRIVERINFO_CALLBACK,
    pub init: FMOD_OUTPUT_INIT_CALLBACK,
    pub start: FMOD_OUTPUT_START_CALLBACK,
    pub stop: FMOD_OUTPUT_STOP_CALLBACK,
    pub close: FMOD_OUTPUT_CLOSE_CALLBACK,
    pub update: FMOD_OUTPUT_UPDATE_CALLBACK,
    pub gethandle: FMOD_OUTPUT_GETHANDLE_CALLBACK,
    pub mixer: FMOD_OUTPUT_MIXER_CALLBACK,
    pub object3dgetinfo: FMOD_OUTPUT_OBJECT3DGETINFO_CALLBACK,
    pub object3dalloc: FMOD_OUTPUT_OBJECT3DALLOC_CALLBACK,
    pub object3dfree: FMOD_OUTPUT_OBJECT3DFREE_CALLBACK,
    pub object3dupdate: FMOD_OUTPUT_OBJECT3DUPDATE_CALLBACK,
    pub openport: FMOD_OUTPUT_OPENPORT_CALLBACK,
    pub closeport: FMOD_OUTPUT_CLOSEPORT_CALLBACK,
    pub devicelistchanged: FMOD_OUTPUT_DEVICELISTCHANGED_CALLBACK
}

struct FMOD_OUTPUT_STATE {
    pub plugindata: *mut void,
    pub readfrommixer: FMOD_OUTPUT_READFROMMIXER_FUNC,
    pub alloc: FMOD_OUTPUT_ALLOC_FUNC,
    pub free: FMOD_OUTPUT_FREE_FUNC,
    pub log: FMOD_OUTPUT_LOG_FUNC,
    pub copyport: FMOD_OUTPUT_COPYPORT_FUNC,
    pub requestreset: FMOD_OUTPUT_REQUESTRESET_FUNC
}

struct FMOD_OUTPUT_OBJECT3DINFO {
    pub buffer: *mut f32,
    pub bufferlength: u32,
    pub position: FMOD_VECTOR,
    pub gain: f32,
    pub spread: f32,
    pub priority: f32
}
