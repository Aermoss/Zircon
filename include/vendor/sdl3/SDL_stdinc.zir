type SDL_Time = Sint64;

struct SDL_alignment_test {
    pub a: Uint8,
    pub b: *mut void
}

enum SDL_DUMMY_ENUM: i32 {
    DUMMY_ENUM_VALUE
}

type SDL_malloc_func = fn(usize) -> *mut void;
type SDL_calloc_func = fn(usize, usize) -> *mut void;
type SDL_realloc_func = fn(*mut void, usize) -> *mut void;
type SDL_free_func = fn(*mut void);

struct SDL_Environment {}

type SDL_CompareCallback = fn(*void, *void) -> i32;
type SDL_CompareCallback_r = fn(*mut void, *void, *void) -> i32;

struct SDL_iconv_data_t {}

type SDL_iconv_t = *mut SDL_iconv_data_t;

type SDL_FunctionPointer = fn();

