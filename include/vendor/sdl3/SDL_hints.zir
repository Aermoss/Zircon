enum SDL_HintPriority: i32 {
    SDL_HINT_DEFAULT,
    SDL_HINT_NORMAL,
    SDL_HINT_OVERRIDE
}

type SDL_HintCallback = fn(*mut void, *i8, *i8, *i8);

extern "C" {
    fn SDL_SetHintWithPriority(name: *i8, value: *i8, priority: SDL_HintPriority) -> bool;
    fn SDL_SetHint(name: *i8, value: *i8) -> bool;
    fn SDL_ResetHint(name: *i8) -> bool;
    fn SDL_ResetHints();
    fn SDL_GetHint(name: *i8) -> *i8;
    fn SDL_GetHintBoolean(name: *i8, default_value: bool) -> bool;
    fn SDL_AddHintCallback(name: *i8, callback: SDL_HintCallback, userdata: *mut void) -> bool;
    fn SDL_RemoveHintCallback(name: *i8, callback: SDL_HintCallback, userdata: *mut void);
}
