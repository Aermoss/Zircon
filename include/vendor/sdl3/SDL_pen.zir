#[include "vendor/sdl3/SDL_stdinc.zir", "vendor/sdl3/SDL_mouse.zir", "vendor/sdl3/SDL_touch.zir" : *]

const SDL_PEN_MOUSEID: u32 = 4294967294;
const SDL_PEN_TOUCHID: u64 = 18446744073709551614;
const SDL_PEN_INPUT_DOWN: u32 = 1;
const SDL_PEN_INPUT_BUTTON_1: u32 = 2;
const SDL_PEN_INPUT_BUTTON_2: u32 = 4;
const SDL_PEN_INPUT_BUTTON_3: u32 = 8;
const SDL_PEN_INPUT_BUTTON_4: u32 = 16;
const SDL_PEN_INPUT_BUTTON_5: u32 = 32;
const SDL_PEN_INPUT_ERASER_TIP: u32 = 1073741824;
const SDL_PEN_INPUT_IN_PROXIMITY: u32 = 2147483648;

type SDL_PenID = Uint32;
type SDL_PenInputFlags = Uint32;

enum SDL_PenAxis: i32 {
    SDL_PEN_AXIS_PRESSURE,
    SDL_PEN_AXIS_XTILT,
    SDL_PEN_AXIS_YTILT,
    SDL_PEN_AXIS_DISTANCE,
    SDL_PEN_AXIS_ROTATION,
    SDL_PEN_AXIS_SLIDER,
    SDL_PEN_AXIS_TANGENTIAL_PRESSURE,
    SDL_PEN_AXIS_COUNT
}

enum SDL_PenDeviceType: i32 {
    SDL_PEN_DEVICE_TYPE_INVALID = -1,
    SDL_PEN_DEVICE_TYPE_UNKNOWN,
    SDL_PEN_DEVICE_TYPE_DIRECT,
    SDL_PEN_DEVICE_TYPE_INDIRECT
}

extern "C" {
    fn SDL_GetPenDeviceType(instance_id: SDL_PenID) -> SDL_PenDeviceType;
}
