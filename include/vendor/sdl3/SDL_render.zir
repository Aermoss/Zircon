    SDL_LOGICAL_PRESENTATION_LETTERBOX,
    SDL_LOGICAL_PRESENTATION_OVERSCAN,
    SDL_LOGICAL_PRESENTATION_INTEGER_SCALE
}

struct SDL_Renderer {}

struct SDL_Texture {
    pub format: SDL_PixelFormat,
    pub w: i32,
    pub h: i32,
    pub refcount: i32
}

