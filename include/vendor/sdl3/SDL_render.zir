enum SDL_TextureAccess: i32 {
    SDL_TEXTUREACCESS_STATIC,
    SDL_TEXTUREACCESS_STREAMING,
    SDL_TEXTUREACCESS_TARGET
}

enum SDL_TextureAddressMode: i32 {
