struct SDL_Event {
    pub _data: [u64; 16]
}

enum SDL_EventAction: i32 {
    SDL_ADDEVENT,
    SDL_PEEKEVENT,
    SDL_GETEVENT
}

type SDL_EventFilter = fn(*mut void, *mut SDL_Event) -> bool;

extern "C" {
    fn SDL_PumpEvents();
    fn SDL_PeepEvents(events: *mut SDL_Event, numevents: i32, action: SDL_EventAction, minType: Uint32, maxType: Uint32) -> i32;
    fn SDL_HasEvent(_type: Uint32) -> bool;
    fn SDL_HasEvents(minType: Uint32, maxType: Uint32) -> bool;
    fn SDL_FlushEvent(_type: Uint32);
    fn SDL_FlushEvents(minType: Uint32, maxType: Uint32);
    fn SDL_PollEvent(event: *mut SDL_Event) -> bool;
    fn SDL_WaitEvent(event: *mut SDL_Event) -> bool;
    fn SDL_WaitEventTimeout(event: *mut SDL_Event, timeoutMS: Sint32) -> bool;
    fn SDL_PushEvent(event: *mut SDL_Event) -> bool;
    fn SDL_SetEventFilter(filter: SDL_EventFilter, userdata: *mut void);
    fn SDL_GetEventFilter(filter: *mut SDL_EventFilter, userdata: *mut *mut void) -> bool;
    fn SDL_AddEventWatch(filter: SDL_EventFilter, userdata: *mut void) -> bool;
    fn SDL_RemoveEventWatch(filter: SDL_EventFilter, userdata: *mut void);
    fn SDL_FilterEvents(filter: SDL_EventFilter, userdata: *mut void);
    fn SDL_SetEventEnabled(_type: Uint32, enabled: bool);
    fn SDL_EventEnabled(_type: Uint32) -> bool;
    fn SDL_RegisterEvents(numevents: i32) -> Uint32;
    fn SDL_GetWindowFromEvent(event: *SDL_Event) -> *mut SDL_Window;
    fn SDL_GetEventDescription(event: *SDL_Event, buf: *mut i8, buflen: i32) -> i32;
}
