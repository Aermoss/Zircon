struct SDL_Color {
    pub r: Uint8,
    pub g: Uint8,
    pub b: Uint8,
    pub a: Uint8
}

struct SDL_FColor {
    pub r: f32,
    pub g: f32,
    pub b: f32,
    pub a: f32
}

struct SDL_Palette {
    pub ncolors: i32,
    pub colors: *mut SDL_Color,
    pub version: Uint32,
    pub refcount: i32
}

struct SDL_PixelFormatDetails {
    pub format: SDL_PixelFormat,
    pub bits_per_pixel: Uint8,
    pub bytes_per_pixel: Uint8,
    pub padding: [Uint8; 2],
    pub Rmask: Uint32,
    pub Gmask: Uint32,
    pub Bmask: Uint32,
    pub Amask: Uint32,
    pub Rbits: Uint8,
    pub Gbits: Uint8,
    pub Bbits: Uint8,
    pub Abits: Uint8,
    pub Rshift: Uint8,
    pub Gshift: Uint8,
    pub Bshift: Uint8,
    pub Ashift: Uint8
}

extern "C" {
    fn SDL_GetPixelFormatName(format: SDL_PixelFormat) -> *i8;
    fn SDL_GetMasksForPixelFormat(format: SDL_PixelFormat, bpp: *mut i32, Rmask: *mut Uint32, Gmask: *mut Uint32, Bmask: *mut Uint32, Amask: *mut Uint32) -> bool;
    fn SDL_GetPixelFormatForMasks(bpp: i32, Rmask: Uint32, Gmask: Uint32, Bmask: Uint32, Amask: Uint32) -> SDL_PixelFormat;
    fn SDL_GetPixelFormatDetails(format: SDL_PixelFormat) -> *SDL_PixelFormatDetails;
    fn SDL_CreatePalette(ncolors: i32) -> *mut SDL_Palette;
    fn SDL_SetPaletteColors(palette: *mut SDL_Palette, colors: *SDL_Color, firstcolor: i32, ncolors: i32) -> bool;
    fn SDL_DestroyPalette(palette: *mut SDL_Palette);
    fn SDL_MapRGB(format: *SDL_PixelFormatDetails, palette: *SDL_Palette, r: Uint8, g: Uint8, b: Uint8) -> Uint32;
    fn SDL_MapRGBA(format: *SDL_PixelFormatDetails, palette: *SDL_Palette, r: Uint8, g: Uint8, b: Uint8, a: Uint8) -> Uint32;
    fn SDL_GetRGB(pixelvalue: Uint32, format: *SDL_PixelFormatDetails, palette: *SDL_Palette, r: *mut Uint8, g: *mut Uint8, b: *mut Uint8);
    fn SDL_GetRGBA(pixelvalue: Uint32, format: *SDL_PixelFormatDetails, palette: *SDL_Palette, r: *mut Uint8, g: *mut Uint8, b: *mut Uint8, a: *mut Uint8);
}
