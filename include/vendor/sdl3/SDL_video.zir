    fn SDL_EGL_SetAttributeCallbacks(platformAttribCallback: SDL_EGLAttribArrayCallback, surfaceAttribCallback: SDL_EGLIntArrayCallback, contextAttribCallback: SDL_EGLIntArrayCallback, userdata: *mut void);
    fn SDL_GL_SetSwapInterval(interval: i32) -> bool;
    fn SDL_GL_GetSwapInterval(interval: *mut i32) -> bool;
    fn SDL_GL_SwapWindow(window: *mut SDL_Window) -> bool;
    fn SDL_GL_DestroyContext(context: SDL_GLContext) -> bool;
}
