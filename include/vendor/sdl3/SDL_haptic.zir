#[include "vendor/sdl3/SDL_stdinc.zir", "vendor/sdl3/SDL_error.zir", "vendor/sdl3/SDL_joystick.zir" : *]

const SDL_HAPTIC_INFINITY: u32 = 4294967295;
const SDL_HAPTIC_POLAR: i32 = 0;
const SDL_HAPTIC_CARTESIAN: i32 = 1;
const SDL_HAPTIC_SPHERICAL: i32 = 2;
const SDL_HAPTIC_STEERING_AXIS: i32 = 3;
const SDL_HAPTIC_CONSTANT: u32 = 1;
const SDL_HAPTIC_SINE: u32 = 2;
const SDL_HAPTIC_SQUARE: u32 = 4;
const SDL_HAPTIC_TRIANGLE: u32 = 8;
const SDL_HAPTIC_SAWTOOTHUP: u32 = 16;
const SDL_HAPTIC_SAWTOOTHDOWN: u32 = 32;
const SDL_HAPTIC_RAMP: u32 = 64;
const SDL_HAPTIC_SPRING: u32 = 128;
const SDL_HAPTIC_DAMPER: u32 = 256;
const SDL_HAPTIC_INERTIA: u32 = 512;
const SDL_HAPTIC_FRICTION: u32 = 1024;
const SDL_HAPTIC_LEFTRIGHT: u32 = 2048;
const SDL_HAPTIC_RESERVED1: u32 = 4096;
const SDL_HAPTIC_RESERVED2: u32 = 8192;
const SDL_HAPTIC_RESERVED3: u32 = 16384;
const SDL_HAPTIC_CUSTOM: u32 = 32768;
const SDL_HAPTIC_GAIN: u32 = 65536;
const SDL_HAPTIC_AUTOCENTER: u32 = 131072;
const SDL_HAPTIC_STATUS: u32 = 262144;
const SDL_HAPTIC_PAUSE: u32 = 524288;

struct SDL_Haptic {}

type SDL_HapticEffectType = Uint16;
type SDL_HapticDirectionType = Uint8;
type SDL_HapticEffectID = i32;

struct SDL_HapticDirection {
    pub _type: SDL_HapticDirectionType,
    pub dir: [Sint32; 3]
}

struct SDL_HapticConstant {
    pub _type: SDL_HapticEffectType,
    pub direction: SDL_HapticDirection,
    pub length: Uint32,
    pub delay: Uint16,
    pub button: Uint16,
    pub interval: Uint16,
    pub level: Sint16,
    pub attack_length: Uint16,
    pub attack_level: Uint16,
    pub fade_length: Uint16,
    pub fade_level: Uint16
}

struct SDL_HapticPeriodic {
    pub _type: SDL_HapticEffectType,
    pub direction: SDL_HapticDirection,
    pub length: Uint32,
    pub delay: Uint16,
    pub button: Uint16,
    pub interval: Uint16,
    pub period: Uint16,
    pub magnitude: Sint16,
    pub offset: Sint16,
    pub phase: Uint16,
    pub attack_length: Uint16,
    pub attack_level: Uint16,
    pub fade_length: Uint16,
    pub fade_level: Uint16
}

struct SDL_HapticCondition {
    pub _type: SDL_HapticEffectType,
    pub direction: SDL_HapticDirection,
    pub length: Uint32,
    pub delay: Uint16,
    pub button: Uint16,
    pub interval: Uint16,
    pub right_sat: [Uint16; 3],
    pub left_sat: [Uint16; 3],
    pub right_coeff: [Sint16; 3],
    pub left_coeff: [Sint16; 3],
    pub deadband: [Uint16; 3],
    pub center: [Sint16; 3]
}

struct SDL_HapticRamp {
    pub _type: SDL_HapticEffectType,
    pub direction: SDL_HapticDirection,
    pub length: Uint32,
    pub delay: Uint16,
    pub button: Uint16,
    pub interval: Uint16,
    pub start: Sint16,
    pub end: Sint16,
    pub attack_length: Uint16,
    pub attack_level: Uint16,
    pub fade_length: Uint16,
    pub fade_level: Uint16
}

struct SDL_HapticLeftRight {
    pub _type: SDL_HapticEffectType,
    pub length: Uint32,
    pub large_magnitude: Uint16,
    pub small_magnitude: Uint16
}

struct SDL_HapticCustom {
    pub _type: SDL_HapticEffectType,
    pub direction: SDL_HapticDirection,
    pub length: Uint32,
    pub delay: Uint16,
    pub button: Uint16,
    pub interval: Uint16,
    pub channels: Uint8,
    pub period: Uint16,
    pub samples: Uint16,
    pub data: *mut Uint16,
    pub attack_length: Uint16,
    pub attack_level: Uint16,
    pub fade_length: Uint16,
    pub fade_level: Uint16
}

struct SDL_HapticEffect {
    pub _data: [u64; 9]
}

type SDL_HapticID = Uint32;

extern "C" {
    fn SDL_GetHaptics(count: *mut i32) -> *mut SDL_HapticID;
    fn SDL_GetHapticNameForID(instance_id: SDL_HapticID) -> *i8;
    fn SDL_OpenHaptic(instance_id: SDL_HapticID) -> *mut SDL_Haptic;
    fn SDL_GetHapticFromID(instance_id: SDL_HapticID) -> *mut SDL_Haptic;
    fn SDL_GetHapticID(haptic: *mut SDL_Haptic) -> SDL_HapticID;
    fn SDL_GetHapticName(haptic: *mut SDL_Haptic) -> *i8;
    fn SDL_IsMouseHaptic() -> bool;
    fn SDL_OpenHapticFromMouse() -> *mut SDL_Haptic;
    fn SDL_IsJoystickHaptic(joystick: *mut SDL_Joystick) -> bool;
    fn SDL_OpenHapticFromJoystick(joystick: *mut SDL_Joystick) -> *mut SDL_Haptic;
    fn SDL_CloseHaptic(haptic: *mut SDL_Haptic);
    fn SDL_GetMaxHapticEffects(haptic: *mut SDL_Haptic) -> i32;
    fn SDL_GetMaxHapticEffectsPlaying(haptic: *mut SDL_Haptic) -> i32;
    fn SDL_GetHapticFeatures(haptic: *mut SDL_Haptic) -> Uint32;
    fn SDL_GetNumHapticAxes(haptic: *mut SDL_Haptic) -> i32;
    fn SDL_HapticEffectSupported(haptic: *mut SDL_Haptic, effect: *SDL_HapticEffect) -> bool;
    fn SDL_CreateHapticEffect(haptic: *mut SDL_Haptic, effect: *SDL_HapticEffect) -> SDL_HapticEffectID;
    fn SDL_UpdateHapticEffect(haptic: *mut SDL_Haptic, effect: SDL_HapticEffectID, data: *SDL_HapticEffect) -> bool;
    fn SDL_RunHapticEffect(haptic: *mut SDL_Haptic, effect: SDL_HapticEffectID, iterations: Uint32) -> bool;
    fn SDL_StopHapticEffect(haptic: *mut SDL_Haptic, effect: SDL_HapticEffectID) -> bool;
    fn SDL_DestroyHapticEffect(haptic: *mut SDL_Haptic, effect: SDL_HapticEffectID);
    fn SDL_GetHapticEffectStatus(haptic: *mut SDL_Haptic, effect: SDL_HapticEffectID) -> bool;
    fn SDL_SetHapticGain(haptic: *mut SDL_Haptic, gain: i32) -> bool;
    fn SDL_SetHapticAutocenter(haptic: *mut SDL_Haptic, autocenter: i32) -> bool;
    fn SDL_PauseHaptic(haptic: *mut SDL_Haptic) -> bool;
    fn SDL_ResumeHaptic(haptic: *mut SDL_Haptic) -> bool;
    fn SDL_StopHapticEffects(haptic: *mut SDL_Haptic) -> bool;
    fn SDL_HapticRumbleSupported(haptic: *mut SDL_Haptic) -> bool;
    fn SDL_InitHapticRumble(haptic: *mut SDL_Haptic) -> bool;
    fn SDL_PlayHapticRumble(haptic: *mut SDL_Haptic, strength: f32, length: Uint32) -> bool;
    fn SDL_StopHapticRumble(haptic: *mut SDL_Haptic) -> bool;
}
