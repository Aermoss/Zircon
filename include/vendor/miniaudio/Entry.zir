    fn ma_sound_group_set_directional_attenuation_factor(pGroup: *mut ma_sound_group, directionalAttenuationFactor: f32);
    fn ma_sound_group_get_directional_attenuation_factor(pGroup: *ma_sound_group) -> f32;
    fn ma_sound_group_set_fade_in_pcm_frames(pGroup: *mut ma_sound_group, volumeBeg: f32, volumeEnd: f32, fadeLengthInFrames: ma_uint64);
    fn ma_sound_group_set_fade_in_milliseconds(pGroup: *mut ma_sound_group, volumeBeg: f32, volumeEnd: f32, fadeLengthInMilliseconds: ma_uint64);
    fn ma_sound_group_get_current_fade_volume(pGroup: *mut ma_sound_group) -> f32;
    fn ma_sound_group_set_start_time_in_pcm_frames(pGroup: *mut ma_sound_group, absoluteGlobalTimeInFrames: ma_uint64);
    fn ma_sound_group_set_start_time_in_milliseconds(pGroup: *mut ma_sound_group, absoluteGlobalTimeInMilliseconds: ma_uint64);
    fn ma_sound_group_set_stop_time_in_pcm_frames(pGroup: *mut ma_sound_group, absoluteGlobalTimeInFrames: ma_uint64);
    fn ma_sound_group_set_stop_time_in_milliseconds(pGroup: *mut ma_sound_group, absoluteGlobalTimeInMilliseconds: ma_uint64);
    fn ma_sound_group_is_playing(pGroup: *ma_sound_group) -> ma_bool32;
    fn ma_sound_group_get_time_in_pcm_frames(pGroup: *ma_sound_group) -> ma_uint64;
}
