    shaderc_limit_max_mesh_view_count_ext,
    shaderc_limit_max_dual_source_draw_buffers_ext
}

enum shaderc_uniform_kind: i32 {
    shaderc_uniform_kind_image,
    shaderc_uniform_kind_sampler,
    shaderc_uniform_kind_texture,
    shaderc_uniform_kind_buffer,
    shaderc_uniform_kind_storage_buffer,
    shaderc_uniform_kind_unordered_access_view
}

struct shaderc_compiler {}

type shaderc_compiler_t = *mut shaderc_compiler;

struct shaderc_compile_options {}

type shaderc_compile_options_t = *mut shaderc_compile_options;

struct shaderc_include_result {
    pub source_name: *i8,
    pub source_name_length: usize,
    pub content: *i8,
    pub content_length: usize,
    pub user_data: *mut void
}

enum shaderc_include_type: i32 {
    shaderc_include_type_relative,
    shaderc_include_type_standard
}

type shaderc_include_resolve_fn = fn(*mut void, *i8, i32, *i8, usize) -> *mut shaderc_include_result;
type shaderc_include_result_release_fn = fn(*mut void, *mut shaderc_include_result);

struct shaderc_compilation_result {}

type shaderc_compilation_result_t = *mut shaderc_compilation_result;

extern "C" {
    fn shaderc_compiler_initialize() -> shaderc_compiler_t;
    fn shaderc_compiler_release(_p0: shaderc_compiler_t);
    fn shaderc_compile_options_initialize() -> shaderc_compile_options_t;
    fn shaderc_compile_options_clone(options: shaderc_compile_options_t) -> shaderc_compile_options_t;
    fn shaderc_compile_options_release(options: shaderc_compile_options_t);
    fn shaderc_compile_options_add_macro_definition(options: shaderc_compile_options_t, name: *i8, name_length: usize, value: *i8, value_length: usize);
    fn shaderc_compile_options_set_source_language(options: shaderc_compile_options_t, lang: shaderc_source_language);
    fn shaderc_compile_options_set_generate_debug_info(options: shaderc_compile_options_t);
    fn shaderc_compile_options_set_optimization_level(options: shaderc_compile_options_t, level: shaderc_optimization_level);
    fn shaderc_compile_options_set_forced_version_profile(options: shaderc_compile_options_t, version: i32, profile: shaderc_profile);
    fn shaderc_compile_options_set_include_callbacks(options: shaderc_compile_options_t, resolver: shaderc_include_resolve_fn, result_releaser: shaderc_include_result_release_fn, user_data: *mut void);
    fn shaderc_compile_options_set_suppress_warnings(options: shaderc_compile_options_t);
    fn shaderc_compile_options_set_target_env(options: shaderc_compile_options_t, target: shaderc_target_env, version: u32);
    fn shaderc_compile_options_set_target_spirv(options: shaderc_compile_options_t, version: shaderc_spirv_version);
    fn shaderc_compile_options_set_warnings_as_errors(options: shaderc_compile_options_t);
    fn shaderc_compile_options_set_limit(options: shaderc_compile_options_t, limit: shaderc_limit, value: i32);
    fn shaderc_compile_options_set_auto_bind_uniforms(options: shaderc_compile_options_t, auto_bind: bool);
    fn shaderc_compile_options_set_auto_combined_image_sampler(options: shaderc_compile_options_t, upgrade: bool);
    fn shaderc_compile_options_set_hlsl_io_mapping(options: shaderc_compile_options_t, hlsl_iomap: bool);
    fn shaderc_compile_options_set_hlsl_offsets(options: shaderc_compile_options_t, hlsl_offsets: bool);
    fn shaderc_compile_options_set_binding_base(options: shaderc_compile_options_t, kind: shaderc_uniform_kind, base: u32);
    fn shaderc_compile_options_set_binding_base_for_stage(options: shaderc_compile_options_t, shader_kind: shaderc_shader_kind, kind: shaderc_uniform_kind, base: u32);
    fn shaderc_compile_options_set_preserve_bindings(options: shaderc_compile_options_t, preserve_bindings: bool);
    fn shaderc_compile_options_set_max_id_bound(options: shaderc_compile_options_t, max_id_bound: u32);
    fn shaderc_compile_options_set_auto_map_locations(options: shaderc_compile_options_t, auto_map: bool);
    fn shaderc_compile_options_set_hlsl_register_set_and_binding_for_stage(options: shaderc_compile_options_t, shader_kind: shaderc_shader_kind, reg: *i8, set: *i8, binding: *i8);
    fn shaderc_compile_options_set_hlsl_register_set_and_binding(options: shaderc_compile_options_t, reg: *i8, set: *i8, binding: *i8);
    fn shaderc_compile_options_set_hlsl_functionality1(options: shaderc_compile_options_t, enable: bool);
    fn shaderc_compile_options_set_hlsl_16bit_types(options: shaderc_compile_options_t, enable: bool);
    fn shaderc_compile_options_set_vulkan_rules_relaxed(options: shaderc_compile_options_t, enable: bool);
    fn shaderc_compile_options_set_invert_y(options: shaderc_compile_options_t, enable: bool);
    fn shaderc_compile_options_set_nan_clamp(options: shaderc_compile_options_t, enable: bool);
    fn shaderc_compile_into_spv(compiler: shaderc_compiler_t, source_text: *i8, source_text_size: usize, shader_kind: shaderc_shader_kind, input_file_name: *i8, entry_point_name: *i8, additional_options: shaderc_compile_options_t) -> shaderc_compilation_result_t;
    fn shaderc_compile_into_spv_assembly(compiler: shaderc_compiler_t, source_text: *i8, source_text_size: usize, shader_kind: shaderc_shader_kind, input_file_name: *i8, entry_point_name: *i8, additional_options: shaderc_compile_options_t) -> shaderc_compilation_result_t;
    fn shaderc_compile_into_preprocessed_text(compiler: shaderc_compiler_t, source_text: *i8, source_text_size: usize, shader_kind: shaderc_shader_kind, input_file_name: *i8, entry_point_name: *i8, additional_options: shaderc_compile_options_t) -> shaderc_compilation_result_t;
    fn shaderc_assemble_into_spv(compiler: shaderc_compiler_t, source_assembly: *i8, source_assembly_size: usize, additional_options: shaderc_compile_options_t) -> shaderc_compilation_result_t;
    fn shaderc_result_release(result: shaderc_compilation_result_t);
    fn shaderc_result_get_length(result: shaderc_compilation_result_t) -> usize;
    fn shaderc_result_get_num_warnings(result: shaderc_compilation_result_t) -> usize;
    fn shaderc_result_get_num_errors(result: shaderc_compilation_result_t) -> usize;
    fn shaderc_result_get_compilation_status(_p0: shaderc_compilation_result_t) -> shaderc_compilation_status;
    fn shaderc_result_get_bytes(result: shaderc_compilation_result_t) -> *i8;
    fn shaderc_result_get_error_message(result: shaderc_compilation_result_t) -> *i8;
    fn shaderc_get_spv_version(version: *mut u32, revision: *mut u32);
    fn shaderc_parse_version_profile(str: *i8, version: *mut i32, profile: *mut shaderc_profile) -> bool;
}
