#[include "vendor/assimp/quaternion.zir" : *]

enum aiMetadataType: i32 {
    AI_BOOL = 0,
    AI_INT32 = 1,
    AI_UINT64 = 2,
    AI_FLOAT = 3,
    AI_DOUBLE = 4,
    AI_AISTRING = 5,
    AI_AIVECTOR3D = 6,
    AI_AIMETADATA = 7,
    AI_INT64 = 8,
    AI_UINT32 = 9,
    AI_META_MAX = 10,
    FORCE_32BIT
}

struct aiMetadataEntry {
    pub mType: aiMetadataType,
    pub mData: *mut void
}

struct aiMetadata {
    pub mNumProperties: u32,
    pub mKeys: *mut aiString,
    pub mValues: *mut aiMetadataEntry
}
