#[include "std/std", "std/io" : *]

@track_caller
fn Panic(message: &String) -> ! {
    Panic(message.Data())
}

@track_caller
fn Panic(message: *i8) -> ! {
    let (file, line, column) = caller_location();
    PanicAt(message, file, line, column)
}

fn PanicAt(message: *i8, file: *i8, line: u32, column: u32) -> ! {
    WriteError("\x1b[31mPanicked at ");
    WriteError(file);
    WriteError(":" + String::FromInteger(line as HostUnsigned) + ":" + String::FromInteger(column as HostUnsigned) + ": ");
    WriteError(message);
    WriteErrorLine("\x1b[0m");
    Exit(1);
}

@nomangle
fn __zircon_bounds_panic(index: usize, length: usize, file: *i8, line: u32, column: u32) -> ! {
    let message = "Index " + String::FromInteger(index as HostUnsigned) + " is out of bounds for a slice of length " + String::FromInteger(length as HostUnsigned) + '.';
    PanicAt(message.Data(), file, line, column)
}

@nomangle
fn __zircon_range_panic(start: usize, end: usize, length: usize, file: *i8, line: u32, column: u32) -> ! {
    let range = String::FromInteger(start as HostUnsigned) + ".." + String::FromInteger(end as HostUnsigned);

    let message = if start > end {
        "Slice range " + range + " starts after it ends."
    } else {
        "Slice range " + range + " is out of bounds for a slice of length " + String::FromInteger(length as HostUnsigned) + '.'
    };

    PanicAt(message.Data(), file, line, column)
}
