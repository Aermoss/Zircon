#[include "std/std", "std/mem", "std/vec", "std/opt" : *]

extern "C" {
    fn strlen(str: *i8) -> usize #[if LIBC] ; #[else] {
        let mut i: usize = 0;

        loop {
            if str[i] == 0 {
                return i;
            } else {
                i += 1;
            }
        }

        0
    } #[endif]

    fn strcmp(s1: *i8, s2: *i8) -> i32 #[if LIBC] ; #[else] {
        let mut i: usize = 0;

        while s1[i] == s2[i] {
            if s1[i] == 0 {
                return 0;
            } i += 1;
        }

        (s1[i] as i32) - (s2[i] as i32)
    } #[endif]

    fn strncmp(s1: *i8, s2: *i8, n: usize) -> i32 #[if LIBC] ; #[else] {
        for i in 0..n {
            if s1[i] != s2[i] {
                return (s1[i] as i32) - (s2[i] as i32);
            }

            if s1[i] == 0 {
                break;
            }
        }

        0
    } #[endif]
}

#[if !ZODIAC]
fn _BigMultiplyAdd(value: &mut Vector<u32>, multiplier: u32, addend: u32) {
    let mut carry = addend as HostUnsigned;

    for i in 0..value.Length() {
        let product = value[i] as HostUnsigned * multiplier as HostUnsigned + carry;
        value[i] = (product & 0xFFFFFFFF) as u32;
        carry = product >> 32;
    }

    if carry != 0 { value.PushBack(carry as u32); }
}

fn _BigBitLength(value: &Vector<u32>) -> HostSigned {
    let mut limb = value.Length();
    while limb > 0 && value[limb - 1] == 0 { limb -= 1; }
    if limb == 0 { return 0; }
    let (mut top, mut bits): (u32, HostSigned) = (value[limb - 1], 0);

    while top != 0 {
        top >>= 1;
        bits += 1;
    }

    (limb as HostSigned - 1) * 32 + bits
}

fn _BigBit(value: &Vector<u32>, index: HostSigned) -> bool {
    let limb = (index / 32) as usize;
    index >= 0 && limb < value.Length() && ((value[limb] >> (index % 32) as u32) & 1) != 0
}

fn _BigShiftLeft(value: &Vector<u32>, bits: HostSigned) -> Vector<u32> {
    let mut result = Vector<u32>();
    let offset = (bits % 32) as u32;
    let mut carry = 0u32;

    for i in 0..(bits / 32) {
        result.PushBack(0);
    }

    for limb in value {
        if offset == 0 {
            result.PushBack(limb);
        } else {
            result.PushBack((limb << offset) | carry);
            carry = limb >> (32 - offset);
        }
    }

    if carry != 0 { result.PushBack(carry); }
    result
}

fn _BigCompare(a: &Vector<u32>, b: &Vector<u32>) -> i32 {
    let mut i = if a.Length() > b.Length() { a.Length() } else { b.Length() };

    while i > 0 {
        i -= 1;
        let x = if i < a.Length() { a[i] } else { 0 };
        let y = if i < b.Length() { b[i] } else { 0 };
        if x != y { return if x > y { 1 } else { -1 }; }
    }

    0
}

fn _BigSubtract(a: &mut Vector<u32>, b: &Vector<u32>) {
    let mut borrow: HostSigned = 0;

    for i in 0..a.Length() {
        let mut difference = a[i] as HostSigned - borrow - if i < b.Length() { b[i] as HostSigned } else { 0 };
        borrow = 0;

        if difference < 0 {
            difference += 4294967296;
            borrow = 1;
        }

        a[i] = difference as u32;
    }
}

fn _BigToDouble(value: &Vector<u32>, exponent: HostSigned, sticky: bool) -> f64 {
    let length = _BigBitLength(value);
    if length == 0 { return 0.0; }
    let mut leading = length - 1 + exponent;
    if leading > 1023 { return 1.0 / 0.0; }
    let precision = if leading >= -1022 { 53 } else { leading + 1075 };
    if precision < 0 { return 0.0; }

    if precision == 0 {
        let mut bits: HostUnsigned = 1;

        if !sticky {
            let mut half = true;

            for i in 0..(length - 1) {
                if _BigBit(value, i) {
                    half = false;
                    break;
                }
            }

            if half { bits = 0; }
        }

        return *((&mut bits as *mut HostUnsigned) as *mut f64);
    }

    let shift = length - precision;
    let mut mantissa: HostUnsigned = 0;

    for i in 0..precision {
        if _BigBit(value, shift + precision - 1 - i) { mantissa |= 1 as HostUnsigned << (precision - 1 - i) as HostUnsigned; }
    }

    if shift > 0 && _BigBit(value, shift - 1) {
        let mut rest = sticky;

        for i in 0..(shift - 1) {
            if _BigBit(value, i) {
                rest = true;
                break;
            }
        }

        if rest || (mantissa & 1) != 0 { mantissa += 1; }
    }

    let mut bits = mantissa;

    if precision == 53 {
        if mantissa == 1 as HostUnsigned << 53 {
            mantissa >>= 1;
            leading += 1;
            if leading > 1023 { return 1.0 / 0.0; }
        }

        bits = ((leading + 1023) as HostUnsigned << 52) | (mantissa & 0xFFFFFFFFFFFFF);
    }

    *((&mut bits as *mut HostUnsigned) as *mut f64)
}

fn _DecimalToDouble(digits: &Vector<u32>, significant: HostSigned, exponent: HostSigned) -> f64 {
    if _BigBitLength(digits) == 0 { return 0.0; }
    if significant - 1 + exponent > 310 { return 1.0 / 0.0; }
    if significant + exponent < -330 { return 0.0; }

    if exponent >= 0 {
        let mut value = Vector<u32>(digits);
        for i in 0..exponent { _BigMultiplyAdd(&mut value, 10, 0); }
        return _BigToDouble(value, 0, false);
    }

    let mut divisor = Vector<u32>();
    divisor.PushBack(1);
    for i in 0..(-exponent) { _BigMultiplyAdd(&mut divisor, 10, 0); }
    let scale = _BigBitLength(divisor) - _BigBitLength(digits) + 55;
    let mut remainder = _BigShiftLeft(digits, if scale > 0 { scale } else { 0 });
    if scale < 0 { divisor = _BigShiftLeft(divisor, -scale); }
    let mut quotient: HostUnsigned = 0;
    let mut bit: HostSigned = 57;

    while bit >= 0 {
        let shifted = _BigShiftLeft(divisor, bit);

        if _BigCompare(remainder, shifted) >= 0 {
            _BigSubtract(&mut remainder, shifted);
            quotient |= 1 as HostUnsigned << bit as HostUnsigned;
        }

        bit -= 1;
    }

    let mut result = Vector<u32>();
    result.PushBack((quotient & 0xFFFFFFFF) as u32);
    result.PushBack((quotient >> 32) as u32);
    _BigToDouble(result, -scale, _BigBitLength(remainder) != 0)
}
#[endif]

class String {
    data: *mut i8 = null,
    length: usize = 0,
    capacity: usize = 0;

    String(&mut this) {
        this.Allocate(0);
    }

    String(&mut this, character: i8) {
        this.Allocate(1);
        this.data[0] = character;
    }

    String(&mut this, string: *i8) {
        if string == null {
            this.Allocate(0);
            return;
        }

        let other_length = strlen(string);
        this.Allocate(other_length);
        memcpy(this.data, string, other_length);
    }

    String(&mut this, other: &String) {
        if other.data == null {
            this.Allocate(0);
            return;
        }

        this.Allocate(other.length);
        memcpy(this.data, other.data, other.length);
    }

    String(&mut this, string: *i8, mut length: usize) {
        if string == null || length == 0 {
            this.Allocate(0);
            return;
        }

        let other_length = strlen(string);

        if length > other_length {
            length = other_length;
        }

        this.Allocate(length);
        memcpy(this.data, string, length);
    }

    String(&mut this, other: &String, mut length: usize) {
        if other.data == null || length == 0 {
            this.Allocate(0);
            return;
        }

        if length > other.length {
            length = other.length;
        }

        this.Allocate(length);
        memcpy(this.data, other.data, length);
    }

    String(&mut this, string: *i8, start: usize, mut length: usize) {
        let other_length = if string != null { strlen(string) } else { 0 };

        if string == null || start >= other_length || length == 0 {
            this.Allocate(0);
            return;
        }

        if start + length > other_length {
            length = other_length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (string + start), length);
    }

    String(&mut this, other: &String, start: usize, mut length: usize) {
        if other.data == null || start >= other.length || length == 0 {
            this.Allocate(0);
            return;
        }

        if start + length > other.length {
            length = other.length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (other.data + start), length);
    }

    ~String(&mut this) {
        this.Release();
    }

    pub fn Data(&this) -> *i8 { this.data }
    pub fn Data(&mut this) -> *mut i8 { this.data }

    pub fn Empty(&this) -> bool { this.length == 0 }
    pub fn Size(&this) -> usize { this.length + 1 }
    pub fn Length(&this) -> usize { this.length }

    fn Allocate(&mut this, length: usize) {
        (this.data, this.length, this.capacity) = (new i8[length + 1], length, length);
        this.data[length] = '\0';
    }

    fn Release(&mut this) {
        if this.data != null { delete[] this.data; }
        (this.data, this.length, this.capacity) = (null, 0, 0);
    }

    fn Append(&mut this, string: *i8, count: usize) {
        let length = this.length + count;

        if this.data != null && length <= this.capacity {
            memcpy((this.data + this.length), string, count);
        } else {
            let capacity = if length > this.capacity * 2 { length } else { this.capacity * 2 };
            let data = new i8[capacity + 1];
            if this.data != null { memcpy(data, this.data, this.length); }
            memcpy((data + this.length), string, count);
            if this.data != null { delete[] this.data; }
            (this.data, this.capacity) = (data, capacity);
        }

        this.length = length;
        this.data[length] = '\0';
    }

    pub fn Clear(&mut this) {
        this.Release();
        this.Allocate(0);
    }

    pub fn FromInteger(mut value: HostUnsigned, base: HostUnsigned) -> String {
        if base < 2 || base > 36 { String() }
        else if value == 0 { String("0") }
        else {
            let mut result = String();

            while value > 0 {
                result += "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"[(value % base) as usize];
                value /= base;
            }

            result.Reverse()
        }
    }

    pub fn FromInteger(value: HostUnsigned) -> String {
        String::FromInteger(value, 10)
    }

    pub fn FromInteger(value: HostSigned, base: HostSigned) -> String {
        if base < 2 || base > 36 {
            String()
        } else if value >= 0 {
            String::FromInteger(value as HostUnsigned, base as HostUnsigned)
        } else if base != 10 {
            String::FromInteger(!(value as HostUnsigned) + 1, base as HostUnsigned)
        } else {
            '-' + String::FromInteger(!(value as HostUnsigned) + 1, base as HostUnsigned)
        }
    }

    pub fn FromInteger(value: HostSigned) -> String {
        String::FromInteger(value, 10)
    }

#[if !ZODIAC]
    pub fn FromFloat(mut value: f64, precision: usize) -> String {
        if value != value { "nan".ToString() }
        else if value == (1.0 / 0.0) { "inf".ToString() }
        else if value == (-1.0 / 0.0) { "-inf".ToString() }
        else if value == 0.0 { "0.0".ToString() }
        else if value < 0.0 {
            '-' + String::FromFloat(-value, precision)
        } else {
            let mut exponent: HostSigned = 0;

            if value >= 1e9 {
                while value >= 10.0 {
                    value /= 10.0;
                    exponent += 1;
                }
            } else if value < 1e-4 {
                while value < 1.0 {
                    value *= 10.0;
                    exponent -= 1;
                }
            }

            let mut integer = value as HostUnsigned;
            let mut fraction = value - (integer as f64);
            let mut round = 0.5;

            for _ in 0..precision {
                round /= 10.0;
            }

            fraction += round;

            if fraction >= 1.0 {
                fraction -= 1.0;
                integer += 1;
            }

            if exponent != 0 && integer >= 10 {
                (integer, exponent) = (integer / 10, exponent + 1);
            }

            let mut result = String::FromInteger(integer);

            if precision != 0 {
                result += '.';
            }

            for i in 0..precision {
                fraction *= 10.0;
                let digit = fraction as i8;
                fraction -= digit as f64;
                result += '0' + digit;
            }

            if exponent != 0 {
                result += 'e';

                if exponent < 0 {
                    result += '-' + String::FromInteger(-exponent);
                } else {
                    result += '+' + String::FromInteger(exponent);
                }
            }

            result
        }
    }

    pub fn FromFloat(mut value: f64) -> String {
        String::FromFloat(value, 6)
    }
#[endif]

    fn ParseUnsigned(&this, start: usize, base: HostUnsigned) -> Option<HostUnsigned> {
        if base < 2 || base > 36 || start >= this.length {
            return Option<HostUnsigned>::None;
        }

        let mut result: HostUnsigned = 0;

        for i in start..this.length {
            let c = this.data[i];

            let value: HostUnsigned = if c >= '0' && c <= '9' {
                (c - '0') as HostUnsigned
            } else if c >= 'A' && c <= 'Z' {
                (c - 'A' + 10) as HostUnsigned
            } else if c >= 'a' && c <= 'z' {
                (c - 'a' + 10) as HostUnsigned
            } else {
                return Option<HostUnsigned>::None;
            };

            if value >= base || result > (-1 as HostUnsigned - value) / base {
                return Option<HostUnsigned>::None;
            }

            result = result * base + value;
        }

        Option<HostUnsigned>::Some(result)
    }

    pub fn ToUnsignedInteger(&this, base: HostUnsigned) -> Option<HostUnsigned> {
        this.ParseUnsigned(if this.StartsWith('+') { 1 } else { 0 }, base)
    }

    pub fn ToUnsignedInteger(&this) -> Option<HostUnsigned> {
        this.ToUnsignedInteger(10)
    }

    pub fn ToInteger(&this, base: HostSigned) -> Option<HostSigned> {
        let negative = this.StartsWith('-');
        let sign_bit = 1 as HostUnsigned << (sizeof(HostUnsigned) * 8 - 1);

        match this.ParseUnsigned(if negative || this.StartsWith('+') { 1 } else { 0 }, base as HostUnsigned) {
            Option<HostUnsigned>::Some(value) if negative && value <= sign_bit => Option<HostSigned>::Some((!value + 1) as HostSigned),
            Option<HostUnsigned>::Some(value) if !negative && value < sign_bit => Option<HostSigned>::Some(value as HostSigned),
            _ => Option<HostSigned>::None
        }
    }

    pub fn ToInteger(&this) -> Option<HostSigned> {
        this.ToInteger(10)
    }

#[if !ZODIAC]
    pub fn ToFloat(&this) -> Option<f64> {
        if this == "nan" { return Option<f64>::Some(0.0 / 0.0); }
        if this == "inf" || this == "+inf" { return Option<f64>::Some(1.0 / 0.0); }
        if this == "-inf" { return Option<f64>::Some(-1.0 / 0.0); }
        let (mut mantissa, mut negative, mut digits) = (Vector<u32>(), false, 0);
        let (mut significant, mut fraction_digits, mut exponent): (HostSigned, HostSigned, HostSigned) = (0, 0, 0);
        let mut i: usize = 0;

        if this.StartsWith('-') {
            negative = true;
            i = 1;
        } else if this.StartsWith('+') {
            i = 1;
        }

        while i < this.length && this.data[i] >= '0' && this.data[i] <= '9' {
            if significant > 0 || this.data[i] != '0' { significant += 1; }
            _BigMultiplyAdd(&mut mantissa, 10, (this.data[i] - '0') as u32);
            (i, digits) = (i + 1, digits + 1);
        }

        if i < this.length && this.data[i] == '.' {
            i += 1;

            while i < this.length && this.data[i] >= '0' && this.data[i] <= '9' {
                if significant > 0 || this.data[i] != '0' { significant += 1; }
                _BigMultiplyAdd(&mut mantissa, 10, (this.data[i] - '0') as u32);
                (i, digits, fraction_digits) = (i + 1, digits + 1, fraction_digits + 1);
            }
        }

        if digits == 0 {
            return Option<f64>::None;
        }

        if i < this.length && (this.data[i] == 'e' || this.data[i] == 'E') {
            i += 1;
            let mut negative_exponent = false;

            if i < this.length {
                if this.data[i] == '-' {
                    negative_exponent = true;
                    i += 1;
                } else if this.data[i] == '+' {
                    i += 1;
                }
            }

            let mut exponent_digits = 0;

            while i < this.length && this.data[i] >= '0' && this.data[i] <= '9' {
                if exponent < 100000 {
                    exponent = exponent * 10 + (this.data[i] - '0') as HostSigned;
                }

                (i, exponent_digits) = (i + 1, exponent_digits + 1);
            }

            if exponent_digits == 0 {
                return Option<f64>::None;
            }

            if negative_exponent {
                exponent = -exponent;
            }
        }

        if i != this.length { return Option<f64>::None; }
        let value = _DecimalToDouble(mantissa, significant, exponent - fraction_digits);
        Option<f64>::Some(if negative { -value } else { value })
    }

#[endif]
    pub fn ToLower(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c = this.data[i];
            if c >= 'A' && c <= 'Z' { c += 32; }
            result.data[i] = c;
        }

        result
    }

    pub fn ToUpper(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c = this.data[i];
            if c >= 'a' && c <= 'z' { c -= 32; }
            result.data[i] = c;
        }

        result
    }

    pub fn Reverse(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            result.data[i] = this.data[this.length - 1 - i];
        }

        result
    }

    pub fn Escape(&this) -> String {
        let mut result = String();

        for i in 0..this.length {
            if this.data[i] == '\a' {
                result += "\\a";
            } else if this.data[i] == '\b' {
                result += "\\b";
            } else if this.data[i] == '\f' {
                result += "\\f";
            } else if this.data[i] == '\n' {
                result += "\\n";
            } else if this.data[i] == '\r' {
                result += "\\r";
            } else if this.data[i] == '\t' {
                result += "\\t";
            } else if this.data[i] == '\v' {
                result += "\\v";
            } else {
                result += this.data[i];
            }
        }

        result
    }

    pub fn Replace(&this, from: &String, to: &String) -> String {
        this.Replace(from.data, to.data, from.length)
    }

    pub fn Replace(&this, from: *i8, to: &String) -> String {
        this.Replace(from, to.data, strlen(from))
    }

    pub fn Replace(&this, from: &String, to: *i8) -> String {
        this.Replace(from.data, to, from.length)
    }

    pub fn Replace(&this, from: *i8, to: *i8) -> String {
        this.Replace(from, to, strlen(from))
    }

    fn Replace(&this, from: *i8, to: *i8, length: usize) -> String {
        let mut result = String();
        let mut i: usize = 0;

        if length == 0 {
            result += this.data;
            return result;
        }

        while i < this.length {
            let mut _match = true;

            for j in 0..length {
                if i + j >= this.length || this.data[i + j] != from[j] {
                    _match = false;
                    break;
                }
            }

            if _match {
                result += to;
                i += length;
            } else {
                result += this.data[i];
                i += 1;
            }
        }

        result
    }

    pub fn SubString(&this, start: usize) -> String {
        if start < this.length {
            String(this.data + start)
        } else {
            String()
        }
    }

    pub fn SubString(&this, start: usize, mut length: usize) -> String {
        if start < this.length {
            let mut result = String();

            if start + length > this.length {
                length = this.length - start;
            }

            for i in 0..length {
                result += this.data[start + i];
            }

            result
        } else {
            String()
        }
    }

    pub fn Contains(&this, substring: &String) -> bool {
        this.Contains(substring.data, substring.length)
    }

    pub fn Contains(&this, substring: *i8) -> bool {
        this.Contains(substring, strlen(substring))
    }

    fn Contains(&this, substring: *i8, length: usize) -> bool {
        this.Find(substring, length).IsSome()
    }

    pub fn Contains(&this, character: i8) -> bool {
        this.Find(character).IsSome()
    }

    pub fn StartsWith(&this, prefix: &String) -> bool {
        this.StartsWith(prefix.data, prefix.length)
    }

    pub fn StartsWith(&this, prefix: *i8) -> bool {
        this.StartsWith(prefix, strlen(prefix))
    }

    fn StartsWith(&this, prefix: *i8, length: usize) -> bool {
        if prefix == null { return false; }
        if length == 0 { return true; }
        if length > this.length { return false; }

        for i in 0..length {
            if this.data[i] != prefix[i] {
                return false;
            }
        }

        true
    }

    pub fn StartsWith(&this, character: i8) -> bool {
        if this.length == 0 { return false; }
        this.data[0] == character
    }

    pub fn EndsWith(&this, suffix: &String) -> bool {
        this.EndsWith(suffix.data, suffix.length)
    }

    pub fn EndsWith(&this, suffix: *i8) -> bool {
        this.EndsWith(suffix, strlen(suffix))
    }

    fn EndsWith(&this, suffix: *i8, length: usize) -> bool {
        if suffix == null { return false; }
        if length == 0 { return true; }
        if length > this.length { return false; }
        let start = this.length - length;

        for i in 0..length {
            if this.data[start + i] != suffix[i] {
                return false;
            }
        }

        true
    }

    pub fn EndsWith(&this, character: i8) -> bool {
        if this.length == 0 { return false; }
        this.data[this.length - 1] == character
    }

    pub fn Split(&this, delimiter: &String) -> Vector<String> {
        this.Split(delimiter.data, delimiter.length)
    }

    pub fn Split(&this, delimiter: *i8) -> Vector<String> {
        this.Split(delimiter, strlen(delimiter))
    }

    fn Split(&this, delimiter: *i8, length: usize) -> Vector<String> {
        let mut result = Vector<String>();

        if length == 0 {
            result.PushBack(String(this.data));
            return result;
        }

        if length == 1 {
            return this.Split(delimiter[0]);
        }

        let mut current = String();
        let mut i: usize = 0;

        while i < this.length {
            let mut found = true;

            if i + length <= this.length {
                for j in 0..length {
                    if this.data[i + j] != delimiter[j] {
                        found = false;
                        break;
                    }
                }
            } else {
                found = false;
            }

            if found {
                result.PushBack(current);
                current = String();
                i += length;
            } else {
                current += this.data[i];
                i += 1;
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        }

        result
    }

    pub fn Split(&this, delimiter: i8) -> Vector<String> {
        let mut result = Vector<String>();
        let mut current = String();

        for i in 0..this.length {
            if this.data[i] != delimiter {
                current += this.data[i];
            } else {
                result.PushBack(current);
                current = "";
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        }

        result
    }

    pub fn Count(&this, substring: &String) -> usize {
        this.Count(substring.data, substring.length)
    }

    pub fn Count(&this, substring: *i8) -> usize {
        this.Count(substring, strlen(substring))
    }

    fn Count(&this, substring: *i8, length: usize) -> usize {
        if substring == null { return 0; }
        if length == 0 { return 0; }
        if length > this.length { return 0; }
        let mut count: usize = 0;
        let mut i: usize = 0;

        while i <= this.length - length {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                count += 1;
                i += length;
            } else {
                i += 1;
            }
        }

        count
    }

    pub fn Count(&this, character: i8) -> usize {
        let mut count: usize = 0;

        for i in 0..this.length {
            if this.data[i] == character {
                count += 1;
            }
        }

        count
    }

    pub fn Find(&this, substring: &String) -> Option<usize> {
        this.Find(substring.data, substring.length)
    }

    pub fn Find(&this, substring: *i8) -> Option<usize> {
        this.Find(substring, strlen(substring))
    }

    fn Find(&this, substring: *i8, length: usize) -> Option<usize> {
        if substring == null || length > this.length { return Option<usize>::None; }
        if length == 0 { return Option<usize>::Some(0); }

        for i in 0..=(this.length - length) {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                return Option<usize>::Some(i);
            }
        }

        Option<usize>::None
    }

    pub fn Find(&this, character: i8) -> Option<usize> {
        for i in 0..this.length {
            if this.data[i] == character {
                return Option<usize>::Some(i);
            }
        }

        Option<usize>::None
    }

    pub fn Strip(&this) -> String {
        let mut start: usize = 0;

        while start < this.length && (this.data[start] == ' ' || this.data[start] == '\t') {
            start += 1;
        }

        let mut end = this.length;

        while end > start && (this.data[end - 1] == ' ' || this.data[end - 1] == '\t' || this.data[end - 1] == '\n' || this.data[end - 1] == '\r') {
            end -= 1;
        }

        this.SubString(start, end - start)
    }

    pub fn Hash(&this) -> HostUnsigned {
#[if ZODIAC]
        let mut hash: HostUnsigned = 0x811c9dc5;
#[else]
        let mut hash: HostUnsigned = 0xcbf29ce484222325;
#[endif]

        for i in 0..this.length {
            let character = this.data[i];
            hash = hash ^ (character as HostUnsigned & 0xFF);
#[if ZODIAC]
            hash = hash * 0x01000193;
#[else]
            hash = hash * 0x100000001b3;
#[endif]
        }

        hash
    }

    pub fn operator=(&mut this, other: &String) -> &mut String {
        this.operator=(other.data)
    }

    pub fn operator=(&mut this, string: *i8) -> &mut String {
        this.Release();

        if string == null {
            this.Allocate(0);
            return this;
        }

        this.Allocate(strlen(string));
        memcpy(this.data, string, this.length);
        this
    }

    pub fn operator=(&mut this, character: i8) -> &mut String {
        this.Release();
        this.Allocate(1);
        this.data[0] = character;
        this
    }

    pub fn operator+=(&mut this, other: &String) -> &mut String {
        this.operator+=(other.data)
    }

    pub fn operator+=(&mut this, string: *i8) -> &mut String {
        if string == null { return this; }
        this.Append(string, strlen(string));
        this
    }

    pub fn operator+=(&mut this, character: i8) -> &mut String {
        let single = [character, '\0'];
        this.Append(&single[0] as *i8, 1);
        this
    }

    pub fn operator+(&this, other: &String) -> String {
        this.operator+(other.data)
    }

    pub fn operator+(&this, string: *i8) -> String {
        let mut result = String(this.data);
        result += string;
        result
    }

    pub fn operator+(&this, character: i8) -> String {
        let mut result = String(this.data);
        result += character;
        result
    }

    pub fn operator*=(&mut this, count: usize) -> &mut String {
        if count <= 0 {
            this.Release();
            this.Allocate(0);
            this
        } else {
            let temp = String(this.data);

            for i in 0..(count - 1) {
                this.operator+=(temp.data);
            }

            this
        }
    }

    pub fn operator*(&this, count: usize) -> String {
        let mut result = String(this.data);
        result *= count;
        result
    }

    pub fn operator==(&this, other: &String) -> bool {
        if this.data == null || other.data == null { return false; }
        if this.length != other.length { return false; }
        strcmp(this.data, other.data) == 0
    }

    pub fn operator==(&this, string: *i8) -> bool {
        if this.data == null || string == null { return false; }
        if this.length != strlen(string) { return false; }
        strcmp(this.data, string) == 0
    }

    pub fn operator==(&this, character: i8) -> bool {
        if this.data == null { return false; }
        if this.length != 1 { return false; }
        this.data[0] == character
    }

    pub fn operator!=(&this, other: &String) -> bool {
        !(this == other)
    }

    pub fn operator!=(&this, string: *i8) -> bool {
        !(this == string)
    }

    pub fn operator!=(&this, character: i8) -> bool {
        !(this == character)
    }

    pub fn operator[](&this, index: usize) -> &i8 {
        this.data[index]
    }

    pub fn operator[](&mut this, index: usize) -> &mut i8 {
        this.data[index]
    }

    pub fn Begin(&this) -> *i8 {
        this.data
    }

    pub fn End(&this) -> *i8 {
        this.data + this.length
    }

    pub fn Begin(&mut this) -> *mut i8 {
        this.data
    }

    pub fn End(&mut this) -> *mut i8 {
        this.data + this.length
    }
}

extend i8 {
    pub fn ToString(this) -> String {
        String(this)
    }

    pub fn operator+(this, string: &String) -> String {
        String(this) + string
    }

    pub fn operator*(this, count: usize) -> String {
        String(this) * count
    }
}

extend *i8 {
    pub fn ToString(this) -> String {
        String(this)
    }

    pub fn operator+(this, string: &String) -> String {
        String(this) + string
    }

    pub fn operator*(this, count: usize) -> String {
        String(this) * count
    }
}
