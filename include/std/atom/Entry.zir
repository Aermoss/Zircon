fn AtomicMemoryFence() {
    volatile asm {
        mfence
    } : memory;
}

fn AtomicLoadFence() {
    volatile asm {
        lfence
    } : memory;
}

fn AtomicStoreFence() {
    volatile asm {
        sfence
    } : memory;
}

fn AtomicPause() {
    volatile asm {
        pause
    };
}
#[else]
fn AtomicExchange8(target: *mut u8, value: u8) -> u8 {
    let wide: u32 = value as u32;
    let result: u32;

    volatile asm : x9(target), w10(wide) -> {
    1:
        ldaxrb w11, [x9]
        stlxrb w12, w10, [x9]
        cbnz w12, 1b
    } -> w11(result) : memory, x12;

    result as u8
}

fn AtomicExchange16(target: *mut i16, value: i16) -> i16 {
    let wide: u32 = value as u16 as u32;
    let result: u32;

    volatile asm : x9(target), w10(wide) -> {
    1:
        ldaxrh w11, [x9]
        stlxrh w12, w10, [x9]
        cbnz w12, 1b
    } -> w11(result) : memory, x12;

    result as u16 as i16
}

fn AtomicExchange32(target: *mut u32, value: u32) -> u32 {
    let wide: u32 = value;
    let result: u32;

    volatile asm : x9(target), w10(wide) -> {
    1:
        ldaxr w11, [x9]
        stlxr w12, w10, [x9]
        cbnz w12, 1b
    } -> w11(result) : memory, x12;

    result
}

fn AtomicExchange64(target: *mut u64, value: u64) -> u64 {
    let wide: u64 = value;
    let result: u64;

    volatile asm : x9(target), x10(wide) -> {
    1:
        ldaxr x11, [x9]
        stlxr w12, x10, [x9]
        cbnz w12, 1b
    } -> x11(result) : memory, x12;

    result
}

fn AtomicCompareExchange8(target: *mut u8, expected: u8, desired: u8) -> u8 {
    let (wide_expected, wide_desired): (u32, u32) = (expected as u32, desired as u32);
    let result: u32;

    volatile asm : x9(target), w10(wide_expected), w11(wide_desired) -> {
    1:
        ldaxrb w12, [x9]
        eor w13, w12, w10
        cbnz w13, 2f
        stlxrb w13, w11, [x9]
        cbnz w13, 1b
    2:
    } -> w12(result) : memory, x13;

    result as u8
}

fn AtomicCompareExchange16(target: *mut i16, expected: i16, desired: i16) -> i16 {
    let (wide_expected, wide_desired): (u32, u32) = (expected as u16 as u32, desired as u16 as u32);
    let result: u32;

    volatile asm : x9(target), w10(wide_expected), w11(wide_desired) -> {
    1:
        ldaxrh w12, [x9]
        eor w13, w12, w10
        cbnz w13, 2f
        stlxrh w13, w11, [x9]
        cbnz w13, 1b
    2:
    } -> w12(result) : memory, x13;

    result as u16 as i16
}

fn AtomicCompareExchange32(target: *mut u32, expected: u32, desired: u32) -> u32 {
    let (wide_expected, wide_desired): (u32, u32) = (expected, desired);
    let result: u32;

    volatile asm : x9(target), w10(wide_expected), w11(wide_desired) -> {
    1:
        ldaxr w12, [x9]
        eor w13, w12, w10
        cbnz w13, 2f
        stlxr w13, w11, [x9]
        cbnz w13, 1b
    2:
    } -> w12(result) : memory, x13;

    result
}

fn AtomicCompareExchange64(target: *mut u64, expected: u64, desired: u64) -> u64 {
    let (wide_expected, wide_desired): (u64, u64) = (expected, desired);
    let result: u64;

    volatile asm : x9(target), x10(wide_expected), x11(wide_desired) -> {
    1:
        ldaxr x12, [x9]
        eor x13, x12, x10
        cbnz x13, 2f
        stlxr w13, x11, [x9]
        cbnz w13, 1b
    2:
    } -> x12(result) : memory, x13;

    result
}

fn AtomicCompareExchangeBool8(target: *mut u8, expected: u8, desired: u8) -> bool {
    AtomicCompareExchange8(target, expected, desired) == expected
}

fn AtomicCompareExchangeBool16(target: *mut i16, expected: i16, desired: i16) -> bool {
    AtomicCompareExchange16(target, expected, desired) == expected
}

fn AtomicCompareExchangeBool32(target: *mut u32, expected: u32, desired: u32) -> bool {
    AtomicCompareExchange32(target, expected, desired) == expected
}

fn AtomicCompareExchangeBool64(target: *mut u64, expected: u64, desired: u64) -> bool {
    AtomicCompareExchange64(target, expected, desired) == expected
}

fn AtomicLoad8(target: *u8) -> u8 {
    let result: u32;

    volatile asm : x9(target) -> {
        ldarb w10, [x9]
    } -> w10(result) : memory;

    result as u8
}

fn AtomicLoad16(target: *i16) -> i16 {
    let result: u32;

    volatile asm : x9(target) -> {
        ldarh w10, [x9]
    } -> w10(result) : memory;

    result as u16 as i16
}

fn AtomicLoad32(target: *u32) -> u32 {
