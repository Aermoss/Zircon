    let mut old = AtomicLoad16(target);

    while !AtomicCompareExchangeBool16(target, old, old | value) {
        old = AtomicLoad16(target);
    }

    old
}

fn AtomicFetchOr32(target: *mut u32, value: u32) -> u32 {
    let mut old = AtomicLoad32(target);

    while !AtomicCompareExchangeBool32(target, old, old | value) {
        old = AtomicLoad32(target);
