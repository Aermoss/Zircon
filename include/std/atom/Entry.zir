fn AtomicFetchNot8(target: *mut u8) -> u8 {
    let mut old = AtomicLoad8(target);

    while !AtomicCompareExchangeBool8(target, old, old ^ (0xFFu8)) {
        old = AtomicLoad8(target);
    }

    old
}

fn AtomicFetchNot16(target: *mut i16) -> i16 {
    let mut old = AtomicLoad16(target);

    while !AtomicCompareExchangeBool16(target, old, old ^ (-1i16)) {
        old = AtomicLoad16(target);
    }

    old
}

fn AtomicFetchNot32(target: *mut u32) -> u32 {
    let mut old = AtomicLoad32(target);

    while !AtomicCompareExchangeBool32(target, old, old ^ (0xFFFFFFFFu32)) {
        old = AtomicLoad32(target);
    }

    old
}

fn AtomicFetchNot64(target: *mut u64) -> u64 {
    let mut old = AtomicLoad64(target);

    while !AtomicCompareExchangeBool64(target, old, old ^ (0xFFFFFFFFFFFFFFFFu64)) {
        old = AtomicLoad64(target);
    }

    old
}

fn AtomicFetchNeg8(target: *mut u8) -> u8 {
    let mut old = AtomicLoad8(target);

    while !AtomicCompareExchangeBool8(target, old, (0 as u8) - old) {
        old = AtomicLoad8(target);
    }

    old
}

fn AtomicFetchNeg16(target: *mut i16) -> i16 {
    let mut old = AtomicLoad16(target);

    while !AtomicCompareExchangeBool16(target, old, (0 as i16) - old) {
