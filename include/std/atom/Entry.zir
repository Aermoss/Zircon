}

fn AtomicFetchXor32(target: *mut u32, value: u32) -> u32 {
    let mut old = AtomicLoad32(target);

    while !AtomicCompareExchangeBool32(target, old, old ^ value) {
        old = AtomicLoad32(target);
    }

