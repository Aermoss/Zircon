    }

    old
}

fn AtomicFetchAnd32(target: *mut u32, value: u32) -> u32 {
    let mut old = AtomicLoad32(target);

    while !AtomicCompareExchangeBool32(target, old, old & value) {
        old = AtomicLoad32(target);
    }

    old
}

fn AtomicFetchAnd64(target: *mut u64, value: u64) -> u64 {
    let mut old = AtomicLoad64(target);

    while !AtomicCompareExchangeBool64(target, old, old & value) {
        old = AtomicLoad64(target);
    }

    old
}

