fn AtomicFetchAnd8(target: *mut u8, value: u8) -> u8 {
    let mut old = AtomicLoad8(target);

    loop {
        if AtomicCompareExchangeBool8(target, old, old & value) {
            break;
        }

        old = AtomicLoad8(target);
        AtomicPause();
    }

    old
}

