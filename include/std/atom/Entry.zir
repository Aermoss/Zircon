fn AtomicFetchNeg64(target: *mut u64) -> u64 {
    let mut old = AtomicLoad64(target);

    while !AtomicCompareExchangeBool64(target, old, (0 as u64) - old) {
        old = AtomicLoad64(target);
    }

    old
}

fn AtomicIncrement8(target: *mut u8) {
    AtomicFetchAdd8(target, 1);
}

fn AtomicIncrement16(target: *mut i16) {
    AtomicFetchAdd16(target, 1);
}

fn AtomicIncrement32(target: *mut u32) {
    AtomicFetchAdd32(target, 1);
}

fn AtomicIncrement64(target: *mut u64) {
    AtomicFetchAdd64(target, 1);
}

fn AtomicDecrement8(target: *mut u8) {
    AtomicFetchSub8(target, 1);
}

fn AtomicDecrement16(target: *mut i16) {
    AtomicFetchSub16(target, 1);
}

fn AtomicDecrement32(target: *mut u32) {
    AtomicFetchSub32(target, 1);
}

fn AtomicDecrement64(target: *mut u64) {
    AtomicFetchSub64(target, 1);
}

fn AtomicBitTestAndSet32(target: *mut u32, bit: u8) -> bool {
    let mask = (1 as u32) << bit as u32;
    (AtomicFetchOr32(target, mask) & mask) != 0
}

fn AtomicBitTestAndSet64(target: *mut u64, bit: u8) -> bool {
    let mask = (1 as u64) << bit as u64;
    (AtomicFetchOr64(target, mask) & mask) != 0
}

fn AtomicBitTestAndReset32(target: *mut u32, bit: u8) -> bool {
    let mask = (1 as u32) << bit as u32;
    (AtomicFetchAnd32(target, mask ^ 0xFFFFFFFFu32) & mask) != 0
}

fn AtomicBitTestAndReset64(target: *mut u64, bit: u8) -> bool {
    let mask = (1 as u64) << bit as u64;
    (AtomicFetchAnd64(target, mask ^ 0xFFFFFFFFFFFFFFFFu64) & mask) != 0
}

fn AtomicBitTestAndComplement32(target: *mut u32, bit: u8) -> bool {
    let mask = (1 as u32) << bit as u32;
    (AtomicFetchXor32(target, mask) & mask) != 0
}

fn AtomicBitTestAndComplement64(target: *mut u64, bit: u8) -> bool {
    let mask = (1 as u64) << bit as u64;
    (AtomicFetchXor64(target, mask) & mask) != 0
}

fn AtomicBitTest32(target: *u32, bit: u8) -> bool {
    (AtomicLoad32(target) & ((1 as u32) << bit as u32)) != 0
}

fn AtomicBitTest64(target: *u64, bit: u8) -> bool {
    (AtomicLoad64(target) & ((1 as u64) << bit as u64)) != 0
}

fn AtomicMemoryFence() {
    volatile asm {
        dmb ish
    } : memory;
}

fn AtomicLoadFence() {
    volatile asm {
        dmb ish
    } : memory;
}

fn AtomicStoreFence() {
    volatile asm {
        dmb ish
    } : memory;
}

fn AtomicPause() {
    volatile asm {
        yield
    };
}
#[endif]

class Atomic<T> {
    value: T;

    Atomic(&mut this) {}

    Atomic(&mut this, value: T) {
        this.value = value;
    }

    pub fn Load(&this) -> T {
        if sizeof(T) == 1 {
            AtomicLoad8(&this.value as *u8) as T
        } else if sizeof(T) == 2 {
            AtomicLoad16(&this.value as *i16) as T
        } else if sizeof(T) == 4 {
            AtomicLoad32(&this.value as *u32) as T
        } else if sizeof(T) == 8 {
            AtomicLoad64(&this.value as *u64) as T
        } else {
            AtomicLoadFence();
            let value = this.value;
            AtomicLoadFence();
            value
        }
    }

    pub fn Store(&mut this, value: T) {
        if sizeof(T) == 1 {
            AtomicExchange8(&this.value as *mut u8, value as u8);
        } else if sizeof(T) == 2 {
            AtomicExchange16(&this.value as *mut i16, value as i16);
        } else if sizeof(T) == 4 {
            AtomicExchange32(&this.value as *mut u32, value as u32);
        } else if sizeof(T) == 8 {
            AtomicExchange64(&this.value as *mut u64, value as u64);
        } else {
            AtomicStoreFence();
            this.value = value;
            AtomicStoreFence();
        }
    }

    pub fn Exchange(&mut this, value: T) -> T {
        if sizeof(T) == 1 {
            AtomicExchange8(&this.value as *mut u8, value as u8) as T
        } else if sizeof(T) == 2 {
            AtomicExchange16(&this.value as *mut i16, value as i16) as T
        } else if sizeof(T) == 4 {
            AtomicExchange32(&this.value as *mut u32, value as u32) as T
        } else if sizeof(T) == 8 {
            AtomicExchange64(&this.value as *mut u64, value as u64) as T
        } else {
            AtomicStoreFence();
            let old = this.value;
            this.value = value;
            AtomicStoreFence();
            old
        }
    }

    pub fn CompareExchange(&mut this, expected: T, desired: T) -> bool {
        if sizeof(T) == 1 {
            AtomicCompareExchangeBool8(&this.value as *mut u8, expected as u8, desired as u8)
        } else if sizeof(T) == 2 {
            AtomicCompareExchangeBool16(&this.value as *mut i16, expected as i16, desired as i16)
        } else if sizeof(T) == 4 {
            AtomicCompareExchangeBool32(&this.value as *mut u32, expected as u32, desired as u32)
        } else if sizeof(T) == 8 {
            AtomicCompareExchangeBool64(&this.value as *mut u64, expected as u64, desired as u64)
        } else {
            AtomicMemoryFence();

            if this.value == expected {
                this.value = desired;
                AtomicMemoryFence();
                true
            } else {
                AtomicMemoryFence();
                false
            }
        }
    }

    pub fn operator==(&this, other: T) -> bool {
        this.Load() == other
    }

    pub fn operator!=(&this, other: T) -> bool {
        this.Load() != other
    }

    pub fn operator==(&this, other: &Atomic<T>) -> bool {
        this.Load() == other.Load()
    }

    pub fn operator!=(&this, other: &Atomic<T>) -> bool {
        this.Load() != other.Load()
    }

    pub fn operator=(&mut this, value: T) -> &mut Atomic<T> {
        this.Store(value);
        this
    }
}
