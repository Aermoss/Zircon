}

fn AtomicFetchXor8(target: *mut u8, value: u8) -> u8 {
    let mut old = AtomicLoad8(target);

    while !AtomicCompareExchangeBool8(target, old, old ^ value) {
        old = AtomicLoad8(target);
    }

    old
}

fn AtomicFetchXor16(target: *mut i16, value: i16) -> i16 {
    let mut old = AtomicLoad16(target);

    while !AtomicCompareExchangeBool16(target, old, old ^ value) {
        old = AtomicLoad16(target);
