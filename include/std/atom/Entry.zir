}

fn AtomicDecrement64(target: *mut u64) {
    volatile asm : rdi(target) -> {
        lock decq (%rdi)
    } : memory;
}

fn AtomicBitTestAndSet32(target: *mut u32, bit: u8) -> bool {
    let mut result = 0;

    volatile asm : rdi(target), sil(bit) -> {
        lock btsl %esi, (%rdi)
        setc %al
    } -> al(result) : memory;

    result != 0
}

fn AtomicBitTestAndSet64(target: *mut u64, bit: u8) -> bool {
    let mut result = 0;

    volatile asm : rdi(target), sil(bit) -> {
        lock btsq %rsi, (%rdi)
        setc %al
    } -> al(result) : memory;

    result != 0
}

