}

fn AtomicFetchXor64(target: *mut u64, value: u64) -> u64 {
    let mut old = AtomicLoad64(target);

    while !AtomicCompareExchangeBool64(target, old, old ^ value) {
        old = AtomicLoad64(target);
    }

    old
