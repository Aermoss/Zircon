#[include "std/str", "std/vec", "std/std" : *]

extern "C" {
    fn _bootstrap(argc: usize, argv: **i8) {
        let mut args = Vector<String>();

        for i in 0..argc {
            args.PushBack(argv[i].ToString());
        }

        Exit(Main(args));
    }
}

#[if AMD64]
asm {
    .globl _start

_start:
    xorq %rbp, %rbp
    popq %rdi
    movq %rsp, %rsi
    andq $-16, %rsp
    call _bootstrap
}
#[elif ARM64]
asm {
    .globl _start

_start:
    mov x29, xzr
    mov x30, xzr
    ldr x0, [sp]
    add x1, sp, #8
    bl _bootstrap
}
#[else]
#[error "Unsupported architecture!"]
#[endif]
