#[include "std/io", "std/mem", "std/time" : *]

type ThreadFunction = fn(*mut void);

class ThreadStart {
    pub function: ThreadFunction,
    pub argument: *mut void;

    ThreadStart(&mut this, function: ThreadFunction, argument: *mut void) {
        this.function = function;
        this.argument = argument;
    }
}

#[if WINDOWS]
class SRWLOCK {
    pub Ptr: *mut void
}

class CONDITION_VARIABLE {
    pub Ptr: *mut void
}

type NativeMutex = SRWLOCK;
type NativeCondition = CONDITION_VARIABLE;

const INFINITE: u32 = 0xFFFFFFFF;

extern "C" {
    fn CreateThread(lpThreadAttributes: *mut void, dwStackSize: usize, lpStartAddress: *mut void, lpParameter: *mut void, dwCreationFlags: u32, lpThreadId: *mut u32) -> *mut void;
    fn WaitForSingleObject(hHandle: *mut void, dwMilliseconds: u32) -> u32;
    fn Sleep(dwMilliseconds: u32);
    fn SwitchToThread() -> i32;

    fn InitializeSRWLock(SRWLock: *mut SRWLOCK);
    fn AcquireSRWLockExclusive(SRWLock: *mut SRWLOCK);
    fn TryAcquireSRWLockExclusive(SRWLock: *mut SRWLOCK) -> u8;
    fn ReleaseSRWLockExclusive(SRWLock: *mut SRWLOCK);

    fn InitializeConditionVariable(ConditionVariable: *mut CONDITION_VARIABLE);
    fn WakeConditionVariable(ConditionVariable: *mut CONDITION_VARIABLE);
    fn WakeAllConditionVariable(ConditionVariable: *mut CONDITION_VARIABLE);
    fn SleepConditionVariableSRW(ConditionVariable: *mut CONDITION_VARIABLE, SRWLock: *mut SRWLOCK, dwMilliseconds: u32, Flags: u32) -> i32;

    fn ThreadEntry(start: *mut void) -> u32 {
        let data = start as *mut ThreadStart;
        let (function, argument) = (data->function, data->argument);
        delete data;
        function(argument);
        0
    }
}
#[else]
class pthread_mutex_t {
    pub data: [u64; 8]
}

class pthread_cond_t {
    pub data: [u64; 8]
}

type pthread_t = usize;
type NativeMutex = pthread_mutex_t;
type NativeCondition = pthread_cond_t;

extern "C" {
    fn pthread_create(thread: *mut pthread_t, attr: *void, start: *mut void, arg: *mut void) -> i32;
    fn pthread_join(thread: pthread_t, result: *mut *mut void) -> i32;
    fn pthread_detach(thread: pthread_t) -> i32;

    fn pthread_mutex_init(mutex: *mut pthread_mutex_t, attr: *void) -> i32;
    fn pthread_mutex_lock(mutex: *mut pthread_mutex_t) -> i32;
    fn pthread_mutex_trylock(mutex: *mut pthread_mutex_t) -> i32;
    fn pthread_mutex_unlock(mutex: *mut pthread_mutex_t) -> i32;
    fn pthread_mutex_destroy(mutex: *mut pthread_mutex_t) -> i32;

    fn pthread_cond_init(cond: *mut pthread_cond_t, attr: *void) -> i32;
    fn pthread_cond_signal(cond: *mut pthread_cond_t) -> i32;
    fn pthread_cond_broadcast(cond: *mut pthread_cond_t) -> i32;
    fn pthread_cond_wait(cond: *mut pthread_cond_t, mutex: *mut pthread_mutex_t) -> i32;
    fn pthread_cond_timedwait(cond: *mut pthread_cond_t, mutex: *mut pthread_mutex_t, deadline: *timespec) -> i32;
    fn pthread_cond_destroy(cond: *mut pthread_cond_t) -> i32;

    fn nanosleep(request: *timespec, remaining: *mut timespec) -> i32;
    fn sched_yield() -> i32;

    fn ThreadEntry(start: *mut void) -> *mut void {
        let data = start as *mut ThreadStart;
        let (function, argument) = (data->function, data->argument);
        delete data;
        function(argument);
        null
    }
}
#[endif]

class Thread {
#[if WINDOWS]
    handle: *mut void = null,
    id: u32 = 0,
#[else]
    handle: pthread_t = 0,
#[endif]
    joined: bool = false;

    Thread(&mut this, function: ThreadFunction, argument: *mut void) {
        this.Start(function, argument, 0);
    }

    Thread(&mut this, function: ThreadFunction, argument: *mut void, committed_stack: usize) {
        this.Start(function, argument, committed_stack);
    }

    fn Start(&mut this, function: ThreadFunction, argument: *mut void, committed_stack: usize) {
        let start = new ThreadStart(function, argument);
#[if WINDOWS]
        this.handle = CreateThread(null, committed_stack, ThreadEntry as *mut void, start as *mut void, 0, &mut this.id);
        let created = this.handle != null;
#[else]
        let created = pthread_create(&mut this.handle, null, ThreadEntry as *mut void, start as *mut void) == 0;
#[endif]

        if !created {
            delete start;
            this.joined = true;
        }
    }

    ~Thread(&mut this) {
        this.Detach();
    }

    pub fn Join(&mut this) {
        if this.joined { return; }
#[if WINDOWS]
        WaitForSingleObject(this.handle, INFINITE);
        CloseHandle(this.handle);
#[else]
        pthread_join(this.handle, null);
#[endif]
        this.joined = true;
    }

    pub fn Detach(&mut this) {
        if this.joined { return; }
#[if WINDOWS]
        CloseHandle(this.handle);
#[else]
        pthread_detach(this.handle);
#[endif]
        this.joined = true;
    }

    pub fn GetId(&this) -> usize {
#[if WINDOWS]
        this.id as usize
#[else]
        this.handle
#[endif]
    }

    pub fn Sleep(&this, seconds: i64, nanoseconds: i32) {
#[if WINDOWS]
        ::Sleep((seconds * 1000 + (nanoseconds / 1000000) as i64) as u32);
#[else]
        let mut time: timespec;
        (time.tv_sec, time.tv_nsec) = (seconds, nanoseconds as i64);
        nanosleep(&time, null);
#[endif]
    }

    pub fn Yield() {
#[if WINDOWS]
        SwitchToThread();
#[else]
        sched_yield();
#[endif]
    }
}

class Mutex {
    lock: NativeMutex;

    Mutex(&mut this) {
#[if WINDOWS]
        InitializeSRWLock(&mut this.lock);
#[else]
        pthread_mutex_init(&mut this.lock, null);
#[endif]
    }

    ~Mutex(&mut this) {
#[if !WINDOWS]
        pthread_mutex_destroy(&mut this.lock);
#[endif]
    }

    pub fn Lock(&mut this) {
#[if WINDOWS]
        AcquireSRWLockExclusive(&mut this.lock);
#[else]
        pthread_mutex_lock(&mut this.lock);
#[endif]
    }

    pub fn Unlock(&mut this) {
#[if WINDOWS]
        ReleaseSRWLockExclusive(&mut this.lock);
#[else]
        pthread_mutex_unlock(&mut this.lock);
#[endif]
    }

    pub fn TryLock(&mut this) -> bool {
#[if WINDOWS]
        TryAcquireSRWLockExclusive(&mut this.lock) != 0
#[else]
        pthread_mutex_trylock(&mut this.lock) == 0
#[endif]
    }

    pub fn Handle(&mut this) -> *mut NativeMutex {
        &mut this.lock
    }
}

class ScopedLock {
    mutex: *mut Mutex;

    ScopedLock(&mut this, mutex: *mut Mutex) {
        this.mutex = mutex;
        this.mutex->Lock();
    }

    ~ScopedLock(&mut this) {
        this.mutex->Unlock();
    }
}

class ConditionVariable {
    condition: NativeCondition;

    ConditionVariable(&mut this) {
#[if WINDOWS]
        InitializeConditionVariable(&mut this.condition);
#[else]
        pthread_cond_init(&mut this.condition, null);
#[endif]
    }

    ~ConditionVariable(&mut this) {
#[if !WINDOWS]
        pthread_cond_destroy(&mut this.condition);
#[endif]
    }

    pub fn Signal(&mut this) {
#[if WINDOWS]
        WakeConditionVariable(&mut this.condition);
#[else]
        pthread_cond_signal(&mut this.condition);
#[endif]
    }

    pub fn Broadcast(&mut this) {
#[if WINDOWS]
        WakeAllConditionVariable(&mut this.condition);
#[else]
        pthread_cond_broadcast(&mut this.condition);
#[endif]
    }

    pub fn Wait(&mut this, mtx: *mut Mutex, timeout: u32) -> bool {
#[if WINDOWS]
        SleepConditionVariableSRW(&mut this.condition, mtx->Handle(), timeout, 0) != 0
#[else]
        let mut deadline: timespec;
        if clock_gettime(CLOCK_REALTIME, &mut deadline) != 0 { return false; }
        let nanoseconds = deadline.tv_nsec + timeout as i64 * 1000000;
        deadline.tv_sec += nanoseconds / 1000000000;
        deadline.tv_nsec = nanoseconds % 1000000000;
        pthread_cond_timedwait(&mut this.condition, mtx->Handle(), &deadline) == 0
#[endif]
    }

    pub fn Wait(&mut this, mtx: *mut Mutex) {
#[if WINDOWS]
        SleepConditionVariableSRW(&mut this.condition, mtx->Handle(), INFINITE, 0);
#[else]
        pthread_cond_wait(&mut this.condition, mtx->Handle());
#[endif]
    }
}
