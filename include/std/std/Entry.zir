#[if SVAROG]
type HostUnsigned = u32;
type HostSigned = i32;
#[else]
type HostUnsigned = u64;
type HostSigned = i64;
#[endif]

extern "C" {
#[if TRIGLAV]
    fn TriglavExit(status: i32) -> ! {
        volatile asm : a7(0), a0(status) -> {
            ecall
        } : memory;

        loop {}
    }

    fn TriglavExecute(path: *i8, command_line: *i8, status: *mut i32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(25), a0(path), a1(command_line), a2(status) -> {
            ecall
        } -> a0(result) : memory;

        result
    }
#[elif WINDOWS]
    fn ExitProcess(uExitCode: u32) -> !;
#[else]
    fn exit(status: i32) -> !;
#[endif]
}

fn Exit(status: i32) -> ! {
#[if TRIGLAV]
    TriglavExit(status);
#[elif WINDOWS]
    ExitProcess(status as u32);
#[else]
    exit(status);
#[endif]
}
