#[if ZENITH_COMPILER]
#[include "std/mem" : *]
#[endif]

#[if ZODIAC]
type HostUnsigned = u32;
type HostSigned = i32;
#[else]
type HostUnsigned = u64;
type HostSigned = i64;
#[endif]

extern "C" {
#[if ZENITH]
#[if !ZENITH_UNIFIED]
    fn ZenithExit(status: i32) -> !;
#[endif]
#[elif WINDOWS]
    fn ExitProcess(uExitCode: u32) -> !;
#[else]
    fn exit(status: i32) -> ! #[if LIBC] ; #[else] {
        let _status: i64 = status as i64;

        volatile asm : rax(60), rdi(_status) -> {
            syscall
        } : memory, rcx, r11, rax;

        loop {}
    } #[endif]
#[endif]
}

fn Exit(status: i32) -> ! {
#[if ZENITH]
#[if ZENITH_COMPILER]
    ReleaseCompilerMemory();
#[endif]
    ZenithExit(status);
#[elif WINDOWS]
    ExitProcess(status as u32);
#[else]
    exit(status);
#[endif]
}
