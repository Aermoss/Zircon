#[include "std/panic" : *]

enum Result<T, E> {
    Ok(T), Err(E);

    pub fn IsOk(&this) -> bool {
        match this {
            Result<T, E>::Ok(_) => true,
            Result<T, E>::Err(_) => false
        }
    }

    pub fn IsErr(&this) -> bool {
        match this {
            Result<T, E>::Ok(_) => false,
            Result<T, E>::Err(_) => true
        }
    }

    pub fn Unwrap(&this) -> T {
        match this {
            Result<T, E>::Ok(value) => value,
            Result<T, E>::Err(_) => Panic("called 'Unwrap' on an 'Err' value.")
        }
    }

    pub fn UnwrapOr(&this, default: T) -> T {
        match this {
            Result<T, E>::Ok(value) => value,
            Result<T, E>::Err(_) => default
        }
    }

    pub fn UnwrapErr(&this) -> E {
        match this {
            Result<T, E>::Ok(_) => Panic("called 'UnwrapErr' on an 'Ok' value."),
            Result<T, E>::Err(err) => err
        }
    }
}
