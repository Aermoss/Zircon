#[include "std/opt", "std/mem" : *]

class Vector<T> {
    data: *mut T = null,
    capacity: usize = 0,
    size: usize = 0;

    Vector(&mut this) {}

    Vector(&mut this, other: &Vector<T>) {
        if other.size == 0 { return; }
        this.Reserve(other.size);

        for i in 0..other.size {
            construct(this.data + i, other.data[i]);
        } this.size = other.size;
    }

    Vector(&mut this, values: &[T]) {
        if values.Length() == 0 { return; }
        this.Reserve(values.Length());

        for i in 0..values.Length() {
            construct(this.data + i, values[i]);
        } this.size = values.Length();
    }

    ~Vector(&mut this) {
        this.Release();
    }

    pub fn Data(&this) -> *T { this.data }
    pub fn Front(&this) -> &T { this.data }
    pub fn Back(&this) -> &T { this.data[this.size - 1] }

    pub fn AsSlice(&this) -> &[T] { slice(this.data, this.size) }
    pub fn AsSlice(&mut this) -> &mut [T] { slice(this.data, this.size) }

    pub fn Data(&mut this) -> *mut T { this.data }
    pub fn Front(&mut this) -> &mut T { this.data }
    pub fn Back(&mut this) -> &mut T { this.data[this.size - 1] }

    pub fn Empty(&this) -> bool { this.size == 0 }
    pub fn Length(&this) -> usize { this.size }

    fn Release(&mut this) {
        if this.data == null { return; }

        for i in 0..this.size {
            destruct(this.data + i);
        }

        free(this.data);
        (this.data, this.capacity, this.size) = (null, 0, 0);
    }

    fn Relocate(&mut this, capacity: usize) {
        let data = malloc(capacity * sizeof(T)) as *mut T;

        if this.data != null {
            memcpy(data, this.data, this.size * sizeof(T));
            free(this.data);
        }

        (this.data, this.capacity) = (data, capacity);
    }

    fn Grow(&mut this, size: usize) {
        if size <= this.capacity { return; }
        let doubled = this.capacity * 2;
        this.Relocate(if doubled > size { doubled } else { size });
    }

    pub fn Clear(&mut this) {
        this.Release();
    }

    pub fn Reserve(&mut this, capacity: usize) {
        if capacity > this.capacity {
            this.Relocate(capacity);
        }
    }

    pub fn Resize(&mut this, size: usize) {
        if size > this.size {
            this.Grow(size);

            for i in this.size..size {
                construct(this.data + i);
            }
        } else {
            for i in size..this.size {
                destruct(this.data + i);
            }
        } this.size = size;
    }

    pub fn Shrink(&mut this) {
        if this.size == this.capacity { return; }

        if this.size == 0 {
            this.Release();
        } else {
            this.Relocate(this.size);
        }
    }

    pub fn Swap(&mut this, other: &mut Vector<T>) {
        let (data, capacity, size) = (this.data, this.capacity, this.size);
        (this.data, this.capacity, this.size) = (other.data, other.capacity, other.size);
        (other.data, other.capacity, other.size) = (data, capacity, size);
    }

    pub fn Enumerate(&this) -> Vector<(usize, T)> {
        let mut result = Vector<(usize, T)>();
        result.Reserve(this.size);

        for i in 0..this.size {
            result.PushBack((i, this.data[i]));
        }

        result
    }

    pub fn Reverse(&this) -> Vector<T> {
        let mut result = Vector<T>();
        result.Reserve(this.size);

        for i in 0..this.size {
            construct(result.data + i, this.data[this.size - 1 - i]);
        }

        result.size = this.size;
        result
    }

    pub fn PushBack(&mut this, value: T) {
        this.Grow(this.size + 1);
        construct(this.data + this.size, value);
        this.size += 1;
    }

    pub fn PopBack(&mut this) -> Option<T> {
        if this.size == 0 { return Option<T>::None; }
        this.size -= 1;
        let result = Option<T>::Some(this.data[this.size]);
        destruct(this.data + this.size);
        result
    }

    pub fn Insert(&mut this, index: usize, value: T) {
        this.Grow(this.size + 1);
        memmove(this.data + index + 1, this.data + index, (this.size - index) * sizeof(T));
        construct(this.data + index, value);
        this.size += 1;
    }

    pub fn RemoveAt(&mut this, index: usize) -> T {
        let result = this.data[index];
        destruct(this.data + index);
        memmove(this.data + index, this.data + index + 1, (this.size - index - 1) * sizeof(T));
        this.size -= 1;
        result
    }

    pub fn Remove(&mut this, value: T) {
        let mut write_index: usize = 0;

        for read_index in 0..this.size {
            if this.data[read_index] != value {
                if read_index != write_index {
                    memcpy(this.data + write_index, this.data + read_index, sizeof(T));
                } write_index += 1;
            } else {
                destruct(this.data + read_index);
            }
        } this.size = write_index;
    }

    pub fn Contains(&this, value: T) -> bool {
        for i in 0..this.size {
            if this.data[i] == value {
                return true;
            }
        }

        false
    }

    pub fn Index(&this, value: T) -> Option<usize> {
        for i in 0..this.size {
            if this.data[i] == value {
                return Option<usize>::Some(i);
            }
        }

        Option<usize>::None
    }

    pub fn operator+(&this, other: &Vector<T>) -> Vector<T> {
        let mut result = Vector<T>();
        result.Reserve(this.size + other.size);

        for i in 0..this.size {
            construct(result.data + i, this.data[i]);
        }

        for i in 0..other.size {
            construct(result.data + this.size + i, other.data[i]);
        }

        result.size = this.size + other.size;
        result
    }

    pub fn operator+=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        let count = other.size;
        this.Grow(this.size + count);

        for i in 0..count {
            construct(this.data + this.size + i, other.data[i]);
        }

        this.size += count;
        this
    }

    pub fn operator=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        if this.data == other.data { return this; }
        this.Release();
        if other.size == 0 { return this; }
        this.Reserve(other.size);

        for i in 0..other.size {
            construct(this.data + i, other.data[i]);
        }

        this.size = other.size;
        this
    }

    pub fn operator[](&this, index: usize) -> &T {
        this.data[index]
    }

    pub fn operator[](&mut this, index: usize) -> &mut T {
        this.data[index]
    }

    pub fn Begin(&this) -> *T {
        this.data
    }

    pub fn End(&this) -> *T {
        this.data + this.size
    }

    pub fn Begin(&mut this) -> *mut T {
        this.data
    }

    pub fn End(&mut this) -> *mut T {
        this.data + this.size
    }
}
