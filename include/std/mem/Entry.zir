#[if TRIGLAV]
struct TriglavHeap {
    pub bins: [*mut u8; 36],
    pub chunk_ptr: *mut u8,
    pub chunk_end: *mut u8
}

static mut triglav_heap: TriglavHeap;
#[endif]

extern "C" {
#[if TRIGLAV || WINDOWS]
#[if TRIGLAV]
    fn TriglavAllocate(size: usize) -> *mut void {
        let mut result: *mut void = null;

        volatile asm : a7(1), a0(size) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavFree(ptr: *mut void) {
        volatile asm : a7(2), a0(ptr) -> {
            ecall
        } : memory;
    }

    fn TriglavCurrentHeap() -> *mut TriglavHeap {
        let mut heap: *mut TriglavHeap = null;

        volatile asm {
            mv a0, tp
        } -> a0(heap);

        if heap == null { &mut triglav_heap as *mut TriglavHeap } else { heap }
    }

    fn TriglavSetHeap(heap: *mut TriglavHeap) {
        volatile asm : a0(heap) -> {
            mv tp, a0
        } : memory;
    }

    fn TriglavNewHeap() -> *mut TriglavHeap {
        let heap = malloc(size_of<TriglavHeap>()) as *mut TriglavHeap;

        for i in 0usize..36 {
            heap->bins[i] = null;
        }

        heap->chunk_ptr = null;
        heap->chunk_end = null;
        heap
    }

    fn TriglavAdoptHeap(retired: *mut TriglavHeap) {
        let heap = TriglavCurrentHeap();

        for i in 0usize..36 {
            let first = retired->bins[i];
            if first == null { continue; }
            let mut last = first;

            while *(last as **mut u8) != null {
                last = *(last as **mut u8);
            }

            *(last as *mut *mut u8) = heap->bins[i];
            heap->bins[i] = first;
        }

        free(retired as *mut void);
    }

    fn TriglavOutOfMemory() -> ! {
        let message = "Out of memory.\n";

        volatile asm : a7(4), a0(message), a1(15) -> {
            ecall
        } : memory;

        volatile asm : a7(0), a0(1) -> {
            ecall
        } : memory;

        loop {}
    }
#[else]
    fn GetProcessHeap() -> *mut void;

    fn HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: usize) -> *mut void;
    fn HeapSize(hHeap: *mut void, dwFlags: u32, lpMem: *void) -> usize;
    fn HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;

    fn RtlCopyMemory(Destination: *mut void, Source: *void, Length: usize);
    fn RtlMoveMemory(Destination: *mut void, Source: *void, Length: usize);
    fn RtlFillMemory(Destination: *mut void, Length: usize, Fill: u8);
#[endif]

    fn malloc(size: usize) -> *mut void {
#[if TRIGLAV]
        if size > (-1 as usize) - 16 { return null; }
        let aligned = if size <= 8 { 8usize } else { (size + 7) & !7usize };

        if aligned <= 4096 {
            let (bin, capacity) = if aligned <= 256 {
                ((aligned >> 3) - 1, aligned)
            } else if aligned <= 512 {
                (32usize, 512usize)
            } else if aligned <= 1024 {
                (33usize, 1024usize)
            } else if aligned <= 2048 {
                (34usize, 2048usize)
            } else {
                (35usize, 4096usize)
            };

            let heap = TriglavCurrentHeap();
            let cached = heap->bins[bin];

            if cached != null {
                heap->bins[bin] = *(cached as **mut u8);
                return cached as *mut void;
            }

            let total = capacity + 8;

            if heap->chunk_ptr == null || (heap->chunk_end as usize) - (heap->chunk_ptr as usize) < total {
                let chunk = TriglavAllocate(32768) as *mut u8;
                if chunk == null { TriglavOutOfMemory(); }
                heap->chunk_ptr = chunk;
                heap->chunk_end = chunk + 32768;
            }

            let header = heap->chunk_ptr as *mut usize;
            heap->chunk_ptr = heap->chunk_ptr + total;
            header[0] = capacity;
            header[1] = bin;
            return (header as *mut u8 + 8) as *mut void;
        }

        let header = TriglavAllocate(aligned + 8) as *mut usize;
        if header == null { TriglavOutOfMemory(); }
        header[0] = aligned;
        header[1] = 0xFFFFFFFF;
        return (header as *mut u8 + 8) as *mut void;
#[else]
        return HeapAlloc(GetProcessHeap(), 0, size);
#[endif]
    }

    fn free(ptr: *mut void) {
        if ptr == null { return; }
#[if TRIGLAV]
        let header = ((ptr as *mut u8) - 8) as *mut usize;
        let bin = header[1];

        if bin < 36 {
            let heap = TriglavCurrentHeap();
            *(ptr as *mut *mut u8) = heap->bins[bin];
            heap->bins[bin] = ptr as *mut u8;
            return;
        }

        TriglavFree(header as *mut void);
#[else]
        HeapFree(GetProcessHeap(), 0, ptr);
#[endif]
    }

    fn memcpy(dst: *mut void, src: *void, size: usize) -> *mut void {
        if size == 0 || dst == null || src == null { return dst; }
#[if TRIGLAV]
        let mut target = dst as *mut u8;
        let mut source = src as *u8;
        let end = target + size;

        if size >= 16 && (((target as usize) ^ (source as usize)) & 3) == 0 {
            while ((target as usize) & 3) != 0 {
                *target = *source;
                target = target + 1;
                source = source + 1;
            }

            while (end as usize) - (target as usize) >= 16 {
                let a = *(source as *u32);
                let b = *((source + 4) as *u32);
                let c = *((source + 8) as *u32);
                let d = *((source + 12) as *u32);
                *(target as *mut u32) = a;
                *((target + 4) as *mut u32) = b;
                *((target + 8) as *mut u32) = c;
                *((target + 12) as *mut u32) = d;
                target = target + 16;
                source = source + 16;
            }

            while (end as usize) - (target as usize) >= 4 {
                *(target as *mut u32) = *(source as *u32);
                target = target + 4;
                source = source + 4;
            }
        }

        while target != end {
            *target = *source;
            target = target + 1;
            source = source + 1;
        }
#[else]
        RtlCopyMemory(dst, src, size);
#[endif]
        return dst;
    }

    fn memmove(dst: *mut void, src: *void, size: usize) -> *mut void {
        if size == 0 || dst == null || src == null { return dst; }
#[if TRIGLAV]
        if (dst as usize) <= (src as usize) {
            return memcpy(dst, src, size);
        } else {
            let mut i = size;

            while i > 0 {
                i -= 1;
                (dst as *mut u8)[i] = (src as *u8)[i];
            }
        }
#[else]
        RtlMoveMemory(dst, src, size);
#[endif]
        return dst;
    }

    fn memset(ptr: *mut void, value: i32, num: usize) -> *mut void {
        if num == 0 || ptr == null { return ptr; }
#[if TRIGLAV]
        let byte = value as u8;
        let mut target = ptr as *mut u8;
        let end = target + num;

        if num >= 16 {
            while ((target as usize) & 3) != 0 {
                *target = byte;
                target = target + 1;
            }

            let pattern = (byte as u32) * 0x01010101;

            while (end as usize) - (target as usize) >= 16 {
                *(target as *mut u32) = pattern;
                *((target + 4) as *mut u32) = pattern;
                *((target + 8) as *mut u32) = pattern;
                *((target + 12) as *mut u32) = pattern;
                target = target + 16;
            }

            while (end as usize) - (target as usize) >= 4 {
                *(target as *mut u32) = pattern;
                target = target + 4;
            }
        }

        while target != end {
            *target = byte;
            target = target + 1;
        }
#[else]
        RtlFillMemory(ptr, num, value as u8);
#[endif]
        return ptr;
    }

    fn calloc(nmemb: usize, size: usize) -> *mut void {
#[if TRIGLAV]
        if size != 0 && nmemb > (-1 as usize) / size { return null; }
#[endif]
        let total = nmemb * size;
        let ptr = malloc(total);
        if ptr == null { return null; }
        memset(ptr, 0, total);
        return ptr;
    }

    fn realloc(ptr: *mut void, size: usize) -> *mut void {
        if ptr == null { return malloc(size); }
        if size == 0 { free(ptr); return null; }
#[if TRIGLAV]
        let header = ((ptr as *mut u8) - 8) as *usize;
        let old_size = header[0];
#[else]
        let old_size = HeapSize(GetProcessHeap(), 0, ptr);
#[endif]
        if size <= old_size { return ptr; }
        let new_ptr = malloc(size);
        if new_ptr == null { return null; }
        memcpy(new_ptr, ptr, old_size);
        free(ptr);
        return new_ptr;
    }
#[else]
    fn malloc(size: usize) -> *mut void;
    fn free(ptr: *mut void);
    fn memcpy(dst: *mut void, src: *void, size: usize) -> *mut void;
    fn memmove(dst: *mut void, src: *void, size: usize) -> *mut void;
    fn memset(ptr: *mut void, value: i32, num: usize) -> *mut void;
    fn calloc(nmemb: usize, size: usize) -> *mut void;
    fn realloc(ptr: *mut void, size: usize) -> *mut void;
#[endif]
}
