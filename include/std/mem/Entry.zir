#[if ZENITH_COMPILER]
static mut compiler_allocations: *mut usize = null;
#[if ZENITH_UNIFIED]
static mut compiler_owner: u32 = 0xFFFFFFFF;
#[endif]
#[endif]

extern "C" {
#[if ZENITH]
#[if !ZENITH_UNIFIED]
    fn ZenithAllocate(size: usize) -> *mut void;
    fn ZenithFree(ptr: *mut void);
#[endif]
#[elif WINDOWS]
    fn GetProcessHeap() -> *mut void;

    fn HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: usize) -> *mut void;
    fn HeapSize(hHeap: *mut void, dwFlags: u32, lpMem: *void) -> usize;
    fn HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;

    fn RtlCopyMemory(Destination: *mut void, Source: *void, Length: usize);
    fn RtlMoveMemory(Destination: *mut void, Source: *void, Length: usize);
    fn RtlFillMemory(Destination: *mut void, Length: usize, Fill: u8);
#[endif]

    fn malloc(size: usize) -> *mut void #[if LIBC] ; #[else] {
#[if ZENITH]
#[if ZENITH_COMPILER]
        if size > (-1 as usize) - 16 { return null; }
#[if ZENITH_UNIFIED]
        let interrupts = DisableInterrupts();
#[endif]
        let header = ZenithAllocate(size + 16) as *mut usize;

        if header == null {
#[if ZENITH_UNIFIED]
            RestoreInterrupts(interrupts);
#[endif]
            return null;
        }
#[if ZENITH_UNIFIED]
        let tracked = ZenithCurrentProcess() == compiler_owner;
        header[3] = if tracked { 1 } else { 0 };
        if tracked {
#[endif]
        header[0] = compiler_allocations as usize;
        header[1] = 0;
        if compiler_allocations != null { compiler_allocations[1] = header as usize; }
        compiler_allocations = header;
#[if ZENITH_UNIFIED]
        }
#[endif]
        header[2] = size;
#[if ZENITH_UNIFIED]
        RestoreInterrupts(interrupts);
#[endif]
        return (header as *mut u8 + 16) as *mut void;
#[else]
        if size > (-1 as usize) - 8 { return null; }
        let header = ZenithAllocate(size + 8) as *mut usize;
        if header == null { return null; }
        header[0] = size;
        return (header as *mut u8 + 8) as *mut void;
#[endif]
#[elif WINDOWS]
        return HeapAlloc(GetProcessHeap(), 0, size);
#[else]
        let mut address: i64 = 0;

        volatile asm : rax(9), rdi(0), rsi((size + 8) as i64), rdx(3), r10(0x22), r8(-1), r9(0) -> {
            syscall
        } -> rax(address) : memory, rcx, r11;

        if address == -1 { return null; }
        let header = address as *mut i64;
        header[0] = size as i64;
        return (address + 8) as *mut void;
#[endif]
    } #[endif]

    fn free(ptr: *mut void) #[if LIBC] ; #[else] {
        if ptr == null { return; }
#[if ZENITH]
#[if ZENITH_COMPILER]
#[if ZENITH_UNIFIED]
        let interrupts = DisableInterrupts();
#[endif]
        let header = ((ptr as *mut u8) - 16) as *mut usize;
#[if ZENITH_UNIFIED]
        if header[3] != 0 {
#[endif]
        let next = header[0] as *mut usize;
        let previous = header[1] as *mut usize;
        if previous == null { compiler_allocations = next; } else { previous[0] = next as usize; }
        if next != null { next[1] = previous as usize; }
#[if ZENITH_UNIFIED]
        }
#[endif]
        ZenithFree(header as *mut void);
#[if ZENITH_UNIFIED]
        RestoreInterrupts(interrupts);
#[endif]
#[else]
        ZenithFree(((ptr as *mut u8) - 8) as *mut void);
#[endif]
#[elif WINDOWS]
        HeapFree(GetProcessHeap(), 0, ptr);
#[else]
        let base = ptr as i64 - 8;
        let header = base as *i64;
        let size = header[0] + 8;

        volatile asm : rax(11), rdi(base), rsi(size) -> {
            syscall
        } : memory, rcx, r11, rax;
#[endif]
    } #[endif]

    fn memcpy(dst: *mut void, src: *void, size: usize) -> *mut void #[if LIBC] ; #[else] {
        if size == 0 || dst == null || src == null { return dst; }
#[if ZENITH]
        for i in 0..size {
            (dst as *mut u8)[i] = (src as *u8)[i];
        }
#[elif WINDOWS]
        RtlCopyMemory(dst, src, size);
#[else]
        volatile asm : rdi(dst as *mut i8), rsi(src as *i8), rcx(size as i64) -> {
            rep movsb
        } : memory, rdi, rsi, rcx;
#[endif]
        return dst;
    } #[endif]

    fn memmove(dst: *mut void, src: *void, size: usize) -> *mut void #[if LIBC] ; #[else] {
        if size == 0 || dst == null || src == null { return dst; }
#[if ZENITH]
        if (dst as usize) <= (src as usize) {
            for i in 0..size {
                (dst as *mut u8)[i] = (src as *u8)[i];
            }
        } else {
            let mut i = size;

            while i > 0 {
                i -= 1;
                (dst as *mut u8)[i] = (src as *u8)[i];
            }
        }
#[elif WINDOWS]
        RtlMoveMemory(dst, src, size);
#[else]
        if (dst as usize) <= (src as usize) || (dst as usize) >= (src as usize) + size {
            volatile asm : rdi(dst as *mut i8), rsi(src as *i8), rcx(size as i64) -> {
                rep movsb
            } : memory, rdi, rsi, rcx;
        } else {
            volatile asm : rdi((dst as *mut i8) + (size - 1)), rsi((src as *i8) + (size - 1)), rcx(size as i64) -> {
                std
                rep movsb
                cld
            } : memory, rdi, rsi, rcx;
        }
#[endif]
        return dst;
    } #[endif]

    fn memset(ptr: *mut void, value: i32, num: usize) -> *mut void #[if LIBC] ; #[else] {
        if num == 0 || ptr == null { return ptr; }
#[if ZENITH]
        for i in 0..num {
            (ptr as *mut u8)[i] = value as u8;
        }
#[elif WINDOWS]
        RtlFillMemory(ptr, num, value as u8);
#[else]
        volatile asm : rdi(ptr as *mut i8), al(value as i8), rcx(num as i64) -> {
            rep stosb
        } : memory, rdi, rcx;
#[endif]
        return ptr;
    } #[endif]

    fn calloc(nmemb: usize, size: usize) -> *mut void #[if LIBC] ; #[else] {
#[if ZENITH]
        if size != 0 && nmemb > (-1 as usize) / size { return null; }
#[endif]
        let total = nmemb * size;
        let ptr = malloc(total);
        if ptr == null { return null; }
        memset(ptr, 0, total);
        return ptr;
    } #[endif]

    fn realloc(ptr: *mut void, size: usize) -> *mut void #[if LIBC] ; #[else] {
        if ptr == null { return malloc(size); }
        if size == 0 { free(ptr); return null; }
#[if ZENITH]
        let header = ((ptr as *mut u8) - 8) as *usize;
        let old_size = header[0];
#[elif WINDOWS]
        let old_size = HeapSize(GetProcessHeap(), 0, ptr);
#[else]
        let header = (ptr as i64 - 8) as *i64;
        let old_size = header[0] as usize;
#[endif]
        if size <= old_size { return ptr; }
        let new_ptr = malloc(size);
        if new_ptr == null { return null; }
        memcpy(new_ptr, ptr, old_size);
        free(ptr);
        return new_ptr;
    } #[endif]
}

#[if ZENITH_COMPILER]
#[if ZENITH_UNIFIED]
fn BeginCompilerMemory() -> bool {
    let interrupts = DisableInterrupts();

    if compiler_owner != 0xFFFFFFFF {
        RestoreInterrupts(interrupts);
        return false;
    }

    compiler_owner = ZenithCurrentProcess();
    RestoreInterrupts(interrupts);
    true
}

fn ReleaseCompilerMemoryForProcess(owner: u32) {
    let interrupts = DisableInterrupts();

    if owner != compiler_owner {
        RestoreInterrupts(interrupts);
        return;
    }

    let mut allocations = compiler_allocations;
    compiler_allocations = null;
    compiler_owner = 0xFFFFFFFF;
    RestoreInterrupts(interrupts);

    while allocations != null {
        let header = allocations;
        allocations = header[0] as *mut usize;
        ZenithFree(header as *mut void);
    }
}
#[endif]

fn ReleaseCompilerMemory() {
#[if ZENITH_UNIFIED]
    ReleaseCompilerMemoryForProcess(ZenithCurrentProcess());
#[else]
    while compiler_allocations != null {
        let header = compiler_allocations;
        compiler_allocations = header[0] as *mut usize;
        ZenithFree(header as *mut void);
    }
#[endif]
}
#[endif]
