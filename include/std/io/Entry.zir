#[include "std/str" : *]

extern "C" {
#[if ZENITH]
    fn ZenithConsoleRead(buffer: *mut i8, length: usize) -> isize {
        let mut result: isize = 0;

        volatile asm : a7(3), a0(buffer), a1(length) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn ZenithConsoleWrite(buffer: *i8, length: usize) -> isize {
        let mut result: isize = 0;

        volatile asm : a7(4), a0(buffer), a1(length) -> {
            ecall
        } -> a0(result) : memory;

        result
    }
#[elif WINDOWS]
    fn ReadFile(hFile: *mut void, lpBuffer: *mut i8, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: *mut u32, lpOverlapped: *mut void) -> i32;
    fn WriteFile(hFile: *mut void, lpBuffer: *i8, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut void) -> i32;

    fn GetStdHandle(nStdHandle: u32) -> *mut void;
#[else]
    fn read(fd: i32, buf: *mut i8, count: usize) -> isize #[if LIBC] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(0), rdi(fd as i64), rsi(buf), rdx(count as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        result as isize
    } #[endif]

    fn write(fd: i32, buf: *i8, len: usize) -> isize #[if LIBC] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(1), rdi(fd), rsi(buf), rdx(len) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        result as isize
    } #[endif]
#[endif]
}

#[if WINDOWS]
const STD_INPUT_HANDLE: u32 = 0xFFFFFFF6;
const STD_OUTPUT_HANDLE: u32 = 0xFFFFFFF5;
const STD_ERROR_HANDLE: u32 = 0xFFFFFFF4;
#[else]
const STDIN_FILENO: i32 = 0;
const STDOUT_FILENO: i32 = 1;
const STDERR_FILENO: i32 = 2;
#[endif]

fn ReadLine() -> Option<String> {
    let mut line = String();
    let mut character: i8 = 0;

    loop {
#[if ZENITH]
        let count = ZenithConsoleRead(&mut character, 1);
#[elif WINDOWS]
        let mut count: u32 = 0;
        ReadFile(GetStdHandle(STD_INPUT_HANDLE), &mut character, 1, &mut count, null);
#[else]
        let count = read(STDIN_FILENO, &mut character, 1);
#[endif]
        if count != 1 && line.Empty() { return Option<String>::None; }
        if count != 1 || character == '\n' || character == '\r' { break; }
        line += character;
    }

    Option<String>::Some(line)
}

fn Write(text: &String) {
#[if ZENITH]
    ZenithConsoleWrite(text.Data(), text.Length());
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text.Data(), text.Length() as u32, null, null);
#[else]
    write(STDOUT_FILENO, text.Data(), text.Length());
#[endif]
}

fn Write(text: *i8) {
#[if ZENITH]
    ZenithConsoleWrite(text, strlen(text));
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text, strlen(text) as u32, null, null);
#[else]
    write(STDOUT_FILENO, text, strlen(text));
#[endif]
}

fn WriteLine(text: &String) {
    Write(text);
#[if ZENITH]
    ZenithConsoleWrite("\n", 1);
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), "\n", 1, null, null);
#[else]
    write(STDOUT_FILENO, "\n", 1);
#[endif]
}

fn WriteLine(text: *i8) {
    Write(text);
#[if ZENITH]
    ZenithConsoleWrite("\n", 1);
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), "\n", 1, null, null);
#[else]
    write(STDOUT_FILENO, "\n", 1);
#[endif]
}

fn WriteError(text: &String) {
#[if ZENITH]
    ZenithConsoleWrite(text.Data(), text.Length());
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_ERROR_HANDLE), text.Data(), text.Length() as u32, null, null);
#[else]
    write(STDERR_FILENO, text.Data(), text.Length());
#[endif]
}

fn WriteError(text: *i8) {
#[if ZENITH]
    ZenithConsoleWrite(text, strlen(text));
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_ERROR_HANDLE), text, strlen(text) as u32, null, null);
#[else]
    write(STDERR_FILENO, text, strlen(text));
#[endif]
}

fn WriteErrorLine(text: &String) {
    WriteError(text);
#[if ZENITH]
    ZenithConsoleWrite("\n", 1);
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_ERROR_HANDLE), "\n", 1, null, null);
#[else]
    write(STDERR_FILENO, "\n", 1);
#[endif]
}

fn WriteErrorLine(text: *i8) {
    WriteError(text);
#[if ZENITH]
    ZenithConsoleWrite("\n", 1);
#[elif WINDOWS]
    WriteFile(GetStdHandle(STD_ERROR_HANDLE), "\n", 1, null, null);
#[else]
    write(STDERR_FILENO, "\n", 1);
#[endif]
}

fn WriteRest() {
    Write("\n");
}

fn WriteRest(arg: *i8, args...) {
    Write(" ");
    Write(arg);
    WriteRest(args...);
}

fn WriteRest(arg: &String, args...) {
    Write(" ");
    Write(arg);
    WriteRest(args...);
}

fn WriteAll(arg: *i8, args...) {
    Write(arg);
    WriteRest(args...);
}

fn WriteAll(arg: &String, args...) {
    Write(arg);
    WriteRest(args...);
}
