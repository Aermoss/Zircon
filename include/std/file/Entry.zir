#[include "std/io", "std/std", "std/str", "std/vec", "std/res", "std/mem" : *]

enum IOError {
    NotFound, PermissionDenied, AlreadyExists, InvalidInput, UnexpectedEnd, NotEmpty, NoSpace, IsFolder, NotFolder, Other(i32);

    pub fn ToString(&this) -> String {
        match this {
            IOError::NotFound => "entity not found".ToString(),
            IOError::PermissionDenied => "permission denied".ToString(),
            IOError::AlreadyExists => "entity already exists".ToString(),
            IOError::InvalidInput => "invalid input".ToString(),
            IOError::UnexpectedEnd => "unexpected end of file".ToString(),
            IOError::NotEmpty => "folder is not empty".ToString(),
            IOError::NoSpace => "no space left".ToString(),
            IOError::IsFolder => "entity is a folder".ToString(),
            IOError::NotFolder => "entity is not a folder".ToString(),
            IOError::Other(code) => "os error " + String::FromInteger(code as HostSigned)
        }
    }
}

enum FileMode: u32 {
    Read, Write, Append, Update
}

enum SeekOrigin: u32 {
    Start, Current, End
}

enum EntryKind: u32 {
    File, Folder
}

class FolderEntry {
    pub name: String,
    pub kind: EntryKind,
    pub size: usize
}

const FILE_BUFFER_SIZE: usize = 4096;

#[if TRIGLAV]
const PATH_SEPARATOR: i8 = '/';
const TRIGLAV_PATH_MAX: usize = 2048;

const TRIGLAV_NO_SPACE: u32 = 5;
const TRIGLAV_FOLDER: u32 = 2;

class TriglavFolderRecord {
    pub name: [i8; 32],
    pub kind: u32,
    pub size: u32
}

extern "C" {
    fn TriglavPathKind(path: *i8) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(5), a0(path) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavCanonicalPath(path: *i8, buffer: *mut i8, capacity: usize) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(6), a0(path), a1(buffer), a2(capacity) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavRemoveFile(path: *i8) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(9), a0(path) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavOpen(path: *i8, mode: u32, handle: *mut u32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(12), a0(path), a1(mode), a2(handle) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavClose(handle: u32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(13), a0(handle) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavRead(handle: u32, buffer: *mut u8, count: usize, read: *mut usize) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(14), a0(handle), a1(buffer), a2(count), a3(read) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavWrite(handle: u32, data: *u8, count: usize) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(15), a0(handle), a1(data), a2(count) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavSeek(handle: u32, offset: i32, origin: u32, position: *mut u32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(16), a0(handle), a1(offset), a2(origin), a3(position) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavSize(handle: u32, size: *mut u32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(17), a0(handle), a1(size) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavListFolder(path: *i8, buffer: *mut TriglavFolderRecord, capacity: u32, count: *mut u32) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(18), a0(path), a1(buffer), a2(capacity), a3(count) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavCreateFolder(path: *i8) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(19), a0(path) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavRemoveFolder(path: *i8) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(20), a0(path) -> {
            ecall
        } -> a0(result) : memory;

        result
    }

    fn TriglavRename(source: *i8, destination: *i8) -> u32 {
        let mut result: u32 = 0;

        volatile asm : a7(21), a0(source), a1(destination) -> {
            ecall
        } -> a0(result) : memory;

        result
    }
}

fn TriglavError(code: u32) -> IOError {
    match code {
        2 => IOError::NotFound,
        3 | 11 | 13 | 17 => IOError::InvalidInput,
        4 | 5 => IOError::NoSpace,
        7 => IOError::NotFolder,
        8 => IOError::IsFolder,
        9 => IOError::NotEmpty,
        10 => IOError::AlreadyExists,
        14 | 15 => IOError::PermissionDenied,
        _ => IOError::Other(code as i32)
    }
}

fn TriglavResult(code: u32) -> Result<(), IOError> {
    if code != 0 { return Result<(), IOError>::Err(TriglavError(code)); }
    Result<(), IOError>::Ok(())
}

fn PathExists(path: &String) -> bool { TriglavPathKind(path.Data()) != 0 }
fn FileExists(path: &String) -> bool { TriglavPathKind(path.Data()) == 1 }
fn FolderExists(path: &String) -> bool { TriglavPathKind(path.Data()) == 2 }

fn CreateFolder(path: &String) -> Result<(), IOError> { TriglavResult(TriglavCreateFolder(path.Data())) }
fn RemoveFile(path: &String) -> Result<(), IOError> { TriglavResult(TriglavRemoveFile(path.Data())) }
fn RemoveFolder(path: &String) -> Result<(), IOError> { TriglavResult(TriglavRemoveFolder(path.Data())) }
fn RenamePath(source: &String, destination: &String) -> Result<(), IOError> { TriglavResult(TriglavRename(source.Data(), destination.Data())) }

fn ListFolder(path: &String) -> Result<Vector<FolderEntry>, IOError> {
    let mut entries = Vector<FolderEntry>();
    let mut count: u32 = 0;
    let mut result = TriglavListFolder(path.Data(), null, 0, &mut count);
    if result != 0 { return Result<Vector<FolderEntry>, IOError>::Err(TriglavError(result)); }

    while count != 0 {
        let capacity = count;
        let records = new TriglavFolderRecord[capacity as usize];
        result = TriglavListFolder(path.Data(), records, capacity, &mut count);

        if result == TRIGLAV_NO_SPACE {
            delete[] records;
            continue;
        }

        if result != 0 {
            delete[] records;
            return Result<Vector<FolderEntry>, IOError>::Err(TriglavError(result));
        }

        for i in 0..count {
            let mut entry: FolderEntry;
            entry.name = String(&records[i as usize].name[0] as *i8);
            entry.kind = if records[i as usize].kind == TRIGLAV_FOLDER { EntryKind::Folder } else { EntryKind::File };
            entry.size = records[i as usize].size as usize;
            entries.PushBack(entry);
        }

        delete[] records;
        break;
    }

    Result<Vector<FolderEntry>, IOError>::Ok(entries)
}

fn AbsolutePath(path: &String) -> Result<String, IOError> {
    let buffer = new i8[TRIGLAV_PATH_MAX];
    let result = TriglavCanonicalPath(path.Data(), buffer, TRIGLAV_PATH_MAX);

    if result != 0 {
        delete[] buffer;
        return Result<String, IOError>::Err(TriglavError(result));
    }

    let canonical = String(buffer);
    delete[] buffer;
    Result<String, IOError>::Ok(canonical)
}

fn ExecutablePath() -> Result<String, IOError> {
    Result<String, IOError>::Err(IOError::InvalidInput)
}

fn TemporaryPath() -> Result<String, IOError> {
    Result<String, IOError>::Err(IOError::InvalidInput)
}
#[elif WINDOWS]
const PATH_SEPARATOR: i8 = '\\';
const MAX_PATH: usize = 260;

class FILETIME {
    pub dwLowDateTime: u32,
    pub dwHighDateTime: u32
}

type LPFILETIME = *mut FILETIME;

class WIN32_FIND_DATAA {
    pub dwFileAttributes: u32,
    pub ftCreationTime: FILETIME,
    pub ftLastAccessTime: FILETIME,
    pub ftLastWriteTime: FILETIME,
    pub nFileSizeHigh: u32,
    pub nFileSizeLow: u32,
    pub dwReserved0: u32,
    pub dwReserved1: u32,
    pub cFileName: [i8; MAX_PATH],
    pub cAlternateFileName: [i8; 14],
    pub dwFileType: u32,
    pub dwCreatorType: u32,
    pub wFinderFlags: u16
}

type LPWIN32_FIND_DATAA = *mut WIN32_FIND_DATAA;

extern "C" {
    fn GetFileAttributesA(lpFileName: *i8) -> u32;

    fn FindFirstFileA(lpFileName: *i8, lpFindFileData: LPWIN32_FIND_DATAA) -> *mut void;
    fn FindNextFileA(hFindFile: *mut void, lpFindFileData: LPWIN32_FIND_DATAA) -> i32;
    fn FindClose(hFindFile: *mut void) -> i32;

    fn GetTempPathA(nBufferLength: u32, lpBuffer: *mut i8) -> u32;
    fn GetFullPathNameA(lpFileName: *i8, nBufferLength: u32, lpBuffer: *mut i8, lpFilePart: *mut *mut i8) -> u32;
    fn GetModuleFileNameA(hModule: *mut void, lpFilename: *mut i8, nSize: u32) -> u32;

    fn CreateFileA(lpFileName: *i8, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut void) -> *mut void;
    fn SetFilePointerEx(hFile: *mut void, liDistanceToMove: i64, lpNewFilePointer: *mut i64, dwMoveMethod: u32) -> i32;
    fn GetFileSizeEx(hFile: *mut void, lpFileSize: *mut i64) -> i32;

    fn DeleteFileA(lpFileName: *i8) -> i32;
    fn CreateDirectoryA(lpPathName: *i8, lpSecurityAttributes: *mut void) -> i32;
    fn RemoveDirectoryA(lpPathName: *i8) -> i32;
    fn MoveFileExA(lpExistingFileName: *i8, lpNewFileName: *i8, dwFlags: u32) -> i32;

    fn GetLastError() -> u32;
}

const GENERIC_READ: u32 = 0x80000000;
const GENERIC_WRITE: u32 = 0x40000000;
const FILE_APPEND_DATA: u32 = 0x00000004;

const FILE_SHARE_READ: u32 = 0x00000001;
const FILE_SHARE_WRITE: u32 = 0x00000002;

const CREATE_ALWAYS: u32 = 0x00000002;
const OPEN_EXISTING: u32 = 0x00000003;
const OPEN_ALWAYS: u32 = 0x00000004;

const MOVEFILE_REPLACE_EXISTING: u32 = 0x00000001;
const MOVEFILE_COPY_ALLOWED: u32 = 0x00000002;

const FILE_ATTRIBUTE_NORMAL: u32 = 0x00000080;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x00000010;
const INVALID_FILE_ATTRIBUTES: u32 = 0xFFFFFFFF;

const INVALID_HANDLE_VALUE: *mut void = -1isize as *mut void;
const MAX_TRANSFER: usize = 0x40000000;

fn LastError() -> IOError {
    match GetLastError() {
        2 | 3 => IOError::NotFound,
        5 | 32 => IOError::PermissionDenied,
        38 => IOError::UnexpectedEnd,
        39 | 112 => IOError::NoSpace,
        80 | 183 => IOError::AlreadyExists,
        87 | 123 | 131 => IOError::InvalidInput,
        145 => IOError::NotEmpty,
        267 => IOError::NotFolder,
        code => IOError::Other(code as i32)
    }
}

fn WindowsResult(success: i32) -> Result<(), IOError> {
    if success == 0 {
        return Result<(), IOError>::Err(LastError());
    }

    Result<(), IOError>::Ok(())
}

fn PathExists(path: &String) -> bool {
    GetFileAttributesA(path.Data()) != INVALID_FILE_ATTRIBUTES
}

fn FileExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());
    attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0
}

fn FolderExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());
    attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
}

fn CreateFolder(path: &String) -> Result<(), IOError> {
    WindowsResult(CreateDirectoryA(path.Data(), null))
}

fn RemoveFile(path: &String) -> Result<(), IOError> {
    WindowsResult(DeleteFileA(path.Data()))
}

fn RemoveFolder(path: &String) -> Result<(), IOError> {
    WindowsResult(RemoveDirectoryA(path.Data()))
}

fn RenamePath(source: &String, destination: &String) -> Result<(), IOError> {
    WindowsResult(MoveFileExA(source.Data(), destination.Data(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED))
}

fn ListFolder(path: &String) -> Result<Vector<FolderEntry>, IOError> {
    let mut find_data: WIN32_FIND_DATAA;
    let handle = FindFirstFileA(JoinPath(path, String("*")).Data(), &mut find_data);
    if handle == INVALID_HANDLE_VALUE { return Result<Vector<FolderEntry>, IOError>::Err(LastError()); }
    let mut entries = Vector<FolderEntry>();

    loop {
        let name = String(&find_data.cFileName[0] as *i8);

        if name != "." && name != ".." {
            let mut entry: FolderEntry;
            entry.name = name;
            entry.kind = if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 { EntryKind::Folder } else { EntryKind::File };
            entry.size = (((find_data.nFileSizeHigh as u64) << 32) | (find_data.nFileSizeLow as u64)) as usize;
            entries.PushBack(entry);
        }

        if FindNextFileA(handle, &mut find_data) == 0 {
            break;
        }
    }

    FindClose(handle);
    Result<Vector<FolderEntry>, IOError>::Ok(entries)
}

fn AbsolutePath(path: &String) -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let mut file_part: *mut i8 = null;
    let length = GetFullPathNameA(path.Data(), MAX_PATH as u32, &mut buffer[0], &mut file_part);
    if length == 0 { return Result<String, IOError>::Err(LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}

fn ExecutablePath() -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let length = GetModuleFileNameA(null, &mut buffer[0], MAX_PATH as u32);
    if length == 0 { return Result<String, IOError>::Err(LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}

fn TemporaryPath() -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let length = GetTempPathA(MAX_PATH as u32, &mut buffer[0]);
    if length == 0 { return Result<String, IOError>::Err(LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}
