extern "C" {
    fn open(pathname: *i8, flags: i32, ...) -> i32;
    fn close(fd: i32) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn fstat(fd: i32, statbuf: *mut _stat) -> i32;
    fn stat(pathname: *i8, statbuf: *mut _stat) -> i32;
    fn access(pathname: *i8, mode: i32) -> i32;
    fn unlink(pathname: *i8) -> i32;
    fn mkdir(pathname: *i8, mode: u32) -> i32;
    fn rmdir(pathname: *i8) -> i32;
    fn rename(oldpath: *i8, newpath: *i8) -> i32;
    fn realpath(path: *i8, resolved_path: *mut i8) -> *mut i8;
    fn opendir(name: *i8) -> *mut void;
    fn readdir(directory: *mut void) -> *mut u8;
    fn closedir(directory: *mut void) -> i32;
#[if DARWIN]
    fn __error() -> *mut i32;
    fn _NSGetExecutablePath(buffer: *mut i8, size: *mut u32) -> i32;
#[else]
    fn __errno_location() -> *mut i32;
    fn readlink(pathname: *i8, buffer: *mut i8, size: usize) -> isize;
#[endif]
}

fn LastError() -> IOError {
#[if DARWIN]
    let code = *__error();
#[else]
    let code = *__errno_location();
#[endif]

    match code {
        2 => IOError::NotFound,
        1 | 13 => IOError::PermissionDenied,
        17 => IOError::AlreadyExists,
        20 => IOError::NotFolder,
        21 => IOError::IsFolder,
        22 => IOError::InvalidInput,
        28 => IOError::NoSpace,
#[if DARWIN]
        66 => IOError::NotEmpty,
#[else]
        39 => IOError::NotEmpty,
#[endif]
        _ => IOError::Other(code)
    }
}

fn PosixResult(result: i32) -> Result<(), IOError> {
    if result != 0 { return Result<(), IOError>::Err(LastError()); }
    Result<(), IOError>::Ok(())
}

fn PathExists(path: &String) -> bool {
    access(path.Data(), F_OK) == 0
}

fn FileExists(path: &String) -> bool {
    let mut st: _stat;
    stat(path.Data(), &mut st) == 0 && ((st.st_mode as u32) & S_IFMT) == S_IFREG
}

fn FolderExists(path: &String) -> bool {
    let mut st: _stat;
    stat(path.Data(), &mut st) == 0 && ((st.st_mode as u32) & S_IFMT) == S_IFDIR
}

fn CreateFolder(path: &String) -> Result<(), IOError> {
    PosixResult(mkdir(path.Data(), FOLDER_PERMISSIONS))
}

fn RemoveFile(path: &String) -> Result<(), IOError> {
    PosixResult(unlink(path.Data()))
}

fn RemoveFolder(path: &String) -> Result<(), IOError> {
    PosixResult(rmdir(path.Data()))
}

fn RenamePath(source: &String, destination: &String) -> Result<(), IOError> {
    PosixResult(rename(source.Data(), destination.Data()))
}

fn ListFolder(path: &String) -> Result<Vector<FolderEntry>, IOError> {
    let directory = opendir(path.Data());
    if directory == null { return Result<Vector<FolderEntry>, IOError>::Err(LastError()); }
    let mut entries = Vector<FolderEntry>();

    loop {
        let record = readdir(directory);
        if record == null { break; }
        let mut entry: FolderEntry;
        entry.name = String((record + DIRENT_NAME_OFFSET) as *i8);
        if entry.name == "." || entry.name == ".." { continue; }
        let mut st: _stat;

        if stat(JoinPath(path, entry.name).Data(), &mut st) == 0 {
            entry.kind = if ((st.st_mode as u32) & S_IFMT) == S_IFDIR { EntryKind::Folder } else { EntryKind::File };
            entry.size = st.st_size as usize;
        } else {
            entry.kind = EntryKind::File;
            entry.size = 0;
        }

        entries.PushBack(entry);
    }

    closedir(directory);
    Result<Vector<FolderEntry>, IOError>::Ok(entries)
}

fn AbsolutePath(path: &String) -> Result<String, IOError> {
    let mut buffer: [i8; PATH_MAX];
    if realpath(path.Data(), &mut buffer[0]) == null { return Result<String, IOError>::Err(LastError()); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8))
}

fn ExecutablePath() -> Result<String, IOError> {
    let mut buffer: [i8; PATH_MAX];
#[if DARWIN]
    let mut size = PATH_MAX as u32;
    if _NSGetExecutablePath(&mut buffer[0], &mut size) != 0 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    AbsolutePath(String(&buffer[0] as *i8))
#[else]
    let length = readlink("/proc/self/exe", &mut buffer[0], PATH_MAX);
    if length < 0 { return Result<String, IOError>::Err(LastError()); }
    if length as usize >= PATH_MAX { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
#[endif]
}

fn TemporaryPath() -> Result<String, IOError> {
    Result<String, IOError>::Ok("/tmp/".ToString())
}
#[endif]

class FileHandle {
    value: usize = 0;

    pub fn Open(path: &String, mode: FileMode) -> Result<FileHandle, IOError> {
        let mut handle: FileHandle;
#[if TRIGLAV]
        let mut value: u32 = 0;
        let result = TriglavOpen(path.Data(), mode as u32, &mut value);
        if result != 0 { return Result<FileHandle, IOError>::Err(TriglavError(result)); }
        handle.value = value as usize;
#[elif WINDOWS]
        let (mut access, mut share, mut disposition) = (GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, OPEN_EXISTING);

        if mode == FileMode::Write {
            (access, share, disposition) = (GENERIC_WRITE, FILE_SHARE_READ, CREATE_ALWAYS);
        } else if mode == FileMode::Append {
            (access, share, disposition) = (FILE_APPEND_DATA, FILE_SHARE_READ, OPEN_ALWAYS);
        } else if mode == FileMode::Update {
            (access, share, disposition) = (GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, OPEN_EXISTING);
        }

        let value = CreateFileA(path.Data(), access, share, null, disposition, FILE_ATTRIBUTE_NORMAL, null);

        if value == INVALID_HANDLE_VALUE {
            let error = LastError();
            if FolderExists(path) { return Result<FileHandle, IOError>::Err(IOError::IsFolder); }
            return Result<FileHandle, IOError>::Err(error);
        }

        handle.value = value as usize;
#[else]
        let mut flags = O_RDONLY;

        if mode == FileMode::Read && FolderExists(path) {
            return Result<FileHandle, IOError>::Err(IOError::IsFolder);
        } else if mode == FileMode::Write {
            flags = O_WRONLY | O_CREAT | O_TRUNC;
        } else if mode == FileMode::Append {
            flags = O_WRONLY | O_CREAT | O_APPEND;
        } else if mode == FileMode::Update {
            flags = O_RDWR;
        }

        let fd = open(path.Data(), flags, FILE_PERMISSIONS);
        if fd < 0 { return Result<FileHandle, IOError>::Err(LastError()); }
        handle.value = fd as usize;
#[endif]
        Result<FileHandle, IOError>::Ok(handle)
    }

    pub fn Close(&this) -> Result<(), IOError> {
#[if TRIGLAV]
        TriglavResult(TriglavClose(this.value as u32))
#[elif WINDOWS]
        WindowsResult(CloseHandle(this.value as *mut void))
#[else]
        PosixResult(close(this.value as i32))
#[endif]
    }

    pub fn Read(&this, buffer: *mut u8, count: usize) -> Result<usize, IOError> {
#[if TRIGLAV]
        let mut length: usize = 0;
        let result = TriglavRead(this.value as u32, buffer, count, &mut length);
        if result != 0 { return Result<usize, IOError>::Err(TriglavError(result)); }
        Result<usize, IOError>::Ok(length)
#[elif WINDOWS]
        let chunk = if count > MAX_TRANSFER { MAX_TRANSFER } else { count };
        let mut length: u32 = 0;
        if ReadFile(this.value as *mut void, buffer as *mut i8, chunk as u32, &mut length, null) == 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(length as usize)
#[else]
        let length = read(this.value as i32, buffer as *mut i8, count);
        if length < 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(length as usize)
#[endif]
    }

    pub fn Write(&this, data: *u8, count: usize) -> Result<usize, IOError> {
#[if TRIGLAV]
        let result = TriglavWrite(this.value as u32, data, count);
        if result != 0 { return Result<usize, IOError>::Err(TriglavError(result)); }
        Result<usize, IOError>::Ok(count)
#[elif WINDOWS]
        let chunk = if count > MAX_TRANSFER { MAX_TRANSFER } else { count };
        let mut length: u32 = 0;
        if WriteFile(this.value as *mut void, data as *i8, chunk as u32, &mut length, null) == 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(length as usize)
#[else]
        let length = write(this.value as i32, data as *i8, count);
        if length < 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(length as usize)
#[endif]
    }

    pub fn Seek(&this, offset: isize, origin: SeekOrigin) -> Result<usize, IOError> {
#[if TRIGLAV]
        let mut position: u32 = 0;
        let result = TriglavSeek(this.value as u32, offset as i32, origin as u32, &mut position);
        if result != 0 { return Result<usize, IOError>::Err(TriglavError(result)); }
        Result<usize, IOError>::Ok(position as usize)
#[elif WINDOWS]
        let mut position: i64 = 0;
        if SetFilePointerEx(this.value as *mut void, offset as i64, &mut position, origin as u32) == 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(position as usize)
#[else]
        let position = lseek(this.value as i32, offset as i64, origin as i32);
        if position < 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(position as usize)
#[endif]
    }

    pub fn Size(&this) -> Result<usize, IOError> {
#[if TRIGLAV]
        let mut size: u32 = 0;
        let result = TriglavSize(this.value as u32, &mut size);
        if result != 0 { return Result<usize, IOError>::Err(TriglavError(result)); }
        Result<usize, IOError>::Ok(size as usize)
#[elif WINDOWS]
        let mut size: i64 = 0;
        if GetFileSizeEx(this.value as *mut void, &mut size) == 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(size as usize)
#[else]
        let mut st: _stat;
        if fstat(this.value as i32, &mut st) != 0 { return Result<usize, IOError>::Err(LastError()); }
        Result<usize, IOError>::Ok(st.st_size as usize)
#[endif]
    }
}

class File {
    handle: FileHandle,
    open: bool = false,
    mode: FileMode,
    buffer: *mut u8 = null,
    position: usize = 0,
    available: usize = 0,
    cursor: usize = 0,
    pending: usize = 0;

    File(&mut this) {
        this.mode = FileMode::Read;
    }

    ~File(&mut this) {
        this.Close();
    }

    pub fn Open(&mut this, path: &String, mode: FileMode) -> Result<(), IOError> {
        if let Result<(), IOError>::Err(error) = this.Close() {
            return Result<(), IOError>::Err(error);
        }

        let handle = match FileHandle::Open(path, mode) {
            Result<FileHandle, IOError>::Ok(handle) => handle,
            Result<FileHandle, IOError>::Err(error) => {
                return Result<(), IOError>::Err(error);
            }
        };

        this.handle = handle;
        this.mode = mode;
        this.open = true;
        this.buffer = new u8[FILE_BUFFER_SIZE];
        this.position = 0;
        this.available = 0;
        this.cursor = 0;
        this.pending = 0;

        if mode == FileMode::Append {
            match handle.Size() {
                Result<usize, IOError>::Ok(size) => {
                    this.position = size;
                },
                Result<usize, IOError>::Err(error) => {
                    this.Close();
                    return Result<(), IOError>::Err(error);
                }
            }
        }

        Result<(), IOError>::Ok(())
    }

    pub fn Close(&mut this) -> Result<(), IOError> {
        if !this.open {
            return Result<(), IOError>::Ok(());
        }

        let flushed = this.FlushPending();
        let closed = this.handle.Close();
        delete[] this.buffer;
        this.buffer = null;
        this.open = false;

        if flushed.IsErr() {
            return flushed;
        }

        closed
    }

    pub fn IsOpen(&this) -> bool {
        this.open
    }

    pub fn Handle(&this) -> FileHandle {
        this.handle
    }

    pub fn Read(&mut this, buffer: *mut u8, count: usize) -> Result<usize, IOError> {
        if !this.open {
            return Result<usize, IOError>::Err(IOError::InvalidInput);
        }

        if this.mode == FileMode::Write || this.mode == FileMode::Append {
            return Result<usize, IOError>::Err(IOError::PermissionDenied);
        }

        if let Result<(), IOError>::Err(error) = this.FlushPending() {
            return Result<usize, IOError>::Err(error);
        }

        let mut copied: usize = 0;

        while copied < count {
            if this.cursor < this.available {
                let mut length = this.available - this.cursor;
                if length > count - copied { length = count - copied; }
                memcpy(buffer + copied, this.buffer + this.cursor, length);
                this.cursor += length;
                this.position += length;
                copied += length;
            } else if count - copied >= FILE_BUFFER_SIZE {
                let read = match this.handle.Read(buffer + copied, count - copied) {
                    Result<usize, IOError>::Ok(read) => read,
                    Result<usize, IOError>::Err(error) => {
                        return Result<usize, IOError>::Err(error);
                    }
                };

                if read == 0 { break; }
                this.position += read;
                copied += read;
            } else {
                let read = match this.handle.Read(this.buffer, FILE_BUFFER_SIZE) {
                    Result<usize, IOError>::Ok(read) => read,
                    Result<usize, IOError>::Err(error) => {
                        return Result<usize, IOError>::Err(error);
                    }
                };

                this.available = read;
                this.cursor = 0;
                if read == 0 { break; }
            }
        }

        Result<usize, IOError>::Ok(copied)
    }

    pub fn ReadExact(&mut this, buffer: *mut u8, count: usize) -> Result<(), IOError> {
        match this.Read(buffer, count) {
            Result<usize, IOError>::Ok(read) => {
                if read != count {
                    return Result<(), IOError>::Err(IOError::UnexpectedEnd);
                }

                Result<(), IOError>::Ok(())
            },
            Result<usize, IOError>::Err(error) => Result<(), IOError>::Err(error)
        }
    }

    pub fn Write(&mut this, data: *u8, count: usize) -> Result<(), IOError> {
        if !this.open {
            return Result<(), IOError>::Err(IOError::InvalidInput);
        }

        if this.mode == FileMode::Read {
            return Result<(), IOError>::Err(IOError::PermissionDenied);
        }

        if let Result<(), IOError>::Err(error) = this.DiscardReadAhead() {
            return Result<(), IOError>::Err(error);
        }

        if this.pending + count > FILE_BUFFER_SIZE {
            if let Result<(), IOError>::Err(error) = this.FlushPending() {
                return Result<(), IOError>::Err(error);
            }
        }

        if count >= FILE_BUFFER_SIZE {
            if let Result<(), IOError>::Err(error) = this.WriteAll(data, count) {
                return Result<(), IOError>::Err(error);
            }
        } else {
            memcpy(this.buffer + this.pending, data, count);
            this.pending += count;
        }

        this.position += count;
        Result<(), IOError>::Ok(())
    }

    pub fn Write(&mut this, text: &String) -> Result<(), IOError> {
        this.Write(text.Data() as *u8, text.Length())
    }

    pub fn Flush(&mut this) -> Result<(), IOError> {
        if !this.open {
            return Result<(), IOError>::Err(IOError::InvalidInput);
        }

        this.FlushPending()
    }

    pub fn Seek(&mut this, offset: isize, origin: SeekOrigin) -> Result<usize, IOError> {
        if !this.open {
            return Result<usize, IOError>::Err(IOError::InvalidInput);
        }

        if let Result<(), IOError>::Err(error) = this.FlushPending() {
            return Result<usize, IOError>::Err(error);
        }

        let mut base: isize = 0;

        if origin == SeekOrigin::Current {
            base = this.position as isize;
        } else if origin == SeekOrigin::End {
            match this.handle.Size() {
                Result<usize, IOError>::Ok(size) => {
                    base = size as isize;
                },
                Result<usize, IOError>::Err(error) => {
                    return Result<usize, IOError>::Err(error);
                }
            }
        }

        if base + offset < 0 {
            return Result<usize, IOError>::Err(IOError::InvalidInput);
        }

        let target = (base + offset) as usize;
        let buffer_start = this.position - this.cursor;

        if this.available != 0 && target >= buffer_start && target <= buffer_start + this.available {
            this.cursor = target - buffer_start;
            this.position = target;
            return Result<usize, IOError>::Ok(target);
        }

        if let Result<usize, IOError>::Err(error) = this.handle.Seek(target as isize, SeekOrigin::Start) {
            return Result<usize, IOError>::Err(error);
        }

        this.available = 0;
        this.cursor = 0;
        this.position = target;
        Result<usize, IOError>::Ok(target)
    }

    pub fn Position(&this) -> usize {
        this.position
    }

    pub fn Size(&mut this) -> Result<usize, IOError> {
        if !this.open {
            return Result<usize, IOError>::Err(IOError::InvalidInput);
        }

        if let Result<(), IOError>::Err(error) = this.FlushPending() {
            return Result<usize, IOError>::Err(error);
        }

        this.handle.Size()
    }

    pub fn ReadU8(&mut this) -> Result<u8, IOError> {
        let mut bytes: [u8; 1];
        if let Result<(), IOError>::Err(error) = this.ReadExact(&mut bytes[0], 1) { return Result<u8, IOError>::Err(error); }
        Result<u8, IOError>::Ok(bytes[0])
    }

    pub fn ReadU16(&mut this) -> Result<u16, IOError> {
        let mut bytes: [u8; 2];
        if let Result<(), IOError>::Err(error) = this.ReadExact(&mut bytes[0], 2) { return Result<u16, IOError>::Err(error); }
        Result<u16, IOError>::Ok((bytes[0] as u16) | ((bytes[1] as u16) << 8))
    }

    pub fn ReadU32(&mut this) -> Result<u32, IOError> {
        let mut bytes: [u8; 4];
        if let Result<(), IOError>::Err(error) = this.ReadExact(&mut bytes[0], 4) { return Result<u32, IOError>::Err(error); }
        Result<u32, IOError>::Ok((bytes[0] as u32) | ((bytes[1] as u32) << 8) | ((bytes[2] as u32) << 16) | ((bytes[3] as u32) << 24))
    }

#[if !SVAROG]
    pub fn ReadU64(&mut this) -> Result<u64, IOError> {
        let mut bytes: [u8; 8];
        if let Result<(), IOError>::Err(error) = this.ReadExact(&mut bytes[0], 8) { return Result<u64, IOError>::Err(error); }
        let mut value: u64 = 0;

        for i in 0..8 {
            value |= (bytes[i as usize] as u64) << ((i * 8) as u64);
        }

        Result<u64, IOError>::Ok(value)
    }
#[endif]

    pub fn WriteU8(&mut this, value: u8) -> Result<(), IOError> {
        let mut bytes: [u8; 1];
        bytes[0] = value;
        this.Write(&bytes[0], 1)
    }

    pub fn WriteU16(&mut this, value: u16) -> Result<(), IOError> {
        let mut bytes: [u8; 2];
        bytes[0] = value as u8;
        bytes[1] = (value >> 8) as u8;
        this.Write(&bytes[0], 2)
    }

    pub fn WriteU32(&mut this, value: u32) -> Result<(), IOError> {
        let mut bytes: [u8; 4];
        bytes[0] = value as u8;
        bytes[1] = (value >> 8) as u8;
        bytes[2] = (value >> 16) as u8;
        bytes[3] = (value >> 24) as u8;
        this.Write(&bytes[0], 4)
    }

#[if !SVAROG]
    pub fn WriteU64(&mut this, value: u64) -> Result<(), IOError> {
        let mut bytes: [u8; 8];

        for i in 0..8 {
            bytes[i as usize] = (value >> ((i * 8) as u64)) as u8;
        }

        this.Write(&bytes[0], 8)
    }
#[endif]

    pub fn ReadBytes(path: &String) -> Result<Vector<u8>, IOError> {
        let mut file = File();
    
        if let Result<(), IOError>::Err(error) = file.Open(path, FileMode::Read) {
            return Result<Vector<u8>, IOError>::Err(error);
        }

        let size = match file.Size() {
            Result<usize, IOError>::Ok(size) => size,
            Result<usize, IOError>::Err(error) => {
                return Result<Vector<u8>, IOError>::Err(error);
            }
        };

        let mut bytes = Vector<u8>();
        bytes.Resize(size);

        if size != 0 {
            match file.Read(bytes.Data(), size) {
                Result<usize, IOError>::Ok(read) => {
                    bytes.Resize(read);
                },
                Result<usize, IOError>::Err(error) => {
                    return Result<Vector<u8>, IOError>::Err(error);
                }
            }
        }

        Result<Vector<u8>, IOError>::Ok(bytes)
    }

    pub fn ReadText(path: &String) -> Result<String, IOError> {
        let mut file = File();

        if let Result<(), IOError>::Err(error) = file.Open(path, FileMode::Read) {
            return Result<String, IOError>::Err(error);
        }

        let size = match file.Size() {
            Result<usize, IOError>::Ok(size) => size,
            Result<usize, IOError>::Err(error) => {
                return Result<String, IOError>::Err(error);
            }
        };

        let buffer = new i8[size + 1];
        let mut length: usize = 0;

        if size != 0 {
            match file.Read(buffer as *mut u8, size) {
                Result<usize, IOError>::Ok(read) => {
                    length = read;
                },
                Result<usize, IOError>::Err(error) => {
                    delete[] buffer;
                    return Result<String, IOError>::Err(error);
                }
            }
        }

        buffer[length] = 0;
        let text = String(buffer as *i8, 0, length);
        delete[] buffer;
        Result<String, IOError>::Ok(text)
    }

    pub fn WriteBytes(path: &String, bytes: &Vector<u8>) -> Result<(), IOError> {
        let mut file = File();
        if let Result<(), IOError>::Err(error) = file.Open(path, FileMode::Write) { return Result<(), IOError>::Err(error); }
        if let Result<(), IOError>::Err(error) = file.Write(bytes.Data(), bytes.Length()) { return Result<(), IOError>::Err(error); }
        file.Close()
    }

    pub fn WriteText(path: &String, text: &String) -> Result<(), IOError> {
        let mut file = File();
        if let Result<(), IOError>::Err(error) = file.Open(path, FileMode::Write) { return Result<(), IOError>::Err(error); }
        if let Result<(), IOError>::Err(error) = file.Write(text) { return Result<(), IOError>::Err(error); }
        file.Close()
    }

    fn WriteAll(&mut this, data: *u8, count: usize) -> Result<(), IOError> {
        let mut written: usize = 0;

        while written < count {
            match this.handle.Write(data + written, count - written) {
                Result<usize, IOError>::Ok(length) => {
                    if length == 0 {
                        return Result<(), IOError>::Err(IOError::NoSpace);
                    }

                    written += length;
                },
                Result<usize, IOError>::Err(error) => {
                    return Result<(), IOError>::Err(error);
                }
            }
        }

        Result<(), IOError>::Ok(())
    }

    fn FlushPending(&mut this) -> Result<(), IOError> {
        if this.pending == 0 {
            return Result<(), IOError>::Ok(());
        }

        let count = this.pending;
        this.pending = 0;
        this.WriteAll(this.buffer as *u8, count)
    }

    fn DiscardReadAhead(&mut this) -> Result<(), IOError> {
        let ahead = this.available > this.cursor;
        this.available = 0;
        this.cursor = 0;

        if ahead {
            if let Result<usize, IOError>::Err(error) = this.handle.Seek(this.position as isize, SeekOrigin::Start) {
                return Result<(), IOError>::Err(error);
            }
        }

        Result<(), IOError>::Ok(())
    }
}

fn JoinPath(directory: &String, file: &String) -> String {
    if directory.Empty() {
        return file;
    }

    if directory[directory.Length() - 1] == '\\' || directory[directory.Length() - 1] == '/' {
        directory + file
    } else {
        directory + PATH_SEPARATOR + file
    }
}

fn SplitExtension(path: String) -> (String, String) {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            break;
        }

        if path[i] == '.' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return (path, String());
    }

    let name = String(path, 0, index);
    let extension = String(path, index, path.Length());
    (name, extension)
}

fn SplitPath(path: String) -> (String, String) {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return (String(), path);
    }

    let directory = String(path, 0, index);
    let file = String(path, index + 1, path.Length());
    (directory, file)
}
