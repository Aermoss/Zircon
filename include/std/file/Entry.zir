#[include "std/io", "std/std", "std/str", "std/res" : *]

enum IOError {
    NotFound, PermissionDenied, AlreadyExists, InvalidInput, Other(i32);

    pub fn ToString(&this) -> String {
        match this {
            IOError::NotFound => "entity not found".ToString(),
            IOError::PermissionDenied => "permission denied".ToString(),
            IOError::AlreadyExists => "entity already exists".ToString(),
            IOError::InvalidInput => "invalid input".ToString(),
            IOError::Other(code) => "os error " + String::FromInteger(code as i64)
        }
    }
}

#[if WINDOWS]
const PATH_SEPERATOR: i8 = '\\';
const MAX_PATH: usize = 260;

class FILETIME {
    pub dwLowDateTime: u32,
    pub dwHighDateTime: u32
}

type LPFILETIME = *mut FILETIME;

class WIN32_FIND_DATAA {
    pub dwFileAttributes: u32,
    pub ftCreationTime: FILETIME,
    pub ftLastAccessTime: FILETIME,
    pub ftLastWriteTime: FILETIME,
    pub nFileSizeHigh: u32,
    pub nFileSizeLow: u32,
    pub dwReserved0: u32,
    pub dwReserved1: u32,
    pub cFileName: [i8; MAX_PATH],
    pub cAlternateFileName: [i8; 14],
    pub dwFileType: u32,
    pub dwCreatorType: u32,
    pub wFinderFlags: u16
}

type LPWIN32_FIND_DATAA = *mut WIN32_FIND_DATAA;

extern "C" {
    fn GetFileAttributesA(lpFileName: *i8) -> u32;

    fn FindFirstFileA(lpFileName: *i8, lpFindFileData: LPWIN32_FIND_DATAA) -> *mut void;
    fn FindNextFileA(hFindFile: *mut void, lpFindFileData: LPWIN32_FIND_DATAA) -> i32;
    fn FindClose(hFindFile: *mut void) -> i32;

    fn GetTempPathA(nBufferLength: u32, lpBuffer: *mut i8) -> u32;
    fn GetFullPathNameA(lpFileName: *i8, nBufferLength: u32, lpBuffer: *mut i8, lpFilePart: *mut *mut i8) -> u32;
    fn GetModuleFileNameA(hModule: *mut void, lpFilename: *mut i8, nSize: u32) -> u32;

    fn CreateFileA(lpFileName: *i8, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut void) -> *mut void;
    fn DeleteFileA(lpFileName: *i8) -> i32;

    fn GetFileSize(hFile: *mut void, lpFileSizeHigh: *mut u32) -> u32;
    fn CloseHandle(hObject: *mut void) -> i32;

    fn GetLastError() -> u32;
}

const GENERIC_READ: u32 = 0x80000000;
const FILE_SHARE_READ: u32 = 0x00000001;
const OPEN_EXISTING: u32 = 0x00000003;

const GENERIC_WRITE: u32 = 0x40000000;
const FILE_SHARE_NONE: u32 = 0x00000000;
const CREATE_ALWAYS: u32 = 0x00000002;

const FILE_ATTRIBUTE_NORMAL: u32 = 0x00000080;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x00000010;
const INVALID_FILE_ATTRIBUTES: u32 = 0xFFFFFFFF;

const INVALID_HANDLE_VALUE: *mut void = -1isize as *mut void;
const INVALID_FILE_SIZE: u32 = 0xFFFFFFFF;

fn _LastError() -> IOError {
    match GetLastError() {
        2 | 3 => IOError::NotFound,
        5 => IOError::PermissionDenied,
        80 | 183 => IOError::AlreadyExists,
        87 | 123 => IOError::InvalidInput,
        code => IOError::Other(code as i32)
    }
}

fn _ReadFile(path: &String) -> Result<String, IOError> {
    let handle = CreateFileA(path.Data(), GENERIC_READ, FILE_SHARE_READ, null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null);
    if handle == INVALID_HANDLE_VALUE { return Result<String, IOError>::Err(_LastError()); }
    let size = GetFileSize(handle, null);

    if size == INVALID_FILE_SIZE {
        let error = _LastError();
        CloseHandle(handle);
        return Result<String, IOError>::Err(error);
    }

    let buffer = new i8[size as usize + 1];
    let mut count: u32 = 0;

    if size != 0 && ReadFile(handle, buffer, size, &mut count, null) == 0 {
        let error = _LastError();
        delete[] buffer;
        CloseHandle(handle);
        return Result<String, IOError>::Err(error);
    }

    buffer[count as usize] = 0;
    let content = String(buffer);
    delete[] buffer;
    CloseHandle(handle);
    Result<String, IOError>::Ok(content)
}

fn _WriteFile(path: &String, content: &String) -> Result<(), IOError> {
    let handle = CreateFileA(path.Data(), GENERIC_WRITE, FILE_SHARE_NONE, null, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, null);
    if handle == INVALID_HANDLE_VALUE { return Result<(), IOError>::Err(_LastError()); }
    let mut written: u32 = 0;

    if WriteFile(handle, content.Data(), content.Length() as u32, &mut written, null) == 0 {
        let error = _LastError();
        CloseHandle(handle);
        return Result<(), IOError>::Err(error);
    }

    CloseHandle(handle);
    Result<(), IOError>::Ok(())
}

fn GetTemporaryPath() -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let length = GetTempPathA(MAX_PATH as u32, &mut buffer[0]);
    if length == 0 { return Result<String, IOError>::Err(_LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}

fn AbsolutePath(path: &String) -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let mut filePart: *mut i8 = null;
    let length = GetFullPathNameA(path.Data(), MAX_PATH as u32, &mut buffer[0], &mut filePart);
    if length == 0 { return Result<String, IOError>::Err(_LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}

fn ExecutablePath() -> Result<String, IOError> {
    let mut buffer: [i8; MAX_PATH];
    let length = GetModuleFileNameA(null, &mut buffer[0], MAX_PATH as u32);
    if length == 0 { return Result<String, IOError>::Err(_LastError()); }
    if length >= MAX_PATH as u32 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
}

fn PathExists(path: &String) -> bool {
    GetFileAttributesA(path.Data()) != INVALID_FILE_ATTRIBUTES
}

fn FileExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0
    } else {
        false
    }
}

fn FolderExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
    } else {
        false
    }
}

fn RemoveFile(path: &String) -> Result<(), IOError> {
    if DeleteFileA(path.Data()) == 0 {
        return Result<(), IOError>::Err(_LastError());
    }

    Result<(), IOError>::Ok(())
}
#[else]
const PATH_SEPERATOR: i8 = '/';
const PATH_MAX: usize = 4096;

const O_RDONLY: i32 = 0;
const O_WRONLY: i32 = 1;

#[if DARWIN]
const O_CREAT: i32 = 512;
const O_TRUNC: i32 = 1024;
#[else]
const O_CREAT: i32 = 64;
const O_TRUNC: i32 = 512;
#[endif]

const S_IRUSR: u32 = 256;
const S_IWUSR: u32 = 128;
const S_IRGRP: u32 = 32;
const S_IWGRP: u32 = 16;

const S_IFMT: u32 = 0xF000;
const S_IFDIR: u32 = 0x4000;
const S_IFREG: u32 = 0x8000;

const SEEK_SET: i32 = 0;
const SEEK_END: i32 = 2;
const F_OK: i32 = 0;

class _stat {
#[if DARWIN]
    pub st_dev: i32,
    pub st_mode: u16,
    pub st_nlink: u16,
    pub st_ino: u64,
    pub st_uid: u32,
    pub st_gid: u32,
    pub st_rdev: i32,
    pub pad0: i32,
    pub st_atime_sec: i64,
    pub st_atime_nsec: i64,
    pub st_mtime_sec: i64,
    pub st_mtime_nsec: i64,
    pub st_ctime_sec: i64,
    pub st_ctime_nsec: i64,
    pub st_btime_sec: i64,
    pub st_btime_nsec: i64,
    pub st_size: i64,
    pub st_blocks: i64,
    pub st_blksize: i32,
    pub st_flags: u32,
    pub st_gen: u32,
    pub st_lspare: i32,
    pub st_qspare0: i64,
    pub st_qspare1: i64
#[elif ARM64]
    pub st_dev: u64,
    pub st_ino: u64,
    pub st_mode: u32,
    pub st_nlink: u32,
    pub st_uid: u32,
    pub st_gid: u32,
    pub st_rdev: u64,
    pub pad0: u64,
    pub st_size: i64,
    pub rest: [i8; 72]
#[else]
    pub st_dev: u64,
    pub st_ino: u64,
    pub st_nlink: u64,
    pub st_mode: u32,
    pub st_uid: u32,
    pub st_gid: u32,
    pub pad0: u32,
    pub st_rdev: u64,
    pub st_size: i64,
    pub rest: [i8; 88]
#[endif]
}

extern "C" {
    fn open(pathname: *i8, flags: i32, mode: u32) -> i32 #[if LIBC] ; #[else] {
        let mut result = 0;

        volatile asm : rax(2), rdi(pathname), rsi(flags as i64), rdx(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn close(fd: i32) #[if LIBC] ; #[else] {
        volatile asm : rax(3), rdi(fd as i64) -> {
            syscall
        } : memory, rcx, r11, rax;
    } #[endif]

    fn lseek(fd: i32, offset: i64, whence: i32) -> i64 #[if LIBC] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(8), rdi(fd as i64), rsi(offset), rdx(whence as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result;
    } #[endif]

    fn stat(pathname: *i8, statbuf: *mut _stat) -> i32 #[if LIBC] ; #[else] {
        let mut result = 0;

        volatile asm : rax(4), rdi(pathname), rsi(statbuf) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn unlink(pathname: *i8) -> i32 #[if LIBC] ; #[else] {
        let mut result = 0;

        volatile asm : rax(87), rdi(pathname) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn access(pathname: *i8, mode: i32) -> i32 #[if LIBC] ; #[else] {
        let mut result = 0;

        volatile asm : rax(21), rdi(pathname), rsi(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn realpath(path: *i8, resolved_path: *mut i8) -> *mut i8;
#[if DARWIN]
    fn __error() -> *mut i32;
    fn opendir(name: *i8) -> *mut void;
    fn closedir(directory: *mut void) -> i32;
    fn _NSGetExecutablePath(buffer: *mut i8, size: *mut u32) -> i32;
#[else]
    fn __errno_location() -> *mut i32;

    fn readlink(pathname: *i8, buffer: *mut i8, size: usize) -> isize #[if LIBC] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(89), rdi(pathname), rsi(buffer), rdx(size as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as isize;
    } #[endif]
#[endif]
}

fn _LastError(result: i64) -> IOError {
#[if !LIBC]
    let code = -result as i32;
#[elif DARWIN]
    let code = *__error();
#[else]
    let code = *__errno_location();
#[endif]

    match code {
        2 | 20 => IOError::NotFound,
        1 | 13 => IOError::PermissionDenied,
        17 => IOError::AlreadyExists,
        22 => IOError::InvalidInput,
        _ => IOError::Other(code)
    }
}

fn _ReadFile(path: &String) -> Result<String, IOError> {
    let fd = open(path.Data(), O_RDONLY, 0);
    if fd < 0 { return Result<String, IOError>::Err(_LastError(fd as i64)); }
    let size = lseek(fd, 0, SEEK_END);

    if size < 0 {
        let error = _LastError(size);
        close(fd);
        return Result<String, IOError>::Err(error);
    }

    lseek(fd, 0, SEEK_SET);
    let buffer = new i8[size as usize + 1];
    let mut length: usize = 0;

    while length < size as usize {
        let count = read(fd, buffer + length, size as usize - length);

        if count < 0 {
            let error = _LastError(count as i64);
            delete[] buffer;
            close(fd);
            return Result<String, IOError>::Err(error);
        }

        if count == 0 { break; }
        length += count as usize;
    }

    buffer[length] = 0;
    let content = String(buffer);
    delete[] buffer;
    close(fd);
    Result<String, IOError>::Ok(content)
}

fn _WriteFile(path: &String, content: &String) -> Result<(), IOError> {
    let mode = S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP;
    let fd = open(path.Data(), O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0 { return Result<(), IOError>::Err(_LastError(fd as i64)); }
    let mut written: usize = 0;

    while written < content.Length() {
        let count = write(fd, content.Data() + written, content.Length() - written);

        if count <= 0 {
            let error = _LastError(count as i64);
            close(fd);
            return Result<(), IOError>::Err(error);
        }

        written += count as usize;
    }

    close(fd);
    Result<(), IOError>::Ok(())
}

fn GetTemporaryPath() -> Result<String, IOError> {
    Result<String, IOError>::Ok("/tmp/".ToString())
}

fn AbsolutePath(path: &String) -> Result<String, IOError> {
    let mut buffer: [i8; PATH_MAX];
    if realpath(path.Data(), &mut buffer[0]) == null { return Result<String, IOError>::Err(_LastError(0)); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8))
}

fn ExecutablePath() -> Result<String, IOError> {
    let mut buffer: [i8; PATH_MAX];
#[if DARWIN]
    let mut size = PATH_MAX as u32;
    if _NSGetExecutablePath(&mut buffer[0], &mut size) != 0 { return Result<String, IOError>::Err(IOError::InvalidInput); }
    AbsolutePath(String(&buffer[0] as *i8))
#[else]
    let length = readlink("/proc/self/exe", &mut buffer[0], PATH_MAX);
    if length < 0 { return Result<String, IOError>::Err(_LastError(length as i64)); }
    if length as usize >= PATH_MAX { return Result<String, IOError>::Err(IOError::InvalidInput); }
    Result<String, IOError>::Ok(String(&buffer[0] as *i8, 0, length as usize))
#[endif]
}

fn PathExists(path: &String) -> bool {
    access(path.Data(), F_OK) == 0
}

#[if DARWIN]
fn FileExists(path: &String) -> bool {
    PathExists(path) && !FolderExists(path)
}

fn FolderExists(path: &String) -> bool {
    let directory = opendir(path.Data());
    if directory == null { return false; }
    closedir(directory);
    true
}
#[else]
fn FileExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0 {
        return false;
    }

    (st.st_mode & S_IFMT) == S_IFREG
}

fn FolderExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0 {
        return false;
    }

    (st.st_mode & S_IFMT) == S_IFDIR
}
#[endif]

fn RemoveFile(path: &String) -> Result<(), IOError> {
    let result = unlink(path.Data());
    if result != 0 { return Result<(), IOError>::Err(_LastError(result as i64)); }
    Result<(), IOError>::Ok(())
}
#[endif]

fn JoinPath(directory: &String, file: &String) -> String {
    if directory.Empty() {
        return file;
    }

    if directory[directory.Length() - 1] == '\\' || directory[directory.Length() - 1] == '/' {
        directory + file
    } else {
        directory + PATH_SEPERATOR + file
    }
}

fn SplitExtension(path: String) -> (String, String) {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            break;
        }

        if path[i] == '.' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return (path, String());
    }

    let name = String(path, 0, index);
    let extension = String(path, index, path.Length());
    (name, extension)
}

fn SplitPath(path: String) -> (String, String) {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return (String(), path);
    }

    let directory = String(path, 0, index);
    let file = String(path, index + 1, path.Length());
    (directory, file)
}
