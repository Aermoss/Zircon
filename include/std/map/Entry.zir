#[include "std/vec", "std/opt" : *]

class Map<K, V> {
    vector: Vector<(K, V)>;

    Map(&mut this) {}

    Map(&mut this, other: &Map<K, V>) {
        this.vector = other.vector;
    }

    ~Map(&mut this) {}

    pub fn Data(&this) -> *(K, V) { this.vector.Data() }
    pub fn Data(&mut this) -> *mut (K, V) { this.vector.Data() }

    pub fn AsSlice(&this) -> &[(K, V)] { this.vector.AsSlice() }
    pub fn AsSlice(&mut this) -> &mut [(K, V)] { this.vector.AsSlice() }

    pub fn Empty(&this) -> bool { this.vector.Empty() }
    pub fn Length(&this) -> usize { this.vector.Length() }

    pub fn Clear(&mut this) {
        this.vector.Clear();
    }

    pub fn Swap(&mut this, other: &mut Map<K, V>) {
        this.vector.Swap(other.vector);
    }

    pub fn Keys(&this) -> Vector<K> {
        let mut keys = Vector<K>();

        for pair in this.vector {
            keys.PushBack(pair.0);
        }

        keys
    }

    pub fn Values(&this) -> Vector<V> {
        let mut values = Vector<V>();

        for pair in this.vector {
            values.PushBack(pair.1);
        }

        values
    }

    pub fn Has(&this, key: K) -> bool {
        for pair in this.vector {
            if pair.0 == key {
                return true;
            }
        }

        false
    }

    pub fn Get(&this, key: K) -> Option<V> {
        for pair in this.vector {
            if pair.0 == key {
                return Option<V>::Some(pair.1);
            }
        }

        Option<V>::None
    }

    pub fn Get(&this, key: K, default: V) -> V {
        for pair in this.vector {
            if pair.0 == key {
                return pair.1;
            }
        }

        default
    }

    pub fn Remove(&mut this, key: K) {
        for i in 0..this.vector.Length() {
            if this.vector[i].0 == key {
                this.vector.RemoveAt(i);
                return;
            }
        }
    }

    pub fn Index(&this, key: K) -> Option<usize> {
        for i in 0..this.vector.Length() {
            if this.vector[i].0 == key {
                return Option<usize>::Some(i);
            }
        }

        Option<usize>::None
    }

    pub fn operator=(&mut this, other: &Map<K, V>) -> &mut Map<K, V> {
        this.vector = other.vector;
        this
    }

    pub fn operator[](&mut this, key: K) -> &mut V {
        for pair in this.vector {
            if pair.0 == key {
                return pair.1;
            }
        }

        let index = this.vector.Length();
        this.vector.Resize(index + 1);
        this.vector[index].0 = key;
        this.vector[index].1
    }

    pub fn Begin(&this) -> *(K, V) {
        this.vector.Begin()
    }

    pub fn End(&this) -> *(K, V) {
        this.vector.End()
    }

    pub fn Begin(&mut this) -> *mut (K, V) {
        this.vector.Begin()
    }

    pub fn End(&mut this) -> *mut (K, V) {
        this.vector.End()
    }
}
