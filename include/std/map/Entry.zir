#[include "std/vec", "std/pair", "std/opt" : *]

class Map<K, V> {
    vector: Vector<Pair<K, V>>;

    Map(&mut this) {}

    Map(&mut this, other: &Map<K, V>) {
        this.vector = other.vector;
    }

    ~Map(&mut this) {}

    pub fn Data(&this) -> *Pair<K, V> { this.vector.Data() }
    pub fn Data(&mut this) -> *mut Pair<K, V> { this.vector.Data() }

    pub fn Empty(&this) -> bool { this.vector.Empty() }
    pub fn Size(&this) -> usize { this.vector.Size() }

    pub fn Clear(&mut this) {
        this.vector.Clear();
    }

    pub fn Swap(&mut this, other: &mut Map<K, V>) {
        this.vector.Swap(other.vector);
    }

    pub fn Keys(&this) -> Vector<K> {
        let mut keys = Vector<K>();

        for pair in this.vector {
            keys.PushBack(pair.left);
        }

        keys
    }

    pub fn Values(&this) -> Vector<V> {
        let mut values = Vector<V>();

        for pair in this.vector {
            values.PushBack(pair.right);
        }

        values
    }

    pub fn Has(&this, key: K) -> bool {
        for pair in this.vector {
            if pair.left == key {
                return true;
            }
        }

        false
    }

    pub fn Get(&this, key: K) -> Option<V> {
        for pair in this.vector {
            if pair.left == key {
                return Option<V>::Some(pair.right);
            }
        }

        Option<V>::None
    }

    pub fn Get(&this, key: K, default: V) -> V {
        for pair in this.vector {
            if pair.left == key {
                return pair.right;
            }
        }

        default
    }

    pub fn Remove(&mut this, key: K) {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                this.vector.RemoveAt(i);
                return;
            }
        }
    }

    pub fn Index(&this, key: K) -> Option<usize> {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                return Option<usize>::Some(i);
            }
        }

        Option<usize>::None
    }

    pub fn operator=(&mut this, other: &Map<K, V>) -> &mut Map<K, V> {
        this.vector = other.vector;
        this
    }

    pub fn operator[](&mut this, key: K) -> &mut V {
        for pair in this.vector {
            if pair.left == key {
                return pair.right;
            }
        }

        this.vector.PushBack(Pair<K, V>(key));
        this.vector[this.vector.Size() - 1].right
    }

    pub fn operator[](&this, index: usize) -> &Pair<K, V> {
        this.vector[index]
    }

    pub fn operator[](&mut this, index: usize) -> &mut Pair<K, V> {
        this.vector[index]
    }

    pub fn Begin(&this) -> *Pair<K, V> {
        this.vector.Begin()
    }

    pub fn End(&this) -> *Pair<K, V> {
        this.vector.End()
    }

    pub fn Begin(&mut this) -> *mut Pair<K, V> {
        this.vector.Begin()
    }

    pub fn End(&mut this) -> *mut Pair<K, V> {
        this.vector.End()
    }
}
