#[include "std/io", "std/file", "std/str", "std/map" : *]

struct Stats {
    pub library_counts: Map<String, usize>,
    pub compiler_counts: Map<String, usize>,
    pub other_counts: Map<String, usize>
}

fn GetLineCount(path: &String) -> usize {
    let content = File::ReadText(path).Unwrap();
    if content.Empty() { return 0; }
    let mut lines = content.Count('\n');

    if content[content.Length() - 1] != '\n' {
        lines += 1;
    }

    lines
}

fn ProcessDirectory(directory: &String, stats: &mut Stats) {
    let entries = match ListFolder(directory) {
        Result<Vector<FolderEntry>, IOError>::Ok(entries) => entries,
        Result<Vector<FolderEntry>, IOError>::Err(_) => {
            return;
        }
    };

    for entry in entries {
        let path = JoinPath(directory, entry.name);

        if entry.kind == EntryKind::Folder {
            if entry.name != ".codex" && entry.name != ".claude" {
                ProcessDirectory(path, stats);
            }
        } else if SplitExtension(entry.name).1 == ".zir" {
            let lines = GetLineCount(path);

            if path.Contains("include") {
                let library = SplitPath(path).0;

                if stats.library_counts.Has(library) {
                    stats.library_counts[library] += lines;
                } else {
                    stats.library_counts[library] = lines;
                }
            } else if path.Contains("src") {
                stats.compiler_counts[path] = lines;
            } else {
                stats.other_counts[path] = lines;
            }
        }
    }
}

fn PrintMap(title: *i8, map: &Map<String, usize>) -> usize {
    let mut total: usize = 0;
    WriteLine("--- " + title.ToString() + " ---");

    for (file, lines) in map {
        WriteLine(file + ": " + String::FromInteger(lines as u64) + " lines");
        total += lines;
    }

    WriteLine("Subtotal: " + String::FromInteger(total as u64) + " lines\n");
    total
}

fn Main(args: &mut Vector<String>) -> i32 {
    let mut stats = Stats {
        library_counts: Map<String, usize>(),
        compiler_counts: Map<String, usize>(),
        other_counts: Map<String, usize>()
    };

    ProcessDirectory(".".ToString(), &mut stats);
    let library_total = PrintMap("Libraries", stats.library_counts);
    let compiler_total = PrintMap("Compiler", stats.compiler_counts);
    let other_total = PrintMap("Other", stats.other_counts);
    let total = library_total + compiler_total + other_total;
    WriteLine("==========================================");
    WriteLine("TOTAL LINES:  " + String::FromInteger(total as u64) + " lines");
    WriteLine("==========================================");
    0
}
